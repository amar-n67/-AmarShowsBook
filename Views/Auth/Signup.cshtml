@model AmarShowsBook.Models.User

@{
    ViewData["Title"] = "Signup";
}

<section class="signup-stage">
    <div class="signup-card">
        <div class="signup-header">
            <span>Shot 02 / Casting Desk</span>
            <h1>Create Opening Credit</h1>
            <p>Your showTime ticket starts with clean contact details and a strong password.</p>
            <small class="signup-version">Version <span data-current-version></span></small>
        </div>

        <form method="post" novalidate onsubmit="return validateSignupForm()">
            <div class="signup-grid">
                <div class="mb-3">
                    <label>Display Name <span class="text-danger">*</span></label>
                    <input name="Name" class="form-control" value="@Model?.Name" placeholder="Name shown in menu" required />
                    <span class="text-danger">@Html.ValidationMessage("Name")</span>
                </div>

                <div class="mb-3">
                    <label>Email <span class="text-danger">*</span></label>
                    <input name="Email" type="email" class="form-control" value="@Model?.Email" placeholder="artist@gmail.com" required />
                    <span class="text-danger">@Html.ValidationMessage("Email")</span>
                </div>

                <div class="mb-3">
                    <label>Mobile <span class="text-danger">*</span></label>
                    <input name="Mobile" class="form-control" value="@Model?.Mobile" placeholder="10 digit mobile" maxlength="10" required />
                    <span class="text-danger">@Html.ValidationMessage("Mobile")</span>
                </div>

                <div class="mb-3">
                    <label>Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input id="signupPassword" name="Password" type="password" class="form-control" minlength="8"
                               pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$" required />
                        <button type="button" class="btn btn-outline-light" data-password-toggle="signupPassword" title="Show password" onclick="togglePassword('signupPassword', this)">
                        </button>
                    </div>
                    <small class="text-muted">Minimum 8 characters with uppercase, lowercase, and special character.</small>
                    <span class="text-danger">@Html.ValidationMessage("Password")</span>
                </div>
            </div>

            <div class="signup-actions">
                <button class="btn btn-primary">Roll My Account</button>
                <a href="/Auth/Login" class="btn btn-secondary">Back To Gate</a>
            </div>
        </form>
    </div>
</section>

<style>
.signup-stage {
    min-height: calc(100vh - 190px);
    display: grid;
    align-items: center;
    padding: 24px 0 44px;
}
.signup-card {
    max-width: 900px;
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    box-shadow: 0 24px 70px rgba(35,31,32,0.22);
}
.signup-header {
    padding: 28px 30px;
    background:
        linear-gradient(135deg, rgba(255, 242, 199, 0.94), rgba(245, 178, 196, 0.86), rgba(146, 229, 221, 0.86)),
        repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px);
    color: #231f20;
}
.signup-header span {
    text-transform: uppercase;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.08em;
}
.signup-header h1 {
    margin: 8px 0 8px;
    font-weight: 900;
    color: #231f20;
}
.signup-header p {
    margin: 0;
    max-width: 620px;
    color: #34303a;
}
.signup-version {
    display: inline-flex;
    margin-top: 12px;
    padding: 5px 10px;
    border: 1px solid rgba(35,31,32,0.18);
    border-radius: 999px;
    color: #34303a;
    font-weight: 900;
}
.signup-card form {
    padding: 26px 30px 30px;
}
.signup-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 18px;
}
.signup-card label {
    margin-bottom: 6px;
    font-weight: 800;
}
.signup-actions {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 8px;
}
.signup-actions .btn {
    min-width: 160px;
    font-weight: 850;
}
@@media (max-width: 760px) {
    .signup-grid {
        grid-template-columns: 1fr;
    }
    .signup-actions {
        flex-direction: column;
    }
}
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("[data-current-version]").forEach(item => {
                item.textContent = window.currentAppVersion || "1.0.0";
            });

            const serverError = "@ViewBag.Error";
            const modelError = "@(!ViewData.ModelState.IsValid ? "Please fix the highlighted signup details." : "")";

            if (serverError) {
                showCinemaPopup(serverError, "error");
            } else if (modelError) {
                showCinemaPopup(modelError, "error");
            }
        });

        function validateSignupForm() {
            const name = document.querySelector('input[name="Name"]').value.trim();
            const email = document.querySelector('input[name="Email"]').value.trim();
            const mobile = document.querySelector('input[name="Mobile"]').value.trim();
            const password = document.getElementById("signupPassword").value;
            const emailMark = String.fromCharCode(64);
            const emailRegex = new RegExp("^[a-zA-Z0-9._%+-]+" + emailMark + "(gmail[.]com|outlook[.]com)$");
            const mobileRegex = /^[0-9]{10}$/;
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$/;

            if (!name) {
                showCinemaPopup("Display name is required.", "error");
                return false;
            }

            if (!emailRegex.test(email)) {
                showCinemaPopup("Only Gmail or Outlook email is allowed.", "error");
                return false;
            }

            if (!mobileRegex.test(mobile)) {
                showCinemaPopup("Mobile must be exactly 10 digits.", "error");
                return false;
            }

            if (!passwordRegex.test(password)) {
                showCinemaPopup("Password must be at least 8 characters and include uppercase, lowercase, and special character.", "error");
                return false;
            }

            return true;
        }
    </script>
}
