        radial-gradient(circle at 88% 10%, rgba(22, 143, 152, 0.20), transparent 24%),
        linear-gradient(120deg, #f7fbf8 0%, #fff5df 46%, #f5d5ca 100%);
    --auth-panel-bg: rgba(255, 253, 248, 0.72);
    --auth-soft-bg: rgba(255, 255, 255, 0.62);
    --auth-field-bg: rgba(255, 255, 255, 0.76);
    --auth-grid-line: rgba(23, 32, 51, 0.05);
    --auth-glow-bg: linear-gradient(90deg, rgba(55, 88, 214, 0.13), rgba(22, 143, 152, 0.18), rgba(228, 93, 72, 0.14));
    --auth-notice-bg: rgba(255, 253, 248, 0.84);
    --auth-notice-border: rgba(22, 143, 152, 0.24);
    --auth-danger-soft: rgba(228, 93, 72, 0.10);
    --auth-danger-text: #9f2e27;
}

html[data-theme="system"] {
    --auth-ink: #1f2937;
