@{
    ViewData["Title"] = "Login";
}

<section class="auth-stage">
    <div class="auth-motion auth-motion-one" aria-hidden="true"></div>
    <div class="auth-motion auth-motion-two" aria-hidden="true"></div>
    <div class="auth-scanline" aria-hidden="true"></div>

    <div class="auth-frame">
        <div class="auth-copy">
            <span class="auth-kicker">Account Access</span>
            <div class="auth-logo-stage">
                <span class="auth-logo-ring" aria-hidden="true"></span>
                <img class="auth-logo" src="~/images/brand/showtime-login-logo.png" alt="showTime" asp-append-version="true" />
            </div>
            <h1>Welcome Back</h1>
            <p>Sign in securely to continue to your bookings, wallet, and tickets.</p>
            <div class="auth-mini-status" aria-label="Application status">
                <span>Secure</span>
                <span>Live</span>
                <span>v<span data-current-version></span></span>
            </div>
        </div>

        <div class="auth-card">
            <div class="auth-slate">
                <span>showTime</span>
                <span>Login</span>
            </div>

            <form method="post" novalidate onsubmit="return validateLoginForm()">
                <div class="auth-field mb-3">
                    <label>Email</label>
                    <input name="email" type="email" class="form-control" placeholder="artist@gmail.com" required />
                </div>

                <div class="auth-field mb-3">
                    <label>Password</label>
                    <div class="input-group">
                        <input id="loginPassword" name="password" type="password" class="form-control" minlength="8"
                               pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$" required />
                        <button type="button" class="btn btn-outline-light" data-password-toggle="loginPassword" title="Show password" onclick="togglePassword('loginPassword', this)">
                        </button>
                    </div>
                </div>

                <button class="btn btn-primary w-100 auth-main-btn">Enter The Set</button>
            </form>

            <div class="auth-links">
                <a href="/Auth/Signup">Create your opening credit</a>
                <a href="/Auth/ForgotPassword">Forgot the script?</a>
            </div>

            <button type="button" class="btn btn-danger w-100 auth-close-btn" onclick="closeApplication()">
                Close Application
            </button>
        </div>
    </div>

    @if (ViewBag.RecoverArchiveId != null)
    {
        <div class="recovery-modal">
            <div class="recovery-dialog" role="dialog" aria-modal="true" aria-labelledby="recoverAccountTitle">
                <span class="recovery-kicker">Deleted Account</span>
                <h2 id="recoverAccountTitle">Recover this account?</h2>
                <p>
                    This account was deleted, but it is still inside the 30 day recovery window.
                    Recover now to restore the archived account data.
                </p>
                <div class="recovery-meta">
                    <span>@ViewBag.RecoverEmail</span>
                    <strong>Available until @ViewBag.RecoverUntil</strong>
                </div>
                <form method="post" action="/Auth/RecoverDeletedAccount">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="archiveId" value="@ViewBag.RecoverArchiveId" />
                    <input type="hidden" name="recoveryChoice" value="recover" />
                    <div class="recovery-actions">
                        <a href="/Auth/Login" class="btn btn-secondary btn-sm">Cancel</a>
                        <button type="submit" class="btn btn-success btn-sm">Recover Account</button>
                    </div>
                </form>
            </div>
        </div>
    }
</section>

<style>
.auth-stage {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - 150px);
    display: grid;
    align-items: center;
    overflow: hidden;
    padding: clamp(24px, 4vw, 54px) 0;
    border-radius: 8px;
}

.auth-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
        linear-gradient(120deg,
            color-mix(in srgb, var(--app-bg) 74%, #101722),
            color-mix(in srgb, var(--app-primary) 30%, var(--app-bg)) 44%,
            color-mix(in srgb, var(--app-accent-strong) 32%, var(--app-bg)));
}

.auth-stage::after {
    content: "";
    position: absolute;
    inset: -20%;
    z-index: -2;
    opacity: 0.38;
    background:
        repeating-linear-gradient(90deg,
            transparent 0 42px,
            color-mix(in srgb, var(--app-nav-text) 15%, transparent) 42px 48px,
            transparent 48px 92px),
        repeating-linear-gradient(0deg,
            transparent 0 32px,
            color-mix(in srgb, var(--app-card) 18%, transparent) 32px 34px,
            transparent 34px 70px);
    transform: rotate(-7deg);
    animation: authFilmDrift 18s linear infinite;
}

.auth-motion {
    position: absolute;
    z-index: -1;
    pointer-events: none;
    border: 1px solid color-mix(in srgb, var(--app-card) 48%, transparent);
    border-radius: 8px;
    background:
        linear-gradient(90deg, transparent 0 10px, color-mix(in srgb, var(--app-card) 54%, transparent) 10px 16px, transparent 16px 34px),
        linear-gradient(180deg, color-mix(in srgb, var(--app-card) 28%, transparent), transparent);
    box-shadow: 0 22px 60px color-mix(in srgb, var(--app-primary) 18%, transparent);
}

.auth-motion-one {
    width: min(720px, 92vw);
    height: 88px;
    left: -190px;
    top: 12%;
    transform: rotate(-10deg);
    animation: authSlideRight 13s linear infinite;
}

.auth-motion-two {
    width: min(620px, 86vw);
    height: 74px;
    right: -220px;
    bottom: 14%;
    transform: rotate(9deg);
    animation: authSlideLeft 15s linear infinite;
}

.auth-scanline {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 2px;
    z-index: 1;
    opacity: 0.8;
    background: linear-gradient(90deg, transparent, var(--app-accent), transparent);
    animation: authScan 3.4s ease-in-out infinite;
}

.auth-frame {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 430px);
    gap: clamp(22px, 4vw, 46px);
    align-items: stretch;
    width: min(1080px, calc(100% - 32px));
    margin: 0 auto;
}
.auth-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 480px;
    overflow: hidden;
    border-radius: 8px;
    padding: clamp(26px, 5vw, 54px);
    color: var(--app-nav-text);
    background:
        linear-gradient(150deg,
            rgba(255, 255, 255, 0.16),
            rgba(15, 23, 42, 0.12)),
        var(--app-nav);
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.28);
    animation: authPanelIn 0.72s ease both;
}

.auth-copy::before,
.auth-copy::after {
    content: "";
    position: absolute;
    inset-inline: 24px;
    height: 10px;
    background:
        repeating-linear-gradient(90deg,
            rgba(255,255,255,0.58) 0 10px,
            transparent 10px 20px);
    opacity: 0.38;
}

.auth-copy::before {
    top: 24px;
}

.auth-copy::after {
    bottom: 24px;
}

.auth-logo-stage {
    position: relative;
    width: min(350px, 86%);
    aspect-ratio: 1.35;
    display: grid;
    place-items: center;
    margin: 14px 0 18px;
}

.auth-logo-ring {
    position: absolute;
    inset: 8%;
    border: 2px solid color-mix(in srgb, var(--app-accent) 70%, transparent);
    border-radius: 999px;
    opacity: 0.64;
    animation: authLogoRing 2.8s ease-in-out infinite;
}
.auth-logo {
    display: block;
    width: 86%;
    max-height: 230px;
    object-fit: contain;
    object-position: center;
    filter: drop-shadow(0 18px 26px rgba(15, 23, 42, 0.28));
    animation: authLogoFloat 4.2s ease-in-out infinite;
}

.auth-copy h1 {
    margin: 0 0 10px;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    line-height: 0.96;
    font-weight: 950;
    letter-spacing: 0;
}
.auth-copy p {
    max-width: 560px;
    margin: 0;
    color: color-mix(in srgb, var(--app-nav-text) 84%, transparent);
    font-size: 1.08rem;
    font-weight: 650;
}

.auth-mini-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
}

.auth-mini-status > span {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    padding: 5px 10px;
    border: 1px solid color-mix(in srgb, var(--app-nav-text) 24%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--app-card) 22%, transparent);
    color: var(--app-nav-text);
    font-size: 0.78rem;
    font-weight: 900;
}
.auth-kicker,
.auth-slate {
    text-transform: uppercase;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.06em;
}
.auth-card {
    align-self: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--app-input-border) 72%, #ffffff 28%);
    border-radius: 8px;
    background: color-mix(in srgb, var(--app-card) 92%, transparent);
    color: var(--app-card-text);
    backdrop-filter: blur(18px);
    box-shadow: 0 24px 70px rgba(0,0,0,0.28);
    animation: authCardIn 0.72s ease 0.12s both;
}
.auth-slate {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: var(--app-nav);
    color: var(--app-nav-text);
}
.auth-card form,
.auth-links,
.auth-close-btn {
    margin: 22px;
}
.auth-card label {
    margin-bottom: 6px;
    font-weight: 800;
}

.auth-field {
    animation: authFieldIn 0.55s ease both;
}

.auth-field:nth-child(2) {
    animation-delay: 0.08s;
}

.auth-card .form-control {
    min-height: 46px;
    border-radius: 8px;
    border-color: var(--app-input-border);
    background: var(--app-input);
    color: var(--app-input-text);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.auth-card .form-control:focus {
    border-color: var(--app-accent-strong);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--app-accent-strong) 18%, transparent);
    transform: translateY(-1px);
}

.auth-card .input-group .btn {
    min-width: 48px;
    border-radius: 0 8px 8px 0;
    border-color: var(--app-input-border);
    color: var(--app-card-text);
    background: color-mix(in srgb, var(--app-card) 72%, var(--app-input));
}

.auth-main-btn {
    min-height: 48px;
    font-weight: 850;
    border: 0;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--app-primary), var(--app-accent-strong));
    box-shadow: 0 14px 30px color-mix(in srgb, var(--app-primary) 34%, transparent);
    transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
}

.auth-main-btn:hover,
.auth-main-btn:focus-visible {
    transform: translateY(-2px);
    filter: saturate(1.08);
    box-shadow: 0 18px 38px color-mix(in srgb, var(--app-primary) 42%, transparent);
}
.auth-links {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
}
.auth-close-btn {
    width: calc(100% - 44px) !important;
    font-weight: 850;
    border-radius: 8px;
}
.recovery-modal {
    position: fixed;
    inset: 0;
    z-index: 1050;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(15, 20, 28, 0.66);
    backdrop-filter: blur(12px);
}
.recovery-dialog {
    width: min(100%, 460px);
    border: 1px solid color-mix(in srgb, var(--app-input-border) 70%, #ffffff 30%);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    padding: 24px;
    box-shadow: 0 28px 80px rgba(0,0,0,0.32);
}
.recovery-kicker {
    display: inline-flex;
    margin-bottom: 8px;
    color: #dc3545;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}
.recovery-dialog h2 {
    margin: 0 0 10px;
    font-weight: 900;
}
.recovery-dialog p {
    margin: 0;
    color: var(--app-muted);
}
.recovery-meta {
    display: grid;
    gap: 4px;
    margin: 16px 0;
    padding: 12px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-input);
}
.recovery-meta span {
    font-weight: 850;
}
.recovery-meta strong {
    color: #198754;
    font-size: 0.86rem;
}
.recovery-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}
@@media (max-width: 840px) {
    .auth-stage {
        min-height: calc(100vh - 120px);
        padding-inline: 0;
    }

    .auth-frame {
        grid-template-columns: 1fr;
        width: min(100% - 24px, 520px);
    }

    .auth-copy {
        min-height: 310px;
        text-align: center;
        align-items: center;
    }

    .auth-copy p {
        font-size: 0.98rem;
    }

    .auth-logo {
        width: min(240px, 88%);
        max-height: 180px;
    }

    .auth-logo-stage {
        margin-inline: auto;
    }

    .auth-card form,
    .auth-links,
    .auth-close-btn {
        margin: 18px;
    }

    .auth-close-btn {
        width: calc(100% - 36px) !important;
    }
}

@@media (prefers-reduced-motion: reduce) {
    .auth-stage::after,
    .auth-motion,
    .auth-scanline,
    .auth-copy,
    .auth-card,
    .auth-logo,
    .auth-logo-ring,
    .auth-field {
        animation: none !important;
    }
}

@@keyframes authFilmDrift {
    to {
        transform: rotate(-7deg) translateX(-92px);
    }
}

@@keyframes authSlideRight {
    50% {
        transform: rotate(-10deg) translateX(130px);
    }
}

@@keyframes authSlideLeft {
    50% {
        transform: rotate(9deg) translateX(-130px);
    }
}

@@keyframes authScan {
    0%, 100% {
        transform: translateY(0);
        opacity: 0;
    }
    50% {
        transform: translateY(calc(100vh - 150px));
        opacity: 0.82;
    }
}

@@keyframes authPanelIn {
    from {
        opacity: 0;
        transform: translateX(-18px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateX(0) scale(1);
    }
}

@@keyframes authCardIn {
    from {
        opacity: 0;
        transform: translateX(18px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateX(0) scale(1);
    }
}

@@keyframes authFieldIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes authLogoFloat {
    50% {
        transform: translateY(-8px);
    }
}

@@keyframes authLogoRing {
    0%, 100% {
        transform: scale(0.88);
        opacity: 0.28;
    }
    50% {
        transform: scale(1.08);
        opacity: 0.68;
    }
}
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("[data-current-version]").forEach(item => {
                item.textContent = window.currentAppVersion || "1.0.0";
            });

            const error = "@ViewBag.Error";
            const success = "@TempData["Success"]";
            if (success) {
                showCinemaPopup(success, "success");
            }
            if (error) {
                showCinemaPopup(error, "error");
            }
        });

        function closeApplication() {
            showCinemaPopup("This will stop the local application and try to close this tab.", "confirm", {
                title: "Pack Up?",
                okText: "Close App",
                cancelText: "Stay",
                onOk: function () {
                    fetch("/Auth/CloseApplication", { method: "POST" })
                        .finally(function () {
                            window.open("", "_self");
                            window.close();
                            document.body.innerHTML = "<main class='container mt-5'><div class='alert alert-success text-center'>Application closed. You may close this tab if the browser keeps it open.</div></main>";
                        });
                }
            });
        }

        function validateLoginForm() {
            const email = document.querySelector('input[name="email"]').value.trim();
            const password = document.getElementById("loginPassword").value;
            const emailMark = String.fromCharCode(64);
            const emailRegex = new RegExp("^[a-zA-Z0-9._%+-]+" + emailMark + "(gmail[.]com|outlook[.]com)$");
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$/;

            if (!emailRegex.test(email)) {
                showCinemaPopup("Only Gmail or Outlook email is allowed.", "error");
                return false;
            }

            if (!passwordRegex.test(password)) {
                showCinemaPopup("Password must be at least 8 characters and include uppercase, lowercase, and special character.", "error");
                return false;
            }

            return true;
        }
    </script>
}
