@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewBag.ReturnUrl ?? "";
}

<section class="auth-stage">
    <div class="auth-progress" aria-hidden="true"><span></span></div>
    <div class="auth-dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="auth-shell">
        <div class="auth-hero auth-login-card motion-surface" data-auth-tilt>
            <div class="auth-copy-panel">
                <div class="auth-brand-row">
                    <div class="auth-brand">
                        <img src="~/images/brand/showtime-login-logo-tight.png" alt="showTime logo" asp-append-version="true" />
                        <span>showTime</span>
                    </div>
                    <small class="auth-device-note">Use large screen for best experience😊.</small>
                </div>

                <span class="auth-kicker">Account access premiere</span>
                <h1>Continue your show.</h1>
                <p>
                    Login to book seats, complete payments, view tickets, manage wallet activity, and return exactly where you left.
                </p>

                <div class="auth-ad-strip" aria-label="Login highlights">
                    <span>Fast booking</span>
                    <span>Secure payment</span>
                    <span>Wallet ready</span>
                    <span>Ticket access</span>
                </div>

                <div class="auth-logo-theater" aria-hidden="true">
                    <span class="auth-logo-ring"></span>
                    <span class="auth-logo-ring two"></span>
                    <img src="~/images/brand/showtime-login-logo-tight.png" alt="" asp-append-version="true" />
                    <span class="auth-orbit one">Book</span>
                    <span class="auth-orbit two">Pay</span>
                    <span class="auth-orbit three">Go</span>
                </div>
            </div>

            <div class="auth-card">
                <div class="auth-card-head">
                    <span>Secure entry</span>
                    <h2>Login</h2>
                    <p>Use your registered email and password to continue.</p>
                </div>

                <form method="post" novalidate onsubmit="return validateLoginForm()">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="auth-field">
                        <label for="loginEmail">Email</label>
                        <input id="loginEmail" name="email" type="email" class="form-control" placeholder="artist@gmail.com" required />
                    </div>

                    <div class="auth-field">
                        <label for="loginPassword">Password</label>
                        <div class="input-group">
                            <input id="loginPassword" name="password" type="password" class="form-control" minlength="8"
                                   pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$" required />
                            <button type="button" class="btn password-toggle" data-password-toggle="loginPassword" title="Show password" onclick="togglePassword('loginPassword', this)"></button>
                        </div>
                    </div>

                    <button class="btn auth-main-btn w-100">Enter showTime</button>
                </form>

                <div class="auth-login-links" aria-label="Login links">
                    <a href="/Auth/Signup">Create account</a>
                    <a href="/Auth/ForgotPassword">Recover access</a>
                    <a href="/Home/Intro">Back to Intro</a>
                </div>

                <button type="button" class="btn auth-close-btn" onclick="closeApplication()">
                    Close Application
                </button>
            </div>
        </div>
    </div>

    @if (ViewBag.RecoverArchiveId != null)
    {
        <div class="recovery-modal">
            <div class="recovery-dialog motion-surface" role="dialog" aria-modal="true" aria-labelledby="recoverAccountTitle">
                <span class="recovery-kicker">Deleted Account</span>
                <h2 id="recoverAccountTitle">Recover this account?</h2>
                <p>
                    This account was deleted, but it is still inside the 30 day recovery window.
                    Recover now to restore the archived account data.
                </p>
                <div class="recovery-meta">
                    <span>@ViewBag.RecoverEmail</span>
                    <strong>Available until @ViewBag.RecoverUntil</strong>
                </div>
                <form method="post" action="/Auth/RecoverDeletedAccount">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="archiveId" value="@ViewBag.RecoverArchiveId" />
                    <input type="hidden" name="recoveryChoice" value="recover" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div class="recovery-actions">
                        <a href="/Auth/Login" class="btn btn-secondary btn-sm">Cancel</a>
                        <button type="submit" class="btn btn-success btn-sm">Recover Account</button>
                    </div>
                </form>
            </div>
        </div>
    }
</section>

<style>
