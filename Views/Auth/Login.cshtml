    --auth-ink: #172033;
    --auth-muted: #5a667a;
    --auth-line: rgba(23, 32, 51, 0.14);
    --auth-coral: #e45d48;
    --auth-teal: #168f98;
    --auth-sun: #f0bd4f;
    --auth-blue: #3758d6;
    --auth-plum: #8a3c6b;
    --auth-shadow: 0 24px 70px rgba(23, 32, 51, 0.18);
    --auth-heading: #101826;
    --auth-subtle-ink: #20364a;
    --auth-stage-bg:
