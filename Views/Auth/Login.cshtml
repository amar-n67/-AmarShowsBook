@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewBag.ReturnUrl ?? "";
}

<section class="auth-stage">
    <div class="auth-progress" aria-hidden="true"><span></span></div>
    <div class="auth-dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="auth-shell">
        <div class="auth-hero motion-surface" data-auth-tilt>
            <div class="auth-brand">
                <img src="~/images/brand/showtime-login-logo-tight.png" alt="showTime logo" asp-append-version="true" />
                <span>showTime</span>
            </div>

            <span class="auth-kicker">Account access premiere</span>
            <h1>Continue your show.</h1>
            <p>
                Login to book seats, complete payments, view tickets, manage wallet activity, and return exactly where you left.
            </p>

            <div class="auth-ad-strip" aria-label="Login highlights">
                <span>Fast booking</span>
                <span>Secure payment</span>
                <span>Wallet ready</span>
                <span>Ticket access</span>
            </div>

            <div class="auth-logo-theater" aria-hidden="true">
                <span class="auth-logo-ring"></span>
                <span class="auth-logo-ring two"></span>
                <img src="~/images/brand/showtime-login-logo-tight.png" alt="" asp-append-version="true" />
                <span class="auth-orbit one">Book</span>
                <span class="auth-orbit two">Pay</span>
                <span class="auth-orbit three">Go</span>
            </div>
        </div>

        <div class="auth-card motion-surface">
            <div class="auth-card-head">
                <span>Secure entry</span>
                <h2>Login</h2>
                <p>Use your registered email and password to continue.</p>
            </div>

            <form method="post" novalidate onsubmit="return validateLoginForm()">
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="auth-field">
                    <label for="loginEmail">Email</label>
                    <input id="loginEmail" name="email" type="email" class="form-control" placeholder="artist@gmail.com" required />
                </div>

                <div class="auth-field">
                    <label for="loginPassword">Password</label>
                    <div class="input-group">
                        <input id="loginPassword" name="password" type="password" class="form-control" minlength="8"
                               pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$" required />
                        <button type="button" class="btn password-toggle" data-password-toggle="loginPassword" title="Show password" onclick="togglePassword('loginPassword', this)"></button>
                    </div>
                </div>

                <button class="btn auth-main-btn w-100">Enter showTime</button>
            </form>

            <div class="auth-login-links" aria-label="Login links">
                <a href="/Auth/Signup">Create account</a>
                <a href="/Auth/ForgotPassword">Recover access</a>
                <a href="/Home/Intro">Back to Intro</a>
            </div>

            <button type="button" class="btn auth-close-btn motion-surface" onclick="closeApplication()">
                Close Application
            </button>
        </div>
    </div>

    @if (ViewBag.RecoverArchiveId != null)
    {
        <div class="recovery-modal">
            <div class="recovery-dialog motion-surface" role="dialog" aria-modal="true" aria-labelledby="recoverAccountTitle">
                <span class="recovery-kicker">Deleted Account</span>
                <h2 id="recoverAccountTitle">Recover this account?</h2>
                <p>
                    This account was deleted, but it is still inside the 30 day recovery window.
                    Recover now to restore the archived account data.
                </p>
                <div class="recovery-meta">
                    <span>@ViewBag.RecoverEmail</span>
                    <strong>Available until @ViewBag.RecoverUntil</strong>
                </div>
                <form method="post" action="/Auth/RecoverDeletedAccount">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="archiveId" value="@ViewBag.RecoverArchiveId" />
                    <input type="hidden" name="recoveryChoice" value="recover" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div class="recovery-actions">
                        <a href="/Auth/Login" class="btn btn-secondary btn-sm">Cancel</a>
                        <button type="submit" class="btn btn-success btn-sm">Recover Account</button>
                    </div>
                </form>
            </div>
        </div>
    }
</section>

<style>
:root {
    --auth-ink: #172033;
    --auth-muted: #5a667a;
    --auth-line: rgba(23, 32, 51, 0.14);
    --auth-coral: #e45d48;
    --auth-teal: #168f98;
    --auth-sun: #f0bd4f;
    --auth-blue: #3758d6;
    --auth-plum: #8a3c6b;
    --auth-shadow: 0 24px 70px rgba(23, 32, 51, 0.18);
}

.auth-stage {
    position: relative;
    isolation: isolate;
    min-height: calc(100vh - 126px);
    overflow: hidden;
    padding: clamp(22px, 4vw, 52px) 0;
    color: var(--auth-ink);
    border-radius: 8px;
    background:
        radial-gradient(circle at 12% 8%, rgba(240, 189, 79, 0.28), transparent 26%),
        radial-gradient(circle at 88% 10%, rgba(22, 143, 152, 0.20), transparent 24%),
        linear-gradient(120deg, #f7fbf8 0%, #fff5df 46%, #f5d5ca 100%);
}

.auth-stage::before {
    position: absolute;
    inset: 0;
    z-index: -3;
    content: "";
    background-image:
        linear-gradient(rgba(23, 32, 51, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(23, 32, 51, 0.05) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.86), transparent 86%);
}

.auth-stage::after {
    position: absolute;
    inset: auto -8vw -24vh -8vw;
    z-index: -2;
    height: 48vh;
    content: "";
    background: linear-gradient(90deg, rgba(55, 88, 214, 0.13), rgba(22, 143, 152, 0.18), rgba(228, 93, 72, 0.14));
    filter: blur(18px);
    transform: skewY(-4deg);
}

.auth-progress {
    position: absolute;
    inset: 0 0 auto;
    z-index: 8;
    height: 4px;
    background: rgba(255, 255, 255, 0.45);
}

.auth-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--auth-coral), var(--auth-sun), var(--auth-teal), var(--auth-blue));
    transform: scaleX(0);
    transform-origin: left;
    animation: authProgress 5.8s ease forwards;
}

.auth-dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
}

.auth-dots span {
    position: absolute;
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(23, 32, 51, 0.18);
    animation: authDotFloat 13s linear infinite;
}

.auth-dots span:nth-child(1) { left: 8%; animation-duration: 12s; }
.auth-dots span:nth-child(2) { left: 28%; animation-duration: 16s; animation-delay: -4s; background: rgba(228, 93, 72, 0.22); }
.auth-dots span:nth-child(3) { left: 52%; animation-duration: 14s; animation-delay: -7s; background: rgba(22, 143, 152, 0.22); }
.auth-dots span:nth-child(4) { left: 74%; animation-duration: 18s; animation-delay: -2s; background: rgba(55, 88, 214, 0.20); }
.auth-dots span:nth-child(5) { left: 91%; animation-duration: 15s; animation-delay: -9s; background: rgba(240, 189, 79, 0.30); }

.auth-shell {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.78fr);
    gap: clamp(18px, 4vw, 42px);
    align-items: stretch;
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
}

.motion-surface {
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.motion-surface > :not(.cursor-glow) {
    position: relative;
    z-index: 1;
}

.cursor-glow {
    position: absolute;
    left: var(--pointer-x, 50%);
    top: var(--pointer-y, 50%);
    z-index: 0;
    width: 190px;
    height: 190px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.84) 0%, rgba(240, 189, 79, 0.28) 34%, transparent 68%);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    transition: opacity 0.22s ease, transform 0.22s ease;
}

.motion-surface:hover .cursor-glow,
.motion-surface:focus-within .cursor-glow {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
}

.auth-hero,
.auth-card {
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 28px;
    background: rgba(255, 253, 248, 0.72);
    box-shadow: var(--auth-shadow);
    backdrop-filter: blur(18px);
}

.auth-hero {
    display: grid;
    min-height: 640px;
    padding: clamp(24px, 4vw, 42px);
    overflow: hidden;
    animation: authCopyIn 0.78s ease both;
}

.auth-card {
    align-self: center;
    display: flex;
    flex-direction: column;
    min-height: 560px;
    padding: clamp(22px, 3vw, 30px);
    animation: authCardIn 0.78s ease 0.08s both;
}

.auth-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    padding: 8px 13px 8px 9px;
    border: 1px solid rgba(23, 32, 51, 0.10);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.62);
    font-weight: 900;
}

.auth-brand img {
    width: 42px;
    height: 42px;
    object-fit: contain;
}

.auth-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 34px 0 18px;
    color: #20364a;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.auth-kicker::before {
    width: 38px;
    height: 3px;
    border-radius: 999px;
    content: "";
    background: linear-gradient(90deg, var(--auth-coral), var(--auth-sun), var(--auth-teal));
}

.auth-hero h1 {
    max-width: 560px;
    margin: 0;
    color: #101826;
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    line-height: 0.94;
    letter-spacing: 0;
}

.auth-hero p {
    max-width: 560px;
    margin: 22px 0 0;
    color: #445066;
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.6;
}

.auth-ad-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
}

.auth-ad-strip span {
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 999px;
    color: #20364a;
    font-size: 0.8rem;
    font-weight: 900;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 12px 24px rgba(23, 32, 51, 0.08);
    animation: authAdPop 0.7s ease both, authAdBreathe 3.8s ease-in-out infinite;
}

.auth-ad-strip span:nth-child(2) { animation-delay: 0.08s, 0.5s; }
.auth-ad-strip span:nth-child(3) { animation-delay: 0.16s, 1s; }
.auth-ad-strip span:nth-child(4) { animation-delay: 0.24s, 1.5s; }

.auth-logo-theater {
    position: relative;
    display: grid;
    place-items: center;
    width: min(72vw, 360px);
    aspect-ratio: 1;
    margin: auto auto 0;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: 38px;
    background:
        linear-gradient(150deg, rgba(255, 253, 248, 0.88), rgba(255, 255, 255, 0.55)),
        linear-gradient(135deg, rgba(55, 88, 214, 0.10), rgba(22, 143, 152, 0.16));
    box-shadow: 0 22px 60px rgba(23, 32, 51, 0.16);
    animation: authFloatPanel 5.8s ease-in-out infinite;
}

.auth-logo-theater img {
    position: relative;
    z-index: 3;
    width: min(66%, 238px);
    height: min(66%, 238px);
    object-fit: contain;
    filter: drop-shadow(0 18px 26px rgba(23, 32, 51, 0.18));
    animation: authLogoPop 1.1s cubic-bezier(0.17, 0.84, 0.44, 1) both;
}

.auth-logo-ring {
    position: absolute;
    inset: 28px;
    border: 1px dashed rgba(22, 143, 152, 0.34);
    border-radius: 999px;
    animation: authLogoSpin 22s linear infinite;
}

.auth-logo-ring.two {
    inset: 68px;
    border-color: rgba(228, 93, 72, 0.32);
    animation-direction: reverse;
    animation-duration: 16s;
}

.auth-orbit {
    position: absolute;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 20px;
    color: #fffefa;
    font-size: 0.75rem;
    font-weight: 900;
    background: #20364a;
    box-shadow: 0 18px 30px rgba(23, 32, 51, 0.18);
    animation: authFloatChip 4.5s ease-in-out infinite;
}

.auth-orbit.one { top: 28px; right: 18px; background: var(--auth-coral); }
.auth-orbit.two { bottom: 46px; left: 10px; background: var(--auth-teal); animation-delay: -1.1s; }
.auth-orbit.three { right: 34px; bottom: 14px; background: var(--auth-plum); animation-delay: -2.2s; }

.auth-card-head {
    margin-bottom: 24px;
}

.auth-card-head span {
    display: inline-flex;
    margin-bottom: 10px;
    color: #20364a;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.auth-card-head h2 {
    margin: 0;
    color: #101826;
    font-size: clamp(2rem, 4vw, 3.1rem);
    line-height: 1;
}

.auth-card-head p {
    margin: 10px 0 0;
    color: var(--auth-muted);
    line-height: 1.55;
}

.auth-card form {
    display: grid;
    gap: 16px;
}

.auth-field {
    animation: authFieldIn 0.55s ease both;
}

.auth-field:nth-child(3) {
    animation-delay: 0.08s;
}

.auth-field label {
    display: block;
    margin-bottom: 7px;
    color: #20364a;
    font-size: 0.86rem;
    font-weight: 900;
}

.auth-card .form-control {
    min-height: 50px;
    border: 1px solid rgba(23, 32, 51, 0.14);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.76);
    color: #172033;
    font-weight: 700;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.auth-card .form-control:focus {
    border-color: var(--auth-teal);
    box-shadow: 0 0 0 4px rgba(22, 143, 152, 0.16);
    transform: translateY(-1px);
}

.auth-card .input-group .form-control {
    border-radius: 14px 0 0 14px;
}

.password-toggle {
    display: grid;
    place-items: center;
    min-width: 52px;
    border: 1px solid rgba(23, 32, 51, 0.14);
    border-left: 0;
    border-radius: 0 14px 14px 0;
    color: #20364a;
    background: rgba(255, 255, 255, 0.76);
}

.auth-main-btn,
.auth-close-btn {
    border-radius: 999px;
    font-weight: 900;
}

.auth-main-btn {
    min-height: 52px;
    margin-top: 4px;
    border: 0;
    color: #fffefa;
    background: linear-gradient(135deg, var(--auth-teal), var(--auth-blue));
    box-shadow: 0 16px 34px rgba(55, 88, 214, 0.18);
}

.auth-main-btn:hover,
.auth-main-btn:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 20px 42px rgba(55, 88, 214, 0.24);
}

.auth-login-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px 16px;
    margin-top: 18px;
    font-size: 0.9rem;
    font-weight: 900;
}

.auth-login-links a {
    color: #20364a;
    text-decoration: underline;
    text-decoration-color: rgba(22, 143, 152, 0.45);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: color 0.18s ease, text-decoration-color 0.18s ease;
}

.auth-login-links a:hover,
.auth-login-links a:focus-visible {
    color: var(--auth-teal);
    text-decoration-color: currentColor;
}

.auth-close-btn {
    min-height: 44px;
    margin-top: auto;
    border: 1px solid rgba(228, 93, 72, 0.36);
    color: #9f2e27;
    background: rgba(228, 93, 72, 0.10);
}

.recovery-modal {
    position: fixed;
    inset: 0;
    z-index: 1050;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(15, 20, 28, 0.62);
    backdrop-filter: blur(14px);
}

.recovery-dialog {
    width: min(100%, 460px);
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.74);
    border-radius: 24px;
    color: var(--auth-ink);
    background: rgba(255, 253, 248, 0.92);
    box-shadow: var(--auth-shadow);
}

.recovery-kicker {
    display: inline-flex;
    margin-bottom: 8px;
    color: #dc3545;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.recovery-dialog h2 {
    margin: 0 0 10px;
    font-weight: 900;
}

.recovery-dialog p {
    margin: 0;
    color: var(--auth-muted);
}

.recovery-meta {
    display: grid;
    gap: 4px;
    margin: 16px 0;
    padding: 12px;
    border: 1px solid var(--auth-line);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.72);
}

.recovery-meta span {
    font-weight: 850;
}

.recovery-meta strong {
    color: #198754;
    font-size: 0.86rem;
}

.recovery-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

@@media (max-width: 940px) {
    .auth-shell {
        grid-template-columns: 1fr;
        width: min(100% - 24px, 620px);
    }

    .auth-hero {
        min-height: auto;
    }

    .auth-logo-theater {
        width: min(82vw, 300px);
        margin-top: 28px;
    }

    .auth-card {
        min-height: auto;
    }
}

@@media (max-width: 560px) {
    .auth-stage {
        min-height: calc(100vh - 98px);
        padding: 14px 0 28px;
    }

    .auth-shell {
        width: min(100% - 18px, 620px);
    }

    .auth-hero,
    .auth-card {
        border-radius: 22px;
        padding: 20px;
    }

    .auth-hero h1 {
        font-size: clamp(2.35rem, 16vw, 4rem);
    }

    .auth-login-links {
        align-items: flex-start;
        flex-direction: column;
    }

    .auth-orbit {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        font-size: 0.68rem;
    }
}

@@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

@@keyframes authProgress {
    to { transform: scaleX(1); }
}

@@keyframes authDotFloat {
    from {
        transform: translateY(108vh) scale(0.7);
        opacity: 0;
    }
    18% { opacity: 1; }
    to {
        transform: translateY(-12vh) scale(1.2);
        opacity: 0;
    }
}

@@keyframes authCopyIn {
    from {
        opacity: 0;
        transform: translateY(22px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes authCardIn {
    from {
        opacity: 0;
        transform: translateY(28px) scale(0.98);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@@keyframes authFieldIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes authAdPop {
    from {
        opacity: 0;
        transform: translateY(10px) scale(0.96);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@@keyframes authAdBreathe {
    0%, 100% {
        transform: translateY(0);
        border-color: rgba(255, 255, 255, 0.82);
    }
    50% {
        transform: translateY(-3px);
        border-color: rgba(22, 143, 152, 0.34);
    }
}

@@keyframes authFloatPanel {
    0%, 100% {
        transform: rotateX(6deg) rotateY(-6deg) translateY(0);
    }
    50% {
        transform: rotateX(2deg) rotateY(6deg) translateY(-12px);
    }
}

@@keyframes authFloatChip {
    0%, 100% {
        transform: translateY(0) rotate(-2deg);
    }
    50% {
        transform: translateY(-12px) rotate(4deg);
    }
}

@@keyframes authLogoPop {
    from {
        opacity: 0;
        transform: scale(0.72) rotate(-7deg);
    }
    to {
        opacity: 1;
        transform: scale(1) rotate(0);
    }
}

@@keyframes authLogoSpin {
    to { transform: rotate(360deg); }
}
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("[data-current-version]").forEach(function (item) {
                item.textContent = window.currentAppVersion || "1.0.0";
            });

            const titleFrames = [
                "showTime - Login",
                "Book Shows Faster",
                "Secure Account Access",
                "Return To Booking"
            ];
            let titleIndex = 0;

            setInterval(function () {
                document.title = titleFrames[titleIndex % titleFrames.length];
                titleIndex += 1;
            }, 1500);

            document
                .querySelectorAll(".motion-surface, .auth-main-btn, .auth-close-btn")
                .forEach(function (surface) {
                    if (!surface.querySelector(".cursor-glow")) {
                        const glow = document.createElement("span");
                        glow.className = "cursor-glow";
                        glow.setAttribute("aria-hidden", "true");
                        surface.appendChild(glow);
                    }

                    surface.addEventListener("pointermove", function (event) {
                        const rect = surface.getBoundingClientRect();
                        const x = ((event.clientX - rect.left) / rect.width) * 100;
                        const y = ((event.clientY - rect.top) / rect.height) * 100;
                        const rotateY = (x - 50) * 0.04;
                        const rotateX = (50 - y) * 0.04;

                        surface.style.setProperty("--pointer-x", x.toFixed(2) + "%");
                        surface.style.setProperty("--pointer-y", y.toFixed(2) + "%");
                        surface.style.transform = "translateY(-3px) rotateX(" + rotateX.toFixed(2) + "deg) rotateY(" + rotateY.toFixed(2) + "deg)";
                    });

                    surface.addEventListener("pointerleave", function () {
                        surface.style.transform = "";
                    });
                });

            const tiltPanel = document.querySelector("[data-auth-tilt]");

            if (tiltPanel && window.matchMedia("(pointer: fine)").matches) {
                tiltPanel.addEventListener("mousemove", function (event) {
                    const rect = tiltPanel.getBoundingClientRect();
                    const x = (event.clientX - rect.left) / rect.width - 0.5;
                    const y = (event.clientY - rect.top) / rect.height - 0.5;
                    tiltPanel.style.transform = "rotateX(" + (y * -3).toFixed(2) + "deg) rotateY(" + (x * 4).toFixed(2) + "deg)";
                });

                tiltPanel.addEventListener("mouseleave", function () {
                    tiltPanel.style.transform = "";
                });
            }

            const error = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Error ?? ""));
            const success = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"] ?? ""));

            if (success) {
                showCinemaPopup(success, "success");
            }
            if (error) {
                showCinemaPopup(error, "error");
            }
        });

        function closeApplication() {
            showCinemaPopup("This will stop the local application and try to close this tab.", "confirm", {
                title: "Pack Up?",
                okText: "Close App",
                cancelText: "Stay",
                onOk: function () {
                    fetch("/Auth/CloseApplication", { method: "POST" })
                        .finally(function () {
                            window.open("", "_self");
                            window.close();
                            document.body.innerHTML = "<main class='container mt-5'><div class='alert alert-success text-center'>Application closed. You may close this tab if the browser keeps it open.</div></main>";
                        });
                }
            });
        }

        function validateLoginForm() {
            const email = document.querySelector('input[name="email"]').value.trim();
            const password = document.getElementById("loginPassword").value;
            const emailMark = String.fromCharCode(64);
            const emailRegex = new RegExp("^[a-zA-Z0-9._%+-]+" + emailMark + "(gmail[.]com|outlook[.]com)$");
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$/;

            if (!emailRegex.test(email)) {
                showCinemaPopup("Only Gmail or Outlook email is allowed.", "error");
                return false;
            }

            if (!passwordRegex.test(password)) {
                showCinemaPopup("Password must be at least 8 characters and include uppercase, lowercase, and special character.", "error");
                return false;
            }

            return true;
        }
    </script>
}
