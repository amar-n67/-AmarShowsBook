    --auth-plum: #526174;
    --auth-stage-bg: linear-gradient(135deg, #dfe7f1, #f8fafc 50%, #fff7e6);
    --auth-panel-bg: rgba(249, 251, 255, 0.82);
    --auth-soft-bg: rgba(255, 255, 255, 0.70);
    --auth-field-bg: rgba(255, 255, 255, 0.88);
    --auth-grid-line: rgba(31, 41, 55, 0.05);
    --auth-glow-bg: linear-gradient(90deg, rgba(49, 95, 159, 0.14), rgba(163, 124, 64, 0.14));
