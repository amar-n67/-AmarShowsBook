    --auth-panel-bg: rgba(24, 34, 51, 0.82);
    --auth-soft-bg: rgba(248, 250, 252, 0.09);
    --auth-field-bg: rgba(32, 41, 58, 0.92);
    --auth-grid-line: rgba(248, 250, 252, 0.055);
    --auth-glow-bg: linear-gradient(90deg, rgba(122, 140, 255, 0.16), rgba(45, 212, 191, 0.14), rgba(220, 76, 100, 0.12));
    --auth-notice-bg: rgba(24, 34, 51, 0.92);
    --auth-notice-border: rgba(45, 212, 191, 0.24);
    --auth-danger-soft: rgba(220, 76, 100, 0.15);
    --auth-danger-text: #fecdd3;
}

html[data-theme="cinema"] {
    --auth-ink: #182536;
    --auth-muted: #526274;
    --auth-line: rgba(24, 37, 54, 0.14);
    --auth-heading: #101826;
    --auth-subtle-ink: #20364a;
    --auth-coral: #e45d48;
    --auth-teal: #168f98;
    --auth-sun: #f0bd4f;
    --auth-blue: #0f7f8a;
    --auth-plum: #8a3c6b;
    --auth-stage-bg:
        radial-gradient(circle at 12% 8%, rgba(240, 189, 79, 0.28), transparent 26%),
        radial-gradient(circle at 88% 10%, rgba(22, 143, 152, 0.20), transparent 24%),
        linear-gradient(120deg, #f7fbf8 0%, #fff5df 46%, #f5d5ca 100%);
    --auth-panel-bg: rgba(255, 253, 248, 0.72);
    --auth-soft-bg: rgba(255, 255, 255, 0.62);
    --auth-field-bg: rgba(255, 255, 255, 0.78);
    --auth-grid-line: rgba(24, 37, 54, 0.05);
    --auth-glow-bg: linear-gradient(90deg, rgba(15, 127, 138, 0.13), rgba(240, 189, 79, 0.18), rgba(228, 93, 72, 0.14));
    --auth-notice-bg: rgba(255, 253, 248, 0.88);
    --auth-notice-border: rgba(22, 143, 152, 0.24);
}

.auth-stage {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    gap: 14px;
    min-height: calc(100svh - 104px);
    overflow: hidden;
    padding: clamp(10px, 2vh, 22px) 0;
    color: var(--auth-ink);
    border-radius: 8px;
    background: var(--auth-stage-bg);
}

.auth-stage *,
.auth-stage *::before,
.auth-stage *::after {
    box-sizing: border-box;
}

.auth-stage::before {
    position: absolute;
    inset: 0;
    z-index: -3;
    content: "";
    background-image:
        linear-gradient(var(--auth-grid-line) 1px, transparent 1px),
        linear-gradient(90deg, var(--auth-grid-line) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.86), transparent 86%);
}

.auth-stage::after {
    position: absolute;
    inset: auto -8vw -24vh -8vw;
    z-index: -2;
    height: 48vh;
    content: "";
    background: var(--auth-glow-bg);
    filter: blur(18px);
    transform: skewY(-4deg);
}

.auth-progress {
    position: absolute;
    inset: 0 0 auto;
    z-index: 8;
    height: 4px;
    background: rgba(255, 255, 255, 0.45);
}

.auth-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--auth-coral), var(--auth-sun), var(--auth-teal), var(--auth-blue));
    transform: scaleX(0);
    transform-origin: left;
    animation: authProgress 5.8s ease forwards;
}

.auth-dots {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
}

.auth-dots span {
    position: absolute;
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(23, 32, 51, 0.18);
    animation: authDotFloat 13s linear infinite;
}

.auth-dots span:nth-child(1) { left: 8%; animation-duration: 12s; }
.auth-dots span:nth-child(2) { left: 28%; animation-duration: 16s; animation-delay: -4s; background: rgba(228, 93, 72, 0.22); }
.auth-dots span:nth-child(3) { left: 52%; animation-duration: 14s; animation-delay: -7s; background: rgba(22, 143, 152, 0.22); }
.auth-dots span:nth-child(4) { left: 74%; animation-duration: 18s; animation-delay: -2s; background: rgba(55, 88, 214, 0.20); }
.auth-dots span:nth-child(5) { left: 91%; animation-duration: 15s; animation-delay: -9s; background: rgba(240, 189, 79, 0.30); }

.auth-shell {
    position: relative;
    z-index: 2;
    width: min(1140px, calc(100% - 28px));
    margin: 0 auto;
}

.motion-surface {
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.motion-surface > :not(.cursor-glow) {
    position: relative;
    z-index: 1;
}

.cursor-glow {
    position: absolute;
    left: var(--pointer-x, 50%);
    top: var(--pointer-y, 50%);
    z-index: 0;
    width: 190px;
    height: 190px;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.84) 0%, rgba(240, 189, 79, 0.28) 34%, transparent 68%);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    transition: opacity 0.22s ease, transform 0.22s ease;
}

.motion-surface:hover .cursor-glow,
.motion-surface:focus-within .cursor-glow {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
}

.auth-hero {
    min-width: 0;
    border: 1px solid var(--auth-line);
    border-radius: 28px;
    background: var(--auth-panel-bg);
    box-shadow: var(--auth-shadow);
    backdrop-filter: blur(18px);
}

.auth-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 460px);
    gap: clamp(18px, 3vw, 34px);
    align-items: center;
    min-height: min(620px, calc(100svh - 150px));
    padding: clamp(20px, 3vw, 34px);
    overflow: hidden;
    animation: authCopyIn 0.78s ease both;
}

.auth-copy-panel {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
}

.auth-card {
    align-self: center;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    padding: clamp(18px, 2.2vw, 26px);
    border: 1px solid var(--auth-line);
    border-radius: 24px;
    background:
        linear-gradient(150deg, var(--auth-soft-bg), rgba(255, 255, 255, 0.36));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(12px);
    animation: authCardIn 0.78s ease 0.08s both;
}

html[data-theme="dark"] .auth-card {
    background:
        linear-gradient(150deg, rgba(248, 250, 252, 0.12), rgba(15, 23, 42, 0.42));
    box-shadow: inset 0 1px 0 rgba(248, 250, 252, 0.14);
}

.auth-brand-row {
    display: inline-flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 10px;
    width: fit-content;
    max-width: 100%;
}

.auth-brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 10px;
    width: fit-content;
    max-width: 100%;
    padding: 8px 13px 8px 9px;
    border: 1px solid var(--auth-line);
    border-radius: 999px;
    color: var(--auth-heading);
    background: var(--auth-soft-bg);
    font-weight: 900;
}

.auth-brand img {
    width: 42px;
    height: 42px;
    object-fit: contain;
}

.auth-device-note {
    display: none;
    color: #dc2626;
    font-size: 0.64rem;
    font-weight: 900;
    line-height: 1.15;
    white-space: nowrap;
}

.auth-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 24px 0 14px;
    color: var(--auth-subtle-ink);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
}

.auth-kicker::before {
    width: 38px;
    height: 3px;
    border-radius: 999px;
    content: "";
    background: linear-gradient(90deg, var(--auth-coral), var(--auth-sun), var(--auth-teal));
}

.auth-hero h1 {
    max-width: 560px;
    margin: 0;
    color: var(--auth-heading);
    font-size: clamp(2.35rem, 5vw, 4.7rem);
    line-height: 0.94;
    letter-spacing: 0;
}

.auth-hero p {
    max-width: 560px;
    margin: 16px 0 0;
    color: var(--auth-muted);
    font-size: clamp(0.98rem, 1.7vw, 1.08rem);
    line-height: 1.6;
    overflow-wrap: anywhere;
}

.auth-ad-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
}

.auth-ad-strip span {
    min-width: 0;
    padding: 8px 12px;
    border: 1px solid var(--auth-line);
    border-radius: 999px;
    color: var(--auth-subtle-ink);
    font-size: 0.8rem;
    font-weight: 900;
    overflow-wrap: anywhere;
    background: var(--auth-soft-bg);
    box-shadow: 0 12px 24px rgba(23, 32, 51, 0.08);
    animation: authAdPop 0.7s ease both, authAdBreathe 3.8s ease-in-out infinite;
}

.auth-ad-strip span:nth-child(2) { animation-delay: 0.08s, 0.5s; }
.auth-ad-strip span:nth-child(3) { animation-delay: 0.16s, 1s; }
.auth-ad-strip span:nth-child(4) { animation-delay: 0.24s, 1.5s; }

.auth-logo-theater {
    position: relative;
    display: grid;
    place-items: center;
    width: min(30vw, 240px);
    aspect-ratio: 1;
    margin: auto auto 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    animation: authFloatPanel 5.8s ease-in-out infinite;
}

.auth-logo-theater img {
    position: relative;
    z-index: 3;
    width: min(66%, 160px);
    height: min(66%, 160px);
    object-fit: contain;
    filter: drop-shadow(0 18px 26px rgba(23, 32, 51, 0.18));
    animation: authLogoPop 1.1s cubic-bezier(0.17, 0.84, 0.44, 1) both;
}

.auth-logo-ring {
    position: absolute;
    inset: 22px;
    border: 0;
    border-radius: 999px;
    animation: authLogoSpin 22s linear infinite;
}

.auth-logo-ring.two {
    inset: 54px;
    animation-direction: reverse;
    animation-duration: 16s;
}

.auth-orbit {
    position: absolute;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border: 0;
    border-radius: 18px;
    color: #fffefa;
    font-size: 0.75rem;
    font-weight: 900;
    background: #20364a;
    box-shadow: 0 18px 30px rgba(23, 32, 51, 0.18);
    animation: authFloatChip 4.5s ease-in-out infinite;
}

.auth-orbit.one { top: 28px; right: 18px; background: var(--auth-coral); }
.auth-orbit.two { bottom: 34px; left: 8px; background: var(--auth-teal); animation-delay: -1.1s; }
.auth-orbit.three { right: 24px; bottom: 10px; background: var(--auth-plum); animation-delay: -2.2s; }

.auth-card-head {
    margin-bottom: 18px;
}

.auth-card-head span {
    display: inline-flex;
    margin-bottom: 10px;
    color: var(--auth-subtle-ink);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.auth-card-head h2 {
    margin: 0;
    color: var(--auth-heading);
    font-size: clamp(1.85rem, 3vw, 2.65rem);
    line-height: 1;
}

.auth-card-head p {
    margin: 10px 0 0;
    color: var(--auth-muted);
    line-height: 1.55;
}

.auth-card form {
    display: grid;
    gap: 13px;
}

.auth-field {
    animation: authFieldIn 0.55s ease both;
}

.auth-field:nth-child(3) {
    animation-delay: 0.08s;
}

.auth-field label {
    display: block;
    margin-bottom: 7px;
    color: var(--auth-subtle-ink);
    font-size: 0.86rem;
    font-weight: 900;
}

.auth-card .form-control {
    min-height: 48px;
    border: 1px solid var(--auth-line);
    border-radius: 14px;
    background: var(--auth-field-bg);
    color: var(--auth-ink);
    font-weight: 700;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.auth-card .form-control:focus {
    border-color: var(--auth-teal);
    box-shadow: 0 0 0 4px rgba(22, 143, 152, 0.16);
    transform: translateY(-1px);
}

.auth-card .input-group .form-control {
    border-radius: 14px 0 0 14px;
}

.password-toggle {
    display: grid;
    place-items: center;
    min-width: 52px;
    border: 1px solid var(--auth-line);
    border-left: 0;
    border-radius: 0 14px 14px 0;
    color: var(--auth-subtle-ink);
    background: var(--auth-field-bg);
}

.auth-main-btn,
.auth-close-btn {
    border-radius: 999px;
    font-weight: 900;
}

.auth-main-btn {
    min-height: 52px;
    margin-top: 4px;
    border: 0;
    color: #fffefa;
    background: linear-gradient(135deg, var(--auth-teal), var(--auth-blue));
    box-shadow: 0 16px 34px rgba(55, 88, 214, 0.18);
}

.auth-main-btn:hover,
.auth-main-btn:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 20px 42px rgba(55, 88, 214, 0.24);
}

.auth-login-links {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(8px, 1.6vw, 18px);
    width: 100%;
    margin-top: 14px;
    font-size: clamp(0.68rem, 0.82vw, 0.82rem);
    font-weight: 900;
    white-space: nowrap;
}

.auth-login-links a {
