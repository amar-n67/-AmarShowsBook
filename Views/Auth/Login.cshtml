@{
    ViewData["Title"] = "Login";
}

<section class="auth-stage">
    <div class="auth-frame">
        <div class="auth-copy">
            @* Previous wording: "Shot 01 / Entry Gate" *@
            <span class="auth-kicker">Account Access</span>
            <h1>showTime</h1>
            @* Previous wording: "Take your mark, verify the script, and open the next scene." *@
            <p>Sign in securely to continue to your account.</p>
            <small class="auth-version">Version <span data-current-version></span></small>
        </div>

        <div class="auth-card">
            <div class="auth-slate">
                @* Previous wording: "Rolling" *@
                <span>Secure</span>
                @* Previous wording: "Login Take" *@
                <span>Login</span>
            </div>

            <form method="post" novalidate onsubmit="return validateLoginForm()">
                <div class="mb-3">
                    <label>Email</label>
                    <input name="email" type="email" class="form-control" placeholder="artist@gmail.com" required />
                </div>

                <div class="mb-3">
                    <label>Password</label>
                    <div class="input-group">
                        <input id="loginPassword" name="password" type="password" class="form-control" minlength="8"
                               pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$" required />
                        <button type="button" class="btn btn-outline-light" data-password-toggle="loginPassword" title="Show password" onclick="togglePassword('loginPassword', this)">
                        </button>
                    </div>
                </div>

                <button class="btn btn-primary w-100 auth-main-btn">Enter The Set</button>
            </form>

            <div class="auth-links">
                <a href="/Auth/Signup">Create your opening credit</a>
                <a href="/Auth/ForgotPassword">Forgot the script?</a>
            </div>

            <button type="button" class="btn btn-danger w-100 auth-close-btn" onclick="closeApplication()">
                Close Application
            </button>
        </div>
    </div>

    @if (ViewBag.RecoverArchiveId != null)
    {
        <div class="recovery-modal">
            <div class="recovery-dialog" role="dialog" aria-modal="true" aria-labelledby="recoverAccountTitle">
                <span class="recovery-kicker">Deleted Account</span>
                <h2 id="recoverAccountTitle">Recover this account?</h2>
                <p>
                    This account was deleted, but it is still inside the 30 day recovery window.
                    Recover now to restore the archived account data.
                </p>
                <div class="recovery-meta">
                    <span>@ViewBag.RecoverEmail</span>
                    <strong>Available until @ViewBag.RecoverUntil</strong>
                </div>
                <form method="post" action="/Auth/RecoverDeletedAccount">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="archiveId" value="@ViewBag.RecoverArchiveId" />
                    <input type="hidden" name="recoveryChoice" value="recover" />
                    <div class="recovery-actions">
                        <a href="/Auth/Login" class="btn btn-secondary btn-sm">Cancel</a>
                        <button type="submit" class="btn btn-success btn-sm">Recover Account</button>
                    </div>
                </form>
            </div>
        </div>
    }
</section>

<style>
.auth-stage {
    min-height: calc(100vh - 190px);
    display: grid;
    align-items: center;
    padding: 24px 0 44px;
}
.auth-frame {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 440px);
    gap: 28px;
    align-items: stretch;
}
.auth-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 430px;
    overflow: hidden;
    border-radius: 8px;
    padding: 34px;
    color: #231f20;
    background:
        linear-gradient(135deg, rgba(255, 242, 199, 0.92), rgba(245, 178, 196, 0.88), rgba(146, 229, 221, 0.86)),
        repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px);
    box-shadow: 0 24px 70px rgba(35, 31, 32, 0.24);
}
.auth-copy h1 {
    margin: 8px 0 8px;
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 900;
    color: #231f20;
}
.auth-copy p {
    max-width: 520px;
    margin: 0;
    color: #34303a;
    font-size: 1.08rem;
}
.auth-version {
    display: inline-flex;
    width: fit-content;
    margin-top: 14px;
    padding: 5px 10px;
    border: 1px solid rgba(35,31,32,0.18);
    border-radius: 999px;
    color: #34303a;
    font-weight: 900;
}
.auth-kicker,
.auth-slate {
    text-transform: uppercase;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.08em;
}
.auth-card {
    align-self: center;
    overflow: hidden;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    box-shadow: 0 22px 58px rgba(0,0,0,0.24);
}
.auth-slate {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    background: var(--app-nav);
    color: var(--app-nav-text);
}
.auth-card form,
.auth-links,
.auth-close-btn {
    margin: 22px;
}
.auth-card label {
    margin-bottom: 6px;
    font-weight: 800;
}
.auth-main-btn {
    min-height: 44px;
    font-weight: 850;
}
.auth-links {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
}
.auth-close-btn {
    width: calc(100% - 44px) !important;
    font-weight: 850;
}
.recovery-modal {
    position: fixed;
    inset: 0;
    z-index: 1050;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(15, 20, 28, 0.66);
    backdrop-filter: blur(12px);
}
.recovery-dialog {
    width: min(100%, 460px);
    border: 1px solid color-mix(in srgb, var(--app-input-border) 70%, #ffffff 30%);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    padding: 24px;
    box-shadow: 0 28px 80px rgba(0,0,0,0.32);
}
.recovery-kicker {
    display: inline-flex;
    margin-bottom: 8px;
    color: #dc3545;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}
.recovery-dialog h2 {
    margin: 0 0 10px;
    font-weight: 900;
}
.recovery-dialog p {
    margin: 0;
    color: var(--app-muted);
}
.recovery-meta {
    display: grid;
    gap: 4px;
    margin: 16px 0;
    padding: 12px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-input);
}
.recovery-meta span {
    font-weight: 850;
}
.recovery-meta strong {
    color: #198754;
    font-size: 0.86rem;
}
.recovery-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}
@@media (max-width: 840px) {
    .auth-frame {
        grid-template-columns: 1fr;
    }
    .auth-copy {
        min-height: 260px;
    }
}
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("[data-current-version]").forEach(item => {
                item.textContent = window.currentAppVersion || "1.0.0";
            });

            const error = "@ViewBag.Error";
            const success = "@TempData["Success"]";
            if (success) {
                showCinemaPopup(success, "success");
            }
            if (error) {
                showCinemaPopup(error, "error");
            }
        });

        function closeApplication() {
            showCinemaPopup("This will stop the local application and try to close this tab.", "confirm", {
                title: "Pack Up?",
                okText: "Close App",
                cancelText: "Stay",
                onOk: function () {
                    fetch("/Auth/CloseApplication", { method: "POST" })
                        .finally(function () {
                            window.open("", "_self");
                            window.close();
                            document.body.innerHTML = "<main class='container mt-5'><div class='alert alert-success text-center'>Application closed. You may close this tab if the browser keeps it open.</div></main>";
                        });
                }
            });
        }

        function validateLoginForm() {
            const email = document.querySelector('input[name="email"]').value.trim();
            const password = document.getElementById("loginPassword").value;
            const emailMark = String.fromCharCode(64);
            const emailRegex = new RegExp("^[a-zA-Z0-9._%+-]+" + emailMark + "(gmail[.]com|outlook[.]com)$");
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$/;

            if (!emailRegex.test(email)) {
                showCinemaPopup("Only Gmail or Outlook email is allowed.", "error");
                return false;
            }

            if (!passwordRegex.test(password)) {
                showCinemaPopup("Password must be at least 8 characters and include uppercase, lowercase, and special character.", "error");
                return false;
            }

            return true;
        }
    </script>
}
