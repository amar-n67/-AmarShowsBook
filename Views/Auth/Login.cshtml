    --auth-subtle-ink: #e2e8f0;
    --auth-coral: #dc4c64;
    --auth-teal: #2dd4bf;
    --auth-sun: #ffd166;
    --auth-blue: #7a8cff;
    --auth-plum: #bf7fb0;
