<div class="card p-4 mx-auto auth-mini">
<h3 class="text-center mb-2">Enter Secret Code</h3>
<p class="text-center text-muted">Lock the scene before resetting password.</p>

<form method="post" action="/Auth/VerifyOTP">

    <input name="otp" class="form-control mb-3" placeholder="Enter OTP" required />

    <div class="d-flex justify-content-between">
        <button class="btn btn-primary">Verify</button>
        <a href="/Auth/Login" class="btn btn-secondary">Back To Gate</a>
    </div>

</form>
</div>

<style>
.auth-mini {
    max-width: 480px;
    border-radius: 8px;
}
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const error = "@ViewBag.Error";
            if (error) showCinemaPopup(error, "error");
        });
    </script>
}
