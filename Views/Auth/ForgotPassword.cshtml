<h3 class="text-center mb-4">🔐 Recover Your Account</h3>

<form method="post" action="/Auth/SendOTP">

    <input name="email" class="form-control mb-3" placeholder="Enter your email" required />

    <div class="d-flex justify-content-between">
        <button class="btn btn-warning">Send OTP</button>
        <a href="/Auth/Login" class="btn btn-secondary">Cancel</a>
    </div>

</form>

<p class="text-danger text-center">@ViewBag.Error</p>
<p class="text-success text-center">@ViewBag.Message</p>