<div class="card p-4 mx-auto auth-mini">
<h3 class="text-center mb-2">Recover Your Account</h3>
<p class="text-center text-muted">Send a secret code before the next password retake.</p>

<form method="post" action="/Auth/SendOTP" onsubmit="return validateForgotPasswordForm()">

    <label>Email</label>
    <input id="forgotEmail" name="email" type="email" class="form-control mb-3" placeholder="Enter Gmail or Outlook email" required />

    <div class="d-flex justify-content-between">
        <button class="btn btn-warning">Send Secret Code</button>
        <a href="/Auth/Login" class="btn btn-secondary">Back To Gate</a>
    </div>

</form>
</div>

<style>
.auth-mini {
    max-width: 480px;
    border-radius: 8px;
}
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const error = "@ViewBag.Error";
            const message = "@ViewBag.Message";
            if (error) showCinemaPopup(error, "error");
            if (message) showCinemaPopup(message, "success");
        });

        function validateForgotPasswordForm() {
            const email = document.getElementById("forgotEmail").value.trim();
            const emailMark = String.fromCharCode(64);
            const emailRegex = new RegExp("^[a-zA-Z0-9._%+-]+" + emailMark + "(gmail[.]com|outlook[.]com)$");

            if (!emailRegex.test(email)) {
                showCinemaPopup("Only Gmail or Outlook email is allowed.", "error");
                return false;
            }

            return true;
        }
    </script>
}
