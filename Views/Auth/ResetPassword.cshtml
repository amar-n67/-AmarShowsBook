<div class="card p-4 mx-auto auth-mini">
<h3 class="text-center mb-2">Reset Password</h3>
<p class="text-center text-muted">Minimum 8 characters with uppercase, lowercase, and special character.</p>

<form method="post" action="/Auth/ResetPassword" onsubmit="return validateResetPasswordForm()">

    <label>New Password</label>
    <div class="input-group mb-3">
        <input id="resetPassword" name="password" type="password" minlength="8"
               pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$"
               class="form-control" placeholder="Minimum 8 characters" required />
        <button type="button" class="btn btn-outline-light" data-password-toggle="resetPassword" title="Show password" onclick="togglePassword('resetPassword', this)"></button>
    </div>

    <label>Confirm Password</label>
    <div class="input-group mb-3">
        <input id="resetConfirmPassword" name="confirmPassword" type="password" minlength="8"
               pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$"
               class="form-control" placeholder="Repeat new password" required />
        <button type="button" class="btn btn-outline-light" data-password-toggle="resetConfirmPassword" title="Show password" onclick="togglePassword('resetConfirmPassword', this)"></button>
    </div>

    <div class="d-flex justify-content-between">
        <button class="btn btn-success">Update Password</button>
        @* Previous wording: "Back To Gate" *@
        <a href="/Auth/Login" class="btn btn-secondary">Back To Login</a>
    </div>

</form>
</div>

<style>
.auth-mini {
    max-width: 480px;
    border-radius: 8px;
}
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const error = "@ViewBag.Error";
            if (error) showCinemaPopup(error, "error");
        });

        function validateResetPasswordForm() {
            const password = document.getElementById("resetPassword").value;
            const confirmPassword = document.getElementById("resetConfirmPassword").value;
            const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9]).{8,}$/;

            if (!passwordRegex.test(password)) {
                showCinemaPopup("Password must be at least 8 characters and include uppercase, lowercase, and special character.", "error");
                return false;
            }

            if (password !== confirmPassword) {
                showCinemaPopup("Both password fields must match.", "error");
                return false;
            }

            return true;
        }
    </script>
}
