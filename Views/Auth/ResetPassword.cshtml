<div class="card p-4 mx-auto auth-mini">
<h3 class="text-center mb-2">Reset Password</h3>
<p class="text-center text-muted">Minimum 8 characters for the fresh script.</p>

<form method="post" action="/Auth/ResetPassword">

    <input id="resetPassword" name="password" type="password" minlength="8" class="form-control mb-3" placeholder="New Password" required />

    <div class="d-flex justify-content-between">
        <button class="btn btn-success">Update Password</button>
        <button type="button" class="btn btn-outline-light" onclick="togglePassword('resetPassword')">View</button>
        <a href="/Auth/Login" class="btn btn-secondary">Back To Gate</a>
    </div>

</form>
</div>

<style>
.auth-mini {
    max-width: 480px;
    border-radius: 8px;
}
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const error = "@ViewBag.Error";
            if (error) showCinemaPopup(error, "error");
        });
    </script>
}
