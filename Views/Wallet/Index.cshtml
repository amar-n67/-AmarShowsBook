@model AmarShowsBook.Models.VwWalletSummary

@{
    ViewData["Title"] = "Wallet";
}

<section class="wallet-page">

    <div class="wallet-header">
        <div>
            <span class="wallet-kicker">Digital Wallet</span>

            <h1>Wallet Dashboard</h1>

            <p>
                Track balance, credits, debits,
                and loyalty points.
            </p>
        </div>
    </div>

    <div class="wallet-grid">

        <div class="wallet-card">
            <span>Wallet Balance</span>
            <strong>₹ @Model.WalletBalance</strong>
        </div>

        <div class="wallet-card">
            <span>Blocked Balance</span>
            <strong>₹ @Model.BlockedBalance</strong>
        </div>

        <div class="wallet-card">
            <span>Loyalty Points</span>
            <strong>@Model.LoyaltyPoints</strong>
        </div>

        <div class="wallet-card">
            <span>Total Credits</span>
            <strong>₹ @Model.TotalCredits</strong>
        </div>

        <div class="wallet-card">
            <span>Total Debits</span>
            <strong>₹ @Model.TotalDebits</strong>
        </div>

        <div class="wallet-card">
            <span>Total Transactions</span>
            <strong>@Model.TotalWalletTransactions</strong>
        </div>

    </div>

</section>

<style>

.wallet-page
{
    padding-bottom: 40px;
}

.wallet-header
{
    padding: 30px;

    border-radius: 8px;

    background:
        linear-gradient(
            135deg,
            rgba(255,242,199,0.94),
            rgba(245,178,196,0.86),
            rgba(146,229,221,0.86)
        );

    color: #231f20;

    margin-bottom: 24px;
}

.wallet-kicker
{
    text-transform: uppercase;

    font-size: 0.75rem;

    font-weight: 900;

    letter-spacing: 0.08em;
}

.wallet-grid
{
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 16px;
}

.wallet-card
{
    padding: 24px;

    border-radius: 8px;

    border: 1px solid var(--app-input-border);

    background: var(--app-card);

    color: var(--app-card-text);

    box-shadow: 0 12px 24px rgba(0,0,0,0.12);
}

.wallet-card span
{
    display: block;

    margin-bottom: 12px;

    font-size: 0.85rem;

    font-weight: 800;

    text-transform: uppercase;
}

.wallet-card strong
{
    font-size: 1.8rem;

    font-weight: 900;
}

@@media (max-width: 760px)
{
    .wallet-grid
    {
        grid-template-columns: 1fr;
    }
}

</style>