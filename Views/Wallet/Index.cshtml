@model AmarShowsBook.Models.Admin.VwWalletSummary

@{
    ViewData["Title"] = "Wallet";
}

<section class="wallet-page">

    <div class="wallet-header">
        <div>
            <span class="wallet-kicker">Digital Wallet</span>

            <h1>Wallet</h1>

            <p>
                Track balance, credits, debits, loyalty points, and the latest wallet movement.
            </p>
        </div>
        <div class="wallet-ticket">
            <span>Status</span>
            <strong>@Model.WalletStatus</strong>
        </div>
    </div>

    <div class="wallet-grid">

        <div class="wallet-card wallet-card-feature">
            <span>Wallet Balance</span>
            <strong>₹ @Model.WalletBalance.ToString("N2")</strong>
        </div>

        <div class="wallet-card">
            <span>Blocked Balance</span>
            <strong>₹ @Model.BlockedBalance.ToString("N2")</strong>
        </div>

        <div class="wallet-card">
            <span>Loyalty Points</span>
            <strong>@Model.LoyaltyPoints</strong>
        </div>

        <div class="wallet-card">
            <span>Total Credits</span>
            <strong>₹ @Model.TotalCredits.ToString("N2")</strong>
        </div>

        <div class="wallet-card">
            <span>Total Debits</span>
            <strong>₹ @Model.TotalDebits.ToString("N2")</strong>
        </div>

        <div class="wallet-card">
            <span>Total Transactions</span>
            <strong>@Model.TotalWalletTransactions</strong>
        </div>

    </div>

    <div class="wallet-strip">
        <div>
            <span>Last Transaction</span>
            <strong>@(Model.LastTransactionAt?.ToString("dd MMM yyyy hh:mm tt") ?? "No wallet transaction yet")</strong>
        </div>
        <a class="wallet-action" href="/Transaction/History">View Transactions</a>
    </div>

</section>

<style>

.wallet-page
{
    padding-bottom: 40px;
}

.wallet-header
{
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18px;
    min-height: 220px;
    padding: 30px;
    border-radius: 8px;
    background:
        repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px),
        linear-gradient(
            135deg,
            rgba(255,242,199,0.94),
            rgba(245,178,196,0.86),
            rgba(146,229,221,0.86)
        );
    color: #231f20;
    margin-bottom: 24px;
    margin-bottom: 18px;
    box-shadow: 0 22px 64px rgba(35,31,32,0.22);
}

.wallet-kicker
{
    text-transform: uppercase;

    font-size: 0.75rem;

    font-weight: 900;

    letter-spacing: 0.08em;
}

.wallet-header h1 {
    margin: 8px 0;
    color: #231f20;
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    font-weight: 900;
}

.wallet-header p {
    max-width: 620px;
    margin: 0;
    color: #34303a;
    font-size: 1.05rem;
}

.wallet-ticket {
    min-width: 170px;
    padding: 14px;
    border: 1px dashed rgba(35,31,32,0.44);
    border-radius: 8px;
    background: rgba(255,255,255,0.38);
    text-align: right;
}

.wallet-ticket span,
.wallet-strip span {
    display: block;
    color: var(--app-muted);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.wallet-ticket span {
    color: #34303a;
}

.wallet-ticket strong {
    color: #231f20;
    font-size: 1.2rem;
    font-weight: 900;
}

.wallet-grid
{
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 16px;
}

.wallet-card
{
    position: relative;
    overflow: hidden;
    padding: 24px;

    border-radius: 8px;

    border: 1px solid var(--app-input-border);

    background: var(--app-card);

    color: var(--app-card-text);

    box-shadow: 0 12px 24px rgba(0,0,0,0.12);
}

.wallet-card::after {
    content: "";
    position: absolute;
    inset: auto 18px 14px auto;
    width: 46px;
    height: 3px;
    border-radius: 999px;
    background: var(--app-accent);
    opacity: 0.75;
}

.wallet-card-feature {
    border-color: color-mix(in srgb, var(--app-accent) 58%, var(--app-input-border));
    background:
        linear-gradient(135deg, color-mix(in srgb, var(--app-accent) 18%, var(--app-card)), var(--app-card)) !important;
}

.wallet-card span
{
    display: block;

    margin-bottom: 12px;

    font-size: 0.85rem;

    font-weight: 800;

    text-transform: uppercase;
}

.wallet-card strong
{
    font-size: 1.8rem;

    font-weight: 900;
}

.wallet-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
    padding: 18px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    box-shadow: 0 14px 34px rgba(0,0,0,0.13);
}

.wallet-strip strong {
    display: block;
    margin-top: 4px;
    font-weight: 900;
}

.wallet-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border-radius: 999px;
    padding: 8px 16px;
    background: var(--app-primary);
    color: #fff !important;
    font-weight: 850;
    text-decoration: none;
    white-space: nowrap;
}

@@media (max-width: 760px)
{
    .wallet-header,
    .wallet-strip
    {
        align-items: stretch;
        flex-direction: column;
    }

    .wallet-ticket
    {
        width: 100%;
        text-align: left;
    }

    .wallet-grid
    {
        grid-template-columns: 1fr;
    }
}

</style>
