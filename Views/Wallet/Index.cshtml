@model AmarShowsBook.Models.Admin.VwWalletSummary
@using AmarShowsBook.Helpers

@{
    ViewData["Title"] = "Wallet";
    var blockedReason = string.IsNullOrWhiteSpace(Model.SuspensionReason)
        ? (Model.BlockedBalance > 0
            ? "This amount is temporarily unavailable for spending."
            : "No wallet amount is currently blocked.")
        : Model.SuspensionReason.Trim();
    var blockedWhen = Model.SuspendedAt?.ToString("dd MMM yyyy hh:mm tt")
        ?? Model.LastTransactionAt?.ToString("dd MMM yyyy hh:mm tt")
        ?? "No blocked date recorded";
    var blockedBy = string.IsNullOrWhiteSpace(Model.SuspendedBy)
        ? "System"
        : Model.SuspendedBy.Trim();
}

<section class="wallet-page">

    <div class="wallet-header">
        <div>
            <span class="wallet-kicker">Digital Wallet</span>

            <h1>Wallet</h1>

            <p>
                Track balance, credits, debits, loyalty points, and the latest wallet movement.
            </p>
        </div>
        <div class="wallet-ticket">
            <span>
                Status
                @if (string.Equals(Model.WalletStatus, "SUSPENDED", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(Model.WalletStatus, "BLOCKED", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="wallet-info">
                        <button type="button" class="wallet-info-btn" aria-label="Show wallet status details">i</button>
                        <span class="wallet-info-popover" role="tooltip">
                            <b>Reason</b> @blockedReason<br />
                            <b>When</b> @blockedWhen<br />
                            <b>By</b> @blockedBy
                        </span>
                    </span>
                }
            </span>
            <strong>@Model.WalletStatus</strong>
        </div>
    </div>

    <div class="wallet-grid">

        <div class="wallet-card wallet-card-feature">
            <span>Wallet Balance</span>
            <strong>@CurrencyFormatter.FormatRupees(Model.WalletBalance)</strong>
        </div>

        <div class="wallet-card">
            <span>
                Blocked Balance
                <span class="wallet-info">
                    <button type="button" class="wallet-info-btn" aria-label="Show blocked balance details">i</button>
                    <span class="wallet-info-popover" role="tooltip">
                        <b>Amount</b> @CurrencyFormatter.FormatRupees(Model.BlockedBalance)<br />
                        <b>Reason</b> @blockedReason<br />
                        <b>When</b> @blockedWhen
                    </span>
                </span>
            </span>
            <strong>@CurrencyFormatter.FormatRupees(Model.BlockedBalance)</strong>
        </div>

        <div class="wallet-card">
            <span>
                Loyalty Points
                <span class="wallet-info">
                    <button type="button" class="wallet-info-btn" aria-label="Show loyalty points details">i</button>
                    <span class="wallet-info-popover" role="tooltip">
                        Loyalty balance is the reward points available in your wallet. These points are earned from eligible showTime activity and may be used where loyalty redemption is allowed.
                    </span>
                </span>
            </span>
            <strong>@Model.LoyaltyPoints</strong>
        </div>

        <div class="wallet-card">
            <span>Total Credits</span>
            <strong>@CurrencyFormatter.FormatRupees(Model.TotalCredits)</strong>
        </div>

        <div class="wallet-card">
            <span>Total Debits</span>
            <strong>@CurrencyFormatter.FormatRupees(Model.TotalDebits)</strong>
        </div>

        <div class="wallet-card">
            <span>Total Transactions</span>
            <strong>@Model.TotalWalletTransactions</strong>
        </div>

    </div>

    <div class="wallet-strip">
        <div>
            <span>Last Transaction</span>
            <strong>@(Model.LastTransactionAt?.ToString("dd MMM yyyy hh:mm tt") ?? "No wallet transaction yet")</strong>
        </div>
        <a class="wallet-action" href="/Transaction/History">View Transactions</a>
    </div>

</section>

<style>

.wallet-page
{
    padding-bottom: 40px;
}

.wallet-header
{
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18px;
    min-height: 220px;
    padding: 30px;
    border-radius: 8px;
    background:
        repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px),
        linear-gradient(
            135deg,
            rgba(255,242,199,0.94),
            rgba(245,178,196,0.86),
            rgba(146,229,221,0.86)
        );
    color: #231f20;
    margin-bottom: 24px;
    margin-bottom: 18px;
    box-shadow: 0 22px 64px rgba(35,31,32,0.22);
}

.wallet-kicker
{
    text-transform: uppercase;

    font-size: 0.75rem;

    font-weight: 900;

    letter-spacing: 0.08em;
}

.wallet-header h1 {
    margin: 8px 0;
    color: #231f20;
    font-size: clamp(2.8rem, 7vw, 5.8rem);
    font-weight: 900;
}

.wallet-header p {
    max-width: 620px;
    margin: 0;
    color: #34303a;
    font-size: 1.05rem;
}

.wallet-ticket {
    min-width: 170px;
    padding: 14px;
    border: 1px dashed rgba(35,31,32,0.44);
    border-radius: 8px;
    background: rgba(255,255,255,0.38);
    text-align: right;
}

.wallet-ticket span,
.wallet-strip span {
    display: block;
    color: var(--app-muted);
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.wallet-ticket span {
    color: #34303a;
}

.wallet-ticket strong {
    color: #231f20;
    font-size: 1.2rem;
    font-weight: 900;
}

.wallet-grid
{
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 16px;
}

.wallet-card
{
    position: relative;
    overflow: visible;
    padding: 24px;

    border-radius: 8px;

    border: 1px solid var(--app-input-border);

    background: var(--app-card);

    color: var(--app-card-text);

    box-shadow: 0 12px 24px rgba(0,0,0,0.12);
}

.wallet-card::after {
    content: "";
    position: absolute;
    inset: auto 18px 14px auto;
    width: 46px;
    height: 3px;
    border-radius: 999px;
    background: var(--app-accent);
    opacity: 0.75;
}

.wallet-card:hover,
.wallet-card:focus-within {
    z-index: 5;
}

.wallet-card-feature {
    border-color: color-mix(in srgb, var(--app-accent) 58%, var(--app-input-border));
    background:
        linear-gradient(135deg, color-mix(in srgb, var(--app-accent) 18%, var(--app-card)), var(--app-card)) !important;
}

.wallet-card span
{
    display: block;

    margin-bottom: 12px;

    font-size: 0.85rem;

    font-weight: 800;

    text-transform: uppercase;
}

.wallet-card strong
{
    font-size: 1.8rem;

    font-weight: 900;
}

.wallet-info {
    position: relative;
    display: inline-flex !important;
    flex: 0 0 auto;
    align-items: center;
    margin-left: 7px;
    vertical-align: middle;
}

.wallet-info-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1px solid color-mix(in srgb, var(--app-accent) 62%, var(--app-input-border));
    border-radius: 50%;
    background: color-mix(in srgb, var(--app-accent) 16%, var(--app-card));
    color: var(--app-card-text);
    font-size: 0.68rem;
    font-weight: 900;
    line-height: 1;
    cursor: help;
    transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
}

.wallet-info-btn:hover,
.wallet-info-btn:focus-visible {
    background: var(--app-accent);
    border-color: var(--app-accent);
    color: #111;
    outline: none;
    transform: translateY(-1px);
}

.wallet-info-popover {
    position: absolute;
    display: block !important;
    left: 50%;
    bottom: calc(100% + 10px);
    z-index: 100;
    width: min(270px, 72vw);
    padding: 10px 12px;
    margin-bottom: 0 !important;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    box-shadow: 0 18px 38px rgba(0,0,0,0.24);
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: 0;
    text-align: left;
    text-transform: none;
    white-space: normal;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 6px);
    transition: opacity 0.16s ease, transform 0.16s ease;
}

.wallet-info-popover::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    width: 10px;
    height: 10px;
    border-right: 1px solid var(--app-input-border);
    border-bottom: 1px solid var(--app-input-border);
    background: var(--app-card);
    transform: translate(-50%, -5px) rotate(45deg);
}

.wallet-info-popover b {
    color: var(--app-muted);
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
}

.wallet-info:hover .wallet-info-popover,
.wallet-info:focus-within .wallet-info-popover {
    opacity: 1;
    transform: translate(-50%, 0);
}

.wallet-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
    padding: 18px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    box-shadow: 0 14px 34px rgba(0,0,0,0.13);
}

.wallet-strip strong {
    display: block;
    margin-top: 4px;
    font-weight: 900;
}

.wallet-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border-radius: 999px;
    padding: 8px 16px;
    background: var(--app-primary);
    color: #fff !important;
    font-weight: 850;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid color-mix(in srgb, var(--app-primary) 70%, #ffffff);
    box-shadow: 0 10px 22px color-mix(in srgb, var(--app-primary) 22%, transparent);
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.wallet-action:hover,
.wallet-action:focus-visible {
    background: var(--app-accent);
    border-color: color-mix(in srgb, var(--app-accent) 70%, #ffffff);
    color: #111 !important;
    box-shadow: 0 16px 30px color-mix(in srgb, var(--app-accent) 28%, transparent);
    transform: translateY(-2px);
}

.wallet-action:active {
    transform: translateY(0);
}

@@media (max-width: 760px)
{
    .wallet-header,
    .wallet-strip
    {
        align-items: stretch;
        flex-direction: column;
    }

    .wallet-ticket
    {
        width: 100%;
        text-align: left;
    }

    .wallet-grid
    {
        grid-template-columns: 1fr;
    }
}

/* Intro-style wallet refresh with restrained motion and theme-aware surfaces. */
.wallet-page {
    --wallet-page-line: color-mix(in srgb, var(--app-input-border) 76%, transparent);
    --wallet-page-glass: color-mix(in srgb, var(--app-card) 82%, transparent);
    --wallet-page-soft: color-mix(in srgb, var(--app-input) 68%, transparent);
    position: relative;
    isolation: isolate;
    padding: clamp(10px, 2vw, 20px) clamp(0px, 1vw, 6px) 44px;
}

.wallet-page::before {
    content: "";
    position: absolute;
    inset: -18px -16px auto;
    z-index: -1;
    height: 360px;
    border-radius: 8px;
    background:
        radial-gradient(circle at 14% 16%, color-mix(in srgb, var(--app-accent) 22%, transparent), transparent 28%),
        radial-gradient(circle at 86% 8%, color-mix(in srgb, var(--app-primary) 16%, transparent), transparent 26%),
        linear-gradient(135deg, color-mix(in srgb, var(--app-bg) 78%, var(--app-card) 22%), transparent);
    pointer-events: none;
}

.wallet-header {
    position: relative;
    overflow: hidden;
    min-height: auto;
    align-items: center;
    padding: clamp(22px, 4vw, 40px);
    border: 1px solid color-mix(in srgb, var(--app-accent-strong) 24%, var(--wallet-page-line));
    background:
        radial-gradient(circle at 80% 28%, color-mix(in srgb, var(--app-primary) 18%, transparent), transparent 30%),
        radial-gradient(circle at 12% 90%, color-mix(in srgb, var(--app-accent) 22%, transparent), transparent 34%),
        linear-gradient(135deg, color-mix(in srgb, var(--app-card) 94%, transparent), color-mix(in srgb, var(--app-input) 66%, transparent));
    color: var(--app-card-text);
    box-shadow:
        0 24px 64px color-mix(in srgb, var(--app-text) 14%, transparent),
        inset 0 1px 0 color-mix(in srgb, #ffffff 58%, transparent);
    animation: walletPageRise 0.56s ease both;
}

.wallet-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
        linear-gradient(color-mix(in srgb, var(--app-text) 6%, transparent) 1px, transparent 1px),
        linear-gradient(90deg, color-mix(in srgb, var(--app-text) 6%, transparent) 1px, transparent 1px);
    background-size: 30px 30px;
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.5), transparent 72%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.5), transparent 72%);
    pointer-events: none;
}

.wallet-header > * {
    position: relative;
    z-index: 1;
}

.wallet-header h1 {
    color: var(--app-card-text);
    line-height: 0.95;
}

.wallet-header p,
.wallet-kicker {
    color: color-mix(in srgb, var(--app-card-text) 74%, var(--app-muted));
}

.wallet-ticket,
.wallet-strip {
    border-color: color-mix(in srgb, var(--app-accent-strong) 28%, var(--wallet-page-line));
    background: var(--wallet-page-glass);
    color: var(--app-card-text);
    box-shadow: 0 18px 44px color-mix(in srgb, var(--app-text) 10%, transparent);
    backdrop-filter: blur(14px);
}

.wallet-ticket span,
.wallet-ticket strong,
.wallet-strip span,
.wallet-strip strong {
    color: var(--app-card-text);
}

.wallet-grid {
    align-items: stretch;
}

.wallet-card {
    --motion-x: 50%;
    --motion-y: 50%;
    --motion-tilt-x: 0deg;
    --motion-tilt-y: 0deg;
    overflow: visible;
    min-height: 148px;
    border-color: color-mix(in srgb, var(--app-accent-strong) 18%, var(--wallet-page-line));
    background:
        radial-gradient(circle at var(--motion-x) var(--motion-y), color-mix(in srgb, var(--app-accent-strong) 9%, transparent), transparent 32%),
        linear-gradient(180deg, color-mix(in srgb, var(--app-card) 94%, transparent), color-mix(in srgb, var(--app-input) 52%, transparent)),
        var(--app-card);
    box-shadow: 0 18px 42px color-mix(in srgb, var(--app-text) 11%, transparent);
    transform: perspective(900px) rotateX(var(--motion-tilt-x)) rotateY(var(--motion-tilt-y)) translateY(0);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    animation: walletCardIn 0.46s ease both;
}

.wallet-card:nth-child(2n) {
    animation-delay: 0.05s;
}

.wallet-card::after {
    background: linear-gradient(90deg, var(--app-accent), var(--app-accent-strong), var(--app-primary));
}

.wallet-card:hover,
.wallet-card:focus-within,
.wallet-card.is-soft-active {
    z-index: 5;
    border-color: color-mix(in srgb, var(--app-primary) 38%, var(--wallet-page-line));
    box-shadow: 0 24px 54px color-mix(in srgb, var(--app-text) 14%, transparent);
    transform: perspective(900px) rotateX(var(--motion-tilt-x)) rotateY(var(--motion-tilt-y)) translateY(-3px);
}

.wallet-card-feature {
    background:
        radial-gradient(circle at var(--motion-x) var(--motion-y), color-mix(in srgb, var(--app-accent) 18%, transparent), transparent 34%),
        linear-gradient(135deg, color-mix(in srgb, var(--app-accent) 18%, var(--app-card)), color-mix(in srgb, var(--app-card) 90%, transparent)) !important;
}

.wallet-card strong {
    color: var(--app-card-text);
    overflow-wrap: anywhere;
}

.wallet-action {
    border-radius: 8px;
    background:
        linear-gradient(135deg, color-mix(in srgb, var(--app-primary) 92%, #ffffff 8%), color-mix(in srgb, var(--app-accent-strong) 86%, var(--app-primary) 14%));
    box-shadow: 0 14px 30px color-mix(in srgb, var(--app-primary) 22%, transparent);
}

html[data-theme="dark"] .wallet-ticket,
html[data-theme="dark"] .wallet-strip,
html[data-theme="dark"] .wallet-card {
    box-shadow: 0 18px 44px color-mix(in srgb, #000000 34%, transparent);
}

@@media (max-width: 760px) {
    .wallet-header {
        align-items: stretch;
    }
}

@@media (max-width: 520px) {
    .wallet-header {
        padding: 18px;
    }

    .wallet-action {
        width: 100%;
    }
}

@@media (prefers-reduced-motion: reduce) {
    .wallet-header,
    .wallet-card {
        animation: none !important;
        transition: none !important;
    }
}

@@keyframes walletPageRise {
    from {
        opacity: 0;
        transform: translateY(14px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes walletCardIn {
    from {
        opacity: 0;
        transform: translateY(12px) scale(0.99);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

</style>

<script>
(function () {
    if (!window.matchMedia || !window.matchMedia("(pointer: fine)").matches) return;

    document.querySelectorAll(".wallet-card").forEach(card => {
        card.addEventListener("mousemove", event => {
            const rect = card.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;
            const tiltX = ((y / rect.height) - 0.5) * -2;
            const tiltY = ((x / rect.width) - 0.5) * 2;

            card.style.setProperty("--motion-x", `${x}px`);
            card.style.setProperty("--motion-y", `${y}px`);
            card.style.setProperty("--motion-tilt-x", `${tiltX.toFixed(2)}deg`);
            card.style.setProperty("--motion-tilt-y", `${tiltY.toFixed(2)}deg`);
            card.classList.add("is-soft-active");
        });

        card.addEventListener("mouseleave", () => {
            card.classList.remove("is-soft-active");
            card.style.setProperty("--motion-tilt-x", "0deg");
            card.style.setProperty("--motion-tilt-y", "0deg");
        });
    });
})();
</script>
