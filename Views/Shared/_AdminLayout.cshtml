<script>
window.showCaptureProtection = window.showCaptureProtection || function (message) {
    const overlay = document.querySelector("[data-capture-protection-overlay]");
    if (!overlay) {
        return;
    }

    const detail = overlay.querySelector("span");
    if (detail && message) {
        detail.textContent = message;
    }

    overlay.classList.add("is-visible");
    clearTimeout(window.__captureProtectionTimer);
    window.__captureProtectionTimer = setTimeout(() => {
        overlay.classList.remove("is-visible");
    }, 1800);
};

(function () {
    const canCapture = document.body?.dataset.captureAllowed === "true";
    if (canCapture) {
        return;
    }

    const protectedMessage = "Recording, screenshots, search shortcuts, and print are allowed only for Admin and Super Admin.";
    const nativePrint = window.print;

    window.print = function () {
        window.showCaptureProtection("Print is allowed only for Admin and Super Admin.");
        return false;
    };

    window.__showTimeNativePrint = nativePrint;

    if (navigator.mediaDevices?.getDisplayMedia) {
        navigator.mediaDevices.getDisplayMedia = function () {
            window.showCaptureProtection(protectedMessage);
            return Promise.reject(new DOMException("Screen capture is restricted.", "NotAllowedError"));
        };
    }

    document.addEventListener("keydown", function (event) {
        const key = String(event.key || "").toLowerCase();
        const code = String(event.code || "").toLowerCase();
        const hasModifier = event.ctrlKey || event.metaKey;
        const isBlockedShortcut =
            (hasModifier && ["p", "s", "f", "u"].includes(key)) ||
            (event.ctrlKey && event.shiftKey && ["i", "j", "c", "s"].includes(key)) ||
            (event.metaKey && event.altKey && ["i", "j", "c"].includes(key)) ||
            key === "f12" ||
            key === "printscreen" ||
            code === "printscreen" ||
            (event.metaKey && event.shiftKey && ["3", "4", "5"].includes(key));

        if (!isBlockedShortcut) {
            return;
        }

        event.preventDefault();
        event.stopPropagation();
        window.showCaptureProtection(protectedMessage);
    }, true);

    document.addEventListener("contextmenu", function (event) {
        event.preventDefault();
        window.showCaptureProtection(protectedMessage);
    }, true);

    window.addEventListener("beforeprint", function (event) {
        event.preventDefault?.();
        window.showCaptureProtection("Print is allowed only for Admin and Super Admin.");
    });
})();
</script>
<script>
(function () {
    let committedTheme = localStorage.getItem("showTimeTheme") || "cinema";

    function markAdminTheme(choice) {
        document.querySelectorAll("[data-admin-theme]").forEach(button => {
            button.classList.toggle("active", button.dataset.adminTheme === choice);
        });
    }

    function previewAdminTheme(choice) {
        const theme = choice || committedTheme || "cinema";
        document.documentElement.dataset.theme = theme;
    }

    function restoreAdminThemePreview() {
        previewAdminTheme(committedTheme);
        markAdminTheme(committedTheme);
    }

    window.setAdminTheme = function (choice) {
        const theme = choice || "cinema";
        committedTheme = theme;
        localStorage.setItem("showTimeTheme", theme);
        localStorage.setItem("showTimeThemeVersion", "3");
        document.documentElement.dataset.theme = theme;
        markAdminTheme(theme);
    };

    window.adminBack = function () {
        if (window.history.length > 1) {
            window.history.back();
            return;
        }

        window.location.href = "/Admin/Dashboard";
    };

    window.confirmLogout = function () {
        const popup = document.getElementById("adminConfirmLogout");
        if (!popup) {
            return confirm("Are you sure you want to logout?");
        }

        popup.classList.add("is-open");
        return false;
    };

    document.addEventListener("DOMContentLoaded", function () {
        const saved = localStorage.getItem("showTimeTheme") || "cinema";
        committedTheme = saved;
        window.setAdminTheme(saved);

        document.querySelectorAll("[data-admin-theme]").forEach(button => {
            const choice = button.dataset.adminTheme;
            button.addEventListener("mouseenter", () => previewAdminTheme(choice));
            button.addEventListener("focus", () => previewAdminTheme(choice));
            button.addEventListener("mouseleave", restoreAdminThemePreview);
            button.addEventListener("blur", restoreAdminThemePreview);
        });

        const popup = document.getElementById("adminConfirmLogout");
        const ok = document.querySelector("[data-admin-logout-ok]");
        const cancel = document.querySelector("[data-admin-logout-cancel]");

        ok?.addEventListener("click", function () {
            window.location.href = "/Auth/Logout";
        });

        cancel?.addEventListener("click", function () {
            popup?.classList.remove("is-open");
        });

        popup?.addEventListener("click", function (event) {
            if (event.target === popup) {
                popup.classList.remove("is-open");
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                popup?.classList.remove("is-open");
            }
        });
    });
})();
</script>
