@inject AmarShowsBook.Services.RbacService RbacService
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Admin Panel</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script>
        (function () {
            const savedTheme = localStorage.getItem("amarShowsTheme") || "cinema";
            document.documentElement.dataset.theme = savedTheme;
        })();
    </script>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="~/css/admin/admin-dashboard.css" />

    <style>
        @@media (pointer: fine) {
            html.app-liquid-cursor,
            html.app-liquid-cursor body,
            html.app-liquid-cursor a,
            html.app-liquid-cursor button,
            html.app-liquid-cursor input,
            html.app-liquid-cursor select,
            html.app-liquid-cursor textarea,
            html.app-liquid-cursor [role="button"] {
                cursor: none !important;
            }

            .liquid-cursor,
            .liquid-cursor-trail {
                position: fixed;
                left: 0;
                top: 0;
                pointer-events: none;
                z-index: 2147483647;
                border-radius: 999px;
                transform: translate3d(-50%, -50%, 0);
                will-change: transform, width, height, opacity;
            }

            .liquid-cursor {
                width: 10px;
                height: 10px;
                border: 1px solid rgba(255, 255, 255, 0.78);
                background:
                    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.95), transparent 36%),
                    color-mix(in srgb, var(--admin-teal) 72%, var(--admin-rose));
                box-shadow:
                    0 0 0 1px color-mix(in srgb, var(--admin-ink) 10%, transparent),
                    0 0 18px color-mix(in srgb, var(--admin-teal) 42%, transparent);
                backdrop-filter: blur(4px) saturate(130%);
                transition: width 0.14s ease, height 0.14s ease, opacity 0.18s ease, background 0.14s ease;
            }

            .liquid-cursor-trail {
                width: 34px;
                height: 34px;
                border: 1px solid color-mix(in srgb, var(--admin-teal) 46%, transparent);
                background: color-mix(in srgb, var(--admin-gold) 10%, transparent);
                box-shadow: 0 0 24px color-mix(in srgb, var(--admin-teal) 22%, transparent);
                backdrop-filter: blur(2px);
                opacity: 0.76;
                transition: width 0.16s ease, height 0.16s ease, opacity 0.2s ease, border-color 0.16s ease;
            }

            html.app-liquid-cursor.cursor-action .liquid-cursor {
                width: 8px;
                height: 8px;
                background:
                    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.95), transparent 36%),
                    var(--admin-gold);
            }

            html.app-liquid-cursor.cursor-action .liquid-cursor-trail {
                width: 44px;
                height: 44px;
                border-color: color-mix(in srgb, var(--admin-gold) 62%, transparent);
                opacity: 0.84;
            }

            html.app-liquid-cursor.cursor-hidden .liquid-cursor,
            html.app-liquid-cursor.cursor-hidden .liquid-cursor-trail {
                opacity: 0;
            }
        }
    </style>
</head>

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var userIdText = Context.Session.GetString("UserId");
    var hasUserId = int.TryParse(userIdText, out var currentUserId);
    Func<string, string, bool> canShowAdminNav = (module, action) =>
        hasUserId && RbacService.HasPermission(currentUserId, module, action);
    var adminNavItems = new[]
    {
        new { Action = "Dashboard", Label = "Dashboard", Url = "/Admin/Dashboard", Module = "ADMIN", Permission = "VIEW" },
        new { Action = "Users", Label = "Users", Url = "/Admin/Users", Module = "USER", Permission = "VIEW" },
        new { Action = "UserAccess", Label = "User Access", Url = "/Admin/UserAccess", Module = "USER", Permission = "GRANT_ACCESS" },
        new { Action = "Roles", Label = "Roles", Url = "/Admin/Roles", Module = "ROLE", Permission = "VIEW" },
        new { Action = "ManageShows", Label = "Manage Shows", Url = "/Admin/ManageShows", Module = "SHOW", Permission = "VIEW" },
        new { Action = "ContentManager", Label = "Data Manager", Url = "/Admin/ContentManager", Module = "SHOW", Permission = "VIEW" },
        new { Action = "Bookings", Label = "Bookings", Url = "/Admin/Bookings", Module = "BOOKING", Permission = "VIEW" },
        new { Action = "Transactions", Label = "Transactions", Url = "/Admin/Transactions", Module = "PAYMENT", Permission = "VIEW" },
        new { Action = "Refunds", Label = "Refunds", Url = "/Admin/Refunds", Module = "REFUND", Permission = "VIEW" },
        new { Action = "CouponUsage", Label = "Coupon Used", Url = "/Admin/CouponUsage", Module = "COUPON", Permission = "VIEW" },
        new { Action = "Wallets", Label = "Wallets", Url = "/Admin/Wallets", Module = "WALLET", Permission = "VIEW" },
        new { Action = "Notifications", Label = "Notifications", Url = "/Admin/Notifications", Module = "NOTIFICATION", Permission = "VIEW" },
        new { Action = "ActivityLogs", Label = "Activity Logs", Url = "/Admin/ActivityLogs", Module = "ADMIN", Permission = "VIEW" },
        new { Action = "Versions", Label = "Versions", Url = "/Admin/Versions", Module = "ADMIN", Permission = "VIEW" }
    };
    var showAdminFilters = new[]
    {
        "Users","UserAccess","Roles","Bookings",
        "Transactions","Wallets","Notifications","ActivityLogs","Versions","ContentManager"
    }.Contains(currentAction);
    var adminStatusOptions = currentAction switch
    {
        "Users" => new[] { "ACTIVE", "DISABLED", "NORMAL", "DELETED" },
        "UserAccess" => new[] { "ACTIVE", "DISABLED" },
        "Roles" => new[] { "ACTIVE", "INACTIVE" },
        "Bookings" => new[] { "SUCCESS", "PENDING", "FAILED", "CONFIRMED", "CANCELLED" },
        "Transactions" => new[] { "SUCCESS", "PENDING", "FAILED", "CONFIRMED", "CANCELLED" },
        "Wallets" => new[] { "ACTIVE", "DISABLED", "BLOCKED" },
        "Notifications" => new[] { "SUCCESS", "SENT", "PENDING", "FAILED", "UNREAD", "ERROR" },
        "ActivityLogs" => new[] { "SUCCESS", "FAILED", "ERROR", "PENDING" },
        "Versions" => new[] { "CURRENT", "PREVIOUS" },
        _ => Array.Empty<string>()
    };
    var adminMethodLabel = currentAction switch
    {
        "Transactions" => "Payment Method",
        "Notifications" => "Notification Type",
        "Bookings" or "ContentManager" => "Show Type",
        _ => string.Empty
    };
    var adminMethodOptions = currentAction switch
    {
        "Transactions" => new[] { "UPI", "CARD", "NETBANKING", "WALLET", "QR" },
        "Notifications" => new[] { "WEB", "EMAIL", "SMS" },
        "Bookings" or "ContentManager" => new[] { "MOVIE", "STANDUP", "LIVE" },
        _ => Array.Empty<string>()
    };
    var canUsePrintTools =
        AmarShowsBook.Helpers.RbacAuthorizationHelper.CanUsePrintTools(Context, RbacService);
}

<body>

<div class="admin-wrapper" id="adminShell">

    <!-- Human Comment: Shared readable admin navigation with a hide/show top button. -->
    <aside class="admin-sidebar" id="adminSidebar">

        <div class="admin-logo">
            <span class="admin-logo-mark">AS</span>
            <span>AmarShowsBook</span>
        </div>

        <nav class="admin-nav" aria-label="Admin navigation">

            @foreach (var item in adminNavItems.Where(x => canShowAdminNav(x.Module, x.Permission)))
            {
                var isActive = currentAction == item.Action ||
                    (item.Action == "Transactions" && currentAction == "TransactionDetails") ||
                    (item.Action == "Refunds" && currentAction == "RefundDetails");

                <a class="@(isActive ? "active" : "")" href="@item.Url">@item.Label</a>
            }

        </nav>

    </aside>

    <main class="admin-main">

        <header class="admin-topbar">
            <button class="admin-icon-btn"
                    type="button"
                    id="adminNavToggle"
                    aria-controls="adminSidebar"
                    aria-expanded="true"
                    title="Hide or show navigation">
                ☰ Menu
            </button>

            @if(currentAction!="Dashboard")
            {
                <button class="admin-icon-btn no-print"
                        type="button"
                        onclick="adminBack()">
                    Back
                </button>
            }

            @if (canUsePrintTools)
            {
                <button class="admin-icon-btn no-print"
                        type="button"
                        onclick="window.print()">
                    Print
                </button>
            }

            <div class="admin-theme-switcher no-print" aria-label="Theme selector">
                <button type="button" data-admin-theme="system" onclick="setAdminTheme('system')">System</button>
                <button type="button" data-admin-theme="dark" onclick="setAdminTheme('dark')">Dark</button>
                <button type="button" data-admin-theme="white" onclick="setAdminTheme('white')">White</button>
                <button type="button" data-admin-theme="cinema" onclick="setAdminTheme('cinema')">Cinema</button>
            </div>

            <!-- Human Comment: Shared admin search filters visible tables and dashboard cards on the current page. -->
            <form class="admin-search" role="search" onsubmit="return false;">
                <label for="adminPageSearch" class="visually-hidden">Search this page</label>
                <span aria-hidden="true">⌕</span>
                <input id="adminPageSearch"
                       type="search"
                       placeholder="Search this page" />
                <button type="button"
                        id="adminSearchClear"
                        title="Clear search">
                    ×
                </button>
            </form>
        </header>

        @if(showAdminFilters)
        {
            <section class="admin-detail-panel admin-filter-panel no-print"
                     id="adminContextFilter"
                     data-page-filter
                     data-page-filter-target=".admin-table tbody tr, table tbody tr, .access-card, [data-admin-searchable]">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <input type="text"
                               class="form-control rounded-pill"
                               data-page-filter-search
                               placeholder="Search records">
                    </div>
                    @if(adminStatusOptions.Any())
                    {
                    <div class="col-md-3">
                        <select class="form-select rounded-pill" data-page-filter-status>
                            <option value="">All Status</option>
                            @foreach(var option in adminStatusOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    }
                    @if(adminMethodOptions.Any())
                    {
                    <div class="col-md-3">
                        <select class="form-select rounded-pill" data-page-filter-method>
                            <option value="">All @adminMethodLabel</option>
                            @foreach(var option in adminMethodOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    }
                    <div class="col-md-2 text-end">
                        <button type="button"
                                class="btn btn-outline-dark rounded-pill w-100"
                                data-page-filter-reset>
                            Reset
                        </button>
                    </div>
                </div>
            </section>
        }

        @RenderBody()

    </main>

</div>

<script src="~/js/admin/admin-dashboard.js"></script>
<script>
(function () {
    function markAdminTheme(choice) {
        document.querySelectorAll("[data-admin-theme]").forEach(button => {
            button.classList.toggle("active", button.dataset.adminTheme === choice);
        });
    }

    window.setAdminTheme = function (choice) {
        const theme = choice || "cinema";
        localStorage.setItem("amarShowsTheme", theme);
        localStorage.setItem("amarShowsThemeVersion", "3");
        document.documentElement.dataset.theme = theme;
        markAdminTheme(theme);
    };

    window.adminBack = function () {
        if (window.history.length > 1) {
            window.history.back();
            return;
        }

        window.location.href = "/Admin/Dashboard";
    };

    document.addEventListener("DOMContentLoaded", function () {
        const saved = localStorage.getItem("amarShowsTheme") || "cinema";
        window.setAdminTheme(saved);
    });
})();
</script>
<script>
(function () {
    const finePointer = window.matchMedia("(pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!finePointer.matches || reducedMotion.matches) {
        return;
    }

    const root = document.documentElement;
    const cursor = document.createElement("span");
    const trail = document.createElement("span");
    let cursorX = window.innerWidth / 2;
    let cursorY = window.innerHeight / 2;
    let trailX = cursorX;
    let trailY = cursorY;
    let rafId = 0;

    cursor.className = "liquid-cursor";
    trail.className = "liquid-cursor-trail";
    cursor.setAttribute("aria-hidden", "true");
    trail.setAttribute("aria-hidden", "true");

    function setActionState(event) {
        const action = event.target.closest("a,button,input,select,textarea,label,[role='button'],.dashboard-card,.admin-nav a,.admin-icon-btn");
        root.classList.toggle("cursor-action", Boolean(action));
    }

    function moveCursor(event) {
        cursorX = event.clientX;
        cursorY = event.clientY;
        root.classList.remove("cursor-hidden");
        setActionState(event);

        if (!rafId) {
            rafId = requestAnimationFrame(renderCursor);
        }
    }

    function renderCursor() {
        trailX += (cursorX - trailX) * 0.18;
        trailY += (cursorY - trailY) * 0.18;

        cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
        trail.style.transform = `translate3d(${trailX}px, ${trailY}px, 0) translate(-50%, -50%)`;
        rafId = requestAnimationFrame(renderCursor);
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.body.appendChild(trail);
        document.body.appendChild(cursor);
        root.classList.add("app-liquid-cursor", "cursor-hidden");
        rafId = requestAnimationFrame(renderCursor);
    });

    document.addEventListener("mousemove", moveCursor, { passive: true });
    document.addEventListener("mouseleave", function () {
        root.classList.add("cursor-hidden");
    });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
