@inject AmarShowsBook.Services.RbacService RbacService
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Admin Panel</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script>
        (function () {
            // Admin pages reuse the same saved theme and cursor choices as the public site.
            const savedTheme = localStorage.getItem("showTimeTheme") || "cinema";
            const savedCursor = localStorage.getItem("showTimeCursor") || "liquid";
            const savedCursorColor = localStorage.getItem("showTimeCursorColor");
            document.documentElement.dataset.theme = savedTheme;
            document.documentElement.dataset.cursorChoice = savedCursor;
            if (savedCursorColor) {
                document.documentElement.style.setProperty("--app-cursor-color", savedCursorColor);
            }
        })();
    </script>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="~/css/admin/admin-dashboard.css"
          asp-append-version="true" />

    <style>
        @@media (pointer: fine) {
            html.app-custom-cursor,
            html.app-custom-cursor body,
            html.app-custom-cursor a,
            html.app-custom-cursor button,
            html.app-custom-cursor input,
            html.app-custom-cursor select,
            html.app-custom-cursor textarea,
            html.app-custom-cursor [role="button"] {
                cursor: none !important;
            }

            .liquid-cursor,
            .liquid-cursor-trail {
                position: fixed;
                left: 0;
                top: 0;
                pointer-events: none;
                z-index: 2147483647;
                border-radius: 999px;
                transform: translate3d(-50%, -50%, 0);
                will-change: transform, width, height, opacity;
            }

            .liquid-cursor {
                width: 10px;
                height: 10px;
                border: 1px solid rgba(255, 255, 255, 0.78);
                background:
                    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.95), transparent 36%),
                    color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 72%, var(--admin-rose));
                box-shadow:
                    0 0 0 1px color-mix(in srgb, var(--admin-ink) 10%, transparent),
                    0 0 18px color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 42%, transparent);
                backdrop-filter: blur(4px) saturate(130%);
                transition: width 0.14s ease, height 0.14s ease, opacity 0.18s ease, background 0.14s ease;
            }

            .liquid-cursor::before,
            .liquid-cursor::after,
            .liquid-cursor-trail::before {
                content: "";
                position: absolute;
                pointer-events: none;
                opacity: 0;
                transition: opacity 0.14s ease;
            }

            .liquid-cursor-trail {
                width: 34px;
                height: 34px;
                border: 1px solid color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 46%, transparent);
                background: color-mix(in srgb, var(--admin-gold) 10%, transparent);
                box-shadow: 0 0 24px color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 22%, transparent);
                backdrop-filter: blur(2px);
                opacity: 0.76;
                transition: width 0.16s ease, height 0.16s ease, opacity 0.2s ease, border-color 0.16s ease;
            }

            html.app-liquid-cursor.cursor-action .liquid-cursor {
                width: 8px;
                height: 8px;
                background:
                    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.95), transparent 36%),
                    var(--admin-gold);
            }

            html.app-liquid-cursor.cursor-action .liquid-cursor-trail {
                width: 44px;
                height: 44px;
                border-color: color-mix(in srgb, var(--admin-gold) 62%, transparent);
                opacity: 0.84;
            }

            html.app-liquid-cursor .liquid-cursor {
                width: 14px;
                height: 14px;
                border-radius: 60% 42% 58% 46%;
                animation: adminCursorLiquidPulse 1.7s ease-in-out infinite;
            }

            html.app-liquid-cursor .liquid-cursor-trail {
                width: 38px;
                height: 38px;
                border-radius: 42% 58% 46% 62%;
                background: radial-gradient(circle, color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 16%, transparent), transparent 68%);
            }

            html.app-liquid-cursor.cursor-hidden .liquid-cursor,
            html.app-liquid-cursor.cursor-hidden .liquid-cursor-trail,
            html.app-precision-cursor.cursor-hidden .liquid-cursor,
            html.app-precision-cursor.cursor-hidden .liquid-cursor-trail,
            html.app-spotlight-cursor.cursor-hidden .liquid-cursor,
            html.app-spotlight-cursor.cursor-hidden .liquid-cursor-trail {
                opacity: 0;
            }

            html.app-precision-cursor .liquid-cursor {
                width: 22px;
                height: 22px;
                border: 0;
                border-radius: 2px;
                background:
                    linear-gradient(var(--app-cursor-color, var(--admin-rose)), var(--app-cursor-color, var(--admin-rose))) center / 2px 22px no-repeat,
                    linear-gradient(90deg, var(--app-cursor-color, var(--admin-rose)), var(--app-cursor-color, var(--admin-rose))) center / 22px 2px no-repeat;
                box-shadow: none;
                backdrop-filter: none;
            }

            html.app-precision-cursor .liquid-cursor-trail {
                width: 34px;
                height: 34px;
                border: 2px dashed var(--app-cursor-color, var(--admin-rose));
                border-radius: 50%;
                background: transparent;
                box-shadow: inset 0 0 0 5px color-mix(in srgb, var(--app-cursor-color, var(--admin-rose)) 8%, transparent);
                opacity: 0.88;
                backdrop-filter: none;
            }

            html.app-precision-cursor.cursor-action .liquid-cursor-trail {
                width: 42px;
                height: 42px;
                border-style: solid;
            }

            html.app-spotlight-cursor .liquid-cursor {
                width: 5px;
                height: 5px;
                border: 0;
                background: var(--app-cursor-color, var(--admin-gold));
                box-shadow: 0 0 12px color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 52%, transparent);
                backdrop-filter: none;
            }

            html.app-spotlight-cursor .liquid-cursor-trail {
                width: 84px;
                height: 84px;
                border: 2px solid color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 58%, transparent);
                background:
                    radial-gradient(circle, transparent 0 30%, color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 14%, transparent) 32% 100%);
                box-shadow:
                    inset 0 0 22px color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 28%, transparent),
                    0 0 34px color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 22%, transparent);
                opacity: 0.72;
                backdrop-filter: blur(1px);
            }

            html.app-spotlight-cursor.cursor-action .liquid-cursor-trail {
                width: 104px;
                height: 104px;
                opacity: 0.82;
            }

            @@keyframes adminCursorLiquidPulse {
                0%, 100% {
                    border-radius: 60% 42% 58% 46%;
                }
                50% {
                    border-radius: 42% 62% 44% 58%;
                }
            }

            html.app-page-busy,
            html.app-page-busy body,
            html.app-page-busy a,
            html.app-page-busy button,
            html.app-page-busy input,
            html.app-page-busy select,
            html.app-page-busy textarea,
            html.app-page-busy [role="button"] {
                cursor: url("/images/brand/showtime-progress-cursor.png") 16 16, progress !important;
            }

            html.app-page-busy .liquid-cursor {
                width: 34px;
                height: 34px;
                border: 0;
                border-radius: 8px;
                background: rgba(255, 255, 255, 0.86);
                box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.72), 0 10px 26px rgba(15, 23, 42, 0.22);
                animation: showTimeProgressPulse 0.72s ease-in-out infinite alternate;
            }

            html.app-page-busy .liquid-cursor::before {
                inset: 3px;
                border-radius: 6px;
                opacity: 1;
                background: url("/images/brand/showtime-progress-cursor.png") center / contain no-repeat;
                animation: showTimeLogoPulse 0.72s ease-in-out infinite alternate;
            }

            html.app-page-busy .liquid-cursor::after {
                inset: 0;
                border-radius: 8px;
                opacity: 0.75;
                background: linear-gradient(115deg, transparent 0 32%, rgba(255, 255, 255, 0.84) 45%, transparent 58% 100%);
                mix-blend-mode: screen;
                animation: showTimeProgressSweep 1s ease-in-out infinite;
            }

            html.app-page-busy .liquid-cursor-trail {
                width: 54px;
                height: 54px;
                border: 0;
                border-radius: 999px;
                background: transparent;
                opacity: 0.9;
            }

            html.app-page-busy .liquid-cursor-trail::before {
                inset: 0;
                border-radius: 999px;
                opacity: 1;
                background: conic-gradient(
                    from 0deg,
                    transparent 0 18%,
                    color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 88%, white) 22% 42%,
                    transparent 48% 100%
                );
                -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
                mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
                animation: showTimeProgressSpin 0.72s linear infinite;
            }

            @@keyframes showTimeProgressSpin {
                to {
                    transform: rotate(360deg);
                }
            }

            @@keyframes showTimeProgressPulse {
                from {
                    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.68), 0 10px 24px rgba(15, 23, 42, 0.2);
                }
                to {
                    box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.42), 0 12px 34px color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 42%, transparent);
                }
            }

            @@keyframes showTimeLogoPulse {
                from {
                    transform: scale(0.9);
                }
                to {
                    transform: scale(1.08);
                }
            }

            @@keyframes showTimeProgressSweep {
                0% {
                    transform: translateX(-120%) rotate(12deg);
                }
                100% {
                    transform: translateX(120%) rotate(12deg);
                }
            }
        }
    </style>
</head>

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var userIdText = Context.Session.GetString("UserId");
    var adminDisplayName = Context.Session.GetString("UserName") ?? Context.Session.GetString("UserEmail") ?? "User";
    var normalizedAdminDisplayName = string.IsNullOrWhiteSpace(adminDisplayName)
        ? "User"
        : adminDisplayName.Trim();
    var supportWhatsAppText = $"Hi showTime Team, I'm {normalizedAdminDisplayName}. I need support. Please help me with my request.";
    var supportWhatsAppUrl = $"https://wa.me/919651698863?text={Uri.EscapeDataString(supportWhatsAppText)}";
    var supportEmailSubject = "showTime Support Request";
    var supportEmailText = $"Hi showTime Team, I'm {normalizedAdminDisplayName}. I need support. Please help me with my request.";
    var supportEmailUrl = $"mailto:support@showtime.com?subject={Uri.EscapeDataString(supportEmailSubject)}&body={Uri.EscapeDataString(supportEmailText)}";
    var adminPrintPageTitle = ViewData["Title"]?.ToString();
    adminPrintPageTitle = string.IsNullOrWhiteSpace(adminPrintPageTitle)
        ? "Admin Panel"
        : adminPrintPageTitle.Trim();
    var hasUserId = int.TryParse(userIdText, out var currentUserId);
    var isDashboardOnlyAdmin = hasUserId &&
        RbacService.HasAnyActiveRole(currentUserId, "DUM_ADMIN") &&
        !RbacService.HasAnyActiveRole(currentUserId, "AMAR_SUPER_ADMIN", "AMAR_ADMIN", "AMAR_DEVELOPER");
    var dumAdminAllowedNavActions = new[]
    {
        "Dashboard",
        "Users",
        "Bookings",
        "Cancellations",
        "Security",
        "Transactions",
        "Refunds",
        "CouponUsage",
        "Wallets",
        "Notifications",
        "ActivityLogs",
        "Versions"
    };
    Func<string, string, bool> canShowAdminNav = (module, action) =>
        hasUserId && (isDashboardOnlyAdmin || RbacService.HasPermission(currentUserId, module, action));
    Func<string, bool> canShowAdminAction = action =>
    {
        if (!hasUserId)
        {
            return false;
        }

        if (isDashboardOnlyAdmin)
        {
            return dumAdminAllowedNavActions.Contains(action);
        }

        if (action == "Dashboard")
        {
            return RbacService.CanOpenAdminDashboard(currentUserId);
        }

        if (action == "Roles" || action == "ManageShows")
        {
            return RbacService.CanAccessSuperAdminArea(currentUserId);
        }

        return true;
    };
    var adminNavItems = new[]
    {
        new { Action = "Dashboard", Label = "Dashboard", Url = "/Admin/Dashboard", Module = "ADMIN", Permission = "VIEW" },
        new { Action = "Users", Label = "Users", Url = "/Admin/Users", Module = "USER", Permission = "VIEW" },
        new { Action = "UserAccess", Label = "User Access", Url = "/Admin/UserAccess", Module = "USER", Permission = "GRANT_ACCESS" },
        new { Action = "Roles", Label = "Roles", Url = "/Admin/Roles", Module = "ROLE", Permission = "VIEW" },
        new { Action = "ManageShows", Label = "Manage Shows", Url = "/Admin/ManageShows", Module = "SHOW", Permission = "VIEW" },
        new { Action = "ContentManager", Label = "Data Manager", Url = "/Admin/ContentManager", Module = "SHOW", Permission = "VIEW" },
        new { Action = "Bookings", Label = "Bookings", Url = "/Admin/Bookings", Module = "BOOKING", Permission = "VIEW" },
        new { Action = "Cancellations", Label = "Cancellations", Url = "/Admin/Cancellations", Module = "BOOKING", Permission = "CANCEL" },
        new { Action = "Security", Label = "Security", Url = "/Admin/Security", Module = "SCANNER", Permission = "VIEW" },
        new { Action = "Transactions", Label = "Transactions", Url = "/Admin/Transactions", Module = "PAYMENT", Permission = "VIEW" },
        new { Action = "Refunds", Label = "Refunds", Url = "/Admin/Refunds", Module = "REFUND", Permission = "VIEW" },
        new { Action = "CouponUsage", Label = "Coupon Used", Url = "/Admin/CouponUsage", Module = "COUPON", Permission = "VIEW" },
        new { Action = "Wallets", Label = "Wallets", Url = "/Admin/Wallets", Module = "WALLET", Permission = "VIEW" },
        new { Action = "Notifications", Label = "Notifications", Url = "/Admin/Notifications", Module = "NOTIFICATION", Permission = "VIEW" },
        new { Action = "ActivityLogs", Label = "Activity Logs", Url = "/Admin/ActivityLogs", Module = "ADMIN", Permission = "VIEW" },
        new { Action = "Versions", Label = "Versions", Url = "/Admin/Versions", Module = "ADMIN", Permission = "VIEW" }
    };
    string adminNavIcon(string action) => action switch
    {
        "Dashboard" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"14\" y=\"4\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"4\" y=\"14\" width=\"6\" height=\"6\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"6\" height=\"6\" rx=\"1.5\"/></svg>",
        "Users" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3.8 19c1.2-4 9.2-4 10.4 0\"/><circle cx=\"17\" cy=\"9\" r=\"2.5\"/><path d=\"M14.5 16.2c2.5-.8 5.2 0 5.9 2.8\"/></svg>",
        "UserAccess" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"12\" r=\"3.5\"/><path d=\"M11.5 12H21\"/><path d=\"M17 12v3\"/><path d=\"M14 12v2\"/></svg>",
        "Roles" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3.5 19 7v5.5c0 3.6-2.5 6.1-7 8-4.5-1.9-7-4.4-7-8V7Z\"/><path d=\"m8.5 12 2.3 2.3 4.7-5\"/></svg>",
        "ManageShows" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"5\" width=\"16\" height=\"14\" rx=\"2\"/><path d=\"M4 9h16\"/><path d=\"m10 12 5 3-5 3Z\"/><path d=\"m7 5 2 4\"/><path d=\"m13 5 2 4\"/></svg>",
        "ContentManager" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"6\" rx=\"7\" ry=\"3\"/><path d=\"M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6\"/><path d=\"M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6\"/></svg>",
        "Bookings" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4Z\"/><path d=\"M9 8v8\"/></svg>",
        "Cancellations" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4Z\"/><path d=\"m9 9 6 6\"/><path d=\"m15 9-6 6\"/></svg>",
        "Security" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"5\" y=\"10\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 10V8a4 4 0 0 1 8 0v2\"/><path d=\"M12 14v2\"/></svg>",
        "Transactions" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3.5\" y=\"6\" width=\"17\" height=\"12\" rx=\"2\"/><path d=\"M3.5 10h17\"/><path d=\"M7 15h3\"/></svg>",
        "Refunds" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 8H4v4\"/><path d=\"M4 12a8 8 0 1 0 2.3-5.7Z\"/><path d=\"M12 8v5l3 2\"/></svg>",
        "CouponUsage" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4Z\"/><path d=\"m9 15 6-6\"/><path d=\"M9 9h.01\"/><path d=\"M15 15h.01\"/></svg>",
        "Wallets" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7.5A2.5 2.5 0 0 1 6.5 5H18a2 2 0 0 1 2 2v11H6.5A2.5 2.5 0 0 1 4 15.5Z\"/><path d=\"M16 12h5v4h-5a2 2 0 0 1 0-4Z\"/><path d=\"M16.5 14h.01\"/></svg>",
        "Notifications" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18 10a6 6 0 0 0-12 0c0 7-3 7-3 7h18s-3 0-3-7\"/><path d=\"M10 21h4\"/></svg>",
        "ActivityLogs" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 3-6.7\"/><path d=\"M3 5v6h6\"/><path d=\"M12 7v5l3 2\"/></svg>",
        "SupportDetails" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12a8 8 0 0 1 16 0v4a2 2 0 0 1-2 2h-2\"/><path d=\"M6 12v3a2 2 0 0 0 2 2h1v-7H8a2 2 0 0 0-2 2Z\"/><path d=\"M18 12v3a2 2 0 0 1-2 2h-1v-7h1a2 2 0 0 1 2 2Z\"/><path d=\"M12 18h4\"/></svg>",
        "Versions" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 13V7a2 2 0 0 0-2-2h-6l-2-2H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h6\"/><path d=\"m16 19 2 2 4-5\"/></svg>",
        _ => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 8v8\"/><path d=\"M8 12h8\"/></svg>"
    };
    var showAdminFilters = new[]
    {
        "Users","UserAccess","Roles","Bookings","Security",
        "Transactions","Wallets","Notifications","ActivityLogs","Versions","ContentManager","Cancellations"
    }.Contains(currentAction);
    var adminStatusOptions = currentAction switch
    {
        "Users" => new[] { "ACTIVE", "DISABLED", "NORMAL", "DELETED" },
        "UserAccess" => new[] { "ACTIVE", "DISABLED" },
        "Roles" => new[] { "ACTIVE", "INACTIVE" },
        "Bookings" => new[] { "SUCCESS", "PENDING", "FAILED", "CONFIRMED", "CANCELLED" },
        "Cancellations" => new[] { "Individual Booking", "Future Show", "History Booking", "History Theater" },
        "Security" => new[] { "VALID", "INVALID", "DUPLICATE", "USED", "ISSUE", "CLEAR" },
        "Transactions" => new[] { "SUCCESS", "PENDING", "FAILED", "CONFIRMED", "CANCELLED" },
        "Wallets" => new[] { "ACTIVE", "DISABLED", "BLOCKED" },
        "Notifications" => new[] { "SUCCESS", "SENT", "DELIVERED", "READ", "PENDING", "PROCESSING", "FAILED", "FAILURE", "ERROR", "CANCELLED", "REJECTED", "ISSUE" },
        "ActivityLogs" => new[] { "SUCCESS", "FAILED", "ERROR", "PENDING" },
        "Versions" => new[] { "CURRENT", "PREVIOUS" },
        _ => Array.Empty<string>()
    };
    if (ViewData["AdminStatusOptions"] is IEnumerable<string> customAdminStatusOptions)
    {
        adminStatusOptions = customAdminStatusOptions
            .Where(option => !string.IsNullOrWhiteSpace(option))
            .Select(option => option.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }
    var adminStatusLabel = ViewData["AdminStatusLabel"] as string ?? "Status";
    var adminMethodLabel = currentAction switch
    {
        "Transactions" => "Payment Method",
        "Security" => "Gate / Device",
        "Notifications" => "Source",
        "Bookings" or "ContentManager" or "Cancellations" => "Show Type",
        _ => string.Empty
    };
    var adminMethodOptions = currentAction switch
    {
        "Transactions" => new[] { "UPI", "CARD", "NETBANKING", "WALLET", "QR" },
        "Security" => new[] { "GATE", "SCANNER", "DEVICE", "UNKNOWN" },
        "Notifications" => new[] { "REFUND", "BOOKING", "PAYMENT", "NOTIFICATION", "SECURITY", "AUTH", "ADMIN", "LOG", "EMAIL", "SMS", "PUSH", "IN_APP", "WHATSAPP" },
        "Bookings" or "ContentManager" or "Cancellations" => new[] { "MOVIE", "STANDUP", "LIVE", "Movie", "Standup", "Live" },
        _ => Array.Empty<string>()
    };
    if (ViewData["AdminMethodLabel"] is string customAdminMethodLabel && !string.IsNullOrWhiteSpace(customAdminMethodLabel))
    {
        adminMethodLabel = customAdminMethodLabel;
    }
    if (ViewData["AdminMethodOptions"] is IEnumerable<string> customAdminMethodOptions)
    {
        adminMethodOptions = customAdminMethodOptions
            .Where(option => !string.IsNullOrWhiteSpace(option))
            .Select(option => option.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }
    var adminPriorityOptions = currentAction switch
    {
        "Notifications" => new[] { "HIGH", "MEDIUM", "LOW", "NORMAL" },
        "Security" => new[] { "HIGH", "NORMAL" },
        _ => Array.Empty<string>()
    };
    var adminFilterTarget = ViewData["AdminFilterTarget"] as string
        ?? ".admin-table tbody tr, table tbody tr, .access-card, [data-admin-searchable]";
    var defaultAdminSortOptions = new[]
    {
        "newest|Newest First",
        "oldest|Oldest First",
        "priority|Priority First",
        "status|Status A-Z",
        "source|Source A-Z"
    };
    var adminSortOptionValues = ViewData["AdminSortOptions"] is IEnumerable<string> customAdminSortOptions
        ? customAdminSortOptions.Where(option => !string.IsNullOrWhiteSpace(option)).ToArray()
        : defaultAdminSortOptions;
    var adminSortOptions = adminSortOptionValues
        .Select(option =>
        {
            var parts = option.Split('|', 2);
            var value = parts[0].Trim();
            var label = parts.Length > 1 ? parts[1].Trim() : value;
            return new { Value = value, Label = label };
        })
        .Where(option => !string.IsNullOrWhiteSpace(option.Value))
        .ToArray();
    var canUsePrintTools =
        AmarShowsBook.Helpers.RbacAuthorizationHelper.CanUsePrintTools(Context, RbacService);
    var canUseProtectedCapture =
        hasUserId &&
        RbacService.HasAnyActiveRole(currentUserId, "AMAR_SUPER_ADMIN", "AMAR_ADMIN");
    var canEditSupportDetails =
        hasUserId &&
        RbacService.CanOpenAdminDashboard(currentUserId);

    var adminNotificationCount =
        ViewData["AdminNotificationCount"] is int notificationCount
            ? notificationCount
            : 0;
}

