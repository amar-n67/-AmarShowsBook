@inject AmarShowsBook.Services.RbacService RbacService
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Admin Panel</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script>
        (function () {
            const savedTheme = localStorage.getItem("amarShowsTheme") || "cinema";
            document.documentElement.dataset.theme = savedTheme;
        })();
    </script>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="~/css/admin/admin-dashboard.css" />
</head>

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var userIdText = Context.Session.GetString("UserId");
    var hasUserId = int.TryParse(userIdText, out var currentUserId);
    Func<string, string, bool> canShowAdminNav = (module, action) =>
        hasUserId && RbacService.HasPermission(currentUserId, module, action);
    var adminNavItems = new[]
    {
        new { Action = "Dashboard", Label = "Dashboard", Url = "/Admin/Dashboard", Module = "ADMIN", Permission = "VIEW" },
        new { Action = "Users", Label = "Users", Url = "/Admin/Users", Module = "USER", Permission = "VIEW" },
        new { Action = "UserAccess", Label = "User Access", Url = "/Admin/UserAccess", Module = "USER", Permission = "GRANT_ACCESS" },
        new { Action = "Roles", Label = "Roles", Url = "/Admin/Roles", Module = "ROLE", Permission = "VIEW" },
        new { Action = "Permissions", Label = "Permissions", Url = "/Admin/Permissions", Module = "PERMISSION", Permission = "VIEW" },
        new { Action = "ManageShows", Label = "Manage Shows", Url = "/Admin/ManageShows", Module = "SHOW", Permission = "VIEW" },
        new { Action = "Bookings", Label = "Bookings", Url = "/Admin/Bookings", Module = "BOOKING", Permission = "VIEW" },
        new { Action = "Transactions", Label = "Transactions", Url = "/Admin/Transactions", Module = "PAYMENT", Permission = "VIEW" },
        new { Action = "Refunds", Label = "Refunds", Url = "/Admin/Refunds", Module = "REFUND", Permission = "VIEW" },
        new { Action = "CouponUsage", Label = "Coupon Used", Url = "/Admin/CouponUsage", Module = "COUPON", Permission = "VIEW" },
        new { Action = "Wallets", Label = "Wallets", Url = "/Admin/Wallets", Module = "WALLET", Permission = "VIEW" },
        new { Action = "Notifications", Label = "Notifications", Url = "/Admin/Notifications", Module = "NOTIFICATION", Permission = "VIEW" },
        new { Action = "ActivityLogs", Label = "Activity Logs", Url = "/Admin/ActivityLogs", Module = "ADMIN", Permission = "VIEW" },
        new { Action = "Versions", Label = "Versions", Url = "/Admin/Versions", Module = "ADMIN", Permission = "VIEW" }
    };
    var showAdminFilters = new[]
    {
        "Users","UserAccess","Roles","Permissions","Bookings",
        "Transactions","Wallets","Notifications","ActivityLogs","Versions"
    }.Contains(currentAction);
}

<body>

<div class="admin-wrapper" id="adminShell">

    <!-- Human Comment: Shared readable admin navigation with a hide/show top button. -->
    <aside class="admin-sidebar" id="adminSidebar">

        <div class="admin-logo">
            <span class="admin-logo-mark">AS</span>
            <span>AmarShowsBook</span>
        </div>

        <nav class="admin-nav" aria-label="Admin navigation">

            @foreach (var item in adminNavItems.Where(x => canShowAdminNav(x.Module, x.Permission)))
            {
                var isActive = currentAction == item.Action ||
                    (item.Action == "Transactions" && currentAction == "TransactionDetails") ||
                    (item.Action == "Refunds" && currentAction == "RefundDetails");

                <a class="@(isActive ? "active" : "")" href="@item.Url">@item.Label</a>
            }

        </nav>

    </aside>

    <main class="admin-main">

        <header class="admin-topbar">
            <button class="admin-icon-btn"
                    type="button"
                    id="adminNavToggle"
                    aria-controls="adminSidebar"
                    aria-expanded="true"
                    title="Hide or show navigation">
                ☰ Menu
            </button>

            @if(currentAction!="Dashboard")
            {
                <button class="admin-icon-btn no-print"
                        type="button"
                        onclick="adminBack()">
                    Back
                </button>
            }

            <button class="admin-icon-btn no-print"
                    type="button"
                    onclick="window.print()">
                Print
            </button>

            <div class="admin-theme-switcher no-print" aria-label="Theme selector">
                <button type="button" data-admin-theme="system" onclick="setAdminTheme('system')">System</button>
                <button type="button" data-admin-theme="dark" onclick="setAdminTheme('dark')">Dark</button>
                <button type="button" data-admin-theme="white" onclick="setAdminTheme('white')">White</button>
                <button type="button" data-admin-theme="cinema" onclick="setAdminTheme('cinema')">Cinema</button>
            </div>

            <!-- Human Comment: Shared admin search filters visible tables and dashboard cards on the current page. -->
            <form class="admin-search" role="search" onsubmit="return false;">
                <label for="adminPageSearch" class="visually-hidden">Search this page</label>
                <span aria-hidden="true">⌕</span>
                <input id="adminPageSearch"
                       type="search"
                       placeholder="Search this page" />
                <button type="button"
                        id="adminSearchClear"
                        title="Clear search">
                    ×
                </button>
            </form>
        </header>

        @if(showAdminFilters)
        {
            <section class="admin-detail-panel admin-filter-panel no-print"
                     id="adminContextFilter"
                     data-page-filter
                     data-page-filter-target=".admin-table tbody tr, table tbody tr, .access-card, [data-admin-searchable]">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <input type="text"
                               class="form-control rounded-pill"
                               data-page-filter-search
                               placeholder="Search records">
                    </div>
                    <div class="col-md-3">
                        <select class="form-select rounded-pill" data-page-filter-status>
                            <option value="">All Status</option>
                            <option value="ACTIVE">ACTIVE</option>
                            <option value="DISABLED">DISABLED</option>
                            <option value="NORMAL">NORMAL</option>
                            <option value="DELETED">DELETED</option>
                            <option value="SUCCESS">SUCCESS</option>
                            <option value="PENDING">PENDING</option>
                            <option value="FAILED">FAILED</option>
                            <option value="CONFIRMED">CONFIRMED</option>
                            <option value="CANCELLED">CANCELLED</option>
                            <option value="SENT">SENT</option>
                            <option value="UNREAD">UNREAD</option>
                            <option value="ERROR">ERROR</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select rounded-pill" data-page-filter-method>
                            <option value="">All Methods</option>
                            <option value="UPI">UPI</option>
                            <option value="CARD">CARD</option>
                            <option value="NETBANKING">NETBANKING</option>
                            <option value="WALLET">WALLET</option>
                            <option value="QR">QR</option>
                            <option value="WEB">WEB</option>
                            <option value="EMAIL">EMAIL</option>
                            <option value="SMS">SMS</option>
                            <option value="MOVIE">MOVIE</option>
                            <option value="STANDUP">STANDUP</option>
                            <option value="LIVE">LIVE</option>
                        </select>
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="button"
                                class="btn btn-outline-dark rounded-pill w-100"
                                data-page-filter-reset>
                            Reset
                        </button>
                    </div>
                </div>
            </section>
        }

        @RenderBody()

    </main>

</div>

<script src="~/js/admin/admin-dashboard.js"></script>
<script>
(function () {
    function markAdminTheme(choice) {
        document.querySelectorAll("[data-admin-theme]").forEach(button => {
            button.classList.toggle("active", button.dataset.adminTheme === choice);
        });
    }

    window.setAdminTheme = function (choice) {
        const theme = choice || "cinema";
        localStorage.setItem("amarShowsTheme", theme);
        localStorage.setItem("amarShowsThemeVersion", "3");
        document.documentElement.dataset.theme = theme;
        markAdminTheme(theme);
    };

    window.adminBack = function () {
        if (window.history.length > 1) {
            window.history.back();
            return;
        }

        window.location.href = "/Admin/Dashboard";
    };

    document.addEventListener("DOMContentLoaded", function () {
        const saved = localStorage.getItem("amarShowsTheme") || "cinema";
        window.setAdminTheme(saved);
    });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
