<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Admin Panel</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="~/css/admin/admin-dashboard.css" />
</head>

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
}

<body>

<div class="admin-wrapper" id="adminShell">

    <!-- Human Comment: Shared readable admin navigation with a hide/show top button. -->
    <aside class="admin-sidebar" id="adminSidebar">

        <div class="admin-logo">
            <span class="admin-logo-mark">AS</span>
            <span>AmarShowsBook</span>
        </div>

        <nav class="admin-nav" aria-label="Admin navigation">

            <a class="@(currentAction == "Dashboard" ? "active" : "")" href="/Admin/Dashboard">Dashboard</a>
            <a class="@(currentAction == "Users" ? "active" : "")" href="/Admin/Users">Users</a>
            <a class="@(currentAction == "UserAccess" ? "active" : "")" href="/Admin/UserAccess">User Access</a>
            <a class="@(currentAction == "Roles" ? "active" : "")" href="/Admin/Roles">Roles</a>
            <a class="@(currentAction == "Permissions" ? "active" : "")" href="/Admin/Permissions">Permissions</a>
            <a class="@(currentAction == "Bookings" ? "active" : "")" href="/Admin/Bookings">Bookings</a>
            <a class="@(currentAction == "Transactions" ? "active" : "")" href="/Admin/Transactions">Transactions</a>
            <a class="@(currentAction == "Refunds" ? "active" : "")" href="/Admin/Refunds">Refunds</a>
            <a class="@(currentAction == "Wallets" ? "active" : "")" href="/Admin/Wallets">Wallets</a>
            <a class="@(currentAction == "Notifications" ? "active" : "")" href="/Admin/Notifications">Notifications</a>
            <a class="@(currentAction == "ActivityLogs" ? "active" : "")" href="/Admin/ActivityLogs">Activity Logs</a>

        </nav>

    </aside>

    <main class="admin-main">

        <header class="admin-topbar">
            <button class="admin-icon-btn"
                    type="button"
                    id="adminNavToggle"
                    aria-controls="adminSidebar"
                    aria-expanded="true"
                    title="Hide or show navigation">
                ☰ Menu
            </button>

            <!-- Human Comment: Shared admin search filters visible tables and dashboard cards on the current page. -->
            <form class="admin-search" role="search" onsubmit="return false;">
                <label for="adminPageSearch" class="visually-hidden">Search this page</label>
                <span aria-hidden="true">⌕</span>
                <input id="adminPageSearch"
                       type="search"
                       placeholder="Search this page" />
                <button type="button"
                        id="adminSearchClear"
                        title="Clear search">
                    ×
                </button>
            </form>
        </header>

        @RenderBody()

    </main>

</div>

<script src="~/js/admin/admin-dashboard.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
