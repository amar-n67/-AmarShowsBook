<script>
(function () {
    // Admin assistant can trigger local export only when the current role can see the export button.
    const widget = document.querySelector("[data-amaro-widget]");
    if (!widget) return;

    const toggle = widget.querySelector("[data-amaro-toggle]");
    const close = widget.querySelector("[data-amaro-close]");
    const panel = widget.querySelector("#adminAmaroPanel");
    const form = widget.querySelector("[data-amaro-form]");
    const input = widget.querySelector("[data-amaro-input]");
    const thread = widget.querySelector("[data-amaro-thread]");
    const options = widget.querySelector("[data-amaro-options]");
    const greeting = widget.querySelector("[data-amaro-greeting]");
    const commandDeck = widget.querySelector("[data-amaro-command-deck]");
    const token = form.querySelector("input[name='__RequestVerificationToken']")?.value || "";
    const submitButton = form.querySelector("button[type='submit']");
    const canCapture = document.body?.dataset.captureAllowed === "true";

    function addMessage(text, kind) {
        const bubble = document.createElement("div");
        bubble.className = "admin-amaro-message admin-amaro-message-" + kind;
        bubble.textContent = text;
        thread.appendChild(bubble);
        thread.scrollTop = thread.scrollHeight;
        return bubble;
    }

    function findPageSearchInput() {
        return document.querySelector("#adminPageSearch") ||
            document.querySelector("[data-page-filter-search]") ||
            document.querySelector("input[type='search']") ||
            Array.from(document.querySelectorAll("input[type='text']")).find(field =>
                /search|filter|find/i.test(field.placeholder || field.name || field.id || ""));
    }

    function applyPageSearch(term) {
        const searchInput = findPageSearchInput();
        if (!searchInput) {
            addMessage("I could not find a search box on this page.", "bot");
            return true;
        }

        searchInput.focus();
        searchInput.value = term || "";
        ["input", "keyup", "change"].forEach(type => {
            searchInput.dispatchEvent(new Event(type, { bubbles: true }));
        });

        addMessage(term ? `Searching this page for "${term}".` : "Search box is ready. Type what you want to find.", "bot");
        return true;
    }

    function directCommandFor(text) {
        const clean = String(text || "").trim();
        const lower = clean.toLowerCase();
        const markers = [
            "search this page for ",
            "search page for ",
            "filter this page for ",
            "find on this page ",
            "search current page for ",
            "page search "
        ];

        if (lower === "back" || lower === "go back" || lower.includes("previous page")) return "go-back";
        if (lower === "print" || lower === "print page" || lower === "print this page" || lower.includes("print current page")) return "print-page";
        if (lower === "clear search" || lower === "clear page search" || lower === "clear this page search") return "clear-page-search";
        if (lower === "search this page" || lower === "search page" || lower === "filter this page") return "page-search:";
        if (lower.includes("export dashboard") || lower.includes("dashboard export")) return "export-dashboard";
        if (lower === "export" || lower === "export this page") return "admin-export";
        if (lower === "close" || lower === "close bot" || lower === "hide bot" || lower === "hide amaro") return "close-bot";
        if (lower === "top" || lower === "go top" || lower === "scroll top") return "scroll-top";
        if (lower === "bottom" || lower === "go bottom" || lower === "scroll bottom") return "scroll-bottom";
        if (lower === "reload" || lower === "refresh" || lower === "refresh page") return "reload-page";
        if (lower === "home" || lower === "open home" || lower === "go home") return "open:/Home/ShowTime";
        if (lower === "wallet" || lower === "open wallet" || lower === "my wallet") return "open:/Wallet/MyWallet";
        if (lower === "transactions" || lower === "transaction" || lower === "my transactions") return "open:/Transaction/History";
        if (lower === "bookings" || lower === "my bookings" || lower === "tickets" || lower === "my tickets") return "open:/Booking/MyBookings";
        if (lower === "profile" || lower === "my profile" || lower === "open profile") return "open:/Profile/MyProfile";
        if (lower === "admin" || lower === "dashboard" || lower === "admin dashboard") return "open:/Admin/Dashboard";
        if (lower === "users" || lower === "admin users") return "open:/Admin/Users";
        if (lower === "roles" || lower === "permissions") return "open:/Admin/Roles";
        if (lower === "refunds" || lower === "admin refunds") return "open:/Admin/Refunds";
        if (lower === "security" || lower === "scanner") return "open:/Admin/Security";
        if (lower === "notifications") return "open:/Admin/Notifications";
        if (lower === "coupons" || lower === "coupon usage") return "open:/Admin/CouponUsage";
        if (lower === "activity" || lower === "activity logs") return "open:/Admin/ActivityLogs";
        if (lower === "versions") return "open:/Admin/Versions";
        if (lower === "theme dark" || lower === "dark") return "theme:dark";
        if (lower === "theme white" || lower === "white") return "theme:white";
        if (lower === "theme cinema" || lower === "cinema") return "theme:cinema";
        if (lower === "theme system" || lower === "system theme") return "theme:system";
        if (lower === "cursor native" || lower === "native cursor") return "cursor:native";
        if (lower === "cursor liquid" || lower === "liquid cursor") return "cursor:liquid";
        if (lower === "cursor precision" || lower === "precision cursor") return "cursor:precision";
        if (lower === "cursor spotlight" || lower === "spotlight cursor") return "cursor:spotlight";

        for (const marker of markers) {
            const index = lower.indexOf(marker);
            if (index >= 0) {
                return "page-search:" + clean.slice(index + marker.length).trim();
            }
        }

        return "";
    }

    function runCommand(command, label) {
        const value = String(command || "");

        if (value === "theme-options") {
            renderOptions([
                { label: "Cinema Theme", command: "theme:cinema" },
                { label: "Dark Theme", command: "theme:dark" },
                { label: "White Theme", command: "theme:white" },
                { label: "System Theme", command: "theme:system" }
            ]);
            addMessage("Choose a theme option.", "bot");
            return true;
        }

        if (value === "cursor-options") {
            renderOptions([
                { label: "Native Cursor", command: "cursor:native" },
                { label: "Liquid Cursor", command: "cursor:liquid" },
                { label: "Precision Cursor", command: "cursor:precision" },
                { label: "Spotlight Cursor", command: "cursor:spotlight" }
            ]);
            addMessage("Choose a cursor style.", "bot");
            return true;
        }

        if (value === "show-suggestions") {
            renderOptions([
                { label: "Upcoming Shows", url: "/Home/ShowTime" },
                { label: "Movies", command: "filter-type:Movie" },
                { label: "Standup", command: "filter-type:Standup" },
                { label: "Live Streams", command: "filter-type:Live" },
                { label: "Today Shows", command: "ask:today shows" }
            ]);
            addMessage("Choose how you want to explore shows.", "bot");
            return true;
        }

        if (value === "support-options") {
            renderOptions([
                { label: "Call Us", url: "tel:+919651698863" },
                { label: "Write Us", url: "mailto:support@showtime.com" },
                { label: "WhatsApp Us", url: "@supportWhatsAppUrl" },
                { label: "Admin Dashboard", url: "/Admin/Dashboard" },
                { label: "My Bookings", url: "/Booking/MyBookings" }
            ]);
            addMessage("Choose Call Us, Write Us, or WhatsApp Us for support. Share the booking, transaction, or refund reference when possible.", "bot");
            return true;
        }

        if (value === "admin-export") {
            const exportButton = document.querySelector("[data-admin-export]");
            if (exportButton) {
                exportButton.click();
                addMessage((label || "Export") + " is being generated. Your download will start shortly.", "bot");
            } else {
                addMessage("Open an admin table page first, then I can export its visible rows.", "bot");
            }
            return true;
        }

        if (value === "export-dashboard") {
            addMessage("Dashboard Excel export is being generated. Your download will start shortly.", "bot");
            window.location.href = "/Admin/ExportDashboard";
            return true;
        }

        if (value === "print-page") {
            if (!canCapture) {
                window.showCaptureProtection?.("Print is allowed only for Admin and Super Admin.");
                addMessage("Print is blocked for your role.", "bot");
                return true;
            }
            addMessage("Opening the print dialog for this page.", "bot");
            setTimeout(() => window.print(), 80);
            return true;
        }

        if (value === "go-back") {
            addMessage("Taking you back.", "bot");
            setTimeout(() => {
                if (window.adminBack) {
                    window.adminBack();
                } else if (window.history.length > 1) {
                    window.history.back();
                } else {
                    window.location.href = "/Admin/Dashboard";
                }
            }, 80);
            return true;
        }

        if (value.startsWith("page-search:")) {
            return applyPageSearch(value.slice("page-search:".length).trim());
        }

        if (value === "clear-page-search") {
            return applyPageSearch("");
        }

        if (value === "close-bot") {
            panel.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
            return true;
        }

        if (value === "scroll-top") {
            window.scrollTo({ top: 0, behavior: "smooth" });
            addMessage("Moved to the top of the page.", "bot");
            return true;
        }

        if (value === "scroll-bottom") {
            window.scrollTo({ top: document.documentElement.scrollHeight, behavior: "smooth" });
            addMessage("Moved to the bottom of the page.", "bot");
            return true;
        }

        if (value === "reload-page") {
            addMessage("Refreshing this page.", "bot");
            setTimeout(() => window.location.reload(), 120);
            return true;
        }

        if (value.startsWith("open:")) {
            const url = value.slice(5);
            if (url.startsWith("/")) {
                addMessage("Opening " + (label || "that page") + ".", "bot");
                window.location.href = url;
                return true;
            }
        }

        if (value.startsWith("ask:")) {
            sendMessage(value.slice(4));
            return true;
        }

        if (value.startsWith("theme:")) {
            const theme = value.split(":")[1] || "cinema";
            if (window.setAdminTheme) {
                window.setAdminTheme(theme);
            } else if (window.setAppTheme) {
                window.setAppTheme(theme);
            }
            addMessage((label || "Theme") + " applied.", "bot");
            return true;
        }

        if (value.startsWith("cursor:")) {
            const cursor = value.split(":")[1] || "native";
            window.setAppCursorStyle?.(cursor);
            addMessage((label || "Cursor") + " applied across the app.", "bot");
            return true;
        }

        if (value.startsWith("filter-type:")) {
            const showType = value.split(":")[1] || "Movie";
            window.location.href = "/Home/ShowTime?type=" + encodeURIComponent(showType);
            return true;
        }

        return false;
    }

    function normalizeOption(item) {
        const option = typeof item === "string"
            ? { label: item, url: "", command: "" }
            : { label: item.label || item.url || "", url: item.url || "", command: item.command || "" };
        const label = String(option.label || "").trim();
        const key = label.toLowerCase();

        if (!option.command && !option.url) {
            if (key === "login") option.url = "/Auth/Login";
            if (key === "signup") option.url = "/Auth/Signup";
            if (key.includes("today") || key.includes("browse") || key === "book a show" || key === "book shows") option.url = "/Home/ShowTime";
            if (key === "movies" || key === "movie") option.command = "filter-type:Movie";
            if (key === "standup") option.command = "filter-type:Standup";
            if (key.includes("live")) option.command = "filter-type:Live";
            if (key.includes("seat")) option.command = "show-suggestions";
            if (key.includes("theme")) option.command = "theme-options";
            if (key.includes("cursor")) option.command = "cursor-options";
            if (key.includes("support") || key.includes("contact")) option.command = "support-options";
            if (key.includes("export dashboard") || key.includes("dashboard export")) option.command = "export-dashboard";
            else if (key.includes("export")) option.command = "admin-export";
            if (key.includes("print")) option.command = "print-page";
            if (key === "back" || key.includes("go back")) option.command = "go-back";
            if (key.includes("search this page")) option.command = "page-search:";
            if (key.includes("clear search")) option.command = "clear-page-search";
            if (key === "home") option.command = "open:/Home/ShowTime";
            if (key === "admin dashboard") option.command = "open:/Admin/Dashboard";
            if (key.includes("admin summary")) option.command = "ask:admin summary";
            if (key.includes("search admin")) option.command = "ask:search admin records";
            if (key.includes("booking") && key.includes("my")) option.url = "/Booking/MyBookings";
            if (key === "wallet") option.url = "/Wallet/MyWallet";
            if (key.includes("transaction")) option.url = "/Transaction/History";
            if (key === "profile") option.url = "/Profile/MyProfile";
        }

        return { label, url: option.url || "", command: option.command || "" };
    }

    function renderOptions(items) {
        options.innerHTML = "";
        items.slice(0, 6).forEach(item => {
            const option = normalizeOption(item);

            if (!option.label) return;

            const button = document.createElement("button");
            button.type = "button";
            button.textContent = option.label;
            button.addEventListener("click", () => {
                if (option.command && runCommand(option.command, option.label)) {
                    return;
                }

                if (option.url && (option.url.startsWith("/") || option.url.startsWith("mailto:") || option.url.startsWith("tel:") || option.url.startsWith("https://wa.me/"))) {
                    window.location.href = option.url;
                    return;
                }

                sendMessage(option.label);
            });
            options.appendChild(button);
        });
    }

    function sendMessage(text) {
        const clean = (text || "").trim();
        if (!clean) return;

        addMessage(clean, "user");
        input.value = "";

        const directCommand = directCommandFor(clean);
        if (directCommand) {
            options.innerHTML = "";
            if (runCommand(directCommand, clean)) {
                return;
            }
        }

        const thinking = addMessage("Thinking...", "bot");
        input.disabled = true;
        if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = "Wait";
        }

        fetch("/Amaro/Ask", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify({ message: clean })
        })
        .then(response => response.json())
        .then(data => {
            thinking.remove();
            addMessage(data.message || "I could not find details for that yet.", "bot");
            renderOptions(data.options || []);
        })
        .catch(() => {
            thinking.remove();
            addMessage("I could not reach Amaro right now. Please try again.", "bot");
        })
        .finally(() => {
            input.disabled = false;
            if (submitButton) {
                submitButton.disabled = false;
                submitButton.textContent = "Send";
            }
            input.focus();
        });
    }

    function loadMenu() {
        fetch("/Amaro/Menu")
            .then(response => response.json())
            .then(data => {
                if (data.greeting && greeting) {
                    greeting.textContent = data.greeting;
                }
                renderOptions(data.options || []);
            })
            .catch(() => renderOptions([
                "Admin Summary",
                "Search Records",
                ...(@canUsePrintTools.ToString().ToLowerInvariant() ? ["Export This Page"] : [])
            ]));
    }

    commandDeck?.querySelectorAll("[data-amaro-prompt]").forEach(button => {
        button.addEventListener("click", function () {
            sendMessage(button.dataset.amaroPrompt || button.textContent);
        });
    });

    toggle?.addEventListener("click", function () {
        const isOpen = panel.hidden;
        panel.hidden = !isOpen;
        toggle.setAttribute("aria-expanded", String(isOpen));
        if (isOpen) {
            loadMenu();
            setTimeout(() => input.focus(), 60);
        }
    });

    close?.addEventListener("click", function () {
        panel.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
    });

    form?.addEventListener("submit", function (event) {
        event.preventDefault();
        sendMessage(input.value);
    });
})();
</script>
<script>
(function () {
    const finePointer = window.matchMedia("(pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!finePointer.matches || reducedMotion.matches) {
        return;
    }

    const root = document.documentElement;
    const cursor = document.createElement("span");
    const trail = document.createElement("span");
    const cursorClasses = ["app-custom-cursor", "app-liquid-cursor", "app-precision-cursor", "app-spotlight-cursor"];
    let cursorX = window.innerWidth / 2;
    let cursorY = window.innerHeight / 2;
    let trailX = cursorX;
    let trailY = cursorY;
    let rafId = 0;
    let isReady = false;

    cursor.className = "liquid-cursor";
    trail.className = "liquid-cursor-trail";
    cursor.setAttribute("aria-hidden", "true");
    trail.setAttribute("aria-hidden", "true");

    function applyLiveCursorColor(color) {
        const cursorColor = color || getComputedStyle(root).getPropertyValue("--app-cursor-color").trim();
        cursor.style.setProperty("--app-cursor-color", cursorColor);
        trail.style.setProperty("--app-cursor-color", cursorColor);
    }

    function applyCursorStyle(choice) {
        const cursorChoice = choice || localStorage.getItem("showTimeCursor") || "liquid";
        const savedColor = localStorage.getItem("showTimeCursorColor");

        root.dataset.cursorChoice = cursorChoice;
        root.classList.remove(...cursorClasses);

        if (savedColor) {
            root.style.setProperty("--app-cursor-color", savedColor);
        } else {
            root.style.removeProperty("--app-cursor-color");
        }
        applyLiveCursorColor(savedColor);

        if (cursorChoice !== "native") {
            root.classList.add("app-custom-cursor", "app-" + cursorChoice + "-cursor");
        }

        if (cursorChoice === "native") {
            cursor.style.display = "none";
            trail.style.display = "none";
            if (rafId) {
                cancelAnimationFrame(rafId);
                rafId = 0;
            }
            return;
        }

        cursor.style.display = "";
        trail.style.display = "";
        if (isReady && !rafId) {
            rafId = requestAnimationFrame(renderCursor);
        }
    }

    window.setAppCursorStyle = function (choice) {
        const cursorChoice = choice || "native";
        localStorage.setItem("showTimeCursor", cursorChoice);
        applyCursorStyle(cursorChoice);
    };

    window.setAppCursorColor = function (color) {
        const cursorColor = color || "";
        if (cursorColor) {
            localStorage.setItem("showTimeCursorColor", cursorColor);
            root.style.setProperty("--app-cursor-color", cursorColor);
        } else {
            localStorage.removeItem("showTimeCursorColor");
            root.style.removeProperty("--app-cursor-color");
        }

        applyLiveCursorColor(cursorColor);

        if (!localStorage.getItem("showTimeCursor") && cursorColor) {
            window.setAppCursorStyle("liquid");
        }
    };

    function setActionState(event) {
        const action = event.target.closest("a,button,input,select,textarea,label,[role='button'],.dashboard-card,.admin-nav a,.admin-icon-btn");
        root.classList.toggle("cursor-action", Boolean(action));
    }

    function moveCursor(event) {
        cursorX = event.clientX;
        cursorY = event.clientY;
        root.classList.remove("cursor-hidden");
        setActionState(event);

        if (!rafId) {
            rafId = requestAnimationFrame(renderCursor);
        }
    }

    function renderCursor() {
        trailX += (cursorX - trailX) * 0.18;
        trailY += (cursorY - trailY) * 0.18;

        cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
        trail.style.transform = `translate3d(${trailX}px, ${trailY}px, 0) translate(-50%, -50%)`;
        rafId = requestAnimationFrame(renderCursor);
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.body.appendChild(trail);
        document.body.appendChild(cursor);
        root.classList.add("cursor-hidden");
        isReady = true;
        window.setAppCursorColor(localStorage.getItem("showTimeCursorColor") || "");
        applyCursorStyle(localStorage.getItem("showTimeCursor") || "liquid");
    });

    document.addEventListener("mousemove", moveCursor, { passive: true });
    document.addEventListener("mouseleave", function () {
        root.classList.add("cursor-hidden");
    });
})();
</script>
<script>
(function () {
    function contactIconSvg(type) {
        if (type === "mail") return '<svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-10 6L2 7"/></svg>';
        if (type === "whatsapp") return '<svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.4-4.8A8.5 8.5 0 1 1 7.8 19L3 21Z"/><path d="M9.2 8.8c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.8 1.8c.1.3.1.5-.1.7l-.4.5c-.1.1-.2.3 0 .5.4.8 1.1 1.5 2.1 2 .3.1.4.1.6-.1l.7-.8c.2-.2.4-.2.7-.1l1.8.9c.3.1.4.3.4.5 0 .6-.4 1.4-.9 1.7-.5.3-1.8.6-4.1-.5-3.4-1.6-5.5-4.7-5.7-6.1-.2-1 .3-1.6.7-1.9.2-.2.5-.3.8-.3Z"/></svg>';
        return '<svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>';
    }

    const iconMap = new Map([
        ["help", contactIconSvg("call")],
        ["email us", contactIconSvg("mail")],
        ["write us", contactIconSvg("mail")],
        ["whatsapp us", contactIconSvg("whatsapp")],
        ["call us", contactIconSvg("call")],
        ["summary", "📊"],
        ["admin summary", "📊"],
        ["search", "🔎"],
        ["search records", "🔎"],
        ["export", "⬇"],
        ["export this page", "⬇"],
        ["access", "🔐"],
        ["open", "→"],
        ["view", "👁"],
        ["view details", "👁"],
        ["save", "✓"],
        ["save device", "✓"],
        ["save changes", "✓"],
        ["update", "✓"],
        ["edit", "✎"],
        ["delete", "🗑"],
        ["cancel", "×"],
        ["close", "×"],
        ["reset", "↺"],
        ["print", "🖨"],
        ["download", "⬇"],
        ["insert", "+"],
        ["insert news", "+"],
        ["add validation", "+"],
        ["grant", "+"],
        ["remove", "−"],
        ["reactivate", "↺"],
        ["suspend", "⏸"],
        ["back to dashboard", "←"],
        ["back to transactions", "←"],
        ["logout", "⏻"],
        ["my profile", "👤"],
        ["developer profile", "🧩"]
    ]);

    function normalizedText(element) {
        return Array.from(element.childNodes)
            .filter(node => node.nodeType === Node.TEXT_NODE)
            .map(node => node.textContent || "")
            .join(" ")
            .trim()
            .replace(/\s+/g, " ")
            .replace(/^←\s*/, "")
            .toLowerCase();
    }

    function iconFor(label) {
        if (iconMap.has(label)) return iconMap.get(label);
        if (label.startsWith("back ")) return "←";
        if (label.startsWith("save ")) return "✓";
        if (label.startsWith("delete ")) return "🗑";
        if (label.startsWith("download ")) return "⬇";
        if (label.startsWith("view ")) return "👁";
        return null;
    }

    function shouldSkip(element) {
        const rawText = (element.textContent || "").trim();
        return /^[←→↺✓✎×+\-−⏸⏻🖨⬇🔎🔐👁👤🧩📊]/u.test(rawText) ||
            element.querySelector(".action-icon-inline,.contact-svg-icon,.alert-support-icon,.dashboard-profile-action-icon,.admin-nav-icon,.admin-icon-btn-icon") ||
            element.closest(".alert-support-link,.dashboard-profile-action,.admin-nav a");
    }

    function iconify(root) {
        const elements = root.matches?.("a, button")
            ? [root, ...root.querySelectorAll("a, button")]
            : [...root.querySelectorAll("a, button")];
        elements.forEach(element => {
            if (shouldSkip(element)) return;
            const label = normalizedText(element);
            if (!label) return;
            const icon = iconFor(label);
            if (!icon) return;

            const iconSpan = document.createElement("span");
            iconSpan.className = "action-icon-inline";
            iconSpan.setAttribute("aria-hidden", "true");
            if (icon.startsWith("<svg")) {
                iconSpan.innerHTML = icon;
            } else {
                iconSpan.textContent = icon;
            }
            element.prepend(iconSpan);
            element.classList.add("action-iconified");
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        iconify(document);
        new MutationObserver(mutations => {
            mutations.forEach(mutation => {
                mutation.addedNodes.forEach(node => {
                    if (node.nodeType !== Node.ELEMENT_NODE) return;
                    iconify(node);
                });
            });
        }).observe(document.body, { childList: true, subtree: true });
    });
})();
</script>
