@inject AmarShowsBook.Services.RbacService RbacService
<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Admin Panel</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script>
        (function () {
            // Admin pages reuse the same saved theme and cursor choices as the public site.
            const savedTheme = localStorage.getItem("amarShowsTheme") || "cinema";
            const savedCursor = localStorage.getItem("amarShowsCursor") || "liquid";
            const savedCursorColor = localStorage.getItem("amarShowsCursorColor");
            document.documentElement.dataset.theme = savedTheme;
            document.documentElement.dataset.cursorChoice = savedCursor;
            if (savedCursorColor) {
                document.documentElement.style.setProperty("--app-cursor-color", savedCursorColor);
            }
        })();
    </script>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="~/css/admin/admin-dashboard.css" />

    <style>
        @@media (pointer: fine) {
            html.app-custom-cursor,
            html.app-custom-cursor body,
            html.app-custom-cursor a,
            html.app-custom-cursor button,
            html.app-custom-cursor input,
            html.app-custom-cursor select,
            html.app-custom-cursor textarea,
            html.app-custom-cursor [role="button"] {
                cursor: none !important;
            }

            .liquid-cursor,
            .liquid-cursor-trail {
                position: fixed;
                left: 0;
                top: 0;
                pointer-events: none;
                z-index: 2147483647;
                border-radius: 999px;
                transform: translate3d(-50%, -50%, 0);
                will-change: transform, width, height, opacity;
            }

            .liquid-cursor {
                width: 10px;
                height: 10px;
                border: 1px solid rgba(255, 255, 255, 0.78);
                background:
                    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.95), transparent 36%),
                    color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 72%, var(--admin-rose));
                box-shadow:
                    0 0 0 1px color-mix(in srgb, var(--admin-ink) 10%, transparent),
                    0 0 18px color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 42%, transparent);
                backdrop-filter: blur(4px) saturate(130%);
                transition: width 0.14s ease, height 0.14s ease, opacity 0.18s ease, background 0.14s ease;
            }

            .liquid-cursor-trail {
                width: 34px;
                height: 34px;
                border: 1px solid color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 46%, transparent);
                background: color-mix(in srgb, var(--admin-gold) 10%, transparent);
                box-shadow: 0 0 24px color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 22%, transparent);
                backdrop-filter: blur(2px);
                opacity: 0.76;
                transition: width 0.16s ease, height 0.16s ease, opacity 0.2s ease, border-color 0.16s ease;
            }

            html.app-liquid-cursor.cursor-action .liquid-cursor {
                width: 8px;
                height: 8px;
                background:
                    radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.95), transparent 36%),
                    var(--admin-gold);
            }

            html.app-liquid-cursor.cursor-action .liquid-cursor-trail {
                width: 44px;
                height: 44px;
                border-color: color-mix(in srgb, var(--admin-gold) 62%, transparent);
                opacity: 0.84;
            }

            html.app-liquid-cursor .liquid-cursor {
                width: 14px;
                height: 14px;
                border-radius: 60% 42% 58% 46%;
                animation: adminCursorLiquidPulse 1.7s ease-in-out infinite;
            }

            html.app-liquid-cursor .liquid-cursor-trail {
                width: 38px;
                height: 38px;
                border-radius: 42% 58% 46% 62%;
                background: radial-gradient(circle, color-mix(in srgb, var(--app-cursor-color, var(--admin-teal)) 16%, transparent), transparent 68%);
            }

            html.app-liquid-cursor.cursor-hidden .liquid-cursor,
            html.app-liquid-cursor.cursor-hidden .liquid-cursor-trail,
            html.app-precision-cursor.cursor-hidden .liquid-cursor,
            html.app-precision-cursor.cursor-hidden .liquid-cursor-trail,
            html.app-spotlight-cursor.cursor-hidden .liquid-cursor,
            html.app-spotlight-cursor.cursor-hidden .liquid-cursor-trail {
                opacity: 0;
            }

            html.app-precision-cursor .liquid-cursor {
                width: 22px;
                height: 22px;
                border: 0;
                border-radius: 2px;
                background:
                    linear-gradient(var(--app-cursor-color, var(--admin-rose)), var(--app-cursor-color, var(--admin-rose))) center / 2px 22px no-repeat,
                    linear-gradient(90deg, var(--app-cursor-color, var(--admin-rose)), var(--app-cursor-color, var(--admin-rose))) center / 22px 2px no-repeat;
                box-shadow: none;
                backdrop-filter: none;
            }

            html.app-precision-cursor .liquid-cursor-trail {
                width: 34px;
                height: 34px;
                border: 2px dashed var(--app-cursor-color, var(--admin-rose));
                border-radius: 50%;
                background: transparent;
                box-shadow: inset 0 0 0 5px color-mix(in srgb, var(--app-cursor-color, var(--admin-rose)) 8%, transparent);
                opacity: 0.88;
                backdrop-filter: none;
            }

            html.app-precision-cursor.cursor-action .liquid-cursor-trail {
                width: 42px;
                height: 42px;
                border-style: solid;
            }

            html.app-spotlight-cursor .liquid-cursor {
                width: 5px;
                height: 5px;
                border: 0;
                background: var(--app-cursor-color, var(--admin-gold));
                box-shadow: 0 0 12px color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 52%, transparent);
                backdrop-filter: none;
            }

            html.app-spotlight-cursor .liquid-cursor-trail {
                width: 84px;
                height: 84px;
                border: 2px solid color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 58%, transparent);
                background:
                    radial-gradient(circle, transparent 0 30%, color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 14%, transparent) 32% 100%);
                box-shadow:
                    inset 0 0 22px color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 28%, transparent),
                    0 0 34px color-mix(in srgb, var(--app-cursor-color, var(--admin-gold)) 22%, transparent);
                opacity: 0.72;
                backdrop-filter: blur(1px);
            }

            html.app-spotlight-cursor.cursor-action .liquid-cursor-trail {
                width: 104px;
                height: 104px;
                opacity: 0.82;
            }

            @@keyframes adminCursorLiquidPulse {
                0%, 100% {
                    border-radius: 60% 42% 58% 46%;
                }
                50% {
                    border-radius: 42% 62% 44% 58%;
                }
            }
        }
    </style>
</head>

@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var userIdText = Context.Session.GetString("UserId");
    var hasUserId = int.TryParse(userIdText, out var currentUserId);
    Func<string, string, bool> canShowAdminNav = (module, action) =>
        hasUserId && RbacService.HasPermission(currentUserId, module, action);
    var adminNavItems = new[]
    {
        new { Action = "Dashboard", Label = "Dashboard", Url = "/Admin/Dashboard", Module = "ADMIN", Permission = "VIEW" },
        new { Action = "Users", Label = "Users", Url = "/Admin/Users", Module = "USER", Permission = "VIEW" },
        new { Action = "UserAccess", Label = "User Access", Url = "/Admin/UserAccess", Module = "USER", Permission = "GRANT_ACCESS" },
        new { Action = "Roles", Label = "Roles", Url = "/Admin/Roles", Module = "ROLE", Permission = "VIEW" },
        new { Action = "ManageShows", Label = "Manage Shows", Url = "/Admin/ManageShows", Module = "SHOW", Permission = "VIEW" },
        new { Action = "ContentManager", Label = "Data Manager", Url = "/Admin/ContentManager", Module = "SHOW", Permission = "VIEW" },
        new { Action = "Bookings", Label = "Bookings", Url = "/Admin/Bookings", Module = "BOOKING", Permission = "VIEW" },
        new { Action = "Security", Label = "Security", Url = "/Admin/Security", Module = "SCANNER", Permission = "VIEW" },
        new { Action = "Transactions", Label = "Transactions", Url = "/Admin/Transactions", Module = "PAYMENT", Permission = "VIEW" },
        new { Action = "Refunds", Label = "Refunds", Url = "/Admin/Refunds", Module = "REFUND", Permission = "VIEW" },
        new { Action = "CouponUsage", Label = "Coupon Used", Url = "/Admin/CouponUsage", Module = "COUPON", Permission = "VIEW" },
        new { Action = "Wallets", Label = "Wallets", Url = "/Admin/Wallets", Module = "WALLET", Permission = "VIEW" },
        new { Action = "Notifications", Label = "Notifications", Url = "/Admin/Notifications", Module = "NOTIFICATION", Permission = "VIEW" },
        new { Action = "ActivityLogs", Label = "Activity Logs", Url = "/Admin/ActivityLogs", Module = "ADMIN", Permission = "VIEW" },
        new { Action = "Versions", Label = "Versions", Url = "/Admin/Versions", Module = "ADMIN", Permission = "VIEW" }
    };
    var showAdminFilters = new[]
    {
        "Users","UserAccess","Roles","Bookings","Security",
        "Transactions","Wallets","Notifications","ActivityLogs","Versions","ContentManager"
    }.Contains(currentAction);
    var adminStatusOptions = currentAction switch
    {
        "Users" => new[] { "ACTIVE", "DISABLED", "NORMAL", "DELETED" },
        "UserAccess" => new[] { "ACTIVE", "DISABLED" },
        "Roles" => new[] { "ACTIVE", "INACTIVE" },
        "Bookings" => new[] { "SUCCESS", "PENDING", "FAILED", "CONFIRMED", "CANCELLED" },
        "Security" => new[] { "VALID", "INVALID", "DUPLICATE", "USED", "ISSUE", "CLEAR" },
        "Transactions" => new[] { "SUCCESS", "PENDING", "FAILED", "CONFIRMED", "CANCELLED" },
        "Wallets" => new[] { "ACTIVE", "DISABLED", "BLOCKED" },
        "Notifications" => new[] { "SUCCESS", "SENT", "DELIVERED", "READ", "PENDING", "PROCESSING", "FAILED", "FAILURE", "ERROR", "CANCELLED", "REJECTED", "ISSUE" },
        "ActivityLogs" => new[] { "SUCCESS", "FAILED", "ERROR", "PENDING" },
        "Versions" => new[] { "CURRENT", "PREVIOUS" },
        _ => Array.Empty<string>()
    };
    var adminMethodLabel = currentAction switch
    {
        "Transactions" => "Payment Method",
        "Security" => "Gate / Device",
        "Notifications" => "Source",
        "Bookings" or "ContentManager" => "Show Type",
        _ => string.Empty
    };
    var adminMethodOptions = currentAction switch
    {
        "Transactions" => new[] { "UPI", "CARD", "NETBANKING", "WALLET", "QR" },
        "Security" => new[] { "GATE", "SCANNER", "DEVICE", "UNKNOWN" },
        "Notifications" => new[] { "REFUND", "BOOKING", "PAYMENT", "NOTIFICATION", "SECURITY", "AUTH", "ADMIN", "LOG", "EMAIL", "SMS", "PUSH", "IN_APP", "WHATSAPP" },
        "Bookings" or "ContentManager" => new[] { "MOVIE", "STANDUP", "LIVE" },
        _ => Array.Empty<string>()
    };
    var adminPriorityOptions = currentAction switch
    {
        "Notifications" => new[] { "HIGH", "MEDIUM", "LOW", "NORMAL" },
        "Security" => new[] { "HIGH", "NORMAL" },
        _ => Array.Empty<string>()
    };
    var canUsePrintTools =
        AmarShowsBook.Helpers.RbacAuthorizationHelper.CanUsePrintTools(Context, RbacService);

    var adminNotificationCount =
        ViewData["AdminNotificationCount"] is int notificationCount
            ? notificationCount
            : 0;
}

<body>

<div class="admin-wrapper" id="adminShell">

    <aside class="admin-sidebar" id="adminSidebar">

        <div class="admin-logo">
            <span class="admin-logo-mark">AS</span>
            <span>AmarShowsBook</span>
        </div>

        <nav class="admin-nav" aria-label="Admin navigation">

            @foreach (var item in adminNavItems.Where(x => canShowAdminNav(x.Module, x.Permission)))
            {
                var isActive = currentAction == item.Action ||
                    (item.Action == "Transactions" && currentAction == "TransactionDetails") ||
                    (item.Action == "Refunds" && currentAction == "RefundDetails");

                <a class="@(isActive ? "active" : "")" href="@item.Url">
                    <span class="admin-nav-label">@item.Label</span>
                    @if (item.Action == "Notifications" && adminNotificationCount > 0)
                    {
                        <span class="admin-nav-count" title="Pending admin notifications">
                            @adminNotificationCount
                        </span>
                    }
                </a>
            }

        </nav>

    </aside>

    <main class="admin-main">

        <header class="admin-topbar">
            <button class="admin-icon-btn"
                    type="button"
                    id="adminNavToggle"
                    aria-controls="adminSidebar"
                    aria-expanded="true"
                    title="Hide or show navigation">
                ☰ Menu
            </button>

            @if(currentAction!="Dashboard")
            {
                <button class="admin-icon-btn no-print"
                        type="button"
                        onclick="adminBack()">
                    Back
                </button>
            }

            @if (canUsePrintTools)
            {
                <button class="admin-icon-btn no-print"
                        type="button"
                        onclick="window.print()">
                    Print
                </button>
            }

            <button class="admin-icon-btn no-print"
                    type="button"
                    id="adminExportButton"
                    data-admin-export
                    title="Export visible admin data">
                Export
            </button>

            <div class="admin-theme-switcher no-print" aria-label="Theme selector">
                <button type="button" data-admin-theme="system" onclick="setAdminTheme('system')">System</button>
                <button type="button" data-admin-theme="dark" onclick="setAdminTheme('dark')">Dark</button>
                <button type="button" data-admin-theme="white" onclick="setAdminTheme('white')">White</button>
                <button type="button" data-admin-theme="cinema" onclick="setAdminTheme('cinema')">Cinema</button>
            </div>

            <form class="admin-search" role="search" onsubmit="return false;">
                <label for="adminPageSearch" class="visually-hidden">Search this page</label>
                <span aria-hidden="true">⌕</span>
                <input id="adminPageSearch"
                       type="search"
                       placeholder="Search this page" />
                <button type="button"
                        id="adminSearchClear"
                        title="Clear search">
                    ×
                </button>
            </form>
        </header>

        @if(showAdminFilters)
        {
            <section class="admin-detail-panel admin-filter-panel no-print"
                     id="adminContextFilter"
                     data-page-filter
                     data-page-filter-target=".admin-table tbody tr, table tbody tr, .access-card, [data-admin-searchable]">
                <div class="row g-3 align-items-center">
                    <div class="col-md-3">
                        <input type="text"
                               class="form-control rounded-pill"
                               data-page-filter-search
                               placeholder="Search records">
                    </div>
                    @if(adminStatusOptions.Any())
                    {
                    <div class="col-md-2">
                        <select class="form-select rounded-pill" data-page-filter-status>
                            <option value="">All Status</option>
                            @foreach(var option in adminStatusOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    }
                    @if(adminMethodOptions.Any())
                    {
                    <div class="col-md-2">
                        <select class="form-select rounded-pill" data-page-filter-method>
                            <option value="">All @adminMethodLabel</option>
                            @foreach(var option in adminMethodOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    }
                    @if(adminPriorityOptions.Any())
                    {
                    <div class="col-md-2">
                        <select class="form-select rounded-pill filter-priority-select" data-page-filter-priority>
                            <option value="">All Color / Priority</option>
                            @foreach(var option in adminPriorityOptions)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    }
                    <div class="col-md-2">
                        <select class="form-select rounded-pill" data-page-filter-sort>
                            <option value="">Default Sort</option>
                            <option value="newest">Newest First</option>
                            <option value="oldest">Oldest First</option>
                            <option value="priority">Priority First</option>
                            <option value="status">Status A-Z</option>
                            <option value="source">Source A-Z</option>
                        </select>
                    </div>
                    <div class="col-md-1 text-end">
                        <button type="button"
                                class="btn btn-outline-dark rounded-pill w-100"
                                data-page-filter-reset>
                            Reset
                        </button>
                    </div>
                </div>
            </section>
        }

        @RenderBody()

        <style>
            .admin-main .table-wrapper table.admin-table thead th,
            .admin-main table.admin-table thead th,
            .admin-main .table thead th {
                background:
                    linear-gradient(180deg, var(--admin-panel-strong, #ffffff), rgba(248, 250, 252, 0.96)) !important;
                color: var(--admin-ink, #111827) !important;
                border-bottom: 3px solid var(--admin-gold, #d9a441) !important;
                box-shadow:
                    inset 0 -1px 0 var(--admin-line, rgba(17, 24, 39, 0.16)) !important;
                text-shadow: none !important;
            }

            html[data-theme="dark"] .admin-main .table-wrapper table.admin-table thead th,
            html[data-theme="dark"] .admin-main table.admin-table thead th,
            html[data-theme="dark"] .admin-main .table thead th {
                background:
                    linear-gradient(180deg, #111827, #20293a) !important;
                color: #f8fafc !important;
                border-bottom-color: var(--admin-gold, #e3b75a) !important;
            }
        </style>

    </main>

</div>

<div class="admin-amaro-widget no-print" data-amaro-widget>
    <button class="admin-amaro-launcher"
            type="button"
            data-amaro-toggle
            aria-expanded="false"
            aria-controls="adminAmaroPanel">
        <span>A</span>
        <strong>Amaro</strong>
    </button>
    <section id="adminAmaroPanel"
             class="admin-amaro-panel"
             aria-label="Amaro role assistant"
             hidden>
        <div class="admin-amaro-header">
            <div>
                <span>Amaro</span>
                <strong data-amaro-greeting>Ask me for admin summaries, search, exports, and role-allowed actions.</strong>
            </div>
            <button type="button" data-amaro-close aria-label="Close Amaro">×</button>
        </div>
        <div class="admin-amaro-deck" data-amaro-command-deck>
            <button type="button" data-amaro-prompt="admin summary">Summary</button>
            <button type="button" data-amaro-prompt="search admin records">Search</button>
            <button type="button" data-amaro-prompt="export this page">Export</button>
            <button type="button" data-amaro-prompt="what can I do">Access</button>
            <button type="button" data-amaro-prompt="contact support">Support</button>
        </div>
        <div class="admin-amaro-options" data-amaro-options></div>
        <div class="admin-amaro-thread" data-amaro-thread>
            <div class="admin-amaro-message admin-amaro-message-bot">
                I follow your RBAC role. Ask for refunds, users, bookings, security, wallet, notifications, coupons, support, versions, shows, or developer tools.
            </div>
        </div>
        <form class="admin-amaro-form" data-amaro-form>
            @Html.AntiForgeryToken()
            <input data-amaro-input
                   type="text"
                   maxlength="300"
                   placeholder="Ask Amaro to summarize, search, open, export, or guide actions"
                   autocomplete="off" />
            <button type="submit">Send</button>
        </form>
    </section>
</div>

<script src="~/js/admin/admin-dashboard.js"></script>
<script>
(function () {
    function markAdminTheme(choice) {
        document.querySelectorAll("[data-admin-theme]").forEach(button => {
            button.classList.toggle("active", button.dataset.adminTheme === choice);
        });
    }

    window.setAdminTheme = function (choice) {
        const theme = choice || "cinema";
        localStorage.setItem("amarShowsTheme", theme);
        localStorage.setItem("amarShowsThemeVersion", "3");
        document.documentElement.dataset.theme = theme;
        markAdminTheme(theme);
    };

    window.adminBack = function () {
        if (window.history.length > 1) {
            window.history.back();
            return;
        }

        window.location.href = "/Admin/Dashboard";
    };

    document.addEventListener("DOMContentLoaded", function () {
        const saved = localStorage.getItem("amarShowsTheme") || "cinema";
        window.setAdminTheme(saved);
    });
})();
</script>
<script>
(function () {
    // Admin Amaro can trigger local export only when the current role can see the export button.
    const widget = document.querySelector("[data-amaro-widget]");
    if (!widget) return;

    const toggle = widget.querySelector("[data-amaro-toggle]");
    const close = widget.querySelector("[data-amaro-close]");
    const panel = widget.querySelector("#adminAmaroPanel");
    const form = widget.querySelector("[data-amaro-form]");
    const input = widget.querySelector("[data-amaro-input]");
    const thread = widget.querySelector("[data-amaro-thread]");
    const options = widget.querySelector("[data-amaro-options]");
    const greeting = widget.querySelector("[data-amaro-greeting]");
    const commandDeck = widget.querySelector("[data-amaro-command-deck]");
    const token = form.querySelector("input[name='__RequestVerificationToken']")?.value || "";

    function addMessage(text, kind) {
        const bubble = document.createElement("div");
        bubble.className = "admin-amaro-message admin-amaro-message-" + kind;
        bubble.textContent = text;
        thread.appendChild(bubble);
        thread.scrollTop = thread.scrollHeight;
    }

    function runCommand(command, label) {
        const value = String(command || "");

        if (value === "theme-options") {
            renderOptions([
                { label: "Cinema Theme", command: "theme:cinema" },
                { label: "Dark Theme", command: "theme:dark" },
                { label: "White Theme", command: "theme:white" },
                { label: "System Theme", command: "theme:system" }
            ]);
            addMessage("Choose a theme option.", "bot");
            return true;
        }

        if (value === "cursor-options") {
            renderOptions([
                { label: "Native Cursor", command: "cursor:native" },
                { label: "Liquid Cursor", command: "cursor:liquid" },
                { label: "Precision Cursor", command: "cursor:precision" },
                { label: "Spotlight Cursor", command: "cursor:spotlight" }
            ]);
            addMessage("Choose a cursor style.", "bot");
            return true;
        }

        if (value === "show-suggestions") {
            renderOptions([
                { label: "Upcoming Shows", url: "/Home/ShowTime" },
                { label: "Movies", command: "filter-type:Movie" },
                { label: "Standup", command: "filter-type:Standup" },
                { label: "Live Streams", command: "filter-type:Live" },
                { label: "Today Shows", command: "ask:today shows" }
            ]);
            addMessage("Choose how you want to explore shows.", "bot");
            return true;
        }

        if (value === "support-options") {
            renderOptions([
                { label: "Call Support", url: "tel:+918920993434" },
                { label: "Email Support", url: "mailto:arcanaamar67@gmail.com" },
                { label: "Admin Dashboard", url: "/Admin/Dashboard" },
                { label: "My Bookings", url: "/Booking/MyBookings" }
            ]);
            addMessage("Support is available at +91 8920993434 and arcanaamar67@gmail.com. Share the booking, transaction, or refund reference when possible.", "bot");
            return true;
        }

        if (value === "admin-export") {
            const exportButton = document.querySelector("[data-admin-export]");
            if (exportButton) {
                exportButton.click();
                addMessage((label || "Export") + " started for the visible rows on this page.", "bot");
            } else {
                addMessage("Open an admin table page first, then I can export its visible rows.", "bot");
            }
            return true;
        }

        if (value.startsWith("ask:")) {
            sendMessage(value.slice(4));
            return true;
        }

        if (value.startsWith("theme:")) {
            const theme = value.split(":")[1] || "cinema";
            if (window.setAdminTheme) {
                window.setAdminTheme(theme);
            } else if (window.setAppTheme) {
                window.setAppTheme(theme);
            }
            addMessage((label || "Theme") + " applied.", "bot");
            return true;
        }

        if (value.startsWith("cursor:")) {
            const cursor = value.split(":")[1] || "native";
            window.setAppCursorStyle?.(cursor);
            addMessage((label || "Cursor") + " applied across the app.", "bot");
            return true;
        }

        if (value.startsWith("filter-type:")) {
            const showType = value.split(":")[1] || "Movie";
            window.location.href = "/Home/ShowTime?type=" + encodeURIComponent(showType);
            return true;
        }

        return false;
    }

    function normalizeOption(item) {
        const option = typeof item === "string"
            ? { label: item, url: "", command: "" }
            : { label: item.label || item.url || "", url: item.url || "", command: item.command || "" };
        const label = String(option.label || "").trim();
        const key = label.toLowerCase();

        if (!option.command && !option.url) {
            if (key === "login") option.url = "/Auth/Login";
            if (key === "signup") option.url = "/Auth/Signup";
            if (key.includes("today") || key.includes("browse") || key === "book a show" || key === "book shows") option.url = "/Home/ShowTime";
            if (key === "movies" || key === "movie") option.command = "filter-type:Movie";
            if (key === "standup") option.command = "filter-type:Standup";
            if (key.includes("live")) option.command = "filter-type:Live";
            if (key.includes("seat")) option.command = "show-suggestions";
            if (key.includes("theme")) option.command = "theme-options";
            if (key.includes("cursor")) option.command = "cursor-options";
            if (key.includes("support") || key.includes("contact")) option.command = "support-options";
            if (key.includes("export")) option.command = "admin-export";
            if (key.includes("admin summary")) option.command = "ask:admin summary";
            if (key.includes("search admin")) option.command = "ask:search admin records";
            if (key.includes("booking") && key.includes("my")) option.url = "/Booking/MyBookings";
            if (key === "wallet") option.url = "/Wallet/MyWallet";
            if (key.includes("transaction")) option.url = "/Transaction/History";
            if (key === "profile") option.url = "/Profile/MyProfile";
        }

        return { label, url: option.url || "", command: option.command || "" };
    }

    function renderOptions(items) {
        options.innerHTML = "";
        items.slice(0, 6).forEach(item => {
            const option = normalizeOption(item);

            if (!option.label) return;

            const button = document.createElement("button");
            button.type = "button";
            button.textContent = option.label;
            button.addEventListener("click", () => {
                if (option.command && runCommand(option.command, option.label)) {
                    return;
                }

                if (option.url && (option.url.startsWith("/") || option.url.startsWith("mailto:") || option.url.startsWith("tel:"))) {
                    window.location.href = option.url;
                    return;
                }

                sendMessage(option.label);
            });
            options.appendChild(button);
        });
    }

    function sendMessage(text) {
        const clean = (text || "").trim();
        if (!clean) return;

        addMessage(clean, "user");
        input.value = "";

        fetch("/Amaro/Ask", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify({ message: clean })
        })
        .then(response => response.json())
        .then(data => {
            addMessage(data.message || "I could not find details for that yet.", "bot");
            renderOptions(data.options || []);
        })
        .catch(() => addMessage("I could not reach Amaro right now. Please try again.", "bot"));
    }

    function loadMenu() {
        fetch("/Amaro/Menu")
            .then(response => response.json())
            .then(data => {
                if (data.greeting && greeting) {
                    greeting.textContent = data.greeting;
                }
                renderOptions(data.options || []);
            })
            .catch(() => renderOptions(["Admin Summary", "Search Records", "Export This Page"]));
    }

    commandDeck?.querySelectorAll("[data-amaro-prompt]").forEach(button => {
        button.addEventListener("click", function () {
            sendMessage(button.dataset.amaroPrompt || button.textContent);
        });
    });

    toggle?.addEventListener("click", function () {
        const isOpen = panel.hidden;
        panel.hidden = !isOpen;
        toggle.setAttribute("aria-expanded", String(isOpen));
        if (isOpen) {
            loadMenu();
            setTimeout(() => input.focus(), 60);
        }
    });

    close?.addEventListener("click", function () {
        panel.hidden = true;
        toggle.setAttribute("aria-expanded", "false");
    });

    form?.addEventListener("submit", function (event) {
        event.preventDefault();
        sendMessage(input.value);
    });
})();
</script>
<script>
(function () {
    const finePointer = window.matchMedia("(pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!finePointer.matches || reducedMotion.matches) {
        return;
    }

    const root = document.documentElement;
    const cursor = document.createElement("span");
    const trail = document.createElement("span");
    const cursorClasses = ["app-custom-cursor", "app-liquid-cursor", "app-precision-cursor", "app-spotlight-cursor"];
    let cursorX = window.innerWidth / 2;
    let cursorY = window.innerHeight / 2;
    let trailX = cursorX;
    let trailY = cursorY;
    let rafId = 0;
    let isReady = false;

    cursor.className = "liquid-cursor";
    trail.className = "liquid-cursor-trail";
    cursor.setAttribute("aria-hidden", "true");
    trail.setAttribute("aria-hidden", "true");

    function applyLiveCursorColor(color) {
        const cursorColor = color || getComputedStyle(root).getPropertyValue("--app-cursor-color").trim();
        cursor.style.setProperty("--app-cursor-color", cursorColor);
        trail.style.setProperty("--app-cursor-color", cursorColor);
    }

    function applyCursorStyle(choice) {
        const cursorChoice = choice || localStorage.getItem("amarShowsCursor") || "liquid";
        const savedColor = localStorage.getItem("amarShowsCursorColor");

        root.dataset.cursorChoice = cursorChoice;
        root.classList.remove(...cursorClasses);

        if (savedColor) {
            root.style.setProperty("--app-cursor-color", savedColor);
        } else {
            root.style.removeProperty("--app-cursor-color");
        }
        applyLiveCursorColor(savedColor);

        if (cursorChoice !== "native") {
            root.classList.add("app-custom-cursor", "app-" + cursorChoice + "-cursor");
        }

        if (cursorChoice === "native") {
            cursor.style.display = "none";
            trail.style.display = "none";
            if (rafId) {
                cancelAnimationFrame(rafId);
                rafId = 0;
            }
            return;
        }

        cursor.style.display = "";
        trail.style.display = "";
        if (isReady && !rafId) {
            rafId = requestAnimationFrame(renderCursor);
        }
    }

    window.setAppCursorStyle = function (choice) {
        const cursorChoice = choice || "native";
        localStorage.setItem("amarShowsCursor", cursorChoice);
        applyCursorStyle(cursorChoice);
    };

    window.setAppCursorColor = function (color) {
        const cursorColor = color || "";
        if (cursorColor) {
            localStorage.setItem("amarShowsCursorColor", cursorColor);
            root.style.setProperty("--app-cursor-color", cursorColor);
        } else {
            localStorage.removeItem("amarShowsCursorColor");
            root.style.removeProperty("--app-cursor-color");
        }

        applyLiveCursorColor(cursorColor);

        if (!localStorage.getItem("amarShowsCursor") && cursorColor) {
            window.setAppCursorStyle("liquid");
        }
    };

    function setActionState(event) {
        const action = event.target.closest("a,button,input,select,textarea,label,[role='button'],.dashboard-card,.admin-nav a,.admin-icon-btn");
        root.classList.toggle("cursor-action", Boolean(action));
    }

    function moveCursor(event) {
        cursorX = event.clientX;
        cursorY = event.clientY;
        root.classList.remove("cursor-hidden");
        setActionState(event);

        if (!rafId) {
            rafId = requestAnimationFrame(renderCursor);
        }
    }

    function renderCursor() {
        trailX += (cursorX - trailX) * 0.18;
        trailY += (cursorY - trailY) * 0.18;

        cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
        trail.style.transform = `translate3d(${trailX}px, ${trailY}px, 0) translate(-50%, -50%)`;
        rafId = requestAnimationFrame(renderCursor);
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.body.appendChild(trail);
        document.body.appendChild(cursor);
        root.classList.add("cursor-hidden");
        isReady = true;
        window.setAppCursorColor(localStorage.getItem("amarShowsCursorColor") || "");
        applyCursorStyle(localStorage.getItem("amarShowsCursor") || "liquid");
    });

    document.addEventListener("mousemove", moveCursor, { passive: true });
    document.addEventListener("mouseleave", function () {
        root.classList.add("cursor-hidden");
    });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
