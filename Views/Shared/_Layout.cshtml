    --app-input-border: #bac4d4;
    --app-input-disabled: #e3e8f0;
    --app-input-disabled-text: #667085;
    --app-muted: #64748b;
    --app-link: #315f9f;
    --app-primary: #315f9f;
    --app-primary-hover: #244a7e;
