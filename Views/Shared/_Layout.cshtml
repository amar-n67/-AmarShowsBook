<script>

document.addEventListener("DOMContentLoaded", function () {
    const isSessionUserLoggedIn = @isLoggedIn.ToString().ToLowerInvariant();

    if (!isSessionUserLoggedIn) {
        return;
    }

    let inactivityTimer;
    let countdownTimer;
    let timeLeft = 30;
    let popupVisible = false;

    const INACTIVITY_TIME = 3 * 60 * 1000;

    // Previous wording used cinema-themed idle messages.
    const cinemaMessages = [
        "Your session is inactive.",
        "Please confirm you are still using the application.",
        "Your session will expire soon.",
        "Activity paused due to inactivity.",
        "Please continue to keep your session active.",
        "For your security, this session is about to end."
    ];

    function resetTimer() {
        clearTimeout(inactivityTimer);

        if (popupVisible) {
            hidePopup();
        }

        inactivityTimer = setTimeout(showSessionPopup, INACTIVITY_TIME);
    }

    function showSessionPopup() {
        popupVisible = true;

        let popup = document.getElementById("sessionPopup");
        let text = document.getElementById("cinemaText");

        if (!popup || !text) return;

        popup.style.display = "block";

        text.innerText = cinemaMessages[Math.floor(Math.random() * cinemaMessages.length)];

        timeLeft = 30;
        updateCountdown();

        clearInterval(countdownTimer);

        countdownTimer = setInterval(() => {
            timeLeft--;
            updateCountdown();

            if (timeLeft <= 0) {
                clearInterval(countdownTimer);
                autoLogout();
            }

        }, 1000);
    }

    function updateCountdown() {
        let el = document.getElementById("countdown");
        if (!el) return;

        el.innerText = "-" + timeLeft;

        el.style.transform = "scale(1.1)";
        setTimeout(() => {
            el.style.transform = "scale(1)";
        }, 150);
    }

    function hidePopup() {
        popupVisible = false;

        let popup = document.getElementById("sessionPopup");
        if (popup) popup.style.display = "none";

        clearInterval(countdownTimer);
    }

    window.stayActive = function () {
        hidePopup();
        resetTimer();
    };

    function autoLogout() {
        if (window.location.pathname.toLowerCase() === "/auth/logout") {
            return;
        }

        window.location.href = "/Auth/Logout";
    }

    ["click","mousemove","keypress","scroll","touchstart"].forEach(event => {
        document.addEventListener(event, resetTimer);
    });

    resetTimer();

});

</script>

<script>
(function () {
    const nativeAlert = window.alert.bind(window);

    function popupTypeFromMessage(message) {
        const text = String(message || "").toLowerCase();

        if (text.includes("success") || text.includes("verified") || text.includes("sent")) {
            return "success";
        }

        if (
            text.includes("error") ||
            text.includes("invalid") ||
            text.includes("required") ||
            text.includes("not") ||
            text.includes("fail") ||
            text.includes("already") ||
            text.includes("nothing")
        ) {
            return "error";
        }

        return "info";
    }

    window.showCinemaPopup = function (message, type, options) {
        const popup = document.getElementById("cinemaPopup");
        const title = document.getElementById("cinemaPopupTitle");
        const body = document.getElementById("cinemaPopupMessage");
        const ok = document.getElementById("cinemaPopupOk");
        const cancel = document.getElementById("cinemaPopupCancel");
        const support = document.getElementById("cinemaPopupSupport");
        const supportMenu = document.getElementById("cinemaPopupSupportMenu");

        if (!popup || !title || !body || !ok || !cancel || !support || !supportMenu) {
            nativeAlert(message);
            return;
        }

        const settings = options || {};
        const popupType = type || popupTypeFromMessage(message);

        popup.className = "cinema-popup-backdrop " + popupType;
        title.innerText = settings.title || (
            // Previous wording: "Housefull Applause"
            popupType === "success" ? "Success" :
            // Previous wording: "Scene Cut"
            popupType === "error" ? "Action Required" :
            // Previous wording: "Director's Call"
            popupType === "confirm" ? "Please Confirm" :
            // Previous wording: "Director's Note"
            "Notice"
        );
        body.innerText = message;
        ok.innerText = settings.okText || "Continue";
        cancel.innerText = settings.cancelText || "Cancel";
        cancel.classList.toggle("d-none", popupType !== "confirm");
        supportMenu.classList.toggle("d-none", popupType !== "error");
        supportMenu.classList.remove("support-open");
        popup.style.display = "block";

        ok.onclick = function () {
            popup.style.display = "none";
            if (typeof settings.onOk === "function") settings.onOk();
        };

        cancel.onclick = function () {
            popup.style.display = "none";
            if (typeof settings.onCancel === "function") settings.onCancel();
        };

        support.onclick = null;
    };

    window.showPopup = function (message, type) {
        window.showCinemaPopup(message, type);
    };

    window.alert = function (message) {
        window.showCinemaPopup(message);
    };

    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".alert-danger").forEach(function (alert) {
            if (alert.querySelector(".alert-support-menu")) return;

            const supportMenu = document.createElement("span");
            supportMenu.className = "alert-support-menu film-support-menu";

            const supportLabel = document.createElement("button");
            supportLabel.type = "button";
            supportLabel.className = "alert-support-link film-nav-btn film-support-trigger";
            supportLabel.title = "Help";
            supportLabel.setAttribute("aria-haspopup", "true");
            supportLabel.setAttribute("aria-expanded", "false");

            const supportIcon = document.createElement("span");
            supportIcon.className = "film-nav-icon";
            supportIcon.innerHTML = window.contactIconSvg("call");

            const supportText = document.createElement("span");
            supportText.className = "film-nav-label";
            supportText.textContent = "Help";

            supportLabel.appendChild(supportIcon);
            supportLabel.appendChild(supportText);

            const supportOptions = document.createElement("span");
            supportOptions.className = "alert-support-options film-support-dropdown";
            supportOptions.setAttribute("role", "menu");
            supportOptions.setAttribute("aria-label", "Help options");

            const callLink = document.createElement("a");
            callLink.href = "tel:+919651698863";
            callLink.innerHTML = window.contactIconSvg("call") + "Call Us";
            callLink.setAttribute("role", "menuitem");

            const emailLink = document.createElement("a");
            emailLink.href = "@globalSupportEmailUrl";
            emailLink.innerHTML = window.contactIconSvg("mail") + "Email Us";
            emailLink.setAttribute("role", "menuitem");

            const whatsappLink = document.createElement("a");
            whatsappLink.href = "@globalSupportWhatsAppUrl";
            whatsappLink.target = "_blank";
            whatsappLink.rel = "noopener";
            whatsappLink.innerHTML = window.contactIconSvg("whatsapp") + "WhatsApp Us";
            whatsappLink.setAttribute("role", "menuitem");

            supportOptions.appendChild(callLink);
            supportOptions.appendChild(emailLink);
            supportOptions.appendChild(whatsappLink);
            supportMenu.appendChild(supportLabel);
            supportMenu.appendChild(supportOptions);
            alert.appendChild(supportMenu);
        });

        document.addEventListener("click", function (event) {
            document.querySelectorAll(".cinema-popup-support-menu.support-open").forEach(function (menu) {
                if (menu.contains(event.target)) return;
                menu.classList.remove("support-open");
            });
        });
    });
})();
</script>

<script>
(function () {
    const finePointer = window.matchMedia("(pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (!finePointer.matches || reducedMotion.matches) {
        return;
    }

    const root = document.documentElement;
    const cursor = document.createElement("span");
    const trail = document.createElement("span");
    const cursorClasses = ["app-custom-cursor", "app-liquid-cursor", "app-precision-cursor", "app-spotlight-cursor"];
    let cursorX = window.innerWidth / 2;
    let cursorY = window.innerHeight / 2;
    let trailX = cursorX;
    let trailY = cursorY;
    let rafId = 0;
    let isReady = false;

    cursor.className = "liquid-cursor";
    trail.className = "liquid-cursor-trail";
    cursor.setAttribute("aria-hidden", "true");
    trail.setAttribute("aria-hidden", "true");

    function applyLiveCursorColor(color) {
        const cursorColor = color || getComputedStyle(root).getPropertyValue("--app-cursor-color").trim();
        cursor.style.setProperty("--app-cursor-color", cursorColor);
        trail.style.setProperty("--app-cursor-color", cursorColor);
    }

    function moveCursor(event) {
        cursorX = event.clientX;
        cursorY = event.clientY;
        root.classList.remove("cursor-hidden");
        setActionState(event);

        if (!rafId) {
            rafId = requestAnimationFrame(renderCursor);
        }
    }

    function renderCursor() {
        trailX += (cursorX - trailX) * 0.18;
        trailY += (cursorY - trailY) * 0.18;

        cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
        trail.style.transform = `translate3d(${trailX}px, ${trailY}px, 0) translate(-50%, -50%)`;
        rafId = requestAnimationFrame(renderCursor);
    }

    function applyCursorStyle(choice) {
        const cursorChoice = choice || localStorage.getItem("showTimeCursor") || "liquid";
        root.dataset.cursorChoice = cursorChoice;
        const savedColor = localStorage.getItem("showTimeCursorColor");
        if (savedColor) {
            root.style.setProperty("--app-cursor-color", savedColor);
        } else {
            root.style.removeProperty("--app-cursor-color");
        }
        applyLiveCursorColor(savedColor);
        root.classList.remove(...cursorClasses);

        if (cursorChoice !== "native") {
            root.classList.add("app-custom-cursor", "app-" + cursorChoice + "-cursor");
        }

        document.querySelectorAll("[data-cursor-choice]").forEach(button => {
            button.classList.toggle("active", button.dataset.cursorChoice === cursorChoice);
        });

        if (cursorChoice === "native") {
            cursor.style.display = "none";
            trail.style.display = "none";
            if (rafId) {
                cancelAnimationFrame(rafId);
                rafId = 0;
            }
            return;
        }

        cursor.style.display = "";
        trail.style.display = "";
        if (isReady && !rafId) {
            rafId = requestAnimationFrame(renderCursor);
        }
    }

    window.setAppCursorStyle = function (choice) {
        const cursorChoice = choice || "native";
        localStorage.setItem("showTimeCursor", cursorChoice);
        applyCursorStyle(cursorChoice);
    };

    window.setAppCursorColor = function (color) {
        const cursorColor = color || "";
        if (cursorColor) {
            localStorage.setItem("showTimeCursorColor", cursorColor);
        } else {
            localStorage.removeItem("showTimeCursorColor");
        }

        if (cursorColor) {
            root.style.setProperty("--app-cursor-color", cursorColor);
        } else {
            root.style.removeProperty("--app-cursor-color");
        }
        applyLiveCursorColor(cursorColor);
        document.querySelectorAll("[data-cursor-color]").forEach(button => {
            button.classList.toggle("active", button.dataset.cursorColor === cursorColor);
        });

        if (!localStorage.getItem("showTimeCursor") && cursorColor) {
            window.setAppCursorStyle("liquid");
        }
    };

	    function setActionState(event) {
	        const action = event.target.closest("a,button,input,select,textarea,label,[role='button'],.show-card,.theme-toggle-btn");
	        root.classList.toggle("cursor-action", Boolean(action));
	    }

	    function showProgressCursor(duration) {
	        root.classList.remove("cursor-hidden");
	        root.classList.add("app-page-busy");
	        window.clearTimeout(window.__showTimeProgressTimer);
	        if (duration) {
	            window.__showTimeProgressTimer = window.setTimeout(hideProgressCursor, duration);
	        }
	    }

	    function hideProgressCursor() {
	        root.classList.remove("app-page-busy");
	    }

	    function isSamePageHash(url) {
	        return url.origin === window.location.origin &&
	            url.pathname === window.location.pathname &&
	            url.search === window.location.search &&
	            Boolean(url.hash);
	    }

	    function shouldShowProgressForLink(link, event) {
	        if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
	            return false;
	        }

	        const href = link.getAttribute("href");
	        if (!href || href === "#" || href.startsWith("javascript:") || href.startsWith("mailto:") || href.startsWith("tel:")) {
	            return false;
	        }

	        if (link.target && link.target.toLowerCase() !== "_self") {
	            return false;
	        }

	        try {
	            return !isSamePageHash(new URL(href, window.location.href));
	        } catch {
	            return false;
	        }
	    }

	    window.showTimeProgressCursor = showProgressCursor;
	    window.hideShowTimeProgressCursor = hideProgressCursor;

	    document.addEventListener("DOMContentLoaded", function () {
	        document.body.appendChild(trail);
	        document.body.appendChild(cursor);
        root.classList.add("cursor-hidden");
        isReady = true;
        window.setAppCursorColor(localStorage.getItem("showTimeCursorColor") || "");
        applyCursorStyle(localStorage.getItem("showTimeCursor") || "liquid");
    });

	    document.addEventListener("mousemove", moveCursor, { passive: true });
	    document.addEventListener("mouseover", setActionState, true);
	    document.addEventListener("mouseout", setActionState, true);
	    document.addEventListener("click", function (event) {
	        const link = event.target.closest("a");
	        if (shouldShowProgressForLink(link, event)) {
	            showProgressCursor(1600);
	            return;
	        }

	        const submitButton = event.target.closest("button[type='submit'],input[type='submit']");
	        if (submitButton && !submitButton.disabled) {
	            const form = submitButton.form;
	            if (form && typeof form.checkValidity === "function" && !form.checkValidity()) {
	                return;
	            }
	            showProgressCursor(2200);
	        }
	    }, true);
	    document.addEventListener("submit", function (event) {
	        if (!event.defaultPrevented) {
	            showProgressCursor(2400);
	        }
	    }, true);
	    window.addEventListener("beforeunload", function () {
	        showProgressCursor();
	    });
	    window.addEventListener("pageshow", hideProgressCursor);
	    document.addEventListener("mouseleave", function () {
	        root.classList.add("cursor-hidden");
	    });
})();
</script>

<script>
(function () {
    const isLoggedIn = @isLoggedIn.ToString().ToLowerInvariant();

    if (!isLoggedIn || !navigator.sendBeacon) {
        return;
    }

    // Keep browser-side activity small; server-side actions already save the detailed request.
    function textOf(element) {
        return (element.innerText || element.value || element.getAttribute("aria-label") || element.title || "")
            .replace(/\s+/g, " ")
            .trim()
            .slice(0, 250);
    }

    // This captures button/link intent that would otherwise be invisible when JavaScript handles the work.
    function sendClickLog(element) {
        const payload = {
            eventType: "click",
            elementType: element.tagName,
            text: textOf(element),
            href: element.href || element.getAttribute("href"),
            path: window.location.pathname,
            id: element.id || "",
            name: element.name || "",
            cssClass: element.className || ""
        };

        const body = new Blob([JSON.stringify(payload)], {
            type: "application/json"
        });

        navigator.sendBeacon("/Activity/ClientEvent", body);
    }

    document.addEventListener("click", function (event) {
        const target = event.target.closest("a,button,input[type='button'],input[type='submit'],input[type='checkbox'],input[type='radio'],select,[data-log-click]");

        if (!target) {
            return;
        }

        sendClickLog(target);
    }, true);
})();
</script>

