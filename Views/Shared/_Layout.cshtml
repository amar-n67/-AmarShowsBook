	        "logout" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M10 5H6.5A2.5 2.5 0 0 0 4 7.5v9A2.5 2.5 0 0 0 6.5 19H10\"/><path d=\"M13 12h7\"/><path d=\"m17 8 4 4-4 4\"/></svg>",
	        "menu" => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h16\"/><path d=\"M4 12h16\"/><path d=\"M4 17h16\"/></svg>",
	        _ => "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M12 8v8\"/><path d=\"M8 12h8\"/></svg>"
	    };

	    try
    {
        currentVersion =
            AppDb.ApplicationVersions
            .OrderByDescending(x => x.IsCurrent)
            .ThenByDescending(x => x.UpdatedAt)
            .Select(x => x.VersionNumber)
            .FirstOrDefault()
            ?? currentVersion;
    }
    catch
    {
        currentVersion = "1.0.0";
    }
}

