@@media (pointer: fine) {
    html.app-custom-cursor,
    html.app-custom-cursor body,
    html.app-custom-cursor a,
    html.app-custom-cursor button,
    html.app-custom-cursor input,
    html.app-custom-cursor select,
    html.app-custom-cursor textarea,
    html.app-custom-cursor [role="button"] {
        cursor: none !important;
    }

    .liquid-cursor,
    .liquid-cursor-trail {
        position: fixed;
        left: 0;
        top: 0;
        pointer-events: none;
        z-index: 2147483647;
        border-radius: 999px;
        transform: translate3d(-50%, -50%, 0);
        will-change: transform, width, height, opacity;
    }

    .liquid-cursor {
        width: 10px;
        height: 10px;
        border: 1px solid rgba(255, 255, 255, 0.78);
        background:
            radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.95), transparent 36%),
            color-mix(in srgb, var(--app-cursor-color, var(--app-accent-strong)) 72%, var(--app-primary));
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--app-text) 10%, transparent),
            0 0 18px color-mix(in srgb, var(--app-cursor-color, var(--app-accent-strong)) 42%, transparent);
        backdrop-filter: blur(4px) saturate(130%);
        mix-blend-mode: normal;
        transition: width 0.14s ease, height 0.14s ease, opacity 0.18s ease, background 0.14s ease;
    }

    .liquid-cursor::before,
    .liquid-cursor::after,
    .liquid-cursor-trail::before,
    .liquid-cursor-trail::after {
        content: "";
        position: absolute;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.14s ease;
    }

    .liquid-cursor-trail {
        width: 34px;
        height: 34px;
        border: 1px solid color-mix(in srgb, var(--app-cursor-color, var(--app-accent-strong)) 46%, transparent);
        background: color-mix(in srgb, var(--app-accent) 10%, transparent);
        box-shadow: 0 0 24px color-mix(in srgb, var(--app-cursor-color, var(--app-accent-strong)) 22%, transparent);
        backdrop-filter: blur(2px);
        opacity: 0.76;
        transition: width 0.16s ease, height 0.16s ease, opacity 0.2s ease, border-color 0.16s ease;
    }

    html.app-liquid-cursor.cursor-action .liquid-cursor {
        width: 8px;
        height: 8px;
        background:
            radial-gradient(circle at 35% 28%, rgba(255, 255, 255, 0.95), transparent 36%),
            var(--app-accent);
    }

    html.app-liquid-cursor.cursor-action .liquid-cursor-trail {
        width: 44px;
        height: 44px;
        border-color: color-mix(in srgb, var(--app-accent) 62%, transparent);
        opacity: 0.84;
    }

    html.app-liquid-cursor .liquid-cursor {
        width: 14px;
        height: 14px;
        border-radius: 60% 42% 58% 46%;
        animation: cursorLiquidPulse 1.7s ease-in-out infinite;
    }

    html.app-liquid-cursor .liquid-cursor-trail {
        width: 38px;
        height: 38px;
        border-style: solid;
        border-radius: 42% 58% 46% 62%;
        background: radial-gradient(circle, color-mix(in srgb, var(--app-cursor-color, var(--app-accent-strong)) 16%, transparent), transparent 68%);
    }

    html.app-liquid-cursor.cursor-hidden .liquid-cursor,
    html.app-liquid-cursor.cursor-hidden .liquid-cursor-trail {
        opacity: 0;
    }

    html.app-precision-cursor .liquid-cursor {
        width: 22px;
        height: 22px;
        border-radius: 2px;
        border: 0;
        background:
            linear-gradient(var(--app-cursor-color, var(--app-danger)), var(--app-cursor-color, var(--app-danger))) center / 2px 22px no-repeat,
            linear-gradient(90deg, var(--app-cursor-color, var(--app-danger)), var(--app-cursor-color, var(--app-danger))) center / 22px 2px no-repeat;
        box-shadow: none;
        backdrop-filter: none;
    }

    html.app-precision-cursor .liquid-cursor-trail {
        width: 34px;
        height: 34px;
        border: 2px dashed var(--app-cursor-color, var(--app-danger));
        border-radius: 50%;
        background: transparent;
        box-shadow: inset 0 0 0 5px color-mix(in srgb, var(--app-cursor-color, var(--app-danger)) 8%, transparent);
        opacity: 0.88;
        backdrop-filter: none;
    }

    html.app-precision-cursor .liquid-cursor::before,
    html.app-precision-cursor .liquid-cursor::after {
        opacity: 1;
        background: var(--app-cursor-color, var(--app-danger));
        border-radius: 999px;
    }

    html.app-precision-cursor .liquid-cursor::before {
        left: 50%;
        top: -9px;
        bottom: -9px;
        width: 2px;
        transform: translateX(-50%);
    }

    html.app-precision-cursor .liquid-cursor::after {
        top: 50%;
        left: -9px;
        right: -9px;
        height: 2px;
        transform: translateY(-50%);
    }

    html.app-precision-cursor.cursor-action .liquid-cursor-trail {
        width: 42px;
        height: 42px;
        border-style: solid;
    }

    html.app-spotlight-cursor .liquid-cursor {
        width: 5px;
        height: 5px;
        border: 0;
        background: var(--app-cursor-color, var(--app-accent));
        box-shadow: 0 0 12px color-mix(in srgb, var(--app-cursor-color, var(--app-accent)) 52%, transparent);
        backdrop-filter: none;
    }

    html.app-spotlight-cursor .liquid-cursor-trail {
        width: 84px;
        height: 84px;
        border: 2px solid color-mix(in srgb, var(--app-cursor-color, var(--app-accent)) 58%, transparent);
        background:
            radial-gradient(circle, transparent 0 30%, color-mix(in srgb, var(--app-cursor-color, var(--app-accent)) 14%, transparent) 32% 100%);
        box-shadow:
            0 0 0 9999px color-mix(in srgb, var(--app-bg) 4%, transparent),
            inset 0 0 22px color-mix(in srgb, var(--app-cursor-color, var(--app-accent)) 28%, transparent),
            0 0 34px color-mix(in srgb, var(--app-cursor-color, var(--app-accent)) 22%, transparent);
        opacity: 0.72;
        backdrop-filter: blur(1px);
    }

    html.app-spotlight-cursor.cursor-action .liquid-cursor-trail {
        width: 104px;
        height: 104px;
        opacity: 0.82;
    }

	    @@keyframes cursorLiquidPulse {
	        0%, 100% {
	            border-radius: 60% 42% 58% 46%;
	        }
	        50% {
	            border-radius: 42% 62% 44% 58%;
	        }
	    }

	    html.app-page-busy,
	    html.app-page-busy body,
	    html.app-page-busy a,
	    html.app-page-busy button,
	    html.app-page-busy input,
	    html.app-page-busy select,
	    html.app-page-busy textarea,
	    html.app-page-busy [role="button"] {
	        cursor: url("/images/brand/showtime-progress-cursor.png") 16 16, progress !important;
	    }

	    html.app-page-busy .liquid-cursor {
	        width: 34px;
	        height: 34px;
	        border: 0;
	        border-radius: 8px;
	        background: rgba(255, 255, 255, 0.86);
	        box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.72), 0 10px 26px rgba(15, 23, 42, 0.22);
	        animation: showTimeProgressPulse 0.72s ease-in-out infinite alternate;
	    }

	    html.app-page-busy .liquid-cursor::before {
	        inset: 3px;
	        border-radius: 6px;
	        opacity: 1;
	        background: url("/images/brand/showtime-progress-cursor.png") center / contain no-repeat;
	        animation: showTimeLogoPulse 0.72s ease-in-out infinite alternate;
	    }

	    html.app-page-busy .liquid-cursor::after {
	        inset: 0;
	        border-radius: 8px;
	        opacity: 0.75;
	        background: linear-gradient(115deg, transparent 0 32%, rgba(255, 255, 255, 0.84) 45%, transparent 58% 100%);
	        mix-blend-mode: screen;
	        animation: showTimeProgressSweep 1s ease-in-out infinite;
	    }

	    html.app-page-busy .liquid-cursor-trail {
	        width: 54px;
	        height: 54px;
	        border: 0;
	        border-radius: 999px;
	        background: transparent;
	        opacity: 0.9;
	    }

	    html.app-page-busy .liquid-cursor-trail::before {
	        inset: 0;
	        border-radius: 999px;
	        opacity: 1;
	        background: conic-gradient(
	            from 0deg,
	            transparent 0 18%,
	            color-mix(in srgb, var(--app-cursor-color, var(--app-accent-strong)) 88%, white) 22% 42%,
	            transparent 48% 100%
	        );
	        -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
	        mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
	        animation: showTimeProgressSpin 0.72s linear infinite;
	    }

	    @@keyframes showTimeProgressSpin {
	        to {
	            transform: rotate(360deg);
	        }
	    }

	    @@keyframes showTimeProgressPulse {
	        from {
	            box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.68), 0 10px 24px rgba(15, 23, 42, 0.2);
	        }
	        to {
	            box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.42), 0 12px 34px color-mix(in srgb, var(--app-cursor-color, var(--app-accent-strong)) 42%, transparent);
	        }
	    }

	    @@keyframes showTimeLogoPulse {
	        from {
	            transform: scale(0.9);
	        }
	        to {
	            transform: scale(1.08);
	        }
	    }

	    @@keyframes showTimeProgressSweep {
	        0% {
	            transform: translateX(-120%) rotate(12deg);
	        }
	        100% {
	            transform: translateX(120%) rotate(12deg);
	        }
	    }
	}

html,
body {
    max-width: 100%;
    overflow-x: hidden;
}

.card {
    background: var(--app-card) !important;
    border-radius: 8px;
    color: var(--app-card-text) !important;
    border-color: var(--app-input-border) !important;
}

.card h1,
.card h2,
.card h3,
.card h4,
.card h5,
.card h6,
.card p,
.card label,
.card small {
    color: inherit;
}

.form-control,
.form-select,
input,
select,
textarea {
    background-color: var(--app-input) !important;
    color: var(--app-input-text) !important;
    border-color: var(--app-input-border) !important;
}

select option {
    background: var(--app-input);
    color: var(--app-input-text);
}

.form-control::placeholder,
input::placeholder,
textarea::placeholder {
    color: color-mix(in srgb, var(--app-input-text) 58%, transparent);
}

.btn[data-password-toggle] {
    position: relative;
    isolation: isolate;
    min-width: 50px;
    min-height: 42px;
    display: inline-grid;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    overflow: hidden;
    border-color: var(--app-input-border) !important;
    color: var(--app-accent-strong) !important;
    background:
        radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--app-accent) 28%, transparent), transparent 62%),
        linear-gradient(135deg, color-mix(in srgb, var(--app-input) 84%, #ffffff 16%), color-mix(in srgb, var(--app-card) 74%, var(--app-input) 26%)) !important;
    box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 74%, transparent), 0 10px 22px color-mix(in srgb, var(--app-accent-strong) 14%, transparent);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
}

.btn[data-password-toggle]::before {
    content: "";
    position: absolute;
    inset: -40%;
    z-index: -1;
    background: conic-gradient(from 90deg, transparent, color-mix(in srgb, var(--app-accent) 38%, transparent), transparent, color-mix(in srgb, var(--app-accent-strong) 34%, transparent), transparent);
    opacity: 0;
    transform: rotate(0deg);
    transition: opacity 0.18s ease;
}

.btn[data-password-toggle]:hover,
.btn[data-password-toggle]:focus-visible {
    color: var(--app-primary) !important;
    border-color: var(--app-accent-strong) !important;
    box-shadow: inset 0 1px 0 color-mix(in srgb, #ffffff 80%, transparent), 0 14px 28px color-mix(in srgb, var(--app-accent-strong) 22%, transparent);
    transform: translateY(-1px);
}

.btn[data-password-toggle]:hover::before,
.btn[data-password-toggle]:focus-visible::before,
.btn[data-password-toggle].is-password-visible::before {
    opacity: 0.58;
    animation: passwordCatHalo 2.8s linear infinite;
}

.btn[data-password-toggle].is-password-visible {
    color: var(--app-primary) !important;
}

.btn[data-password-toggle].is-password-animating .password-cat {
    animation: passwordCatPounce 0.46s cubic-bezier(0.16, 1, 0.3, 1);
}

.input-group > .btn[data-password-toggle],
.password-reveal-group > .btn[data-password-toggle] {
    border-left: 0 !important;
    border-radius: 0 12px 12px 0 !important;
}

.password-reveal-group {
    display: flex;
    align-items: stretch;
    width: 100%;
}

.password-reveal-group > input[data-password-managed] {
    flex: 1 1 auto;
    min-width: 0;
    width: auto !important;
    border-top-right-radius: 0 !important;
    border-bottom-right-radius: 0 !important;
}

.password-cat {
    position: relative;
    width: 30px;
    height: 24px;
    display: inline-block;
    color: currentColor;
    filter: drop-shadow(0 5px 8px color-mix(in srgb, var(--app-accent-strong) 22%, transparent));
    transform-origin: 50% 75%;
}

.password-cat::before {
    left: 3px;
    transform: rotate(-22deg);
}

.password-cat::after {
    right: 3px;
    transform: rotate(22deg);
}

.password-cat::before,
.password-cat::after,
.password-cat-ear {
    content: "";
    position: absolute;
    top: 0;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 9px solid currentColor;
    transition: transform 0.22s ease;
}

.password-cat-face {
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: 0;
    height: 19px;
    border: 2px solid currentColor;
    border-radius: 52% 52% 46% 46%;
    background: linear-gradient(180deg, color-mix(in srgb, var(--app-input) 82%, transparent), color-mix(in srgb, var(--app-card) 76%, transparent));
    box-shadow: inset 0 -4px 8px color-mix(in srgb, var(--app-accent-strong) 10%, transparent);
    transition: transform 0.24s ease, box-shadow 0.24s ease;
}

.password-cat-eye {
    position: absolute;
    top: 6px;
    display: grid;
    place-items: center;
    width: 7px;
    height: 10px;
    overflow: hidden;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: color-mix(in srgb, var(--app-accent) 18%, transparent);
    transition: top 0.22s ease, width 0.22s ease, height 0.22s ease, border-color 0.22s ease, border-radius 0.22s ease, background 0.22s ease, transform 0.22s ease;
}

.password-cat-eye:first-child {
    left: 6px;
}

.password-cat-eye:last-child {
    right: 6px;
}

.password-cat-pupil {
    width: 2px;
    height: 8px;
    border-radius: 999px;
    background: currentColor;
    transition: opacity 0.18s ease, transform 0.22s ease;
}

.password-cat-glint {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #ffffff;
    transition: opacity 0.18s ease, transform 0.22s ease;
}

.password-cat-nose {
    position: absolute;
    left: 50%;
    bottom: 4px;
    width: 4px;
    height: 3px;
    border-radius: 999px 999px 45% 45%;
    background: currentColor;
    transform: translateX(-50%);
    opacity: 0.72;
}

.password-cat-whisker {
    position: absolute;
    top: 12px;
    width: 8px;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.62;
    transition: transform 0.22s ease, opacity 0.22s ease;
}

.password-cat-whisker.left {
    left: -5px;
    transform: rotate(8deg);
}

.password-cat-whisker.right {
    right: -5px;
    transform: rotate(-8deg);
}

.password-cat.closed .password-cat-eye {
    top: 10px;
    width: 8px;
    height: 2px;
    border-color: transparent;
    border-radius: 999px;
    background: currentColor;
    transform: scaleX(1.26);
}

.password-cat.closed .password-cat-pupil,
.password-cat.closed .password-cat-glint {
    opacity: 0;
    transform: scaleY(0);
}

.password-cat.open .password-cat-eye {
    animation: passwordCatBlink 4.6s ease-in-out infinite;
}

.password-cat.open .password-cat-face {
    box-shadow: inset 0 -4px 8px color-mix(in srgb, var(--app-accent-strong) 12%, transparent), 0 0 16px color-mix(in srgb, var(--app-accent) 24%, transparent);
}

.password-cat.open .password-cat-whisker.left {
    transform: translateX(-1px) rotate(14deg);
}

.password-cat.open .password-cat-whisker.right {
    transform: translateX(1px) rotate(-14deg);
}

@@keyframes passwordCatBlink {
    0%, 84%, 100% {
        transform: scaleY(1);
    }
    88%, 91% {
        transform: scaleY(0.22);
    }
}

@@keyframes passwordCatPounce {
    0% {
        transform: translateY(0) scale(1);
    }
    36% {
        transform: translateY(-3px) scale(1.08);
    }
    72% {
        transform: translateY(1px) scale(0.96);
    }
    100% {
        transform: translateY(0) scale(1);
    }
}

@@keyframes passwordCatHalo {
    to {
        transform: rotate(360deg);
    }
}

@@media (prefers-reduced-motion: reduce) {
    .btn[data-password-toggle],
