html[data-theme="dark"] {
    color-scheme: dark;
    --app-bg: #101722;
    --app-text: #f8fafc;
    --app-card: #182233;
    --app-card-text: #ffffff;
    --app-input: #20293a;
    --app-input-text: #ffffff;
    --app-input-border: #526174;
    --app-input-disabled: #1a2231;
    --app-input-disabled-text: #d1d5db;
