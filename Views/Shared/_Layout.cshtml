    color: var(--app-muted) !important;
}

.form-control,
.form-select,
.input-group-text,
input,
select,
textarea {
    background-color: var(--app-input) !important;
    color: var(--app-input-text) !important;
    border-color: var(--app-input-border) !important;
}

.form-control:focus,
.form-select:focus,
input:focus,
select:focus,
textarea:focus {
    background-color: var(--app-input) !important;
    color: var(--app-input-text) !important;
    border-color: var(--app-accent-strong) !important;
    box-shadow: 0 0 0 0.18rem color-mix(in srgb, var(--app-accent-strong) 24%, transparent) !important;
}

.form-control::placeholder,
input::placeholder,
textarea::placeholder {
    color: var(--app-muted) !important;
    opacity: 1;
}

.form-control:disabled,
.form-control[readonly],
input:disabled,
input[readonly],
select:disabled,
textarea:disabled,
textarea[readonly] {
