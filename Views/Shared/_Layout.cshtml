<!DOCTYPE html>
<html lang="en">
<head>
    <style>
body {
    background: #0f172a;
    color: #e5e7eb;
    font-family: 'Segoe UI', sans-serif;
}

.card {
    background: #1e293b;
    border-radius: 16px;
    color: #f1f5f9;
}

.form-control {
    background: #334155;
    color: #fff;
    border: none;
}

.form-control::placeholder {
    color: #cbd5f5;
}

.btn-primary {
    background: #6366f1;
    border: none;
}

.btn-primary:hover {
    background: #4f46e5;
}

a {
    color: #93c5fd;
}
@@keyframes popupFade {
    from {
        opacity: 0;
        transform: translate(-50%, -58%) scale(0.92);
    }

    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
}

.cinema-popup-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background:
        linear-gradient(135deg, rgba(18, 24, 38, 0.78), rgba(122, 24, 46, 0.72)),
        rgba(0, 0, 0, 0.54);
    backdrop-filter: blur(7px);
    z-index: 10000;
}

.cinema-popup-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(420px, calc(100vw - 32px));
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 18px;
    background: #fffdf8;
    color: #231f20;
    box-shadow: 0 28px 80px rgba(0,0,0,0.46);
    animation: popupFade 0.25s ease forwards;
}

.cinema-popup-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    background: linear-gradient(135deg, #231f20, #8f1d3f, #0f766e);
    color: #f7d774;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.cinema-popup-body {
    padding: 24px;
    text-align: center;
}

.cinema-popup-title {
    margin: 0 0 8px;
    color: #231f20;
    font-weight: 850;
}

.cinema-popup-message {
    margin: 0;
    color: #4b5563;
    line-height: 1.5;
}

.cinema-popup-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 0 24px 24px;
}

.cinema-popup-btn {
    min-width: 110px;
    border: 0;
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: 800;
}

.cinema-popup-ok {
    background: #0f766e;
    color: #fff;
}

.cinema-popup-cancel {
    background: #e5e7eb;
    color: #374151;
}

.cinema-popup-backdrop.error .cinema-popup-strip {
    background: linear-gradient(135deg, #231f20, #991b1b, #b45309);
}

.cinema-popup-backdrop.success .cinema-popup-strip {
    background: linear-gradient(135deg, #14532d, #0f766e);
}

</style>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - AmarShowsBook</title>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" />

</head>

<body>
    <div id="cinemaPopup" class="cinema-popup-backdrop" role="dialog" aria-modal="true" aria-labelledby="cinemaPopupTitle">
        <div class="cinema-popup-card">
            <div class="cinema-popup-strip">
                <span id="cinemaPopupReel">AmarShowsBook</span>
                <span>Final Take</span>
            </div>
            <div class="cinema-popup-body">
                <h5 id="cinemaPopupTitle" class="cinema-popup-title">Director's Note</h5>
                <p id="cinemaPopupMessage" class="cinema-popup-message"></p>
            </div>
            <div class="cinema-popup-actions">
                <button type="button" id="cinemaPopupCancel" class="cinema-popup-btn cinema-popup-cancel d-none">Retake</button>
                <button type="button" id="cinemaPopupOk" class="cinema-popup-btn cinema-popup-ok">Continue</button>
            </div>
        </div>
</div>
<!-- ================= SESSION POPUP ================= -->
<div id="sessionPopup" style="
display:none;
position:fixed;
top:0; left:0;
width:100%; height:100%;
background:rgba(0,0,0,0.75);
backdrop-filter: blur(6px);
z-index:9999;">

    <div style="
        position:absolute;
        top:50%; left:50%;
        transform:translate(-50%, -50%) scale(0.9);
        background:#1e293b;
        padding:30px;
        border-radius:14px;
        text-align:center;
        color:white;
        width:320px;
        box-shadow:0 0 30px rgba(0,0,0,0.8);
        animation: popupFade 0.35s ease forwards;
    ">

        <h4 style="color:#facc15;">🎬 Still Watching?</h4>

        <p id="cinemaText" style="color:#cbd5f5;">
            Your show is paused... audience missing 🍿
        </p>

        <h2 id="countdown"
            style="color:#f87171;
                   font-size:42px;
                   margin:10px 0;
                   text-shadow:0 0 10px #f87171;">
            -30
        </h2>

        <button onclick="stayActive()"
                class="btn btn-success mt-2">
            ▶ Continue Watching
        </button>

    </div>
</div>

<!-- ================= NAVBAR ================= -->
<header>
<nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
<div class="container-fluid">

    <a class="navbar-brand" asp-controller="Home" asp-action="Index">AmarShowsBook</a>

    <div class="d-flex align-items-center ms-auto">

        @if (Context.Session.GetString("UserEmail") != null)
        {
            <!-- USER INFO -->
            <div class="text-end me-3">
                <div id="liveDateTime" style="font-size:12px;"></div>
                <div style="font-weight:bold;">
                    @Context.Session.GetString("UserEmail")
                </div>
            </div>

            <!-- PROFILE IMAGE -->
            <img src="@(!string.IsNullOrEmpty(Context.Session.GetString("ProfileImage")) 
    ? Context.Session.GetString("ProfileImage") 
    : "/uploads/default.png")"
     style="width:40px;height:40px;border-radius:50%;" />
     
            <!-- PROFILE BUTTON -->
            <a class="btn btn-warning me-2" href="/Profile/Index">Profile</a>

            <!-- LOGOUT -->
            <a class="btn btn-danger"
               href="/Auth/Logout"
               onclick="return confirmLogout()">Logout</a>
        }

    </div>

</div>
</nav>
</header>

<!-- ================= BODY ================= -->
<div class="container mt-5">
    @RenderBody()
</div>

<!-- ================= FOOTER ================= -->
<footer class="border-top footer text-muted">
<div class="container">
    &copy; 2026 - AmarShowsBook
</div>
</footer>

<!-- ================= SCRIPTS ================= -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
function togglePassword(fieldId) {
    var input = document.getElementById(fieldId);
    input.type = input.type === "password" ? "text" : "password";
}
</script>

<!-- ✅ DATE + TIME -->
<script>
function updateDateTime() {
    let now = new Date();

    let date = now.toLocaleDateString('en-IN', {
        weekday: 'long',
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });

    let time = now.toLocaleTimeString();

    document.getElementById("liveDateTime").innerHTML =
        date + " | " + time;
}
setInterval(updateDateTime, 1000);
updateDateTime();
</script>

<!-- LOGOUT CONFIRM -->
<script>
function confirmLogout() {
    showCinemaPopup("Interval or exit? Your show will close and you will be logged out.", "confirm", {
        title: "Exit The Show?",
        okText: "Exit Show",
        cancelText: "Stay Seated",
        onOk: function () {
            window.location.href = "/Auth/Logout";
        }
    });

    return false;
}
</script>

<script>

document.addEventListener("DOMContentLoaded", function () {

    let inactivityTimer;
    let countdownTimer;
    let timeLeft = 30;
    let popupVisible = false;

    const INACTIVITY_TIME = 3 * 60 * 1000; // ✅ 3 minutes (change if needed)

    const cinemaMessages = [
        "🍿 Audience gone missing...",
        "🎥 Projector waiting for you...",
        "🎬 Interval chal raha hai...",
        "📽 Scene ruk gaya hai boss...",
        "🎞 Reel freeze ho gaya...",
        "🛑 Show paused... hero kidhar hai?"
    ];

    function resetTimer() {
        clearTimeout(inactivityTimer);

        if (popupVisible) {
            hidePopup();
        }

        inactivityTimer = setTimeout(showSessionPopup, INACTIVITY_TIME);
    }

    function showSessionPopup() {
        popupVisible = true;

        let popup = document.getElementById("sessionPopup");
        let text = document.getElementById("cinemaText");

        if (!popup || !text) return; // ✅ safety

        popup.style.display = "block";

        // random message
        text.innerText = cinemaMessages[Math.floor(Math.random() * cinemaMessages.length)];

        timeLeft = 30;
        updateCountdown();

        clearInterval(countdownTimer);

        countdownTimer = setInterval(() => {
            timeLeft--;
            updateCountdown();

            if (timeLeft <= 0) {
                clearInterval(countdownTimer);
                autoLogout();
            }

        }, 1000);
    }

    function updateCountdown() {
        let el = document.getElementById("countdown");
        if (!el) return;

        el.innerText = "-" + timeLeft;

        // subtle animation
        el.style.transform = "scale(1.1)";
        setTimeout(() => {
            el.style.transform = "scale(1)";
        }, 150);
    }

    function hidePopup() {
        popupVisible = false;

        let popup = document.getElementById("sessionPopup");
        if (popup) popup.style.display = "none";

        clearInterval(countdownTimer);
    }

    window.stayActive = function () {
        hidePopup();
        resetTimer();
    };

    function autoLogout() {
        window.location.href = "/Auth/Logout";
    }

    // USER ACTIVITY TRACK
    ["click","mousemove","keypress","scroll","touchstart"].forEach(event => {
        document.addEventListener(event, resetTimer);
    });

    // START
    resetTimer();

});

</script>

<script>
(function () {
    const nativeAlert = window.alert.bind(window);

    function popupTypeFromMessage(message) {
        const text = String(message || "").toLowerCase();

        if (text.includes("success") || text.includes("verified") || text.includes("sent")) {
            return "success";
        }

        if (
            text.includes("error") ||
            text.includes("invalid") ||
            text.includes("required") ||
            text.includes("not") ||
            text.includes("fail") ||
            text.includes("already") ||
            text.includes("nothing")
        ) {
            return "error";
        }

        return "info";
    }

    window.showCinemaPopup = function (message, type, options) {
        const popup = document.getElementById("cinemaPopup");
        const title = document.getElementById("cinemaPopupTitle");
        const body = document.getElementById("cinemaPopupMessage");
        const ok = document.getElementById("cinemaPopupOk");
        const cancel = document.getElementById("cinemaPopupCancel");

        if (!popup || !title || !body || !ok || !cancel) {
            nativeAlert(message);
            return;
        }

        const settings = options || {};
        const popupType = type || popupTypeFromMessage(message);

        popup.className = "cinema-popup-backdrop " + popupType;
        title.innerText = settings.title || (
            popupType === "success" ? "Housefull Applause" :
            popupType === "error" ? "Scene Cut" :
            popupType === "confirm" ? "Director's Call" :
            "Director's Note"
        );
        body.innerText = message;
        ok.innerText = settings.okText || "Continue";
        cancel.innerText = settings.cancelText || "Cancel";
        cancel.classList.toggle("d-none", popupType !== "confirm");
        popup.style.display = "block";

        ok.onclick = function () {
            popup.style.display = "none";
            if (typeof settings.onOk === "function") settings.onOk();
        };

        cancel.onclick = function () {
            popup.style.display = "none";
            if (typeof settings.onCancel === "function") settings.onCancel();
        };
    };

    window.showPopup = function (message, type) {
        window.showCinemaPopup(message, type);
    };

    window.alert = function (message) {
        window.showCinemaPopup(message);
    };
})();
</script>

@RenderSection("Scripts", required: false)

<script>
function showPopup(message) {
    window.showCinemaPopup(message);
}
</script>
</body>
</html>
