    --app-popup-surface: #f9fbff;
    --app-popup-text: #1f2937;
    --app-popup-muted: #64748b;
    --app-popup-backdrop: linear-gradient(135deg, rgba(35, 49, 66, 0.62), rgba(163, 124, 64, 0.42)), rgba(248, 250, 252, 0.58);
    --app-profile-bg: linear-gradient(135deg, #dfe7f1, #f8fafc, #fff7e6);
}

html[data-theme="white"] {
    --app-bg: #f7f7fb;
    --app-text: #1f2937;
    --app-card: #ffffff;
    --app-card-text: #1f2937;
    --app-input: #ffffff;
    --app-input-text: #111827;
    --app-input-border: #d1d5db;
    --app-input-disabled: #eef2f7;
    --app-input-disabled-text: #6b7280;
    --app-muted: #6b7280;
    --app-link: #3858d6;
    --app-primary: #3858d6;
    --app-primary-hover: #2843b2;
    --app-nav: linear-gradient(135deg, #ffffff, #edf4f7 55%, #eaf0ff);
    --app-nav-text: #111827;
    --app-accent: #2563eb;
    --app-accent-strong: #0f766e;
    --app-danger: #dc2626;
    --app-page-surface: #ffffff;
    --app-page-text: #111827;
    --app-popup-surface: #ffffff;
