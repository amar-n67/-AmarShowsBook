<script>
(function () {
    if (localStorage.getItem("amarShowsThemeVersion") !== "3") {
        localStorage.setItem("amarShowsTheme", "cinema");
        localStorage.setItem("amarShowsThemeVersion", "3");
    }

    const storedTheme = localStorage.getItem("amarShowsTheme") || "cinema";
    const storedCursor = localStorage.getItem("amarShowsCursor") || "liquid";
    document.documentElement.dataset.theme = storedTheme;
    document.documentElement.dataset.themeChoice = storedTheme;
    document.documentElement.dataset.cursorChoice = storedCursor;
    const storedCursorColor = localStorage.getItem("amarShowsCursorColor");
    if (storedCursorColor) {
        document.documentElement.style.setProperty("--app-cursor-color", storedCursorColor);
    }
})();
</script>

