<script>
function getPasswordCatMarkup(isOpen) {
    return '<span class="password-cat ' + (isOpen ? 'open' : 'closed') + '" aria-hidden="true">' +
        '<span class="password-cat-face">' +
        '<span class="password-cat-eye"></span>' +
        '<span class="password-cat-eye"></span>' +
        '</span>' +
        '</span>';
}

function setPasswordToggleState(button, isOpen) {
    if (!button) return;

    button.innerHTML = getPasswordCatMarkup(isOpen);
    button.setAttribute("aria-label", isOpen ? "Hide password" : "Show password");
    button.title = isOpen ? "Hide password" : "Show password";
}

document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("[data-password-toggle]").forEach(function (button) {
        var fieldId = button.getAttribute("data-password-toggle");
        var input = document.getElementById(fieldId);
        setPasswordToggleState(button, input && input.type === "text");
    });
});

function togglePassword(fieldId, button) {
    var input = document.getElementById(fieldId);
    if (!input) return;

    var shouldShow = input.type === "password";
    input.type = shouldShow ? "text" : "password";

    var toggleButton = button || document.querySelector('[data-password-toggle="' + fieldId + '"]');
    setPasswordToggleState(toggleButton, shouldShow);
}
</script>

<script>
function appBack() {
    if (window.history.length > 1) {
        window.history.back();
        return;
    }

    window.location.href = "/Home/ShowTime";
}

function toggleFilmMenu(button) {
    const menu = document.getElementById("filmMenu");
    if (!menu) return;

    menu.classList.remove("hover-open");
    const isOpen = menu.classList.toggle("open");
    menu.dataset.pinnedOpen = String(isOpen);
    button?.setAttribute("aria-expanded", String(isOpen));
}

function clearAppSearch() {
    const input = document.getElementById("appPageSearch");
    if (!input) return;

    input.value = "";
    filterCurrentPage("");
    input.focus();
}

function filterCurrentPage(term) {
    const query = String(term || "").trim().toLowerCase();
    const rows = document.querySelectorAll("tbody tr");
    const cards = document.querySelectorAll(".show-card, .booking-card, .transaction-stat, .stat-card, .wallet-card, .admin-detail-panel, [data-admin-searchable]");

    rows.forEach(row => {
        row.classList.toggle("app-search-hidden", query.length > 0 && !row.innerText.toLowerCase().includes(query));
    });

    cards.forEach(card => {
        card.classList.toggle("app-search-hidden", query.length > 0 && !card.innerText.toLowerCase().includes(query));
    });
}

document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("appPageSearch");
    const filmMenu = document.getElementById("filmMenu");
    const filmMenuButton = document.querySelector("[data-film-menu-button]");
    let filmMenuCloseTimer = 0;

    function isFilmMenuCollapsed() {
        return Boolean(filmMenuButton) && window.getComputedStyle(filmMenuButton).display !== "none";
    }

    function setFilmMenuExpanded(isExpanded) {
        filmMenuButton?.setAttribute("aria-expanded", String(isExpanded));
    }

    function openFilmMenuByHover() {
        if (!filmMenu || !isFilmMenuCollapsed() || filmMenu.dataset.pinnedOpen === "true") return;
        clearTimeout(filmMenuCloseTimer);
        filmMenu.classList.add("hover-open");
        setFilmMenuExpanded(true);
    }

    function closeFilmMenuByHover() {
        if (!filmMenu || filmMenu.dataset.pinnedOpen === "true") return;
        clearTimeout(filmMenuCloseTimer);
        filmMenuCloseTimer = window.setTimeout(function () {
            filmMenu.classList.remove("hover-open");
            setFilmMenuExpanded(filmMenu.classList.contains("open"));
        }, 140);
    }

    filmMenuButton?.addEventListener("mouseenter", openFilmMenuByHover);
    filmMenuButton?.addEventListener("mouseleave", closeFilmMenuByHover);
    filmMenu?.addEventListener("mouseenter", openFilmMenuByHover);
    filmMenu?.addEventListener("mouseleave", closeFilmMenuByHover);

    document.addEventListener("click", function (event) {
        if (!filmMenu || !filmMenuButton || !isFilmMenuCollapsed()) return;
        if (filmMenu.contains(event.target) || filmMenuButton.contains(event.target)) return;

        filmMenu.classList.remove("open", "hover-open");
        filmMenu.dataset.pinnedOpen = "false";
        setFilmMenuExpanded(false);
    });

    window.addEventListener("resize", function () {
        if (!filmMenu || !filmMenuButton || isFilmMenuCollapsed()) return;
        filmMenu.classList.remove("open", "hover-open");
        filmMenu.dataset.pinnedOpen = "false";
        setFilmMenuExpanded(false);
    });

    input?.addEventListener("input", function () {
        filterCurrentPage(input.value);
    });

    document.querySelectorAll("[data-app-filter]").forEach(function (panel) {
        const searchBox = panel.querySelector("[data-app-filter-search]");
        const statusBox = panel.querySelector("[data-app-filter-status]");
        const methodBox = panel.querySelector("[data-app-filter-method]");
        const sortBox = panel.querySelector("[data-app-filter-sort]");
        const resetButton = panel.querySelector("[data-app-filter-reset]");
        const targetSelector = panel.getAttribute("data-app-filter-target") || "tbody tr";
        const anchor = document.querySelector(".booking-filter-anchor")
            || document.querySelector(".booking-grid")
            || document.querySelector(".transaction-table-wrap")
            || document.querySelector(".table-wrapper");

        if (anchor && anchor.parentElement) {
            anchor.parentElement.insertBefore(panel, anchor);
        }

        function normalizeFilterValue(value) {
            return String(value || "").trim().toLowerCase();
        }

        function getFilterValues(item, key) {
            return normalizeFilterValue(item.dataset[key])
                .split("|")
                .map(value => value.trim())
                .filter(Boolean);
        }

        function matchesFilter(item, key, selectedValue, text) {
            if (!selectedValue) return true;

            const values = getFilterValues(item, key);
            return values.length > 0
                ? values.includes(selectedValue)
                : text.includes(selectedValue);
        }

        function getSortValue(item, key) {
            return item.dataset[key] || "";
        }

        function sortItems() {
            const sort = sortBox?.value || "showtime-asc";
            const parentMap = new Map();

            document.querySelectorAll(targetSelector).forEach(function (item) {
                if (panel.contains(item) || !item.parentElement) return;

                const parent = item.parentElement;
                if (!parentMap.has(parent)) {
                    parentMap.set(parent, []);
                }

                parentMap.get(parent).push(item);
            });

            parentMap.forEach(function (items, parent) {
                items
                    .sort(function (a, b) {
                        if (sort === "booked-desc" || sort === "booked-asc") {
                            const left = Number(getSortValue(a, "sortBooked") || "0");
                            const right = Number(getSortValue(b, "sortBooked") || "0");
                            return sort === "booked-desc" ? right - left : left - right;
                        }

                        if (sort === "amount-desc" || sort === "amount-asc") {
                            const left = Number(getSortValue(a, "sortAmount") || "0");
                            const right = Number(getSortValue(b, "sortAmount") || "0");
                            return sort === "amount-desc" ? right - left : left - right;
                        }

                        if (sort === "status-asc") {
                            return getSortValue(a, "sortStatus").localeCompare(getSortValue(b, "sortStatus"));
                        }

                        const left = Number(getSortValue(a, "sortShowtime") || "0");
                        const right = Number(getSortValue(b, "sortShowtime") || "0");
                        return sort === "showtime-desc" ? right - left : left - right;
                    })
                    .forEach(function (item) {
                        parent.appendChild(item);
                    });
            });
        }

        function applyFilters() {
            const query = normalizeFilterValue(searchBox?.value);
            const status = normalizeFilterValue(statusBox?.value);
            const method = normalizeFilterValue(methodBox?.value);
            const hasActiveFilter = Boolean(query || status || method);

            document.querySelectorAll(targetSelector).forEach(function (item) {
                if (panel.contains(item)) return;

                const text = normalizeFilterValue(item.dataset.filterSearch || item.innerText);
                const matchesSearch = !query || text.includes(query);
                const matchesStatus = matchesFilter(item, "filterStatus", status, text);
                const matchesMethod = matchesFilter(item, "filterMethod", method, text);
                item.hidden = !(matchesSearch && matchesStatus && matchesMethod);
            });

            sortItems();

            document.querySelectorAll(".booking-category").forEach(function (category) {
                const cards = Array.from(category.querySelectorAll(".booking-card"));
                const emptyState = category.querySelector(".booking-category-empty");
                const activeBookingTab = document.querySelector("[data-booking-tab].active");
                const activeBookingCategory = activeBookingTab?.dataset.bookingTab;

                if (activeBookingCategory && category.dataset.bookingCategory !== activeBookingCategory) {
                    category.hidden = true;
                    return;
                }

                if (!cards.length) {
                    category.hidden = hasActiveFilter;
                    return;
                }

                category.hidden = cards.every(function (card) {
                    return card.hidden;
                });

                if (emptyState) {
                    emptyState.hidden = hasActiveFilter;
                }
            });
        }

        searchBox?.addEventListener("input", applyFilters);
        statusBox?.addEventListener("change", applyFilters);
        methodBox?.addEventListener("change", applyFilters);
        sortBox?.addEventListener("change", applyFilters);
        resetButton?.addEventListener("click", function () {
            if (searchBox) searchBox.value = "";
            if (statusBox) statusBox.value = "";
            if (methodBox) methodBox.value = "";
            if (sortBox) sortBox.value = "showtime-asc";
            applyFilters();
            searchBox?.focus();
        });

        if (sortBox) sortBox.value = "showtime-asc";
        applyFilters();
    });
});
</script>

