<script>
(function () {
    // Theme and cursor settings live in localStorage so public pages, profile pages, and admin pages stay in sync.
    if (localStorage.getItem("showTimeThemeVersion") !== "3") {
        localStorage.setItem("showTimeTheme", "cinema");
        localStorage.setItem("showTimeThemeVersion", "3");
    }

    const storedTheme = localStorage.getItem("showTimeTheme") || "cinema";
    const storedCursor = localStorage.getItem("showTimeCursor") || "liquid";
    document.documentElement.dataset.theme = storedTheme;
    document.documentElement.dataset.themeChoice = storedTheme;
    document.documentElement.dataset.cursorChoice = storedCursor;
    const storedCursorColor = localStorage.getItem("showTimeCursorColor");
    if (storedCursorColor) {
        document.documentElement.style.setProperty("--app-cursor-color", storedCursorColor);
    }
})();
</script>

