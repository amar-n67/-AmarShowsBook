<!DOCTYPE html>
<html lang="en">
<head>
    <style>
:root {
    --app-bg: #0f172a;
    --app-text: #e5e7eb;
    --app-card: #1e293b;
    --app-card-text: #f1f5f9;
    --app-input: #334155;
    --app-input-text: #fff;
    --app-input-border: #475569;
    --app-input-disabled: #243244;
    --app-input-disabled-text: #a8b3c7;
    --app-muted: #cbd5f5;
    --app-link: #93c5fd;
    --app-primary: #6366f1;
    --app-primary-hover: #4f46e5;
    --app-nav: linear-gradient(135deg, #231f20, #8f1d3f 52%, #0f766e);
    --app-nav-text: #fffdf8;
    --app-accent: #f7d774;
    --app-accent-strong: #0f766e;
    --app-danger: #991b1b;
    --app-page-surface: #fff;
    --app-page-text: #231f20;
    --app-profile-bg: linear-gradient(135deg, rgba(35, 31, 32, 0.96), rgba(122, 24, 46, 0.9), rgba(15, 118, 110, 0.86));
}

html[data-theme="system"] {
    --app-bg: #e8edf5;
    --app-text: #1f2937;
    --app-card: #f9fbff;
    --app-card-text: #1f2937;
    --app-input: #ffffff;
    --app-input-text: #111827;
    --app-input-border: #bac4d4;
    --app-input-disabled: #e3e8f0;
    --app-input-disabled-text: #667085;
    --app-muted: #64748b;
    --app-link: #315f9f;
    --app-primary: #315f9f;
    --app-primary-hover: #244a7e;
    --app-nav: linear-gradient(135deg, #233142, #455d7a 58%, #a37c40);
    --app-nav-text: #fffdf8;
    --app-accent: #f2c46d;
    --app-accent-strong: #315f9f;
    --app-danger: #9f3a3a;
    --app-page-surface: #f9fbff;
    --app-page-text: #1f2937;
    --app-profile-bg: linear-gradient(135deg, #dfe7f1, #f8fafc, #fff7e6);
}

html[data-theme="white"] {
    --app-bg: #f7f7fb;
    --app-text: #1f2937;
    --app-card: #ffffff;
    --app-card-text: #1f2937;
    --app-input: #ffffff;
    --app-input-text: #111827;
    --app-input-border: #d1d5db;
    --app-input-disabled: #eef2f7;
    --app-input-disabled-text: #6b7280;
    --app-muted: #6b7280;
    --app-link: #2563eb;
    --app-primary: #2563eb;
    --app-primary-hover: #1d4ed8;
    --app-nav: linear-gradient(135deg, #ffffff, #eef2ff 55%, #dbeafe);
    --app-nav-text: #111827;
    --app-accent: #2563eb;
    --app-accent-strong: #0f766e;
    --app-danger: #dc2626;
    --app-page-surface: #ffffff;
    --app-page-text: #111827;
    --app-profile-bg: linear-gradient(135deg, #f8fafc, #eef2ff, #ecfeff);
}

html[data-theme="dark"] {
    --app-bg: #050816;
    --app-text: #e5e7eb;
    --app-card: #111827;
    --app-card-text: #f9fafb;
    --app-input: #1f2937;
    --app-input-text: #ffffff;
    --app-input-border: #374151;
    --app-input-disabled: #111827;
    --app-input-disabled-text: #9ca3af;
    --app-muted: #9ca3af;
    --app-link: #93c5fd;
    --app-primary: #4f46e5;
    --app-primary-hover: #4338ca;
    --app-nav: linear-gradient(135deg, #050816, #312e81, #164e63);
    --app-nav-text: #f9fafb;
    --app-accent: #a5b4fc;
    --app-accent-strong: #22d3ee;
    --app-danger: #b91c1c;
    --app-page-surface: #111827;
    --app-page-text: #f9fafb;
    --app-profile-bg: linear-gradient(135deg, #050816, #111827, #164e63);
}

html[data-theme="cinema"] {
    --app-bg: #0f172a;
    --app-text: #e5e7eb;
    --app-card: #1e293b;
    --app-card-text: #f1f5f9;
    --app-input: #334155;
    --app-input-text: #fff;
    --app-input-border: #475569;
    --app-input-disabled: #243244;
    --app-input-disabled-text: #a8b3c7;
    --app-muted: #cbd5f5;
    --app-link: #93c5fd;
    --app-primary: #6366f1;
    --app-primary-hover: #4f46e5;
    --app-nav: linear-gradient(135deg, #231f20, #8f1d3f 52%, #0f766e);
    --app-nav-text: #fffdf8;
    --app-accent: #f7d774;
    --app-accent-strong: #0f766e;
    --app-danger: #991b1b;
    --app-page-surface: #fff;
    --app-page-text: #231f20;
    --app-profile-bg: linear-gradient(135deg, rgba(35, 31, 32, 0.96), rgba(122, 24, 46, 0.9), rgba(15, 118, 110, 0.86));
}

body {
    background: var(--app-bg);
    color: var(--app-text);
    font-family: 'Segoe UI', sans-serif;
    transition: background 0.2s ease, color 0.2s ease;
}

.card {
    background: var(--app-card) !important;
    border-radius: 16px;
    color: var(--app-card-text) !important;
    border-color: var(--app-input-border) !important;
}

.form-control,
.form-select,
input,
select,
textarea {
    background-color: var(--app-input) !important;
    color: var(--app-input-text) !important;
    border-color: var(--app-input-border) !important;
}

.form-control::placeholder,
input::placeholder,
textarea::placeholder {
    color: var(--app-muted) !important;
    opacity: 1;
}

.form-control:disabled,
.form-control[readonly],
input:disabled,
input[readonly],
select:disabled,
textarea:disabled,
textarea[readonly] {
    background-color: var(--app-input-disabled) !important;
    color: var(--app-input-disabled-text) !important;
    border-color: var(--app-input-border) !important;
    opacity: 1;
}

label,
.form-label,
h1, h2, h3, h4, h5, h6,
p,
li,
td,
th {
    color: inherit;
}

.text-muted {
    color: var(--app-muted) !important;
}

.table {
    color: var(--app-text);
}

.alert {
    border-radius: 12px;
}

.alert-danger {
    background: color-mix(in srgb, var(--app-danger) 14%, var(--app-card)) !important;
    color: var(--app-card-text) !important;
    border-color: color-mix(in srgb, var(--app-danger) 44%, var(--app-input-border)) !important;
}

.alert-success {
    background: color-mix(in srgb, var(--app-accent-strong) 15%, var(--app-card)) !important;
    color: var(--app-card-text) !important;
    border-color: color-mix(in srgb, var(--app-accent-strong) 45%, var(--app-input-border)) !important;
}

.btn-primary {
    background: var(--app-primary);
    border: none;
}

.btn-primary:hover {
    background: var(--app-primary-hover);
}

a {
    color: var(--app-link);
}
@@keyframes popupFade {
    from {
        opacity: 0;
        transform: translate(-50%, -58%) scale(0.92);
    }

    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
}

.cinema-popup-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background:
        linear-gradient(135deg, rgba(18, 24, 38, 0.78), rgba(122, 24, 46, 0.72)),
        rgba(0, 0, 0, 0.54);
    backdrop-filter: blur(7px);
    z-index: 10000;
}

.cinema-popup-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(420px, calc(100vw - 32px));
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 18px;
    background: #fffdf8;
    color: #231f20;
    box-shadow: 0 28px 80px rgba(0,0,0,0.46);
    animation: popupFade 0.25s ease forwards;
}

.cinema-popup-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    background: linear-gradient(135deg, #231f20, #8f1d3f, #0f766e);
    color: #f7d774;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.cinema-popup-body {
    padding: 24px;
    text-align: center;
}

.cinema-popup-title {
    margin: 0 0 8px;
    color: #231f20;
    font-weight: 850;
}

.cinema-popup-message {
    margin: 0;
    color: #4b5563;
    line-height: 1.5;
}

.cinema-popup-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 0 24px 24px;
}

.cinema-popup-btn {
    min-width: 110px;
    border: 0;
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: 800;
}

.cinema-popup-ok {
    background: #0f766e;
    color: #fff;
}

.cinema-popup-cancel {
    background: #e5e7eb;
    color: #374151;
}

.cinema-popup-backdrop.error .cinema-popup-strip {
    background: linear-gradient(135deg, #231f20, #991b1b, #b45309);
}

.cinema-popup-backdrop.success .cinema-popup-strip {
    background: linear-gradient(135deg, #14532d, #0f766e);
}

.film-navbar {
    margin: 14px;
    border: 1px solid rgba(247, 215, 116, 0.28);
    border-radius: 18px;
    background: var(--app-nav);
    box-shadow: 0 16px 36px rgba(0,0,0,0.28);
}

.film-navbar .container-fluid {
    gap: 14px;
}

.film-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--app-nav-text) !important;
    font-weight: 900;
    letter-spacing: 0;
}

.film-brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px dashed rgba(247, 215, 116, 0.7);
    border-radius: 10px;
    color: var(--app-accent);
    background: rgba(255,255,255,0.08);
}

.film-menu {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
}

.film-user-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 14px;
    background: rgba(255,255,255,0.1);
    color: var(--app-nav-text);
}

.film-user-meta {
    text-align: right;
    line-height: 1.2;
}

.film-time {
    color: color-mix(in srgb, var(--app-nav-text) 72%, transparent);
    font-size: 11px;
}

.film-email {
    max-width: 220px;
    overflow: hidden;
    color: var(--app-nav-text);
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.film-avatar {
    width: 42px;
    height: 42px;
    border: 2px solid var(--app-accent);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 8px 18px rgba(0,0,0,0.3);
}

.film-nav-btn {
    border: 0;
    border-radius: 999px;
    padding: 8px 14px;
    font-weight: 850;
    text-decoration: none;
}

.film-profile-btn {
    background: var(--app-accent);
    color: #231f20 !important;
}

.film-logout-btn {
    background: var(--app-danger);
    color: #fff !important;
}

.theme-switcher {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 999px;
    background: rgba(255,255,255,0.11);
}

.theme-toggle-btn {
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--app-nav-text);
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 850;
}

.theme-toggle-btn.active {
    background: var(--app-accent);
    color: #231f20;
    box-shadow: 0 6px 16px rgba(0,0,0,0.22);
}

.profile-page {
    background: var(--app-profile-bg), repeating-linear-gradient(90deg, rgba(255,255,255,0.04) 0 12px, transparent 12px 26px) !important;
}

.profile-shell {
    background: var(--app-page-surface) !important;
    color: var(--app-page-text) !important;
}

.profile-hero,
.poster-panel {
    background: var(--app-nav) !important;
}

html[data-theme="dark"] .profile-scene,
.profile-scene,
.scene-title h5,
.field-block label {
    color: var(--app-page-text) !important;
}

.scene-title span,
.dropdown-icon {
    color: var(--app-accent-strong) !important;
}

.profile-scene {
    border-bottom-color: var(--app-input-border) !important;
}

.clean-input {
    background-color: var(--app-input) !important;
    color: var(--app-input-text) !important;
    border-color: var(--app-input-border) !important;
}

input.clean-input[readonly],
.clean-input:disabled {
    background-color: var(--app-input-disabled) !important;
    color: var(--app-input-disabled-text) !important;
    border-color: var(--app-input-border) !important;
}

.profile-hero h2,
.profile-hero p,
.poster-panel,
.poster-panel * {
    color: var(--app-nav-text) !important;
}

.poster-label,
.profile-ticket {
    color: var(--app-accent) !important;
}

html[data-theme="white"] .film-user-card,
html[data-theme="white"] .theme-switcher,
html[data-theme="system"] .film-user-card,
html[data-theme="system"] .theme-switcher {
    border-color: rgba(17,24,39,0.12);
    background: rgba(17,24,39,0.05);
}

@@media (max-width: 760px) {
    .film-navbar {
        margin: 8px;
    }

    .film-menu {
        width: 100%;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .film-user-card {
        width: 100%;
        justify-content: flex-end;
    }

    .theme-switcher {
        order: 3;
        width: 100%;
        justify-content: space-between;
    }
}

</style>
