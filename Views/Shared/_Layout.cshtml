        : "/uploads/default.png")"
         class="film-avatar" />
            </div>
     
            <!-- PROFILE BUTTON -->
            <a class="film-nav-btn film-profile-btn" href="/Profile/MyProfile">My Profile</a>

            <!-- LOGOUT -->
