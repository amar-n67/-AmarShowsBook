<!-- ================= SCRIPTS ================= -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
function getPasswordCatMarkup(isOpen) {
    return '<span class="password-cat ' + (isOpen ? 'open' : 'closed') + '" aria-hidden="true">' +
        '<span class="password-cat-face">' +
        '<span class="password-cat-eye"></span>' +
        '<span class="password-cat-eye"></span>' +
        '</span>' +
        '</span>';
}

function setPasswordToggleState(button, isOpen) {
    if (!button) return;

    button.innerHTML = getPasswordCatMarkup(isOpen);
    button.setAttribute("aria-label", isOpen ? "Hide password" : "Show password");
    button.title = isOpen ? "Hide password" : "Show password";
}

document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll("[data-password-toggle]").forEach(function (button) {
        var fieldId = button.getAttribute("data-password-toggle");
        var input = document.getElementById(fieldId);
        setPasswordToggleState(button, input && input.type === "text");
    });
});

function togglePassword(fieldId, button) {
    var input = document.getElementById(fieldId);
    if (!input) return;

    var shouldShow = input.type === "password";
    input.type = shouldShow ? "text" : "password";

    var toggleButton = button || document.querySelector('[data-password-toggle="' + fieldId + '"]');
    setPasswordToggleState(toggleButton, shouldShow);
}
</script>

<!-- ✅ DATE + TIME -->
<script>
function updateDateTime() {
    let liveDateTime = document.getElementById("liveDateTime");
    if (!liveDateTime) return;

    let now = new Date();

    let date = now.toLocaleDateString('en-IN', {
        weekday: 'long',
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });

    let time = now.toLocaleTimeString();

    liveDateTime.innerHTML = date + " | " + time;
}
setInterval(updateDateTime, 1000);
updateDateTime();
</script>

<script>
(function () {
    function markThemeButton(choice) {
        document.querySelectorAll(".theme-toggle-btn").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.themeChoice === choice);
        });
    }

    window.setAppTheme = function (choice) {
        const themeChoice = choice || "cinema";
        localStorage.setItem("amarShowsTheme", themeChoice);
        localStorage.setItem("amarShowsThemeVersion", "3");
        document.documentElement.dataset.themeChoice = themeChoice;
        document.documentElement.dataset.theme = themeChoice;
        markThemeButton(themeChoice);
    };

    document.addEventListener("DOMContentLoaded", function () {
        const saved = localStorage.getItem("amarShowsTheme") || "cinema";
        window.setAppTheme(saved);
    });
})();
</script>

<!-- LOGOUT CONFIRM -->
<script>
function confirmLogout() {
    showCinemaPopup("Interval or exit? Your show will close and you will be logged out.", "confirm", {
        title: "Exit The Show?",
        okText: "Exit Show",
        cancelText: "Stay Seated",
        onOk: function () {
            window.location.href = "/Auth/Logout";
        }
    });

    return false;
}
</script>

<script>

document.addEventListener("DOMContentLoaded", function () {
    // Human Comment:
    // Inactivity validation only runs for logged-in users, never on login/logout pages.
    const isSessionUserLoggedIn = @isLoggedIn.ToString().ToLowerInvariant();

    if (!isSessionUserLoggedIn) {
        return;
    }

    let inactivityTimer;
    let countdownTimer;
    let timeLeft = 30;
    let popupVisible = false;

    const INACTIVITY_TIME = 3 * 60 * 1000; // ✅ 3 minutes (change if needed)

    const cinemaMessages = [
        "🍿 Audience gone missing...",
        "🎥 Projector waiting for you...",
        "🎬 Interval chal raha hai...",
        "📽 Scene ruk gaya hai boss...",
        "🎞 Reel freeze ho gaya...",
        "🛑 Show paused... hero kidhar hai?"
    ];

    function resetTimer() {
        clearTimeout(inactivityTimer);

        if (popupVisible) {
            hidePopup();
        }

        inactivityTimer = setTimeout(showSessionPopup, INACTIVITY_TIME);
    }

    function showSessionPopup() {
        popupVisible = true;

        let popup = document.getElementById("sessionPopup");
        let text = document.getElementById("cinemaText");

        if (!popup || !text) return; // ✅ safety

        popup.style.display = "block";

        // random message
        text.innerText = cinemaMessages[Math.floor(Math.random() * cinemaMessages.length)];

        timeLeft = 30;
        updateCountdown();

        clearInterval(countdownTimer);

        countdownTimer = setInterval(() => {
            timeLeft--;
            updateCountdown();

            if (timeLeft <= 0) {
                clearInterval(countdownTimer);
                autoLogout();
            }

        }, 1000);
    }

    function updateCountdown() {
        let el = document.getElementById("countdown");
        if (!el) return;

        el.innerText = "-" + timeLeft;

        // subtle animation
        el.style.transform = "scale(1.1)";
        setTimeout(() => {
            el.style.transform = "scale(1)";
        }, 150);
    }

    function hidePopup() {
        popupVisible = false;

        let popup = document.getElementById("sessionPopup");
        if (popup) popup.style.display = "none";

        clearInterval(countdownTimer);
    }

    window.stayActive = function () {
        hidePopup();
        resetTimer();
    };

    function autoLogout() {
        if (window.location.pathname.toLowerCase() === "/auth/logout") {
            return;
        }

        window.location.href = "/Auth/Logout";
    }

    // USER ACTIVITY TRACK
    ["click","mousemove","keypress","scroll","touchstart"].forEach(event => {
        document.addEventListener(event, resetTimer);
    });

    // START
    resetTimer();

});

</script>

<script>
(function () {
    const nativeAlert = window.alert.bind(window);

    function popupTypeFromMessage(message) {
        const text = String(message || "").toLowerCase();

        if (text.includes("success") || text.includes("verified") || text.includes("sent")) {
            return "success";
        }

        if (
            text.includes("error") ||
            text.includes("invalid") ||
            text.includes("required") ||
            text.includes("not") ||
            text.includes("fail") ||
            text.includes("already") ||
            text.includes("nothing")
        ) {
            return "error";
        }

        return "info";
    }

    window.showCinemaPopup = function (message, type, options) {
        const popup = document.getElementById("cinemaPopup");
        const title = document.getElementById("cinemaPopupTitle");
        const body = document.getElementById("cinemaPopupMessage");
        const ok = document.getElementById("cinemaPopupOk");
        const cancel = document.getElementById("cinemaPopupCancel");

        if (!popup || !title || !body || !ok || !cancel) {
            nativeAlert(message);
            return;
        }

        const settings = options || {};
        const popupType = type || popupTypeFromMessage(message);

        popup.className = "cinema-popup-backdrop " + popupType;
        title.innerText = settings.title || (
            popupType === "success" ? "Housefull Applause" :
            popupType === "error" ? "Scene Cut" :
            popupType === "confirm" ? "Director's Call" :
            "Director's Note"
        );
        body.innerText = message;
        ok.innerText = settings.okText || "Continue";
        cancel.innerText = settings.cancelText || "Cancel";
        cancel.classList.toggle("d-none", popupType !== "confirm");
        popup.style.display = "block";

        ok.onclick = function () {
            popup.style.display = "none";
            if (typeof settings.onOk === "function") settings.onOk();
        };

        cancel.onclick = function () {
            popup.style.display = "none";
            if (typeof settings.onCancel === "function") settings.onCancel();
        };
    };

    window.showPopup = function (message, type) {
        window.showCinemaPopup(message, type);
    };

    window.alert = function (message) {
        window.showCinemaPopup(message);
    };
})();
</script>

@RenderSection("Scripts", required: false)

<script>
function showPopup(message) {
    window.showCinemaPopup(message);
}
</script>
</body>
</html>
