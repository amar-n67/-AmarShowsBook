<script>
(function () {
    let committedTheme = localStorage.getItem("showTimeTheme") || "cinema";

    function markThemeButton(choice) {
        document.querySelectorAll(".theme-toggle-btn").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.themeChoice === choice);
        });
    }

    function previewTheme(choice) {
        const themeChoice = choice || committedTheme || "cinema";
        document.documentElement.dataset.themeChoice = themeChoice;
        document.documentElement.dataset.theme = themeChoice;
    }

    function restoreThemePreview() {
        previewTheme(committedTheme);
        markThemeButton(committedTheme);
    }

    function isMobileThemeTapTarget(target) {
        const element = target instanceof Element ? target : target?.parentElement;
        return !element?.closest("a,button,input,select,textarea,label,summary,[role='button'],[contenteditable='true'],[data-no-theme-double-tap]");
    }

    function enableMobileThemeDoubleTap() {
        const isTouchDevice = window.matchMedia("(hover: none), (pointer: coarse)").matches ||
            navigator.maxTouchPoints > 0;

        if (!isTouchDevice) return;

        const themeOrder = ["cinema", "dark", "white", "system"];
        let lastTapTime = 0;
        let lastTapX = 0;
        let lastTapY = 0;

        document.addEventListener("touchend", function (event) {
            if (event.changedTouches.length !== 1 || event.touches.length > 0) return;

            const touch = event.changedTouches[0];
            const now = Date.now();
            const isDoubleTap =
                now - lastTapTime > 60 &&
                now - lastTapTime < 360 &&
                Math.abs(touch.clientX - lastTapX) < 42 &&
                Math.abs(touch.clientY - lastTapY) < 42;

            if (!isDoubleTap) {
                lastTapTime = now;
                lastTapX = touch.clientX;
                lastTapY = touch.clientY;
                return;
            }

            lastTapTime = 0;

            if (!isMobileThemeTapTarget(event.target)) return;

            event.preventDefault();
            const currentTheme = localStorage.getItem("showTimeTheme") || committedTheme || "cinema";
            const currentIndex = themeOrder.indexOf(currentTheme);
            const nextTheme = themeOrder[(currentIndex + 1 + themeOrder.length) % themeOrder.length];

            window.setAppTheme(nextTheme);
            navigator.vibrate?.(18);
        }, { passive: false });
    }

    window.setAppTheme = function (choice) {
        const themeChoice = choice || "cinema";
        committedTheme = themeChoice;
        localStorage.setItem("showTimeTheme", themeChoice);
        localStorage.setItem("showTimeThemeVersion", "3");
        document.documentElement.dataset.themeChoice = themeChoice;
        document.documentElement.dataset.theme = themeChoice;
        markThemeButton(themeChoice);
    };

    document.addEventListener("DOMContentLoaded", function () {
        const saved = localStorage.getItem("showTimeTheme") || "cinema";
        committedTheme = saved;
        window.setAppTheme(saved);

        document.querySelectorAll(".theme-toggle-btn[data-theme-choice]").forEach(button => {
            const choice = button.dataset.themeChoice;
            button.addEventListener("mouseenter", () => previewTheme(choice));
            button.addEventListener("focus", () => previewTheme(choice));
            button.addEventListener("mouseleave", restoreThemePreview);
            button.addEventListener("blur", restoreThemePreview);
        });

        enableMobileThemeDoubleTap();
    });
})();
</script>

<script>
function updateShowTimePrintMetadata() {
    const now = new Date();
    const formatted = now.toLocaleString(undefined, {
        year: "numeric",
        month: "short",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit"
    });

    document.querySelectorAll("[data-print-now]").forEach(element => {
        element.textContent = formatted;
    });

    const fallbackTitle = document.querySelector("h1")?.textContent?.trim() ||
        document.title.replace(/\s+-\s+.*$/, "").trim() ||
        "showTime";

    document.querySelectorAll("[data-print-title]").forEach(element => {
        element.textContent = fallbackTitle;
    });
}

window.addEventListener("beforeprint", updateShowTimePrintMetadata);

window.showCaptureProtection = window.showCaptureProtection || function (message) {
    const overlay = document.querySelector("[data-capture-protection-overlay]");
    if (!overlay) {
        return;
    }

    const detail = overlay.querySelector("span");
    if (detail && message) {
        detail.textContent = message;
    }

    overlay.classList.add("is-visible");
    clearTimeout(window.__captureProtectionTimer);
    window.__captureProtectionTimer = setTimeout(() => {
        overlay.classList.remove("is-visible");
    }, 1800);
};

(function () {
    const canCapture = document.body?.dataset.captureAllowed === "true";
    if (canCapture) {
        return;
    }

    const protectedMessage = "Recording, screenshots, search shortcuts, and print are allowed only for Admin and Super Admin.";
    const nativePrint = window.print;

    window.print = function () {
        window.showCaptureProtection("Print is allowed only for Admin and Super Admin.");
        return false;
    };

    window.__showTimeNativePrint = nativePrint;

    if (navigator.mediaDevices?.getDisplayMedia) {
        navigator.mediaDevices.getDisplayMedia = function () {
            window.showCaptureProtection(protectedMessage);
            return Promise.reject(new DOMException("Screen capture is restricted.", "NotAllowedError"));
        };
    }

    document.addEventListener("keydown", function (event) {
        const key = String(event.key || "").toLowerCase();
        const code = String(event.code || "").toLowerCase();
        const hasModifier = event.ctrlKey || event.metaKey;
        const isBlockedShortcut =
            (hasModifier && ["p", "s", "f", "u"].includes(key)) ||
            (event.ctrlKey && event.shiftKey && ["i", "j", "c", "s"].includes(key)) ||
            (event.metaKey && event.altKey && ["i", "j", "c"].includes(key)) ||
            key === "f12" ||
            key === "printscreen" ||
            code === "printscreen" ||
            (event.metaKey && event.shiftKey && ["3", "4", "5"].includes(key));

        if (!isBlockedShortcut) {
            return;
        }

        event.preventDefault();
        event.stopPropagation();
        window.showCaptureProtection(protectedMessage);
    }, true);

    document.addEventListener("contextmenu", function (event) {
        event.preventDefault();
        window.showCaptureProtection(protectedMessage);
    }, true);

    window.addEventListener("beforeprint", function (event) {
        event.preventDefault?.();
        window.showCaptureProtection("Print is allowed only for Admin and Super Admin.");
    });
})();
</script>

