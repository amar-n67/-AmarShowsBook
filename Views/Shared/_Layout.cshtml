    --app-popup-muted: #4b5563;
    --app-popup-backdrop: linear-gradient(135deg, rgba(255, 255, 255, 0.7), rgba(219, 234, 254, 0.82)), rgba(15, 23, 42, 0.28);
    --app-profile-bg: linear-gradient(135deg, #f8fafc, #eef2ff, #ecfeff);
