}
</style>

</head>

<body>
    <div id="cinemaPopup" class="cinema-popup-backdrop" role="dialog" aria-modal="true" aria-labelledby="cinemaPopupTitle">
        <div class="cinema-popup-card">
            <div class="cinema-popup-strip">
                <span id="cinemaPopupReel">AmarShowsBook</span>
                <span>Final Take</span>
            </div>
            <div class="cinema-popup-body">
                <h5 id="cinemaPopupTitle" class="cinema-popup-title">Director's Note</h5>
                <p id="cinemaPopupMessage" class="cinema-popup-message"></p>
            </div>
            <div class="cinema-popup-actions">
                <button type="button" id="cinemaPopupCancel" class="cinema-popup-btn cinema-popup-cancel d-none">Retake</button>
                <button type="button" id="cinemaPopupOk" class="cinema-popup-btn cinema-popup-ok">Continue</button>
            </div>
        </div>
</div>
<!-- ================= SESSION POPUP ================= -->
<div id="sessionPopup" style="
display:none;
position:fixed;
top:0; left:0;
width:100%; height:100%;
background:rgba(0,0,0,0.75);
backdrop-filter: blur(6px);
z-index:9999;">

    <div style="
        position:absolute;
        top:50%; left:50%;
        transform:translate(-50%, -50%) scale(0.9);
        background:#1e293b;
        padding:30px;
        border-radius:14px;
        text-align:center;
        color:white;
        width:320px;
        box-shadow:0 0 30px rgba(0,0,0,0.8);
        animation: popupFade 0.35s ease forwards;
    ">

        <h4 style="color:#facc15;">🎬 Still Watching?</h4>

        <p id="cinemaText" style="color:#cbd5f5;">
            Your show is paused... audience missing 🍿
        </p>

        <h2 id="countdown"
            style="color:#f87171;
                   font-size:42px;
                   margin:10px 0;
                   text-shadow:0 0 10px #f87171;">
            -30
        </h2>

        <button onclick="stayActive()"
                class="btn btn-success mt-2">
            ▶ Continue Watching
        </button>

    </div>
</div>

<!-- ================= NAVBAR ================= -->
<header>
<nav class="navbar navbar-expand-sm film-navbar mb-3">
<div class="container-fluid">

    <a class="navbar-brand film-brand" asp-controller="Home" asp-action="Index">
        <span class="film-brand-badge">🎬</span>
        <span>showTime</span>
    </a>

@{
    var isLoggedIn = Context.Session.GetString("UserEmail") != null;
}

    <div class="film-menu">
        <div class="theme-switcher" aria-label="Theme selector">
            <button type="button" class="theme-toggle-btn" data-theme-choice="system" onclick="setAppTheme('system')">System</button>
            <button type="button" class="theme-toggle-btn" data-theme-choice="dark" onclick="setAppTheme('dark')">Dark</button>
            <button type="button" class="theme-toggle-btn" data-theme-choice="white" onclick="setAppTheme('white')">White</button>
            <button type="button" class="theme-toggle-btn" data-theme-choice="cinema" onclick="setAppTheme('cinema')">Cinema</button>
        </div>

        @if (isLoggedIn)
        {
            <div class="film-actions">
                <div class="film-navigation-links" aria-label="Main navigation">
                    <a class="film-nav-btn" href="/Home/Index">Home</a>
                    <a class="film-nav-btn" href="/Booking/MyBookings">My Bookings</a>
                    <a class="film-nav-btn" href="/Transaction/History">My Transactions</a>
                    <a class="film-nav-btn" href="/Wallet/Index">Wallet</a>
                    <a class="film-nav-btn" href="/Admin/Dashboard">Admin Dashboard</a>
