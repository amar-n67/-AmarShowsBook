<!DOCTYPE html>
<html lang="en">
<head>
    <style>
body {
    background: #0f172a;
    color: #e5e7eb;
    font-family: 'Segoe UI', sans-serif;
}

.card {
    background: #1e293b;
    border-radius: 16px;
    color: #f1f5f9;
}

.form-control {
    background: #334155;
    color: #fff;
    border: none;
}

.form-control::placeholder {
    color: #cbd5f5;
}

.btn-primary {
    background: #6366f1;
    border: none;
}

.btn-primary:hover {
    background: #4f46e5;
}

a {
    color: #93c5fd;
}
/* ✅ ADD THIS (animation for popup) */

@@keyframes popupFade {

    from {

        opacity: 0;

        transform: translate(-50%, -60%) scale(0.8);

    }

    to {

        opacity: 1;

        transform: translate(-50%, -50%) scale(1);

    }

}

</style>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - AmarShowsBook</title>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" />

</head>

<body>
    <div id="customPopup" style="
display:none;
position:fixed;
top:20px;
right:20px;
background:#1e293b;
color:#fff;
padding:15px 20px;
border-radius:8px;
box-shadow:0 0 10px rgba(0,0,0,0.5);
z-index:9999;">
</div>
<!-- ================= SESSION POPUP ================= -->
<div id="sessionPopup" style="
display:none;
position:fixed;
top:0; left:0;
width:100%; height:100%;
background:rgba(0,0,0,0.75);
backdrop-filter: blur(6px);
z-index:9999;">

    <div style="
        position:absolute;
        top:50%; left:50%;
        transform:translate(-50%, -50%) scale(0.9);
        background:#1e293b;
        padding:30px;
        border-radius:14px;
        text-align:center;
        color:white;
        width:320px;
        box-shadow:0 0 30px rgba(0,0,0,0.8);
        animation: popupFade 0.35s ease forwards;
    ">

        <h4 style="color:#facc15;">🎬 Still Watching?</h4>

        <p id="cinemaText" style="color:#cbd5f5;">
            Your show is paused... audience missing 🍿
        </p>

        <h2 id="countdown"
            style="color:#f87171;
                   font-size:42px;
                   margin:10px 0;
                   text-shadow:0 0 10px #f87171;">
            -30
        </h2>

        <button onclick="stayActive()"
                class="btn btn-success mt-2">
            ▶ Continue Watching
        </button>

    </div>
</div>

<!-- ================= NAVBAR ================= -->
<header>
<nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
<div class="container-fluid">

    <a class="navbar-brand" asp-controller="Home" asp-action="Index">AmarShowsBook</a>

    <div class="d-flex align-items-center ms-auto">

        @if (Context.Session.GetString("UserEmail") != null)
        {
            <!-- USER INFO -->
            <div class="text-end me-3">
                <div id="liveDateTime" style="font-size:12px;"></div>
                <div style="font-weight:bold;">
                    @Context.Session.GetString("UserEmail")
                </div>
            </div>

            <!-- PROFILE IMAGE -->
            <img src="@(!string.IsNullOrEmpty(Context.Session.GetString("ProfileImage")) 
    ? Context.Session.GetString("ProfileImage") 
    : "/uploads/default.png")"
     style="width:40px;height:40px;border-radius:50%;" />
     
            <!-- PROFILE BUTTON -->
            <a class="btn btn-warning me-2" href="/Profile/Index">Profile</a>

            <!-- LOGOUT -->
            <a class="btn btn-danger"
               href="/Auth/Logout"
               onclick="return confirmLogout()">Logout</a>
        }

    </div>

</div>
</nav>
</header>

<!-- ================= BODY ================= -->
<div class="container mt-5">
    @RenderBody()
</div>

<!-- ================= FOOTER ================= -->
<footer class="border-top footer text-muted">
<div class="container">
    &copy; 2026 - AmarShowsBook
</div>
</footer>

<!-- ================= SCRIPTS ================= -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
function togglePassword(fieldId) {
    var input = document.getElementById(fieldId);
    input.type = input.type === "password" ? "text" : "password";
}
</script>

<!-- ✅ DATE + TIME -->
<script>
function updateDateTime() {
    let now = new Date();

    let date = now.toLocaleDateString('en-IN', {
        weekday: 'long',
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });

    let time = now.toLocaleTimeString();

    document.getElementById("liveDateTime").innerHTML =
        date + " | " + time;
}
setInterval(updateDateTime, 1000);
updateDateTime();
</script>

<!-- LOGOUT CONFIRM -->
<script>
function confirmLogout() {
    return confirm("🎬 Are you sure you want to exit the show?");
}
</script>

<script>

document.addEventListener("DOMContentLoaded", function () {

    let inactivityTimer;
    let countdownTimer;
    let timeLeft = 30;
    let popupVisible = false;

    const INACTIVITY_TIME = 3 * 60 * 1000; // ✅ 3 minutes (change if needed)

    const cinemaMessages = [
        "🍿 Audience gone missing...",
        "🎥 Projector waiting for you...",
        "🎬 Interval chal raha hai...",
        "📽 Scene ruk gaya hai boss...",
        "🎞 Reel freeze ho gaya...",
        "🛑 Show paused... hero kidhar hai?"
    ];

    function resetTimer() {
        clearTimeout(inactivityTimer);

        if (popupVisible) {
            hidePopup();
        }

        inactivityTimer = setTimeout(showSessionPopup, INACTIVITY_TIME);
    }

    function showSessionPopup() {
        popupVisible = true;

        let popup = document.getElementById("sessionPopup");
        let text = document.getElementById("cinemaText");

        if (!popup || !text) return; // ✅ safety

        popup.style.display = "block";

        // random message
        text.innerText = cinemaMessages[Math.floor(Math.random() * cinemaMessages.length)];

        timeLeft = 30;
        updateCountdown();

        clearInterval(countdownTimer);

        countdownTimer = setInterval(() => {
            timeLeft--;
            updateCountdown();

            if (timeLeft <= 0) {
                clearInterval(countdownTimer);
                autoLogout();
            }

        }, 1000);
    }

    function updateCountdown() {
        let el = document.getElementById("countdown");
        if (!el) return;

        el.innerText = "-" + timeLeft;

        // subtle animation
        el.style.transform = "scale(1.1)";
        setTimeout(() => {
            el.style.transform = "scale(1)";
        }, 150);
    }

    function hidePopup() {
        popupVisible = false;

        let popup = document.getElementById("sessionPopup");
        if (popup) popup.style.display = "none";

        clearInterval(countdownTimer);
    }

    window.stayActive = function () {
        hidePopup();
        resetTimer();
    };

    function autoLogout() {
        window.location.href = "/Auth/Logout";
    }

    // USER ACTIVITY TRACK
    ["click","mousemove","keypress","scroll","touchstart"].forEach(event => {
        document.addEventListener(event, resetTimer);
    });

    // START
    resetTimer();

});

</script>@RenderSection("Scripts", required: false)

<script>
function showPopup(message) {
    let popup = document.getElementById("customPopup");

    popup.innerText = message;
    popup.style.display = "block";

    setTimeout(() => {
        popup.style.display = "none";
    }, 2500);
}
</script>
</body>
</html>
