@model ErrorViewModel
@{
    ViewData["Title"] = "Technical Pause";
}

<div class="card p-4 mx-auto text-center" style="max-width: 560px; border-radius: 8px;">
    <h1>Technical Pause</h1>
    <p class="text-muted">The scene could not be completed. Please go back and try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }

    <a href="/Home/Index" class="btn btn-primary">Back To showTime</a>
</div>
