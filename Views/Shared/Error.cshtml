@model ErrorViewModel
@{
    @* Previous wording: "Technical Pause" *@
    ViewData["Title"] = "Application Error";
}

<div class="card p-4 mx-auto text-center" style="max-width: 560px; border-radius: 8px;">
    @* Previous wording: "Technical Pause" *@
    <h1>Application Error</h1>
    @* Previous wording: "The scene could not be completed. Please go back and try again." *@
    <p class="text-muted">The request could not be completed. Please go back and try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }

    <a href="/Home/ShowTime" class="btn btn-primary">Back To showTime</a>
</div>
