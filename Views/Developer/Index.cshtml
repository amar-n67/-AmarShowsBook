@model AmarShowsBook.Models.ViewModels.DeveloperVM

@{
    ViewData["Title"]="Developer Profile";
    var canEdit = ViewBag.CanEditDeveloperProfile as bool? ?? false;
    var profileImage = string.IsNullOrWhiteSpace(Model.ProfileImage)
        ? "/images/default-user.png"
        : Model.ProfileImage;
    var roleLabel = canEdit ? "Developer editor access" : "Profile viewer access";
    var defaultSkills = "ASP.NET Core MVC, Entity Framework Core, PostgreSQL, Razor Views, Bootstrap, JavaScript, RBAC, Session Authentication, Payment Flow, QR Ticketing";
    var defaultTechnologies = ".NET 10, C#, Npgsql, PostgreSQL Views, MVC Controllers, Razor, Bootstrap, jQuery, HTML5, CSS3, Docker, Render Deployment";
    var skillsText = string.IsNullOrWhiteSpace(Model.Skills) ? defaultSkills : Model.Skills;
    var technologiesText = string.IsNullOrWhiteSpace(Model.Technologies) ? defaultTechnologies : Model.Technologies;
    var skillList = skillsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var technologyList = technologiesText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var supportPhone = string.IsNullOrWhiteSpace(Model.SupportPhone) ? "+91 9651698863" : Model.SupportPhone.Trim();
    var supportWhatsAppNumber = string.IsNullOrWhiteSpace(Model.SupportWhatsAppPhone) ? supportPhone : Model.SupportWhatsAppPhone.Trim();
    var developerWhatsAppNumber = string.IsNullOrWhiteSpace(Model.DeveloperWhatsAppPhone) ? supportPhone : Model.DeveloperWhatsAppPhone.Trim();
    var supportEmail = string.IsNullOrWhiteSpace(Model.SupportEmail) ? "support@showtime.com" : Model.SupportEmail.Trim();
    var developerEmail = string.IsNullOrWhiteSpace(Model.DeveloperEmail) ? supportEmail : Model.DeveloperEmail.Trim();
    var supportDialPhone = supportPhone.Replace(" ", "").Replace("-", "");
    var supportWhatsAppPhone = supportWhatsAppNumber.Replace(" ", "").Replace("-", "").Replace("+", "");
    var developerWhatsAppPhone = developerWhatsAppNumber.Replace(" ", "").Replace("-", "").Replace("+", "");
    var currentSupportUser = Context.Session.GetString("UserName") ?? Context.Session.GetString("UserEmail") ?? "User";
    Func<string?, string, string> renderDraft = (template, fallback) =>
        (string.IsNullOrWhiteSpace(template) ? fallback : template.Trim()).Replace("{user}", currentSupportUser);
    var topWhatsAppText = renderDraft(
        Model.TopWhatsAppText,
        "Hi showTime Team, I'm {user}. I visited showTime and would like to connect with you.");
    var topWhatsAppUrl = $"https://wa.me/{developerWhatsAppPhone}?text={Uri.EscapeDataString(topWhatsAppText)}";
    var supportWhatsAppText = renderDraft(
        Model.SupportWhatsAppText,
        "Hi showTime Team, I'm {user}. I need support. Please help me with my request.");
    var supportWhatsApp = $"https://wa.me/{supportWhatsAppPhone}?text={Uri.EscapeDataString(supportWhatsAppText)}";
    var supportEmailSubject = string.IsNullOrWhiteSpace(Model.SupportEmailSubject)
        ? "showTime Support Request"
        : Model.SupportEmailSubject.Trim();
    var supportEmailText = renderDraft(
        Model.SupportEmailText,
        "Hi showTime Team, I'm {user}. I need support. Please help me with my request.");
    var supportEmailUrl = $"mailto:{supportEmail}?subject={Uri.EscapeDataString(supportEmailSubject)}&body={Uri.EscapeDataString(supportEmailText)}";
    var developerEmailSubject = string.IsNullOrWhiteSpace(Model.DeveloperEmailSubject)
        ? "showTime Developer Contact"
        : Model.DeveloperEmailSubject.Trim();
    var developerEmailText = renderDraft(
        Model.DeveloperEmailText,
        "Hi showTime Team, I'm {user}. I would like to connect with the developer.");
    var developerEmailUrl = $"mailto:{developerEmail}?subject={Uri.EscapeDataString(developerEmailSubject)}&body={Uri.EscapeDataString(developerEmailText)}";
    var applicationSections = new[]
    {
        new { Title = "Application Stack", Body = "ASP.NET Core MVC application using Razor views, EF Core, Npgsql, PostgreSQL tables/views, Bootstrap styling, JavaScript interactions, QR ticket generation, wallet, transactions, refunds, and admin dashboards." },
        new { Title = "Role And Access", Body = "Session authorization with RBAC roles, role-permission mapping, application menus, module actions, developer bypass settings, and page-level authorization filters." },
        new { Title = "Booking Domain", Body = "Movies, standup shows, live streams, schedules, venues, screens, seats, booking drafts, payment sessions, confirmed bookings, tickets, transactions, refunds, coupons, and wallet usage." },
        new { Title = "Operations", Body = "Admin tools for users, roles, permissions, bookings, transactions, coupon usage, wallets, refunds, notifications, activity logs, application versions, and show management." }
    };
    var socials = new[]
    {
        new { Label = "GitHub", Url = Model.GitHubUrl },
        new { Label = "LinkedIn", Url = Model.LinkedInUrl },
        new { Label = "Twitter", Url = Model.TwitterUrl },
        new { Label = "Instagram", Url = Model.InstagramUrl },
        new { Label = "Facebook", Url = Model.FacebookUrl },
        new { Label = "YouTube", Url = Model.YoutubeUrl },
        new { Label = "Website", Url = Model.WebsiteUrl },
        new { Label = "Email", Url = (string?)developerEmailUrl },
        new { Label = "WhatsApp", Url = (string?)topWhatsAppUrl }
    };
    var supportContacts = new[]
    {
        new { Label = "Call Us", Url = $"tel:{supportDialPhone}", Tone = "phone" },
        new { Label = "Write Us", Url = supportEmailUrl, Tone = "mail" },
        new { Label = "Developer WhatsApp", Url = topWhatsAppUrl, Tone = "whatsapp" },
        new { Label = "WhatsApp Us", Url = supportWhatsApp, Tone = "whatsapp" }
    };
}

<section class="developer-page">

@if(TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}
@if(TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="developer-hero">

<div class="profile-left">

<img class="profile-image"
id="developerProfilePreview"
src="@profileImage"
alt="@Model.FullName profile image" />

<span class="developer-kicker">DEVELOPER PROFILE</span>

<h1>@Model.FullName</h1>

<p class="bio">

@(Model.Bio ?? "Creative Full Stack Developer")

</p>

<div class="experience-badge">

⭐ @Model.ExperienceYears Years Experience

</div>

</div>


<div class="profile-right">

<div class="social-grid">

@foreach (var social in socials)
{
    var hasUrl = !string.IsNullOrWhiteSpace(social.Url);
    if (hasUrl)
    {
        <a href="@social.Url" target="_blank" rel="noopener noreferrer">
            @if (social.Label == "Email")
            {
                <svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            }
            else if (social.Label == "WhatsApp")
            {
                <svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.4-4.8A8.5 8.5 0 1 1 7.8 19L3 21Z"/><path d="M9.2 8.8c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.8 1.8c.1.3.1.5-.1.7l-.4.5c-.1.1-.2.3 0 .5.4.8 1.1 1.5 2.1 2 .3.1.4.1.6-.1l.7-.8c.2-.2.4-.2.7-.1l1.8.9c.3.1.4.3.4.5 0 .6-.4 1.4-.9 1.7-.5.3-1.8.6-4.1-.5-3.4-1.6-5.5-4.7-5.7-6.1-.2-1 .3-1.6.7-1.9.2-.2.5-.3.8-.3Z"/></svg>
            }
            <span>@social.Label</span>
        </a>
    }
    else
    {
        <span class="social-link-disabled" title="@social.Label URL is not added yet">
            @social.Label
        </span>
    }
}

</div>

</div>

</div>

<nav class="developer-command-bar" aria-label="Developer profile menu">
<div class="developer-menu-title">
<span>@roleLabel</span>
<strong>Application engineering profile</strong>
</div>

<div class="developer-menu-links">
<a href="#developerOverview" data-developer-target="developerOverview">Overview</a>
<a href="#developerSkills" data-developer-target="developerSkills">Skills</a>
<a href="#developerTech" data-developer-target="developerTech">Technologies</a>
<a href="#developerApplication" data-developer-target="developerApplication">Application</a>
<a href="#developerSupport" class="developer-menu-support" data-developer-target="developerSupport">Help</a>
</div>

<div class="developer-menu-actions">
@if(canEdit)
{
<button type="button" class="developer-edit-toggle" onclick="toggleDeveloperEditor()">Edit Profile</button>
}
else
{
<span class="developer-readonly-pill">Read only</span>
}
</div>
</nav>



<div class="developer-grid" id="developerOverview">

<div class="dev-card">

<h2>📧 Basic Information</h2>

<div class="detail-item">
<strong>Email</strong>
<span>@Model.Email</span>
</div>

<div class="detail-item">
<strong>Phone</strong>
<span>@Model.Phone</span>
</div>

<div class="detail-item">
<strong>Address</strong>
<span>@Model.Address</span>
</div>

</div>



<div class="dev-card">

<h2 id="developerSkills">🛠 Skills</h2>

<div class="dev-chip-list">
@foreach(var skill in skillList)
{
    <span>@skill</span>
}
</div>

</div>


<div class="dev-card">

<h2>🎓 Education</h2>

<p>

@Model.Education

</p>

</div>



<div class="dev-card">

<h2>🚀 Projects</h2>

<p>

@Model.Projects

</p>

</div>



<div class="dev-card">

<h2 id="developerTech">⚡ Technologies</h2>

<div class="dev-chip-list tech">
@foreach(var technology in technologyList)
{
    <span>@technology</span>
}
</div>

</div>



<div class="dev-card">

<h2>🏆 Achievements</h2>

<p>

@Model.Achievements

</p>

</div>

</div>

<div class="developer-grid developer-application-grid" id="developerApplication">
@foreach(var section in applicationSections)
{
<div class="dev-card">
<h2>@(section.Title)</h2>
<p>@(section.Body)</p>
</div>
}
</div>

<div class="developer-support-grid" id="developerSupport" aria-label="Developer and application support options">
	@foreach(var contact in supportContacts)
	{
	    <a class="developer-support-card @contact.Tone"
	       href="@contact.Url"
	       target="@(contact.Tone == "whatsapp" ? "_blank" : null)"
	       rel="@(contact.Tone == "whatsapp" ? "noopener" : null)">
        @if (contact.Tone == "phone")
        {
            <svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>
        }
        else if (contact.Tone == "mail")
        {
            <svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        }
        else
        {
            <svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.4-4.8A8.5 8.5 0 1 1 7.8 19L3 21Z"/><path d="M9.2 8.8c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.8 1.8c.1.3.1.5-.1.7l-.4.5c-.1.1-.2.3 0 .5.4.8 1.1 1.5 2.1 2 .3.1.4.1.6-.1l.7-.8c.2-.2.4-.2.7-.1l1.8.9c.3.1.4.3.4.5 0 .6-.4 1.4-.9 1.7-.5.3-1.8.6-4.1-.5-3.4-1.6-5.5-4.7-5.7-6.1-.2-1 .3-1.6.7-1.9.2-.2.5-.3.8-.3Z"/></svg>
        }
        <span>@contact.Label</span>
    </a>
}
</div>


@if(canEdit)
{
<div class="developer-edit-panel" id="developerEditPanel" hidden>
<div class="developer-edit-header">
<h2>Edit Developer Profile</h2>
<p>Changes are saved directly to the database profile record.</p>
</div>

<form asp-action="Update" method="post" enctype="multipart/form-data" class="developer-edit-form">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="DeveloperId" />

<div class="developer-photo-editor">
<img src="@profileImage" id="developerEditPreview" alt="Developer profile preview" />
<div>
<label class="developer-upload-btn" for="profilePhoto">Upload / Change Photo</label>
<input id="profilePhoto" name="profilePhoto" type="file" accept="image/*" onchange="previewDeveloperPhoto(this)" />
<p>Choose a JPG, PNG, WEBP, or GIF. The poster updates when you save.</p>
</div>
</div>

<div class="dev-form-grid">
<label>
<span>Full Name</span>
<input asp-for="FullName" class="form-control" />
</label>
<label>
<span>Email</span>
<input asp-for="Email" class="form-control" />
</label>
<label>
<span>Phone</span>
<input asp-for="Phone" class="form-control" />
</label>
<label>
<span>Experience Years</span>
<input asp-for="ExperienceYears" class="form-control" type="number" min="0" />
</label>
<label>
<span>Profile Image URL</span>
<input asp-for="ProfileImage" class="form-control" id="ProfileImage" placeholder="/uploads/profile.png or https://..." />
</label>
<label>
<span>Resume URL</span>
<input asp-for="ResumeUrl" class="form-control" />
</label>
<label class="dev-form-wide">
<span>Bio</span>
<textarea asp-for="Bio" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Address</span>
<textarea asp-for="Address" class="form-control" rows="2"></textarea>
</label>
<label class="dev-form-wide">
<span>Skills</span>
<textarea asp-for="Skills" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Education</span>
<textarea asp-for="Education" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Projects</span>
<textarea asp-for="Projects" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Technologies</span>
<textarea asp-for="Technologies" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Achievements</span>
<textarea asp-for="Achievements" class="form-control" rows="3"></textarea>
</label>
<label>
<span>GitHub URL</span>
<input asp-for="GitHubUrl" class="form-control" />
</label>
<label>
<span>LinkedIn URL</span>
<input asp-for="LinkedInUrl" class="form-control" />
</label>
<label>
<span>Twitter URL</span>
<input asp-for="TwitterUrl" class="form-control" />
</label>
<label>
<span>Instagram URL</span>
<input asp-for="InstagramUrl" class="form-control" />
</label>
<label>
<span>Facebook URL</span>
<input asp-for="FacebookUrl" class="form-control" />
</label>
<label>
<span>YouTube URL</span>
<input asp-for="YoutubeUrl" class="form-control" />
</label>
<label class="dev-form-wide">
<span>Website URL</span>
<input asp-for="WebsiteUrl" class="form-control" />
</label>
	<label class="dev-form-wide">
	<span>Developer WhatsApp Number</span>
	<input asp-for="DeveloperWhatsAppPhone" class="form-control" id="DeveloperWhatsAppPhone" placeholder="+91 9651698863" />
	</label>
	<label>
	<span>Developer Email</span>
	<input asp-for="DeveloperEmail" class="form-control" placeholder="developer@example.com" />
	</label>
	<label>
	<span>Developer Email Subject</span>
	<input asp-for="DeveloperEmailSubject" class="form-control" placeholder="showTime Developer Contact" />
	</label>
	<label class="dev-form-wide">
	<span>Developer Email Body</span>
	<textarea asp-for="DeveloperEmailText" class="form-control" rows="2" placeholder="Hi showTime Team, I'm {user}. I would like to connect with the developer."></textarea>
	</label>
	<input type="hidden" asp-for="SupportPhone" id="SupportPhone" />
	<input type="hidden" asp-for="SupportWhatsAppPhone" id="SupportWhatsAppPhone" />
	<input type="hidden" asp-for="SupportEmail" />
	<input type="hidden" asp-for="IsSupportWhatsAppSameAsPhone" />
	<input type="hidden" name="IsDeveloperWhatsAppSameAsPhone" value="false" />
	<input type="hidden" asp-for="TopWhatsAppText" />
	<input type="hidden" asp-for="SupportWhatsAppText" />
	<input type="hidden" asp-for="SupportEmailSubject" />
	<input type="hidden" asp-for="SupportEmailText" />
	</div>

<div class="developer-edit-actions">
<button type="button" class="back-btn developer-hide-editor-btn" onclick="requestDeveloperEditorHide()">Hide Editor</button>
<button type="submit" class="resume-btn">Update Profile</button>
</div>
</form>
</div>
}



<div class="resume-section">

@if(!string.IsNullOrEmpty(Model.ResumeUrl))
{
<a href="@Model.ResumeUrl"
target="_blank"
class="resume-btn">

📄 Download Resume

</a>
}

<a href="/Home/ShowTime"
class="back-btn">

⬅ Back

</a>

</div>

</section>



<style>

.developer-page{

padding:clamp(16px, 3vw, 30px);
min-height:100vh;

background:
var(--app-bg);

color:var(--app-text);
}


.developer-hero{

display:flex;
flex-wrap:wrap;
justify-content:space-between;
align-items:center;
gap:20px;

min-height:130px;
padding:24px;

border-radius:8px;

background:
repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px),
linear-gradient(135deg, rgba(255,242,199,0.94), rgba(245,178,196,0.86), rgba(146,229,221,0.86));
border:0;
color:#231f20;
box-shadow:0 22px 64px rgba(35,31,32,0.22);

margin-bottom:30px;
}


.profile-left{

display:grid;
grid-template-columns:auto minmax(0, 1fr);
column-gap:18px;
align-items:center;
text-align:left;
width:min(520px, 100%);
}


.profile-image{

width:180px;
height:180px;
grid-row:1 / span 4;

border-radius:50%;

object-fit:cover;

border:6px solid var(--app-primary);

box-shadow:
0 0 30px
color-mix(in srgb, var(--app-primary) 46%, transparent);
}


.profile-left h1{

margin:8px 0;

color:#231f20;
font-size:clamp(2rem, 5vw, 3.8rem);
font-weight:900;
line-height:.92;
}

.developer-kicker{
display:block;
align-self:end;
text-transform:uppercase;
font-size:.74rem;
font-weight:900;
letter-spacing:.08em;
color:#34303a;
}

.bio{

opacity:.8;
margin:0;
color:#34303a;
}


.experience-badge{

margin-top:4px;

padding:8px 12px;

background:rgba(255,255,255,.38);
border:1px dashed rgba(35,31,32,.44);

border-radius:8px;

font-weight:900;
color:#231f20;
}



.profile-right{

flex:1;
display:flex;
justify-content:center;
align-items:center;
}


.social-grid{

display:grid;

grid-template-columns:
repeat(
auto-fit,
minmax(130px,1fr)
);

gap:15px;
width:100%;
}


.social-grid a{

padding:15px;

border-radius:15px;

text-decoration:none;

color:var(--app-card-text);

background:color-mix(in srgb, var(--app-card) 78%, var(--app-primary));
border:1px solid var(--app-input-border);

text-align:center;

font-weight:700;

transition:.4s;
display:inline-flex;
align-items:center;
justify-content:center;
gap:8px;
}

.social-grid a:hover{

transform:translateY(-5px);

background:var(--app-primary);
color:#fff;
}

.social-link-disabled{
padding:15px;
border-radius:15px;
color:var(--app-muted);
background:var(--app-input-disabled);
border:1px dashed var(--app-input-border);
text-align:center;
font-weight:800;
cursor:not-allowed;
}



.developer-grid{

display:grid;

grid-template-columns:
repeat(
auto-fit,
minmax(260px,1fr)
);

gap:20px;
}

.developer-command-bar{
display:flex;
align-items:center;
justify-content:space-between;
gap:16px;
margin:-8px 0 24px;
padding:12px;
border:1px solid color-mix(in srgb, var(--app-primary) 28%, var(--app-input-border));
border-radius:8px;
background:
linear-gradient(135deg,
color-mix(in srgb, var(--app-card) 88%, #ffffff),
color-mix(in srgb, var(--app-primary) 12%, var(--app-card)));
color:var(--app-card-text);
box-shadow:0 18px 48px rgba(15,23,42,.14);
position:sticky;
top:12px;
z-index:20;
backdrop-filter:blur(18px);
}

.developer-menu-title{
display:grid;
gap:3px;
min-width:220px;
padding:4px 6px;
}

.developer-menu-title span{
display:block;
color:var(--app-muted);
font-size:.78rem;
font-weight:850;
text-transform:uppercase;
letter-spacing:.08em;
}

.developer-menu-title strong{
display:block;
font-size:1rem;
font-weight:900;
}

.developer-menu-links,
.developer-menu-actions{
display:flex;
align-items:center;
gap:8px;
flex-wrap:wrap;
}

.developer-menu-links{
justify-content:center;
flex:1;
}

.developer-menu-actions{
justify-content:flex-end;
min-width:130px;
}

.developer-menu-links a,
.developer-edit-toggle,
.developer-readonly-pill{
min-height:42px;
display:inline-flex;
align-items:center;
justify-content:center;
padding:0 15px;
border-radius:999px;
border:1px solid color-mix(in srgb, var(--app-primary) 22%, var(--app-input-border));
background:color-mix(in srgb, var(--app-card) 84%, #ffffff);
color:var(--app-card-text);
text-decoration:none;
font-weight:900;
font-size:.9rem;
line-height:1;
white-space:nowrap;
box-shadow:0 8px 20px rgba(15,23,42,.08);
transition:transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease, border-color .2s ease;
}

.developer-menu-links a:hover,
.developer-menu-links a:focus-visible,
.developer-menu-links a.developer-menu-active,
.developer-edit-toggle:hover,
.developer-edit-toggle:focus-visible{
transform:translateY(-2px);
border-color:color-mix(in srgb, var(--app-primary) 62%, var(--app-input-border));
background:var(--app-primary);
color:#fff;
box-shadow:0 14px 28px color-mix(in srgb, var(--app-primary) 28%, transparent);
outline:none;
}

.developer-edit-toggle,
.developer-upload-btn,
.resume-btn,
.back-btn{
cursor:pointer;
}

.developer-menu-links a.developer-menu-support.developer-menu-active:not(:hover):not(:focus-visible){
transform:none;
border-color:color-mix(in srgb, var(--app-primary) 22%, var(--app-input-border));
background:color-mix(in srgb, var(--app-card) 84%, #ffffff);
color:var(--app-card-text);
box-shadow:0 8px 20px rgba(15,23,42,.08);
}

.developer-readonly-pill{
background:var(--app-input-disabled);
color:var(--app-muted);
box-shadow:none;
}


.dev-card{

padding:25px;

