overflow:hidden;
border-color:color-mix(in srgb, var(--app-accent-strong) 18%, var(--developer-page-line));
background:
radial-gradient(circle at var(--motion-x) var(--motion-y), color-mix(in srgb, var(--app-accent-strong) 9%, transparent), transparent 32%),
linear-gradient(180deg, color-mix(in srgb, var(--app-card) 94%, transparent), color-mix(in srgb, var(--app-input) 52%, transparent)),
var(--app-card);
box-shadow:0 18px 42px color-mix(in srgb, var(--app-text) 11%, transparent);
transform:perspective(900px) rotateX(var(--motion-tilt-x)) rotateY(var(--motion-tilt-y)) translateY(0);
