@model AmarShowsBook.Models.ViewModels.DeveloperVM

@{
    ViewData["Title"]="Developer Profile";
    var canEdit = ViewBag.CanEditDeveloperProfile as bool? ?? false;
    var profileImage = string.IsNullOrWhiteSpace(Model.ProfileImage)
        ? "/images/default-user.png"
        : Model.ProfileImage;
    var roleLabel = canEdit ? "Developer editor access" : "Profile viewer access";
    var defaultSkills = "ASP.NET Core MVC, Entity Framework Core, PostgreSQL, Razor Views, Bootstrap, JavaScript, RBAC, Session Authentication, Payment Flow, QR Ticketing";
    var defaultTechnologies = ".NET 10, C#, Npgsql, PostgreSQL Views, MVC Controllers, Razor, Bootstrap, jQuery, HTML5, CSS3, Docker, Render Deployment";
    var skillsText = string.IsNullOrWhiteSpace(Model.Skills) ? defaultSkills : Model.Skills;
    var technologiesText = string.IsNullOrWhiteSpace(Model.Technologies) ? defaultTechnologies : Model.Technologies;
    var skillList = skillsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var technologyList = technologiesText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var supportPhone = string.IsNullOrWhiteSpace(Model.SupportPhone) ? "+91 9651698863" : Model.SupportPhone.Trim();
    var supportWhatsAppNumber = string.IsNullOrWhiteSpace(Model.SupportWhatsAppPhone) ? supportPhone : Model.SupportWhatsAppPhone.Trim();
    var developerWhatsAppNumber = string.IsNullOrWhiteSpace(Model.DeveloperWhatsAppPhone) ? supportPhone : Model.DeveloperWhatsAppPhone.Trim();
    var supportEmail = string.IsNullOrWhiteSpace(Model.SupportEmail) ? "support@showtime.com" : Model.SupportEmail.Trim();
    var developerEmail = string.IsNullOrWhiteSpace(Model.DeveloperEmail) ? supportEmail : Model.DeveloperEmail.Trim();
    var supportDialPhone = supportPhone.Replace(" ", "").Replace("-", "");
    var supportWhatsAppPhone = supportWhatsAppNumber.Replace(" ", "").Replace("-", "").Replace("+", "");
    var developerWhatsAppPhone = developerWhatsAppNumber.Replace(" ", "").Replace("-", "").Replace("+", "");
    var currentSupportUser = Context.Session.GetString("UserName") ?? Context.Session.GetString("UserEmail") ?? "User";
    Func<string?, string, string> renderDraft = (template, fallback) =>
        (string.IsNullOrWhiteSpace(template) ? fallback : template.Trim()).Replace("{user}", currentSupportUser);
    var topWhatsAppText = renderDraft(
        Model.TopWhatsAppText,
        "Hi showTime Team, I'm {user}. I visited showTime and would like to connect with you.");
    var topWhatsAppUrl = $"https://wa.me/{developerWhatsAppPhone}?text={Uri.EscapeDataString(topWhatsAppText)}";
    var supportWhatsAppText = renderDraft(
        Model.SupportWhatsAppText,
        "Hi showTime Team, I'm {user}. I need support. Please help me with my request.");
    var supportWhatsApp = $"https://wa.me/{supportWhatsAppPhone}?text={Uri.EscapeDataString(supportWhatsAppText)}";
    var supportEmailSubject = string.IsNullOrWhiteSpace(Model.SupportEmailSubject)
        ? "showTime Support Request"
        : Model.SupportEmailSubject.Trim();
    var supportEmailText = renderDraft(
        Model.SupportEmailText,
        "Hi showTime Team, I'm {user}. I need support. Please help me with my request.");
    var supportEmailUrl = $"mailto:{supportEmail}?subject={Uri.EscapeDataString(supportEmailSubject)}&body={Uri.EscapeDataString(supportEmailText)}";
    var developerEmailSubject = string.IsNullOrWhiteSpace(Model.DeveloperEmailSubject)
        ? "showTime Developer Contact"
        : Model.DeveloperEmailSubject.Trim();
    var developerEmailText = renderDraft(
        Model.DeveloperEmailText,
        "Hi showTime Team, I'm {user}. I would like to connect with the developer.");
    var developerEmailUrl = $"mailto:{developerEmail}?subject={Uri.EscapeDataString(developerEmailSubject)}&body={Uri.EscapeDataString(developerEmailText)}";
    var applicationSections = new[]
    {
        new { Title = "Application Stack", Body = "ASP.NET Core MVC application using Razor views, EF Core, Npgsql, PostgreSQL tables/views, Bootstrap styling, JavaScript interactions, QR ticket generation, wallet, transactions, refunds, and admin dashboards." },
        new { Title = "Role And Access", Body = "Session authorization with RBAC roles, role-permission mapping, application menus, module actions, developer bypass settings, and page-level authorization filters." },
        new { Title = "Booking Domain", Body = "Movies, standup shows, live streams, schedules, venues, screens, seats, booking drafts, payment sessions, confirmed bookings, tickets, transactions, refunds, coupons, and wallet usage." },
        new { Title = "Operations", Body = "Admin tools for users, roles, permissions, bookings, transactions, coupon usage, wallets, refunds, notifications, activity logs, application versions, and show management." }
    };
    var socials = new[]
    {
        new { Label = "GitHub", Url = Model.GitHubUrl },
        new { Label = "LinkedIn", Url = Model.LinkedInUrl },
        new { Label = "Twitter", Url = Model.TwitterUrl },
        new { Label = "Instagram", Url = Model.InstagramUrl },
        new { Label = "Facebook", Url = Model.FacebookUrl },
        new { Label = "YouTube", Url = Model.YoutubeUrl },
        new { Label = "Website", Url = Model.WebsiteUrl },
        new { Label = "Email", Url = (string?)developerEmailUrl },
        new { Label = "WhatsApp", Url = (string?)topWhatsAppUrl }
    };
    var supportContacts = new[]
    {
        new { Label = "Call Us", Url = $"tel:{supportDialPhone}", Tone = "phone" },
        new { Label = "Write Us", Url = supportEmailUrl, Tone = "mail" },
        new { Label = "WhatsApp Us", Url = supportWhatsApp, Tone = "whatsapp" }
    };
    var socialIcon = (string label) => label switch
    {
        "GitHub" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><path d='M12 .7A11.3 11.3 0 0 0 8.4 22.7c.6.1.8-.3.8-.6v-2.1c-3.4.7-4.1-1.5-4.1-1.5-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.3 11.3 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.3 2.9.1 3.2.8.9 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.3 11.3 0 0 0 12 .7Z'/></svg>",
        "LinkedIn" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><path d='M20.5 3h-17A.5.5 0 0 0 3 3.5v17c0 .3.2.5.5.5h17c.3 0 .5-.2.5-.5v-17a.5.5 0 0 0-.5-.5ZM8.4 18.2H5.7V9.7h2.7v8.5ZM7.1 8.6a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2Zm11.1 9.6h-2.7V14c0-1 0-2.3-1.4-2.3s-1.6 1.1-1.6 2.2v4.3H9.8V9.7h2.6v1.2h.1c.4-.7 1.3-1.4 2.6-1.4 2.8 0 3.3 1.8 3.3 4.2v4.5Z'/></svg>",
        "Twitter" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><path d='M14.4 10.6 22.1 2h-1.8l-6.7 7.4L8.4 2H2.2l8.1 11.5L2.2 22h1.8l7-7.7 5.6 7.7h6.2l-8.4-11.4Zm-2.5 2.8-.8-1.1L4.6 3.3h2.9l5.1 7.1.8 1.1 6.9 9.4h-2.9l-5.5-7.5Z'/></svg>",
        "Instagram" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><defs><linearGradient id='instagramProfileGradient' x1='3' x2='21' y1='21' y2='3' gradientUnits='userSpaceOnUse'><stop stop-color='#feda75'/><stop offset='.32' stop-color='#fa7e1e'/><stop offset='.62' stop-color='#d62976'/><stop offset='1' stop-color='#4f5bd5'/></linearGradient></defs><rect width='17' height='17' x='3.5' y='3.5' rx='5' fill='none' stroke='url(#instagramProfileGradient)' stroke-width='2.2'/><circle cx='12' cy='12' r='3.7' fill='none' stroke='url(#instagramProfileGradient)' stroke-width='2.2'/><circle cx='17.2' cy='6.8' r='1.2' fill='url(#instagramProfileGradient)'/></svg>",
        "Facebook" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><path d='M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.5V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z'/></svg>",
        "YouTube" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><path d='M21.6 7.2s-.2-1.5-.8-2.1c-.8-.8-1.7-.8-2.1-.9C15.8 4 12 4 12 4s-3.8 0-6.7.2c-.4.1-1.3.1-2.1.9-.6.6-.8 2.1-.8 2.1S2.2 9 2.2 10.8v1.7c0 1.8.2 3.6.2 3.6s.2 1.5.8 2.1c.8.8 1.9.8 2.4.9 1.7.2 6.4.2 6.4.2s3.8 0 6.7-.3c.4 0 1.3-.1 2.1-.8.6-.6.8-2.1.8-2.1s.2-1.8.2-3.6v-1.7c0-1.8-.2-3.6-.2-3.6ZM10.2 14.9V8.7l5.9 3.1-5.9 3.1Z'/></svg>",
        "Website" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='12' r='9' fill='none' stroke='currentColor' stroke-width='2'/><path d='M3 12h18M12 3c2.4 2.4 3.6 5.4 3.6 9S14.4 18.6 12 21c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3Z' fill='none' stroke='currentColor' stroke-width='2'/></svg>",
        "Email" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><path fill='#4285f4' d='M3 6.5 12 13l9-6.5V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6.5Z'/><path fill='#34a853' d='M3 6.5 12 13l-9 6.5V6.5Z'/><path fill='#fbbc04' d='M21 6.5 12 13l9 6.5V6.5Z'/><path fill='#ea4335' d='M5 4h14a2 2 0 0 1 2 2.5L12 13 3 6.5A2 2 0 0 1 5 4Z'/></svg>",
        "WhatsApp" => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><path d='M12 2.2a9.7 9.7 0 0 0-8.4 14.6L2.3 22l5.3-1.4A9.7 9.7 0 1 0 12 2.2Zm0 17.7a8 8 0 0 1-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8 8 0 1 1 12 19.9Zm4.5-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1-1.5-.7-2.6-1.6-3.4-3.1-.1-.2 0-.4.1-.5l.4-.5c.1-.1.1-.3.2-.4.1-.1 0-.3 0-.4L9.6 8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-1 1-1 2.4 0 1.4 1 2.7 1.2 2.9.1.2 2 3.2 5 4.3 1.9.8 2.7.7 3.6.6.6-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.2-.2-.2-.5-.4Z'/></svg>",
        _ => "<svg class='social-app-logo' viewBox='0 0 24 24' aria-hidden='true'><circle cx='12' cy='12' r='9' fill='none' stroke='currentColor' stroke-width='2'/><path d='M3 12h18M12 3c2.4 2.4 3.6 5.4 3.6 9S14.4 18.6 12 21c-2.4-2.4-3.6-5.4-3.6-9S9.6 5.4 12 3Z' fill='none' stroke='currentColor' stroke-width='2'/></svg>"
    };
}

<section class="developer-page">

@if(TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}
@if(TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="developer-hero">

<div class="profile-left">

<img class="profile-image"
id="developerProfilePreview"
src="@profileImage"
alt="@Model.FullName profile image" />

<span class="developer-kicker">DEVELOPER PROFILE</span>

<h1>@Model.FullName</h1>

<p class="bio">

@(Model.Bio ?? "Creative Full Stack Developer")

</p>

<div class="experience-badge">

⭐ @Model.ExperienceYears Years Experience

</div>

</div>


<div class="profile-right">

<div class="social-grid">

@foreach (var social in socials)
{
    var hasUrl = !string.IsNullOrWhiteSpace(social.Url);
    var socialTone = social.Label.ToLowerInvariant().Replace(" ", "-");
    if (hasUrl)
    {
        <a class="social-link social-link-@socialTone" href="@social.Url" target="_blank" rel="noopener noreferrer" aria-label="@social.Label" title="@social.Label">
            @Html.Raw(socialIcon(social.Label))
            <span class="visually-hidden">@social.Label</span>
        </a>
    }
    else
    {
        <span class="social-link-disabled social-link-@socialTone" title="@social.Label URL is not added yet" aria-label="@social.Label URL is not added yet">
            @Html.Raw(socialIcon(social.Label))
            <span class="visually-hidden">@social.Label</span>
        </span>
    }
}

</div>

</div>

</div>

<nav class="developer-command-bar" aria-label="Developer profile menu">
<div class="developer-menu-title">
<span>@roleLabel</span>
<strong>Application engineering profile</strong>
</div>

<div class="developer-menu-links">
<a href="#developerOverview" data-developer-target="developerOverview">Overview</a>
<a href="#developerSkills" data-developer-target="developerSkills">Skills</a>
<a href="#developerTech" data-developer-target="developerTech">Technologies</a>
<a href="#developerApplication" data-developer-target="developerApplication">Application</a>
<a href="#developerSupport" class="developer-menu-support" data-developer-target="developerSupport">Help</a>
</div>

<div class="developer-menu-actions">
@if(canEdit)
{
<button type="button" class="developer-edit-toggle" onclick="toggleDeveloperEditor()">Edit Profile</button>
}
else
{
<span class="developer-readonly-pill">Read only</span>
}
</div>
</nav>



<div class="developer-grid" id="developerOverview">

<div class="dev-card">

<h2>📧 Basic Information</h2>

<div class="detail-item">
<strong>Email</strong>
<span>@Model.Email</span>
</div>

<div class="detail-item">
<strong>Phone</strong>
<span>@Model.Phone</span>
</div>

<div class="detail-item">
<strong>Address</strong>
<span>@Model.Address</span>
</div>

</div>



<div class="dev-card">

<h2 id="developerSkills">🛠 Skills</h2>

<div class="dev-chip-list">
@foreach(var skill in skillList)
{
    <span>@skill</span>
}
</div>

</div>


<div class="dev-card">

<h2>🎓 Education</h2>

<p>

@Model.Education

</p>

</div>



<div class="dev-card">

<h2>🚀 Projects</h2>

<p>

@Model.Projects

</p>

</div>



<div class="dev-card">

<h2 id="developerTech">⚡ Technologies</h2>

<div class="dev-chip-list tech">
@foreach(var technology in technologyList)
{
    <span>@technology</span>
}
</div>

</div>



<div class="dev-card">

<h2>🏆 Achievements</h2>

<p>

@Model.Achievements

</p>

</div>

</div>

<div class="developer-grid developer-application-grid" id="developerApplication">
@foreach(var section in applicationSections)
{
<div class="dev-card">
<h2>@(section.Title)</h2>
<p>@(section.Body)</p>
</div>
}
</div>

<div class="developer-support-grid" id="developerSupport" aria-label="Developer and application support options">
	@foreach(var contact in supportContacts)
	{
	    <a class="developer-support-card @contact.Tone"
	       href="@contact.Url"
	       target="@(contact.Tone == "whatsapp" ? "_blank" : null)"
	       rel="@(contact.Tone == "whatsapp" ? "noopener" : null)">
        @if (contact.Tone == "phone")
        {
            <svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>
        }
        else if (contact.Tone == "mail")
        {
            <svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
        }
        else
        {
            <svg class="contact-svg-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21l1.4-4.8A8.5 8.5 0 1 1 7.8 19L3 21Z"/><path d="M9.2 8.8c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.8 1.8c.1.3.1.5-.1.7l-.4.5c-.1.1-.2.3 0 .5.4.8 1.1 1.5 2.1 2 .3.1.4.1.6-.1l.7-.8c.2-.2.4-.2.7-.1l1.8.9c.3.1.4.3.4.5 0 .6-.4 1.4-.9 1.7-.5.3-1.8.6-4.1-.5-3.4-1.6-5.5-4.7-5.7-6.1-.2-1 .3-1.6.7-1.9.2-.2.5-.3.8-.3Z"/></svg>
        }
        <span>@contact.Label</span>
    </a>
}
</div>


@if(canEdit)
{
<div class="developer-edit-panel" id="developerEditPanel" hidden>
<div class="developer-edit-header">
<h2>Edit Developer Profile</h2>
<p>Changes are saved directly to the database profile record.</p>
</div>

<form asp-action="Update" method="post" enctype="multipart/form-data" class="developer-edit-form">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="DeveloperId" />

<div class="developer-photo-editor">
<img src="@profileImage" id="developerEditPreview" alt="Developer profile preview" />
<div>
<label class="developer-upload-btn" for="profilePhoto">Upload / Change Photo</label>
<input id="profilePhoto" name="profilePhoto" type="file" accept="image/*" onchange="previewDeveloperPhoto(this)" />
<p>Choose a JPG, PNG, WEBP, or GIF. The poster updates when you save.</p>
</div>
</div>

<div class="dev-form-grid">
<label>
<span>Full Name</span>
<input asp-for="FullName" class="form-control" />
</label>
<label>
<span>Email</span>
<input asp-for="Email" class="form-control" />
</label>
<label>
<span>Phone</span>
<input asp-for="Phone" class="form-control" />
</label>
<label>
<span>Experience Years</span>
<input asp-for="ExperienceYears" class="form-control" type="number" min="0" />
</label>
<label>
<span>Profile Image URL</span>
<input asp-for="ProfileImage" class="form-control" id="ProfileImage" placeholder="/uploads/profile.png or https://..." />
</label>
<label>
<span>Resume URL</span>
<input asp-for="ResumeUrl" class="form-control" />
</label>
<label class="dev-form-wide">
<span>Bio</span>
<textarea asp-for="Bio" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Address</span>
<textarea asp-for="Address" class="form-control" rows="2"></textarea>
</label>
<label class="dev-form-wide">
<span>Skills</span>
<textarea asp-for="Skills" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Education</span>
<textarea asp-for="Education" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Projects</span>
<textarea asp-for="Projects" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Technologies</span>
<textarea asp-for="Technologies" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Achievements</span>
<textarea asp-for="Achievements" class="form-control" rows="3"></textarea>
</label>
<label>
<span>GitHub URL</span>
<input asp-for="GitHubUrl" class="form-control" />
</label>
<label>
<span>LinkedIn URL</span>
<input asp-for="LinkedInUrl" class="form-control" />
</label>
<label>
<span>Twitter URL</span>
<input asp-for="TwitterUrl" class="form-control" />
</label>
<label>
<span>Instagram URL</span>
<input asp-for="InstagramUrl" class="form-control" />
</label>
<label>
<span>Facebook URL</span>
<input asp-for="FacebookUrl" class="form-control" />
</label>
<label>
<span>YouTube URL</span>
<input asp-for="YoutubeUrl" class="form-control" />
</label>
<label class="dev-form-wide">
<span>Website URL</span>
<input asp-for="WebsiteUrl" class="form-control" />
</label>
	<label class="dev-form-wide">
	<span>Developer WhatsApp Number</span>
	<input asp-for="DeveloperWhatsAppPhone" class="form-control" id="DeveloperWhatsAppPhone" placeholder="+91 9651698863" />
	</label>
	<label>
	<span>Developer Email</span>
	<input asp-for="DeveloperEmail" class="form-control" placeholder="developer@example.com" />
	</label>
	<label>
	<span>Developer Email Subject</span>
	<input asp-for="DeveloperEmailSubject" class="form-control" placeholder="showTime Developer Contact" />
	</label>
	<label class="dev-form-wide">
	<span>Developer Email Body</span>
	<textarea asp-for="DeveloperEmailText" class="form-control" rows="2" placeholder="Hi showTime Team, I'm {user}. I would like to connect with the developer."></textarea>
	</label>
	<input type="hidden" asp-for="SupportPhone" id="SupportPhone" />
	<input type="hidden" asp-for="SupportWhatsAppPhone" id="SupportWhatsAppPhone" />
	<input type="hidden" asp-for="SupportEmail" />
	<input type="hidden" asp-for="IsSupportWhatsAppSameAsPhone" />
	<input type="hidden" name="IsDeveloperWhatsAppSameAsPhone" value="false" />
	<input type="hidden" asp-for="TopWhatsAppText" />
	<input type="hidden" asp-for="SupportWhatsAppText" />
	<input type="hidden" asp-for="SupportEmailSubject" />
	<input type="hidden" asp-for="SupportEmailText" />
	</div>

<div class="developer-edit-actions">
<button type="button" class="back-btn developer-hide-editor-btn" onclick="requestDeveloperEditorHide()">Hide Editor</button>
<button type="submit" class="resume-btn">Update Profile</button>
</div>
</form>
</div>
}



<div class="resume-section">

@if(!string.IsNullOrEmpty(Model.ResumeUrl))
{
<a href="@Model.ResumeUrl"
target="_blank"
class="resume-btn">

📄 Download Resume

</a>
}

<a href="/Home/ShowTime"
class="back-btn">

⬅ Back

</a>

</div>

</section>



<style>

.developer-page{

padding:clamp(16px, 3vw, 30px);
min-height:100vh;

background:
var(--app-bg);

color:var(--app-text);
}


.developer-hero{

display:flex;
flex-wrap:wrap;
justify-content:space-between;
align-items:center;
gap:20px;

min-height:130px;
padding:24px;

border-radius:8px;

background:
repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px),
linear-gradient(135deg, rgba(255,242,199,0.94), rgba(245,178,196,0.86), rgba(146,229,221,0.86));
border:0;
color:#231f20;
box-shadow:0 22px 64px rgba(35,31,32,0.22);

margin-bottom:30px;
}


.profile-left{

display:grid;
grid-template-columns:auto minmax(0, 1fr);
column-gap:18px;
align-items:center;
text-align:left;
width:min(520px, 100%);
}


.profile-image{

width:180px;
height:180px;
grid-row:1 / span 4;

border-radius:50%;

object-fit:cover;

border:6px solid var(--app-primary);

box-shadow:
0 0 30px
color-mix(in srgb, var(--app-primary) 46%, transparent);
}


.profile-left h1{

margin:8px 0;

color:#231f20;
font-size:clamp(2rem, 5vw, 3.8rem);
font-weight:900;
line-height:.92;
}

.developer-kicker{
display:block;
align-self:end;
text-transform:uppercase;
font-size:.74rem;
font-weight:900;
letter-spacing:.08em;
color:#34303a;
}

.bio{

opacity:.8;
margin:0;
color:#34303a;
}


.experience-badge{

margin-top:4px;

padding:8px 12px;

background:rgba(255,255,255,.38);
border:1px dashed rgba(35,31,32,.44);

border-radius:8px;

font-weight:900;
color:#231f20;
}



.profile-right{

flex:1;
display:flex;
justify-content:center;
align-items:center;
}


.social-grid{

display:grid;

grid-template-columns:
repeat(
auto-fit,
minmax(130px,1fr)
);

gap:15px;
width:100%;
}


.social-grid a{

padding:15px;

border-radius:15px;

text-decoration:none;

color:var(--app-card-text);

background:color-mix(in srgb, var(--app-card) 78%, var(--app-primary));
border:1px solid var(--app-input-border);

text-align:center;

font-weight:700;

transition:.4s;
display:inline-flex;
align-items:center;
justify-content:center;
gap:8px;
}

.social-grid a:hover{

transform:translateY(-5px);

background:var(--app-primary);
color:#fff;
}

.social-link-disabled{
padding:15px;
border-radius:15px;
color:var(--app-muted);
background:var(--app-input-disabled);
border:1px dashed var(--app-input-border);
text-align:center;
font-weight:800;
cursor:not-allowed;
}



.developer-grid{

display:grid;

grid-template-columns:
repeat(
auto-fit,
minmax(260px,1fr)
);

gap:20px;
}

.developer-command-bar{
display:flex;
align-items:center;
justify-content:space-between;
gap:16px;
margin:-8px 0 24px;
padding:12px;
border:1px solid color-mix(in srgb, var(--app-primary) 28%, var(--app-input-border));
border-radius:8px;
background:
linear-gradient(135deg,
color-mix(in srgb, var(--app-card) 88%, #ffffff),
color-mix(in srgb, var(--app-primary) 12%, var(--app-card)));
color:var(--app-card-text);
box-shadow:0 18px 48px rgba(15,23,42,.14);
position:sticky;
top:12px;
z-index:20;
backdrop-filter:blur(18px);
}

.developer-menu-title{
display:grid;
gap:3px;
min-width:220px;
padding:4px 6px;
}

.developer-menu-title span{
display:block;
color:var(--app-muted);
font-size:.78rem;
font-weight:850;
text-transform:uppercase;
letter-spacing:.08em;
}

.developer-menu-title strong{
display:block;
font-size:1rem;
font-weight:900;
}

.developer-menu-links,
.developer-menu-actions{
display:flex;
align-items:center;
gap:8px;
flex-wrap:wrap;
}

.developer-menu-links{
justify-content:center;
flex:1;
}

.developer-menu-actions{
justify-content:flex-end;
min-width:130px;
}

.developer-menu-links a,
.developer-edit-toggle,
.developer-readonly-pill{
min-height:42px;
display:inline-flex;
align-items:center;
justify-content:center;
padding:0 15px;
border-radius:999px;
border:1px solid color-mix(in srgb, var(--app-primary) 22%, var(--app-input-border));
background:color-mix(in srgb, var(--app-card) 84%, #ffffff);
color:var(--app-card-text);
text-decoration:none;
font-weight:900;
font-size:.9rem;
line-height:1;
white-space:nowrap;
box-shadow:0 8px 20px rgba(15,23,42,.08);
transition:transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease, border-color .2s ease;
}

.developer-menu-links a:hover,
.developer-menu-links a:focus-visible,
.developer-menu-links a.developer-menu-active,
.developer-edit-toggle:hover,
.developer-edit-toggle:focus-visible{
transform:translateY(-2px);
border-color:color-mix(in srgb, var(--app-primary) 62%, var(--app-input-border));
background:var(--app-primary);
color:#fff;
box-shadow:0 14px 28px color-mix(in srgb, var(--app-primary) 28%, transparent);
outline:none;
}

.developer-edit-toggle,
.developer-upload-btn,
.resume-btn,
.back-btn{
cursor:pointer;
}

.developer-menu-links a.developer-menu-support.developer-menu-active:not(:hover):not(:focus-visible){
transform:none;
border-color:color-mix(in srgb, var(--app-primary) 22%, var(--app-input-border));
background:color-mix(in srgb, var(--app-card) 84%, #ffffff);
color:var(--app-card-text);
box-shadow:0 8px 20px rgba(15,23,42,.08);
}

.developer-readonly-pill{
background:var(--app-input-disabled);
color:var(--app-muted);
box-shadow:none;
}


.dev-card{

padding:25px;

border-radius:8px;

background:var(--app-card);
border:1px solid var(--app-input-border);
color:var(--app-card-text);
overflow-wrap:anywhere;

backdrop-filter:blur(20px);

transition:.4s;
}


.dev-card:hover{

transform:
translateY(-8px);

box-shadow:
0 15px 30px
rgba(
0,
0,
0,
0.3
);

}

.developer-section-highlight{
outline:3px solid color-mix(in srgb, var(--app-primary) 72%, #fff);
outline-offset:4px;
box-shadow:0 0 0 8px color-mix(in srgb, var(--app-primary) 16%, transparent), 0 18px 34px rgba(15,23,42,.18);
animation:developerSectionPulse 1.6s ease;
}

.developer-grid.developer-section-highlight,
.developer-support-grid.developer-section-highlight{
border-radius:10px;
}

@@keyframes developerSectionPulse{
0%{
outline-color:color-mix(in srgb, var(--app-primary) 92%, #fff);
box-shadow:0 0 0 2px color-mix(in srgb, var(--app-primary) 22%, transparent), 0 12px 24px rgba(15,23,42,.12);
}
55%{
outline-color:color-mix(in srgb, var(--app-primary) 72%, #fff);
box-shadow:0 0 0 10px color-mix(in srgb, var(--app-primary) 18%, transparent), 0 18px 34px rgba(15,23,42,.18);
}
100%{
outline-color:color-mix(in srgb, var(--app-primary) 48%, #fff);
box-shadow:0 0 0 6px color-mix(in srgb, var(--app-primary) 10%, transparent), 0 12px 24px rgba(15,23,42,.12);
}
}


.dev-card h2{

margin-bottom:20px;

color:var(--app-primary);
font-size:1.08rem;
font-weight:800;
}

.developer-application-grid{
margin-top:20px;
}

.developer-support-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
gap:15px;
margin-top:20px;
}

.developer-support-card{
padding:15px;
border-radius:15px;
text-decoration:none;
color:var(--app-card-text);
background:color-mix(in srgb, var(--app-card) 78%, var(--app-primary));
border:1px solid var(--app-input-border);
text-align:center;
font-weight:800;
transition:.4s;
display:inline-flex;
align-items:center;
justify-content:center;
gap:8px;
min-height:54px;
}

.developer-support-card:hover,
.developer-support-card:focus-visible{
transform:translateY(-5px);
background:var(--app-primary);
color:#fff;
outline:none;
}

.dev-chip-list{
display:flex;
flex-wrap:wrap;
gap:8px;
}

.dev-chip-list span{
display:inline-flex;
align-items:center;
min-height:32px;
padding:6px 10px;
border:1px solid var(--app-input-border);
border-radius:999px;
background:color-mix(in srgb, var(--app-primary) 10%, var(--app-card));
font-weight:850;
font-size:.86rem;
}

.dev-chip-list.tech span{
background:color-mix(in srgb, var(--app-accent-strong) 10%, var(--app-card));
}

.developer-edit-panel{
margin-top:24px;
padding:clamp(18px, 3vw, 28px);
border-radius:8px;
background:var(--app-card);
border:1px solid var(--app-input-border);
color:var(--app-card-text);
box-shadow:0 18px 44px rgba(15,23,42,.1);
}

.developer-edit-panel[hidden]{
display:none;
}

.developer-edit-header{
display:flex;
justify-content:space-between;
gap:16px;
align-items:flex-end;
margin-bottom:18px;
}

.developer-edit-header h2{
margin:0;
font-size:1.35rem;
font-weight:850;
}

.developer-edit-header p{
margin:0;
color:var(--app-muted);
font-weight:650;
}

.dev-form-grid{
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
gap:14px;
}

.dev-form-grid label{
display:grid;
gap:7px;
min-width:0;
font-weight:800;
color:var(--app-card-text);
}

.dev-form-grid .developer-checkbox-label{
display:flex;
align-items:center;
gap:9px;
min-height:42px;
padding-top:22px;
}

.developer-checkbox-label input{
width:18px;
height:18px;
accent-color:var(--app-primary);
}

.dev-form-grid span{
font-size:.82rem;
color:var(--app-muted);
}

.dev-form-wide{
grid-column:1 / -1;
}

.developer-edit-actions{
display:flex;
justify-content:flex-end;
gap:10px;
flex-wrap:wrap;
margin-top:18px;
}

.developer-hide-editor-btn{
border:0;
background:var(--app-input-disabled);
color:var(--app-card-text);
}

.developer-photo-editor{
display:flex;
align-items:center;
gap:16px;
margin-bottom:18px;
padding:14px;
border:1px dashed var(--app-input-border);
border-radius:8px;
background:color-mix(in srgb, var(--app-card) 84%, var(--app-primary));
}

.developer-photo-editor img{
width:96px;
height:96px;
border-radius:50%;
object-fit:cover;
border:4px solid var(--app-primary);
}

.developer-photo-editor input[type="file"]{
position:absolute;
width:1px;
height:1px;
opacity:0;
pointer-events:none;
}

.developer-upload-btn{
display:inline-flex;
align-items:center;
justify-content:center;
min-height:38px;
padding:8px 14px;
border-radius:15px;
border:1px solid var(--app-input-border);
background:#fff;
color:var(--app-card-text);
font-weight:900;
text-align:center;
text-decoration:none;
transition:.4s;
}

.developer-photo-editor p{
margin:8px 0 0;
color:var(--app-muted);
font-weight:650;
}


.detail-item{

display:flex;

justify-content:space-between;

padding:12px 0;

border-bottom:
1px solid
var(--app-input-border);
}


.resume-section{

margin-top:40px;

display:flex;

justify-content:center;

gap:15px;
}


.resume-btn,
.back-btn{
display:inline-flex;
align-items:center;
justify-content:center;
padding:15px 30px;
border-radius:15px;
border:1px solid var(--app-input-border);
background:color-mix(in srgb, var(--app-card) 78%, var(--app-primary));
color:var(--app-card-text);
text-decoration:none;
font-weight:800;
text-align:center;
transition:.4s;
}

.back-btn{
border-color:color-mix(in srgb, var(--app-muted) 45%, var(--app-input-border));
background:color-mix(in srgb, var(--app-card) 88%, var(--app-muted));
color:var(--app-muted);
}


.developer-upload-btn:hover,
.developer-upload-btn:focus-visible,
.resume-btn:hover,
.resume-btn:focus-visible,
.back-btn:hover,
.back-btn:focus-visible{
transform:translateY(-5px);
background:var(--app-primary);
color:#fff;
outline:none;
}

.back-btn:hover,
.back-btn:focus-visible{
border-color:color-mix(in srgb, var(--app-muted) 72%, var(--app-input-border));
background:var(--app-muted);
}



@@media(max-width:768px)
{

.developer-hero{

flex-direction:column;
gap:22px;
}

.profile-left,
.profile-right{
width:100%;
}

.profile-left{
grid-template-columns:auto minmax(0,1fr);
}

.social-grid{

grid-template-columns:
repeat(
2,
1fr
);
}

.developer-grid{

grid-template-columns:
1fr;
}

.dev-form-grid{
grid-template-columns:1fr;
}

.developer-edit-header,
.developer-photo-editor,
.resume-section,
.developer-command-bar{
display:grid;
align-items:start;
}

.developer-command-bar{
position:relative;
top:auto;
grid-template-columns:1fr;
}

.developer-menu-title,
.developer-menu-actions{
min-width:0;
width:100%;
}

.developer-menu-links,
.developer-menu-actions{
justify-content:flex-start;
}

}

@@media(max-width:520px)
{
.profile-image{
width:140px;
height:140px;
}

.profile-left{
grid-template-columns:1fr;
justify-items:center;
text-align:center;
}

.profile-image{
grid-row:auto;
}

.profile-left h1{
font-size:1.55rem;
}

.resume-btn,
.back-btn{
width:100%;
text-align:center;
}

.developer-menu-links{
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
width:100%;
}

.developer-menu-links a,
.developer-edit-toggle,
.developer-readonly-pill{
width:100%;
padding-inline:10px;
}
}

/* Intro-style developer profile refresh. */
.developer-page {
--developer-page-line: color-mix(in srgb, var(--app-input-border) 76%, transparent);
--developer-page-glass: color-mix(in srgb, var(--app-card) 82%, transparent);
--developer-page-soft: color-mix(in srgb, var(--app-input) 68%, transparent);
position:relative;
isolation:isolate;
background:var(--app-profile-bg, var(--app-bg));
}

.developer-page::before {
content:"";
position:absolute;
inset:-18px -16px auto;
z-index:-1;
height:380px;
border-radius:8px;
background:
radial-gradient(circle at 12% 12%, color-mix(in srgb, var(--app-accent) 22%, transparent), transparent 28%),
radial-gradient(circle at 88% 8%, color-mix(in srgb, var(--app-accent-strong) 18%, transparent), transparent 26%),
linear-gradient(135deg, color-mix(in srgb, var(--app-bg) 78%, var(--app-card) 22%), transparent);
pointer-events:none;
}

.developer-hero {
position:relative;
overflow:hidden;
min-height:auto;
padding:clamp(22px, 4vw, 40px);
border:1px solid color-mix(in srgb, var(--app-accent-strong) 24%, var(--developer-page-line));
background:
radial-gradient(circle at 80% 28%, color-mix(in srgb, var(--app-accent-strong) 18%, transparent), transparent 30%),
radial-gradient(circle at 12% 90%, color-mix(in srgb, var(--app-accent) 22%, transparent), transparent 34%),
linear-gradient(135deg, color-mix(in srgb, var(--app-card) 94%, transparent), color-mix(in srgb, var(--app-input) 66%, transparent));
color:var(--app-card-text);
box-shadow:
0 24px 64px color-mix(in srgb, var(--app-text) 14%, transparent),
inset 0 1px 0 color-mix(in srgb, #ffffff 58%, transparent);
animation:developerPageRise .56s ease both;
}

.developer-hero::before {
content:"";
position:absolute;
inset:0;
z-index:0;
background:
linear-gradient(color-mix(in srgb, var(--app-text) 6%, transparent) 1px, transparent 1px),
linear-gradient(90deg, color-mix(in srgb, var(--app-text) 6%, transparent) 1px, transparent 1px);
background-size:30px 30px;
-webkit-mask-image:linear-gradient(90deg, rgba(0,0,0,.5), transparent 72%);
mask-image:linear-gradient(90deg, rgba(0,0,0,.5), transparent 72%);
pointer-events:none;
}

.developer-hero > * {
position:relative;
z-index:1;
}

.profile-image {
border-color:color-mix(in srgb, var(--app-primary) 68%, var(--app-accent));
box-shadow:
0 18px 42px color-mix(in srgb, var(--app-primary) 20%, transparent),
0 0 0 10px color-mix(in srgb, var(--app-card) 46%, transparent);
}

.profile-left h1 {
color:var(--app-card-text);
line-height:.96;
text-wrap:balance;
}

.developer-kicker,
.bio {
color:color-mix(in srgb, var(--app-card-text) 74%, var(--app-muted));
}

.experience-badge {
border-color:color-mix(in srgb, var(--app-accent-strong) 30%, var(--developer-page-line));
background:color-mix(in srgb, var(--app-card) 62%, transparent);
color:var(--app-card-text);
box-shadow:0 14px 30px color-mix(in srgb, var(--app-text) 10%, transparent);
backdrop-filter:blur(14px);
}

.developer-command-bar,
.developer-edit-panel,
.developer-photo-editor {
border-color:var(--developer-page-line);
background:var(--developer-page-glass);
box-shadow:0 18px 44px color-mix(in srgb, var(--app-text) 10%, transparent);
backdrop-filter:blur(14px);
}

.developer-command-bar {
top:10px;
}

.developer-menu-links a,
.developer-edit-toggle,
.developer-readonly-pill,
.resume-btn,
.back-btn,
.developer-upload-btn,
.developer-support-card,
.social-grid a,
.social-link-disabled {
border-radius:8px;
}

.developer-menu-links a,
.developer-edit-toggle,
.resume-btn,
.developer-upload-btn,
.developer-support-card,
.social-grid a {
transition:transform .16s ease, box-shadow .16s ease, border-color .16s ease, background .16s ease, color .16s ease;
}

.developer-menu-links a:hover,
.developer-menu-links a:focus-visible,
.developer-menu-links a.developer-menu-active,
.developer-edit-toggle:hover,
.developer-edit-toggle:focus-visible,
.developer-upload-btn:hover,
.developer-upload-btn:focus-visible,
.resume-btn:hover,
.resume-btn:focus-visible,
.back-btn:hover,
.back-btn:focus-visible,
.developer-support-card:hover,
.developer-support-card:focus-visible,
.social-grid a:hover,
.social-grid a:focus-visible {
transform:translateY(-3px);
}

.social-grid a,
.developer-support-card,
.resume-btn {
background:
linear-gradient(135deg, color-mix(in srgb, var(--app-card) 88%, transparent), color-mix(in srgb, var(--app-primary) 14%, var(--app-card)));
box-shadow:0 14px 30px color-mix(in srgb, var(--app-text) 10%, transparent);
}

.social-grid a:hover,
.social-grid a:focus-visible,
.developer-support-card:hover,
.developer-support-card:focus-visible,
.resume-btn:hover,
.resume-btn:focus-visible {
background:
linear-gradient(135deg, color-mix(in srgb, var(--app-primary) 92%, #ffffff 8%), color-mix(in srgb, var(--app-accent-strong) 86%, var(--app-primary) 14%));
color:#fff;
box-shadow:0 18px 38px color-mix(in srgb, var(--app-primary) 26%, transparent);
}

.contact-svg-icon {
width:18px;
height:18px;
flex:0 0 18px;
fill:none;
stroke:currentColor;
stroke-width:2;
stroke-linecap:round;
stroke-linejoin:round;
}

.social-grid {
grid-template-columns:repeat(auto-fit,minmax(58px,1fr));
max-width:520px;
}

.social-grid a.social-link,
.social-grid .social-link-disabled {
--social-brand:#168f98;
display:inline-flex;
align-items:center;
justify-content:center;
gap:0;
width:100%;
aspect-ratio:1;
min-height:58px;
padding:10px;
border-color:color-mix(in srgb, var(--social-brand) 34%, var(--app-input-border));
background:
linear-gradient(135deg,
color-mix(in srgb, var(--app-card) 90%, transparent),
color-mix(in srgb, var(--social-brand) 14%, var(--app-card)));
color:var(--social-brand) !important;
text-decoration:none;
box-shadow:0 14px 30px color-mix(in srgb, var(--social-brand) 16%, transparent);
}

.social-app-logo {
display:block;
width:31px;
height:31px;
fill:currentColor;
stroke:none;
transition:transform .18s ease, filter .18s ease;
}

.social-link-website .social-app-logo {
fill:none;
stroke:currentColor;
}

.social-grid .visually-hidden {
position:absolute !important;
width:1px !important;
height:1px !important;
padding:0 !important;
margin:-1px !important;
overflow:hidden !important;
clip:rect(0,0,0,0) !important;
white-space:nowrap !important;
border:0 !important;
}

.social-grid a.social-link:hover,
.social-grid a.social-link:focus-visible {
border-color:color-mix(in srgb, var(--social-brand) 68%, #ffffff);
background:
linear-gradient(135deg,
color-mix(in srgb, var(--social-brand) 17%, var(--app-card)),
color-mix(in srgb, var(--app-card) 76%, transparent));
color:var(--social-brand) !important;
box-shadow:0 18px 38px color-mix(in srgb, var(--social-brand) 26%, transparent);
outline:none;
}

.social-grid a.social-link:hover .social-app-logo,
.social-grid a.social-link:focus-visible .social-app-logo {
transform:scale(1.08);
filter:saturate(1.15);
}

.social-grid .social-link-disabled {
opacity:.56;
filter:saturate(.7);
box-shadow:none;
}

.social-link-github {
--social-brand:#181717;
}

.social-link-linkedin {
--social-brand:#0a66c2;
}

.social-link-twitter {
--social-brand:#111111;
}

.social-link-instagram {
--social-brand:#d62976;
}

.social-link-facebook {
--social-brand:#1877f2;
}

.social-link-youtube {
--social-brand:#ff0000;
}

.social-link-website {
