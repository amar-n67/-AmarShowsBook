</style>

<script>
function previewDeveloperPhoto(input) {
    const file = input.files && input.files[0];
    if (!file) return;

    const url = URL.createObjectURL(file);
    const heroPreview = document.getElementById("developerProfilePreview");
    const editPreview = document.getElementById("developerEditPreview");

    if (heroPreview) heroPreview.src = url;
    if (editPreview) editPreview.src = url;
}

function showDeveloperEditor() {
    const panel = document.getElementById("developerEditPanel");
    if (!panel) return;

    panel.hidden = false;
    panel.scrollIntoView({ behavior: "smooth", block: "start" });
}

function getDeveloperForm() {
    return document.querySelector("#developerEditPanel form");
}

function snapshotDeveloperForm(form) {
    if (!form) return "";

    const data = new FormData(form);
    const values = [];

    for (const [key, value] of data.entries()) {
        if (key === "__RequestVerificationToken") continue;
        values.push(key + "=" + (value instanceof File ? value.name + ":" + value.size : value));
    }

    return values.sort().join("&");
}

function rememberDeveloperFormState() {
    const form = getDeveloperForm();
    if (form) {
        form.dataset.initialState = snapshotDeveloperForm(form);
    }

    const editPreview = document.getElementById("developerEditPreview");
    if (editPreview && !editPreview.dataset.originalSrc) {
        editPreview.dataset.originalSrc = editPreview.getAttribute("src") || "";
    }
}

function hasDeveloperFormChanges() {
    const form = getDeveloperForm();
    return Boolean(form) && (form.dataset.initialState || "") !== snapshotDeveloperForm(form);
}

function hideDeveloperEditor(dropChanges) {
    const panel = document.getElementById("developerEditPanel");
    const form = getDeveloperForm();
    if (!panel) return;

    if (dropChanges && form) {
        form.reset();
        const heroPreview = document.getElementById("developerProfilePreview");
        const editPreview = document.getElementById("developerEditPreview");
        const originalImage = editPreview?.dataset.originalSrc;
        if (heroPreview && originalImage) heroPreview.src = originalImage;
        if (editPreview && originalImage) editPreview.src = originalImage;
        rememberDeveloperFormState();
    }

    panel.hidden = true;
}

function requestDeveloperEditorHide() {
    if (!hasDeveloperFormChanges()) {
        hideDeveloperEditor(false);
        return;
    }

    showCinemaPopup("You changed the developer profile. Save before hiding, or drop the unsaved changes?", "confirm", {
        title: "Save Changes?",
        okText: "Save",
        cancelText: "Drop",
        onOk: function () {
            getDeveloperForm()?.requestSubmit();
        },
        onCancel: function () {
            hideDeveloperEditor(true);
        }
    });
}

function toggleDeveloperEditor() {
    const panel = document.getElementById("developerEditPanel");
    if (!panel) return;

    if (panel.hidden) {
        showDeveloperEditor();
        rememberDeveloperFormState();
        return;
    }

    requestDeveloperEditorHide();
}

function syncSupportWhatsAppNumber() {
    const sameCheckbox = document.getElementById("IsSupportWhatsAppSameAsPhone");
    const phoneInput = document.getElementById("SupportPhone");
    const whatsappInput = document.getElementById("SupportWhatsAppPhone");

    if (!sameCheckbox || !phoneInput || !whatsappInput) return;

    if (sameCheckbox.checked) {
        whatsappInput.value = phoneInput.value;
        whatsappInput.setAttribute("readonly", "readonly");
    } else {
        whatsappInput.removeAttribute("readonly");
    }
}

function syncDeveloperWhatsAppNumber() {
    const sameCheckbox = document.getElementById("IsDeveloperWhatsAppSameAsPhone");
    const phoneInput = document.getElementById("SupportPhone");
    const whatsappInput = document.getElementById("DeveloperWhatsAppPhone");

    if (!sameCheckbox || !phoneInput || !whatsappInput) return;

    if (sameCheckbox.checked) {
        whatsappInput.value = phoneInput.value;
        whatsappInput.setAttribute("readonly", "readonly");
    } else {
        whatsappInput.removeAttribute("readonly");
    }
}

function highlightDeveloperSection(targetId) {
    const target = document.getElementById(targetId);
    if (!target) return;

    document.querySelectorAll(".developer-section-highlight").forEach(function (element) {
        element.classList.remove("developer-section-highlight");
    });

    document.querySelectorAll(".developer-menu-links a[data-developer-target]").forEach(function (link) {
        link.classList.toggle("developer-menu-active", link.dataset.developerTarget === targetId);
    });

    const highlightTarget = target.closest(".dev-card") || target;
    highlightTarget.classList.add("developer-section-highlight");

    window.setTimeout(function () {
        highlightTarget.classList.remove("developer-section-highlight");
    }, 1800);
}

function setupDeveloperCardMotion() {
    if (!window.matchMedia || !window.matchMedia("(pointer: fine)").matches) return;

    document.querySelectorAll(".dev-card").forEach(card => {
        card.addEventListener("mousemove", event => {
            const rect = card.getBoundingClientRect();
            const x = event.clientX - rect.left;
            const y = event.clientY - rect.top;
            const tiltX = ((y / rect.height) - 0.5) * -2;
            const tiltY = ((x / rect.width) - 0.5) * 2;

            card.style.setProperty("--motion-x", `${x}px`);
            card.style.setProperty("--motion-y", `${y}px`);
            card.style.setProperty("--motion-tilt-x", `${tiltX.toFixed(2)}deg`);
            card.style.setProperty("--motion-tilt-y", `${tiltY.toFixed(2)}deg`);
            card.classList.add("is-soft-active");
        });

        card.addEventListener("mouseleave", () => {
            card.classList.remove("is-soft-active");
            card.style.setProperty("--motion-tilt-x", "0deg");
            card.style.setProperty("--motion-tilt-y", "0deg");
        });
    });
}

document.addEventListener("DOMContentLoaded", function () {
    rememberDeveloperFormState();
    syncSupportWhatsAppNumber();
    syncDeveloperWhatsAppNumber();
    setupDeveloperCardMotion();

    document.getElementById("IsSupportWhatsAppSameAsPhone")?.addEventListener("change", syncSupportWhatsAppNumber);
    document.getElementById("SupportPhone")?.addEventListener("input", syncSupportWhatsAppNumber);
    document.getElementById("IsDeveloperWhatsAppSameAsPhone")?.addEventListener("change", syncDeveloperWhatsAppNumber);
    document.getElementById("SupportPhone")?.addEventListener("input", syncDeveloperWhatsAppNumber);

    document.querySelectorAll(".developer-menu-links a[data-developer-target]").forEach(function (link) {
        link.addEventListener("click", function () {
            const targetId = link.dataset.developerTarget;
            window.setTimeout(function () {
                highlightDeveloperSection(targetId);
            }, 120);
        });
    });

    if (window.location.hash) {
        window.setTimeout(function () {
            highlightDeveloperSection(window.location.hash.substring(1));
        }, 250);
    }
});
</script>
