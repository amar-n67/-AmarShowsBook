@model AmarShowsBook.Models.ViewModels.DeveloperVM

@{
    ViewData["Title"]="Developer Profile";
    var canEdit = ViewBag.CanEditDeveloperProfile as bool? ?? false;
}

<section class="developer-page">

@if(TempData["Success"] != null)
{
<div class="alert alert-success">@TempData["Success"]</div>
}
@if(TempData["Error"] != null)
{
<div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="developer-hero">

<div class="profile-left">

<img class="profile-image"
src="@(string.IsNullOrEmpty(Model.ProfileImage)
?"/images/default-user.png"
:Model.ProfileImage)" />

<h1>@Model.FullName</h1>

<p class="bio">

@(Model.Bio ?? "Creative Full Stack Developer")

</p>

<div class="experience-badge">

⭐ @Model.ExperienceYears Years Experience

</div>

</div>


<div class="profile-right">

<div class="social-grid">

<a href="@Model.GitHubUrl" target="_blank">
GitHub
</a>

<a href="@Model.LinkedInUrl" target="_blank">
LinkedIn
</a>

<a href="@Model.TwitterUrl" target="_blank">
Twitter
</a>

<a href="@Model.InstagramUrl" target="_blank">
Instagram
</a>

<a href="@Model.FacebookUrl" target="_blank">
Facebook
</a>

<a href="@Model.YoutubeUrl" target="_blank">
YouTube
</a>

<a href="@Model.WebsiteUrl" target="_blank">
Website
</a>

</div>

</div>

</div>



<div class="developer-grid">

<div class="dev-card">

<h2>📧 Basic Information</h2>

<div class="detail-item">
<strong>Email</strong>
<span>@Model.Email</span>
</div>

<div class="detail-item">
<strong>Phone</strong>
<span>@Model.Phone</span>
</div>

<div class="detail-item">
<strong>Address</strong>
<span>@Model.Address</span>
</div>

</div>



<div class="dev-card">

<h2>🛠 Skills</h2>

<p>

@Model.Skills

</p>

</div>


<div class="dev-card">

<h2>🎓 Education</h2>

<p>

@Model.Education

</p>

</div>



<div class="dev-card">

<h2>🚀 Projects</h2>

<p>

@Model.Projects

</p>

</div>



<div class="dev-card">

<h2>⚡ Technologies</h2>

<p>

@Model.Technologies

</p>

</div>



<div class="dev-card">

<h2>🏆 Achievements</h2>

<p>

@Model.Achievements

</p>

</div>

</div>


@if(canEdit)
{
<div class="developer-edit-panel">
<div class="developer-edit-header">
<h2>Edit Developer Profile</h2>
<p>Changes are saved directly to the database profile record.</p>
</div>

<form asp-action="Update" method="post" class="developer-edit-form">
@Html.AntiForgeryToken()
<input type="hidden" asp-for="DeveloperId" />

<div class="dev-form-grid">
<label>
<span>Full Name</span>
<input asp-for="FullName" class="form-control" />
</label>
<label>
<span>Email</span>
<input asp-for="Email" class="form-control" />
</label>
<label>
<span>Phone</span>
<input asp-for="Phone" class="form-control" />
</label>
<label>
<span>Experience Years</span>
<input asp-for="ExperienceYears" class="form-control" type="number" min="0" />
</label>
<label>
<span>Profile Image URL</span>
<input asp-for="ProfileImage" class="form-control" />
</label>
<label>
<span>Resume URL</span>
<input asp-for="ResumeUrl" class="form-control" />
</label>
<label class="dev-form-wide">
<span>Bio</span>
<textarea asp-for="Bio" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Address</span>
<textarea asp-for="Address" class="form-control" rows="2"></textarea>
</label>
<label class="dev-form-wide">
<span>Skills</span>
<textarea asp-for="Skills" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Education</span>
<textarea asp-for="Education" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Projects</span>
<textarea asp-for="Projects" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Technologies</span>
<textarea asp-for="Technologies" class="form-control" rows="3"></textarea>
</label>
<label class="dev-form-wide">
<span>Achievements</span>
<textarea asp-for="Achievements" class="form-control" rows="3"></textarea>
</label>
<label>
<span>GitHub URL</span>
<input asp-for="GitHubUrl" class="form-control" />
</label>
<label>
<span>LinkedIn URL</span>
<input asp-for="LinkedInUrl" class="form-control" />
</label>
<label>
<span>Twitter URL</span>
<input asp-for="TwitterUrl" class="form-control" />
</label>
<label>
<span>Instagram URL</span>
<input asp-for="InstagramUrl" class="form-control" />
</label>
<label>
<span>Facebook URL</span>
<input asp-for="FacebookUrl" class="form-control" />
</label>
<label>
<span>YouTube URL</span>
<input asp-for="YoutubeUrl" class="form-control" />
</label>
<label class="dev-form-wide">
<span>Website URL</span>
<input asp-for="WebsiteUrl" class="form-control" />
</label>
</div>

<div class="developer-edit-actions">
<button type="submit" class="resume-btn">Update Profile</button>
</div>
</form>
</div>
}



<div class="resume-section">

@if(!string.IsNullOrEmpty(Model.ResumeUrl))
{
<a href="@Model.ResumeUrl"
target="_blank"
class="resume-btn">

📄 Download Resume

</a>
}

<a href="/Home/Index"
class="back-btn">

⬅ Back

</a>

</div>

</section>



<style>

.developer-page{

padding:clamp(16px, 3vw, 30px);
min-height:100vh;

background:
var(--app-bg);

color:var(--app-text);
}


.developer-hero{

display:flex;
flex-wrap:wrap;
justify-content:space-between;
gap:40px;

padding:clamp(20px, 3vw, 35px);

border-radius:8px;

background:var(--app-card);
border:1px solid var(--app-input-border);
color:var(--app-card-text);

backdrop-filter:blur(20px);

margin-bottom:30px;
}


.profile-left{

text-align:center;
width:min(300px, 100%);
}


.profile-image{

width:180px;
height:180px;

border-radius:50%;

object-fit:cover;

border:6px solid var(--app-primary);

box-shadow:
0 0 30px
color-mix(in srgb, var(--app-primary) 46%, transparent);
}


.profile-left h1{

margin-top:15px;

font-size:2rem;
font-weight:800;
}


.bio{

opacity:.8;
margin-top:10px;
}


.experience-badge{

margin-top:15px;

padding:12px;

background:var(--app-primary);

border-radius:20px;

font-weight:700;
color:#fff;
}



.profile-right{

flex:1;
display:flex;
justify-content:center;
align-items:center;
}


.social-grid{

display:grid;

grid-template-columns:
repeat(
auto-fit,
minmax(130px,1fr)
);

gap:15px;
width:100%;
}


.social-grid a{

padding:15px;

border-radius:15px;

text-decoration:none;

color:var(--app-card-text);

background:color-mix(in srgb, var(--app-card) 78%, var(--app-primary));
border:1px solid var(--app-input-border);

text-align:center;

font-weight:700;

transition:.4s;
}

.social-grid a:hover{

transform:translateY(-5px);

background:var(--app-primary);
color:#fff;
}



.developer-grid{

display:grid;

grid-template-columns:
repeat(
auto-fit,
minmax(260px,1fr)
);

gap:20px;
}


.dev-card{

padding:25px;

border-radius:8px;

background:var(--app-card);
border:1px solid var(--app-input-border);
color:var(--app-card-text);
overflow-wrap:anywhere;

backdrop-filter:blur(20px);

transition:.4s;
}


.dev-card:hover{

transform:
translateY(-8px);

box-shadow:
0 15px 30px
rgba(
0,
0,
0,
0.3
);

}


.dev-card h2{

margin-bottom:20px;

color:var(--app-primary);
font-size:1.08rem;
font-weight:800;
}

.developer-edit-panel{
margin-top:24px;
padding:clamp(18px, 3vw, 28px);
border-radius:8px;
background:var(--app-card);
border:1px solid var(--app-input-border);
color:var(--app-card-text);
box-shadow:0 18px 44px rgba(15,23,42,.1);
}

.developer-edit-header{
display:flex;
justify-content:space-between;
gap:16px;
align-items:flex-end;
margin-bottom:18px;
}

.developer-edit-header h2{
margin:0;
font-size:1.35rem;
font-weight:850;
}

.developer-edit-header p{
margin:0;
color:var(--app-muted);
font-weight:650;
}

.dev-form-grid{
display:grid;
grid-template-columns:repeat(2,minmax(0,1fr));
gap:14px;
}

.dev-form-grid label{
display:grid;
gap:7px;
min-width:0;
font-weight:800;
color:var(--app-card-text);
}

.dev-form-grid span{
font-size:.82rem;
color:var(--app-muted);
}

.dev-form-wide{
grid-column:1 / -1;
}

.developer-edit-actions{
display:flex;
justify-content:flex-end;
margin-top:18px;
}


.detail-item{

display:flex;

justify-content:space-between;

padding:12px 0;

border-bottom:
1px solid
var(--app-input-border);
}


.resume-section{

margin-top:40px;

display:flex;

justify-content:center;

gap:15px;
}


.resume-btn,
.back-btn{

padding:15px 30px;

border-radius:15px;

text-decoration:none;

font-weight:700;

color:#fff;

transition:.4s;
}


.resume-btn{

background:var(--app-accent-strong);
}


.back-btn{

background:var(--app-primary);
}


.resume-btn:hover,
.back-btn:hover{

transform:
translateY(-5px);
}



@@media(max-width:768px)
{

.developer-hero{

flex-direction:column;
gap:22px;
}

.profile-left,
.profile-right{
width:100%;
}

.social-grid{

grid-template-columns:
repeat(
2,
1fr
);
}

.developer-grid{

grid-template-columns:
1fr;
}

.dev-form-grid{
grid-template-columns:1fr;
}

.developer-edit-header,
.resume-section{
display:grid;
align-items:start;
}

}

@@media(max-width:520px)
{
.profile-image{
width:140px;
height:140px;
}

.profile-left h1{
font-size:1.55rem;
}

.resume-btn,
.back-btn{
width:100%;
text-align:center;
}
}

</style>
