<script>
function previewDeveloperPhoto(input) {
    const file = input.files && input.files[0];
    if (!file) return;

    const url = URL.createObjectURL(file);
    const heroPreview = document.getElementById("developerProfilePreview");
    const editPreview = document.getElementById("developerEditPreview");

    if (heroPreview) heroPreview.src = url;
    if (editPreview) editPreview.src = url;
}

function showDeveloperEditor() {
    const panel = document.getElementById("developerEditPanel");
    if (!panel) return;

    panel.hidden = false;
    panel.scrollIntoView({ behavior: "smooth", block: "start" });
}

function getDeveloperForm() {
    return document.querySelector("#developerEditPanel form");
}

function snapshotDeveloperForm(form) {
    if (!form) return "";

    const data = new FormData(form);
    const values = [];

    for (const [key, value] of data.entries()) {
        if (key === "__RequestVerificationToken") continue;
        values.push(key + "=" + (value instanceof File ? value.name + ":" + value.size : value));
    }

    return values.sort().join("&");
}

function rememberDeveloperFormState() {
    const form = getDeveloperForm();
    if (form) {
        form.dataset.initialState = snapshotDeveloperForm(form);
    }

    const editPreview = document.getElementById("developerEditPreview");
    if (editPreview && !editPreview.dataset.originalSrc) {
        editPreview.dataset.originalSrc = editPreview.getAttribute("src") || "";
    }
}

function hasDeveloperFormChanges() {
    const form = getDeveloperForm();
    return Boolean(form) && (form.dataset.initialState || "") !== snapshotDeveloperForm(form);
}

function hideDeveloperEditor(dropChanges) {
    const panel = document.getElementById("developerEditPanel");
    const form = getDeveloperForm();
    if (!panel) return;

    if (dropChanges && form) {
        form.reset();
        const heroPreview = document.getElementById("developerProfilePreview");
        const editPreview = document.getElementById("developerEditPreview");
        const originalImage = editPreview?.dataset.originalSrc;
        if (heroPreview && originalImage) heroPreview.src = originalImage;
        if (editPreview && originalImage) editPreview.src = originalImage;
        rememberDeveloperFormState();
    }

    panel.hidden = true;
}

function requestDeveloperEditorHide() {
    if (!hasDeveloperFormChanges()) {
        hideDeveloperEditor(false);
        return;
    }

    showCinemaPopup("You changed the developer profile. Save before hiding, or drop the unsaved changes?", "confirm", {
        title: "Save Changes?",
        okText: "Save",
        cancelText: "Drop",
        onOk: function () {
            getDeveloperForm()?.requestSubmit();
        },
        onCancel: function () {
            hideDeveloperEditor(true);
        }
    });
}

function toggleDeveloperEditor() {
    const panel = document.getElementById("developerEditPanel");
    if (!panel) return;

    if (panel.hidden) {
        showDeveloperEditor();
        rememberDeveloperFormState();
        return;
    }

    requestDeveloperEditorHide();
}

document.addEventListener("DOMContentLoaded", rememberDeveloperFormState);
</script>
