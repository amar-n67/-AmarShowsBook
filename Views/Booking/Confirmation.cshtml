@model BookingDraft
@using System.Net
@inject AmarShowsBook.Services.RbacService RbacService

@{
    var canUsePrintTools = AmarShowsBook.Helpers.RbacAuthorizationHelper.CanUsePrintTools(Context, RbacService);
    var schedule = ViewBag.Schedule;
    var user = ViewBag.User as AmarShowsBook.Models.User;
    var seatCount = Model.SeatNumbers.Split(',').Length;
    var seatPrice = Model.TotalAmount / seatCount;
    var ticketUrl = ViewBag.TicketUrl as string ?? $"{Context.Request.Scheme}://{Context.Request.Host}/Booking/Ticket/{Model.Id}";
    var title = schedule?.Movie?.Title ?? schedule?.StandupShow?.Title ?? schedule?.LiveStream?.Title ?? "Show";
    var venue = schedule?.Location == null ? "Venue to be announced" : $"{schedule.Location.Area}, {schedule.Location.State}";
    string? posterUrl = Convert.ToString(schedule?.Movie?.PosterUrl
        ?? schedule?.StandupShow?.PosterUrl
        ?? schedule?.LiveStream?.PosterUrl);
    string? imageList = Convert.ToString(schedule?.Movie?.Images
        ?? schedule?.StandupShow?.Images
        ?? schedule?.LiveStream?.Images);

    if (string.IsNullOrWhiteSpace(posterUrl) && !string.IsNullOrWhiteSpace(imageList))
    {
        posterUrl = imageList.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x));
    }

    posterUrl = string.IsNullOrWhiteSpace(posterUrl)
        ? "/images/default1.jpg"
        : posterUrl;
}

<style>

:root{
--primary:#ff2d55;
--bg:#f4f6ff;
--muted:#6b7280;
}

body{

margin:0;
padding:20px;

font-family:Segoe UI,sans-serif;

background:
linear-gradient(
135deg,
#ececf8,
#f8f8ff
);

overflow:auto;

}


/* wrapper */

.ticket-wrapper{

display:flex;
justify-content:center;
align-items:center;

min-height:90vh;
padding:16px 0 36px;
}


/* ticket */

.ticket{

width:950px;

display:grid;

grid-template-columns:
2fr 1fr;

background:white;

border-radius:30px;

overflow:hidden;

position:relative;

box-shadow:
0 20px 50px rgba(0,0,0,.1);

animation:
floatTicket 4s infinite ease-in-out;
}


/* side holes */

.ticket::before,
.ticket::after{

content:"";

position:absolute;

width:50px;
height:50px;

border-radius:50%;

background:var(--bg);

top:50%;

transform:
translateY(-50%);
}

.ticket::before{

left:-25px;
}

.ticket::after{

right:-25px;
}



/* LEFT */

.left{

padding:25px 30px;

position:relative;
}


/* title */

.header{

padding:18px;

text-align:center;

background:
linear-gradient(
135deg,
#ff2d55,
#d10045
);

color:white;

font-size:26px;

font-weight:900;

letter-spacing:5px;

border-radius:20px;

margin-bottom:25px;
}


/* movie */

.movie-section{

display:flex;

gap:20px;
}


.poster{

width:180px;
height:180px;

border-radius:20px;

object-fit:cover;

aspect-ratio:1/1;

box-shadow:
0 10px 20px rgba(0,0,0,.15);

transition:.4s;

}

.poster:hover{

transform:
scale(1.05);

}


.movie-info h1{

margin:0;

font-size:36px;

font-weight:900;
}

.movie-info p{

margin-top:10px;

font-size:16px;

color:var(--muted);
}


/* separator */

.ticket-line{

margin:25px 0;

border-top:
3px dashed #ddd;
}


/* rows */

.data-row{

display:flex;

justify-content:space-between;

padding:14px 0;
}

.label{

font-size:18px;

color:#777;

font-weight:700;
}

.value{

font-size:20px;

font-weight:900;
}



/* total row */

.bottom{

display:flex;

justify-content:space-between;

align-items:center;

margin-top:25px;
}

.total{

font-size:45px;

font-weight:900;

color:var(--primary);
}



/* download */

.download-btn{

border:none;

padding:14px 25px;

border-radius:14px;

font-size:16px;

font-weight:800;

cursor:pointer;

color:white;

background:
linear-gradient(
135deg,
#ff2d55,
#ff005d
);

transition:.4s;
}

.ticket-action-row{
display:flex;
gap:12px;
flex-wrap:wrap;
}

.my-bookings-btn{
display:inline-flex;
align-items:center;
justify-content:center;
border:1px solid #d7dbe4;
padding:14px 25px;
border-radius:14px;
font-size:16px;
font-weight:800;
text-decoration:none;
color:#20212a;
background:#fff;
transition:.4s;
}

.my-bookings-btn:hover{
transform:translateY(-4px);
box-shadow:0 10px 25px rgba(0,0,0,.12);
}

.download-btn:hover{

transform:
translateY(-4px);

box-shadow:
0 10px 25px rgba(255,0,90,.25);
}



/* RIGHT */

.right{

padding:25px;

background:#fafafa;

position:relative;

}


/* center dashed line */

.right::before{

content:"";

position:absolute;

left:0;
top:0;

height:100%;

border-left:
3px dashed #ddd;
}


/* middle cuts */

.right::after{

content:"";

position:absolute;

left:-25px;
top:50%;

width:50px;
height:50px;

background:var(--bg);

border-radius:50%;

transform:
translateY(-50%);
}



/* cards */

.info-card{

display:flex;

gap:12px;

padding:12px;

margin-bottom:15px;

background:white;

border-radius:15px;

box-shadow:
0 5px 10px rgba(0,0,0,.05);
}


.icon{

width:45px;
height:45px;

display:flex;

justify-content:center;
align-items:center;

border-radius:50%;

background:
linear-gradient(
135deg,
#ff2d55,
#ff005d
);

font-size:20px;

color:white;
}

.side-label{

font-size:12px;

color:#888;
}

.side-value{

font-size:15px;

font-weight:800;
}


/* QR */

.qr{

margin-top:20px;

display:flex;

justify-content:center;

align-items:center;

flex:1;
}


.qr img{

width:220px;
height:220px;

padding:18px;

background:white;

border-radius:22px;

object-fit:contain;

box-shadow:
0 10px 25px rgba(0,0,0,.12);

transition:.4s;

animation:
qrPulse 3s infinite;
}


.qr img:hover{

transform:
scale(1.05);
}


@@keyframes qrPulse{

50%{

transform:
translateY(-5px);
}

}


/* animation */

@@keyframes floatTicket{

50%{

transform:
translateY(-8px);

}

}


/* print */

@@media print{

body{
background:white;
}

.download-btn{

display:none;
}

.my-bookings-btn{
display:none;
}

}


/* responsive */

@@media(max-width:900px){

body{

overflow:auto;
}

.ticket{

grid-template-columns:1fr;
}

.right::before{

display:none;
}

.movie-section{

flex-direction:column;

align-items:center;

text-align:center;
}

.bottom{

flex-direction:column;

gap:20px;
}

}

</style>


<div class="ticket-wrapper">

<div class="ticket">

<div class="left">

<div class="header">

🎟 TICKET BOOKED

</div>


<div class="movie-section">

<img
class="poster"
src="@posterUrl"
alt="@title poster"
/>

<div class="movie-info">

<h1>

@title

</h1>

<p>
📍 @venue
</p>

<p>
📅 @(schedule?.StartTime.ToString("dd MMM yyyy") ?? "TBA")
</p>

<p>
🕒 @(schedule?.StartTime.ToString("hh:mm tt") ?? "TBA")
</p>

</div>

</div>


<div class="ticket-line"></div>


<div class="data-row">

<div class="label">

💺 Seats

</div>

<div class="value">

@Model.SeatNumbers

</div>

</div>


<div class="data-row">

<div class="label">

💰 Seat Price

</div>

<div class="value">

₹@seatPrice

</div>

</div>


<div class="bottom">

<div>

<div class="label">

TOTAL

</div>

<div class="total">

₹@Model.TotalAmount

</div>

</div>

<div class="ticket-action-row no-print">

@if(canUsePrintTools)
{
<button
class="download-btn"
onclick="window.print()">

⬇ Download Ticket

</button>
}

<a
class="my-bookings-btn"
href="/Booking/MyBookings">

My Bookings

</a>

</div>

</div>

</div>



<div class="right">

<div class="info-card">

<div class="icon">
🆔
</div>

<div>

<div class="side-label">
Booking Id
</div>

<div class="side-value">
#@Model.Id
</div>

</div>

</div>


<div class="info-card">

<div class="icon">
📧
</div>

<div>

<div class="side-label">
Email
</div>

<div class="side-value">
@(user?.Email ?? ViewBag.Email ?? "Not Available")
</div>

</div>

</div>


<div class="info-card">

<div class="icon">
📱
</div>

<div>

<div class="side-label">
Phone
</div>

<div class="side-value">
@(user?.Mobile ?? ViewBag.Phone ?? "Not Available")
</div>

</div>

</div>


<div class="info-card">

<div class="icon">
📅
</div>

<div>

<div class="side-label">
Booking Date
</div>

<div class="side-value">
@DateTime.Now.ToString("dd MMM yyyy")
</div>

</div>

</div>


<div class="qr">

<img
src="/Booking/CreateQR?text=@WebUtility.UrlEncode(ticketUrl)"
/>

</div>

</div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const params = new URLSearchParams(window.location.search);
    const canUsePrintTools = @canUsePrintTools.ToString().ToLowerInvariant();
    if (canUsePrintTools && params.get("print") === "1") {
        window.print();
    }
});
</script>

</div>
