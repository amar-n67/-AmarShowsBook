@model BookingDraft

@{
    var schedule = ViewBag.Schedule;
}

<style>

:root{

--bg:#f5f7fb;
--card:#fff;

--text:#111827;
--muted:#6b7280;

--success:#16a34a;
--danger:#dc2626;

--border:#e5e7eb;

}

body{

background:var(--bg);

font-family:Segoe UI,sans-serif;

overflow-x:hidden;

}



.ticket-container{

max-width:750px;

margin:40px auto;

padding:20px;

animation:fadeUp .6s;

position:relative;

}



.ticket-card{

background:var(--card);

border-radius:25px;

overflow:hidden;

border:1px solid var(--border);

box-shadow:
0 15px 40px rgba(0,0,0,.06);

}



.ticket-header{

padding:35px;

text-align:center;

position:relative;

color:white;

overflow:hidden;

}


.success{

background:
linear-gradient(
135deg,
#16a34a,
#22c55e
);

}


.failed{

background:
linear-gradient(
135deg,
#dc2626,
#ef4444
);

animation:shake .6s;

}


.ticket-header h2{

margin:0;

font-size:30px;

font-weight:800;

}



.icon{

font-size:60px;

margin-bottom:15px;

animation:bounce 1.2s infinite;

}



.ticket-body{

padding:30px;

}



.row{

display:flex;

justify-content:space-between;

padding:16px 0;

border-bottom:1px solid var(--border);

}


.label{

font-size:14px;

font-weight:600;

color:var(--muted);

}


.value{

font-size:16px;

font-weight:700;

}


.amount{

font-size:28px;

font-weight:800;

color:#4f46e5;

}



.reason{

margin-top:25px;

padding:14px;

border-radius:14px;

background:#fef2f2;

color:#dc2626;

font-weight:700;

}



.action{

margin-top:30px;

text-align:center;

}


.action-btn{

display:inline-block;

padding:14px 30px;

border-radius:14px;

font-weight:700;

text-decoration:none;

color:white;

transition:.3s;

}


.booking-btn{

background:#4f46e5;

}


.retry-btn{

background:#dc2626;

}


.action-btn:hover{

transform:
translateY(-3px);

box-shadow:
0 10px 20px rgba(0,0,0,.15);

}



/* CONFETTI */

.confetti{

position:absolute;

width:10px;

height:10px;

top:-20px;

animation:fall 4s linear infinite;

}


.confetti:nth-child(1){

left:10%;
background:#ff595e;
animation-delay:0s;

}

.confetti:nth-child(2){

left:30%;
background:#ffca3a;
animation-delay:.5s;

}

.confetti:nth-child(3){

left:50%;
background:#8ac926;
animation-delay:1s;

}

.confetti:nth-child(4){

left:70%;
background:#1982c4;
animation-delay:1.5s;

}

.confetti:nth-child(5){

left:90%;
background:#6a4c93;
animation-delay:2s;

}



/* animations */

@@keyframes fall{

0%{

transform:
translateY(-50px)
rotate(0deg);

opacity:1;

}

100%{

transform:
translateY(700px)
rotate(720deg);

opacity:0;

}

}


@@keyframes bounce{

0%,100%{

transform:translateY(0);

}

50%{

transform:translateY(-8px);

}

}


@@keyframes shake{

0%,100%{

transform:translateX(0);

}

25%{

transform:translateX(-8px);

}

75%{

transform:translateX(8px);

}

}


@@keyframes fadeUp{

from{

opacity:0;

transform:
translateY(25px);

}

to{

opacity:1;

transform:
translateY(0);

}

}



@@media(max-width:768px){

.ticket-container{

padding:12px;

}


.ticket-body{

padding:20px;

}


.row{

flex-direction:column;

gap:6px;

}


.ticket-header h2{

font-size:24px;

}

}

</style>



<div class="ticket-container">

@if(Model.Status=="CONFIRMED")
{

<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>
<div class="confetti"></div>

}

<div class="ticket-card">

<div class="ticket-header @(Model.Status=="CONFIRMED" ? "success":"failed")">

@if(Model.Status=="CONFIRMED")
{
<div class="icon">
🎉
</div>

<h2>

Booking Successful

</h2>
}
else
{
<div class="icon">
❌
</div>

<h2>

Booking Failed

</h2>
}

</div>



<div class="ticket-body">

<div class="row">
<div class="label">Booking Id</div>
<div class="value">#@Model.Id</div>
</div>

<div class="row">
<div class="label">Seats</div>
<div class="value">@Model.SeatNumbers</div>
</div>

<div class="row">
<div class="label">Amount</div>
<div class="value amount">
₹@Model.TotalAmount
</div>
</div>

<div class="row">
<div class="label">Venue</div>
<div class="value">
@schedule.Location.Area
</div>
</div>

<div class="row">
<div class="label">Location</div>
<div class="value">
@schedule.Location.State,
@schedule.Location.Country
</div>
</div>

<div class="row">
<div class="label">Show Time</div>
<div class="value">
@schedule.StartTime
</div>
</div>

@if(Model.Status!="CONFIRMED")
{
<div class="reason">

Reason:
Transaction Failed

</div>
}


<div class="action">

@if(Model.Status=="CONFIRMED")
{
<a
class="action-btn booking-btn"
href="/Booking/MyBookings">

View My Bookings

</a>
}
else
{
<a
class="action-btn retry-btn"
href="/Booking/Payment?bookingId=@Model.Id">

Retry Payment

</a>
}

</div>

</div>

</div>

</div>