.payment-container {
    position: relative;
    isolation: isolate;
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(18px, 4vw, 46px) 16px 54px;
}

.payment-container::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    content: "";
    border-radius: 28px;
    background:
        radial-gradient(circle at 12% 8%, rgba(240, 189, 79, 0.28), transparent 26%),
        radial-gradient(circle at 88% 10%, rgba(22, 143, 152, 0.20), transparent 24%),
        linear-gradient(120deg, #f7fbf8 0%, #fff5df 48%, #f5d5ca 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.62);
}

.payment-container::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    border-radius: 28px;
    background-image:
        linear-gradient(rgba(23, 32, 51, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(23, 32, 51, 0.05) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92), transparent 92%);
}

