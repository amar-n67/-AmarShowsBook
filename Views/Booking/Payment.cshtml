@model BookingDraft
@using AmarShowsBook.Helpers

@{
    var walletAmountUsed = ViewBag.WalletAmountUsed as decimal? ?? 0;
    var payableAmount = ViewBag.PayableAmount as decimal? ?? Model.TotalAmount;
}

<style>

body{
    background:#f4f6f9;
}

.payment-container{
    width:700px;
    margin:40px auto;
}

.payment-card{

    background:white;

    border-radius:25px;

    overflow:hidden;

    box-shadow:
    0px 10px 30px rgba(0,0,0,.15);
}

.payment-header{

    background:
    linear-gradient(
    135deg,
    #6a11cb,
    #2575fc);

    color:white;

    padding:30px;

    text-align:center;
}

.payment-header h2{
    margin:0;
    font-size:30px;
}

.payment-body{
    padding:30px;
}

.amount-box{

    text-align:center;

    background:#f7f9fc;

    padding:20px;

    border-radius:15px;

    margin-bottom:25px;
}

.amount-box h3{
    margin:0;
    color:#666;
}

.amount{

    font-size:35px;

    font-weight:bold;

    color:#0d6efd;
}

.wallet-applied{
    margin-top:8px;
    color:#16a34a;
    font-weight:800;
}

.payment-option{

    border:1px solid #ddd;

    padding:15px;

    border-radius:12px;

    margin-bottom:15px;

    cursor:pointer;

    transition:.3s;
}

.payment-option:hover{
    background:#f3f7ff;
}

#qrSection{

    margin-top:20px;

    text-align:center;

    display:none;
}

#qrImage{

    border:8px solid #eee;

    border-radius:15px;

    padding:10px;

    background:white;
}

.scan-text{

    margin-top:15px;

    font-weight:bold;

    color:#666;
}

.pay-btn{

    width:100%;

    border:none;

    padding:15px;

    font-size:18px;

    border-radius:40px;

    cursor:pointer;

    color:white;

    font-weight:bold;

    margin-top:25px;

    background:
    linear-gradient(
    135deg,
    #28a745,
    #0d6efd);

    transition:.3s;
}

.pay-btn:hover{

    transform:
    translateY(-2px);

    box-shadow:
    0px 10px 20px rgba(0,0,0,.2);
}
<style>

:root{

--bg:#f5f7fb;
--card:#fff;

--text:#111827;
--muted:#6b7280;

--primary:#4f46e5;
--success:#16a34a;

--border:#e5e7eb;

}

body{

background:var(--bg);

font-family:Segoe UI,sans-serif;

color:var(--text);

}


.payment-container{

max-width:750px;

margin:40px auto;

padding:20px;

animation:fadeUp .5s;

}


.payment-card{

background:var(--card);

border-radius:25px;

padding:30px;

border:1px solid var(--border);

box-shadow:

0 15px 40px rgba(0,0,0,.06);

}



.payment-header{

display:flex;

justify-content:space-between;

align-items:center;

padding-bottom:20px;

margin-bottom:25px;

border-bottom:1px solid var(--border);

}


.payment-header h2{

margin:0;

font-size:28px;

font-weight:800;

}


.amount-box{

padding:25px;

border-radius:18px;

background:#fafafa;

text-align:center;

margin-bottom:25px;

border:1px solid var(--border);

}


.amount-box h3{

margin:0;

font-size:14px;

color:var(--muted);

margin-bottom:10px;

}


.amount{

font-size:35px;

font-weight:900;

color:var(--primary);

}


.wallet-applied{

margin-top:10px;

color:var(--success);

font-weight:700;

}



/* payment cards */

.payment-grid{

display:grid;

grid-template-columns:
1fr 1fr;

gap:15px;

margin-bottom:20px;

}


.payment-option{

padding:18px;

border-radius:16px;

background:#fafafa;

border:1px solid var(--border);

cursor:pointer;

transition:.3s;

display:flex;

align-items:center;

gap:12px;

font-weight:700;

}


.payment-option:hover{

transform:translateY(-3px);

border-color:var(--primary);

}


.payment-option input{

accent-color:var(--primary);

transform:scale(1.2);

}



/* QR */

#qrSection{

display:none;

margin-top:25px;

padding:25px;

text-align:center;

background:#fafafa;

border-radius:20px;

border:1px solid var(--border);

animation:fadeUp .4s;

}


#qrImage{

border-radius:18px;

padding:10px;

background:white;

border:1px solid var(--border);

}


.scan-text{

margin-top:15px;

font-size:14px;

font-weight:700;

color:var(--muted);

}



/* button */

.pay-btn{

width:100%;

padding:16px;

border:none;

border-radius:15px;

margin-top:25px;

background:

linear-gradient(
135deg,
#4f46e5,
#6366f1
);

color:white;

font-size:16px;

font-weight:800;

cursor:pointer;

transition:.3s;

}


.pay-btn:hover{

transform:

translateY(-2px);

box-shadow:

0 10px 25px rgba(79,70,229,.25);

}


.pay-btn:disabled{

opacity:.7;

cursor:not-allowed;

}



/* animation */

@@keyframes fadeUp{

from{

opacity:0;

transform:
translateY(15px);

}

to{

opacity:1;

transform:
translateY(0);

}

}


/* mobile */

@@media(max-width:768px){

.payment-container{

padding:12px;

}


.payment-card{

padding:20px;

}


.payment-header{

flex-direction:column;

align-items:flex-start;

gap:10px;

}


.payment-grid{

grid-template-columns:1fr;

}


.amount{

font-size:28px;

}


}

</style>



<div class="payment-container">

<div class="payment-card">

<div class="payment-header">

<h2>

💳 Payment

</h2>

<div style="color:#6b7280">

Booking #@Model.Id

</div>

</div>


<div class="amount-box">

<h3>

Total Payable

</h3>

<div class="amount">

@CurrencyFormatter.FormatRupees(
payableAmount
)

</div>

@if(walletAmountUsed>0)
{
<div class="wallet-applied">

Wallet used:

@CurrencyFormatter.FormatRupees(
walletAmountUsed
)

</div>
}

</div>



<div class="payment-grid">

<label class="payment-option">

<input
type="radio"
name="pay"
value="UPI"
checked
onchange="toggleQR()" />

📱 UPI

</label>


<label class="payment-option">

<input
type="radio"
name="pay"
value="CARD"
onchange="toggleQR()" />

💳 Card

</label>


<label class="payment-option">

<input
type="radio"
name="pay"
value="NETBANKING"
onchange="toggleQR()" />

🏦 Net Banking

</label>


<label class="payment-option">

<input
type="radio"
name="pay"
value="QR"
onchange="toggleQR()" />

🔳 QR Scan

</label>

</div>



<div id="qrSection">

<img
id="qrImage"
width="220" />

<div class="scan-text">

Scan QR using any UPI app

</div>

</div>



<button
id="payButton"
class="pay-btn"
type="button"
onclick="pay()">

Proceed Payment

</button>


</div>

</div>
<script>

let statusChecker=null;


async function toggleQR()
{
    let paymentMethod=

    document.querySelector(
    'input[name="pay"]:checked'
    ).value;


    if(paymentMethod==="QR")
    {
        document
        .getElementById(
        "qrSection")
        .style.display="block";

        document
        .getElementById(
        "payButton")
        .style.display="none";


        let response=

        await fetch(
        "/Booking/GenerateQR?bookingId=@Model.Id"
        );

        let result=
        await response.json();


        document
        .getElementById(
        "qrImage")
        .src=
        "/Booking/CreateQR?text="
        +
        encodeURIComponent(
        result.url);


        if(statusChecker)
        {
            clearInterval(
            statusChecker);
        }

        statusChecker=
        setInterval(
        checkQRStatus,
        3000
        );
    }
    else
    {
        document
        .getElementById(
        "qrSection")
        .style.display="none";

        document
        .getElementById(
        "payButton")
        .style.display="block";

        clearInterval(
        statusChecker);
    }
}



async function pay()
{
    const payButton =
    document.getElementById(
    "payButton");

    payButton.disabled =
    true;

    payButton.innerText =
    "Processing...";

    let paymentMethod=

    document.querySelector(
    'input[name="pay"]:checked'
    ).value;


    try
    {
        let response=

        await fetch(
        "/Booking/CompletePayment",
        {
            method:"POST",

            headers:
            {
                "Content-Type":
                "application/json"
            },

            body:
            JSON.stringify(
            {
                bookingId:@Model.Id,
                paymentMethod:paymentMethod
            })
        });

        let result=
        await response.json();


        if(result.success)
        {
            window.location=
            "/Booking/Confirmation?bookingId=@Model.Id";
        }
        else
        {
            alert(
            result.message || "Transaction Failed");

            payButton.disabled =
            false;

            payButton.innerText =
            "Pay Now";
        }
    }
    catch(error)
    {
        alert(
        "Payment could not be completed. Please try again.");

        payButton.disabled =
        false;

        payButton.innerText =
        "Pay Now";
    }
}



async function checkQRStatus()
{
    let response=

    await fetch(
    "/Booking/CheckQRStatus?bookingId=@Model.Id"
    );

    let result=
    await response.json();


    if(
    result.status==="SUCCESS"
    ||
    result.status==="FAILED"
    )
    {
        clearInterval(
        statusChecker);

        window.location=
        "/Booking/Confirmation?bookingId=@Model.Id";
    }
}

</script>
