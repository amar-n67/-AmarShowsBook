        </div>
    </div>
    <div id="upiOtpRow" class="otp-row">
        <div class="payment-field full">
            <label for="upiOtp">OTP</label>
            <input id="upiOtp" type="password" inputmode="numeric" maxlength="6" placeholder="Enter 6 digit OTP" />
        </div>
    </div>
</div>

<div id="cardDetails" class="method-details" data-method-panel="CARD">
    <h3 class="method-title">Card Details</h3>
