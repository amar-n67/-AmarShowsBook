@model BookingDraft

<div class="card">

    <h2>Payment</h2>

    <p>
        Amount: ₹@Model.TotalAmount
    </p>

    <div>
        <input type="radio"
               name="pay"
               value="UPI"
               checked
               onchange="toggleQR()">
        UPI
    </div>

    <div>
        <input type="radio"
               name="pay"
               value="CARD"
               onchange="toggleQR()">
        Card
    </div>

    <div>
        <input type="radio"
               name="pay"
               value="NETBANKING"
               onchange="toggleQR()">
        Net Banking
    </div>

    <div>
        <input type="radio"
               name="pay"
               value="QR"
               onchange="toggleQR()">
        QR Scan
    </div>


    <div id="qrSection"
         style="display:none">

        <img id="qrImage"
             width="250"/>
    </div>


    <button id="payButton"
            onclick="pay()">
        Pay
    </button>

</div>


<script>

async function toggleQR()
{
    let paymentMethod=

    document.querySelector(
    'input[name="pay"]:checked'
    ).value;


    if(paymentMethod==="QR")
    {
        document
        .getElementById(
        "qrSection")
        .style.display="block";


        document
        .getElementById(
        "payButton")
        .style.display="none";


        let response=

        await fetch(
        "/Booking/GenerateQR?bookingId=@Model.Id"
        );

        let result=
        await response.json();


        document
        .getElementById(
        "qrImage")
        .src=
        "/Booking/CreateQR?text="
        +
        encodeURIComponent(
        result.url);
    }
    else
    {
        document
        .getElementById(
        "qrSection")
        .style.display="none";

        document
        .getElementById(
        "payButton")
        .style.display="block";
    }
}


async function pay()
{
    let paymentMethod=

    document.querySelector(
    'input[name="pay"]:checked'
    ).value;


    let response=

    await fetch(
    "/Booking/CompletePayment",
    {
        method:"POST",

        headers:
        {
            "Content-Type":
            "application/json"
        },

        body:
        JSON.stringify(
        {
            bookingId:@Model.Id,
            paymentMethod:paymentMethod
        })
    });

    let result=
    await response.json();

    if(result.success)
{
    window.location=
    "/Booking/Confirmation?bookingId=@Model.Id";
}
else
{
    alert(
    "Transaction failed. Booking not completed");
}
}
let statusChecker=

setInterval(
checkQRStatus,
3000
);

async function checkQRStatus()
{
    let response=

    await fetch(
    "/Booking/CheckQRStatus?bookingId=@Model.Id"
    );

    let result=
    await response.json();

    if(result.status==="SUCCESS")
    {
        clearInterval(
        statusChecker);

        window.location=
        "/Booking/Confirmation?bookingId=@Model.Id";
    }

   if(result.status==="FAILED")
{
    clearInterval(
    statusChecker);

    window.location=
    "/Booking/Confirmation?bookingId=@Model.Id";
}
}
</script>