@model BookingDraft
@using AmarShowsBook.Helpers

@{
    var walletAmountUsed = ViewBag.WalletAmountUsed as decimal? ?? 0;
    var payableAmount = ViewBag.PayableAmount as decimal? ?? Model.TotalAmount;
}

<style>

:root{
--bg:#f4f7fc;
--card:rgba(255,255,255,.92);
--primary:#ff2d55;
--primary2:#7d4dff;
--success:#16db65;
--text:#111827;
--muted:#6b7280;
--border:rgba(0,0,0,.08);
}

body{
margin:0;
font-family:Segoe UI,sans-serif;
color:var(--text);
overflow-x:hidden;

background:
linear-gradient(
135deg,
#eef2ff,
#fdf2f8,
#f8fafc
);
}


/* animated moving light */

body::before{

content:"";

position:fixed;

width:200%;
height:200%;

top:-50%;
left:-50%;

background:
conic-gradient(
from 0deg,
rgba(255,45,85,.08),
transparent,
rgba(125,77,255,.06),
transparent
);

animation:
rotateBg 25s linear infinite;

pointer-events:none;

z-index:-2;
}


/* floating circles */

body::after{

content:"";

position:fixed;

width:100%;
height:100%;

background:

radial-gradient(
circle,
rgba(255,45,85,.12) 0,
transparent 10%
),

radial-gradient(
circle,
rgba(125,77,255,.08) 0,
transparent 8%
);

background-size:
250px 250px,
300px 300px;

animation:
floatDots 15s linear infinite;

pointer-events:none;

z-index:-1;
}


@@keyframes rotateBg{

100%{

transform:
rotate(360deg);

}

}


@@keyframes floatDots{

0%{

background-position:
0 0,
0 0;
}

100%{

background-position:
500px 600px,
-500px 400px;
}

}


/* container */

.payment-container{

max-width:850px;

margin:auto;

padding:50px 20px;

animation:
fadeUp .8s;
}


/* card */

.payment-card{

background:
var(--card);

backdrop-filter:
blur(30px);

border-radius:30px;

padding:35px;

border:
1px solid var(--border);

box-shadow:

0 15px 40px rgba(0,0,0,.08),
0 0 25px rgba(255,45,85,.08);

overflow:hidden;

position:relative;

animation:
cardGlow 5s infinite alternate;
}


@@keyframes cardGlow{

100%{

box-shadow:

0 20px 60px rgba(255,45,85,.12),
0 0 40px rgba(125,77,255,.08);

}

}


/* top animated line */

.payment-card::before{

content:"";

position:absolute;

top:0;
left:0;

width:100%;
height:5px;

background:
linear-gradient(
90deg,
#ff2d55,
#7d4dff,
#00cfff,
#ff2d55
);

background-size:300%;

animation:
moveGradient 5s linear infinite;
}

@@keyframes moveGradient{

100%{

background-position:
300%;
}

}


/* header */

.payment-header{

display:flex;

justify-content:space-between;

align-items:center;

padding-bottom:20px;

margin-bottom:25px;

border-bottom:
1px solid #eee;
}

.payment-header h2{

margin:0;

font-size:32px;

font-weight:900;
}


/* amount box */

.amount-box{

padding:30px;

border-radius:25px;

text-align:center;

background:

linear-gradient(
145deg,
white,
#fafafa
);

border:1px solid #ececec;

margin-bottom:30px;

transition:.4s;
}

.amount-box:hover{

transform:
translateY(-5px);
}


.amount{

font-size:50px;

font-weight:900;

color:var(--primary);

text-shadow:

0 0 15px rgba(255,45,85,.2);

animation:
pulseAmount 2s infinite;
}

@@keyframes pulseAmount{

50%{

transform:
scale(1.04);
}

}

.wallet-applied{

margin-top:12px;

font-weight:700;

color:var(--success);
}


/* payment methods */

.payment-grid{

display:grid;

grid-template-columns:
repeat(2,1fr);

gap:18px;
}


.payment-option{

padding:22px;

border-radius:20px;

background:white;

border:1px solid #ececec;

display:flex;

align-items:center;

gap:15px;

font-weight:800;

cursor:pointer;

transition:.4s;

transform-style:preserve-3d;
}

.payment-option:hover{

transform:

translateY(-10px)
rotateX(8deg);

box-shadow:

0 15px 30px rgba(0,0,0,.08);

border-color:
var(--primary);
}


.payment-option input{

transform:scale(1.2);

accent-color:
var(--primary);
}


/* QR */

#qrSection{

display:none;

margin-top:30px;

padding:25px;

border-radius:25px;

background:white;

border:1px solid #eee;

text-align:center;

animation:
fadeUp .5s;
}

#qrImage{

padding:10px;

background:white;

border-radius:18px;

box-shadow:

0 10px 30px rgba(0,0,0,.1);

animation:
floatQR 3s ease infinite;
}

@@keyframes floatQR{

50%{

transform:
translateY(-10px);

}

}

.scan-text{

margin-top:15px;

font-weight:700;

color:#666;
}

/* buttons container */

.action-buttons{

display:flex;
gap:15px;
margin-top:35px;

}


/* cancel button */

.cancel-btn{

flex:1;

padding:18px;

border:none;

border-radius:20px;

background:
linear-gradient(
90deg,
#ff4d4d,
#d10035
);

color:white;

font-size:18px;

font-weight:900;

cursor:pointer;

transition:.4s;

}

.cancel-btn:hover{

transform:
translateY(-5px);

box-shadow:
0 15px 35px rgba(255,0,50,.3);

}


/* pay button */

.pay-btn{

flex:2;

padding:18px;

border:none;

border-radius:20px;

background:
linear-gradient(
90deg,
#ff2d55,
#7d4dff
);

color:white;

font-size:18px;

font-weight:900;

cursor:pointer;

transition:.4s;

animation:
pulseBtn 2s infinite;

}

.pay-btn:hover{

transform:
translateY(-5px);

box-shadow:
0 15px 35px rgba(255,45,85,.25);

}
@@keyframes pulseBtn{

50%{

transform:
scale(1.02);
}

}


@@keyframes fadeUp{

from{

opacity:0;

transform:
translateY(30px);

}

to{

opacity:1;

transform:
translateY(0);

}

}


/* mobile */

@@media(max-width:768px){

.payment-grid{

grid-template-columns:1fr;
}

.payment-header{

flex-direction:column;

gap:15px;
}

.amount{

font-size:36px;
}

}

</style>


<div class="payment-container">

<div class="payment-card">

<div class="payment-header">

<h2>

💳 Payment

</h2>

<div style="color:#6b7280">

Booking #@Model.Id

</div>

</div>


<div class="amount-box">

<h3>

Total Payable

</h3>

<div class="amount">

@CurrencyFormatter.FormatRupees(
payableAmount
)

</div>

@if(walletAmountUsed>0)
{
<div class="wallet-applied">

Wallet used:

@CurrencyFormatter.FormatRupees(
walletAmountUsed
)

</div>
}

</div>



<div class="payment-grid">

<label class="payment-option">

<input
type="radio"
name="pay"
value="UPI"
checked
onchange="toggleQR()" />

📱 UPI

</label>


<label class="payment-option">

<input
type="radio"
name="pay"
value="CARD"
onchange="toggleQR()" />

💳 Card

</label>


<label class="payment-option">

<input
type="radio"
name="pay"
value="NETBANKING"
onchange="toggleQR()" />

🏦 Net Banking

</label>


<label class="payment-option">

<input
type="radio"
name="pay"
value="QR"
onchange="toggleQR()" />

🔳 QR Scan

</label>

</div>



<div id="qrSection">

<img
id="qrImage"
width="220" />

<div class="scan-text">

Scan QR using any UPI app

</div>

</div>
<div class="action-buttons">

<button
type="button"
class="cancel-btn"
onclick="cancelBooking()">

❌ Cancel

</button>

<button
id="payButton"
class="pay-btn"
type="button"
onclick="pay()">

Proceed Payment →

</button>

</div>
</div>
<script>

let statusChecker=null;


async function toggleQR()
{
    let paymentMethod=

    document.querySelector(
    'input[name="pay"]:checked'
    ).value;


    if(paymentMethod==="QR")
    {
        document
        .getElementById(
        "qrSection")
        .style.display="block";

        document
        .getElementById(
        "payButton")
        .style.display="none";


        @* let response=

        await fetch(
        "/Booking/GenerateQR?bookingId=@Model.Id"
        );

        let result=
        await response.json();


        document
        .getElementById(
        "qrImage")
        .src=
        "/Booking/CreateQR?text="
        +
        encodeURIComponent(
        result.url); *@

        try
{
    let response=

    await fetch(
    "/Booking/GenerateQR?bookingId=@Model.Id"
    );

    if(!response.ok)
    {
        throw new Error(
        "QR generation failed"
        );
    }

    let result=
    await response.json();

    if(!result.success)
    {
        throw new Error(
        "QR generation failed"
        );
    }

    document
    .getElementById(
    "qrImage"
    )
    .src=
    "/Booking/CreateQR?text="
    +
    encodeURIComponent(
    result.url
    );
}
catch(error)
{
    console.log(error);

    alert(
    "Unable to generate QR"
    );
}


        if(statusChecker)
        {
            clearInterval(
            statusChecker);
        }

        statusChecker=
        setInterval(
        checkQRStatus,
        3000
        );
    }
    else
    {
        document
        .getElementById(
        "qrSection")
        .style.display="none";

        document
        .getElementById(
        "payButton")
        .style.display="block";

        if(statusChecker)
{
    clearInterval(
    statusChecker
    );
}
    }
}

async function pay()
{
    const payButton =
    document.getElementById(
    "payButton");

    payButton.disabled =
    true;

    payButton.innerText =
    "Processing...";

    let paymentMethod=

    document.querySelector(
    'input[name="pay"]:checked'
    ).value;


    try
    {
        let response=

        await fetch(
        "/Booking/CompletePayment",
        {
            method:"POST",

            headers:
            {
                "Content-Type":
                "application/json"
            },

            body:
            JSON.stringify(
            {
                bookingId:@Model.Id,
                paymentMethod:paymentMethod
            })
        });

        let result=
        await response.json();


        if(result.success)
        {
            window.location=
            "/Booking/Confirmation?bookingId=@Model.Id";
        }
        else
        {
            alert(
            result.message || "Transaction Failed");

            payButton.disabled =
            false;

            payButton.innerText =
            "Pay Now";
        }
    }
    catch(error)
    {
        alert(
        "Payment could not be completed. Please try again.");

        payButton.disabled =
        false;

        payButton.innerText =
        "Pay Now";
    }
}



async function checkQRStatus()
{
    let response=

    await fetch(
    "/Booking/CheckQRStatus?bookingId=@Model.Id"
    );

    let result=
    await response.json();


    if(
    result.status==="SUCCESS"
    ||
    result.status==="FAILED"
    )
    {
        clearInterval(
        statusChecker);

        window.location=
        "/Booking/Confirmation?bookingId=@Model.Id";
    }
}
function cancelBooking()
{
    let confirmCancel=
    confirm(
    "Do you want to cancel booking?"
    );

    if(!confirmCancel)
    {
        return;
    }

    sessionStorage.setItem(
    "refreshHome",
    "true"
    );

    window.location.href=
    "/Home/Index";
}


/* refresh home page automatically */

window.addEventListener(
"load",
function()
{
    if(
        sessionStorage.getItem(
        "refreshHome"
        )
    )
    {
        sessionStorage.removeItem(
        "refreshHome"
        );

        setTimeout(
        ()=>location.reload(),
        100
        );
    }
});
</script>
