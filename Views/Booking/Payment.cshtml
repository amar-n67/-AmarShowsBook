@model BookingDraft

<div class="card">
    <h2>Payment</h2>

    <p>
        Amount: ₹@Model.TotalAmount
    </p>

    <div>
        <input type="radio" name="pay" value="UPI" checked />
        UPI
    </div>

    <div>
        <input type="radio" name="pay" value="CARD" />
        Card
    </div>

    <div>
        <input type="radio" name="pay" value="NETBANKING" />
        Net Banking
    </div>

    <div>
        <input type="radio" name="pay" value="QR" />
        QR Scan
    </div>

    <button onclick="pay()">
        Pay
    </button>
</div>

<script>

async function pay()
{
    const paymentMethod =
    document.querySelector(
    'input[name="pay"]:checked'
    ).value;

    const response =
    await fetch(
    "/Booking/CompletePayment",
    {
        method:"POST",

        headers:
        {
            'Content-Type':
            'application/json'
        },

        body:
        JSON.stringify(
        {
            bookingId:@Model.Id,
            paymentMethod:paymentMethod
        })
    });

    const result =
    await response.json();

    if(result.success)
    {
        alert(
        "Payment successful");

        window.location=
        "/Booking/Confirmation?bookingId=@Model.Id";
    }
    else
    {
        alert(
        "Payment failed");
    }
}

</script>