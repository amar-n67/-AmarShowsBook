    background:
        radial-gradient(circle at 12% 8%, rgba(240, 189, 79, 0.20), transparent 26%),
        radial-gradient(circle at 88% 10%, rgba(22, 143, 152, 0.14), transparent 24%),
        linear-gradient(120deg, #f7fbf8 0%, #fff5df 48%, #f5d5ca 100%);
}

.payment-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, 0.82fr);
    gap: 0;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 28px;
    color: #172033;
    background: rgba(255, 253, 248, 0.76);
    box-shadow: 0 24px 70px rgba(23, 32, 51, 0.16);
    backdrop-filter: blur(18px);
    animation: paymentStageIn 0.7s ease both;
}

.payment-card::before {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    width: auto;
    height: 5px;
    content: "";
    background: linear-gradient(90deg, #e45d48, #f0bd4f, #168f98, #3758d6);
    background-size: 220% 100%;
    animation: paymentGradientRun 5.4s linear infinite;
}

.payment-header {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 22px;
    align-items: start;
    margin: 0;
    padding: clamp(22px, 4vw, 34px);
    border-bottom: 1px solid rgba(23, 32, 51, 0.12);
    background: transparent;
}

.payment-title-block {
    display: grid;
    gap: 10px;
}

.payment-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    padding: 8px 13px 8px 9px;
    border: 1px solid rgba(23, 32, 51, 0.10);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.66);
    color: #172033;
    font-weight: 900;
    box-shadow: 0 12px 28px rgba(23, 32, 51, 0.08);
}

.payment-brand img {
    width: 38px;
    height: 38px;
    object-fit: contain;
}

.payment-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #20364a;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
}

.payment-kicker::before {
    width: 36px;
    height: 3px;
    border-radius: 999px;
    content: "";
    background: linear-gradient(90deg, #e45d48, #f0bd4f, #168f98);
}

.payment-header h2 {
    margin: 0;
    color: #101826;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.96;
    font-weight: 900;
    letter-spacing: 0;
}

.payment-reference {
    align-self: start;
    padding: 10px 14px;
    border: 1px solid rgba(23, 32, 51, 0.10);
    border-radius: 999px;
    color: #5a667a;
    background: rgba(255, 255, 255, 0.62);
    font-weight: 900;
    white-space: nowrap;
}

.payment-card > .payment-step {
    grid-column: 1;
    margin: 0;
    padding: 22px clamp(20px, 3vw, 30px);
    border-bottom: 1px solid rgba(23, 32, 51, 0.10);
}

.payment-card > .payment-step:last-child {
    border-bottom: 0;
}

.payment-deadline {
    grid-column: 1;
    margin: 0;
    padding: 22px clamp(20px, 3vw, 30px);
    border: 0;
    border-bottom: 1px solid rgba(23, 32, 51, 0.10);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.36);
    box-shadow: none;
}

.payment-deadline span,
.payment-field label,
.step-title strong,
.amount-box h3 {
    letter-spacing: 0;
}

.payment-deadline span {
    color: #5a667a;
}

.payment-deadline strong {
    color: #172033;
}

.deadline-clock {
    --timer-color: #168f98;
    --timer-glow: rgba(22, 143, 152, 0.24);
    width: 92px;
    height: 92px;
    min-width: 92px;
    background: conic-gradient(var(--timer-color) 0 var(--timer-progress), rgba(23, 32, 51, 0.10) var(--timer-progress) 360deg);
    box-shadow: 0 14px 30px var(--timer-glow), inset 0 0 0 1px rgba(255, 255, 255, 0.72);
}

.deadline-clock::before {
    background:
        repeating-conic-gradient(from -1deg, rgba(23, 32, 51, 0.24) 0deg 2deg, transparent 2deg 30deg),
        radial-gradient(circle at 32% 24%, #fff, rgba(255, 255, 255, 0.88) 48%, #f8fafc 100%);
}

.amount-box {
    position: relative;
    grid-column: 2;
    grid-row: 2 / span 4;
    align-items: stretch;
    justify-content: flex-start;
    margin: 0;
    padding: clamp(22px, 3vw, 30px);
    border: 0;
    border-left: 1px solid rgba(23, 32, 51, 0.10);
    border-radius: 0;
    background:
        radial-gradient(circle at 85% 8%, rgba(240, 189, 79, 0.22), transparent 28%),
        linear-gradient(145deg, rgba(255, 255, 255, 0.68), rgba(255, 253, 248, 0.52));
    text-align: left;
}

.amount-box:hover {
    transform: none;
}

.amount-box .step-title {
    justify-content: flex-start;
    margin-bottom: 12px;
}

.amount-box h3 {
    margin: 0 0 8px;
    color: #5a667a;
}

.amount {
    color: #101826;
    font-size: clamp(2.3rem, 5vw, 3.6rem);
    line-height: 1;
    text-shadow: none;
    animation: amountFloat 3.4s ease-in-out infinite;
}

.wallet-applied {
    display: block;
    margin-top: 12px;
    padding: 10px 12px;
    border: 1px solid rgba(22, 143, 152, 0.20);
    border-radius: 14px;
    color: #0f766e;
    background: rgba(22, 143, 152, 0.10);
    font-size: 0.88rem;
}

.step-title {
    gap: 10px;
    margin-bottom: 14px;
    color: #172033;
}

.step-title::before {
    display: inline-block;
    width: 10px;
    height: 30px;
    border-radius: 999px;
    content: "";
    background: linear-gradient(180deg, #e45d48, #f0bd4f, #168f98);
}

.step-title span {
    display: none;
}

.step-title strong {
    color: #172033;
    font-size: 1rem;
    font-weight: 900;
    text-transform: none;
}

.payment-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
}

.payment-option,
.method-details,
#qrSection,
.payment-status {
    border: 1px solid rgba(23, 32, 51, 0.12);
    background: rgba(255, 255, 255, 0.66);
    box-shadow: 0 14px 30px rgba(23, 32, 51, 0.07);
}

.payment-option {
    min-height: 64px;
    padding: 14px;
    border-radius: 18px;
    color: #172033;
    font-weight: 900;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.payment-option:hover {
    border-color: rgba(22, 143, 152, 0.32);
    transform: translateY(-3px);
    box-shadow: 0 18px 38px rgba(23, 32, 51, 0.10);
}

.payment-option:has(input:checked) {
    border-color: rgba(22, 143, 152, 0.46);
    background:
        radial-gradient(circle at 18% 20%, rgba(240, 189, 79, 0.22), transparent 42%),
        rgba(255, 255, 255, 0.74);
    box-shadow: 0 0 0 4px rgba(22, 143, 152, 0.12), 0 18px 38px rgba(23, 32, 51, 0.10);
}

.payment-option input {
    accent-color: #168f98;
}

.method-details {
    border-radius: 22px;
    padding: 22px;
    animation: paymentStageIn 0.35s ease;
}

.method-title {
    color: #172033;
    font-weight: 900;
}

.payment-field label {
    color: #5a667a;
}

.payment-field input,
.payment-field select {
    height: 48px;
    border: 1px solid rgba(23, 32, 51, 0.14);
    border-radius: 16px;
    color: #172033;
    background: rgba(255, 255, 255, 0.78);
    font-weight: 800;
}

.payment-field input:focus,
.payment-field select:focus {
    border-color: #168f98;
    box-shadow: 0 0 0 4px rgba(22, 143, 152, 0.14);
    background: rgba(255, 255, 255, 0.92);
}

.field-hint {
    color: #5a667a;
}

.upi-handle-options button,
.saved-detail-btn,
.otp-send-btn {
    border-radius: 999px;
    font-weight: 900;
}

.upi-handle-options button,
.saved-detail-btn {
    border-color: rgba(23, 32, 51, 0.12);
    color: #20364a;
    background: rgba(255, 255, 255, 0.68);
}

.upi-handle-options button.active,
.upi-handle-options button:hover,
.saved-detail-btn:hover {
    border-color: rgba(22, 143, 152, 0.36);
    color: #0f766e;
    background: rgba(22, 143, 152, 0.10);
}

.saved-detail-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 0;
    padding: 2px 3px;
    border: 0;
    border-radius: 0;
    color: #0f766e;
    background:
        linear-gradient(transparent 58%, rgba(240, 189, 79, 0.46) 58%),
        transparent;
    box-shadow: none;
    font-size: 0.92rem;
    line-height: 1.4;
    text-align: left;
    text-decoration: underline;
    text-decoration-color: rgba(22, 143, 152, 0.55);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
}

.saved-detail-btn:hover,
.saved-detail-btn:focus-visible {
    color: #3758d6;
    background:
        linear-gradient(transparent 52%, rgba(240, 189, 79, 0.64) 52%),
        transparent;
    box-shadow: none;
    text-decoration-color: currentColor;
    outline: none;
}

.real-card-stage {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    perspective: 1200px;
    margin: 4px 0 18px;
}

.live-card-preview {
    width: min(100%, 410px);
    aspect-ratio: 1.585;
    perspective: 1200px;
}

.live-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.72s cubic-bezier(0.2, 0.9, 0.22, 1);
}

.live-card-preview.is-flipped .live-card-inner {
    transform: rotateY(180deg);
}

.live-card-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(18px, 4vw, 24px);
    border: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 24px;
    color: #fffefa;
    backface-visibility: hidden;
    box-shadow: 0 22px 48px rgba(23, 32, 51, 0.22);
}

.live-card-face::before {
    position: absolute;
    inset: -40% -22% auto auto;
    width: 78%;
    aspect-ratio: 1;
    border-radius: 50%;
    content: "";
    background: radial-gradient(circle, rgba(240, 189, 79, 0.55), transparent 68%);
    animation: liveCardAura 6s ease-in-out infinite;
}

.live-card-face::after {
    position: absolute;
    inset: 0;
    content: "";
    background:
        linear-gradient(115deg, transparent 0 34%, rgba(255, 255, 255, 0.18) 45%, transparent 56%),
        repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 18px);
    opacity: 0.55;
    transform: translateX(-42%);
    animation: liveCardShine 4.8s ease-in-out infinite;
}

.live-card-front {
    background:
        radial-gradient(circle at 18% 22%, rgba(240, 189, 79, 0.34), transparent 30%),
        radial-gradient(circle at 88% 18%, rgba(22, 143, 152, 0.48), transparent 34%),
        linear-gradient(135deg, #172033 0%, #3758d6 50%, #8a3c6b 100%);
}

.live-card-back {
    transform: rotateY(180deg);
    background:
        radial-gradient(circle at 16% 24%, rgba(228, 93, 72, 0.34), transparent 30%),
        radial-gradient(circle at 88% 10%, rgba(22, 143, 152, 0.42), transparent 34%),
        linear-gradient(135deg, #101826 0%, #20364a 55%, #0f766e 100%);
}

.live-card-top,
.live-card-chip-row,
.live-card-meta,
.live-card-signature,
.live-card-back-note {
    position: relative;
    z-index: 1;
}

.live-card-top,
.live-card-chip-row,
.live-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.live-card-bank {
    font-size: 0.9rem;
    font-weight: 950;
    letter-spacing: 0;
}

.live-card-network {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 5px 10px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    font-size: 0.72rem;
    font-weight: 950;
}

.live-card-chip {
    width: 48px;
    height: 36px;
    border: 1px solid rgba(255, 255, 255, 0.44);
    border-radius: 10px;
    background:
        linear-gradient(90deg, transparent 31%, rgba(23, 32, 51, 0.24) 32% 34%, transparent 35% 64%, rgba(23, 32, 51, 0.24) 65% 67%, transparent 68%),
        linear-gradient(180deg, transparent 45%, rgba(23, 32, 51, 0.22) 46% 50%, transparent 51%),
        linear-gradient(135deg, #f9e58c, #d6a53c);
    box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.34), 0 10px 18px rgba(23, 32, 51, 0.18);
}

.live-card-contactless {
    position: relative;
    width: 38px;
    height: 28px;
}

.live-card-contactless::before,
.live-card-contactless::after {
    position: absolute;
    inset: 0;
    content: "";
    border: 2px solid rgba(255, 255, 255, 0.70);
    border-left-color: transparent;
    border-bottom-color: transparent;
    border-radius: 50%;
    transform: rotate(45deg);
}

.live-card-contactless::after {
    inset: 6px;
}

.live-card-number {
    position: relative;
    z-index: 1;
    min-height: 38px;
    font-size: clamp(1.28rem, 5vw, 1.9rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    font-variant-numeric: tabular-nums;
    transition: transform 0.24s ease, color 0.24s ease;
}

.live-card-number.is-changing,
.live-card-meta strong.is-changing,
.live-card-cvv.is-changing {
    animation: cardValuePop 0.36s ease;
}

.live-card-meta small,
.live-card-signature span,
.live-card-back-note {
    display: block;
    color: rgba(255, 255, 255, 0.70);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
}

.live-card-meta strong {
    display: block;
    margin-top: 4px;
    font-size: 0.96rem;
    font-weight: 950;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
}

.live-card-strip {
    position: relative;
    z-index: 1;
    height: 46px;
    margin: 12px -24px 0;
    background: rgba(5, 10, 18, 0.82);
}

.live-card-signature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 86px;
    align-items: center;
    gap: 10px;
}

.live-card-signature span {
    display: flex;
    align-items: flex-end;
    height: 42px;
    padding: 0 10px 6px;
    border-radius: 8px;
    color: rgba(23, 32, 51, 0.58);
    background:
        repeating-linear-gradient(-8deg, rgba(23, 32, 51, 0.18) 0 8px, transparent 8px 16px),
        rgba(255, 255, 255, 0.86);
    font-size: 0.58rem;
    text-transform: uppercase;
}

.live-card-cvv {
    display: grid;
    place-items: center;
    min-height: 42px;
    border-radius: 8px;
    color: #172033;
    background: rgba(255, 255, 255, 0.92);
    font-size: 1.05rem;
    font-weight: 950;
    font-variant-numeric: tabular-nums;
}

.live-card-back-note {
    position: relative;
    z-index: 1;
    margin: 0;
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.45;
    text-transform: none;
}

@@keyframes liveCardAura {
    50% {
        transform: translate(-16px, 14px) scale(1.08);
        opacity: 0.78;
    }
}

@@keyframes liveCardShine {
    50% {
        transform: translateX(42%);
    }
}

@@keyframes cardValuePop {
    0% {
        transform: translateY(4px);
        opacity: 0.62;
    }

    100% {
        transform: translateY(0);
        opacity: 1;
    }
}

.otp-send-btn {
    background: linear-gradient(135deg, #168f98, #0f766e);
}

.validation-message {
    border-radius: 16px;
}

.validation-message.error {
    color: #9f2e27;
    background: rgba(228, 93, 72, 0.12);
}

.validation-message.success {
    color: #0f766e;
    background: rgba(22, 143, 152, 0.12);
}

.payment-status {
    border-radius: 18px;
}

.payment-status-text {
    color: #5a667a;
}

.payment-status-track {
    background: rgba(23, 32, 51, 0.08);
}

.payment-status-fill {
    background: linear-gradient(90deg, #e45d48, #f0bd4f, #168f98, #3758d6);
}

#qrSection {
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.66);
}

#qrImage {
    border-radius: 18px;
    animation: qrFloat 3.4s ease-in-out infinite;
}

.scan-text {
    color: #5a667a;
}

.action-buttons {
    align-items: stretch;
    gap: 12px;
    margin-top: 6px;
}

.cancel-btn,
.pay-btn {
    min-height: 52px;
    border-radius: 999px;
    font-size: 0.98rem;
    font-weight: 900;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
}

.cancel-btn {
    flex: 0 0 140px;
    border: 1px solid rgba(228, 93, 72, 0.30);
    color: #9f2e27;
    background: rgba(228, 93, 72, 0.10);
}

.pay-btn {
    flex: 1 1 auto;
    color: #fffefa;
    background: linear-gradient(135deg, #168f98, #3758d6);
    box-shadow: 0 16px 34px rgba(55, 88, 214, 0.16);
}

.cancel-btn:hover,
.pay-btn:hover {
    transform: translateY(-3px);
}

.cancel-btn:hover {
    box-shadow: 0 14px 28px rgba(228, 93, 72, 0.16);
}

.pay-btn:hover {
    box-shadow: 0 18px 38px rgba(55, 88, 214, 0.22);
}

@@keyframes paymentStageIn {
    from {
        opacity: 0;
        transform: translateY(22px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes paymentGradientRun {
    to {
        background-position: 220% 0;
    }
}

@@keyframes amountFloat {
    50% {
        transform: translateY(-4px);
    }
}

@@keyframes qrFloat {
    50% {
        transform: translateY(-8px);
    }
}

@@media (max-width: 960px) {
    .payment-card {
        grid-template-columns: 1fr;
    }

    .payment-header,
    .payment-deadline,
    .payment-card > .payment-step,
    .amount-box {
        grid-column: 1;
    }

    .amount-box {
        grid-row: auto;
        border-left: 0;
        border-bottom: 1px solid rgba(23, 32, 51, 0.10);
    }

    .payment-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media (max-width: 640px) {
    .payment-container {
        padding-inline: 10px;
    }

    .payment-card {
        border-radius: 22px;
    }

    .payment-header {
        grid-template-columns: 1fr;
    }

    .payment-reference {
        width: fit-content;
    }

    .payment-header h2 {
        font-size: clamp(2.2rem, 13vw, 4rem);
    }

    .payment-deadline {
        align-items: flex-start;
        flex-direction: column;
    }

    .payment-grid,
    .field-grid,
    .otp-row {
        grid-template-columns: 1fr;
    }

    .action-buttons {
        flex-direction: column;
    }

    .cancel-btn,
    .pay-btn {
        flex: 1 1 auto;
        width: 100%;
    }
}

/* Keeps the animated payment screen tied to the active application theme. */
:root {
    --bg: var(--app-bg, #f4f7fc);
    --card: var(--app-card, rgba(255, 255, 255, 0.92));
    --primary: var(--app-primary, #ff2d55);
    --primary2: var(--app-accent-strong, #7d4dff);
    --success: var(--app-success, #16db65);
    --text: var(--app-card-text, #111827);
    --muted: var(--app-muted, #6b7280);
    --border: var(--app-input-border, rgba(0, 0, 0, 0.08));
    --payment-solid-bg: var(--app-bg, #f4f7fc);
    --payment-page-bg: var(--app-profile-bg, var(--app-bg, #f4f7fc));
    --payment-page-text: var(--app-page-text, var(--app-card-text, #111827));
    --payment-card-bg: color-mix(in srgb, var(--app-card, #ffffff) 88%, transparent);
    --payment-soft-bg: color-mix(in srgb, var(--app-input, #ffffff) 74%, transparent);
    --payment-strong-bg: color-mix(in srgb, var(--app-card, #ffffff) 92%, var(--app-bg, #f4f7fc) 8%);
    --payment-border: color-mix(in srgb, var(--app-input-border, #d1d5db) 78%, transparent);
    --payment-muted: var(--app-muted, #6b7280);
    --payment-primary: var(--app-primary, #3858d6);
    --payment-accent: var(--app-accent-strong, #168f98);
    --payment-warm: var(--app-accent, #f0bd4f);
    --payment-danger: var(--app-danger, #dc2626);
    --payment-success: var(--app-success, #16a34a);
    --payment-shadow: 0 24px 70px color-mix(in srgb, #000000 18%, transparent);
}

html[data-theme] body {
    color: var(--payment-page-text);
    background: var(--payment-page-bg);
}

body::before {
    background:
        conic-gradient(
            from 0deg,
            color-mix(in srgb, var(--payment-primary) 10%, transparent),
            transparent,
            color-mix(in srgb, var(--payment-accent) 9%, transparent),
            transparent);
}

body::after {
    background:
        radial-gradient(circle, color-mix(in srgb, var(--payment-primary) 10%, transparent) 0, transparent 10%),
        radial-gradient(circle, color-mix(in srgb, var(--payment-accent) 9%, transparent) 0, transparent 8%);
}

.payment-container::before {
    background:
        radial-gradient(circle at 12% 8%, color-mix(in srgb, var(--payment-warm) 25%, transparent), transparent 26%),
        radial-gradient(circle at 88% 10%, color-mix(in srgb, var(--payment-accent) 20%, transparent), transparent 24%),
        linear-gradient(120deg, color-mix(in srgb, var(--payment-solid-bg) 84%, var(--payment-card-bg) 16%), var(--payment-strong-bg));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--payment-border) 72%, transparent);
}

.payment-container::after {
    background-image:
        linear-gradient(color-mix(in srgb, var(--payment-page-text) 7%, transparent) 1px, transparent 1px),
        linear-gradient(90deg, color-mix(in srgb, var(--payment-page-text) 7%, transparent) 1px, transparent 1px);
}

.payment-card {
    border-color: var(--payment-border);
    color: var(--payment-page-text);
    background: var(--payment-card-bg);
    box-shadow: var(--payment-shadow);
}

.payment-card::before,
.payment-kicker::before,
.step-title::before,
.payment-status-fill {
    background: linear-gradient(90deg, var(--payment-primary), var(--payment-warm), var(--payment-accent));
}

.payment-header {
    border-bottom-color: var(--payment-border);
}

.payment-card > .payment-step,
.payment-deadline {
    border-bottom-color: var(--payment-border);
}

.amount-box {
    border-left-color: var(--payment-border);
    background:
        radial-gradient(circle at 85% 8%, color-mix(in srgb, var(--payment-warm) 18%, transparent), transparent 28%),
        linear-gradient(145deg, color-mix(in srgb, var(--payment-card-bg) 94%, var(--payment-accent) 6%), var(--payment-card-bg));
}

.payment-brand,
.payment-reference,
.payment-deadline,
.payment-option,
.method-details,
#qrSection,
.payment-status,
.upi-handle-options button,
.saved-detail-btn {
    border-color: var(--payment-border);
    color: var(--payment-page-text);
    background: var(--payment-soft-bg);
    box-shadow: 0 14px 30px color-mix(in srgb, #000000 9%, transparent);
}

.payment-kicker,
.payment-reference,
.payment-deadline span,
.amount-box h3,
.payment-field label,
.field-hint,
.payment-status-text,
.scan-text {
    color: var(--payment-muted);
}

.payment-header h2,
.payment-deadline strong,
.step-title,
.step-title strong,
.method-title,
.payment-option,
.amount {
