        linear-gradient(135deg, color-mix(in srgb, #101826 80%, var(--payment-primary) 20%) 0%, var(--payment-primary) 50%, color-mix(in srgb, var(--payment-accent) 80%, #101826 20%) 100%);
}

.live-card-back {
    background:
