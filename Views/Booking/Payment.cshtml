@model BookingDraft
@using AmarShowsBook.Helpers
@using System.Text.Json

@{
    var walletAmountUsed = ViewBag.WalletAmountUsed as decimal? ?? 0;
    var couponDiscount = ViewBag.CouponDiscount as decimal? ?? 0;
    var payableAmount = ViewBag.PayableAmount as decimal? ?? Model.TotalAmount;
    var savedDetails = ViewBag.SavedPaymentDetails as List<AmarShowsBook.Models.PaymentMethodDetail>
        ?? new List<AmarShowsBook.Models.PaymentMethodDetail>();
    var savedUpi = savedDetails.FirstOrDefault(x => x.PaymentMethod == "UPI");
    var savedCard = savedDetails.FirstOrDefault(x => x.PaymentMethod == "CARD");
    var savedNetbanking = savedDetails.FirstOrDefault(x => x.PaymentMethod == "NETBANKING");
}

