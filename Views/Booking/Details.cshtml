@model BookingDraft
@using AmarShowsBook.Helpers

@{
    var schedule = ViewBag.Schedule;
    var user = ViewBag.User;
    var wallet = ViewBag.Wallet as AmarShowsBook.Models.Admin.VwWalletSummary;
    var walletAmountUsed = ViewBag.WalletAmountUsed as decimal? ?? 0;
    var usableWallet = wallet?.WalletStatus == "ACTIVE"
        ? Math.Max(0, wallet.WalletBalance - wallet.BlockedBalance)
        : 0;
    var payableAmount = Math.Max(0, Model.TotalAmount - walletAmountUsed);

    string title =
    schedule?.Movie?.Title
    ??
    schedule?.StandupShow?.Title
    ??
    schedule?.LiveStream?.Title
    ??
    "Unknown Show";


    string theater =
    schedule?.Location?.Area
    ??
    "Unknown Theater";


    string location =

    schedule?.Location!=null

    ?

    $"{schedule.Location.State}, {schedule.Location.Country}"

    :

    "Location unavailable";


    string email =
    user?.Email
    ??
    "Not Available";


    string mobile =
    user?.Mobile
    ??
    "Not Available";


    string showTime =

    schedule?.StartTime!=null
    ?

    schedule.StartTime.ToString(
    "dd MMM yyyy hh:mm tt")

    :

    "N/A";
}

<style>

body{
background:#f4f6f9;
}

.booking-container{
width:800px;
margin:40px auto;
}

.ticket-card{
background:white;
border-radius:25px;
overflow:hidden;
box-shadow:0 10px 30px rgba(0,0,0,.15);
}

.ticket-header{
background:linear-gradient(
135deg,
#1e3c72,
#2a5298);

color:white;
padding:30px;
text-align:center;
}

.ticket-body{
padding:30px;
}

.detail-row{
display:flex;
justify-content:space-between;
padding:15px 0;
border-bottom:1px solid #eee;
}

.label{
font-weight:bold;
color:#666;
}

.value{
font-weight:bold;
font-size:18px;
}

.amount{
color:#0d6efd;
font-size:26px;
}

.status{
padding:6px 15px;
border-radius:20px;
color:white;
background:orange;
}

.btn-section{
margin-top:30px;
display:flex;
justify-content:space-between;
}

.btn{

padding:15px 30px;
border:none;
border-radius:30px;
cursor:pointer;
font-weight:bold;
color:white;
text-decoration:none;
}

.pay-btn{
background:linear-gradient(
135deg,
#28a745,
#0d6efd);
}

.back-btn{
background:#777;
}

.cancel-btn{
background:#dc2626;
}

.wallet-panel{
margin-top:22px;
padding:18px;
border:1px solid #dbeafe;
border-radius:18px;
background:#f8fafc;
}

.wallet-panel h3{
margin:0 0 12px;
color:#0f172a;
}

.wallet-form{
display:flex;
gap:10px;
margin-top:14px;
}

.wallet-form input{
flex:1;
padding:12px 14px;
border:1px solid #cbd5e1;
border-radius:12px;
font-weight:800;
}

.wallet-form button{
border:0;
padding:12px 18px;
border-radius:12px;
background:#0f766e;
color:#fff;
font-weight:900;
}

.amount-breakdown{
margin-top:12px;
display:grid;
gap:8px;
}

</style>


<div class="booking-container">

<div class="ticket-card">

<div class="ticket-header">

<h2>
🎟 Booking Details
</h2>

</div>

<div class="ticket-body">

@if(TempData["Success"]!=null)
{
<div class="alert alert-success">
@TempData["Success"]
</div>
}

<div class="detail-row">
<div class="label">
Booking Id
</div>

<div class="value">
#@Model.Id
</div>
</div>


<div class="detail-row">
<div class="label">
Movie / Show
</div>

<div class="value">
@title
</div>
</div>


<div class="detail-row">
<div class="label">
Seat Numbers
</div>

<div class="value">
@Model.SeatNumbers
</div>
</div>


<div class="detail-row">
<div class="label">
Show Time
</div>

<div class="value">
@showTime
</div>
</div>


<div class="detail-row">
<div class="label">
Theater
</div>

<div class="value">
@theater
</div>
</div>


<div class="detail-row">
<div class="label">
Location
</div>

<div class="value">
@location
</div>
</div>


<div class="detail-row">
<div class="label">
Email
</div>

<div class="value">
@email
</div>
</div>


<div class="detail-row">
<div class="label">
Mobile
</div>

<div class="value">
@mobile
</div>
</div>


<div class="detail-row">
<div class="label">
Amount
</div>

<div class="value amount">
@CurrencyFormatter.FormatRupees(Model.TotalAmount)
</div>
</div>

<div class="wallet-panel">
<h3>
Wallet
</h3>

<div class="amount-breakdown">
<div>
Available:
<strong>@CurrencyFormatter.FormatRupees(usableWallet)</strong>
</div>
<div>
Wallet Used:
<strong>@CurrencyFormatter.FormatRupees(walletAmountUsed)</strong>
</div>
<div>
Payable:
<strong>@CurrencyFormatter.FormatRupees(payableAmount)</strong>
</div>
</div>

<form class="wallet-form" method="post" action="/Booking/ApplyWallet">
@Html.AntiForgeryToken()
<input type="hidden" name="bookingId" value="@Model.Id" />
<input
type="number"
name="walletAmount"
min="0"
step="0.01"
max="@Math.Min(usableWallet, Model.TotalAmount)"
value="@walletAmountUsed"
placeholder="Wallet amount" />
<button type="submit">
Apply
</button>
</form>
</div>


<div class="detail-row">

<div class="label">
Status
</div>

<div>
<span class="status">
@Model.Status
</span>
</div>

</div>


<div class="btn-section">

<a
class="btn back-btn"
href="javascript:history.back()">

← Back

</a>

<a
class="btn cancel-btn"
href="/Home/Index">

Cancel

</a>

<button
type="button"
class="btn pay-btn"
onclick="location.href='/Booking/Payment?bookingId=@Model.Id'">

💳 Proceed To Payment

</button>

</div>

</div>

</div>

</div>
