@model BookingDraft
@using AmarShowsBook.Helpers

@{
    var schedule = ViewBag.Schedule;
    var user = ViewBag.User;
    var wallet = ViewBag.Wallet as AmarShowsBook.Models.Admin.VwWalletSummary;

    var walletAmountUsed =
    ViewBag.WalletAmountUsed as decimal? ?? 0;

    var usableWallet =
    wallet?.WalletStatus=="ACTIVE"
    ?
    Math.Max(
    0,
    wallet.WalletBalance-wallet.BlockedBalance
    )
    :
    0;

    var couponDiscount =
    ViewBag.CouponDiscount as decimal? ?? 0;

    var finalPayable =
    Math.Max(
    0,
    Model.TotalAmount
    -walletAmountUsed
    -couponDiscount
    );

    string title =
    schedule?.Movie?.Title
    ??
    schedule?.StandupShow?.Title
    ??
    schedule?.LiveStream?.Title
    ??
    "Unknown Show";

    string theater =
    schedule?.Location?.Area
    ??
    "Unknown Theater";

    string location =
    schedule?.Location!=null
    ?
    $"{schedule.Location.State}, {schedule.Location.Country}"
    :
    "Location unavailable";

    string email =
    user?.Email
    ??
    "Not Available";

    string mobile =
    user?.Mobile
    ??
    "Not Available";

    string showTime =
    schedule?.StartTime!=null
    ?
    schedule.StartTime.ToString(
    "dd MMM yyyy hh:mm tt")
    :
    "N/A";
}

<style>

:root{

--bg:#f5f7fb;
--card:#fff;
--text:#111827;
--muted:#6b7280;

--primary:#4f46e5;
--success:#16a34a;
--danger:#dc2626;

--border:#e5e7eb;

}

body{

background:var(--bg);

font-family:
Segoe UI,sans-serif;

color:var(--text);

}


.booking-container{

max-width:850px;

margin:40px auto;

padding:20px;

animation:fadeUp .5s;

}


.booking-card{

background:var(--card);

border-radius:25px;

padding:30px;

border:1px solid var(--border);

box-shadow:
0 15px 40px rgba(0,0,0,.05);

}


.booking-header{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:25px;

padding-bottom:25px;

border-bottom:1px solid var(--border);

}


.booking-header h2{

margin:0;

font-size:28px;

font-weight:800;

}


.status{

padding:8px 16px;

border-radius:999px;

background:#fff7ed;

color:#ea580c;

font-size:13px;

font-weight:700;

}


.info-grid{

display:grid;

grid-template-columns:
1fr 1fr;

gap:15px;

margin-bottom:25px;

}


.info-box{

padding:18px;

border-radius:16px;

background:#fafafa;

border:1px solid transparent;

transition:.3s;

}


.info-box:hover{

border-color:#d1d5db;

transform:translateY(-2px);

}


.label{

font-size:13px;

color:var(--muted);

margin-bottom:6px;

}


.value{

font-size:16px;

font-weight:700;

}



.section{

margin-top:25px;

padding:22px;

border-radius:20px;

background:#fafafa;

border:1px solid var(--border);

}


.section-title{

font-size:18px;

font-weight:800;

margin-bottom:20px;

}


.wallet-stats{

display:flex;

justify-content:space-between;

margin-bottom:20px;

}


.wallet-stats div{

text-align:center;

}


.wallet-stats span{

display:block;

font-size:13px;

color:var(--muted);

margin-bottom:5px;

}


.wallet-stats strong{

font-size:18px;

}



.form-row{

display:flex;

gap:12px;

}


.form-row input{

flex:1;

padding:12px;

border-radius:12px;

border:1px solid var(--border);

outline:none;

}


.form-row button{

border:none;

padding:12px 18px;

border-radius:12px;

background:var(--primary);

color:white;

font-weight:700;

cursor:pointer;

}



.price-breakdown{

display:flex;

flex-direction:column;

gap:10px;

}


.price-breakdown div{

display:flex;

justify-content:space-between;

padding:14px;

border-radius:12px;

background:white;

border:1px solid var(--border);

}


.total{

background:#ecfdf5 !important;

border:1px solid #bbf7d0 !important;

}


.total strong{

color:var(--success);

font-size:22px;

}



.actions{

margin-top:30px;

display:flex;

gap:15px;

justify-content:flex-end;

}


.btn{

padding:13px 20px;

border:none;

border-radius:12px;

font-weight:700;

cursor:pointer;

text-decoration:none;

}


.back-btn{

background:#e5e7eb;

color:black;

}


.cancel-btn{

background:var(--danger);

color:white;

}


.pay-btn{

background:var(--primary);

color:white;

}


.btn:hover{

opacity:.9;

transform:translateY(-2px);

}



@@keyframes fadeUp{

from{

opacity:0;

transform:translateY(15px);

}

to{

opacity:1;

transform:translateY(0);

}

}



@@media(max-width:768px){

.booking-container{

padding:12px;

}


.booking-card{

padding:20px;

}


.booking-header{

flex-direction:column;

align-items:flex-start;

gap:10px;

}


.info-grid{

grid-template-columns:1fr;

}


.wallet-stats{

flex-direction:column;

gap:15px;

}


.form-row{

flex-direction:column;

}


.actions{

flex-direction:column;

}


.btn{

width:100%;

text-align:center;

}

}

</style>



<div class="booking-container">

<div class="booking-card">

<div class="booking-header">

<div>

<h2>@title</h2>

<div style="color:#6b7280">

Booking #@Model.Id

</div>

</div>

<span class="status">

@Model.Status

</span>

</div>



<div class="info-grid">

<div class="info-box">
<div class="label">Seats</div>
<div class="value">🍿 @Model.SeatNumbers</div>
</div>

<div class="info-box">
<div class="label">Show Time</div>
<div class="value">@showTime</div>
</div>

<div class="info-box">
<div class="label">Theater</div>
<div class="value">@theater</div>
</div>

<div class="info-box">
<div class="label">Location</div>
<div class="value">@location</div>
</div>

<div class="info-box">
<div class="label">Email</div>
<div class="value">@email</div>
</div>

<div class="info-box">
<div class="label">Mobile</div>
<div class="value">@mobile</div>
</div>

</div>



<!-- Wallet -->

<div class="section">

<div class="section-title">

💰 Wallet

</div>

<div class="wallet-stats">

<div>
<span>Available</span>
<strong>
@CurrencyFormatter.FormatRupees(
usableWallet)
</strong>
</div>

<div>
<span>Used</span>
<strong>
@CurrencyFormatter.FormatRupees(
walletAmountUsed)
</strong>
</div>

</div>

<form
class="form-row"
method="post"
action="/Booking/ApplyWallet">

@Html.AntiForgeryToken()

<input
type="hidden"
name="bookingId"
value="@Model.Id"/>

<input
type="number"
name="walletAmount"
value="@walletAmountUsed"
step="0.01"
placeholder="Wallet amount"/>

<button>

Apply

</button>

</form>

</div>



<!-- Coupon -->

<div class="section">

<div class="section-title">

🎁 Coupon

</div>

<form
class="form-row"
method="post"
action="/Booking/ApplyCoupon">

@Html.AntiForgeryToken()

<input
type="hidden"
name="bookingId"
value="@Model.Id"/>

<input
type="text"
name="couponCode"
placeholder="Enter coupon code"/>

<button>

Apply

</button>

</form>

</div>



<!-- Payment -->

<div class="section">

<div class="section-title">

🧾 Payment Summary

</div>

<div class="price-breakdown">

<div>
<span>Ticket</span>
<strong>
@CurrencyFormatter.FormatRupees(
Model.TotalAmount)
</strong>
</div>

<div>
<span>Wallet Used</span>
<strong>
-@CurrencyFormatter.FormatRupees(
walletAmountUsed)
</strong>
</div>

<div>
<span>Coupon Discount</span>
<strong>
-@CurrencyFormatter.FormatRupees(
couponDiscount)
</strong>
</div>

<div class="total">
<span>Total Payable</span>
<strong>
@CurrencyFormatter.FormatRupees(
finalPayable)
</strong>
</div>

</div>

</div>



<div class="actions">

<a
class="btn back-btn"
href="javascript:history.back()">

Back

</a>

<a
class="btn cancel-btn"
href="/Home/Index">

Cancel

</a>

<button
type="button"
class="btn pay-btn"
onclick="location.href='/Booking/Payment?bookingId=@Model.Id'">

Proceed Payment

</button>

</div>

</div>

</div>