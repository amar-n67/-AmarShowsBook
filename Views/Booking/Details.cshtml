</div>

<div class="info-box">
<div class="label">Show Time</div>
<div class="value">@showTime</div>
</div>

<div class="info-box">
<div class="label">Theater</div>
<div class="value">@theater</div>
</div>

<div class="info-box">
<div class="label">Screen</div>
<div class="value">@(screen?.ScreenName ?? "Screen TBA")</div>
</div>

<div class="info-box">
<div class="label">Location</div>
<div class="value">@location</div>
</div>

<div class="info-box">
<div class="label">Email</div>
<div class="value">@email</div>
</div>

<div class="info-box">
<div class="label">Mobile</div>
<div class="value">@mobile</div>
</div>

</div>




<div class="section">

<div class="section-title">

Wallet

</div>

<div class="wallet-stats">

<div>
<span>Available</span>
<span class="app-info">
<button type="button" class="app-info-btn" aria-label="Show available wallet details">i</button>
<span class="app-info-popover" role="tooltip">
<b>Wallet</b> Available wallet is balance minus blocked balance.<br />
<b>Status</b> @(wallet?.WalletStatus ?? "NA")<br />
<b>Blocked</b> @CurrencyFormatter.FormatRupees(wallet?.BlockedBalance ?? 0)
</span>
</span>
<strong>
@CurrencyFormatter.FormatRupees(
usableWallet)
</strong>
</div>

<div>
<span>Used</span>
<span class="app-info">
<button type="button" class="app-info-btn" aria-label="Show wallet used details">i</button>
<span class="app-info-popover" role="tooltip">
This amount will be deducted from your wallet for this booking before gateway payment is calculated.
</span>
</span>
<strong>
@CurrencyFormatter.FormatRupees(
walletAmountUsed)
</strong>
</div>

</div>

<form
class="form-row"
method="post"
action="/Booking/ApplyWallet">

@Html.AntiForgeryToken()

<input
type="hidden"
name="bookingId"
value="@Model.Id"/>

<input
type="number"
name="walletAmount"
value="@walletAmountUsed"
step="0.01"
placeholder="Wallet amount"/>

<button>

Apply

</button>

</form>

</div>




<div class="section">

<div class="section-title">

Coupon

</div>

<form
class="form-row"
method="post"
action="/Booking/ApplyCoupon">

@Html.AntiForgeryToken()

<input
type="hidden"
name="bookingId"
value="@Model.Id"/>

<input
type="text"
name="couponCode"
value="@couponCode"
placeholder="Enter coupon code"/>

<button>

Apply

</button>

</form>

@if(availableCoupons.Any())
{
<div class="coupon-hints">
@foreach(var coupon in availableCoupons)
{
    <button type="button" onclick="fillCoupon('@coupon.Split(" - ")[0]')">@coupon</button>
}
</div>
}

</div>




<div class="section">

<div class="section-title">

Payment Summary

</div>

<div class="price-breakdown">

<div>
<span>Ticket</span>
<strong>
@CurrencyFormatter.FormatRupees(
Model.TotalAmount)
</strong>
</div>

<div>
<span>Wallet Used</span>
<strong>
-@CurrencyFormatter.FormatRupees(
walletAmountUsed)
</strong>
</div>

<div>
<span>Coupon Discount</span>
<span class="app-info">
<button type="button" class="app-info-btn" aria-label="Show coupon discount details">i</button>
<span class="app-info-popover" role="tooltip">
Coupon discount reduces the payable amount. Coupon discount is not counted as a refundable wallet or payment amount.
</span>
</span>
<strong>
-@CurrencyFormatter.FormatRupees(
couponDiscount)
</strong>
</div>

<div class="total">
<span>Total Payable</span>
<strong>
@CurrencyFormatter.FormatRupees(
finalPayable)
</strong>
</div>

</div>

</div>
<div class="actions">

<a
class="btn back-btn"
href="#"
onclick="goBack(event)">

Back

</a>

<button
type="button"
class="btn pay-btn"
onclick="location.href='/Booking/Payment?bookingId=@Model.Id'">

Proceed Payment

</button>

</div>

</div>
</div>

<script>

function goBack(e)
{
    e.preventDefault();

    window.location.href=
    document.referrer +
    (
        document.referrer.includes("?")
        ? "&refresh=" + Date.now()
        : "?refresh=" + Date.now()
    );
}

function fillCoupon(code)
{
    const input = document.querySelector('input[name="couponCode"]');
    if(input)
    {
        input.value = code;
        input.focus();
    }
}

</script>
