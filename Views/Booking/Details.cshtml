@model BookingDraft
@using AmarShowsBook.Helpers

@{
    var schedule = ViewBag.Schedule;
    var user = ViewBag.User;
    var wallet = ViewBag.Wallet as AmarShowsBook.Models.Admin.VwWalletSummary;
    var screen = ViewBag.Screen as Screen;
    var venueInfo = ViewBag.Venue as AmarShowsBook.Models.Venue;

    var walletAmountUsed =
    ViewBag.WalletAmountUsed as decimal? ?? 0;

    var usableWallet =
    wallet?.WalletStatus=="ACTIVE"
    ?
    Math.Max(
    0,
    wallet.WalletBalance-wallet.BlockedBalance
    )
    :
    0;

    var couponDiscount =
    ViewBag.CouponDiscount as decimal? ?? 0;

    var couponCode =
    ViewBag.CouponCode as string ?? "";

    var availableCoupons =
    ViewBag.AvailableCoupons as List<string> ?? new List<string>();

    var finalPayable =
    Math.Max(
    0,
    Model.TotalAmount
    -walletAmountUsed
    -couponDiscount
    );

    string title =
    schedule?.Movie?.Title
    ??
    schedule?.StandupShow?.Title
    ??
    schedule?.LiveStream?.Title
    ??
    "Unknown Show";

    string theater =
    venueInfo?.VenueName
    ??
    schedule?.Location?.Area
    ??
    "Unknown Theater";

    string location =
    venueInfo!=null
    ?
    $"{venueInfo.Address}, {venueInfo.City}, {venueInfo.State}, {venueInfo.Country}"
    :
    schedule?.Location!=null
    ?
    $"{schedule.Location.State}, {schedule.Location.Country}"
    :
    "Location unavailable";

    string email =
    user?.Email
    ??
    "Not Available";

    string mobile =
    user?.Mobile
    ??
    "Not Available";

    string showTime =
    schedule?.StartTime!=null
    ?
    ShowTimeFormatter.Format(
    schedule.StartTime,
    "dd MMM yyyy hh:mm tt")
    :
    "N/A";
}

