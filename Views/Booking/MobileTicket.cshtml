@model BookingDraft

@{
var schedule=ViewBag.Schedule;
var user=ViewBag.User as AmarShowsBook.Models.User;
var bookingRef=ViewBag.BookingRef as string ?? $"#{Model.Id}";
var title = schedule?.Movie?.Title ?? schedule?.StandupShow?.Title ?? schedule?.LiveStream?.Title ?? "Show";
var venue = schedule?.Location?.Area ?? "Venue to be announced";
}

<style>

body{

margin:0;

padding:20px;

font-family:Segoe UI,sans-serif;

background:
linear-gradient(
135deg,
#f5f7ff,
#fff
);

display:flex;

justify-content:center;
align-items:center;

min-height:100vh;
}


.ticket{

width:100%;
max-width:420px;

background:white;

border-radius:30px;

overflow:hidden;

box-shadow:
0 15px 35px rgba(0,0,0,.1);

animation:
slideUp .6s;
}


.header{

padding:18px;

text-align:center;

font-size:24px;

font-weight:900;

color:white;

background:
linear-gradient(
135deg,
#ff2d55,
#d10045
);
}


.content{

padding:25px;
}


.poster{

width:100%;

height:220px;

border-radius:20px;

object-fit:cover;
}


.title{

font-size:28px;

font-weight:900;

margin-top:20px;
}


.row{

display:flex;

justify-content:space-between;

padding:14px 0;

border-bottom:
1px dashed #eee;
}


.total{

font-size:35px;

font-weight:900;

color:#ff2d55;

text-align:center;

margin-top:25px;
}

.ticket-actions{
display:grid;
grid-template-columns:1fr 1fr;
gap:12px;
margin-top:22px;
}

.ticket-action{
border:none;
border-radius:14px;
padding:13px 16px;
text-align:center;
text-decoration:none;
font-size:15px;
font-weight:900;
cursor:pointer;
}

.ticket-action.primary{
background:#ff2d55;
color:#fff;
}

.ticket-action.secondary{
background:#eef2f7;
color:#20212a;
}

@@media print{
.ticket-actions{
display:none;
}
body{
background:white;
}
}


@@keyframes slideUp{

from{

opacity:0;

transform:
translateY(30px);
}

to{

opacity:1;

transform:
translateY(0);
}

}

</style>


<div class="ticket">

<div class="header">

🎟 TICKET BOOKED

</div>

<div class="content">

<img
class="poster"
src="https://picsum.photos/400/400?random=@Model.Id"
/>

<div class="title">

@title

</div>


<div class="row">

<span>Booking ID</span>

<span>@bookingRef</span>

</div>

<div class="row">

<span>Email</span>

<span>@(user?.Email ?? "Not Available")</span>

</div>

<div class="row">

<span>Phone</span>

<span>@(user?.Mobile ?? "Not Available")</span>

</div>


<div class="row">

<span>Seats</span>

<span>@Model.SeatNumbers</span>

</div>


<div class="row">

<span>Date</span>

<span>
@(schedule?.StartTime.ToString("dd MMM yyyy") ?? "TBA")
</span>

</div>


<div class="row">

<span>Time</span>

<span>
@(schedule?.StartTime.ToString("hh:mm tt") ?? "TBA")
</span>

</div>


<div class="row">

<span>Venue</span>

<span>
@venue
</span>

</div>


<div class="total">

₹@Model.TotalAmount

</div>

<div class="ticket-actions">
<button class="ticket-action primary" type="button" onclick="window.print()">Download</button>
<a class="ticket-action secondary" href="/Booking/MyBookings">My Bookings</a>
</div>

</div>

</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const params = new URLSearchParams(window.location.search);
    if (params.get("print") === "1") {
        window.print();
    }
});
</script>
