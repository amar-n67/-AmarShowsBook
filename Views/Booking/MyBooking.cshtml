@model List<AmarShowsBook.Models.VwBookingCompleteDetails>

<h2>My Bookings</h2>

<table class="table">
    <thead>
        <tr>
            <th>Booking Ref</th>
            <th>Show</th>
            <th>Status</th>
            <th>Amount</th>
            <th>Booked At</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.BookingRef</td>
                <td>@item.ShowTitle</td>
                <td>@item.BookingStatus</td>
                <td>@item.PayableAmount</td>
                <td>@item.BookedAt</td>
            </tr>
        }
    </tbody>
</table>