<script>

function getYoutubeId(url)
{
    if(!url)
    {
        return "";
    }

    try
    {
        const parsedUrl = new URL(url);

        if(parsedUrl.hostname.includes("youtu.be"))
        {
            return parsedUrl.pathname.substring(1);
        }

        if(parsedUrl.pathname.includes("/embed/"))
        {
            return parsedUrl.pathname.split("/embed/")[1].split("/")[0];
        }

        return parsedUrl.searchParams.get("v") || "";
    }
    catch
    {
        return "";
    }
}

document.addEventListener("DOMContentLoaded", function () {
    const screen = document.querySelector(".screen-line.has-trailer");
    const frame = document.getElementById("seatTrailerFrame");

    if(!screen || !frame)
    {
        return;
    }

    const videoId = getYoutubeId(screen.dataset.trailerUrl);

    if(!videoId)
    {
        screen.classList.remove("has-trailer");
        return;
    }

    const start = parseInt(screen.dataset.trailerStart || "0", 10);
    frame.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&controls=0&loop=1&playlist=${videoId}&start=${Math.max(0,start)}`;
});

const maxSeatLimit=
@(User.IsInRole("Admin") ? 999 : 6);



function toggleSeat(button)
{
    if(
        button.classList.contains("booked")
        ||
        button.classList.contains("locked")
    )
    {
        return;
    }

    let selected=

    document.querySelectorAll(
    ".seat-btn.selected"
    );


    if(
        !button.classList.contains("selected")
        &&
        selected.length>=maxSeatLimit
    )
    {
        showCinemaPopup(
        `Maximum ${maxSeatLimit} seats allowed`,
        "error"
        );

        return;
    }

    button.classList.toggle(
    "selected"
    );

    updateSeatDisplay();
}

function updateSeatDisplay()
{
let selected=
Array.from(
document.querySelectorAll(
".seat-btn.selected"
));

let seatsHTML="";
let pricesHTML="";

let total=0;

selected.forEach(x=>{

let seat=
x.dataset.name;

let price=
parseFloat(
x.dataset.price||0
);

total+=price;


seatsHTML+=
`
<div class="receipt-col">
${seat}
</div>
`;


pricesHTML+=
`
<div class="receipt-col">
₹${price}
</div>
`;

});


document.getElementById(
"selectedSeatsContainer"
).innerHTML=
seatsHTML;


document.getElementById(
"seatPriceContainer"
).innerHTML=
pricesHTML;


document.getElementById(
"totalAmount"
).innerText=
"₹"+total;
}

function nextStep()
{
    let selectedSeats=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatIds=

    selectedSeats.map(
    x=>x.dataset.id
    );


    if(!seatIds.length)
    {
        showCinemaPopup(
        "Please select seats",
        "error"
        );

        return;
    }


    let total=

    selectedSeats.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    fetch(
    "/Booking/LockSeats",
    {

        method:"POST",

        headers:
        {
            "Content-Type":
            "application/json"
        },

        body:
        JSON.stringify(
        {
            scheduleId:@Model.Id,

            seatIds:seatIds,

            totalAmount:total
        })

    })

    .then(
    x=>x.json()
    )

    .then(
    result=>
    {
        if(result.success)
        {
            showCinemaPopup(
            "Seats Locked",
            "success"
            );

            window.location=
            "/Booking/Details?id="
            +
            result.bookingId;
        }
        else
        {
            showCinemaPopup(
            result.message,
            "error"
            );
        }
    })

    .catch(
    error=>
    {
        console.log(error);

        showCinemaPopup(
        "Something went wrong",
        "error"
        );
    });

}

</script>
