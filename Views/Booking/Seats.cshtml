}

.btn-primary{

background:
linear-gradient(
90deg,
#ff2d55,
#c9002e
);

color:white;
}

.btn-secondary{

background:#222;
color:white;
}

.btn:hover{

transform:translateY(-4px);

box-shadow:
0 0 20px rgba(255,0,0,.5);
}


/* MOBILE */

@@media(max-width:768px){

.booking-hero,
.booking-summary{

flex-direction:column;
gap:20px;
}

.seat-btn{

width:52px;
height:52px;
}

