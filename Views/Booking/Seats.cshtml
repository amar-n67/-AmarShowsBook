@model AmarShowsBook.Models.ShowSchedule

@{
    ViewData["Title"]="Seat Booking";

    var title=
    Model.Type=="Movie"
    ? Model.Movie?.Title
    :
    Model.Type=="Standup"
    ? Model.StandupShow?.Title
    :
    Model.LiveStream?.Title;

    var location=
    Model.Location==null
    ?
    "Location to be announced"
    :
    $"{Model.Location.Area}, {Model.Location.State}, {Model.Location.Country}";

    @* var seats=
    ViewBag.Seats
    as List<AmarShowsBook.Models.ViewModels.SeatVM>; *@
    var seats=
ViewBag.Seats
as List<AmarShowsBook.Models.ViewModels.SeatVM>;

var availableDates=
ViewBag.AvailableDates
as List<AmarShowsBook.Models.ShowSchedule>;
}

<section class="booking-page">

<div class="booking-hero">

<div>

<span class="booking-kicker">

Seat Shot

</span>

<h1>

@(title ?? "Untitled Show")

</h1>

<p>

@Model.Type /
@Model.StartTime.ToString("dd MMM yyyy, hh:mm tt")
/
@location

</p>

</div>

<div class="booking-hero-actions no-print">
    <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
    <a
    href="/Home/Index?type=@Model.Type"
    class="btn btn-secondary">

    Back To ShowTime

    </a>
</div>

</div>

@* <div class="show-dates">

@foreach(var show in
((List<AmarShowsBook.Models.ShowSchedule>)
ViewBag.AvailableDates)
.GroupBy(x=>x.StartTime.Date)
.Select(x=>x.First()))
{
    <a
    class="date-chip @(show.Id==Model.Id ? "active":"")"
    href="/Booking/Seats/@show.Id">

    @show.StartTime.ToString("dd MMM")

    </a>
}

</div> *@
@if(availableDates!=null && availableDates.Any())
{
<div class="show-dates">

@foreach(var show in
availableDates
.GroupBy(x=>x.StartTime.Date)
.Select(x=>x.First()))
{
    <a
    class="date-chip @(show.Id==Model.Id ? "active":"")"
    href="/Booking/Seats/@show.Id">

        @show.StartTime.ToString("dd MMM")

    </a>
}

</div>
}

<div class="screen-line">

<span>

SCREEN

</span>

</div>



<div class="seat-board">

@if(seats!=null && seats.Any())
{
    var groupedSeats=
    seats
    .GroupBy(x=>x.Row)
    .OrderBy(x=>x.Key);

    foreach(var rowGroup in groupedSeats)
    {
        <div class="seat-row">

            <div class="row-label">

                @rowGroup.Key

            </div>

            @{
                int count=0;
            }

            @foreach(var seat in rowGroup.OrderBy(x=>Convert.ToInt32(x.Number)))
            {
                var cssClass="available";

                if(seat.IsBooked)
                {
                    cssClass="booked";
                }
                else if(seat.IsLocked)
                {
                    cssClass="locked";
                }
                else if(seat.Price>300)
                {
                    cssClass="gold";
                }

                count++;

                <button
                type="button"
                class="seat-btn @cssClass"
                data-id="@seat.SeatId"
                data-name="@seat.Row@seat.Number"
                data-price="@seat.Price"
                onclick="toggleSeat(this)"
                @(seat.IsBooked||seat.IsLocked?"disabled":"")>

                    <div class="seat-name">

                        @seat.Row@seat.Number

                    </div>

                    <div class="seat-price">

                        ₹@seat.Price

                    </div>

                </button>

                @if(count==5)
                {
                    <div class="seat-gap"></div>
                }
            }

        </div>
    }
}

</div>



<div class="legend">

<div class="legend-item">
<div class="legend-box available"></div>
Available
</div>

<div class="legend-item">
<div class="legend-box selected"></div>
Selected
</div>

<div class="legend-item">
<div class="legend-box locked"></div>
Locked
</div>

<div class="legend-item">
<div class="legend-box booked"></div>
Booked
</div>

<div class="legend-item">
<div class="legend-box gold"></div>
Premium
</div>

</div>



<div class="booking-summary">

<div>

<div>

<span>

Selected Seats

</span>

<strong id="selectedSeats">

None

</strong>

</div>

<br>

<div>

<span>

Seat Price

</span>

<strong id="seatPrice">

₹0

</strong>

</div>

<br>

<div>

<span>

Total Amount

</span>

<strong id="totalAmount">

₹0

</strong>

</div>

</div>


<button
type="button"
class="btn btn-primary"
onclick="nextStep()">

Next

</button>

</div>

</section>



<style>
    :root{
--primary:#ff4757;
--dark:#1e1e2e;
--card:#2a2a3d;
--border:#444;
--text:#fff;
--muted:#bdbdbd;

--green:#2ed573;
--red:#ff4757;
--orange:#ffa502;
}

.booking-page{
padding:40px;
max-width:1400px;
margin:auto;
color:var(--text);
background:#121212;
border-radius:20px;
}

.booking-hero{
display:flex;
justify-content:space-between;
align-items:center;
padding:30px;
border-radius:20px;
background:var(--card);
margin-bottom:40px;
border:1px solid var(--border);
}

.booking-kicker{
display:inline-block;
padding:6px 14px;
background:var(--primary);
border-radius:30px;
font-size:.8rem;
font-weight:700;
margin-bottom:12px;
}

.booking-hero h1{
font-size:2rem;
margin:10px 0;
font-weight:800;
}

.booking-hero p{
color:var(--muted);
font-size:.95rem;
}

.booking-hero-actions{
display:flex;
gap:10px;
}

.screen-line{
text-align:center;
margin:50px auto;
}

.screen-line span{
padding:10px 40px;
background:white;
color:black;
font-weight:700;
border-radius:50px;
display:inline-block;
}

.seat-board{
padding:35px;
background:var(--card);
border-radius:20px;
border:1px solid var(--border);
}

.seat-row{
display:flex;
justify-content:center;
align-items:center;
gap:12px;
margin-bottom:15px;
}

.row-label{
width:40px;
font-size:18px;
font-weight:700;
}

.seat-btn{
width:65px;
height:65px;
border:none;
border-radius:12px;
cursor:pointer;
font-weight:700;
transition:.3s;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
}

.seat-btn:hover{
transform:translateY(-4px);
}

.available{
background:white;
color:black;
}

.selected{
background:var(--green)!important;
color:black!important;
}

.booked{
background:var(--red);
color:white;
cursor:not-allowed;
}

.locked{
background:var(--orange);
color:black;
cursor:not-allowed;
}

.gold{
background:gold;
color:black;
}

.seat-name{
font-size:.85rem;
font-weight:700;
}

.seat-price{
font-size:.7rem;
margin-top:3px;
}

.legend{
display:flex;
justify-content:center;
gap:15px;
margin:35px 0;
flex-wrap:wrap;
}

.legend-item{
display:flex;
align-items:center;
gap:8px;
padding:10px 14px;
background:var(--card);
border-radius:30px;
}

.legend-box{
width:16px;
height:16px;
border-radius:4px;
}

.booking-summary{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:40px;
padding:30px;
background:var(--card);
border-radius:20px;
border:1px solid var(--border);
}

.booking-summary span{
display:block;
font-size:.8rem;
color:var(--muted);
margin-bottom:4px;
}

.booking-summary strong{
font-size:1rem;
}

#totalAmount{
font-size:2rem;
color:var(--green);
font-weight:800;
}

.btn{
padding:12px 22px;
border:none;
border-radius:10px;
font-weight:600;
text-decoration:none;
cursor:pointer;
}

.btn-primary{
background:var(--primary);
color:white;
}

.btn-secondary{
background:#444;
color:white;
}

.btn:hover{
opacity:.9;
}

@@media(max-width:768px){

.booking-hero,
.booking-summary{
flex-direction:column;
gap:20px;
}

.seat-row{
flex-wrap:wrap;
}

.row-label{
width:100%;
text-align:center;
}

.seat-btn{
width:58px;
height:58px;
}

}
.show-dates{

display:flex;
gap:12px;
flex-wrap:wrap;
justify-content:center;

margin:0 0 35px 0;

}

.date-chip{

padding:12px 18px;

border-radius:30px;

background:#2a2a3d;

color:white;

text-decoration:none;

border:1px solid #444;

transition:.3s;

}

.date-chip:hover{

transform:translateY(-3px);

}

.date-chip.active{

background:#ff4757;

font-weight:700;

}
</style>
<script>

const maxSeatLimit=
@(User.IsInRole("Admin") ? 999 : 6);



function toggleSeat(button)
{
    if(
        button.classList.contains("booked")
        ||
        button.classList.contains("locked")
    )
    {
        return;
    }

    let selected=

    document.querySelectorAll(
    ".seat-btn.selected"
    );


    if(
        !button.classList.contains("selected")
        &&
        selected.length>=maxSeatLimit
    )
    {
        showCinemaPopup(
        `Maximum ${maxSeatLimit} seats allowed`,
        "error"
        );

        return;
    }

    button.classList.toggle(
    "selected"
    );

    updateSeatDisplay();
}




function updateSeatDisplay()
{
    let selected=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatNames=

    selected.map(
    x=>x.dataset.name
    );


    let prices=

    selected.map(
    x=>
    "₹"+
    parseFloat(
    x.dataset.price||0
    )
    );


    let total=

    selected.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    document.getElementById(
    "selectedSeats"
    ).innerText=

    seatNames.length
    ?
    seatNames.join(", ")
    :
    "None";


    document.getElementById(
    "seatPrice"
    ).innerText=

    prices.length
    ?
    prices.join(", ")
    :
    "₹0";


    document.getElementById(
    "totalAmount"
    ).innerText=

    "₹"+total;
}




function nextStep()
{
    let selectedSeats=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatIds=

    selectedSeats.map(
    x=>x.dataset.id
    );


    if(!seatIds.length)
    {
        showCinemaPopup(
        "Please select seats",
        "error"
        );

        return;
    }


    let total=

    selectedSeats.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    fetch(
    "/Booking/LockSeats",
    {

        method:"POST",

        headers:
        {
            "Content-Type":
            "application/json"
        },

        body:
        JSON.stringify(
        {
            scheduleId:@Model.Id,

            seatIds:seatIds,

            totalAmount:total
        })

    })

    .then(
    x=>x.json()
    )

    .then(
    result=>
    {
        if(result.success)
        {
            showCinemaPopup(
            "Seats Locked",
            "success"
            );

            window.location=
            "/Booking/Details?id="
            +
            result.bookingId;
        }
        else
        {
            showCinemaPopup(
            result.message,
            "error"
            );
        }
    })

    .catch(
    error=>
    {
        console.log(error);

        showCinemaPopup(
        "Something went wrong",
        "error"
        );
    });

}

</script>
