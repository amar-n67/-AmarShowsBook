@model AmarShowsBook.Models.ShowSchedule

@{
    ViewData["Title"]="Seat Booking";

    var title=
    Model.Type=="Movie"
    ? Model.Movie?.Title
    :
    Model.Type=="Standup"
    ? Model.StandupShow?.Title
    :
    Model.LiveStream?.Title;

    var location=
    Model.Location==null
    ?
    "Location to be announced"
    :
    $"{Model.Location.Area}, {Model.Location.State}, {Model.Location.Country}";

    var seats=
    ViewBag.Seats
    as List<AmarShowsBook.Models.ViewModels.SeatVM>;
}

<section class="booking-page">

<div class="booking-hero">

<div>

<span class="booking-kicker">

Seat Shot

</span>

<h1>

@(title ?? "Untitled Show")

</h1>

<p>

@Model.Type /
@Model.StartTime.ToString("dd MMM yyyy, hh:mm tt")
/
@location

</p>

</div>

<a
href="/Home/Index?type=@Model.Type"
class="btn btn-secondary">

Back To ShowTime

</a>

</div>



<div class="screen-line">

<span>

SCREEN

</span>

</div>



<div class="seat-board">

@if(seats!=null && seats.Any())
{
    var groupedSeats=
    seats
    .GroupBy(x=>x.Row)
    .OrderBy(x=>x.Key);

    foreach(var rowGroup in groupedSeats)
    {
        <div class="seat-row">

            <div class="row-label">

                @rowGroup.Key

            </div>

            @{
                int count=0;
            }

            @foreach(var seat in rowGroup.OrderBy(x=>Convert.ToInt32(x.Number)))
            {
                var cssClass="available";

                if(seat.IsBooked)
                {
                    cssClass="booked";
                }
                else if(seat.IsLocked)
                {
                    cssClass="locked";
                }
                else if(seat.Price>300)
                {
                    cssClass="gold";
                }

                count++;

                <button
                type="button"
                class="seat-btn @cssClass"
                data-id="@seat.SeatId"
                data-name="@seat.Row@seat.Number"
                data-price="@seat.Price"
                onclick="toggleSeat(this)"
                @(seat.IsBooked||seat.IsLocked?"disabled":"")>

                    <div class="seat-name">

                        @seat.Row@seat.Number

                    </div>

                    <div class="seat-price">

                        ₹@seat.Price

                    </div>

                </button>

                @if(count==5)
                {
                    <div class="seat-gap"></div>
                }
            }

        </div>
    }
}

</div>



<div class="legend">

<div class="legend-item">
<div class="legend-box available"></div>
Available
</div>

<div class="legend-item">
<div class="legend-box selected"></div>
Selected
</div>

<div class="legend-item">
<div class="legend-box locked"></div>
Locked
</div>

<div class="legend-item">
<div class="legend-box booked"></div>
Booked
</div>

<div class="legend-item">
<div class="legend-box gold"></div>
Premium
</div>

</div>



<div class="booking-summary">

<div>

<div>

<span>

Selected Seats

</span>

<strong id="selectedSeats">

None

</strong>

</div>

<br>

<div>

<span>

Seat Price

</span>

<strong id="seatPrice">

₹0

</strong>

</div>

<br>

<div>

<span>

Total Amount

</span>

<strong id="totalAmount">

₹0

</strong>

</div>

</div>


<button
type="button"
class="btn btn-primary"
onclick="nextStep()">

Next

</button>

</div>

</section>



<style>

:root{

--primary:#ff3366;
--secondary:#7c3aed;

--green:#00ff88;
--red:#ef4444;
--orange:#f59e0b;

--glass:rgba(255,255,255,.08);

}

body{

margin:0;

font-family:Segoe UI,sans-serif;

background:
linear-gradient(
135deg,
#050816,
#111827,
#1f1147
);

color:white;

}


.booking-page{

padding:35px;

}


.booking-hero{

display:flex;

justify-content:space-between;

align-items:center;

padding:30px;

border-radius:25px;

background:var(--glass);

backdrop-filter:blur(20px);

margin-bottom:40px;

}


.booking-kicker{

padding:10px 15px;

border-radius:999px;

background:
linear-gradient(
90deg,
var(--primary),
var(--secondary)
);

}


.screen-line{

width:80%;

margin:50px auto;

text-align:center;

border-top:6px solid white;

border-radius:100%;

height:100px;

}

.screen-line span{

display:inline-block;

margin-top:25px;

padding:10px 25px;

background:white;

color:black;

border-radius:999px;

font-weight:700;

}


.seat-board{

display:flex;

flex-direction:column;

gap:15px;

padding:35px;

background:var(--glass);

border-radius:25px;

max-width:1200px;

margin:auto;

}


.seat-row{

display:flex;

justify-content:center;

align-items:center;

gap:10px;

}


.row-label{

width:40px;

font-size:18px;

font-weight:900;

}


.seat-gap{

width:60px;

}


.seat-btn{

width:70px;

height:70px;

border:none;

border-radius:14px;

display:flex;

flex-direction:column;

align-items:center;

justify-content:center;

cursor:pointer;

transition:.3s;

}


.seat-name{

font-size:13px;

font-weight:800;

}


.seat-price{

font-size:10px;

opacity:.7;

margin-top:4px;

}


.available{

background:white;
color:black;

}

.available:hover{

transform:
translateY(-5px)
scale(1.05);

}


.selected{

background:
linear-gradient(
135deg,
#00ff88,
#00e676
)!important;

color:black !important;

}


.booked{

background:var(--red);
color:white;

}

.locked{

background:var(--orange);
color:white;

}

.gold{

background:
linear-gradient(
135deg,
gold,
orange
);

color:black;

}


.legend{

display:flex;

justify-content:center;

gap:20px;

margin:40px;

flex-wrap:wrap;

}


.legend-item{

display:flex;

gap:10px;

padding:10px 20px;

background:var(--glass);

border-radius:999px;

}


.legend-box{

width:18px;
height:18px;
border-radius:5px;

}


.booking-summary{

display:flex;

justify-content:space-between;

margin-top:40px;

padding:30px;

background:var(--glass);

border-radius:25px;

}


#totalAmount{

font-size:30px;

color:var(--green);

}


@@media(max-width:768px){

.seat-row{

flex-wrap:wrap;

}

.row-label{

width:100%;

text-align:center;

margin-bottom:10px;

}

.seat-gap{

display:none;

}

.booking-summary{

flex-direction:column;

gap:20px;

}

}

</style>


<script>

const maxSeatLimit=
@(User.IsInRole("Admin") ? 999 : 6);



function toggleSeat(button)
{
    if(
        button.classList.contains("booked")
        ||
        button.classList.contains("locked")
    )
    {
        return;
    }

    let selected=

    document.querySelectorAll(
    ".seat-btn.selected"
    );


    if(
        !button.classList.contains("selected")
        &&
        selected.length>=maxSeatLimit
    )
    {
        showCinemaPopup(
        `Maximum ${maxSeatLimit} seats allowed`,
        "error"
        );

        return;
    }

    button.classList.toggle(
    "selected"
    );

    updateSeatDisplay();
}




function updateSeatDisplay()
{
    let selected=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatNames=

    selected.map(
    x=>x.dataset.name
    );


    let prices=

    selected.map(
    x=>
    "₹"+
    parseFloat(
    x.dataset.price||0
    )
    );


    let total=

    selected.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    document.getElementById(
    "selectedSeats"
    ).innerText=

    seatNames.length
    ?
    seatNames.join(", ")
    :
    "None";


    document.getElementById(
    "seatPrice"
    ).innerText=

    prices.length
    ?
    prices.join(", ")
    :
    "₹0";


    document.getElementById(
    "totalAmount"
    ).innerText=

    "₹"+total;
}




function nextStep()
{
    let selectedSeats=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatIds=

    selectedSeats.map(
    x=>x.dataset.id
    );


    if(!seatIds.length)
    {
        showCinemaPopup(
        "Please select seats",
        "error"
        );

        return;
    }


    let total=

    selectedSeats.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    fetch(
    "/Booking/LockSeats",
    {

        method:"POST",

        headers:
        {
            "Content-Type":
            "application/json"
        },

        body:
        JSON.stringify(
        {
            scheduleId:@Model.Id,

            seatIds:seatIds,

            totalAmount:total
        })

    })

    .then(
    x=>x.json()
    )

    .then(
    result=>
    {
        if(result.success)
        {
            showCinemaPopup(
            "Seats Locked",
            "success"
            );

            window.location=
            "/Booking/Details?id="
            +
            result.bookingId;
        }
        else
        {
            showCinemaPopup(
            result.message,
            "error"
            );
        }
    })

    .catch(
    error=>
    {
        console.log(error);

        showCinemaPopup(
        "Something went wrong",
        "error"
        );
    });

}

</script>