@model AmarShowsBook.Models.ShowSchedule
@inject AmarShowsBook.Services.RbacService RbacService

@{
    ViewData["Title"]="Seat Booking";
    var canUsePrintTools = AmarShowsBook.Helpers.RbacAuthorizationHelper.CanUsePrintTools(Context, RbacService);

    var title=
    Model.Type=="Movie"
    ? Model.Movie?.Title
    :
    Model.Type=="Standup"
    ? Model.StandupShow?.Title
    :
    Model.LiveStream?.Title;

    var location=
    Model.Location==null
    ?
    "Location to be announced"
    :
    $"{Model.Location.Area}, {Model.Location.State}, {Model.Location.Country}";

    var seats=
ViewBag.Seats
as List<AmarShowsBook.Models.ViewModels.SeatVM>;

var availableDates=
ViewBag.AvailableDates
as List<AmarShowsBook.Models.ShowSchedule>;

var trailerUrl=
ViewBag.TrailerUrl as string;

var trailerStartSeconds=
ViewBag.TrailerStartSeconds as int? ?? 0;

var screen=
ViewBag.Screen as Screen;

var venueInfo=
ViewBag.Venue as AmarShowsBook.Models.Venue;

var theaterDetails =
venueInfo!=null
? $"{venueInfo.VenueName} / {screen?.ScreenName ?? "Screen TBA"} / {venueInfo.Address}, {venueInfo.City}"
: location;

var selectedShowDay =
string.IsNullOrWhiteSpace(Model.ShowDay)
? ShowTimeFormatter.Format(Model.StartTime, "dddd")
: Model.ShowDay;

var selectedStartLocal =
ShowTimeFormatter.ToAppLocal(Model.StartTime);
}

<section class="booking-page">

<div class="booking-hero">

<div>

<span class="booking-kicker">

Seat Shot

</span>

<h1>

@(title ?? "Untitled Show")

</h1>

<p>

@Model.Type /
@selectedShowDay /
@selectedStartLocal.ToString("dd MMM yyyy, hh:mm tt")
/
@theaterDetails

</p>

</div>

<div class="booking-hero-actions no-print">
    @if(canUsePrintTools)
    {
    <button type="button" class="btn btn-primary" onclick="printSeatLayout()">Print</button>
    }
    <a
    href="/Home/ShowTime?type=@Model.Type"
    class="btn btn-secondary">

    Back To ShowTime

    </a>
</div>

	</div>

	@{
	    var currentDate =
	    selectedStartLocal.Date;
}

@if(availableDates != null && availableDates.Any())
{
<div class="show-dates">

@foreach(var show in
availableDates
.GroupBy(x=>ShowTimeFormatter.ToAppLocal(x.StartTime).Date)
.Select(x=>x.First())
.OrderBy(x=>x.StartTime))
{
    var showStartLocal =
    ShowTimeFormatter.ToAppLocal(show.StartTime);

    bool activeDate =
    showStartLocal.Date == currentDate;

    var showDay =
    string.IsNullOrWhiteSpace(show.ShowDay)
    ? showStartLocal.ToString("ddd")
    : show.ShowDay;

    showDay = showDay.Length > 3 ? showDay.Substring(0, 3) : showDay;

    <a
    class="date-chip @(activeDate ? "active":"")"
    href="/Booking/Seats/@show.Id">

        <span>@showDay</span>
        <strong>@showStartLocal.ToString("dd MMM")</strong>

    </a>
}

</div>
}
<div class="seat-print-area" id="seatPrintArea" aria-label="Printable seat layout">

<div class="screen-line @(string.IsNullOrWhiteSpace(trailerUrl) ? "" : "has-trailer")"
     data-trailer-url="@trailerUrl"
     data-trailer-start="@trailerStartSeconds">

<span>SCREEN</span>

<iframe
id="seatTrailerFrame"
title="Show trailer preview"
allow="autoplay; encrypted-media"
allowfullscreen>
</iframe>

</div>



<div class="seat-board" aria-label="Seat layout. Screen is at the top and premium seats are at the back.">
<div class="seat-orientation">
    <span>Front / Screen</span>
    <strong>Premium rows are at the back</strong>
</div>
<div class="seat-scroll-cue">Swipe left or right to view every seat</div>

@if(seats!=null && seats.Any())
{
    var groupedSeats=
    seats
    .GroupBy(x=>x.Row)
    .OrderBy(x=>x.Key);

    foreach(var rowGroup in groupedSeats)
    {
        var rowCategory =
            rowGroup
            .GroupBy(x=>x.Category ?? "")
            .OrderByDescending(x=>x.Count())
            .Select(x=>x.Key)
            .FirstOrDefault() ?? "";

        <div class="seat-row @((rowCategory ?? "").ToLowerInvariant())-row">

            <div class="row-label">

                @rowGroup.Key

            </div>

            @{
                int count=0;
            }

            @foreach(var seat in rowGroup.OrderBy(x=>Convert.ToInt32(x.Number)))
            {
                var cssClass="available";

                if(seat.IsBooked)
                {
                    cssClass="booked";
                }
                else if(seat.IsLocked)
                {
                    cssClass="locked";
                }
                else
                {
                    cssClass=(seat.Category ?? "Silver").ToLowerInvariant();
                }

                var seatCategoryLabel =
                    string.IsNullOrWhiteSpace(seat.Category)
                    ? "Standard"
                    : seat.Category;

                var lockExpiryIso = seat.LockExpiresAt.HasValue
                    ? seat.LockExpiresAt.Value.ToUniversalTime().ToString("o")
                    : "";

                var seatStateLabel =
                    seat.IsBooked
                    ? "booked"
                    : seat.IsLocked
                        ? "locked"
                        : "available";

                count++;

                <button
                type="button"
                class="seat-btn @cssClass"
                data-id="@seat.SeatId"
                data-name="@seat.Row@seat.Number"
                data-price="@seat.Price"
                data-category="@seat.Category"
                data-lock-expires="@lockExpiryIso"
                onclick="toggleSeat(this)"
                aria-label="Seat @seat.Row@seat.Number, @seatCategoryLabel, ₹@seat.Price, @seatStateLabel"
                aria-disabled="@(seat.IsBooked||seat.IsLocked?"true":"false")">

                    <span class="chair-back" aria-hidden="true"></span>
                    <span class="chair-arm chair-arm-left" aria-hidden="true"></span>
                    <span class="chair-arm chair-arm-right" aria-hidden="true"></span>
                    <span class="chair-cushion" aria-hidden="true"></span>
                    <span class="chair-base" aria-hidden="true"></span>

                    <div class="seat-name">

                        @seat.Row@seat.Number

                    </div>

                    <div class="seat-price">

                        ₹@seat.Price

                    </div>

                    @if(seat.IsLocked)
                    {
                        <div class="seat-lock-tooltip">
                            <span>Locked seat</span>
                            <strong data-lock-countdown="@lockExpiryIso">Calculating...</strong>
                            <small>Auto release if payment is not done</small>
                        </div>
                    }

                </button>

                @if(count==5 && rowGroup.Count()>5)
{
    <div class="seat-gap"></div>
}
            }

        </div>
    }
}

</div>



<div class="legend">

<div class="legend-group">
<span class="legend-title">Seat Status</span>
<div class="legend-item">
<div class="legend-box available"></div>
Available seat
</div>

<div class="legend-item">
<div class="legend-box selected"></div>
Selected seat
</div>

<div class="legend-item">
<div class="legend-box locked"></div>
Locked
</div>

<div class="legend-item">
<div class="legend-box booked"></div>
Booked
</div>
</div>

<div class="legend-group">
<span class="legend-title">Seat Category / Price</span>
<div class="legend-item">
<div class="legend-box silver"></div>
Silver available
</div>

<div class="legend-item">
<div class="legend-box gold"></div>
Gold available
</div>

<div class="legend-item">
<div class="legend-box premium"></div>
Premium available
</div>
</div>

</div>

</div>
<div class="booking-summary">

    <div class="ticket-receipt">

        <div class="ticket-header">
            CINEMA RECEIPT
        </div>

        <div class="ticket-body">

            <div class="receipt-row">

                <div class="receipt-title">
                    Selected Seats
                </div>

                <div
                id="selectedSeatsContainer"
                class="receipt-data">

                </div>

            </div>


            <div class="receipt-row">

                <div class="receipt-title">
                    Seat Price
                </div>

                <div
                id="seatPriceContainer"
                class="receipt-data">

                </div>

            </div>

        </div>


        <div class="receipt-total">

            <span>
                TOTAL
            </span>

            <strong id="totalAmount">
                ₹0
            </strong>

        </div>

        <div class="ticket-cut-left"></div>
        <div class="ticket-cut-right"></div>

    </div>


    <div class="cinema-side">

        <div class="booking-action-card">

            <div class="booking-action-icon" aria-hidden="true">
                🎟
            </div>

            <div class="booking-action-copy">
                <span>Booking Flow</span>
                <strong>Choose seats, then continue</strong>
                <small>Your selected seats and total update on the receipt.</small>
            </div>

            <div class="booking-flow-steps" aria-hidden="true">
                <span class="active">1</span>
                <span>2</span>
                <span>3</span>
            </div>

        </div>


        <button
        type="button"
        class="btn next-btn"
        onclick="nextStep()">

            Next →

        </button>

    </div>

</div>
</section>

<style>

:root{
    --bg:#07090f;
    --card:#111827;
    --card2:#0d1118;
    --red:#ff2d55;
    --redGlow:#ff2d5580;
    --green:#1dd75b;
    --purple:#7d4dff;
    --gold:#d49b2a;
    --text:#fff;
    --muted:#b5b5b5;
}

body{
    background:
    radial-gradient(circle at top,#2a0007 0%,#07090f 45%);
}

.booking-page{
    max-width:1500px;
    margin:auto;
    padding:30px;
    color:white;
}


.booking-hero{
    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:30px;

    border-radius:25px;

    background:
    linear-gradient(
    145deg,
    rgba(30,30,40,.95),
    rgba(10,10,15,.95)
    );

    border:1px solid rgba(255,255,255,.1);

    box-shadow:
    0 0 35px rgba(255,0,50,.15);
}

.booking-kicker{

    display:inline-block;

    background:
    linear-gradient(
    90deg,
    #ff2d55,
    #c9002e
    );

    padding:10px 20px;

    border-radius:12px;

    font-size:14px;

    font-weight:700;
}

.booking-hero h1{

    font-size:60px;

    margin:15px 0;

    font-weight:800;

    font-style:italic;
}

.booking-hero p{

    color:#c2c2c2;
}




.show-dates{

display:flex;

justify-content:center;

gap:8px;

margin:18px 0 24px;

flex-wrap:wrap;
}

.date-chip{

display:grid;

gap:4px;

min-width:64px;

background:#111827;

border:1px solid #333;

border-radius:10px;

padding:7px 10px;

text-decoration:none;

color:white;

text-align:center;

transition:.4s;
}

.date-chip span{
font-size:.66rem;
font-weight:800;
opacity:.78;
line-height:1;
}

.date-chip strong{
font-size:.82rem;
font-weight:950;
line-height:1.05;
}

.date-chip:hover{

transform:translateY(-5px);
}

.date-chip.active{

background:var(--red);

box-shadow:
0 0 20px var(--redGlow);

border-color:var(--red);
}




.screen-line{

margin:60px auto;

width:80%;

min-height:120px;

border-top-left-radius:100%;

border-top-right-radius:100%;

border:5px solid rgba(255,50,50,.7);

border-bottom:none;

display:flex;

align-items:center;

justify-content:center;

background:

linear-gradient(
180deg,
rgba(255,40,50,.25),
transparent
);

box-shadow:

0 0 40px rgba(255,0,0,.3);

position:relative;

overflow:hidden;
animation:screenGlow 3.8s ease-in-out infinite;
}

.screen-line::before{
content:"";
position:absolute;
inset:-28px 8% auto;
height:90px;
border-radius:50%;
background:radial-gradient(ellipse,rgba(255,45,85,.32),transparent 68%);
filter:blur(16px);
animation:screenBeam 4.2s ease-in-out infinite;
pointer-events:none;
}

.screen-line span{

font-size:50px;

font-weight:800;

letter-spacing:8px;

position:relative;

z-index:2;
}

.screen-line iframe{
display:none;
position:absolute;
inset:0;
width:100%;
height:100%;
border:0;
opacity:.42;
filter:saturate(1.1) contrast(1.08);
pointer-events:none;
}

.screen-line.has-trailer{
height:260px;
border-radius:28px 28px 90% 90% / 28px 28px 18% 18%;
border:1px solid rgba(255,255,255,.18);
background:#05070c;
box-shadow:0 20px 70px rgba(255,45,85,.22);
}

.screen-line.has-trailer iframe{
display:block;
}

.screen-line.has-trailer::after{
content:"";
position:absolute;
inset:0;
background:linear-gradient(180deg, rgba(7,9,15,.12), rgba(7,9,15,.72));
z-index:1;
}



.seat-board{
padding:26px 18px 30px;
max-width:1200px;
margin:0 auto;
overflow-x:auto;
scrollbar-color:#ff2d55 #111827;
scrollbar-width:thin;
}

.seat-orientation{
display:flex;
justify-content:space-between;
align-items:center;
gap:14px;
width:min(860px,100%);
margin:0 auto 18px;
padding:10px 16px;
border:1px solid rgba(255,255,255,.12);
border-radius:14px;
background:linear-gradient(90deg,rgba(255,45,85,.18),rgba(255,255,255,.04));
color:#f8fafc;
font-size:13px;
font-weight:800;
animation:fadeSlideDown .45s ease both;
}

.seat-orientation span,
.seat-orientation strong{
display:block;
white-space:nowrap;
}

.seat-orientation span{
color:#ffb3c3;
text-transform:uppercase;
letter-spacing:.08em;
font-size:11px;
}

.seat-row{

display:grid;
grid-template-columns:34px repeat(5,58px) 48px repeat(5,58px);

justify-content:center;

align-items:center;

gap:9px;

margin-bottom:11px;
min-width:760px;
padding:6px 10px;
border-radius:14px;
transition:background .2s ease, box-shadow .2s ease;
animation:seatRowIn .52s ease both;
}

.seat-row:nth-of-type(2){animation-delay:.04s;}
.seat-row:nth-of-type(3){animation-delay:.08s;}
.seat-row:nth-of-type(4){animation-delay:.12s;}
.seat-row:nth-of-type(5){animation-delay:.16s;}
.seat-row:nth-of-type(6){animation-delay:.2s;}
.seat-row:nth-of-type(7){animation-delay:.24s;}
.seat-row:nth-of-type(8){animation-delay:.28s;}
.seat-row:nth-of-type(9){animation-delay:.32s;}
.seat-row:nth-of-type(10){animation-delay:.36s;}

.seat-row.premium-row{
background:linear-gradient(90deg,rgba(255,217,92,.12),rgba(255,217,92,.04));
box-shadow:inset 0 0 0 1px rgba(255,217,92,.12);
}

.seat-row.gold-row{
background:linear-gradient(90deg,rgba(244,163,58,.08),transparent);
}

.seat-row.silver-row{
background:linear-gradient(90deg,rgba(255,255,255,.04),transparent);
}

.row-label{

width:30px;

color:#ff3d3d;

font-size:20px;

font-weight:bold;
text-align:center;
}

.seat-gap{

width:48px;
height:1px;
}


.seat-btn{

width:58px;
height:70px;

position:relative;

border:0;

cursor:pointer;

border-radius:18px 18px 12px 12px;

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

isolation:isolate;

overflow:visible;

background:transparent!important;

perspective:460px;

transition:transform .28s ease, filter .28s ease;

transform-style:preserve-3d;

font-weight:700;

box-shadow:none;
animation:chairSettle .5s ease both;

}


.seat-btn::after{

content:"";

position:absolute;

left:8px;
right:8px;
bottom:-7px;

height:12px;

background:rgba(0,0,0,.35);

border-radius:999px;

filter:blur(5px);

z-index:-1;
}

.chair-back,
.chair-cushion,
.chair-arm,
.chair-base{
position:absolute;
display:block;
pointer-events:none;
}

.chair-back{
left:7px;
right:7px;
top:3px;
height:40px;
border-radius:16px 16px 9px 9px;
background:var(--seat-back);
box-shadow:
inset 0 5px 8px rgba(255,255,255,.34),
inset 0 -11px 14px rgba(0,0,0,.22),
0 8px 12px rgba(0,0,0,.38);
transform:rotateX(8deg) translateZ(6px);
z-index:1;
}

.chair-back::before{
content:"";
position:absolute;
left:8px;
right:8px;
top:8px;
height:10px;
border-radius:999px;
background:rgba(255,255,255,.22);
}

.chair-cushion{
left:9px;
right:9px;
bottom:13px;
height:26px;
border-radius:10px 10px 14px 14px;
background:var(--seat-cushion);
box-shadow:
inset 0 4px 7px rgba(255,255,255,.28),
inset 0 -8px 12px rgba(0,0,0,.24),
0 8px 12px rgba(0,0,0,.35);
transform:rotateX(58deg) translateY(7px);
transform-origin:top center;
z-index:3;
}

.chair-arm{
top:30px;
width:9px;
height:31px;
border-radius:8px 8px 11px 11px;
background:var(--seat-side);
box-shadow:
inset 0 3px 4px rgba(255,255,255,.22),
0 6px 9px rgba(0,0,0,.38);
z-index:4;
}

.chair-arm-left{
left:3px;
transform:skewY(-8deg);
}

.chair-arm-right{
right:3px;
transform:skewY(8deg);
}

.chair-base{
left:17px;
right:17px;
bottom:2px;
height:11px;
border-radius:3px 3px 8px 8px;
background:linear-gradient(180deg,rgba(20,20,24,.8),rgba(0,0,0,.92));
box-shadow:0 5px 10px rgba(0,0,0,.42);
z-index:2;
}



.seat-btn:hover{

transform:

translateY(-7px)
rotateX(7deg)
scale(1.07);

filter:brightness(1.08) saturate(1.08);
}

.seat-btn:active{
transform:translateY(-2px) scale(.96);
}




