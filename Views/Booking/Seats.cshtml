    --card:#111827;
    --card2:#0d1118;
    --red:#ff2d55;
    --redGlow:#ff2d5580;
    --green:#1dd75b;
    --purple:#7d4dff;
    --gold:#d49b2a;
    --text:#fff;
    --muted:#b5b5b5;
}

body{
    background:
    radial-gradient(circle at top,#2a0007 0%,#07090f 45%);
}

.booking-page{
    max-width:1500px;
    margin:auto;
    padding:30px;
    color:white;
}

/* HERO */

.booking-hero{
    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:30px;

    border-radius:25px;

    background:
    linear-gradient(
    145deg,
    rgba(30,30,40,.95),
    rgba(10,10,15,.95)
    );

    border:1px solid rgba(255,255,255,.1);

    box-shadow:
    0 0 35px rgba(255,0,50,.15);
}

.booking-kicker{

    display:inline-block;

    background:
    linear-gradient(
    90deg,
    #ff2d55,
    #c9002e
    );

    padding:10px 20px;

    border-radius:12px;

    font-size:14px;

    font-weight:700;
}

.booking-hero h1{

    font-size:60px;

    margin:15px 0;

    font-weight:800;

    font-style:italic;
}

.booking-hero p{

    color:#c2c2c2;
}



/* DATE BUTTONS */

.show-dates{

display:flex;

justify-content:center;

gap:15px;

margin:35px 0;
}

.date-chip{

background:#111827;

border:1px solid #333;

border-radius:15px;

padding:15px 25px;

text-decoration:none;

color:white;

transition:.4s;
}

.date-chip:hover{

transform:translateY(-5px);
}

.date-chip.active{

background:var(--red);

box-shadow:
0 0 20px var(--redGlow);

border-color:var(--red);
}



/* SCREEN */

.screen-line{

margin:60px auto;

width:80%;

height:120px;

border-top-left-radius:100%;

border-top-right-radius:100%;

border:5px solid rgba(255,50,50,.7);

border-bottom:none;

display:flex;

align-items:center;

justify-content:center;

background:

linear-gradient(
180deg,
rgba(255,40,50,.25),
transparent
);

box-shadow:

0 0 40px rgba(255,0,0,.3);
}

.screen-line span{

font-size:50px;

font-weight:800;

letter-spacing:8px;
}


/* SEATS */

.seat-board{

padding:30px;
}

.seat-row{

display:flex;

justify-content:center;

align-items:center;

gap:12px;

margin-bottom:12px;
}

.row-label{

width:30px;

color:#ff3d3d;

font-size:24px;

font-weight:bold;
}

