	/* Responsive seat booking redesign tied to the active app theme. */
	:root{
	--seat-page-bg:var(--app-profile-bg, var(--app-bg, #101722));
	--seat-page-text:var(--app-page-text, var(--app-card-text, #f8fafc));
	--seat-card-bg:color-mix(in srgb, var(--app-card, #182233) 88%, transparent);
	--seat-card-strong:color-mix(in srgb, var(--app-card, #182233) 94%, var(--app-bg, #101722) 6%);
	--seat-soft-bg:color-mix(in srgb, var(--app-input, #20293a) 72%, transparent);
	--seat-border:color-mix(in srgb, var(--app-input-border, #526174) 78%, transparent);
	--seat-muted:var(--app-muted, #cbd5e1);
	--seat-primary:var(--app-primary, #7a8cff);
	--seat-accent:var(--app-accent-strong, #2dd4bf);
	--seat-warm:var(--app-accent, #ffd166);
	--seat-danger:var(--app-danger, #dc4c64);
	--seat-success:var(--app-success, #2dd4bf);
	--seat-shadow:0 24px 70px color-mix(in srgb, #000000 20%, transparent);
	}

	html[data-theme] body,
	body{
	background:var(--seat-page-bg);
	color:var(--seat-page-text);
	overflow-x:hidden;
	}

	.booking-page{
	width:min(1500px,100%);
	max-width:1500px;
	padding:clamp(12px,3vw,34px);
	color:var(--seat-page-text);
	}

	.booking-hero{
	display:grid;
	grid-template-columns:minmax(0,1fr) auto;
	gap:clamp(16px,3vw,30px);
	align-items:center;
	padding:clamp(18px,4vw,34px);
	border:1px solid var(--seat-border);
	border-radius:28px;
	background:
	radial-gradient(circle at 12% 8%, color-mix(in srgb, var(--seat-warm) 20%, transparent), transparent 32%),
	radial-gradient(circle at 88% 12%, color-mix(in srgb, var(--seat-accent) 18%, transparent), transparent 34%),
	linear-gradient(145deg, var(--seat-card-bg), var(--seat-card-strong));
	box-shadow:var(--seat-shadow);
	}

	.booking-kicker{
	padding:8px 14px;
	border:1px solid color-mix(in srgb, var(--seat-accent) 34%, var(--seat-border));
	border-radius:999px;
	color:var(--seat-page-text);
	background:color-mix(in srgb, var(--seat-soft-bg) 88%, var(--seat-accent) 12%);
	font-size:.78rem;
	font-weight:950;
	letter-spacing:0;
	}

	.booking-hero h1{
	margin:12px 0 10px;
	color:var(--seat-page-text);
	font-size:clamp(2rem,7vw,5rem);
	line-height:.96;
	font-style:normal;
	letter-spacing:0;
	overflow-wrap:anywhere;
	}

	.booking-hero p{
	max-width:980px;
	margin:0;
	color:var(--seat-muted);
	font-weight:800;
	line-height:1.55;
	}

	.booking-hero-actions{
	display:flex;
	flex-wrap:wrap;
	justify-content:flex-end;
	gap:10px;
	min-width:min(100%,230px);
	}

	.booking-hero-actions .btn{
	display:inline-flex;
	align-items:center;
	justify-content:center;
	min-height:44px;
	padding:10px 16px;
	border-radius:999px;
	font-weight:900;
	white-space:nowrap;
	}

	.booking-hero-actions .btn-primary{
	border-color:var(--seat-primary);
	background:linear-gradient(135deg,var(--seat-primary),var(--seat-accent));
	color:#fff;
	}

	.booking-hero-actions .btn-secondary{
	border:1px solid var(--seat-border);
	background:var(--seat-soft-bg);
	color:var(--seat-page-text);
