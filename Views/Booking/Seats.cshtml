@model AmarShowsBook.Models.ShowSchedule

@{
    ViewData["Title"]="Seat Booking";

    var title=
    Model.Type=="Movie"
    ? Model.Movie?.Title
    :
    Model.Type=="Standup"
    ? Model.StandupShow?.Title
    :
    Model.LiveStream?.Title;

    var location=
    Model.Location==null
    ?
    "Location to be announced"
    :
    $"{Model.Location.Area}, {Model.Location.State}, {Model.Location.Country}";

    var seats=
    ViewBag.Seats
    as List<AmarShowsBook.Models.ViewModels.SeatVM>;
}

<section class="booking-page">

<div class="booking-hero">

<div>

<span class="booking-kicker">

Seat Shot

</span>

<h1>

@(title ?? "Untitled Show")

</h1>

<p>

@Model.Type /
@Model.StartTime.ToString("dd MMM yyyy, hh:mm tt")
/
@location

</p>

</div>

<div class="booking-hero-actions no-print">
    <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
    <a
    href="/Home/Index?type=@Model.Type"
    class="btn btn-secondary">

    Back To ShowTime

    </a>
</div>

</div>



<div class="screen-line">

<span>

SCREEN

</span>

</div>



<div class="seat-board">

@if(seats!=null && seats.Any())
{
    var groupedSeats=
    seats
    .GroupBy(x=>x.Row)
    .OrderBy(x=>x.Key);

    foreach(var rowGroup in groupedSeats)
    {
        <div class="seat-row">

            <div class="row-label">

                @rowGroup.Key

            </div>

            @{
                int count=0;
            }

            @foreach(var seat in rowGroup.OrderBy(x=>Convert.ToInt32(x.Number)))
            {
                var cssClass="available";

                if(seat.IsBooked)
                {
                    cssClass="booked";
                }
                else if(seat.IsLocked)
                {
                    cssClass="locked";
                }
                else if(seat.Price>300)
                {
                    cssClass="gold";
                }

                count++;

                <button
                type="button"
                class="seat-btn @cssClass"
                data-id="@seat.SeatId"
                data-name="@seat.Row@seat.Number"
                data-price="@seat.Price"
                onclick="toggleSeat(this)"
                @(seat.IsBooked||seat.IsLocked?"disabled":"")>

                    <div class="seat-name">

                        @seat.Row@seat.Number

                    </div>

                    <div class="seat-price">

                        ₹@seat.Price

                    </div>

                </button>

                @if(count==5)
                {
                    <div class="seat-gap"></div>
                }
            }

        </div>
    }
}

</div>



<div class="legend">

<div class="legend-item">
<div class="legend-box available"></div>
Available
</div>

<div class="legend-item">
<div class="legend-box selected"></div>
Selected
</div>

<div class="legend-item">
<div class="legend-box locked"></div>
Locked
</div>

<div class="legend-item">
<div class="legend-box booked"></div>
Booked
</div>

<div class="legend-item">
<div class="legend-box gold"></div>
Premium
</div>

</div>



<div class="booking-summary">

<div>

<div>

<span>

Selected Seats

</span>

<strong id="selectedSeats">

None

</strong>

</div>

<br>

<div>

<span>

Seat Price

</span>

<strong id="seatPrice">

₹0

</strong>

</div>

<br>

<div>

<span>

Total Amount

</span>

<strong id="totalAmount">

₹0

</strong>

</div>

</div>


<button
type="button"
class="btn btn-primary"
onclick="nextStep()">

Next

</button>

</div>

</section>



<style>
:root{

--primary:#ff3366;
--secondary:#7c3aed;

--green:#00ff88;
--red:#ff3b5c;
--orange:#f59e0b;

--dark:#050816;
--glass:rgba(255,255,255,.08);

--border:rgba(255,255,255,.12);

}

.booking-page,
.booking-page *{
margin:0;
padding:0;
box-sizing:border-box;
}

.booking-page{

font-family:Segoe UI,sans-serif;

background:
radial-gradient(
circle at top left,
rgba(124,58,237,.35),
transparent 40%
),
radial-gradient(
circle at bottom right,
rgba(255,51,102,.35),
transparent 40%
),
linear-gradient(
135deg,
#050816,
#0f172a,
#170d3b
);

background-size:400% 400%;

animation:
bgMove 15s ease infinite;

color:white;

min-height:calc(100vh - 180px);

overflow-x:hidden;

}

@@keyframes bgMove{

0%{

background-position:0% 50%;

}

50%{

background-position:100% 50%;

}

100%{

background-position:0% 50%;

}

}

.booking-page{

padding:40px;
max-width:1500px;
margin:auto;
border-radius:8px;

}


/* HERO */

.booking-hero{

display:flex;

justify-content:space-between;

align-items:center;

padding:35px;

border-radius:30px;

background:rgba(255,255,255,.07);

backdrop-filter:blur(30px);

border:1px solid var(--border);

box-shadow:

0 15px 40px rgba(0,0,0,.4),
0 0 30px rgba(124,58,237,.25);

margin-bottom:50px;

animation:
fadeUp 1s ease;

}

.booking-hero-actions{
display:flex;
gap:12px;
flex-wrap:wrap;
justify-content:flex-end;
}

.booking-kicker{

padding:10px 20px;

font-size:13px;

font-weight:700;

letter-spacing:2px;

border-radius:999px;

background:
linear-gradient(
90deg,
var(--primary),
var(--secondary)
);

display:inline-block;

margin-bottom:15px;

}

.booking-hero h1{

font-size:42px;

font-weight:800;

margin:15px 0;

color:white;

}

.booking-hero p{

color:#d1d5db;

font-size:16px;

line-height:1.7;

}


/* SCREEN */

.screen-line{

width:85%;

margin:70px auto;

text-align:center;

position:relative;

}

.screen-line:before{

content:"";

position:absolute;

width:100%;
height:8px;

background:

linear-gradient(
90deg,
transparent,
white,
transparent
);

border-radius:100%;

filter:blur(2px);

animation:
screenGlow 2s infinite;

}

@@keyframes screenGlow{

0%{

opacity:.4;

}

50%{

opacity:1;

}

100%{

opacity:.4;

}

}

.screen-line span{

display:inline-block;

margin-top:35px;

padding:12px 35px;

background:white;

color:black;

font-weight:800;

border-radius:999px;

box-shadow:

0 0 25px rgba(255,255,255,.8);

}


/* SEAT AREA */

.seat-board{

display:flex;

flex-direction:column;

gap:18px;

padding:45px;

border-radius:35px;

background:rgba(255,255,255,.05);

backdrop-filter:blur(30px);

border:1px solid var(--border);

box-shadow:

0 0 50px rgba(0,0,0,.4);

perspective:1100px;
transform:rotateX(4deg);
transform-origin:center top;

}


.seat-row{

display:flex;

justify-content:center;

align-items:center;

gap:12px;

animation:
fadeUp .6s ease;

}


.row-label{

width:45px;

font-size:18px;

font-weight:900;

color:#fff;

}


/* SEATS */

.seat-btn{

width:75px;
height:75px;

border:none;

border-radius:18px;

cursor:pointer;

transition:.4s;
transform:translateZ(0);

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

position:relative;

overflow:hidden;

font-weight:700;

box-shadow:
0 10px 0 rgba(0,0,0,.24),
0 18px 28px rgba(0,0,0,.28),
inset 0 1px 0 rgba(255,255,255,.55);

}

.seat-btn:after{
content:"";
position:absolute;
left:14%;
right:14%;
bottom:8px;
height:9px;
border-radius:999px;
background:rgba(0,0,0,.18);
}

.seat-btn:before{

content:"";

position:absolute;

width:100%;
height:100%;

background:

linear-gradient(
45deg,
transparent,
rgba(255,255,255,.2),
transparent
);

left:-100%;

transition:.6s;

}

.seat-btn:hover:before{

left:100%;

}

.seat-btn:hover{

transform:
translateY(-8px)
scale(1.08)
rotateX(10deg);

}


.seat-name{

font-size:14px;

font-weight:800;

z-index:2;

color:inherit;

}

.seat-price{

font-size:11px;

opacity:.95;

z-index:2;

color:inherit;

margin-top:5px;

}


.available{

background:white;
color:black;

}

.selected{

background:

linear-gradient(
135deg,
#00ff88,
#00d084
)!important;

color:black!important;

box-shadow:

0 10px 0 rgba(0,90,54,.7),
0 0 25px #00ff88;

}

.booked{

background:var(--red);

color:white;

cursor:not-allowed;
box-shadow:0 8px 0 rgba(100,0,20,.7), 0 16px 24px rgba(0,0,0,.3);

}

.locked{

background:var(--orange);

color:black;

cursor:not-allowed;
box-shadow:0 8px 0 rgba(120,72,0,.7), 0 16px 24px rgba(0,0,0,.3);

}

.gold{

background:

linear-gradient(
135deg,
gold,
orange
);

color:black;

box-shadow:

0 10px 0 rgba(145,88,0,.75),
0 0 20px gold;

}


/* LEGEND */

.legend{

display:flex;

justify-content:center;

flex-wrap:wrap;

gap:15px;

margin:50px 0;

}

.legend-item{

display:flex;

align-items:center;

gap:10px;

padding:12px 22px;

border-radius:999px;

background:rgba(255,255,255,.07);

backdrop-filter:blur(15px);

font-size:14px;

}

.legend-box{

width:18px;
height:18px;

border-radius:5px;

}


/* SUMMARY */

.booking-summary{

display:flex;

justify-content:space-between;

align-items:center;

padding:35px;

border-radius:30px;

background:rgba(255,255,255,.08);

backdrop-filter:blur(25px);

border:1px solid var(--border);

margin-top:50px;

}

.booking-summary strong{

font-size:18px;

color:white;

}

#totalAmount{

font-size:35px;

font-weight:900;

color:var(--green);

text-shadow:

0 0 15px var(--green);

}


/* BUTTON */

.btn{

padding:14px 28px;

border:none;

border-radius:15px;

font-weight:700;

cursor:pointer;

transition:.4s;

}

.btn-primary{

background:

linear-gradient(
90deg,
var(--primary),
var(--secondary)
);

color:white;

box-shadow:

0 0 20px rgba(255,51,102,.4);

}

.btn-primary:hover{

transform:
translateY(-4px);

box-shadow:

0 0 30px rgba(255,51,102,.8);

}


/* ANIMATION */

@@keyframes fadeUp{

from{

opacity:0;

transform:translateY(40px);

}

to{

opacity:1;

transform:translateY(0);

}

}


/* MOBILE */

@@media(max-width:768px){

.booking-hero{

flex-direction:column;

gap:20px;

}

.booking-summary{

flex-direction:column;

gap:25px;

}

.seat-row{

flex-wrap:wrap;

}

.row-label{

width:100%;

text-align:center;

margin-bottom:10px;

}

.seat-gap{

display:none;

}

.seat-btn{

width:65px;

height:65px;

}

}

</style>


<script>

const maxSeatLimit=
@(User.IsInRole("Admin") ? 999 : 6);



function toggleSeat(button)
{
    if(
        button.classList.contains("booked")
        ||
        button.classList.contains("locked")
    )
    {
        return;
    }

    let selected=

    document.querySelectorAll(
    ".seat-btn.selected"
    );


    if(
        !button.classList.contains("selected")
        &&
        selected.length>=maxSeatLimit
    )
    {
        showCinemaPopup(
        `Maximum ${maxSeatLimit} seats allowed`,
        "error"
        );

        return;
    }

    button.classList.toggle(
    "selected"
    );

    updateSeatDisplay();
}




function updateSeatDisplay()
{
    let selected=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatNames=

    selected.map(
    x=>x.dataset.name
    );


    let prices=

    selected.map(
    x=>
    "₹"+
    parseFloat(
    x.dataset.price||0
    )
    );


    let total=

    selected.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    document.getElementById(
    "selectedSeats"
    ).innerText=

    seatNames.length
    ?
    seatNames.join(", ")
    :
    "None";


    document.getElementById(
    "seatPrice"
    ).innerText=

    prices.length
    ?
    prices.join(", ")
    :
    "₹0";


    document.getElementById(
    "totalAmount"
    ).innerText=

    "₹"+total;
}




function nextStep()
{
    let selectedSeats=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatIds=

    selectedSeats.map(
    x=>x.dataset.id
    );


    if(!seatIds.length)
    {
        showCinemaPopup(
        "Please select seats",
        "error"
        );

        return;
    }


    let total=

    selectedSeats.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    fetch(
    "/Booking/LockSeats",
    {

        method:"POST",

        headers:
        {
            "Content-Type":
            "application/json"
        },

        body:
        JSON.stringify(
        {
            scheduleId:@Model.Id,

            seatIds:seatIds,

            totalAmount:total
        })

    })

    .then(
    x=>x.json()
    )

    .then(
    result=>
    {
        if(result.success)
        {
            showCinemaPopup(
            "Seats Locked",
            "success"
            );

            window.location=
            "/Booking/Details?id="
            +
            result.bookingId;
        }
        else
        {
            showCinemaPopup(
            result.message,
            "error"
            );
        }
    })

    .catch(
    error=>
    {
        console.log(error);

        showCinemaPopup(
        "Something went wrong",
        "error"
        );
    });

}

</script>
