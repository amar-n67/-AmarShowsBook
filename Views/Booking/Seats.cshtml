</style>

<script>

const maxSeatLimit=
@(User.IsInRole("Admin") ? 999 : 6);



function toggleSeat(button)
{
    if(
        button.classList.contains("booked")
        ||
        button.classList.contains("locked")
    )
    {
        return;
    }

    let selected=

    document.querySelectorAll(
    ".seat-btn.selected"
    );


    if(
        !button.classList.contains("selected")
        &&
        selected.length>=maxSeatLimit
    )
    {
        showCinemaPopup(
        `Maximum ${maxSeatLimit} seats allowed`,
        "error"
        );

        return;
    }

    button.classList.toggle(
    "selected"
    );

    updateSeatDisplay();
}




function updateSeatDisplay()
{
    let selected=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatNames=

    selected.map(
    x=>x.dataset.name
    );


    let prices=

    selected.map(
    x=>
    "₹"+
    parseFloat(
    x.dataset.price||0
    )
    );


    let total=

    selected.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    document.getElementById(
    "selectedSeats"
    ).innerText=

    seatNames.length
    ?
    seatNames.join(", ")
    :
    "None";


    document.getElementById(
    "seatPrice"
    ).innerText=

    prices.length
    ?
    prices.join(", ")
    :
    "₹0";


    document.getElementById(
    "totalAmount"
    ).innerText=

    "₹"+total;
}




function nextStep()
{
    let selectedSeats=

    Array.from(
    document.querySelectorAll(
    ".seat-btn.selected"
    ));


    let seatIds=

    selectedSeats.map(
    x=>x.dataset.id
    );


    if(!seatIds.length)
    {
        showCinemaPopup(
        "Please select seats",
        "error"
        );

        return;
    }


    let total=

    selectedSeats.reduce(
    (sum,x)=>

    sum+

    parseFloat(
    x.dataset.price||0
    ),

    0
    );


    fetch(
    "/Booking/LockSeats",
    {

        method:"POST",

        headers:
        {
            "Content-Type":
            "application/json"
        },

        body:
        JSON.stringify(
        {
            scheduleId:@Model.Id,

            seatIds:seatIds,

            totalAmount:total
        })

    })

    .then(
    x=>x.json()
    )

    .then(
    result=>
    {
        if(result.success)
        {
            showCinemaPopup(
            "Seats Locked",
            "success"
            );

            window.location=
            "/Booking/Details?id="
            +
            result.bookingId;
        }
        else
        {
            showCinemaPopup(
            result.message,
            "error"
            );
        }
    })

    .catch(
    error=>
    {
        console.log(error);

        showCinemaPopup(
        "Something went wrong",
        "error"
        );
    });

}

</script>
