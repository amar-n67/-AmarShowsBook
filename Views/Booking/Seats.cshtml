@model AmarShowsBook.Models.ShowSchedule

@{
    ViewData["Title"]="Seat Booking";

    var title=
    Model.Type=="Movie"
    ? Model.Movie?.Title
    :
    Model.Type=="Standup"
    ? Model.StandupShow?.Title
    :
    Model.LiveStream?.Title;

    var location=
    Model.Location==null
    ?
    "Location to be announced"
    :
    $"{Model.Location.Area}, {Model.Location.State}, {Model.Location.Country}";

    @* var seats=
    ViewBag.Seats
    as List<AmarShowsBook.Models.ViewModels.SeatVM>; *@
    var seats=
ViewBag.Seats
as List<AmarShowsBook.Models.ViewModels.SeatVM>;

var availableDates=
ViewBag.AvailableDates
as List<AmarShowsBook.Models.ShowSchedule>;

var trailerUrl=
ViewBag.TrailerUrl as string;

var trailerStartSeconds=
ViewBag.TrailerStartSeconds as int? ?? 0;

var screen=
ViewBag.Screen as Screen;

var venueInfo=
ViewBag.Venue as AmarShowsBook.Models.Venue;

var theaterDetails =
venueInfo!=null
? $"{venueInfo.VenueName} / {screen?.ScreenName ?? "Screen TBA"} / {venueInfo.Address}, {venueInfo.City}"
: location;
}

<section class="booking-page">

<div class="booking-hero">

<div>

<span class="booking-kicker">

Seat Shot

</span>

<h1>

@(title ?? "Untitled Show")

</h1>

<p>

@Model.Type /
@Model.StartTime.ToString("dd MMM yyyy, hh:mm tt")
/
@theaterDetails

</p>

</div>

<div class="booking-hero-actions no-print">
    <button type="button" class="btn btn-primary" onclick="window.print()">Print</button>
    <a
    href="/Home/Index?type=@Model.Type"
    class="btn btn-secondary">

    Back To ShowTime

    </a>
</div>

</div>

@{
    var currentDate =
    Model.StartTime.Date;
}

@if(availableDates != null && availableDates.Any())
{
<div class="show-dates">

@foreach(var show in
availableDates
.Where(x=>x.StartTime >= DateTime.UtcNow)
.GroupBy(x=>x.StartTime.Date)
.Select(x=>x.First())
.OrderBy(x=>x.StartTime))
{
    bool activeDate =
    show.StartTime.Date == currentDate;

    <a
    class="date-chip @(activeDate ? "active":"")"
    href="/Booking/Seats/@show.Id">

        @show.StartTime.ToString("dd MMM")

    </a>
}

</div>
}
<div class="screen-line @(string.IsNullOrWhiteSpace(trailerUrl) ? "" : "has-trailer")"
     data-trailer-url="@trailerUrl"
     data-trailer-start="@trailerStartSeconds">

@* <span>

SCREEN

</span> *@

<iframe
id="seatTrailerFrame"
title="Show trailer preview"
allow="autoplay; encrypted-media"
allowfullscreen>
</iframe>

</div>



<div class="seat-board">

@if(seats!=null && seats.Any())
{
    var groupedSeats=
    seats
    .GroupBy(x=>x.Row)
    .OrderBy(x=>x.Key);

    foreach(var rowGroup in groupedSeats)
    {
        <div class="seat-row">

            <div class="row-label">

                @rowGroup.Key

            </div>

            @{
                int count=0;
            }

            @foreach(var seat in rowGroup.OrderBy(x=>Convert.ToInt32(x.Number)))
            {
                var cssClass="available";

                if(seat.IsBooked)
                {
                    cssClass="booked";
                }
                else if(seat.IsLocked)
                {
                    cssClass="locked";
                }
                else if(seat.Price>300)
                {
                    cssClass="gold";
                }

                count++;

                <button
                type="button"
                class="seat-btn @cssClass"
                data-id="@seat.SeatId"
                data-name="@seat.Row@seat.Number"
                data-price="@seat.Price"
                onclick="toggleSeat(this)"
                @(seat.IsBooked||seat.IsLocked?"disabled":"")>

                    <div class="seat-name">

                        @seat.Row@seat.Number

                    </div>

                    <div class="seat-price">

                        ₹@seat.Price

                    </div>

                </button>

                @if(count==5 && rowGroup.Count()>5)
{
    <div class="seat-gap"></div>
}
            }

        </div>
    }
}

</div>



<div class="legend">

<div class="legend-item">
<div class="legend-box available"></div>
Available
</div>

<div class="legend-item">
<div class="legend-box selected"></div>
Selected
</div>

<div class="legend-item">
<div class="legend-box locked"></div>
Locked
</div>

<div class="legend-item">
<div class="legend-box booked"></div>
Booked
</div>

<div class="legend-item">
<div class="legend-box gold"></div>
Premium
</div>

</div>
<div class="booking-summary">

    <div class="ticket-receipt">

        <div class="ticket-header">
            CINEMA RECEIPT
        </div>

        <div class="ticket-body">

            <div class="receipt-row">

                <div class="receipt-title">
                    Selected Seats
                </div>

                <div
                id="selectedSeatsContainer"
                class="receipt-data">

                </div>

            </div>


            <div class="receipt-row">

                <div class="receipt-title">
                    Seat Price
                </div>

                <div
                id="seatPriceContainer"
                class="receipt-data">

                </div>

            </div>

        </div>


        <div class="receipt-total">

            <span>
                TOTAL
            </span>

            <strong id="totalAmount">
                ₹0
            </strong>

        </div>

        <div class="ticket-cut-left"></div>
        <div class="ticket-cut-right"></div>

    </div>


    <div class="cinema-side">

        <div class="cinema-animation">

            <div style="font-size:40px">
                🍿
            </div>

            <div class="rat-track">

                <div class="rat">

                    🐀

                </div>

            </div>

            <p>
                Enjoy the show!
            </p>

        </div>


        <button
        type="button"
        class="btn next-btn"
        onclick="nextStep()">

            Next →

        </button>

    </div>

</div>
</section>

