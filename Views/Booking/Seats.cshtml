0 8px 18px rgba(0,0,0,.6);

}

.seat-btn:hover{

transform:

translateY(-8px)
scale(1.06);
}

.available{

background:

linear-gradient(
180deg,
#ffffff,
#cccccc
);

color:black;
}

.selected{

background:

linear-gradient(
180deg,
#22ff66,
#16c74d
)!important;

color:black!important;
}

.booked{

background:

linear-gradient(
180deg,
#ff4444,
#c40000
);

cursor:not-allowed;
}

.locked{

background:

linear-gradient(
180deg,
#8b5cf6,
#6d28d9
);
}

.gold{

background:

linear-gradient(
180deg,
#f9c74f,
#d49b2a
);

color:black;
}

.seat-name{

font-size:13px;
}

.seat-price{

font-size:11px;
}


/* LEGEND */

.legend{

display:flex;

justify-content:center;

gap:30px;

margin:40px 0;

padding:20px;

border-radius:50px;

background:#0d1118;
}

.legend-item{

display:flex;

align-items:center;

gap:10px;
}

.legend-box{

width:25px;

height:25px;

border-radius:8px;
}



/* SUMMARY */

.booking-summary{

margin-top:40px;

display:flex;

justify-content:space-between;

align-items:center;

padding:35px;

background:

linear-gradient(
145deg,
#181818,
#0d1118
);

border-radius:25px;

box-shadow:
0 0 30px rgba(255,0,0,.15);
}

.booking-summary span{

display:block;

font-size:14px;

color:#aaa;
}

.booking-summary strong{

font-size:20px;
}

