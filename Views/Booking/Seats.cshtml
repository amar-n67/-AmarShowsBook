}

.seat-lock-tooltip span{
display:block;
font-size:10px;
font-weight:950;
letter-spacing:.08em;
text-transform:uppercase;
color:#c4b5fd;
}

.seat-lock-tooltip strong{
display:block;
margin-top:4px;
font-size:20px;
font-weight:950;
font-variant-numeric:tabular-nums;
color:#facc15;
text-shadow:0 0 14px rgba(250,204,21,.28);
}

.seat-lock-tooltip small{
display:block;
margin-top:3px;
font-size:10px;
font-weight:800;
line-height:1.25;
