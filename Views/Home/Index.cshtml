<script>

function closeTrailer()
{
    document
    .getElementById("trailerFrame")
    .src="";

    document
    .getElementById("trailerModal")
    .style.display="none";
}

function showLocationError(message)
{
    if(typeof showCinemaPopup==="function")
    {
        showCinemaPopup(
        message,
        "error"
        );
        return;
    }

    alert(message);
}

function showTrailerSoon()
{
    if(typeof showCinemaPopup==="function")
    {
        showCinemaPopup(
        "Trailer coming soon.",
        "info"
        );
        return;
    }

    alert("Trailer coming soon.");
}

function getYouTubeVideoId(url)
{
    if(!url || url==="#")
    {
        return "";
    }

    try
    {
        const parsedUrl = new URL(url);
        const host = parsedUrl.hostname.toLowerCase();

        if(host.includes("youtu.be"))
        {
            return parsedUrl.pathname.split("/").filter(Boolean)[0] || "";
        }

        if(parsedUrl.pathname.includes("/embed/"))
        {
            return parsedUrl.pathname.split("/embed/")[1]?.split("/")[0] || "";
        }

        if(parsedUrl.pathname.includes("/shorts/"))
        {
            return parsedUrl.pathname.split("/shorts/")[1]?.split("/")[0] || "";
        }

        return parsedUrl.searchParams.get("v") || "";
    }
    catch
    {
        return "";
    }
}

function setSelectOptions(
selectId,
options,
placeholder,
selectedName
)
{
    const select=
    document.getElementById(
    selectId
    );

    if(!select)
    {
        return;
    }

    select.innerHTML=
    `<option value="">
    ${placeholder}
    </option>`;

    options.forEach(item=>{

        const option=
        document.createElement(
        "option"
        );

        const optionName=
        item.name || item;

        option.value=optionName;

        option.dataset.id=
        item.id || "";

        option.dataset.hasData=
        item.id
        ?
        "true"
        :
        "false";

        option.dataset.name=
        optionName;

        option.textContent=
        optionName;

        if(
        selectedName &&
        optionName
        .toLowerCase()
        ===
        selectedName
        .toLowerCase()
        )
        {
            option.selected=true;
        }

        select.appendChild(
        option
        );

    });
}


async function loadCountries()
{
    try
    {
        const response=
        await fetch(
        "/Home/GetCountries"
        );

        if(!response.ok)
        {
            throw new Error(
            "Country request failed"
            );
        }

        const countries=
        await response.json();

        const india=countries.find(x=>x.name && x.name.toLowerCase()==="india");

        const selectedCountryName=india ? india.name : "";

        setSelectOptions(
        "country",
        countries,
        "All Countries",
        selectedCountryName
        );

        if(india)
        {
            await loadStates();
        }

    }
    catch
    {
        setSelectOptions(
        "country",
        [],
        "All Countries"
        );

        setSelectOptions(
        "state",
        [],
        "All States"
        );

        setSelectOptions(
        "district",
        [],
        "All Regions"
        );

        showLocationError(
        "Could not load countries."
        );
    }
}



async function loadStates()
{
    const countrySelect=
    document.getElementById(
    "country"
    );

    const selectedCountry=
    countrySelect.options[
    countrySelect.selectedIndex
    ];

    const countryId=
    selectedCountry
    ?
    selectedCountry.dataset.id
    :
    "";

    const countryName=countrySelect.value || "";

    setSelectOptions(
    "district",
    [],
    "All Regions"
    );

    if(!countryId && !countryName)
    {
        setSelectOptions(
        "state",
        [],
        "All States"
        );

        return;
    }

    try
    {
        const response=
        await fetch(
        `/Home/GetStates?countryId=${encodeURIComponent(countryId)}&countryName=${encodeURIComponent(countryName)}`
        );

        const states=
        await response.json();

        setSelectOptions(
        "state",
        states,
        "All States"
        );
    }
    catch
    {
        showLocationError(
        "Could not load states."
        );
    }
}



async function loadDistricts()
{
    const stateSelect=
    document.getElementById(
    "state"
    );

    const selectedState=
    stateSelect.options[
    stateSelect.selectedIndex
    ];

    const stateId=
    selectedState
    ?
    selectedState.dataset.id
    :
    "";

    const stateName=stateSelect.value || "";
    const countryName=document.getElementById("country")?.value || "";

    if(!stateId && !stateName)
    {
        setSelectOptions(
        "district",
        [],
        "All Regions"
        );

        return;
    }

    try
    {
        const response=
        await fetch(
        `/Home/GetDistricts?stateId=${encodeURIComponent(stateId)}&stateName=${encodeURIComponent(stateName)}&countryName=${encodeURIComponent(countryName)}`
        );

        const districts=
        await response.json();

        setSelectOptions(
        "district",
        districts,
        "All Regions"
        );
    }
    catch
    {
        showLocationError(
        "Could not load regions."
        );
    }
}

function applyLocationFilter()
{
    const country=
    document.getElementById("country")?.value.toLowerCase() || "";

    const state=
    document.getElementById("state")?.value.toLowerCase() || "";

    const district=
    document.getElementById("district")?.value.toLowerCase() || "";

    document.querySelectorAll(".show-card").forEach(card=>{
        const cardCountry=(card.dataset.country || "").toLowerCase();
        const cardState=(card.dataset.state || "").toLowerCase();
        const cardRegion=(card.dataset.region || "").toLowerCase();
        const cardLocation=(card.dataset.location || card.innerText || "").toLowerCase();
        const matchesCountry=!country || cardCountry===country || cardLocation.includes(country);
        const matchesState=!state || cardState===state || cardLocation.includes(state);
        const matchesDistrict=!district || cardRegion===district || cardLocation.includes(district);
        card.hidden=!(matchesCountry && matchesState && matchesDistrict);
    });
}

function resetLocationFilter()
{
    ["country","state","district"].forEach(id=>{
        const select=document.getElementById(id);
        if(select)
        {
            select.selectedIndex=0;
        }
    });

    document.querySelectorAll(".show-card").forEach(card=>{
        card.hidden=false;
    });

    loadCountries();
}



document.addEventListener(
"DOMContentLoaded",
()=>{

loadCountries();



document
.querySelectorAll(
".image-strip"
)
.forEach(slider=>{

const images=
slider.querySelectorAll(
".swap-image"
);

if(
images.length<=1
)
return;

let current=0;

setInterval(()=>{

images[current]
.classList.remove(
"active"
);

current=
(
current+1
)
%
images.length;

images[current]
.classList.add(
"active"
);

},3000);

});



document
.querySelectorAll(
".trailer-btn"
)
.forEach(button=>{

button.addEventListener(
"click",
(event)=>{

event.preventDefault();

event.stopPropagation();

let url=
button.dataset.url;

let videoId=getYouTubeVideoId(url);

if(videoId)
{
document
.getElementById(
"trailerFrame"
)
.src=
`https://www.youtube.com/embed/${videoId}?autoplay=1`;

document
.getElementById(
"trailerModal"
)
.style.display=
"flex";
}
else
{
showTrailerSoon();
}

});

});



document
.getElementById(
"trailerModal"
)
.addEventListener(
"click",
function(e){

if(
e.target.id===
"trailerModal"
)
{
closeTrailer();
}

});

});

</script>
