    }

    .action-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
        border-radius: 6px;
        background: rgba(255,255,255,.2);
        line-height: 1;
        font-size: 0.88rem;
    }

.trailer-btn:hover span:last-child,
.btn-primary:hover span:last-child,
