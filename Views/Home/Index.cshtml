@model AmarShowsBook.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "showTime";
    var selectedType = Context.Request.Query["type"].ToString();
    if (string.IsNullOrWhiteSpace(selectedType))
    {
        selectedType = "Movie";
    }
    var userName = Context.Session.GetString("UserName") ?? "Artist";
    var userLanguage = Context.Session.GetString("UserLanguage") ?? "English";
    var userGenre = Context.Session.GetString("UserGenre") ?? "Dramatic";
}

<section class="showtime-page">
    <div class="showtime-hero">
        <div>
            <span class="showtime-kicker">Now Rolling</span>
            <h1>showTime</h1>
            <p>@userName, your @userLanguage track and @userGenre mood are on the board.</p>
        </div>
        <div class="showtime-ticket">
            <span>@userLanguage</span>
            <strong>@userGenre</strong>
        </div>
    </div>

    <div class="showtime-controls">
        <div class="location-strip">
            <div>
                <label>Country</label>
                <select id="country" class="form-control" onchange="loadStates()">
                    <option value="">Loading countries...</option>
                </select>
            </div>

            <div>
                <label>State</label>
                <select id="state" class="form-control" onchange="loadDistricts()">
                    <option value="">Select State</option>
                </select>
            </div>

            <div>
                <label>Region</label>
                <select id="district" class="form-control">
                    <option value="">Select Region</option>
                </select>
            </div>
        </div>

        <nav class="showtime-tabs" aria-label="Show category">
            <a href="/Home/Index?type=Movie" class="@(selectedType == "Movie" ? "active" : "")">Movies</a>
            <a href="/Home/Index?type=Standup" class="@(selectedType == "Standup" ? "active" : "")">Standup</a>
            <a href="/Home/Index?type=Live" class="@(selectedType == "Live" ? "active" : "")">Live</a>
        </nav>
    </div>

    <div class="schedule-board">
        @if (!Model.HomeShows.Any())
        {
            <div class="empty-slate">
                <span>No Shot Scheduled</span>
                <h2>The reel is quiet for this category.</h2>
                <p>Try another tab or schedule a new show when the next scene is ready.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model.HomeShows)
{
    var showRegion =
        $"{item.Location}, {item.State}, {item.Country}";

                <article class="show-card">
                    <div class="show-card-top">
                        <span>@item.ShowType</span>
                        <strong>@item.StartTime.ToString("hh:mm tt")</strong>
                    </div>
                    <h2>@(item.Title ?? "Untitled Show")</h2>
                    <p>Camera opens at @item.StartTime.ToString("dd MMM yyyy, hh:mm tt")</p>
                    <p class="show-region">@showRegion</p>
                    <a class="btn btn-primary" href="/Booking/Seats/@item.ScheduleId">Book The Seat</a>
                </article>
            }
        }
    </div>
</section>

<style>
.showtime-page {
    padding-bottom: 44px;
}
.showtime-hero {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: flex-end;
    min-height: 260px;
    padding: 34px;
    border-radius: 8px;
    background:
        linear-gradient(135deg, rgba(255, 242, 199, 0.94), rgba(245, 178, 196, 0.86), rgba(146, 229, 221, 0.86)),
        repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px);
    color: #231f20;
    box-shadow: 0 22px 64px rgba(35,31,32,0.22);
}
.showtime-kicker,
.showtime-ticket span,
.show-card-top span,
.empty-slate span {
    text-transform: uppercase;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.08em;
}
.showtime-hero h1 {
    margin: 8px 0;
    color: #231f20;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 900;
}
.showtime-hero p {
    margin: 0;
    max-width: 620px;
    color: #34303a;
    font-size: 1.08rem;
}
.showtime-ticket {
    min-width: 180px;
    padding: 14px;
    border: 1px dashed rgba(35,31,32,0.44);
    border-radius: 8px;
    text-align: right;
    background: rgba(255,255,255,0.38);
}
.showtime-ticket strong {
    display: block;
    color: #231f20;
    font-size: 1.2rem;
}
.showtime-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: end;
    margin: 24px 0;
}
.location-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
}
.location-strip label {
    margin-bottom: 6px;
    font-weight: 800;
}
.showtime-tabs {
    display: inline-flex;
    gap: 6px;
    padding: 6px;
    border: 1px solid var(--app-input-border);
    border-radius: 999px;
    background: var(--app-card);
}
.showtime-tabs a {
    min-width: 90px;
    padding: 9px 14px;
    border-radius: 999px;
    color: var(--app-text);
    text-align: center;
    text-decoration: none;
    font-weight: 850;
}
.showtime-tabs a.active {
    background: var(--app-primary);
    color: #fff;
}
.schedule-board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
}
.show-card,
.empty-slate {
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    box-shadow: 0 14px 34px rgba(0,0,0,0.13);
}
.show-card {
    display: grid;
    gap: 12px;
    padding: 18px;
}
.show-card-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--app-muted);
}
.show-card h2 {
    min-height: 58px;
    margin: 0;
    color: inherit;
    font-size: 1.22rem;
    font-weight: 900;
}
.show-card p {
    margin: 0;
    color: var(--app-muted);
}
.show-region {
    min-height: 42px;
    font-weight: 750;
}
.show-card .btn {
    align-self: end;
    font-weight: 850;
}
.empty-slate {
    grid-column: 1 / -1;
    padding: 34px;
    text-align: center;
}
.empty-slate h2 {
    margin: 8px 0;
    color: inherit;
}
.empty-slate p {
    margin: 0;
    color: var(--app-muted);
}
@@media (max-width: 980px) {
    .showtime-controls,
    .schedule-board {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .showtime-tabs {
        grid-column: 1 / -1;
        justify-content: center;
    }
}
@@media (max-width: 760px) {
    .showtime-hero,
    .showtime-controls,
    .location-strip,
    .schedule-board {
        grid-template-columns: 1fr;
    }
    .showtime-hero {
        padding: 24px;
    }
    .showtime-ticket {
        width: 100%;
        text-align: left;
    }
    .showtime-tabs {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        width: 100%;
    }
    .showtime-tabs a {
        min-width: 0;
    }
}
</style>

<script>
function showLocationError(message) {
    if (typeof showCinemaPopup === "function") {
        showCinemaPopup(message, "error");
        return;
    }

    alert(message);
}

function setSelectOptions(selectId, options, placeholder, selectedName) {
    const select = document.getElementById(selectId);
    select.innerHTML = `<option value="">${placeholder}</option>`;

    options.forEach(item => {
        const option = document.createElement("option");
        const optionName = item.name || item;

        option.value = optionName;
        option.dataset.id = item.id || "";
        option.dataset.hasData = item.id ? "true" : "false";
        option.dataset.name = optionName;
        option.textContent = item.name || item;

        if (selectedName && optionName.toLowerCase() === selectedName.toLowerCase()) {
            option.selected = true;
        }

        select.appendChild(option);
    });
}

async function loadCountries() {
    try {
        const response = await fetch("/Home/GetCountries");

        if (!response.ok) {
            throw new Error("Country request failed");
        }

        const countries = await response.json();
        const india = countries.find(country => country.name && country.name.toLowerCase() === "india");
        const selectedCountryName = india ? india.name : "";

        setSelectOptions("country", countries, "Select Country", selectedCountryName);

        if (india && india.id) {
            await loadStates();
        }
    } catch {
        setSelectOptions("country", [], "Select Country");
        setSelectOptions("state", [], "Select State");
        setSelectOptions("district", [], "Select Region");
        showLocationError("Could not load countries. Please try again.");
    }
}

async function loadStates() {
    const countrySelect = document.getElementById("country");
    const selectedCountry = countrySelect.options[countrySelect.selectedIndex];
    const countryId = selectedCountry ? selectedCountry.dataset.id : "";

    setSelectOptions("district", [], "Select Region");

    if (!countryId) {
        setSelectOptions("state", [], selectedCountry && selectedCountry.value ? "No states available" : "Select State");
        return;
    }

    setSelectOptions("state", [], "Loading states...");

    try {
        const response = await fetch(`/Home/GetStates?countryId=${encodeURIComponent(countryId)}`);

        if (!response.ok) {
            throw new Error("State request failed");
        }

        const states = await response.json();
        setSelectOptions("state", states, states.length ? "Select State" : "No states available");
    } catch {
        setSelectOptions("state", [], "Select State");
        showLocationError("Could not load states. Please try again.");
    }
}

async function loadDistricts() {
    const stateSelect = document.getElementById("state");
    const selectedState = stateSelect.options[stateSelect.selectedIndex];
    const stateId = selectedState ? selectedState.dataset.id : "";

    if (!stateId) {
        setSelectOptions("district", [], "Select Region");
        return;
    }

    setSelectOptions("district", [], "Loading regions...");

    try {
        const response = await fetch(`/Home/GetDistricts?stateId=${encodeURIComponent(stateId)}`);

        if (!response.ok) {
            throw new Error("Region request failed");
        }

        const districts = await response.json();
        setSelectOptions("district", districts, districts.length ? "Select Region" : "No regions available");
    } catch {
        setSelectOptions("district", [], "Select Region");
        showLocationError("Could not load regions. Please try again.");
    }
}

document.addEventListener("DOMContentLoaded", loadCountries);
</script>
