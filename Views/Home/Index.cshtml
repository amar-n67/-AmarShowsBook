<script>
const showtimeFilterStorageKey="showtimeFilters";
const showtimeLaunchStorageKey="showtimeCurrentLocationInitialized";
const showtimeResetAfterNewsStorageKey="showtimeResetAfterNews";
let locationDisplayOverride="";
let currentLocationFilter=null;
let isRestoringShowtimeFilters=false;
const isPlatformMode=@(platformMode.ToString().ToLowerInvariant());
const isOttMode=@(string.Equals(selectedType, "OTT", StringComparison.OrdinalIgnoreCase).ToString().ToLowerInvariant());

function formatOttTime(seconds)
{
    if(!Number.isFinite(seconds) || seconds<0)
    {
        return "0:00";
    }

    const totalSeconds=Math.floor(seconds);
    const minutes=Math.floor(totalSeconds/60);
    const remainingSeconds=totalSeconds%60;
    return `${minutes}:${remainingSeconds.toString().padStart(2,"0")}`;
}

function setupOttExperience()
{
    if(!isOttMode)
    {
        return;
    }

    const shell=document.querySelector(".ott-player-shell");
    const frame=document.querySelector(".ott-video-frame");
    const video=document.getElementById("ottVideoPlayer");
    const source=video?.querySelector("source");
    const bigPlay=document.getElementById("ottBigPlay");
    const playPause=document.getElementById("ottPlayPause");
    const muteButton=document.getElementById("ottMute");
    const progress=document.getElementById("ottProgress");
    const volume=document.getElementById("ottVolume");
    const speed=document.getElementById("ottSpeed");
    const nextButton=document.getElementById("ottNext");
    const fullscreenButton=document.getElementById("ottFullscreen");
    const currentTime=document.getElementById("ottCurrentTime");
    const duration=document.getElementById("ottDuration");
    const search=document.getElementById("ottSearch");
    const cards=Array.from(document.querySelectorAll(".ott-title-card"));
    const platformButtons=Array.from(document.querySelectorAll(".ott-platform-pill"));
    let currentIndex=0;
    let selectedPlatform="All";

    if(!shell || !frame || !video || !source || !cards.length)
    {
        return;
    }

    const setText=(id,value)=>{
        const element=document.getElementById(id);
        if(element)
        {
            element.textContent=value || "";
        }
    };

    const syncPlaybackButtons=()=>{
        const isPlaying=!video.paused && !video.ended;
        frame.classList.toggle("is-playing",isPlaying);
        if(bigPlay)
        {
            bigPlay.textContent=isPlaying ? "Ⅱ" : "▶";
            bigPlay.title=isPlaying ? "Pause" : "Play";
            bigPlay.setAttribute("aria-label",isPlaying ? "Pause" : "Play");
        }
        if(playPause)
        {
            playPause.textContent=isPlaying ? "Ⅱ" : "▶";
            playPause.title=isPlaying ? "Pause" : "Play";
            playPause.setAttribute("aria-label",isPlaying ? "Pause" : "Play");
        }
    };

    const updateMuteButton=()=>{
        if(muteButton)
        {
            muteButton.textContent=video.muted || video.volume===0 ? "🔇" : "🔊";
            muteButton.title=video.muted || video.volume===0 ? "Unmute" : "Mute";
            muteButton.setAttribute("aria-label",muteButton.title);
        }
    };

    const updateVisibleCards=()=>{
        const query=(search?.value || "").trim().toLowerCase();
        cards.forEach(card=>{
            const matchesPlatform=selectedPlatform==="All" || card.dataset.platform===selectedPlatform;
            const searchBlob=[
                card.dataset.platform,
                card.dataset.title,
                card.dataset.type,
                card.dataset.language,
                card.dataset.description
            ].join(" ").toLowerCase();
            const matchesSearch=!query || searchBlob.includes(query);
            card.hidden=!(matchesPlatform && matchesSearch);
        });
    };

    const loadCard=(card,shouldPlay)=>{
        currentIndex=cards.indexOf(card);
        cards.forEach(item=>item.classList.toggle("active",item===card));
        const accent=card.dataset.accent || "var(--app-primary)";
        shell.style.setProperty("--ott-accent",accent);
        source.src=card.dataset.video || source.src;
        video.load();
        video.volume=Number(volume?.value || 0.8);
        video.playbackRate=Number(speed?.value || 1);
        setText("ottPlayerInitials",card.dataset.initials);
        setText("ottPlayerPlatform",card.dataset.platform);
        setText("ottPlayerQuality",card.dataset.quality);
        setText("ottPlayerType",card.dataset.type);
        setText("ottPlayerTitle",card.dataset.title);
        setText("ottPlayerRating",`${card.dataset.rating || "NA"} ★`);
        setText("ottPlayerYear",card.dataset.year);
        setText("ottPlayerDuration",card.dataset.duration);
        setText("ottPlayerLanguage",card.dataset.language);
        setText("ottPlayerDescription",card.dataset.description);
        if(progress)
        {
            progress.value="0";
        }
        if(currentTime)
        {
            currentTime.textContent="0:00";
        }
        syncPlaybackButtons();

        if(shouldPlay)
        {
            video.play().catch(()=>syncPlaybackButtons());
        }
    };

    const togglePlay=()=>{
        if(video.paused || video.ended)
        {
            video.play().catch(()=>syncPlaybackButtons());
        }
        else
        {
            video.pause();
        }
    };

    const playNext=()=>{
        const visibleCards=cards.filter(card=>!card.hidden);
        if(!visibleCards.length)
        {
            return;
        }
        const activeCard=cards[currentIndex] || visibleCards[0];
        const visibleIndex=visibleCards.indexOf(activeCard);
        const nextCard=visibleCards[(visibleIndex+1+visibleCards.length)%visibleCards.length];
        loadCard(nextCard,true);
    };

    platformButtons.forEach(button=>{
        button.addEventListener("click",()=>{
            selectedPlatform=button.dataset.platform || "All";
            platformButtons.forEach(item=>item.classList.toggle("active",item===button));
            updateVisibleCards();
            const firstVisible=cards.find(card=>!card.hidden);
            if(firstVisible)
            {
                loadCard(firstVisible,false);
            }
        });
    });

    cards.forEach(card=>{
        card.addEventListener("click",()=>loadCard(card,true));
    });

    search?.addEventListener("input",()=>{
        updateVisibleCards();
        const activeCard=cards[currentIndex];
        if(activeCard?.hidden)
        {
            const firstVisible=cards.find(card=>!card.hidden);
            if(firstVisible)
            {
                loadCard(firstVisible,false);
            }
        }
    });

    bigPlay?.addEventListener("click",togglePlay);
    playPause?.addEventListener("click",togglePlay);
    video.addEventListener("click",togglePlay);
    video.addEventListener("play",syncPlaybackButtons);
    video.addEventListener("pause",syncPlaybackButtons);
    video.addEventListener("ended",playNext);
    video.addEventListener("loadedmetadata",()=>{
        if(duration)
        {
            duration.textContent=formatOttTime(video.duration);
        }
    });
    video.addEventListener("timeupdate",()=>{
        if(currentTime)
        {
            currentTime.textContent=formatOttTime(video.currentTime);
        }
        if(progress && Number.isFinite(video.duration) && video.duration>0)
        {
            progress.value=((video.currentTime/video.duration)*100).toString();
        }
    });

    progress?.addEventListener("input",()=>{
        if(Number.isFinite(video.duration) && video.duration>0)
        {
            video.currentTime=(Number(progress.value)/100)*video.duration;
        }
    });

    volume?.addEventListener("input",()=>{
        video.volume=Number(volume.value);
        video.muted=video.volume===0;
        updateMuteButton();
    });

    muteButton?.addEventListener("click",()=>{
        video.muted=!video.muted;
        updateMuteButton();
    });

    speed?.addEventListener("change",()=>{
        video.playbackRate=Number(speed.value || 1);
    });

    nextButton?.addEventListener("click",playNext);
    fullscreenButton?.addEventListener("click",()=>{
        if(document.fullscreenElement)
        {
            document.exitFullscreen?.();
            return;
        }
        frame.requestFullscreen?.();
    });

    loadCard(cards[0],false);
    updateVisibleCards();
    updateMuteButton();
}

function closeTrailer()
{
    document
    .getElementById("trailerFrame")
    .src="";

    document
    .getElementById("trailerModal")
    .style.display="none";
}

function showLocationError(message)
{
    if(typeof showCinemaPopup==="function")
    {
        showCinemaPopup(
        message,
        "error"
        );
        return;
    }

    alert(message);
}

function setLocationStatus(message)
{
    const status=document.getElementById("locationStatus");
    if(status)
    {
        status.textContent=message || "";
    }
}

function clearCurrentLocationFilter()
{
    locationDisplayOverride="";
    currentLocationFilter=null;
}

function changeShowType(type)
{
    const selectedType=type || "All";
    const showTypeSelect=document.getElementById("showTypeFilter");
    if(showTypeSelect)
    {
        showTypeSelect.value=selectedType;
    }
    saveShowtimeFilters();
    if(selectedType.toLowerCase()==="news")
    {
        window.location.href="/Home/News";
        return;
    }
    window.location.href="/Home/ShowTime?type=" + encodeURIComponent(selectedType);
}

function toggleLocationChooser()
{
    const panel=document.getElementById("locationPanel");
    if(panel)
    {
        panel.hidden=!panel.hidden;
        const button=document.getElementById("locationSummaryButton");
        if(button)
        {
            button.setAttribute("aria-expanded",(!panel.hidden).toString());
            const symbol=button.querySelector(".location-toggle-symbol");
            if(symbol)
            {
                symbol.textContent=panel.hidden ? "⌄" : "⌃";
            }
        }
    }
}

function getSelectedLocationName()
{
    if(locationDisplayOverride)
    {
        return locationDisplayOverride;
    }

    const district=document.getElementById("district")?.value || "";
    const state=document.getElementById("state")?.value || "";
    const country=document.getElementById("country")?.value || "";
    return [district,state,country].filter(Boolean).join(", ") || "All locations";
}

function updateLocationSummary()
{
    const locationName=getSelectedLocationName();
    const button=document.getElementById("locationSummaryButton");
    if(button)
    {
        const text=button.querySelector(".location-choice-text");
        if(text)
        {
            text.textContent=locationName;
        }
        else
        {
            button.textContent=locationName;
        }
        button.title=locationName;
    }

    const prefix=locationDisplayOverride ? "Using current location" : "Using";
    setLocationStatus(locationName==="All locations" ? "Using all locations" : `${prefix} ${locationName}`);
    updateFilterFieldStyles();
}

function toggleFilterActive(controlId,isActive)
{
    const control=document.getElementById(controlId);
    const field=control?.closest(".location-field,.location-picker");
    if(field)
    {
        field.classList.toggle("is-filter-active",Boolean(isActive));
    }
}

function updateFilterFieldStyles()
{
    toggleFilterActive("showTypeFilter",(document.getElementById("showTypeFilter")?.value || "All") !== "All");
    toggleFilterActive("locationSummaryButton",getSelectedLocationName() !== "All locations");
    toggleFilterActive("country",Boolean(document.getElementById("country")?.value));
    toggleFilterActive("state",Boolean(document.getElementById("state")?.value));
    toggleFilterActive("district",Boolean(document.getElementById("district")?.value));
    toggleFilterActive("ratingFilter",Boolean(document.getElementById("ratingFilter")?.value));
    toggleFilterActive("dateFilter",Boolean(document.getElementById("dateFilter")?.value));
    toggleFilterActive("sortShows",(document.getElementById("sortShows")?.value || "upcoming") !== "upcoming");
}

function hasVisibleShows()
{
    return Array.from(document.querySelectorAll(".show-card")).some(card=>!card.hidden);
}

function getShowtimeFilterState()
{
    return {
        type:document.getElementById("showTypeFilter")?.value || "All",
        country:document.getElementById("country")?.value || "",
        state:document.getElementById("state")?.value || "",
        district:document.getElementById("district")?.value || "",
        rating:document.getElementById("ratingFilter")?.value || "",
        date:document.getElementById("dateFilter")?.value || "",
        sort:document.getElementById("sortShows")?.value || "upcoming",
        locationDisplayOverride,
        currentLocationFilter
    };
}

function saveShowtimeFilters()
{
    if(isRestoringShowtimeFilters)
    {
        return;
    }

    try
    {
        const state=getShowtimeFilterState();
        const hasMeaningfulFilter=Boolean(
            state.country ||
            (state.type && state.type!=="All") ||
            state.state ||
            state.district ||
            state.rating ||
            state.date ||
            (state.sort && state.sort!=="upcoming") ||
            state.locationDisplayOverride ||
            state.currentLocationFilter
        );

        if(hasMeaningfulFilter)
        {
            localStorage.setItem(showtimeFilterStorageKey,JSON.stringify(state));
        }
        else
        {
            localStorage.removeItem(showtimeFilterStorageKey);
        }
    }
    catch
    {
    }
}

function getSavedShowtimeFilters()
{
    try
    {
        const saved=JSON.parse(localStorage.getItem(showtimeFilterStorageKey) || "{}");
        return saved && typeof saved==="object" ? saved : {};
    }
    catch
    {
        return {};
    }
}

function clearSavedShowtimeFilters()
{
    try
    {
        localStorage.removeItem(showtimeFilterStorageKey);
    }
    catch
    {
    }
}

function showTrailerSoon()
{
    if(typeof showCinemaPopup==="function")
    {
        showCinemaPopup(
        "Trailer coming soon.",
        "info"
        );
        return;
    }

    alert("Trailer coming soon.");
}

function getYouTubeVideoId(url)
{
    if(!url || url==="#")
    {
        return "";
    }

    try
    {
        const parsedUrl = new URL(url);
        const host = parsedUrl.hostname.toLowerCase();

        if(host.includes("youtu.be"))
        {
            return parsedUrl.pathname.split("/").filter(Boolean)[0] || "";
        }

        if(parsedUrl.pathname.includes("/embed/"))
        {
            return parsedUrl.pathname.split("/embed/")[1]?.split("/")[0] || "";
        }

        if(parsedUrl.pathname.includes("/shorts/"))
        {
            return parsedUrl.pathname.split("/shorts/")[1]?.split("/")[0] || "";
        }

        return parsedUrl.searchParams.get("v") || "";
    }
    catch
    {
        return "";
    }
}

function setSelectOptions(
selectId,
options,
placeholder,
selectedName
)
{
    const select=
    document.getElementById(
    selectId
    );

    if(!select)
    {
        return;
    }

    select.innerHTML=
    `<option value="">
    ${placeholder}
    </option>`;

    options.forEach(item=>{

        const option=
        document.createElement(
        "option"
        );

        const optionName=
        item.name || item;

        option.value=optionName;

        option.dataset.id=
        item.id || "";

        option.dataset.hasData=
        item.id
        ?
        "true"
        :
        "false";

        option.dataset.name=
        optionName;

        option.textContent=
        optionName;

        if(
        selectedName &&
        optionName
        .toLowerCase()
        ===
        selectedName
        .toLowerCase()
        )
        {
            option.selected=true;
        }

        select.appendChild(
        option
        );

    });
}

function setSimpleOptions(selectId,items,placeholder)
{
    const select=document.getElementById(selectId);
    if(!select)
    {
        return;
    }

    const currentValue=select.value;
    select.innerHTML=`<option value="">${placeholder}</option>`;

    items.forEach(item=>{
        const option=document.createElement("option");
        option.value=item.value;
        option.textContent=item.label;
        select.appendChild(option);
    });

    if(Array.from(select.options).some(option=>option.value===currentValue))
    {
        select.value=currentValue;
    }
}

function populateDynamicFilters()
{
    const cards=Array.from(document.querySelectorAll(".show-card"));

    const ratings=[...new Set(cards
    .map(card=>card.dataset.rating)
    .filter(Boolean))]
    .sort((a,b)=>Number(b)-Number(a))
    .map(value=>({value,label:value}));

    setSimpleOptions("ratingFilter",ratings,"Any");

    const dateInput=document.getElementById("dateFilter");
    const dates=cards
    .map(card=>card.dataset.date)
    .filter(Boolean)
    .sort();

    if(dateInput && dates.length)
    {
        dateInput.min=dates[0];
        dateInput.max=dates[dates.length-1];
    }
}

function setControlValue(controlId,value)
{
    const control=document.getElementById(controlId);
    if(control && value !== undefined && value !== null)
    {
        control.value=value;
    }
}

async function restoreSavedShowtimeFilters()
{
    const saved=getSavedShowtimeFilters();
    const hasSavedFilter=Boolean(
        saved.country ||
        (saved.type && saved.type!=="All") ||
        saved.state ||
        saved.district ||
        saved.rating ||
        saved.date ||
        (saved.sort && saved.sort!=="upcoming") ||
        saved.locationDisplayOverride ||
        saved.currentLocationFilter
    );

    if(!hasSavedFilter)
    {
        return false;
    }

    isRestoringShowtimeFilters=true;
    try
    {
        await loadCountries(saved.country || "");
        if(saved.country)
        {
            selectBestLocationOption("country",[saved.country]);
            await loadStates(saved.state || "");
        }

        if(saved.state)
        {
            selectBestLocationOption("state",[saved.state]);
            await loadDistricts(saved.district || "");
        }

        if(saved.district)
        {
            selectBestLocationOption("district",[saved.district]);
        }

        setControlValue("ratingFilter",saved.rating || "");
        setControlValue("dateFilter",saved.date || "");
        setControlValue("sortShows",saved.sort || "upcoming");
        setControlValue("showTypeFilter",saved.type || "All");
        locationDisplayOverride=saved.locationDisplayOverride || "";
        currentLocationFilter=saved.currentLocationFilter || null;
    }
    finally
    {
        isRestoringShowtimeFilters=false;
    }

    applyLocationFilter();
    return true;
}


function normalizeLocationText(value)
{
    return (value || "")
    .toString()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();
}

function selectBestLocationOption(selectId,candidates)
{
    const select=document.getElementById(selectId);
    if(!select)
    {
        return "";
    }

    const normalizedCandidates=(Array.isArray(candidates) ? candidates : [candidates])
    .map(normalizeLocationText)
    .filter(Boolean);

    if(!normalizedCandidates.length)
    {
        return "";
    }

    const options=Array.from(select.options);
    const match=options.find(option=>{
        const optionText=normalizeLocationText(option.dataset.name || option.value || option.textContent);
        return optionText && normalizedCandidates.some(candidate=>
            optionText===candidate ||
            optionText.includes(candidate) ||
            candidate.includes(optionText)
        );
    });

    if(match)
    {
        select.value=match.value;
        return match.value;
    }

    return "";
}

function setCurrentRegionOption(region)
{
    const select=document.getElementById("district");
    const regionName=(region || "").trim();
    if(!select || !regionName)
    {
        return "";
    }

    const normalizedRegion=normalizeLocationText(regionName);
    Array.from(select.options).forEach(option=>{
        const optionName=normalizeLocationText(option.dataset.name || option.value || option.textContent);
        if(optionName===normalizedRegion)
        {
            option.remove();
        }
    });

    const option=document.createElement("option");
    option.value=regionName;
    option.dataset.id="";
    option.dataset.hasData="false";
    option.dataset.name=regionName;
    option.dataset.currentLocation="true";
    option.textContent=regionName;
    option.selected=true;

    select.insertBefore(option,select.firstChild);
    return regionName;
}

function selectAllOption(select)
{
    if(!select)
    {
        return;
    }

    if(Array.from(select.options).some(option=>option.value===""))
    {
        select.value="";
        return;
    }

    select.selectedIndex=0;
}

async function loadCountries(selectedName)
{
    try
    {
        const response=
        await fetch(
        "/Home/GetCountries"
        );

        if(!response.ok)
        {
            throw new Error(
            "Country request failed"
            );
        }

        const countries=
        await response.json();

        const currentCountry=document.getElementById("country")?.value || "";
        const selectedCountryName=selectedName || currentCountry || "";

        setSelectOptions(
        "country",
        countries,
        "All Countries",
        selectedCountryName
        );

        if(selectedCountryName)
        {
            await loadStates();
        }
        else
        {
            setSelectOptions(
            "state",
            [],
            "All States"
            );

