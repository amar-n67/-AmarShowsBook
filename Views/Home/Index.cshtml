        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        min-width: 16px;
        height: 16px;
        margin: 0;
        font-size: 0.84rem;
        line-height: 1;
    }

.location-current-btn {
    background: #fff;
    color: var(--app-primary);
    border-color: color-mix(in srgb, var(--app-primary) 32%, var(--app-input-border));
}

.location-reset-btn {
    background: color-mix(in srgb, var(--app-input) 78%, transparent);
    color: var(--app-input-text);
}

.filter-clear-field {
    flex: 0 0 auto;
    min-width: 64px;
}

.filter-clear-field::after {
    content: none !important;
    display: none !important;
}

    .showtime-clear-btn {
        width: 100%;
        background: #fff;
        color: var(--app-primary);
        border-color: color-mix(in srgb, var(--app-primary) 30%, var(--app-input-border));
        gap: 5px;
    }

    .showtime-clear-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--app-primary) 12%, transparent);
        font-size: 0.86rem;
        font-weight: 900;
        line-height: 1;
    }

    .showtime-controls button.action-iconified,
    .empty-state-link.action-iconified {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

.location-current-btn:hover,
.location-current-btn:focus-visible,
.location-reset-btn:hover,
.showtime-clear-btn:hover,
.showtime-clear-btn:focus-visible {
    transform: translateY(-1px);
    border-color: var(--app-primary);
}

.location-current-btn:hover,
.location-current-btn:focus-visible {
    background: var(--app-primary);
    color: #fff;
    outline: none;
}

.showtime-clear-btn:hover,
.showtime-clear-btn:focus-visible {
    background: var(--app-primary);
    color: #fff;
    outline: none;
}

.location-status {
    grid-column: 1 / -1;
    min-height: 0;
    margin: -2px 0 0;
    color: var(--app-muted);
    font-size: 0.72rem;
    font-weight: 700;
}

.empty-state-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    margin-top: 6px;
    padding: 0 14px;
    border: 1px solid var(--app-primary);
    border-radius: 8px;
    background: #fff;
    color: var(--app-primary);
    font-size: 0.82rem;
    font-weight: 900;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
}

.empty-state-link:hover,
.empty-state-link:focus-visible {
    background: var(--app-primary);
    color: #fff;
    outline: none;
    transform: translateY(-1px);
}

.showtime-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    padding: 0;
    align-self: stretch;
    align-items: stretch;
    width: 100%;
    border: 0;
    background: transparent;
