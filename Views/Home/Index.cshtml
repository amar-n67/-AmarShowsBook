        color: rgba(255,255,255,.82);
        font-size: 0.88rem;
        line-height: 1.45;
    }

    .ott-controls {
        position: absolute;
        left: 14px;
        right: 14px;
        bottom: 12px;
        display: grid;
        gap: 8px;
        padding: 10px;
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 8px;
        background: rgba(0,0,0,.46);
