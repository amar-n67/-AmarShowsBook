    }
    
    .schedule-board {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        align-items: stretch;
    }
    
    .show-card,
    .empty-slate {
        border: 1px solid var(--app-input-border);
        border-radius: 8px;
        background: var(--app-card);
        color: var(--app-card-text);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.13);
    }
    
    .show-card {
        display: flex;
        flex-direction: column;
        padding: 20px;
        min-height: 100%;
