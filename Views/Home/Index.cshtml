.showtime-tabs a:hover {
    transform: translateY(-1px);
    border-color: var(--app-primary);
}

.show-card {
    cursor: default;
}

.show-card:hover {
    transform: translateY(-4px);
}

    .card-actions .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        min-width: 0;
        min-height: 46px;
        border-radius: 8px;
