@model AmarShowsBook.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "showTime";
    var selectedType = Context.Request.Query["type"].ToString();
    if (string.IsNullOrWhiteSpace(selectedType))
    {
        selectedType = "Movie";
    }
    var userName = Context.Session.GetString("UserName") ?? "Artist";
    var userLanguage = Context.Session.GetString("UserLanguage") ?? "English";
    var userGenre = Context.Session.GetString("UserGenre") ?? "Dramatic";
}

<section class="showtime-page">
    <div class="showtime-hero">
        <div>
            <span class="showtime-kicker">Now Rolling</span>
            <h1>showTime</h1>
            <p>@userName, your @userLanguage track and @userGenre mood are on the board.</p>
        </div>
        <div class="showtime-ticket">
            <span>@userLanguage</span>
            <strong>@userGenre</strong>
        </div>
    </div>

    <div class="showtime-controls">
        <div class="location-strip">
            <div>
                <label>Country</label>
                <select id="country" class="form-control" onchange="loadStates()">
                    <option value="">Loading countries...</option>
                </select>
            </div>

            <div>
                <label>State</label>
                <select id="state" class="form-control" onchange="loadDistricts()">
                    <option value="">Select State</option>
                </select>
            </div>

            <div>
                <label>Region</label>
                <select id="district" class="form-control">
                    <option value="">Select Region</option>
                </select>
            </div>
        </div>

        <nav class="showtime-tabs" aria-label="Show category">
            <a href="/Home/Index?type=Movie" class="@(selectedType == "Movie" ? "active" : "")">Movies</a>
            <a href="/Home/Index?type=Standup" class="@(selectedType == "Standup" ? "active" : "")">Standup</a>
            <a href="/Home/Index?type=Live" class="@(selectedType == "Live" ? "active" : "")">Live</a>
        </nav>
    </div>

    <div class="schedule-board">
        @if (!Model.HomeShows.Any())
        {
            <div class="empty-slate">
                <span>No Shot Scheduled</span>
                <h2>The reel is quiet for this category.</h2>
                <p>Try another tab or schedule a new show when the next scene is ready.</p>
            </div>
        }
        else
        {
            @* @foreach (var item in Model.HomeShows) *@
            @* @foreach (var item in Model.HomeShows
.GroupBy(x => x.ShowId)
.Select(x => x.First())) *@
@foreach (var item in Model.HomeShows
.Where(x => x.ScheduleId > 0)
.GroupBy(x => x.ShowId)
.Select(x => x.First()))
{
    var showRegion =
    $"{item.Location}, {item.State}, {item.Country}";

<article class="show-card"
onclick="location.href='/Booking/Seats/@item.ScheduleId'">
  <div class="card-body">

        <h2 class="movie-title">

            @(item.Title ?? "Untitled Show")

        </h2>


        <div class="image-strip">

            <img class="swap-image active"
                 src="@(string.IsNullOrEmpty(item.PosterUrl)
                 ? "/images/default1.jpg"
                 : item.PosterUrl)" />

            @if(!string.IsNullOrEmpty(item.Images))
            {
                @foreach(var img in item.Images.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries))
                {
                    <img class="swap-image"
                         src="@img.Trim()" />
                }
            }

        </div>

<div class="movie-details">

    <div class="detail-row">

        <span>Date:
            @item.StartTime.ToString("dd MMM yyyy")
        </span>

        <span>Time:
            @item.StartTime.ToString("hh:mm tt")
        </span>

    </div>

    <div class="venue-row">

        Venue: @showRegion

    </div>

</div>


<div class="card-actions">
    @* <a
class="btn trailer-btn"
data-url="@item.TrailerUrl"
href="javascript:void(0)">

▶ Trailer

</a> *@
<a
class="btn trailer-btn"
data-url="@item.TrailerUrl"
href="#"
onclick="event.preventDefault();event.stopPropagation();">

▶ Trailer
</a>

     @* <a
    class="btn btn-primary"
    href="/Booking/Seats/@item.ScheduleId">
    
    Book Ticket

    </a>  *@
<a
class="btn btn-primary"
href="/Booking/Seats/@item.ScheduleId"
onclick="event.stopPropagation();">

Book Ticket
</a>

</div>

    </div>

</article>

}
        }
    </div>
    <div id="trailerModal" class="trailer-modal">

    <div class="trailer-container">

        <button
        class="close-trailer"
        onclick="closeTrailer()">

        ✕

        </button>

        <iframe
        id="trailerFrame"
        allowfullscreen
        allow="autoplay">
        </iframe>

    </div>

</div>
</section>

<style>
    .show-card{
cursor:pointer;
}
    .trailer-modal{

display:none;
position:fixed;

top:0;
left:0;

width:100%;
height:100%;

background:rgba(0,0,0,.85);

z-index:9999;

justify-content:center;
align-items:center;

}

.trailer-container{

width:90%;
max-width:1000px;

height:80vh;

position:relative;

z-index:9999;

}

.trailer-container iframe{

width:100%;
height:100%;

border:none;
border-radius:15px;

}

.close-trailer{

position:absolute;

top:-50px;
right:0;

width:42px;
height:42px;

border:none;

border-radius:50%;

background:#ff4757;
color:white;

cursor:pointer;

font-size:18px;
font-weight:bold;

z-index:10000;

display:flex;
justify-content:center;
align-items:center;

}
.showtime-page {
    padding-bottom: 44px;
}
.showtime-hero {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: flex-end;
    min-height: 260px;
    padding: 34px;
    border-radius: 8px;
    background:
        linear-gradient(135deg, rgba(255, 242, 199, 0.94), rgba(245, 178, 196, 0.86), rgba(146, 229, 221, 0.86)),
        repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px);
    color: #231f20;
    box-shadow: 0 22px 64px rgba(35,31,32,0.22);
}
.showtime-kicker,
.showtime-ticket span,
.show-card-top span,
.empty-slate span {
    text-transform: uppercase;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.08em;
}
.showtime-hero h1 {
    margin: 8px 0;
    color: #231f20;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 900;
}
.showtime-hero p {
    margin: 0;
    max-width: 620px;
    color: #34303a;
    font-size: 1.08rem;
}
.showtime-ticket {
    min-width: 180px;
    padding: 14px;
    border: 1px dashed rgba(35,31,32,0.44);
    border-radius: 8px;
    text-align: right;
    background: rgba(255,255,255,0.38);
}
.showtime-ticket strong {
    display: block;
    color: #231f20;
    font-size: 1.2rem;
}
.showtime-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: end;
    margin: 24px 0;
}
.location-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
}
.location-strip label {
    margin-bottom: 6px;
    font-weight: 800;
}
.showtime-tabs {
    display: inline-flex;
    gap: 6px;
    padding: 6px;
    border: 1px solid var(--app-input-border);
    border-radius: 999px;
    background: var(--app-card);
}
.showtime-tabs a {
    min-width: 90px;
    padding: 9px 14px;
    border-radius: 999px;
    color: var(--app-text);
    text-align: center;
    text-decoration: none;
    font-weight: 850;
}
.showtime-tabs a.active {
    background: var(--app-primary);
    color: #fff;
}
.schedule-board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
}
.show-card,
.empty-slate {
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    color: var(--app-card-text);
    box-shadow: 0 14px 34px rgba(0,0,0,0.13);
}
.show-card {
    display: grid;
    gap: 12px;
    padding: 18px;
}
.show-card-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--app-muted);
}
.show-card h2 {
    min-height: 58px;
    margin: 0;
    color: inherit;
    font-size: 1.22rem;
    font-weight: 900;
}
.show-card p {
    margin: 0;
    color: var(--app-muted);
}
.show-region {
    min-height: 42px;
    font-weight: 750;
}
.show-card .btn {
    align-self: end;
    font-weight: 850;
}
.empty-slate {
    grid-column: 1 / -1;
    padding: 34px;
    text-align: center;
}
.empty-slate h2 {
    margin: 8px 0;
    color: inherit;
}
.empty-slate p {
    margin: 0;
    color: var(--app-muted);
}
@@media (max-width: 980px) {
    .showtime-controls,
    .schedule-board {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .showtime-tabs {
        grid-column: 1 / -1;
        justify-content: center;
    }
}
@@media (max-width: 760px) {
    .showtime-hero,
    .showtime-controls,
    .location-strip,
    .schedule-board {
        grid-template-columns: 1fr;
    }
    .showtime-hero {
        padding: 24px;
    }
    .showtime-ticket {
        width: 100%;
        text-align: left;
    }
    .showtime-tabs {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        width: 100%;
    }
    .showtime-tabs a {
        min-width: 0;
    }
}
.movie-title{
font-size:1.6rem;
font-weight:800;
margin-bottom:18px;
}

.image-strip{
height:260px;
width:100%;
position:relative;
overflow:hidden;
border-radius:20px;
margin-bottom:18px;
box-shadow:0 12px 30px rgba(0,0,0,.25);
}

.swap-image{
position:absolute;
top:0;
left:0;
width:100%;
height:100%;
object-fit:cover;
opacity:0;
transform:scale(1.1);
transition:opacity 1s ease,transform 6s ease;
}

.swap-image.active{
opacity:1;
transform:scale(1);
}

.movie-details{
margin:15px 0;
font-size:.92rem;
}

.detail-row{
display:flex;
justify-content:space-between;
padding-bottom:8px;
margin-bottom:8px;
border-bottom:1px solid rgba(255,255,255,.08);
}

.detail-row span{
font-weight:500;
color:#d1d5db;
}

.venue-row{
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
color:#bdbdbd;
}

.card-actions{
display:flex;
gap:10px;
width:100%;
margin-top:15px;
}

.card-actions .btn{
flex:1;
padding:12px;
text-align:center;
border-radius:10px;
font-size:.9rem;
font-weight:600;
text-decoration:none;
transition:.3s;
}

.trailer-btn{
background:#353b48;
color:white;
}

.btn-primary{
background:#ff4757;
color:white;
}

.card-actions .btn:hover{
transform:translateY(-3px);
}

.show-card{
padding:20px;
overflow:hidden;
border-radius:25px;
backdrop-filter:blur(20px);
transition:.4s;
}

.show-card:hover{
transform:translateY(-10px) scale(1.02);
}
</style> 

<script>

function closeTrailer()
{
    document
    .getElementById("trailerFrame")
    .src="";

    document
    .getElementById("trailerModal")
    .style.display="none";
}

function showLocationError(message)
{
    if(typeof showCinemaPopup==="function")
    {
        showCinemaPopup(
        message,
        "error"
        );
        return;
    }

    alert(message);
}

function setSelectOptions(
selectId,
options,
placeholder,
selectedName
)
{
    const select=
    document.getElementById(
    selectId
    );

    select.innerHTML=
    `<option value="">
    ${placeholder}
    </option>`;

    options.forEach(item=>{

        const option=
        document.createElement(
        "option"
        );

        const optionName=
        item.name || item;

        option.value=
        optionName;

        option.dataset.id=
        item.id || "";

        option.dataset.hasData=
        item.id
        ?
        "true"
        :
        "false";

        option.dataset.name=
        optionName;

        option.textContent=
        optionName;

        if(
        selectedName &&
        optionName
        .toLowerCase()
        ===
        selectedName
        .toLowerCase()
        )
        {
            option.selected=true;
        }

        select.appendChild(
        option
        );

    });
}


async function loadCountries()
{
    try
    {
        const response=
        await fetch(
        "/Home/GetCountries"
        );

        if(!response.ok)
        {
            throw new Error(
            "Country request failed"
            );
        }

        const countries=
        await response.json();

        const india=
        countries.find(
        x=>
        x.name &&
        x.name
        .toLowerCase()
        ===
        "india"
        );

        const selectedCountryName=
        india
        ?
        india.name
        :
        "";

        setSelectOptions(
        "country",
        countries,
        "Select Country",
        selectedCountryName
        );

        if(
        india &&
        india.id
        )
        {
            await loadStates();
        }

    }
    catch
    {
        setSelectOptions(
        "country",
        [],
        "Select Country"
        );

        setSelectOptions(
        "state",
        [],
        "Select State"
        );

        setSelectOptions(
        "district",
        [],
        "Select Region"
        );

        showLocationError(
        "Could not load countries."
        );
    }
}



async function loadStates()
{
    const countrySelect=
    document.getElementById(
    "country"
    );

    const selectedCountry=
    countrySelect.options[
    countrySelect.selectedIndex
    ];

    const countryId=
    selectedCountry
    ?
    selectedCountry.dataset.id
    :
    "";

    setSelectOptions(
    "district",
    [],
    "Select Region"
    );

    if(!countryId)
    {
        setSelectOptions(
        "state",
        [],
        "Select State"
        );

        return;
    }

    try
    {
        const response=
        await fetch(
        `/Home/GetStates?countryId=${countryId}`
        );

        const states=
        await response.json();

        setSelectOptions(
        "state",
        states,
        "Select State"
        );
    }
    catch
    {
        showLocationError(
        "Could not load states."
        );
    }
}



async function loadDistricts()
{
    const stateSelect=
    document.getElementById(
    "state"
    );

    const selectedState=
    stateSelect.options[
    stateSelect.selectedIndex
    ];

    const stateId=
    selectedState
    ?
    selectedState.dataset.id
    :
    "";

    if(!stateId)
    {
        setSelectOptions(
        "district",
        [],
        "Select Region"
        );

        return;
    }

    try
    {
        const response=
        await fetch(
        `/Home/GetDistricts?stateId=${stateId}`
        );

        const districts=
        await response.json();

        setSelectOptions(
        "district",
        districts,
        "Select Region"
        );
    }
    catch
    {
        showLocationError(
        "Could not load regions."
        );
    }
}



document.addEventListener(
"DOMContentLoaded",
()=>{

loadCountries();



document
.querySelectorAll(
".image-strip"
)
.forEach(slider=>{

const images=
slider.querySelectorAll(
".swap-image"
);

if(
images.length<=1
)
return;

let current=0;

setInterval(()=>{

images[current]
.classList.remove(
"active"
);

current=
(
current+1
)
%
images.length;

images[current]
.classList.add(
"active"
);

},3000);

});



document
.querySelectorAll(
".trailer-btn"
)
.forEach(button=>{

button.addEventListener(
"click",
(event)=>{

event.preventDefault();

event.stopPropagation();

let url=
button.dataset.url;

if(
!url ||
url=="#"
)
{
alert(
"Trailer coming soon"
);

return;
}

let videoId="";

try
{
    let parsedUrl=
    new URL(url);

    if(parsedUrl.hostname.includes("youtu.be"))
    {
        videoId=
        parsedUrl.pathname.substring(1);
    }
    else
    {
        videoId=
        parsedUrl.searchParams.get("v");
    }
}
catch
{
    console.log("Invalid trailer url");
}

if(videoId)
{
document
.getElementById(
"trailerFrame"
)
.src=
`https://www.youtube.com/embed/${videoId}?autoplay=1`;

document
.getElementById(
"trailerModal"
)
.style.display=
"flex";
}

});

});



document
.getElementById(
"trailerModal"
)
.addEventListener(
"click",
function(e){

if(
e.target.id===
"trailerModal"
)
{
closeTrailer();
}

});

});

</script>