@model AmarShowsBook.Models.ViewModels.HomeViewModel


@{
    ViewData["Title"] = "showTime";
    var selectedType = Context.Request.Query["type"].ToString();
    if (string.IsNullOrWhiteSpace(selectedType))
    {
        selectedType = "Movie";
    }
    var userName = Context.Session.GetString("UserName") ?? "Artist";
    var userLanguage = Context.Session.GetString("UserLanguage") ?? "English";
    var userGenre = Context.Session.GetString("UserGenre") ?? "Dramatic";
}

<section class="showtime-page">
    <div class="showtime-hero">
        <div>
            <span class="showtime-kicker">Now Rolling</span>
            <h1>showTime</h1>
            <p>@userName, your @userLanguage track and @userGenre mood are on the board.</p>
        </div>
        <div class="showtime-ticket">
            <span>@userLanguage</span>
            <strong>@userGenre</strong>
        </div>
    </div>

<div class="showtime-controls">
    <div class="location-panel">
        <div class="location-strip">
            <div class="location-field">
                <label>Country</label>
                <select id="country" class="form-control" onchange="loadStates()">
                    <option value="">Loading countries...</option>
                </select>
            </div>
            <div class="location-field">
                <label>State</label>
                <select id="state" class="form-control" onchange="loadDistricts()">
                    <option value="">Select State</option>
                </select>
            </div>
            <div class="location-field">
                <label>Region</label>
                <select id="district" class="form-control">
                    <option value="">Select Region</option>
                </select>
            </div>
            <div class="location-field location-actions">
                <button type="button" class="location-search-btn" onclick="applyLocationFilter()">Search</button>
                <button type="button" class="location-reset-btn" onclick="resetLocationFilter()">Reset</button>
            </div>
        </div>
    </div>
    <nav class="showtime-tabs" aria-label="Show category">
        <a href="/Home/Index?type=Movie" class="@(selectedType == "Movie" ? "active" : "")">Movies</a>
        <a href="/Home/Index?type=Standup" class="@(selectedType == "Standup" ? "active" : "")">Standup</a>
        <a href="/Home/Index?type=Live" class="@(selectedType == "Live" ? "active" : "")">Live</a>
    </nav>
</div>

    <div class="schedule-board">
        @if (!Model.HomeShows.Any())
        {
            <div class="empty-slate">
                <span>No Shot Scheduled</span>
                <h2>The reel is quiet for this category.</h2>
                <p>Try another tab or schedule a new show when the next scene is ready.</p>
            </div>
        }
        else
        {
            @* @foreach (var item in Model.HomeShows) *@
            @* @foreach (var item in Model.HomeShows
.GroupBy(x => x.ShowId)
.Select(x => x.First())) *@
@foreach (var item in Model.HomeShows
.Where(x => x.ScheduleId > 0)
.GroupBy(x => x.ShowId)
.Select(x => x.First()))
{
    var showRegion =
    string.IsNullOrWhiteSpace(item.TheaterDetails)
    ? $"{item.Location}, {item.State}, {item.Country}"
    : item.TheaterDetails;
    var showLocation = string.Join(", ", new[] { item.Location, item.State, item.Country }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
    var hasTrailer = !string.IsNullOrWhiteSpace(item.TrailerUrl);

<article class="show-card"
data-location="@showLocation"
onclick="location.href='/Booking/Seats/@item.ScheduleId'">
  <div class="card-body">

        <h2 class="movie-title">

            @(item.Title ?? "Untitled Show")

        </h2>


        <div class="image-strip">

            <img class="swap-image active"
                 src="@(string.IsNullOrEmpty(item.PosterUrl)
                 ? "/images/default1.jpg"
                 : item.PosterUrl)" />

            @if(!string.IsNullOrEmpty(item.Images))
            {
                @foreach(var img in item.Images.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries))
                {
                    <img class="swap-image"
                         src="@img.Trim()" />
                }
            }

        </div>

<div class="movie-details">

    <div class="detail-row">

        <span>Date:
            @item.StartTime.ToString("dd MMM yyyy")
        </span>

        <span>Time:
            @item.StartTime.ToString("hh:mm tt")
        </span>

    </div>

    <div class="detail-row">
        <span>Director/Host: @(string.IsNullOrWhiteSpace(item.Director) ? "NA" : item.Director)</span>
        <span class="imdb-rating" title="IMDB rating">@(item.ImdbRating?.ToString("0.0") ?? "NA")</span>
    </div>

    <div class="venue-row">
        Cast: @(string.IsNullOrWhiteSpace(item.Cast) ? "NA" : item.Cast)
    </div>

    <div class="venue-row">

        Venue: @showRegion

    </div>

    <div class="venue-row">

        Location: @(string.IsNullOrWhiteSpace(showLocation) ? "Location TBA" : showLocation)

    </div>

</div>


<div class="card-actions">
    @* <a
class="btn trailer-btn"
data-url="@item.TrailerUrl"
href="javascript:void(0)">

▶ Trailer

</a> *@
<a
class="btn trailer-btn @(hasTrailer ? "" : "trailer-unavailable")"
data-url="@item.TrailerUrl"
href="#"
onclick="event.preventDefault();event.stopPropagation();">

▶ Trailer
</a>

     @* <a
    class="btn btn-primary"
    href="/Booking/Seats/@item.ScheduleId">
    
    Book Ticket

    </a>  *@
<a
class="btn btn-primary"
href="/Booking/Seats/@item.ScheduleId"
onclick="event.stopPropagation();">

Book Ticket
</a>

</div>

    </div>

</article>

}
        }
    </div>
    <div id="trailerModal" class="trailer-modal">

    <div class="trailer-container">

        <button
        class="close-trailer"
        onclick="closeTrailer()">

        ✕

        </button>

        <iframe
        id="trailerFrame"
        allowfullscreen
        allow="autoplay">
        </iframe>

    </div>

</div>
</section>

