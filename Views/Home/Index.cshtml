        font-size: 0.92rem;
        font-weight: 950;
        letter-spacing: 0;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.32), 0 8px 18px color-mix(in srgb, var(--platform-accent) 28%, transparent);
    }

    .platform-copy {
        min-width: 0;
        display: grid;
        gap: 4px;
    }

    .platform-copy strong {
        color: inherit;
        font-size: 1rem;
        font-weight: 950;
        line-height: 1.15;
        overflow-wrap: anywhere;
    }

    .platform-copy small {
        color: var(--app-muted);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.35;
    }

    .platform-open {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: color-mix(in srgb, var(--platform-accent) 12%, #fff);
        color: var(--platform-accent);
        font-weight: 950;
        line-height: 1;
    }
    
    .movie-title {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: 18px;
    }
    
    .image-strip {
        height: 0;
        padding-bottom: 100%;
        width: 100%;
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        margin-bottom: 18px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
        background: var(--app-input-border);
    }
    
    .swap-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.1);
        transition: opacity 1s ease, transform 6s ease;
        border-radius: 8px;
    }
    
    .swap-image.active {
        opacity: 1;
        transform: scale(1);
    }
    
    .movie-details {
        margin: 15px 0;
        font-size: 0.92rem;
        flex: 1;
        position: relative;
    }
    
    .imdb-rating {
        position: absolute;
        top: -60px;
        right: 0;
        background: linear-gradient(135deg, #f5c518, #ddb700);
        color: #000;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.85rem;
        box-shadow: 0 4px 12px rgba(245, 197, 24, 0.4);
        z-index: 10;
    }
    
    .imdb-rating::before {
        content: "⭐ ";
    }
    
    .detail-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
        padding-bottom: 8px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--app-input-border);
    }
    
    .detail-row span {
        font-weight: 500;
        color: var(--app-muted);
        word-break: break-word;
        white-space: normal;
        overflow-wrap: break-word;
    }
    
    .detail-row span:first-child {
        flex: 1 1 auto;
        min-width: 50%;
    }
    
    .detail-row span:last-child {
        flex: 0 0 auto;
        text-align: right;
    }
    
    .venue-row {
        display: block;
        width: 100%;
        padding: 4px 0;
        word-break: break-word;
        white-space: normal;
        overflow-wrap: break-word;
        line-height: 1.4;
        color: var(--app-muted);
    }
    
    .venue-row:first-letter {
        text-transform: uppercase;
    }
    
    .card-actions {
        display: flex;
        gap: 10px;
        width: 100%;
        margin-top: 15px;
        margin-top: auto;
    }
    
    .card-actions .btn {
        flex: 1;
        padding: 12px;
        text-align: center;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }
    
    .trailer-btn {
        background: var(--app-input-disabled);
        border: 1px solid var(--app-input-border);
        color: var(--app-input-text);
    }

    .trailer-unavailable {
        opacity: 0.82;
    }
    
    .btn-primary {
        background: var(--app-primary);
        border-color: var(--app-primary);
        color: white;
    }
    
    .card-actions .btn:hover {
        transform: translateY(-3px);
    }
    
    .show-card {
        padding: 20px;
        overflow: hidden;
        border-radius: 8px;
        backdrop-filter: blur(20px);
        transition: 0.4s;
    }
    
    .show-card:hover {
        transform: translateY(-10px) scale(1.02);
    }
    
    .top-profile-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: flex-end;
    }
    
    .profile-btn,
    .exit-btn {
        padding: 12px 22px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
        width: 150px;
        text-align: center;
    }
    
    .profile-btn {
        background: #2f80ed;
        color: white;
    }
    
    .exit-btn {
        background: #ff4757;
        color: white;
    }
    
    .profile-btn:hover,
    .exit-btn:hover {
        transform: translateY(-3px);
    }
    
.location-panel-heading,
.show-type-heading {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    margin: 0;
    white-space: nowrap;
}

.location-panel-heading span,
.show-type-heading span {
    color: var(--app-muted);
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
}

.location-panel-heading strong {
    color: var(--app-card-text);
    font-size: 0.72rem;
    font-weight: 900;
}

.showtime-controls {
    display: grid;
    grid-template-columns: minmax(90px, .78fr) minmax(150px, 1.3fr) minmax(82px, .62fr) minmax(116px, .8fr) minmax(116px, .86fr) minmax(64px, auto);
    gap: 8px;
    align-items: end;
    margin: 10px 0 16px;
    padding: 8px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    box-shadow: 0 10px 24px rgba(15,23,42,.08);
}

.showtime-controls.platform-mode {
    grid-template-columns: minmax(220px, 360px);
    max-width: 380px;
}

.showtime-controls.platform-mode .location-picker,
.showtime-controls.platform-mode .compact-filter-field,
.showtime-controls.platform-mode .location-panel,
.showtime-controls.platform-mode .location-status {
    display: none;
}

.location-panel,
.show-type-panel,
.location-picker {
    min-width: 0;
    display: grid;
    align-items: stretch;
    border: 0;
    background: transparent;
}

.location-panel[hidden] {
    display: none;
}

.location-panel {
    grid-column: 1 / -1;
    padding-top: 4px;
}

.location-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(104px, 1fr)) minmax(140px, auto);
    gap: 6px;
    align-items: center;
}

.location-field {
    min-width: 0;
    max-width: none;
    position: relative;
    display: grid;
    gap: 3px;
    padding: 0;
    border: 0;
    background: transparent;
}

.location-field label,
.location-picker label {
    margin: 0;
    color: var(--app-muted);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

    .location-field select,
    .location-field input,
    .location-choice-btn,
    .location-current-btn,
    .location-reset-btn,
    .showtime-clear-btn {
        min-height: 34px;
        height: 34px;
        border-radius: 8px;
        box-sizing: border-box;
    }

.location-field select,
.location-field input,
.location-choice-btn {
    width: 100%;
    appearance: none;
    padding: 0 26px 0 9px;
    font-size: 0.78rem;
    background: #fff;
    color: var(--app-input-text);
    font-weight: 700;
    border: 1px solid var(--app-input-border);
    box-shadow: none;
}

.location-choice-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    padding-right: 9px;
    text-align: left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.location-choice-symbol,
.location-toggle-symbol {
    flex: 0 0 auto;
    color: var(--app-primary);
    font-size: 0.9rem;
    font-weight: 950;
    line-height: 1;
}

.location-choice-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.location-toggle-symbol {
    margin-left: auto;
}

.location-field:not(.location-actions):not(.filter-clear-field)::after {
    content: "⌄";
    position: absolute;
    right: 15px;
    bottom: 13px;
    color: var(--app-primary);
    font-size: 1rem;
    font-weight: 950;
    pointer-events: none;
}

.location-field select:focus {
    border-color: var(--app-primary);
    outline: 0;
    box-shadow: 0 0 0 0.16rem color-mix(in srgb, var(--app-primary) 18%, transparent);
}

.location-field.is-filter-active label,
.location-picker.is-filter-active label {
    color: var(--app-primary);
}

.location-field.is-filter-active select,
.location-field.is-filter-active input,
.location-picker.is-filter-active .location-choice-btn {
    background: #fff6d8 !important;
    background-color: #fff6d8 !important;
    border-color: #d99a00 !important;
    color: var(--app-input-text);
    box-shadow: 0 0 0 2px rgba(217, 154, 0, 0.16), inset 0 0 0 1px rgba(217, 154, 0, 0.12) !important;
}

.location-actions {
    align-self: end;
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-content: start;
    gap: 8px;
    padding: 0;
    border: 0;
    background: transparent;
}

    .location-current-btn,
    .location-reset-btn,
    .showtime-clear-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--app-input-border);
        min-width: 0;
        padding: 0 10px;
        font-size: 0.76rem;
        font-weight: 800;
        white-space: nowrap;
        line-height: 1;
        overflow: hidden;
        transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
    }

    .location-current-btn .action-icon-inline,
    .location-reset-btn .action-icon-inline,
