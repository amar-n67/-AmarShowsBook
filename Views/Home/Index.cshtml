        background:
            linear-gradient(180deg, rgba(255,255,255,0.88), rgba(255,255,255,0.72)),
            linear-gradient(135deg, color-mix(in srgb, var(--platform-accent) 18%, transparent), transparent 46%);
        color: var(--app-card-text);
