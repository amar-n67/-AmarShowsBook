    color: var(--app-muted);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

    .location-field select,
    .location-field input,
    .location-choice-btn,
    .location-current-btn,
    .location-reset-btn,
    .showtime-clear-btn {
        min-height: 34px;
        height: 34px;
        border-radius: 8px;
        box-sizing: border-box;
    }

.location-field select,
.location-field input,
.location-choice-btn {
    width: auto;
    appearance: none;
    padding: 0 26px 0 9px;
    font-size: 0.78rem;
    background: #fff;
    color: var(--app-input-text);
    font-weight: 700;
    border: 1px solid var(--app-input-border);
    box-shadow: none;
}

.location-choice-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    padding-right: 9px;
    text-align: left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.location-choice-symbol,
.location-toggle-symbol {
    flex: 0 0 auto;
    color: var(--app-primary);
    font-size: 0.9rem;
    font-weight: 950;
    line-height: 1;
}

.location-choice-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.location-toggle-symbol {
    margin-left: auto;
}

.location-field:not(.location-actions):not(.filter-clear-field):not(.search-filter-field)::after {
    content: "⌄";
