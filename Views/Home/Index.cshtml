let isRestoringShowtimeFilters=false;
const isPlatformMode=@(platformMode.ToString().ToLowerInvariant());
const isOttMode=@(string.Equals(selectedType, "OTT", StringComparison.OrdinalIgnoreCase).ToString().ToLowerInvariant());

function isSmallShowtimeFilterScreen()
{
    return window.matchMedia("(max-width: 820px)").matches;
}

function setShowtimeFilterToggleState(isExpanded)
{
    const toggle=document.getElementById("showtimeFilterToggle");
    if(!toggle)
    {
        return;
    }

    toggle.setAttribute("aria-expanded",String(Boolean(isExpanded)));
}

function toggleShowtimeFilters()
{
    const controls=document.querySelector("[data-showtime-filter-shell]");
    if(!controls || controls.classList.contains("platform-mode") || !isSmallShowtimeFilterScreen())
    {
        return;
    }

    const shouldExpand=controls.classList.contains("is-filter-collapsed");
    controls.classList.toggle("is-filter-collapsed",!shouldExpand);
    controls.classList.toggle("is-filter-expanded",shouldExpand);
    setShowtimeFilterToggleState(shouldExpand);
}

function setupShowtimeFilterCollapse()
{
    const controls=document.querySelector("[data-showtime-filter-shell]");
    if(!controls || controls.classList.contains("platform-mode"))
    {
        return;
    }

    const syncFilterLayout=()=>{
        if(isSmallShowtimeFilterScreen())
        {
            const isExpanded=controls.classList.contains("is-filter-expanded");
            controls.classList.toggle("is-filter-collapsed",!isExpanded);
            setShowtimeFilterToggleState(isExpanded);
            return;
        }

        controls.classList.remove("is-filter-collapsed","is-filter-expanded");
        setShowtimeFilterToggleState(true);
    };

    syncFilterLayout();
    window.addEventListener("resize",syncFilterLayout);
}

function formatOttTime(seconds)
{
    if(!Number.isFinite(seconds) || seconds<0)
    {
        return "0:00";
    }

    const totalSeconds=Math.floor(seconds);
    const minutes=Math.floor(totalSeconds/60);
    const remainingSeconds=totalSeconds%60;
    return `${minutes}:${remainingSeconds.toString().padStart(2,"0")}`;
}

function setupOttExperience()
{
    if(!isOttMode)
    {
        return;
    }

    const shell=document.querySelector(".ott-player-shell");
    const frame=document.querySelector(".ott-video-frame");
    const video=document.getElementById("ottVideoPlayer");
    const source=video?.querySelector("source");
    const bigPlay=document.getElementById("ottBigPlay");
    const playPause=document.getElementById("ottPlayPause");
    const muteButton=document.getElementById("ottMute");
    const progress=document.getElementById("ottProgress");
    const volume=document.getElementById("ottVolume");
    const speed=document.getElementById("ottSpeed");
    const nextButton=document.getElementById("ottNext");
    const fullscreenButton=document.getElementById("ottFullscreen");
    const currentTime=document.getElementById("ottCurrentTime");
    const duration=document.getElementById("ottDuration");
    const search=document.getElementById("ottSearch");
    const cards=Array.from(document.querySelectorAll(".ott-title-card"));
    const platformButtons=Array.from(document.querySelectorAll(".ott-platform-pill"));
    let currentIndex=0;
    let selectedPlatform="All";

    if(!shell || !frame || !video || !source || !cards.length)
    {
        return;
    }

    const setText=(id,value)=>{
        const element=document.getElementById(id);
        if(element)
        {
            element.textContent=value || "";
        }
    };

    const syncPlaybackButtons=()=>{
        const isPlaying=!video.paused && !video.ended;
        frame.classList.toggle("is-playing",isPlaying);
        if(bigPlay)
        {
            bigPlay.textContent=isPlaying ? "Ⅱ" : "▶";
            bigPlay.title=isPlaying ? "Pause" : "Play";
            bigPlay.setAttribute("aria-label",isPlaying ? "Pause" : "Play");
        }
        if(playPause)
        {
            playPause.textContent=isPlaying ? "Ⅱ" : "▶";
            playPause.title=isPlaying ? "Pause" : "Play";
            playPause.setAttribute("aria-label",isPlaying ? "Pause" : "Play");
        }
    };

    const updateMuteButton=()=>{
        if(muteButton)
        {
            muteButton.textContent=video.muted || video.volume===0 ? "🔇" : "🔊";
            muteButton.title=video.muted || video.volume===0 ? "Unmute" : "Mute";
            muteButton.setAttribute("aria-label",muteButton.title);
        }
    };

    const updateVisibleCards=()=>{
        const query=(search?.value || "").trim().toLowerCase();
        cards.forEach(card=>{
            const matchesPlatform=selectedPlatform==="All" || card.dataset.platform===selectedPlatform;
            const searchBlob=[
                card.dataset.platform,
                card.dataset.title,
                card.dataset.type,
                card.dataset.language,
                card.dataset.description
            ].join(" ").toLowerCase();
            const matchesSearch=!query || searchBlob.includes(query);
            card.hidden=!(matchesPlatform && matchesSearch);
        });
    };

    const loadCard=(card,shouldPlay)=>{
        currentIndex=cards.indexOf(card);
        cards.forEach(item=>item.classList.toggle("active",item===card));
        const accent=card.dataset.accent || "var(--app-primary)";
        shell.style.setProperty("--ott-accent",accent);
        source.src=card.dataset.video || source.src;
        video.load();
        video.volume=Number(volume?.value || 0.8);
        video.playbackRate=Number(speed?.value || 1);
        setText("ottPlayerInitials",card.dataset.initials);
        setText("ottPlayerPlatform",card.dataset.platform);
        setText("ottPlayerQuality",card.dataset.quality);
        setText("ottPlayerType",card.dataset.type);
        setText("ottPlayerTitle",card.dataset.title);
        setText("ottPlayerRating",`${card.dataset.rating || "NA"} ★`);
        setText("ottPlayerYear",card.dataset.year);
        setText("ottPlayerDuration",card.dataset.duration);
        setText("ottPlayerLanguage",card.dataset.language);
        setText("ottPlayerDescription",card.dataset.description);
        if(progress)
        {
            progress.value="0";
        }
        if(currentTime)
        {
            currentTime.textContent="0:00";
        }
        syncPlaybackButtons();

        if(shouldPlay)
        {
            video.play().catch(()=>syncPlaybackButtons());
        }
    };

    const togglePlay=()=>{
        if(video.paused || video.ended)
        {
            video.play().catch(()=>syncPlaybackButtons());
        }
        else
        {
            video.pause();
        }
    };

    const playNext=()=>{
        const visibleCards=cards.filter(card=>!card.hidden);
        if(!visibleCards.length)
        {
            return;
        }
        const activeCard=cards[currentIndex] || visibleCards[0];
        const visibleIndex=visibleCards.indexOf(activeCard);
        const nextCard=visibleCards[(visibleIndex+1+visibleCards.length)%visibleCards.length];
        loadCard(nextCard,true);
    };

    platformButtons.forEach(button=>{
        button.addEventListener("click",()=>{
            selectedPlatform=button.dataset.platform || "All";
            platformButtons.forEach(item=>item.classList.toggle("active",item===button));
            updateVisibleCards();
            const firstVisible=cards.find(card=>!card.hidden);
            if(firstVisible)
            {
                loadCard(firstVisible,false);
            }
        });
    });

    cards.forEach(card=>{
        card.addEventListener("click",()=>loadCard(card,true));
    });

    search?.addEventListener("input",()=>{
        updateVisibleCards();
        const activeCard=cards[currentIndex];
        if(activeCard?.hidden)
        {
            const firstVisible=cards.find(card=>!card.hidden);
            if(firstVisible)
            {
                loadCard(firstVisible,false);
            }
        }
    });

    bigPlay?.addEventListener("click",togglePlay);
    playPause?.addEventListener("click",togglePlay);
    video.addEventListener("click",togglePlay);
    video.addEventListener("play",syncPlaybackButtons);
    video.addEventListener("pause",syncPlaybackButtons);
    video.addEventListener("ended",playNext);
    video.addEventListener("loadedmetadata",()=>{
        if(duration)
        {
            duration.textContent=formatOttTime(video.duration);
        }
    });
    video.addEventListener("timeupdate",()=>{
        if(currentTime)
        {
            currentTime.textContent=formatOttTime(video.currentTime);
        }
        if(progress && Number.isFinite(video.duration) && video.duration>0)
        {
            progress.value=((video.currentTime/video.duration)*100).toString();
        }
    });

    progress?.addEventListener("input",()=>{
        if(Number.isFinite(video.duration) && video.duration>0)
        {
            video.currentTime=(Number(progress.value)/100)*video.duration;
        }
    });

    volume?.addEventListener("input",()=>{
        video.volume=Number(volume.value);
        video.muted=video.volume===0;
        updateMuteButton();
    });

    muteButton?.addEventListener("click",()=>{
        video.muted=!video.muted;
        updateMuteButton();
    });

    speed?.addEventListener("change",()=>{
        video.playbackRate=Number(speed.value || 1);
    });

    nextButton?.addEventListener("click",playNext);
    fullscreenButton?.addEventListener("click",()=>{
        if(document.fullscreenElement)
        {
            document.exitFullscreen?.();
            return;
        }
        frame.requestFullscreen?.();
    });

    loadCard(cards[0],false);
    updateVisibleCards();
    updateMuteButton();
}

