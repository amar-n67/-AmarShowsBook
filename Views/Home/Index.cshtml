            grid-template-columns: 1fr;
            flex-direction: column;
        }
        .showtime-hero {
            padding: 24px;
        }
        .showtime-ticket {
            width: 100%;
            text-align: left;
        }
        .showtime-tabs {
            display: grid;
            grid-template-columns: 1fr;
            width: 100%;
        }
        .showtime-tabs a {
            min-width: 0;
            min-height: 60px;
        }
        .location-field {
            max-width: 100%;
        }
        .location-actions {
            justify-content: stretch;
