    html[data-theme="cinema"] .showtime-page {
        margin: -1.5rem -12px 0;
        padding: 18px 12px 52px;
        background:
            linear-gradient(180deg, rgba(24, 34, 49, 0.08), transparent 220px),
            var(--app-bg);
        color: var(--app-text);
    }

    html[data-theme="cinema"] .showtime-hero {
        background:
            linear-gradient(135deg, rgba(24, 34, 49, 0.98), rgba(38, 57, 79, 0.96) 52%, rgba(154, 106, 55, 0.92)),
            repeating-linear-gradient(90deg, rgba(240, 198, 107, 0.12) 0 10px, transparent 10px 24px);
        color: #fffaf0;
        border: 1px solid rgba(240, 198, 107, 0.32);
        box-shadow: 0 24px 70px rgba(24, 34, 49, 0.26);
    }

    html[data-theme="cinema"] .location-panel,
    html[data-theme="cinema"] .showtime-tabs,
    html[data-theme="cinema"] .show-card,
    html[data-theme="cinema"] .empty-slate {
        background: rgba(255, 255, 255, 0.94);
        border-color: rgba(154, 106, 55, 0.24);
        box-shadow: 0 16px 38px rgba(24, 34, 49, 0.12);
    }

    html[data-theme="cinema"] .showtime-tabs a.active,
    html[data-theme="cinema"] .location-search-btn,
    html[data-theme="cinema"] .btn-primary {
        background: linear-gradient(135deg, var(--app-primary), var(--app-primary-hover));
        border-color: transparent;
        color: #fff;
    }

    html[data-theme="cinema"] .trailer-btn {
        background: #182231;
        color: #fffaf0;
        border-color: rgba(240, 198, 107, 0.28);
    }

    html[data-theme="cinema"] .image-strip {
        background: linear-gradient(135deg, rgba(24, 34, 49, 0.14), rgba(240, 198, 107, 0.16));
        box-shadow: 0 16px 34px rgba(24, 34, 49, 0.22);
    }
</style>

<script>

function closeTrailer()
{
    document
    .getElementById("trailerFrame")
    .src="";

    document
    .getElementById("trailerModal")
    .style.display="none";
}

function showLocationError(message)
{
    if(typeof showCinemaPopup==="function")
    {
        showCinemaPopup(
        message,
        "error"
        );
        return;
    }

    alert(message);
}

function showTrailerSoon()
{
    if(typeof showCinemaPopup==="function")
    {
        showCinemaPopup(
        "Trailer coming soon.",
        "info"
        );
        return;
    }

    alert("Trailer coming soon.");
}

function getYouTubeVideoId(url)
{
    if(!url || url==="#")
    {
        return "";
    }

    try
    {
        const parsedUrl = new URL(url);
        const host = parsedUrl.hostname.toLowerCase();

        if(host.includes("youtu.be"))
        {
            return parsedUrl.pathname.split("/").filter(Boolean)[0] || "";
        }

        if(parsedUrl.pathname.includes("/embed/"))
        {
            return parsedUrl.pathname.split("/embed/")[1]?.split("/")[0] || "";
        }

        if(parsedUrl.pathname.includes("/shorts/"))
        {
            return parsedUrl.pathname.split("/shorts/")[1]?.split("/")[0] || "";
        }

        return parsedUrl.searchParams.get("v") || "";
    }
    catch
    {
        return "";
    }
}

function setSelectOptions(
selectId,
options,
placeholder,
selectedName
)
{
    const select=
    document.getElementById(
    selectId
    );

    select.innerHTML=
    `<option value="">
    ${placeholder}
    </option>`;

    options.forEach(item=>{

        const option=
        document.createElement(
        "option"
        );

        const optionName=
        item.name || item;

        option.value=
        optionName;

        option.dataset.id=
        item.id || "";

        option.dataset.hasData=
        item.id
        ?
        "true"
        :
        "false";

        option.dataset.name=
        optionName;

        option.textContent=
        optionName;

        if(
        selectedName &&
        optionName
        .toLowerCase()
        ===
        selectedName
        .toLowerCase()
        )
        {
            option.selected=true;
        }

        select.appendChild(
        option
        );

    });
}


async function loadCountries()
{
    try
    {
        const response=
        await fetch(
        "/Home/GetCountries"
        );

        if(!response.ok)
        {
            throw new Error(
            "Country request failed"
            );
        }

        const countries=
        await response.json();

        const india=
        countries.find(
        x=>
        x.name &&
        x.name
        .toLowerCase()
        ===
        "india"
        );

        const selectedCountryName=
        india
        ?
        india.name
        :
        "";

        setSelectOptions(
        "country",
        countries,
        "Select Country",
        selectedCountryName
        );

        if(
        india &&
        india.id
        )
        {
            await loadStates();
        }

    }
    catch
    {
        setSelectOptions(
        "country",
        [],
        "Select Country"
        );

        setSelectOptions(
        "state",
        [],
        "Select State"
        );

        setSelectOptions(
        "district",
        [],
        "Select Region"
        );

        showLocationError(
        "Could not load countries."
        );
    }
}



async function loadStates()
{
    const countrySelect=
    document.getElementById(
    "country"
    );

    const selectedCountry=
    countrySelect.options[
    countrySelect.selectedIndex
    ];

    const countryId=
    selectedCountry
    ?
    selectedCountry.dataset.id
    :
    "";

    setSelectOptions(
    "district",
    [],
    "Select Region"
    );

    if(!countryId)
    {
        setSelectOptions(
        "state",
        [],
        "Select State"
        );

        return;
    }

    try
    {
        const response=
        await fetch(
        `/Home/GetStates?countryId=${countryId}`
        );

        const states=
        await response.json();

        setSelectOptions(
        "state",
        states,
        "Select State"
        );
    }
    catch
    {
        showLocationError(
        "Could not load states."
        );
    }
}



async function loadDistricts()
{
    const stateSelect=
    document.getElementById(
    "state"
    );

    const selectedState=
    stateSelect.options[
    stateSelect.selectedIndex
    ];

    const stateId=
    selectedState
    ?
    selectedState.dataset.id
    :
    "";

    if(!stateId)
    {
        setSelectOptions(
        "district",
        [],
        "Select Region"
        );

        return;
    }

    try
    {
        const response=
        await fetch(
        `/Home/GetDistricts?stateId=${stateId}`
        );

        const districts=
        await response.json();

        setSelectOptions(
        "district",
        districts,
        "Select Region"
        );
    }
    catch
    {
        showLocationError(
        "Could not load regions."
        );
    }
}

function applyLocationFilter()
{
    const country=
    document.getElementById("country")?.value.toLowerCase() || "";

    const state=
    document.getElementById("state")?.value.toLowerCase() || "";

    const district=
    document.getElementById("district")?.value.toLowerCase() || "";

    document.querySelectorAll(".show-card").forEach(card=>{
        const text=card.innerText.toLowerCase();
        const matchesCountry=!country || text.includes(country);
        const matchesState=!state || text.includes(state);
        const matchesDistrict=!district || text.includes(district);
        card.hidden=!(matchesCountry && matchesState && matchesDistrict);
    });
}

function resetLocationFilter()
{
    ["country","state","district"].forEach(id=>{
        const select=document.getElementById(id);
        if(select)
        {
            select.selectedIndex=0;
        }
    });

    document.querySelectorAll(".show-card").forEach(card=>{
        card.hidden=false;
    });

    loadCountries();
}



document.addEventListener(
"DOMContentLoaded",
()=>{

loadCountries();



document
.querySelectorAll(
".image-strip"
)
.forEach(slider=>{

const images=
slider.querySelectorAll(
".swap-image"
);

if(
images.length<=1
)
return;

let current=0;

setInterval(()=>{

images[current]
.classList.remove(
"active"
);

current=
(
current+1
)
%
images.length;

images[current]
.classList.add(
"active"
);

},3000);

});



document
.querySelectorAll(
".trailer-btn"
)
.forEach(button=>{

button.addEventListener(
"click",
(event)=>{

event.preventDefault();

event.stopPropagation();

let url=
button.dataset.url;

let videoId=getYouTubeVideoId(url);

if(videoId)
{
document
.getElementById(
"trailerFrame"
)
.src=
`https://www.youtube.com/embed/${videoId}?autoplay=1`;

document
.getElementById(
"trailerModal"
)
.style.display=
"flex";
}
else
{
showTrailerSoon();
}

});

});



document
.getElementById(
"trailerModal"
)
.addEventListener(
"click",
function(e){

if(
e.target.id===
"trailerModal"
)
{
closeTrailer();
}

});

});

</script>
