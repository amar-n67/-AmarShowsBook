    }

    .ott-player-info > p:last-child {
        display: none;
    }

    .ott-controls {
        left: 8px;
        right: 8px;
        bottom: 8px;
    }

    .ott-progress-row,
    .ott-control-row {
        gap: 6px;
    }

    .ott-control-row {
