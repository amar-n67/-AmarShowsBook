        min-height: 112px;
        padding: 16px;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--platform-accent) 24%, var(--app-input-border));
        border-radius: 8px;
        background:
            linear-gradient(180deg, rgba(255,255,255,0.88), rgba(255,255,255,0.72)),
            linear-gradient(135deg, color-mix(in srgb, var(--platform-accent) 18%, transparent), transparent 46%);
        color: var(--app-card-text);
        text-decoration: none;
        box-shadow: 0 12px 26px rgba(15,23,42,.1);
        transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .platform-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 5px;
        background: var(--platform-accent);
    }

    .platform-card:hover,
    .platform-card:focus-visible {
        transform: translateY(-3px);
        border-color: var(--platform-accent);
        box-shadow: 0 16px 34px rgba(15,23,42,.14);
        outline: none;
    }

    .platform-mark {
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border-radius: 8px;
        background: var(--platform-accent);
        color: #fff;
        font-size: 0.92rem;
        font-weight: 950;
        letter-spacing: 0;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.32), 0 8px 18px color-mix(in srgb, var(--platform-accent) 28%, transparent);
    }

    .platform-copy {
        min-width: 0;
        display: grid;
        gap: 4px;
    }

    .platform-copy strong {
        color: inherit;
        font-size: 1rem;
        font-weight: 950;
        line-height: 1.15;
        overflow-wrap: anywhere;
    }

    .platform-copy small {
        color: var(--app-muted);
        font-size: 0.78rem;
        font-weight: 700;
        line-height: 1.35;
    }

    .platform-open {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: color-mix(in srgb, var(--platform-accent) 12%, #fff);
        color: var(--platform-accent);
        font-weight: 950;
        line-height: 1;
    }
    
    .movie-title {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: 18px;
    }
    
    .image-strip {
        height: 0;
        padding-bottom: 100%;
        width: 100%;
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        margin-bottom: 18px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
        background: var(--app-input-border);
    }
    
    .swap-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.1);
        transition: opacity 1s ease, transform 6s ease;
        border-radius: 8px;
    }
    
    .swap-image.active {
        opacity: 1;
        transform: scale(1);
    }
    
    .movie-details {
        margin: 15px 0;
        font-size: 0.92rem;
        flex: 1;
        position: relative;
    }
    
    .imdb-rating {
        position: absolute;
        top: -60px;
        right: 0;
        background: linear-gradient(135deg, #f5c518, #ddb700);
        color: #000;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.85rem;
        box-shadow: 0 4px 12px rgba(245, 197, 24, 0.4);
        z-index: 10;
    }
    
    .imdb-rating::before {
        content: "⭐ ";
    }
    
    .detail-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
        padding-bottom: 8px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--app-input-border);
    }
    
    .detail-row span {
        font-weight: 500;
        color: var(--app-muted);
        word-break: break-word;
        white-space: normal;
        overflow-wrap: break-word;
    }
    
    .detail-row span:first-child {
        flex: 1 1 auto;
        min-width: 50%;
    }
    
    .detail-row span:last-child {
        flex: 0 0 auto;
        text-align: right;
    }
    
    .venue-row {
        display: block;
        width: 100%;
        padding: 4px 0;
        word-break: break-word;
        white-space: normal;
        overflow-wrap: break-word;
        line-height: 1.4;
        color: var(--app-muted);
    }
    
    .venue-row:first-letter {
        text-transform: uppercase;
    }
    
    .card-actions {
        display: flex;
        gap: 10px;
        width: 100%;
        margin-top: 15px;
        margin-top: auto;
    }
    
    .card-actions .btn {
        flex: 1;
        padding: 12px;
        text-align: center;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }
    
    .trailer-btn {
        background: var(--app-input-disabled);
        border: 1px solid var(--app-input-border);
        color: var(--app-input-text);
    }

    .trailer-unavailable {
        opacity: 0.82;
    }
    
    .btn-primary {
        background: var(--app-primary);
        border-color: var(--app-primary);
        color: white;
    }
    
    .card-actions .btn:hover {
        transform: translateY(-3px);
    }
    
    .show-card {
        padding: 20px;
        overflow: hidden;
        border-radius: 8px;
        backdrop-filter: blur(20px);
        transition: 0.4s;
    }
    
    .show-card:hover {
        transform: translateY(-10px) scale(1.02);
    }
    
    .top-profile-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: flex-end;
    }
    
    .profile-btn,
    .exit-btn {
        padding: 12px 22px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
        width: 150px;
        text-align: center;
    }
    
    .profile-btn {
        background: #2f80ed;
        color: white;
    }
    
    .exit-btn {
        background: #ff4757;
        color: white;
    }
    
    .profile-btn:hover,
    .exit-btn:hover {
        transform: translateY(-3px);
    }
    
.location-panel-heading,
.show-type-heading {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    margin: 0;
    white-space: nowrap;
}

.location-panel-heading span,
.show-type-heading span {
    color: var(--app-muted);
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
}

.location-panel-heading strong {
    color: var(--app-card-text);
    font-size: 0.72rem;
    font-weight: 900;
}

.showtime-controls {
    display: grid;
    grid-template-columns: minmax(220px, 1.55fr) minmax(118px, .72fr) minmax(190px, 1.2fr) minmax(92px, .55fr) minmax(154px, .82fr) minmax(154px, .82fr) minmax(76px, auto);
    gap: 10px;
    align-items: end;
    margin: 10px 0 16px;
    padding: 8px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    box-shadow: 0 10px 24px rgba(15,23,42,.08);
}

.showtime-controls.platform-mode {
    grid-template-columns: minmax(220px, 360px);
    max-width: 380px;
}

.showtime-controls.platform-mode .location-picker,
.showtime-controls.platform-mode .search-filter-field,
.showtime-controls.platform-mode .compact-filter-field,
.showtime-controls.platform-mode .location-panel,
.showtime-controls.platform-mode .location-status {
    display: none;
}

.location-panel,
.show-type-panel,
.location-picker {
    min-width: 0;
    display: grid;
    align-items: stretch;
    border: 0;
    background: transparent;
}

.location-panel[hidden] {
    display: none;
}

.location-panel {
    grid-column: 1 / -1;
    padding-top: 4px;
}

.location-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(104px, 1fr)) minmax(140px, auto);
    gap: 6px;
    align-items: center;
}

.location-field {
    min-width: 0;
    max-width: none;
    position: relative;
    display: grid;
