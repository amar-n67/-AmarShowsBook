            radial-gradient(circle at 18% 22%, color-mix(in srgb, var(--ott-accent) 38%, transparent), transparent 30%),
            linear-gradient(135deg, #111, #050505 62%, color-mix(in srgb, var(--ott-accent) 18%, #090909));
