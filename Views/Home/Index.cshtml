    box-shadow: 0 0 0 0.16rem color-mix(in srgb, var(--app-primary) 18%, transparent);
}

.location-field.is-filter-active label,
.location-picker.is-filter-active label {
    color: var(--app-primary);
}

.location-field.is-filter-active select,
.location-field.is-filter-active input,
.location-picker.is-filter-active .location-choice-btn {
    background: #fff6d8 !important;
    background-color: #fff6d8 !important;
    border-color: #d99a00 !important;
    color: var(--app-input-text);
    box-shadow: 0 0 0 2px rgba(217, 154, 0, 0.16), inset 0 0 0 1px rgba(217, 154, 0, 0.12) !important;
}

.location-actions {
    align-self: end;
    display: grid;
    grid-template-columns: 1fr 1fr;
    justify-content: start;
    gap: 8px;
    padding: 0;
    border: 0;
    background: transparent;
}

    .location-current-btn,
    .location-reset-btn,
    .showtime-clear-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--app-input-border);
        min-width: 0;
        padding: 0 10px;
        font-size: 0.76rem;
        font-weight: 800;
        white-space: nowrap;
        line-height: 1;
        overflow: hidden;
        transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
    }

    .location-current-btn .action-icon-inline,
    .location-reset-btn .action-icon-inline,
    .empty-state-link .action-icon-inline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        min-width: 16px;
        height: 16px;
        margin: 0;
        font-size: 0.84rem;
        line-height: 1;
    }

.location-current-btn {
    background: #fff;
    color: var(--app-primary);
    border-color: color-mix(in srgb, var(--app-primary) 32%, var(--app-input-border));
}

.location-reset-btn {
    background: color-mix(in srgb, var(--app-input) 78%, transparent);
    color: var(--app-input-text);
}

.filter-clear-field {
    flex: 0 0 auto;
    min-width: 64px;
}

.filter-clear-field::after {
    content: none !important;
    display: none !important;
}

    .showtime-clear-btn {
        width: 100%;
        background: #fff;
        color: var(--app-primary);
        border-color: color-mix(in srgb, var(--app-primary) 30%, var(--app-input-border));
        gap: 5px;
    }

    .showtime-clear-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--app-primary) 12%, transparent);
        font-size: 0.86rem;
        font-weight: 900;
        line-height: 1;
    }

    .showtime-controls button.action-iconified,
    .empty-state-link.action-iconified {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

.location-current-btn:hover,
.location-current-btn:focus-visible,
.location-reset-btn:hover,
.showtime-clear-btn:hover,
.showtime-clear-btn:focus-visible {
    transform: translateY(-1px);
    border-color: var(--app-primary);
}

.location-current-btn:hover,
.location-current-btn:focus-visible {
    background: var(--app-primary);
    color: #fff;
    outline: none;
}

.showtime-clear-btn:hover,
.showtime-clear-btn:focus-visible {
    background: var(--app-primary);
    color: #fff;
    outline: none;
}

.location-status {
    grid-column: 1 / -1;
    min-height: 0;
    margin: -2px 0 0;
    color: var(--app-muted);
    font-size: 0.72rem;
    font-weight: 700;
}

.empty-state-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    margin-top: 6px;
    padding: 0 14px;
    border: 1px solid var(--app-primary);
    border-radius: 8px;
    background: #fff;
    color: var(--app-primary);
    font-size: 0.82rem;
    font-weight: 900;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease, transform 0.16s ease;
}

.empty-state-link:hover,
.empty-state-link:focus-visible {
    background: var(--app-primary);
    color: #fff;
    outline: none;
    transform: translateY(-1px);
}

.showtime-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    padding: 0;
    align-self: stretch;
    align-items: stretch;
    width: 100%;
    border: 0;
    background: transparent;
}

.showtime-tabs a {
    --type-color: var(--app-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 34px;
    padding: 7px 8px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: #fff;
    color: var(--app-input-text);
    text-align: center;
    text-decoration: none;
    box-shadow: none;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, color 0.18s ease;
}

.showtime-tabs strong {
    display: block;
    max-width: 1180px;
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.1;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 900;
}

.showtime-tabs small {
    display: none;
    margin-top: 3px;
    color: var(--app-muted);
    font-size: 0.66rem;
    font-weight: 800;
    line-height: 1.1;
}

.showtime-tabs a.active {
    background: var(--app-primary);
    border-color: var(--app-primary);
    color: #fff;
    box-shadow: none;
}

.showtime-tabs a:hover {
    transform: translateY(-1px);
    border-color: var(--app-primary);
}

.show-card {
    cursor: default;
}

.show-card:hover {
    transform: translateY(-4px);
}

    .card-actions .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        min-width: 0;
        min-height: 46px;
        border-radius: 8px;
        box-sizing: border-box;
        white-space: nowrap;
        overflow: hidden;
        line-height: 1;
        padding-inline: 10px;
    }

    .card-actions .btn > span:last-child {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .action-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
        border-radius: 6px;
        background: rgba(255,255,255,.2);
        line-height: 1;
        font-size: 0.88rem;
    }

.trailer-btn:hover span:last-child,
.btn-primary:hover span:last-child,
.trailer-btn:focus-visible span:last-child,
.btn-primary:focus-visible span:last-child {
    text-decoration: underline;
    text-underline-offset: 3px;
}

@@media (max-width: 980px) {
    .showtime-controls {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ott-studio {
        grid-template-columns: 1fr;
    }

    .ott-rail {
        position: static;
        grid-template-columns: repeat(4, minmax(150px, 1fr));
        overflow-x: auto;
    }

    .location-panel,
    .show-type-panel {
        grid-template-rows: auto auto;
    }

    .location-panel-heading,
    .show-type-heading {
        margin-bottom: 6px;
    }

    .location-strip {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .showtime-tabs {
        width: 100%;
    }

    .location-actions {
        display: grid;
        grid-column: 1 / -1;
        grid-template-columns: 1fr 1fr;
        justify-content: stretch;
    }
}

@@media (max-width: 760px) {
    .showtime-hero {
        align-items: flex-start;
        flex-direction: column;
        padding: 24px;
    }

    .ott-video-frame {
        min-height: 360px;
    }

    .ott-player-info {
        bottom: 104px;
    }

    .ott-section-head {
        align-items: stretch;
        flex-direction: column;
    }

    .ott-search-wrap {
        flex-basis: auto;
    }

    .showtime-ticket,
    .showtime-summary {
        width: 100%;
        text-align: left;
    }

    .detail-row {
        flex-direction: column;
