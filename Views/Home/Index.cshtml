    .showtime-tabs {
        grid-template-columns: 1fr;
        gap: 8px;
    }

    .location-actions {
        grid-template-columns: 1fr;
    }

    .showtime-tabs a {
        min-height: 44px;
        justify-content: center;
        padding: 10px 12px;
        text-align: center;
    }

    .showtime-tabs .tab-icon,
    .card-actions .action-icon {
        display: none;
    }

    .showtime-tabs strong {
        white-space: normal;
