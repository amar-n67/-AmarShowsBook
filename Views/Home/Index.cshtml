@model AmarShowsBook.Models.ViewModels.HomeViewModel


@{
    ViewData["Title"] = "showTime";
    var selectedType = Context.Request.Query["type"].ToString();
    if (string.IsNullOrWhiteSpace(selectedType))
    {
        selectedType = "All";
    }
    var selectedTypeLabel = string.Equals(selectedType, "All", StringComparison.OrdinalIgnoreCase) ? "All" : selectedType;
    var userName = Context.Session.GetString("UserName") ?? "Artist";
    var userLanguage = Context.Session.GetString("UserLanguage") ?? "English";
    var userGenre = Context.Session.GetString("UserGenre") ?? "Dramatic";
    var isLoggedIn = Context.Session.GetString("UserEmail") != null;
}

<section class="showtime-page">
    <div class="showtime-hero">
        <div>
            <h1>showTime</h1>
            <p>@userName, find a show near you.</p>
        </div>
    </div>

<div class="showtime-controls">
    <div class="location-field">
        <label for="showTypeFilter">Show type</label>
        <select id="showTypeFilter" class="form-control" onchange="changeShowType(this.value)">
            <option value="All" selected="@(selectedTypeLabel == "All" ? "selected" : null)">All</option>
            <option value="Movie" selected="@(selectedType == "Movie" ? "selected" : null)">Movie</option>
            <option value="Live" selected="@(selectedType == "Live" ? "selected" : null)">Live</option>
            <option value="Standup" selected="@(selectedType == "Standup" ? "selected" : null)">Standup</option>
            <option value="News" selected="@(selectedType == "News" ? "selected" : null)">News</option>
        </select>
    </div>
    <div class="location-picker">
        <label>Location</label>
        <button type="button" class="location-choice-btn" id="locationSummaryButton" onclick="toggleLocationChooser()" aria-expanded="false" title="All locations">
            <span class="location-choice-symbol" aria-hidden="true">⌖</span>
            <span class="location-choice-text">All locations</span>
            <span class="location-toggle-symbol" aria-hidden="true">⌄</span>
        </button>
    </div>
    <div class="location-field compact-filter-field">
        <label for="ratingFilter">Rating <span aria-hidden="true">★</span></label>
        <select id="ratingFilter" class="form-control" onchange="applyLocationFilter()">
            <option value="">Any</option>
        </select>
    </div>
    <div class="location-field compact-filter-field">
        <label for="dateFilter">Available Dates</label>
        <input id="dateFilter" class="form-control" type="date" onchange="applyLocationFilter()" />
    </div>
    <div class="location-field compact-filter-field">
        <label for="sortShows">Sort</label>
        <select id="sortShows" class="form-control" onchange="applyLocationFilter()">
            <option value="upcoming">Upcoming first</option>
            <option value="today">Today first</option>
            <option value="rating">Highest rating</option>
            <option value="time">Earliest time</option>
            <option value="title">Name A-Z</option>
            <option value="location">Location A-Z</option>
            <option value="type">Show type</option>
        </select>
    </div>
    <div class="location-field compact-filter-field filter-clear-field">
        <label>&nbsp;</label>
        <button type="button" class="filter-clear-btn" onclick="clearAllShowtimeFilters()">Clear</button>
    </div>
    <div class="location-panel" id="locationPanel" hidden>
        <div class="location-strip">
            <div class="location-field">
                <label for="country">Country</label>
                <select id="country" class="form-control" onchange="clearCurrentLocationFilter(); loadStates().then(applyLocationFilter)">
                    <option value="">All Countries</option>
                </select>
            </div>
            <div class="location-field">
                <label for="state">State</label>
                <select id="state" class="form-control" onchange="clearCurrentLocationFilter(); loadDistricts().then(applyLocationFilter)">
                    <option value="">All States</option>
                </select>
            </div>
            <div class="location-field">
                <label for="district">Region</label>
                <select id="district" class="form-control" onchange="clearCurrentLocationFilter(); applyLocationFilter()">
                    <option value="">All Regions</option>
                </select>
            </div>
            <div class="location-actions">
                <button type="button" class="location-current-btn" onclick="detectCurrentLocation()">Current</button>
                <button type="button" class="location-reset-btn" onclick="resetLocationFilter()">Reset</button>
            </div>
        </div>
    </div>
    <p class="location-status" id="locationStatus" aria-live="polite"></p>
</div>

    <div class="schedule-board">
        @if (!Model.HomeShows.Any())
        {
            <div class="empty-slate">
                <span>No shows</span>
                <h2>No shows found.</h2>
                <p>Try another type or location.</p>
            </div>
        }
        else
        {
@foreach (var item in Model.HomeShows
.Where(x => x.ScheduleId > 0)
.GroupBy(x => x.ShowId)
.Select(x => x.First()))
{
    var showRegion =
    string.IsNullOrWhiteSpace(item.TheaterDetails)
    ? $"{item.Location}, {item.State}, {item.Country}"
    : item.TheaterDetails;
    var showLocation = string.Join(", ", new[] { item.Location, item.State, item.Country }
        .Where(value => !string.IsNullOrWhiteSpace(value)));
    var hasTrailer = !string.IsNullOrWhiteSpace(item.TrailerUrl);

<article class="show-card"
data-location="@showLocation"
data-country="@item.Country"
data-state="@item.State"
data-region="@item.Location"
data-show-type="@item.ShowType"
data-title="@item.Title"
data-director="@item.Director"
data-rating="@(item.ImdbRating?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
data-date="@item.StartTime.ToString("yyyy-MM-dd")"
data-date-label="@item.StartTime.ToString("dd MMM yyyy")"
data-start="@item.StartTime.ToString("O")"
data-time="@item.StartTime.TimeOfDay.TotalMinutes.ToString(System.Globalization.CultureInfo.InvariantCulture)">
  <div class="card-body">

        <h2 class="movie-title">

            @(item.Title ?? "Untitled Show")

        </h2>


        <div class="image-strip">

            <img class="swap-image active"
                 src="@(string.IsNullOrEmpty(item.PosterUrl)
                 ? "/images/default1.jpg"
                 : item.PosterUrl)" />

            @if(!string.IsNullOrEmpty(item.Images))
            {
                @foreach(var img in item.Images.Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries))
                {
                    <img class="swap-image"
                         src="@img.Trim()" />
                }
            }

        </div>

<div class="movie-details">

    <div class="detail-row">

        <span>Date:
            @item.StartTime.ToString("dd MMM yyyy")
        </span>

        <span>Time:
            @item.StartTime.ToString("hh:mm tt")
        </span>

    </div>

    <div class="detail-row">
        <span>Director/Host: @(string.IsNullOrWhiteSpace(item.Director) ? "NA" : item.Director)</span>
        <span class="imdb-rating" title="IMDB rating">@(item.ImdbRating?.ToString("0.0") ?? "NA")</span>
    </div>

    <div class="venue-row">
        Cast: @(string.IsNullOrWhiteSpace(item.Cast) ? "NA" : item.Cast)
    </div>

    <div class="venue-row">

        Venue: @showRegion

    </div>

    <div class="venue-row">

        Location: @(string.IsNullOrWhiteSpace(showLocation) ? "Location TBA" : showLocation)

    </div>

</div>


<div class="card-actions">
<a
class="btn trailer-btn @(hasTrailer ? "" : "trailer-unavailable")"
data-url="@item.TrailerUrl"
href="#"
onclick="event.preventDefault();event.stopPropagation();">

<span class="action-icon" aria-hidden="true">▶</span>
<span>Trailer</span>
</a>

<a
class="btn btn-primary"
href="/Booking/Seats/@item.ScheduleId"
title="@(isLoggedIn ? "Book Ticket" : "Login required to book tickets")"
aria-label="@(isLoggedIn ? "Book Ticket" : "Login required to book tickets")">

<span class="action-icon" aria-hidden="true">🎟</span>
<span>@(isLoggedIn ? "Book" : "Login")</span>
</a>

</div>

    </div>

</article>

}
        }
    </div>
    <div class="empty-slate filter-empty-state" id="filterEmptyState" hidden>
        <span>No shows</span>
        <h2 id="filterEmptyTitle">No shows available.</h2>
        <p id="filterEmptyMessage">Try another location or filter.</p>
        <button type="button" class="empty-state-link" id="showNearbyLink" onclick="showNearbyShows()" hidden>Show nearby</button>
    </div>
    <div id="trailerModal" class="trailer-modal">

    <div class="trailer-container">

        <button
        class="close-trailer"
        onclick="closeTrailer()">

        ✕

        </button>

        <iframe
        id="trailerFrame"
        allowfullscreen
        allow="autoplay">
        </iframe>

    </div>

</div>
</section>

<style>
    .show-card {
        cursor: pointer;
    }
    
    .trailer-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }
    
    .trailer-container {
        width: 90%;
        max-width: 1000px;
        height: 80vh;
        position: relative;
        z-index: 9999;
    }
    
    .trailer-container iframe {
        width: 100%;
        height: 100%;
        border: none;
        border-radius: 15px;
    }
    
    .close-trailer {
        position: absolute;
        top: -50px;
        right: 0;
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 50%;
        background: #ff4757;
        color: white;
        cursor: pointer;
        font-size: 18px;
        font-weight: bold;
        z-index: 10000;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    
    .showtime-page {
        padding-bottom: 44px;
    }
    
    .showtime-hero {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: center;
        min-height: 130px;
        padding: 24px;
        border-radius: 8px;
        background: var(--app-nav);
        color: var(--app-nav-text);
        box-shadow: 0 14px 34px rgba(35, 31, 32, 0.16);
    }
    
    .showtime-kicker,
    .showtime-ticket span,
    .show-card-top span,
    .empty-slate span {
        text-transform: uppercase;
        font-size: 0.74rem;
        font-weight: 850;
        letter-spacing: 0.08em;
    }
    
    .showtime-hero h1 {
        margin: 0 0 6px;
        color: inherit;
        font-size: clamp(2rem, 5vw, 3.8rem);
        font-weight: 900;
    }
    
    .showtime-hero p {
        margin: 0;
        max-width: 620px;
        color: color-mix(in srgb, var(--app-nav-text) 82%, transparent);
        font-size: 1rem;
    }
    
    .showtime-ticket {
        min-width: 180px;
        padding: 14px;
        border: 1px dashed color-mix(in srgb, var(--app-nav-text) 42%, transparent);
        border-radius: 8px;
        text-align: right;
        background: color-mix(in srgb, var(--app-card) 28%, transparent);
    }
    
    .showtime-ticket strong {
        display: block;
        color: inherit;
        font-size: 1.2rem;
    }
    
    .showtime-controls {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
        gap: 12px;
        align-items: stretch;
        margin: 24px 0;
    }
    
    .location-panel {
        min-width: 0;
        padding: 16px 20px;
        border: 1px solid var(--app-input-border);
        border-radius: 8px;
        background: var(--app-card);
        color: var(--app-card-text);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.13);
    }
    
    .location-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: end;
    }
    
    .location-field {
        flex: 1;
        min-width: 150px;
        max-width: none;
    }
    
    .location-field label {
        display: block;
        margin-bottom: 6px;
        font-size: 0.75rem;
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--app-muted);
    }
    
    .location-field select {
        width: 100%;
        min-height: 36px;
        border-radius: 10px;
        padding: 0 10px;
        font-size: 0.85rem;
        border: 1px solid var(--app-input-border);
        background: var(--app-bg);
        color: var(--app-text);
    }
    
    .location-actions {
        flex: 0 0 auto;
        display: flex;
        gap: 8px;
        min-width: auto;
        max-width: none;
    }
    
    .location-reset-btn {
        min-height: 36px;
        padding: 0 14px;
        border-radius: 10px;
        border: 1px solid var(--app-input-border);
        font-weight: 800;
        white-space: nowrap;
        font-size: 0.85rem;
    }
    
    .location-reset-btn {
        background: transparent;
        color: var(--app-card-text);
    }
    
    .showtime-tabs {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        padding: 10px;
        border: 1px solid var(--app-input-border);
        border-radius: 8px;
        background: var(--app-card);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.13);
    }
    
    .showtime-tabs a {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        min-height: 76px;
        padding: 12px;
        border: 1px solid color-mix(in srgb, var(--app-input-border) 72%, transparent);
        border-radius: 8px;
        color: var(--app-text);
        text-align: left;
        text-decoration: none;
        font-weight: 850;
        font-size: 0.9rem;
        background: color-mix(in srgb, var(--app-bg) 42%, var(--app-card));
    }

    .showtime-tabs a:hover {
        border-color: var(--app-primary);
        transform: translateY(-2px);
    }

    .showtime-tabs .tab-icon {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        border-radius: 50%;
        background: color-mix(in srgb, var(--app-primary) 14%, transparent);
        font-size: 1.15rem;
    }

    .showtime-tabs strong,
    .showtime-tabs small {
        display: block;
        line-height: 1.2;
    }

    .showtime-tabs small {
        margin-top: 3px;
        color: var(--app-muted);
        font-size: 0.72rem;
        font-weight: 750;
    }
    
    .showtime-tabs a.active {
        background: var(--app-primary);
        color: #fff;
        border-color: var(--app-primary);
        box-shadow: 0 10px 24px color-mix(in srgb, var(--app-primary) 24%, transparent);
    }

    .showtime-tabs a.active .tab-icon {
        background: rgba(255, 255, 255, 0.22);
    }

    .showtime-tabs a.active small {
        color: rgba(255, 255, 255, 0.82);
    }
    
    .schedule-board {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        align-items: stretch;
    }
    
    .show-card,
    .empty-slate {
        border: 1px solid var(--app-input-border);
        border-radius: 8px;
        background: var(--app-card);
        color: var(--app-card-text);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.13);
    }
    
    .show-card {
        display: flex;
        flex-direction: column;
        padding: 20px;
        min-height: 100%;
        position: relative;
    }
    
    .show-card .card-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        height: 100%;
    }
    
    .show-card-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: var(--app-muted);
    }
    
    .show-card h2 {
        min-height: 58px;
        margin: 0;
        color: inherit;
        font-size: 1.22rem;
        font-weight: 900;
    }
    
    .show-card p {
        margin: 0;
        color: var(--app-muted);
    }
    
    .show-region {
        min-height: 42px;
        font-weight: 750;
    }
    
    .show-card .btn {
        align-self: end;
        font-weight: 850;
    }
    
    .empty-slate {
        grid-column: 1 / -1;
        padding: 34px;
        text-align: center;
    }
    
    .empty-slate h2 {
        margin: 8px 0;
        color: inherit;
    }
    
    .empty-slate p {
        margin: 0;
        color: var(--app-muted);
    }
    
    .movie-title {
        font-size: 1.6rem;
        font-weight: 800;
        margin-bottom: 18px;
    }
    
    .image-strip {
        height: 0;
        padding-bottom: 100%;
        width: 100%;
        position: relative;
        overflow: hidden;
        border-radius: 8px;
        margin-bottom: 18px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
        background: var(--app-input-border);
    }
    
    .swap-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transform: scale(1.1);
        transition: opacity 1s ease, transform 6s ease;
        border-radius: 8px;
    }
    
    .swap-image.active {
        opacity: 1;
        transform: scale(1);
    }
    
    .movie-details {
        margin: 15px 0;
        font-size: 0.92rem;
        flex: 1;
        position: relative;
    }
    
    .imdb-rating {
        position: absolute;
        top: -60px;
        right: 0;
        background: linear-gradient(135deg, #f5c518, #ddb700);
        color: #000;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.85rem;
        box-shadow: 0 4px 12px rgba(245, 197, 24, 0.4);
        z-index: 10;
    }
    
    .imdb-rating::before {
        content: "⭐ ";
    }
    
    .detail-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 8px;
        padding-bottom: 8px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--app-input-border);
    }
    
    .detail-row span {
        font-weight: 500;
        color: var(--app-muted);
        word-break: break-word;
        white-space: normal;
        overflow-wrap: break-word;
    }
    
    .detail-row span:first-child {
        flex: 1 1 auto;
        min-width: 50%;
    }
    
    .detail-row span:last-child {
        flex: 0 0 auto;
        text-align: right;
    }
    
    .venue-row {
        display: block;
        width: 100%;
        padding: 4px 0;
        word-break: break-word;
        white-space: normal;
        overflow-wrap: break-word;
        line-height: 1.4;
        color: var(--app-muted);
    }
    
    .venue-row:first-letter {
        text-transform: uppercase;
    }
    
    .card-actions {
        display: flex;
        gap: 10px;
        width: 100%;
        margin-top: 15px;
        margin-top: auto;
    }
    
    .card-actions .btn {
        flex: 1;
        padding: 12px;
        text-align: center;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }
    
    .trailer-btn {
        background: var(--app-input-disabled);
        border: 1px solid var(--app-input-border);
        color: var(--app-input-text);
    }

    .trailer-unavailable {
        opacity: 0.82;
    }
    
    .btn-primary {
        background: var(--app-primary);
        border-color: var(--app-primary);
        color: white;
    }
    
    .card-actions .btn:hover {
        transform: translateY(-3px);
    }
    
    .show-card {
        padding: 20px;
        overflow: hidden;
        border-radius: 8px;
        backdrop-filter: blur(20px);
        transition: 0.4s;
    }
    
    .show-card:hover {
        transform: translateY(-10px) scale(1.02);
    }
    
    .top-profile-actions {
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: flex-end;
    }
    
    .profile-btn,
    .exit-btn {
        padding: 12px 22px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
        width: 150px;
        text-align: center;
    }
    
    .profile-btn {
        background: #2f80ed;
        color: white;
    }
    
    .exit-btn {
        background: #ff4757;
        color: white;
    }
    
    .profile-btn:hover,
    .exit-btn:hover {
        transform: translateY(-3px);
    }
    
.location-panel-heading,
.show-type-heading {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    margin: 0;
    white-space: nowrap;
}

.location-panel-heading span,
.show-type-heading span {
    color: var(--app-muted);
    font-size: 0.68rem;
    font-weight: 900;
    text-transform: uppercase;
}

.location-panel-heading strong {
    color: var(--app-card-text);
    font-size: 0.72rem;
    font-weight: 900;
}

.showtime-controls {
    display: grid;
    grid-template-columns: minmax(90px, .78fr) minmax(150px, 1.3fr) minmax(82px, .62fr) minmax(116px, .8fr) minmax(116px, .86fr) minmax(64px, auto);
    gap: 8px;
    align-items: end;
    margin: 10px 0 16px;
    padding: 8px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    box-shadow: 0 10px 24px rgba(15,23,42,.08);
}

.location-panel,
.show-type-panel,
.location-picker {
    min-width: 0;
    display: grid;
    align-items: stretch;
    border: 0;
    background: transparent;
}

.location-panel[hidden] {
    display: none;
}

.location-panel {
    grid-column: 1 / -1;
    padding-top: 4px;
}

.location-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(104px, 1fr)) minmax(140px, auto);
    gap: 6px;
    align-items: center;
}

.location-field {
    min-width: 0;
    max-width: none;
    position: relative;
    display: grid;
    gap: 3px;
    padding: 0;
    border: 0;
    background: transparent;
}

.location-field label,
.location-picker label {
    margin: 0;
    color: var(--app-muted);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.location-field select,
.location-field input,
.location-choice-btn,
.location-current-btn,
.location-reset-btn,
.filter-clear-btn {
    min-height: 34px;
    height: 34px;
    border-radius: 8px;
}

.location-field select,
.location-field input,
.location-choice-btn {
    width: 100%;
    appearance: none;
    padding: 0 26px 0 9px;
    font-size: 0.78rem;
    background: #fff;
    color: var(--app-input-text);
    font-weight: 700;
    border: 1px solid var(--app-input-border);
