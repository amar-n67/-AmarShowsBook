    padding: 0;
    border: 0;
    background: transparent;
}

.search-filter-field {
    min-width: 220px;
}

.compact-filter-field {
    min-width: 92px;
}

#showTypeFilter {
    min-width: 118px;
}

#dateFilter,
#sortShows {
    min-width: 154px;
}

.location-field label,
.location-picker label {
