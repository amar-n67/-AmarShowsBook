function getYouTubeVideoId(url)
{
    if(!url || url==="#")
    {
        return "";
    }

    try
    {
        const parsedUrl = new URL(url);
        const host = parsedUrl.hostname.toLowerCase();

        if(host.includes("youtu.be"))
        {
            return parsedUrl.pathname.split("/").filter(Boolean)[0] || "";
        }

        if(parsedUrl.pathname.includes("/embed/"))
        {
            return parsedUrl.pathname.split("/embed/")[1]?.split("/")[0] || "";
        }

        if(parsedUrl.pathname.includes("/shorts/"))
        {
            return parsedUrl.pathname.split("/shorts/")[1]?.split("/")[0] || "";
        }

        return parsedUrl.searchParams.get("v") || "";
    }
    catch
    {
        return "";
    }
}

function setSelectOptions(
selectId,
options,
placeholder,
selectedName
)
{
    const select=
    document.getElementById(
    selectId
    );

    if(!select)
    {
        return;
    }

    select.innerHTML=
    `<option value="">
    ${placeholder}
    </option>`;

    options.forEach(item=>{

        const option=
        document.createElement(
        "option"
        );

        const optionName=
        item.name || item;

        option.value=optionName;

        option.dataset.id=
        item.id || "";

        option.dataset.hasData=
        item.id
        ?
        "true"
        :
        "false";

        option.dataset.name=
        optionName;

        option.textContent=
        optionName;

        if(
        selectedName &&
        optionName
        .toLowerCase()
        ===
        selectedName
        .toLowerCase()
        )
        {
            option.selected=true;
        }

        select.appendChild(
        option
        );

    });
}

function setSimpleOptions(selectId,items,placeholder)
{
    const select=document.getElementById(selectId);
    if(!select)
    {
        return;
    }

    const currentValue=select.value;
    select.innerHTML=`<option value="">${placeholder}</option>`;

    items.forEach(item=>{
        const option=document.createElement("option");
        option.value=item.value;
        option.textContent=item.label;
        select.appendChild(option);
    });

    if(Array.from(select.options).some(option=>option.value===currentValue))
    {
        select.value=currentValue;
    }
}

function populateDynamicFilters()
{
    const cards=Array.from(document.querySelectorAll(".show-card"));

    const dates=[...new Map(cards
    .map(card=>({
        value:card.dataset.date || "",
        label:card.dataset.dateLabel || card.dataset.date || ""
    }))
    .filter(item=>item.value)
    .sort((a,b)=>a.value.localeCompare(b.value))
    .map(item=>[item.value,item])).values()];

    setSimpleOptions("dateFilter",dates,"Any date");
}

function setControlValue(controlId,value)
{
    const control=document.getElementById(controlId);
    if(control && value !== undefined && value !== null)
    {
        control.value=value;
    }
}

async function restoreSavedShowtimeFilters()
{
    const saved=getSavedShowtimeFilters();
    const hasSavedFilter=Boolean(
        saved.search ||
        saved.country ||
        (saved.type && saved.type!=="All") ||
        saved.state ||
        saved.district ||
        saved.date ||
        (saved.sort && saved.sort!=="upcoming") ||
        saved.locationDisplayOverride ||
        saved.currentLocationFilter
    );

    if(!hasSavedFilter)
    {
        return false;
    }

    isRestoringShowtimeFilters=true;
    try
    {
        await loadCountries(saved.country || "");
        if(saved.country)
        {
            selectBestLocationOption("country",[saved.country]);
            await loadStates(saved.state || "");
        }

        if(saved.state)
        {
            selectBestLocationOption("state",[saved.state]);
            await loadDistricts(saved.district || "");
        }

        if(saved.district)
        {
            selectBestLocationOption("district",[saved.district]);
        }

        setControlValue("showtimeSearch",saved.search || "");
        setControlValue("dateFilter",saved.date || "");
        setControlValue("sortShows",saved.sort || "upcoming");
        setControlValue("showTypeFilter",saved.type || "All");
        locationDisplayOverride=saved.locationDisplayOverride || "";
        currentLocationFilter=saved.currentLocationFilter || null;
    }
    finally
    {
        isRestoringShowtimeFilters=false;
    }

    applyLocationFilter();
    return true;
}


function normalizeLocationText(value)
{
    return (value || "")
    .toString()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();
}

function selectBestLocationOption(selectId,candidates)
{
    const select=document.getElementById(selectId);
    if(!select)
    {
        return "";
    }

    const normalizedCandidates=(Array.isArray(candidates) ? candidates : [candidates])
    .map(normalizeLocationText)
    .filter(Boolean);

    if(!normalizedCandidates.length)
    {
        return "";
    }

    const options=Array.from(select.options);
    const match=options.find(option=>{
        const optionText=normalizeLocationText(option.dataset.name || option.value || option.textContent);
        return optionText && normalizedCandidates.some(candidate=>
            optionText===candidate ||
            optionText.includes(candidate) ||
            candidate.includes(optionText)
        );
    });

    if(match)
    {
        select.value=match.value;
        return match.value;
    }

    return "";
}

function setCurrentRegionOption(region)
{
    const select=document.getElementById("district");
    const regionName=(region || "").trim();
    if(!select || !regionName)
    {
        return "";
    }

    const normalizedRegion=normalizeLocationText(regionName);
    Array.from(select.options).forEach(option=>{
        const optionName=normalizeLocationText(option.dataset.name || option.value || option.textContent);
        if(optionName===normalizedRegion)
        {
            option.remove();
        }
    });

    const option=document.createElement("option");
    option.value=regionName;
    option.dataset.id="";
    option.dataset.hasData="false";
    option.dataset.name=regionName;
    option.dataset.currentLocation="true";
    option.textContent=regionName;
    option.selected=true;

    select.insertBefore(option,select.firstChild);
    return regionName;
}

function selectAllOption(select)
{
    if(!select)
    {
        return;
    }

    if(Array.from(select.options).some(option=>option.value===""))
    {
        select.value="";
        return;
    }

    select.selectedIndex=0;
}

async function loadCountries(selectedName)
{
    try
    {
        const response=
        await fetch(
        "/Home/GetCountries"
        );

        if(!response.ok)
        {
            throw new Error(
            "Country request failed"
            );
        }

        const countries=
        await response.json();

        const currentCountry=document.getElementById("country")?.value || "";
        const selectedCountryName=selectedName || currentCountry || "";

        setSelectOptions(
        "country",
        countries,
        "All Countries",
        selectedCountryName
        );

        if(selectedCountryName)
        {
            await loadStates();
        }
        else
        {
            setSelectOptions(
            "state",
            [],
            "All States"
            );

            setSelectOptions(
            "district",
            [],
            "All Regions"
            );
        }

    }
    catch
    {
        setSelectOptions(
        "country",
        [],
        "All Countries"
        );

        setSelectOptions(
        "state",
        [],
        "All States"
        );

        setSelectOptions(
        "district",
        [],
        "All Regions"
        );

        showLocationError(
        "Could not load countries."
        );
    }
}



async function loadStates(selectedName)
{
    const countrySelect=
    document.getElementById(
    "country"
    );

    const selectedCountry=
    countrySelect.options[
    countrySelect.selectedIndex
    ];

    const countryId=
    selectedCountry
    ?
    selectedCountry.dataset.id
    :
    "";

    const countryName=countrySelect.value || "";

    setSelectOptions(
    "district",
    [],
    "All Regions"
    );

    if(!countryId && !countryName)
    {
        setSelectOptions(
        "state",
        [],
        "All States"
        );

        return;
    }

    try
    {
        const response=
        await fetch(
        `/Home/GetStates?countryId=${encodeURIComponent(countryId)}&countryName=${encodeURIComponent(countryName)}`
        );

        const states=
        await response.json();

        setSelectOptions(
        "state",
        states,
        "All States",
        selectedName
        );
        updateLocationSummary();
    }
    catch
    {
        showLocationError(
        "Could not load states."
        );
    }
}



async function loadDistricts(selectedName)
{
    const stateSelect=
    document.getElementById(
    "state"
    );

    const selectedState=
    stateSelect.options[
    stateSelect.selectedIndex
    ];

    const stateId=
    selectedState
    ?
    selectedState.dataset.id
    :
    "";

    const stateName=stateSelect.value || "";
    const countryName=document.getElementById("country")?.value || "";

    if(!stateId && !stateName)
    {
        setSelectOptions(
        "district",
        [],
        "All Regions"
        );

        return;
    }

    try
    {
        const response=
        await fetch(
        `/Home/GetDistricts?stateId=${encodeURIComponent(stateId)}&stateName=${encodeURIComponent(stateName)}&countryName=${encodeURIComponent(countryName)}`
        );

        const districts=
        await response.json();

        setSelectOptions(
        "district",
        districts,
        "All Regions",
        selectedName
        );
        updateLocationSummary();
    }
    catch
    {
        showLocationError(
        "Could not load regions."
        );
    }
}

async function detectCurrentLocation(isAuto)
{
    if(!navigator.geolocation)
    {
        if(!isAuto)
        {
            showLocationError("Current location is not supported in this browser.");
        }
        return;
    }

    try
    {
        setLocationStatus("Detecting your current location...");

        const position=await new Promise((resolve,reject)=>{
            navigator.geolocation.getCurrentPosition(resolve,reject,{
                enableHighAccuracy:false,
                timeout:9000,
                maximumAge:300000
            });
        });

        const latitude=position.coords.latitude;
        const longitude=position.coords.longitude;

        const response=await fetch(
            `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(latitude)}&lon=${encodeURIComponent(longitude)}&zoom=12&addressdetails=1`
        );

        if(!response.ok)
        {
            throw new Error("Location lookup failed");
        }

        const result=await response.json();
        const address=result.address || {};
        const country=address.country || "";
        const state=address.state || address.province || address.region || "";
        const regionCandidates=[
            address.neighbourhood,
            address.suburb,
            address.city_district,
            address.quarter,
            address.county,
            address.city,
            address.town,
            address.village,
            address.municipality,
            address.state_district
        ].filter(Boolean);
        const region=regionCandidates[0] || "";

        if(!country && !state && !region)
        {
            throw new Error("Location details unavailable");
        }

        await loadCountries(country);
        selectBestLocationOption("country",[country]);
        await loadStates(state);
        selectBestLocationOption("state",[state]);
        await loadDistricts(region);
        const matchedRegion=selectBestLocationOption("district",regionCandidates);
        if(region)
        {
            setCurrentRegionOption(region);
        }

        const detected=[region,state,country].filter(Boolean).join(", ");
        locationDisplayOverride=detected;
        currentLocationFilter={
            country,
            state,
            region,
            regionCandidates,
            hasMatchedRegion: Boolean(matchedRegion)
        };
        applyLocationFilter();
        updateLocationSummary();
    }
    catch
    {
        setLocationStatus("");
        if(!isAuto)
        {
            showLocationError("Could not detect your current location. Please choose it manually.");
        }
    }
}

function applyLocationFilter()
{
    const searchValue=
    normalizeLocationText(document.getElementById("showtimeSearch")?.value || "");

    const country=
    document.getElementById("country")?.value.toLowerCase() || "";

    const state=
    document.getElementById("state")?.value.toLowerCase() || "";

    const district=
    document.getElementById("district")?.value.toLowerCase() || "";

    const dateValue=
    document.getElementById("dateFilter")?.value || "";

    const typeValue=
    document.getElementById("showTypeFilter")?.value || "All";

    document.querySelectorAll(".show-card").forEach(card=>{
        const cardCountry=(card.dataset.country || "").toLowerCase();
        const cardState=(card.dataset.state || "").toLowerCase();
        const cardRegion=(card.dataset.region || "").toLowerCase();
        const cardLocation=(card.dataset.location || card.innerText || "").toLowerCase();
        const cardDate=card.dataset.date || "";
        const cardType=card.dataset.showType || "";
        const cardSearch=normalizeLocationText(card.dataset.filterSearch || card.innerText || "");
        let matchesCountry=!country || cardCountry===country || cardLocation.includes(country);
        let matchesState=!state || cardState===state || cardLocation.includes(state);
        let matchesDistrict=!district || cardRegion===district || cardLocation.includes(district);

        if(currentLocationFilter && currentLocationFilter.region)
        {
            const currentRegion=normalizeLocationText(currentLocationFilter.region);
            const currentCandidates=(currentLocationFilter.regionCandidates || [])
                .map(normalizeLocationText)
                .filter(Boolean);
            const normalizedCardRegion=normalizeLocationText(card.dataset.region || "");
            const normalizedCardLocation=normalizeLocationText(card.dataset.location || card.innerText || "");
            const matchesCurrentRegion=currentCandidates.some(candidate=>
                normalizedCardRegion===candidate ||
                normalizedCardLocation.includes(candidate)
            ) || normalizedCardRegion===currentRegion || normalizedCardLocation.includes(currentRegion);

            matchesCountry=!currentLocationFilter.country || cardCountry===currentLocationFilter.country.toLowerCase() || cardLocation.includes(currentLocationFilter.country.toLowerCase());
            matchesState=!currentLocationFilter.state || cardState===currentLocationFilter.state.toLowerCase() || cardLocation.includes(currentLocationFilter.state.toLowerCase());
            matchesDistrict=matchesCurrentRegion;
        }

        const matchesDate=!dateValue || cardDate===dateValue;
        const matchesType=typeValue==="All" || cardType===typeValue;
        const matchesSearch=!searchValue || cardSearch.includes(searchValue);
        card.hidden=!(matchesSearch && matchesCountry && matchesState && matchesDistrict && matchesDate && matchesType);
    });

    updateLocationSummary();
    updateFilterEmptyState();
    sortShows();
    saveShowtimeFilters();
}

function updateFilterEmptyState()
{
    const cards=Array.from(document.querySelectorAll(".show-card"));
    const emptyState=document.getElementById("filterEmptyState");
    const emptyTitle=document.getElementById("filterEmptyTitle");
    const emptyMessage=document.getElementById("filterEmptyMessage");
    const nearbyLink=document.getElementById("showNearbyLink");
    if(!emptyState)
    {
        return;
    }

    const hasVisibleCard=cards.some(card=>!card.hidden);
    emptyState.hidden=hasVisibleCard || !cards.length;
    const hasLocation=getSelectedLocationName() !== "All locations";

    if(nearbyLink)
    {
        nearbyLink.hidden=!hasLocation || hasVisibleCard || !cards.length;
    }

    if(emptyTitle)
    {
        emptyTitle.textContent=hasLocation ? "No shows available at your location." : "No shows available.";
    }

    if(emptyMessage)
    {
        const locationName=getSelectedLocationName();
        const search=document.getElementById("showtimeSearch")?.value?.trim() || "";
        const date=document.getElementById("dateFilter")?.value || "";
        const filterText=[
            search ? `"${search}"` : "",
            date ? date : ""
        ].filter(Boolean).join(", ");
        const locationText=locationName !== "All locations" ? ` at ${locationName}` : "";
        const selectedFilterText=filterText ? ` for ${filterText}` : "";

        emptyMessage.textContent=`No shows available${locationText}${selectedFilterText}.`;
    }
}

async function setLocationToFirstVisibleShowRegion()
{
    const card=Array.from(document.querySelectorAll(".show-card")).find(item=>!item.hidden);
    if(!card)
    {
        return "";
    }

    const country=card.dataset.country || "";
    const state=card.dataset.state || "";
    const region=card.dataset.region || "";

    clearCurrentLocationFilter();

    if(country)
    {
        await loadCountries(country);
        selectBestLocationOption("country",[country]);
    }

    if(state)
    {
        await loadStates(state);
        selectBestLocationOption("state",[state]);
    }

    if(region)
    {
        await loadDistricts(region);
        selectBestLocationOption("district",[region]);
    }

    applyLocationFilter();
    return getSelectedLocationName();
}

async function showNearbyShows()
{
    const districtSelect=document.getElementById("district");
    const stateSelect=document.getElementById("state");
    const countrySelect=document.getElementById("country");

    const hadCurrentLocation=Boolean(currentLocationFilter);
    clearCurrentLocationFilter();

    if(hadCurrentLocation)
    {
        selectAllOption(districtSelect);
        applyLocationFilter();
        if(hasVisibleShows())
        {
            await setLocationToFirstVisibleShowRegion();
            setLocationStatus(`Showing nearby shows in ${getSelectedLocationName()}`);
            return;
        }
    }

    if(districtSelect?.value)
    {
        selectAllOption(districtSelect);
        applyLocationFilter();
        if(hasVisibleShows())
        {
            await setLocationToFirstVisibleShowRegion();
            setLocationStatus(`Showing nearby shows in ${getSelectedLocationName()}`);
            return;
        }
    }

    if(stateSelect?.value)
    {
        selectAllOption(stateSelect);
        setSelectOptions("district",[],"All Regions");
        applyLocationFilter();
        if(hasVisibleShows())
        {
            await setLocationToFirstVisibleShowRegion();
            setLocationStatus(`Showing nearby shows in ${getSelectedLocationName()}`);
            return;
        }
    }

    if(countrySelect?.value)
    {
        selectAllOption(countrySelect);
        setSelectOptions("state",[],"All States");
        setSelectOptions("district",[],"All Regions");
    }

    applyLocationFilter();

    if(hasVisibleShows())
    {
        await setLocationToFirstVisibleShowRegion();
    }

    const relaxedLocation=getSelectedLocationName();
    setLocationStatus(relaxedLocation==="All locations"
        ? "Showing all available shows"
        : `Showing nearby shows in ${relaxedLocation}`);
}

function sortShows()
{
    const board=document.querySelector(".schedule-board");
    if(!board)
    {
        return;
    }

    const sortValue=document.getElementById("sortShows")?.value || "upcoming";
    const cards=Array.from(board.querySelectorAll(".show-card"));

    const readText=(card,key)=>(card.dataset[key] || "").toLowerCase();
    const readDate=card=>{
        const time=Date.parse(card.dataset.start || "");
        return Number.isNaN(time) ? 0 : time;
    };
    const readNumber=(card,key)=>Number(card.dataset[key] || 0);

    cards.sort((a,b)=>{
        if(sortValue==="rating")
        {
            return readNumber(b,"rating") - readNumber(a,"rating") || readDate(a) - readDate(b);
        }

        if(sortValue==="ratingLow")
        {
            return readNumber(a,"rating") - readNumber(b,"rating") || readDate(a) - readDate(b);
        }

        if(sortValue==="today")
        {
            const today=new Date();
            today.setHours(0,0,0,0);
            const todayTime=today.getTime();
            const aGap=Math.abs(new Date(readDate(a)).setHours(0,0,0,0) - todayTime);
            const bGap=Math.abs(new Date(readDate(b)).setHours(0,0,0,0) - todayTime);
            return aGap - bGap || readDate(a) - readDate(b);
        }

        if(sortValue==="time")
        {
            return readNumber(a,"time") - readNumber(b,"time") || readDate(a) - readDate(b);
        }

        if(sortValue==="title")
        {
            return readText(a,"title").localeCompare(readText(b,"title")) || readDate(a) - readDate(b);
        }

        if(sortValue==="location")
        {
            return readText(a,"location").localeCompare(readText(b,"location")) || readDate(a) - readDate(b);
        }

        if(sortValue==="type")
        {
            return readText(a,"showType").localeCompare(readText(b,"showType")) || readDate(a) - readDate(b);
        }

        return readDate(a) - readDate(b);
    });

    cards.forEach(card=>board.appendChild(card));
}

function resetLocationFilter()
{
    clearSavedShowtimeFilters();

    ["country","state","district"].forEach(id=>{
        const select=document.getElementById(id);
        if(select)
        {
            selectAllOption(select);
        }
    });

    clearCurrentLocationFilter();

    ["showtimeSearch","dateFilter","sortShows"].forEach(id=>{
        const field=document.getElementById(id);
        if(field)
        {
            field.value="";
        }
    });

    const sortSelect=document.getElementById("sortShows");
    if(sortSelect)
    {
        sortSelect.value="upcoming";
    }

    document.querySelectorAll(".show-card").forEach(card=>{
        card.hidden=false;
    });

    loadCountries();
    updateLocationSummary();
    updateFilterEmptyState();
    sortShows();
}

async function clearAllShowtimeFilters()
{
    clearSavedShowtimeFilters();

    const showTypeSelect=document.getElementById("showTypeFilter");
    if(showTypeSelect)
    {
        showTypeSelect.value="All";
    }

    const currentType=new URLSearchParams(window.location.search).get("type") || "All";
    if(currentType !== "All")
    {
        window.location.href="/Home/ShowTime";
        return;
    }

    ["showtimeSearch","dateFilter"].forEach(id=>{
        const field=document.getElementById(id);
        if(field)
        {
            field.value="";
        }
    });

    const sortSelect=document.getElementById("sortShows");
    if(sortSelect)
    {
        sortSelect.value="upcoming";
    }

    ["country","state","district"].forEach(id=>{
        const select=document.getElementById(id);
        if(select)
        {
            selectAllOption(select);
        }
    });

    clearCurrentLocationFilter();
    await loadCountries();
    await detectCurrentLocation(true);

    if(!currentLocationFilter)
    {
        applyLocationFilter();
    }
}



