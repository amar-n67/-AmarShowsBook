<script>
function normalizeNewsText(value) {
    return (value || "")
        .toString()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();
}

function newsLocationMatches(card, country, state, city) {
    const cardCountry = normalizeNewsText(card.dataset.country);
    const cardState = normalizeNewsText(card.dataset.state);
    const cardCity = normalizeNewsText(card.dataset.city);
    const cardRegion = normalizeNewsText(card.dataset.region);

    const matchesCountry = !country ||
        cardCountry === country ||
        cardCountry === "world" ||
        cardCountry === "all" ||
        cardRegion.includes(country);

    const matchesState = !state ||
        cardState === state ||
        cardState === "all" ||
        cardRegion.includes(state);

    const matchesCity = !city ||
        cardCity === city ||
        cardCity === "all" ||
        cardRegion.includes(city);

    return matchesCountry && matchesState && matchesCity;
}

function getNewsFilters() {
    return {
        search: normalizeNewsText(document.getElementById("newsFilterSearch")?.value),
        country: normalizeNewsText(document.getElementById("newsCountry")?.value),
        language: normalizeNewsText(document.getElementById("newsLanguage")?.value),
        category: normalizeNewsText(document.getElementById("newsCategory")?.value)
    };
}

function filterNews() {
    const filters = getNewsFilters();

    document.querySelectorAll("[data-news-card]").forEach(card => {
        const haystack = [
            card.dataset.name,
            card.dataset.language,
            card.dataset.category,
            card.dataset.region,
            card.dataset.country,
            card.dataset.state,
            card.dataset.city,
            card.textContent
        ].map(normalizeNewsText).join(" ");

        const matchesSearch = !filters.search || haystack.includes(filters.search);
        const matchesLanguage = !filters.language || normalizeNewsText(card.dataset.language) === filters.language;
        const matchesCategory = !filters.category || normalizeNewsText(card.dataset.category) === filters.category;
        const matchesLocation = newsLocationMatches(card, filters.country, "", "");
        card.classList.toggle("news-hidden", !(matchesSearch && matchesLanguage && matchesCategory && matchesLocation));
    });

    const visibleChannels = Array.from(document.querySelectorAll(".news-channel"))
        .filter(card => !card.classList.contains("news-hidden"));
    const fallbackToAll = visibleChannels.length === 0;

    if (fallbackToAll) {
        document.querySelectorAll("[data-news-card]").forEach(card => card.classList.remove("news-hidden"));
    }

    document.querySelectorAll("[data-news-slot]").forEach(slot => {
        const haystack = [
            slot.dataset.channel,
            slot.dataset.type,
            slot.dataset.country,
            slot.dataset.state,
            slot.dataset.city,
            slot.textContent
        ].map(normalizeNewsText).join(" ");

        const matchesSearch = !filters.search || haystack.includes(filters.search);
        const matchesLocation = newsLocationMatches(slot, filters.country, "", "");
        slot.classList.toggle("news-hidden", !fallbackToAll && !(matchesSearch && matchesLocation));
    });

    setNewsStatus(fallbackToAll);
}

function setNewsStatus(fallbackToAll) {
    const status = document.getElementById("newsFilterStatus");
    if (!status) return;

    const visibleCount = Array.from(document.querySelectorAll(".news-channel"))
        .filter(card => !card.classList.contains("news-hidden")).length;

    status.textContent = fallbackToAll
        ? "Showing all news channels"
        : `Showing ${visibleCount} news channels`;
}

let currentNewsPlayerUrl = "";
let currentNewsPlayerType = "frame";
let currentNewsVolume = 70;
let currentNewsMuted = false;
let currentNewsCaptions = false;
let currentNewsSpeed = 1;
let currentNewsResolution = "auto";
let newsProgressTimer = 0;
let newsLiveStartedAt = 0;
let currentNewsPaused = false;
let newsChromeTimer = 0;
let newsChromeEventsBound = false;
let newsPlayerDrag = {
    active: false,
    moved: false,
    startX: 0,
    startY: 0,
    left: 0,
    top: 0
};

function setNewsPlayerLoading(isLoading) {
    const loader = document.getElementById("newsPlayerLoader");
    if (loader) {
        loader.classList.toggle("is-hidden", !isLoading);
    }
}

function syncNewsFullscreenButton() {
    const button = document.getElementById("newsFullscreenButton");
    if (!button) {
        return;
    }

    const isFullscreen = Boolean(document.fullscreenElement);
    button.textContent = isFullscreen ? "⤢" : "⛶";
    button.setAttribute("aria-label", isFullscreen ? "Exit fullscreen" : "Maximize player");
}

function syncNewsMiniButton() {
    const button = document.getElementById("newsMiniButton");
    const player = document.getElementById("newsPlayer");
    if (!button || !player) {
        return;
    }

    const isMini = player.classList.contains("is-mini");
    button.textContent = isMini ? "▣" : "▾";
    button.setAttribute("aria-label", isMini ? "Restore player" : "Minimize player");
}

function showNewsPlayerChrome() {
    const frameWrap = document.getElementById("newsPlayerFrameWrap");
    if (!frameWrap) {
        return;
    }

    frameWrap.classList.remove("is-chrome-hidden");
    window.clearTimeout(newsChromeTimer);
    newsChromeTimer = window.setTimeout(hideNewsPlayerChrome, 3000);
}

function hideNewsPlayerChrome() {
    const frameWrap = document.getElementById("newsPlayerFrameWrap");
    if (frameWrap && !document.activeElement?.closest(".news-player-controls")) {
        frameWrap.classList.add("is-chrome-hidden");
    }
}

function bindNewsPlayerChromeEvents() {
    if (newsChromeEventsBound) {
        return;
    }

    const frameWrap = document.getElementById("newsPlayerFrameWrap");
    if (!frameWrap) {
        return;
    }

    ["mousemove", "touchstart", "pointerdown", "focusin"].forEach(eventName => {
        frameWrap.addEventListener(eventName, showNewsPlayerChrome, { passive: true });
    });

    frameWrap.addEventListener("click", function (event) {
        if (event.target.closest(".news-player-controls") || newsPlayerDrag.moved) {
            newsPlayerDrag.moved = false;
            return;
        }

        toggleNewsPlayback();
        showNewsPlayerChrome();
    });

    document.addEventListener("fullscreenchange", function () {
        syncNewsFullscreenButton();
        showNewsPlayerChrome();
    });

    bindNewsMiniDragEvents();

    newsChromeEventsBound = true;
}

function bindNewsMiniDragEvents() {
    const player = document.getElementById("newsPlayer");
    if (!player) {
        return;
    }

    player.addEventListener("pointerdown", function (event) {
        if (!player.classList.contains("is-mini") || event.target.closest("button, input, select, a, .news-player-controls")) {
            return;
        }

        const rect = player.getBoundingClientRect();
        newsPlayerDrag = {
            active: true,
            moved: false,
            startX: event.clientX,
            startY: event.clientY,
            left: rect.left,
            top: rect.top
        };
        player.classList.add("is-dragging");
        player.setPointerCapture?.(event.pointerId);
    });

    player.addEventListener("pointermove", function (event) {
        if (!newsPlayerDrag.active) {
            return;
        }

        const dx = event.clientX - newsPlayerDrag.startX;
        const dy = event.clientY - newsPlayerDrag.startY;
        if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
            newsPlayerDrag.moved = true;
        }

        const rect = player.getBoundingClientRect();
        const nextLeft = Math.max(8, Math.min(window.innerWidth - rect.width - 8, newsPlayerDrag.left + dx));
        const nextTop = Math.max(8, Math.min(window.innerHeight - rect.height - 8, newsPlayerDrag.top + dy));
        player.style.left = `${nextLeft}px`;
        player.style.top = `${nextTop}px`;
        player.style.right = "auto";
        player.style.bottom = "auto";
    });

    ["pointerup", "pointercancel"].forEach(eventName => {
        player.addEventListener(eventName, function () {
            if (!newsPlayerDrag.active) {
                return;
            }

            newsPlayerDrag.active = false;
            player.classList.remove("is-dragging");
            window.setTimeout(function () {
                newsPlayerDrag.moved = false;
            }, 0);
        });
    });
}

function restoreNewsPlayerFromMini() {
    const player = document.getElementById("newsPlayer");
    if (!player) {
        return;
    }

    player.classList.remove("is-mini", "is-dragging");
    player.style.left = "";
    player.style.top = "";
    player.style.right = "";
    player.style.bottom = "";
    if (!player.hidden) {
        document.querySelector(".news-page")?.classList.add("is-player-open");
        document.getElementById("newsBoard")?.setAttribute("aria-hidden", "true");
    }
    syncNewsMiniButton();
    showNewsPlayerChrome();
    player.scrollIntoView({ behavior: "smooth", block: "start" });
}

function sendNewsFrameCommand(command, args = []) {
    const frame = document.getElementById("newsPlayerFrame");
    if (!frame || frame.hidden || !frame.contentWindow) {
        return;
    }

    frame.contentWindow.postMessage(JSON.stringify({
        event: "command",
        func: command,
        args
    }), "*");
}

function prepareNewsFrameUrl(url) {
    if (!url) {
        return "about:blank";
    }

    try {
        const playerUrl = new URL(url, window.location.origin);
        playerUrl.searchParams.set("enablejsapi", "1");
        playerUrl.searchParams.set("origin", window.location.origin);
        playerUrl.searchParams.set("controls", "0");
        playerUrl.searchParams.set("fs", "0");
        playerUrl.searchParams.set("disablekb", "1");
        playerUrl.searchParams.set("cc_load_policy", currentNewsCaptions ? "1" : "0");
        playerUrl.searchParams.set("cc_lang_pref", "en");
        playerUrl.searchParams.set("hl", "en");
        return playerUrl.toString();
    }
    catch {
        return url;
    }
}

function formatNewsTime(seconds) {
    if (!Number.isFinite(seconds) || seconds < 0) {
        return "LIVE";
    }

    const total = Math.floor(seconds);
    const minutes = Math.floor(total / 60);
    const remainingSeconds = total % 60;
    return `${minutes}:${String(remainingSeconds).padStart(2, "0")}`;
}

function updateNewsProgress() {
    const progress = document.getElementById("newsProgressRange");
    const label = document.getElementById("newsProgressLabel");
    const video = document.getElementById("newsPlayerVideo");

    if (!progress || !label) {
        return;
    }

    if (currentNewsPlayerType === "native" && video && Number.isFinite(video.duration) && video.duration > 0) {
        progress.disabled = false;
        progress.value = String(Math.min(100, Math.max(0, (video.currentTime / video.duration) * 100)));
        label.textContent = `${formatNewsTime(video.currentTime)} / ${formatNewsTime(video.duration)}`;
        label.classList.remove("is-live");
        return;
    }

    const elapsed = newsLiveStartedAt ? Math.max(0, (Date.now() - newsLiveStartedAt) / 1000) : 0;
    progress.disabled = true;
    progress.value = "100";
    label.textContent = `LIVE ${formatNewsTime(elapsed)}`;
    label.classList.add("is-live");
}

function startNewsProgressTimer() {
    window.clearInterval(newsProgressTimer);
    updateNewsProgress();
    newsProgressTimer = window.setInterval(updateNewsProgress, 1000);
}

function stopNewsProgressTimer() {
    window.clearInterval(newsProgressTimer);
    newsProgressTimer = 0;
}

function syncNewsPlayerControls() {
    const muteButton = document.getElementById("newsMuteButton");
    const captionButton = document.getElementById("newsCaptionButton");
    const volumeRange = document.getElementById("newsVolumeRange");
    const speedSelect = document.getElementById("newsSpeedSelect");
    const resolutionSelect = document.getElementById("newsResolutionSelect");
    const video = document.getElementById("newsPlayerVideo");

    if (volumeRange) {
        volumeRange.value = String(currentNewsVolume);
    }

    if (muteButton) {
        muteButton.textContent = currentNewsMuted || currentNewsVolume === 0 ? "🔇" : "🔊";
        muteButton.classList.toggle("is-active", !currentNewsMuted && currentNewsVolume > 0);
    }

    if (captionButton) {
        captionButton.classList.toggle("is-active", currentNewsCaptions);
    }

    if (speedSelect) {
        speedSelect.value = String(currentNewsSpeed);
    }

    if (resolutionSelect) {
        resolutionSelect.value = currentNewsResolution;
    }

    if (video) {
        video.volume = Math.max(0, Math.min(1, currentNewsVolume / 100));
        video.muted = currentNewsMuted || currentNewsVolume === 0;
        video.playbackRate = currentNewsSpeed;
    }

    if (currentNewsPlayerType === "frame") {
        sendNewsFrameCommand(currentNewsMuted || currentNewsVolume === 0 ? "mute" : "unMute");
        sendNewsFrameCommand("setVolume", [currentNewsVolume]);
        sendNewsFrameCommand("setPlaybackRate", [currentNewsSpeed]);
        sendNewsFrameCommand(currentNewsPaused ? "pauseVideo" : "playVideo");
        if (currentNewsResolution !== "auto") {
            sendNewsFrameCommand("setPlaybackQuality", [currentNewsResolution]);
        }
    }

    updateNewsProgress();
}

function resetNewsPlayerMedia() {
    const frame = document.getElementById("newsPlayerFrame");
    const video = document.getElementById("newsPlayerVideo");

    if (frame) {
        frame.hidden = true;
        frame.src = "about:blank";
    }

    if (video) {
        video.pause();
        video.hidden = true;
        video.removeAttribute("src");
        video.load();
    }

    stopNewsProgressTimer();
    currentNewsPaused = false;
    newsLiveStartedAt = 0;
}

async function resolveNewsLiveUrl(channelId) {
    try {
        const response = await fetch(`/Home/ResolveNewsLive?channelId=${encodeURIComponent(channelId)}`, {
            headers: {
                "Accept": "application/json",
                "X-Requested-With": "XMLHttpRequest"
            }
        });

        if (!response.ok) {
            return {
                success: false,
                message: "Could not resolve the live feed."
            };
        }

        const result = await response.json();
        return {
            success: Boolean(result.success),
            playerUrl: result.playerUrl || "",
            playerType: result.playerType || "frame",
            message: result.message || ""
        };
    }
    catch {
        return {
            success: false,
            message: "Could not resolve the live feed."
        };
    }
}

async function openNewsPlayer(button) {
    const page = document.querySelector(".news-page");
    const player = document.getElementById("newsPlayer");
    const board = document.getElementById("newsBoard");
    const frame = document.getElementById("newsPlayerFrame");
    const video = document.getElementById("newsPlayerVideo");
    const logo = document.getElementById("newsPlayerLogo");
    const name = document.getElementById("newsPlayerName");
    const meta = document.getElementById("newsPlayerMeta");
    const description = document.getElementById("newsPlayerDescription");
    const status = document.getElementById("newsPlayerStatus");

    if (!player || !frame || !button) {
        return;
    }

    const channelId = button.dataset.playerId || "";
    const keepMini = player.classList.contains("is-mini");

    if (logo) {
        logo.src = button.dataset.playerLogo || "";
        logo.alt = `${button.dataset.playerName || "News channel"} logo`;
    }

    if (name) {
        name.textContent = button.dataset.playerName || "News Live";
    }

    if (meta) {
        meta.textContent = [button.dataset.playerCategory, button.dataset.playerLanguage, button.dataset.playerRegion]
            .filter(Boolean)
            .join(" · ") || "Live channel";
    }

    if (description) {
        description.textContent = button.dataset.playerDescription || "Official live feed is playing inside this page.";
    }

    setNewsPlayerLoading(true);
    resetNewsPlayerMedia();
    bindNewsPlayerChromeEvents();
    showNewsPlayerChrome();
    player.hidden = false;

    if (keepMini) {
        page?.classList.remove("is-player-open");
        board?.removeAttribute("aria-hidden");
        player.classList.add("is-mini");
        syncNewsMiniButton();
    }
    else {
        page?.classList.add("is-player-open");
        board?.setAttribute("aria-hidden", "true");
        player.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    if (status) {
        status.textContent = "Finding live feed";
    }

    const resolved = await resolveNewsLiveUrl(channelId);
    currentNewsPlayerUrl = resolved.playerUrl || "";
    currentNewsPlayerType = resolved.playerType || "frame";
    currentNewsPaused = false;
    newsLiveStartedAt = Date.now();

    if (!resolved.success && !resolved.playerUrl) {
        setNewsPlayerLoading(false);
        if (status) {
            status.textContent = resolved.message || "Live feed unavailable";
        }
        return;
    }

    if (status) {
        status.textContent = resolved.success ? "Live" : (resolved.message || "Trying fallback");
    }

    if (currentNewsPlayerType === "native" && video) {
        frame.hidden = true;
        video.hidden = false;
        video.muted = currentNewsMuted || currentNewsVolume === 0;
        video.volume = Math.max(0, Math.min(1, currentNewsVolume / 100));
        video.playbackRate = currentNewsSpeed;
        video.autoplay = true;
        video.src = currentNewsPlayerUrl;
        Array.from(video.textTracks || []).forEach(track => {
            track.mode = currentNewsCaptions ? "showing" : "disabled";
        });
        video.onloadeddata = function () {
            setNewsPlayerLoading(false);
            startNewsProgressTimer();
        };
        video.onerror = function () {
            setNewsPlayerLoading(false);
            if (status) {
                status.textContent = "Live feed unavailable";
            }
        };
        video.play().catch(function () {
            currentNewsPaused = true;
            syncNewsPlayerControls();
            if (status) {
                status.textContent = "Tap reload to start";
            }
        });
    }
    else {
        video?.setAttribute("hidden", "");
        frame.hidden = false;
        frame.onload = function () {
            setNewsPlayerLoading(false);
            syncNewsPlayerControls();
            startNewsProgressTimer();
        };
        frame.src = prepareNewsFrameUrl(currentNewsPlayerUrl);
    }

    syncNewsPlayerControls();

    window.setTimeout(function () {
        setNewsPlayerLoading(false);
    }, 4500);
}

function closeNewsPlayer() {
    const page = document.querySelector(".news-page");
    const player = document.getElementById("newsPlayer");
    const board = document.getElementById("newsBoard");
    resetNewsPlayerMedia();
    window.clearTimeout(newsChromeTimer);
    restoreNewsPlayerFromMini();
    currentNewsPlayerUrl = "";
    currentNewsPlayerType = "frame";
    currentNewsPaused = false;
    page?.classList.remove("is-player-open");
    player?.setAttribute("hidden", "");
    board?.removeAttribute("aria-hidden");
}

function toggleNewsPlayback() {
    const video = document.getElementById("newsPlayerVideo");
    currentNewsPaused = !currentNewsPaused;

    if (currentNewsPlayerType === "native" && video) {
        if (currentNewsPaused) {
            video.pause();
        }
        else {
            video.play().catch(function () {
                currentNewsPaused = true;
            }).finally(syncNewsPlayerControls);
        }
    }
    else {
        sendNewsFrameCommand(currentNewsPaused ? "pauseVideo" : "playVideo");
    }

    syncNewsPlayerControls();
}

function reloadNewsPlayer() {
    const frame = document.getElementById("newsPlayerFrame");
    const video = document.getElementById("newsPlayerVideo");
    if (!frame || !currentNewsPlayerUrl) {
        return;
    }

    setNewsPlayerLoading(true);
    if (currentNewsPlayerType === "native" && video) {
        video.currentTime = 0;
        video.play().finally(function () {
            setNewsPlayerLoading(false);
            startNewsProgressTimer();
        });
    }
    else {
        frame.src = "about:blank";
        window.setTimeout(function () {
            frame.src = prepareNewsFrameUrl(currentNewsPlayerUrl);
        }, 80);
    }
}

function seekNewsPlayer(value) {
    const video = document.getElementById("newsPlayerVideo");
    const parsed = Number(value);

    if (currentNewsPlayerType !== "native" || !video || !Number.isFinite(video.duration) || video.duration <= 0 || !Number.isFinite(parsed)) {
        updateNewsProgress();
        return;
    }

    video.currentTime = Math.max(0, Math.min(video.duration, (parsed / 100) * video.duration));
    updateNewsProgress();
}

function toggleNewsCaptions() {
    const video = document.getElementById("newsPlayerVideo");
    currentNewsCaptions = !currentNewsCaptions;

    if (currentNewsPlayerType === "native" && video) {
        Array.from(video.textTracks || []).forEach(track => {
            track.mode = currentNewsCaptions ? "showing" : "disabled";
        });
    }
    else if (currentNewsPlayerUrl) {
        const frame = document.getElementById("newsPlayerFrame");
        sendNewsFrameCommand(currentNewsCaptions ? "loadModule" : "unloadModule", ["captions"]);
        if (currentNewsCaptions) {
            sendNewsFrameCommand("setOption", ["captions", "track", { languageCode: "en" }]);
            sendNewsFrameCommand("setOption", ["captions", "fontSize", 1]);
        }
        if (frame) {
            frame.src = prepareNewsFrameUrl(currentNewsPlayerUrl);
        }
    }

    syncNewsPlayerControls();
}

function changeNewsResolution(value) {
    currentNewsResolution = value || "auto";
    if (currentNewsPlayerType === "frame" && currentNewsResolution !== "auto") {
        sendNewsFrameCommand("setPlaybackQuality", [currentNewsResolution]);
    }
    syncNewsPlayerControls();
}

function changeNewsSpeed(value) {
    const parsed = Number(value);
    currentNewsSpeed = Number.isFinite(parsed) ? Math.max(0.25, Math.min(2, parsed)) : 1;
    syncNewsPlayerControls();
}

function toggleNewsMute() {
    currentNewsMuted = !currentNewsMuted;
    if (!currentNewsMuted && currentNewsVolume === 0) {
        currentNewsVolume = 70;
    }
    syncNewsPlayerControls();
}

function changeNewsVolume(value) {
    const parsed = Number(value);
    currentNewsVolume = Number.isFinite(parsed) ? Math.max(0, Math.min(100, parsed)) : 70;
    currentNewsMuted = currentNewsVolume === 0;
    syncNewsPlayerControls();
}

function fullscreenNewsPlayer() {
    const frameWrap = document.getElementById("newsPlayerFrameWrap");
    restoreNewsPlayerFromMini();
    if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen();
        return;
    }

    if (!frameWrap || !frameWrap.requestFullscreen) {
        return;
    }

    frameWrap.requestFullscreen();
    showNewsPlayerChrome();
}

function minimizeNewsPlayer() {
    if (document.fullscreenElement && document.exitFullscreen) {
        document.exitFullscreen();
    }

    const player = document.getElementById("newsPlayer");
    if (!player) {
        return;
    }

    if (player.classList.contains("is-mini")) {
        restoreNewsPlayerFromMini();
        return;
    }

    player.classList.add("is-mini");
    player.style.left = "";
    player.style.top = "";
    player.style.right = "18px";
    player.style.bottom = "18px";
    document.querySelector(".news-page")?.classList.remove("is-player-open");
    document.getElementById("newsBoard")?.removeAttribute("aria-hidden");
    syncNewsMiniButton();
    showNewsPlayerChrome();
}

function resetNewsFilters() {
    const search = document.getElementById("newsFilterSearch");
    const country = document.getElementById("newsCountry");
    const language = document.getElementById("newsLanguage");
    const category = document.getElementById("newsCategory");
    if (search) search.value = "";
    if (country) country.value = "";
    if (language) language.value = "";
    if (category) category.value = "";
    filterNews();
}

function prepareHomeResetAfterNews() {
    try {
        localStorage.removeItem("showtimeFilters");
        sessionStorage.setItem("showtimeResetAfterNews", "true");
        sessionStorage.removeItem("showtimeCurrentLocationInitialized");
    }
    catch {
    }
}

function goNewsHome() {
    resetNewsFilters();
    prepareHomeResetAfterNews();
    window.location.href = "/Home/ShowTime";
}

document.addEventListener("DOMContentLoaded", function () {
    prepareHomeResetAfterNews();
    filterNews();
});
</script>
