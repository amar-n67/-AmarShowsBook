@model AmarShowsBook.Models.ViewModels.NewsViewModel
@{
    ViewData["Title"] = "News";
    var nextSlot = Model.Slots.FirstOrDefault();
    var featured = Model.Channels.Take(6).ToList();
}

<section class="news-page">
    <div class="news-shell">
        <header class="news-hero">
            <div>
                <span class="news-kicker">Live Desk</span>
                <h1>News</h1>
                <p>Live channels, regional desks, and upcoming bulletins in one place.</p>
            </div>
            <div class="news-summary">
                <span>Channels</span>
                <strong>@Model.Channels.Count active</strong>
                <small>@(nextSlot == null ? "Schedule ready" : $"Next {nextSlot.StartsAt.ToLocalTime():dd MMM, hh:mm tt}")</small>
            </div>
        </header>

        <div class="news-controls" aria-label="News filters">
            <label class="news-search-field">
                <span>Search</span>
                <input id="newsFilterSearch" type="search" placeholder="Channel, language, location" oninput="filterNews()" />
            </label>
            <label>
                <span>Country</span>
                <select id="newsCountry" onchange="filterNews()">
                    <option value="">All Country</option>
                    @foreach (var country in Model.Countries)
                    {
                        <option value="@country">@country</option>
                    }
                </select>
            </label>
            <label>
                <span>Language</span>
                <select id="newsLanguage" onchange="filterNews()">
                    <option value="">All Language</option>
                    @foreach (var language in Model.Languages)
                    {
                        <option value="@language">@language</option>
                    }
                </select>
            </label>
            <label>
                <span>Category</span>
                <select id="newsCategory" onchange="filterNews()">
                    <option value="">All Category</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </label>
            <button type="button" class="news-reset-button" onclick="resetNewsFilters()" aria-label="Reset news filters">
                <span aria-hidden="true">↺</span>
                <span>Reset</span>
            </button>
            <button type="button" class="news-home-button" onclick="goNewsHome()" aria-label="Go home and reset filters">
                <span aria-hidden="true">←</span>
                <span>Home</span>
            </button>
        </div>
        <p class="news-filter-status" id="newsFilterStatus" aria-live="polite">Showing all news channels</p>

            <div class="news-feature-grid">
                @foreach (var channel in featured)
                {
                    <article class="news-feature" data-news-card data-name="@channel.ChannelName" data-language="@channel.Language" data-category="@channel.Category" data-region="@channel.Region" data-country="@channel.Country" data-state="@channel.State" data-city="@channel.City">
                        <img src="@channel.LogoUrl" alt="@channel.ChannelName logo" loading="lazy" />
                        <div>
                            <span>@channel.Category</span>
                            <h2>@channel.ChannelName</h2>
                            <p>@channel.Language · @channel.Region</p>
                        </div>
                        <button type="button"
                                class="news-play-button"
                                data-player-name="@channel.ChannelName"
                                data-player-id="@channel.Id"
                                data-player-logo="@channel.LogoUrl"
                                data-player-language="@channel.Language"
                                data-player-category="@channel.Category"
                                data-player-region="@channel.Region"
                                data-player-description="@channel.Description"
                                onclick="openNewsPlayer(this)"
                                aria-label="Play @channel.ChannelName live">▶</button>
                    </article>
                }
            </div>

            <section class="news-player" id="newsPlayer" aria-label="Live news player" hidden>
                <div class="news-player-head">
                    <div class="news-player-title">
                        <img id="newsPlayerLogo" src="" alt="" />
                        <div>
                            <span id="newsPlayerMeta">Live channel</span>
                            <h2 id="newsPlayerName">News Live</h2>
                        </div>
                    </div>
                    <div class="news-player-tools">
                        <button type="button" onclick="reloadNewsPlayer()" aria-label="Reload player">↻</button>
                        <button type="button" class="news-player-close" onclick="closeNewsPlayer()" aria-label="Close popup player">×</button>
                    </div>
                </div>
                <div class="news-player-frame-wrap" id="newsPlayerFrameWrap">
                    <iframe id="newsPlayerFrame"
                            title="Embedded live feed"
                            src="about:blank"
                            allow="autoplay; encrypted-media; fullscreen"
                            tabindex="-1"
                            allowfullscreen></iframe>
                    <video id="newsPlayerVideo" playsinline preload="metadata" hidden></video>
                    <div class="news-player-frame-mask news-player-frame-mask-top" aria-hidden="true"></div>
                    <div class="news-player-frame-mask news-player-frame-mask-bottom" aria-hidden="true"></div>
                    <div class="news-player-controls" aria-label="Player controls">
                        <input type="range" id="newsProgressRange" class="news-progress-range" min="0" max="100" value="100" aria-label="Playback progress" oninput="seekNewsPlayer(this.value)" />
                        <span id="newsProgressLabel" class="news-progress-label is-live">LIVE 0:00</span>
                        <button type="button" id="newsCaptionButton" onclick="toggleNewsCaptions()" aria-label="Toggle captions">CC</button>
                        <button type="button" id="newsMuteButton" onclick="toggleNewsMute()" aria-label="Toggle volume">🔇</button>
                        <input type="range" id="newsVolumeRange" min="0" max="100" value="70" aria-label="Volume" oninput="changeNewsVolume(this.value)" />
                        <select id="newsResolutionSelect" aria-label="Resolution" onchange="changeNewsResolution(this.value)">
                            <option value="auto">Auto</option>
                            <option value="hd1080">1080p</option>
                            <option value="hd720">720p</option>
                            <option value="large">480p</option>
                            <option value="medium">360p</option>
                        </select>
                        <select id="newsSpeedSelect" aria-label="Speed" onchange="changeNewsSpeed(this.value)">
                            <option value="0.75">0.75x</option>
                            <option value="1" selected>1x</option>
                            <option value="1.25">1.25x</option>
                            <option value="1.5">1.5x</option>
                            <option value="2">2x</option>
                        </select>
                        <button type="button" id="newsFullscreenButton" onclick="fullscreenNewsPlayer()" aria-label="Maximize player">⛶</button>
                        <button type="button" id="newsMiniButton" onclick="minimizeNewsPlayer()" aria-label="Minimize player">▾</button>
                    </div>
                    <div class="news-player-loader" id="newsPlayerLoader">
                        <strong>Loading live channel</strong>
                        <span>Official feed opens here on this page.</span>
                    </div>
                </div>
                <div class="news-player-footer">
                    <p id="newsPlayerDescription">Select a channel to start live playback.</p>
                    <span id="newsPlayerStatus">Ready</span>
                </div>
            </section>

            <div class="news-board" id="newsBoard">
                <section class="news-channel-list" aria-label="News channels">
                    @foreach (var channel in Model.Channels)
                    {
                        <article class="news-channel" data-news-card data-name="@channel.ChannelName" data-language="@channel.Language" data-category="@channel.Category" data-region="@channel.Region" data-country="@channel.Country" data-state="@channel.State" data-city="@channel.City">
                            <img src="@channel.LogoUrl" alt="@channel.ChannelName logo" loading="lazy" />
                            <div class="news-channel-main">
                                <div class="news-channel-title">
                                    <h2>@channel.ChannelName</h2>
                                    <span>@channel.Language</span>
                                </div>
                                <p>@channel.Description</p>
                                <div class="news-tags">
                                    <span>@channel.Category</span>
                                    <span>@channel.Region</span>
                                    <span>@channel.Country</span>
                                    @if (!string.Equals(channel.State, "All", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span>@channel.State</span>
                                    }
                                </div>
                            </div>
                            <div class="news-actions">
                                <button type="button"
                                        class="news-play-button"
                                        data-player-name="@channel.ChannelName"
                                        data-player-id="@channel.Id"
                                        data-player-logo="@channel.LogoUrl"
                                        data-player-language="@channel.Language"
                                        data-player-category="@channel.Category"
                                        data-player-region="@channel.Region"
                                        data-player-description="@channel.Description"
                                        onclick="openNewsPlayer(this)"
                                        aria-label="Play @channel.ChannelName live">▶</button>
                                <a href="@channel.WebsiteUrl" target="_blank" rel="noopener" aria-label="Open @channel.ChannelName website">↗</a>
                            </div>
                        </article>
                    }
                </section>

                <aside class="news-schedule" aria-label="Upcoming news schedule">
                    <div class="news-schedule-head">
                        <span>Upcoming</span>
                        <strong>@Model.Slots.Count slots</strong>
                    </div>
                    @foreach (var slot in Model.Slots)
                    {
                        <article class="news-slot" data-news-slot data-channel="@slot.Channel?.ChannelName" data-type="@slot.ProgramType" data-country="@slot.Channel?.Country" data-state="@slot.Channel?.State" data-city="@slot.Channel?.City">
                            <time datetime="@slot.StartsAt.ToString("O")">@slot.StartsAt.ToLocalTime().ToString("dd MMM · hh:mm tt")</time>
                            <h3>@slot.ProgramTitle</h3>
                            <p>@slot.ProgramType</p>
                        </article>
                    }
                </aside>
            </div>
    </div>
</section>

<style>
.news-page {
    color: var(--app-page-text);
    padding-bottom: 40px;
}

.news-shell {
    max-width: 1320px;
    margin: 0 auto;
}

.news-hero {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    min-height: 220px;
    padding: 28px;
    border-radius: 8px;
    margin-bottom: 18px;
    background:
        repeating-linear-gradient(90deg, rgba(35,31,32,0.08) 0 10px, transparent 10px 24px),
        linear-gradient(135deg, rgba(255,242,199,0.94), rgba(245,178,196,0.86), rgba(146,229,221,0.86));
    color: #231f20;
    box-shadow: 0 22px 64px rgba(35,31,32,0.22);
}

.news-kicker,
.news-schedule-head span,
.news-feature span {
    color: #231f20;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.news-hero h1 {
    margin: 8px 0;
    color: #231f20;
    font-size: clamp(2.5rem, 6vw, 5.2rem);
    font-weight: 900;
    letter-spacing: 0;
}

.news-hero p {
    max-width: 640px;
    color: #34303a;
    font-size: 1.05rem;
    margin: 0;
}

.news-summary {
    min-width: 190px;
    padding: 14px;
    border: 1px dashed rgba(35,31,32,0.44);
    border-radius: 8px;
    background: rgba(255,255,255,0.38);
    text-align: right;
}

.news-summary span,
.news-summary small {
    color: var(--app-muted);
    font-weight: 800;
}

.news-summary > span {
    display: block;
    color: #34303a;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.news-summary strong {
    display: block;
    color: #231f20;
    font-size: 1.3rem;
    font-weight: 900;
}

.news-controls button,
.news-actions a,
.news-feature a,
.news-play-button,
.news-player button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: 1px solid color-mix(in srgb, var(--app-primary) 22%, var(--app-input-border));
    background: color-mix(in srgb, var(--app-card) 84%, #ffffff);
    color: var(--app-card-text);
    text-decoration: none;
    min-width: 44px;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    font-weight: 900;
    box-shadow: 0 8px 20px rgba(15,23,42,.08);
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease, border-color .2s ease;
}

.news-controls {
    display: grid;
    grid-template-columns: repeat(4, minmax(180px, 1fr)) repeat(2, minmax(100px, 0.7fr));
    align-items: end;
    gap: 16px;
    margin: 0 0 18px;
    padding: 22px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    box-shadow: 0 12px 28px rgba(0,0,0,0.1);
}

.news-controls label {
    display: grid;
    min-width: 0;
    gap: 7px;
    color: var(--app-muted);
    font-size: 0.82rem;
    font-weight: 800;
}

.news-controls label > span {
    display: block;
    line-height: 1.1;
}

.news-controls input,
.news-controls select {
    width: 100%;
    min-width: 0;
    height: 42px;
    min-height: 42px;
    max-height: 42px;
    box-sizing: border-box;
    border: 1px solid var(--app-input-border);
    border-radius: 999px;
    background: var(--app-input);
    color: var(--app-input-text);
    padding: 0 14px;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 42px;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
}

.news-controls select {
    padding-right: 34px;
    background-image:
        linear-gradient(45deg, transparent 50%, currentColor 50%),
        linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
        calc(100% - 18px) 18px,
        calc(100% - 13px) 18px;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
}

.news-controls input[type="search"]::-webkit-search-decoration,
.news-controls input[type="search"]::-webkit-search-cancel-button,
.news-controls input[type="search"]::-webkit-search-results-button,
.news-controls input[type="search"]::-webkit-search-results-decoration {
    display: none;
}

.news-reset-button,
.news-home-button {
    width: 100%;
    height: 42px;
    min-height: 42px;
    max-height: 42px;
    padding: 0 14px;
    white-space: nowrap;
}

.news-reset-button:hover,
.news-reset-button:focus-visible,
.news-home-button:hover,
.news-home-button:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--app-primary) 62%, var(--app-input-border));
    background: var(--app-primary);
    color: #fff;
    box-shadow: 0 14px 28px color-mix(in srgb, var(--app-primary) 28%, transparent);
    outline: none;
}

.news-filter-status {
    color: var(--app-muted);
    font-weight: 700;
    margin: -6px 0 16px;
}

.news-page.is-player-open .news-controls,
.news-page.is-player-open .news-filter-status,
.news-page.is-player-open .news-feature-grid,
.news-page.is-player-open .news-board {
    display: none !important;
}

.news-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
}

.news-feature,
.news-channel,
.news-slot {
    background: color-mix(in srgb, var(--app-card) 88%, transparent);
    border: 1px solid color-mix(in srgb, var(--app-page-text) 12%, transparent);
    border-radius: 8px;
    color: var(--app-card-text);
    box-shadow: 0 14px 34px color-mix(in srgb, var(--app-page-text) 8%, transparent);
}

.news-feature {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 12px;
    padding: 14px;
}

.news-feature img,
.news-channel img {
    width: 58px;
    height: 58px;
    border-radius: 8px;
    object-fit: contain;
    background: var(--app-input);
    border: 1px solid color-mix(in srgb, var(--app-page-text) 10%, transparent);
}

.news-feature h2,
.news-channel h2,
.news-slot h3 {
    margin: 0;
    letter-spacing: 0;
}

.news-feature h2,
.news-channel h2 {
    font-size: 1rem;
    line-height: 1.2;
}

.news-feature p,
.news-channel p,
.news-slot p {
    margin: 4px 0 0;
    color: var(--app-muted);
}

.news-board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    gap: 16px;
    align-items: start;
}

.news-channel-list {
    display: grid;
    gap: 10px;
}

.news-channel {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px;
}

.news-channel-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.news-channel-title span,
.news-tags span {
    border: 1px solid color-mix(in srgb, var(--app-accent-strong) 22%, transparent);
    color: var(--app-accent-strong);
    background: color-mix(in srgb, var(--app-accent-strong) 12%, var(--app-card));
    border-radius: 999px;
    padding: 4px 8px;
    font-size: 0.78rem;
    font-weight: 800;
    white-space: nowrap;
}

.news-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
}

.news-actions {
    display: flex;
    gap: 8px;
}

.news-actions a {
    background: color-mix(in srgb, var(--app-card) 84%, #ffffff);
    color: var(--app-card-text);
}

.news-actions a:first-child,
.news-feature .news-play-button {
    width: 44px;
    height: 44px;
    padding: 0;
}

.news-player {
    display: grid;
    gap: 12px;
    margin: 0 0 16px;
    padding: 14px;
    border: 1px solid var(--app-input-border);
    border-radius: 8px;
    background: var(--app-card);
    box-shadow: 0 18px 42px color-mix(in srgb, var(--app-page-text) 12%, transparent);
}

.news-player[hidden] {
    display: none !important;
}

.news-player.is-mini {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 1080;
    width: min(520px, calc(100vw - 28px));
    margin: 0;
    padding: 8px;
    gap: 8px;
    cursor: grab;
}

.news-player.is-mini.is-dragging {
    cursor: grabbing;
    user-select: none;
}

.news-player.is-mini .news-player-head {
    grid-template-columns: minmax(0, 1fr) auto;
}

.news-player.is-mini .news-player-footer {
    display: none;
}

.news-player.is-mini .news-player-title img {
    width: 32px;
    height: 32px;
}

.news-player.is-mini .news-player-title h2 {
    font-size: 0.92rem;
}

.news-player.is-mini .news-player-title span {
    font-size: 0.68rem;
}

.news-player.is-mini .news-player-frame-wrap {
    display: grid;
    grid-template-rows: auto auto;
    aspect-ratio: auto;
    min-height: 0;
    overflow: hidden;
}

.news-player.is-mini .news-player-frame-wrap.is-chrome-hidden {
    cursor: default;
}

.news-player.is-mini .news-player-frame-wrap.is-chrome-hidden .news-player-controls {
    opacity: 1;
    transform: none;
    pointer-events: auto;
}

.news-player.is-mini .news-player-frame-wrap iframe,
.news-player.is-mini .news-player-frame-wrap video {
    position: relative;
    inset: auto;
    grid-row: 1;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    min-height: 0;
    transform: none;
}

.news-player.is-mini .news-player-frame-mask-top {
    height: 42px;
}

.news-player.is-mini .news-player-frame-mask-bottom {
    display: none;
}

.news-player.is-mini .news-player-controls {
    position: relative;
    left: auto;
    right: auto;
    bottom: auto;
    grid-row: 2;
    gap: 6px;
    padding: 6px;
    border-width: 1px 0 0;
    border-radius: 0;
    background: #101010;
    backdrop-filter: none;
    cursor: default;
}

.news-player.is-mini .news-player-controls button {
    width: 34px;
    height: 32px;
    min-width: 34px;
}

.news-player.is-mini .news-progress-range {
    flex: 1 1 145px;
    min-width: 120px;
}

.news-player.is-mini .news-progress-label {
    min-width: 74px;
    font-size: 0.7rem;
}

.news-player.is-mini .news-player-controls input[type="range"]:not(.news-progress-range) {
    width: 92px;
}

.news-player.is-mini .news-player-controls select {
    min-width: 74px;
    font-size: 0.74rem;
}

.news-player-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
}

.news-player-title {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 10px;
}

.news-player-title img {
    width: 46px;
    height: 46px;
    border-radius: 8px;
    object-fit: contain;
    background: var(--app-input);
    border: 1px solid var(--app-input-border);
}

.news-player-title span {
    display: block;
    color: var(--app-muted);
    font-size: 0.78rem;
    font-weight: 850;
}

.news-player-title h2 {
    margin: 2px 0 0;
    font-size: 1.18rem;
    line-height: 1.15;
    letter-spacing: 0;
}

.news-player-tools {
    display: flex;
    justify-self: end;
    gap: 8px;
}

.news-player-tools button {
    width: 42px;
    height: 42px;
    padding: 0;
}

.news-player-close {
    display: none;
}

.news-player.is-mini .news-player-close {
    display: inline-flex;
}

.news-player-frame-wrap {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 280px;
    border: 1px solid color-mix(in srgb, var(--app-page-text) 16%, transparent);
    border-radius: 8px;
    background: #050505;
}

.news-player-frame-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #050505;
    pointer-events: none;
    transform: scale(1.045);
    transform-origin: center;
}

.news-player-frame-wrap video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #050505;
    object-fit: contain;
}

.news-player-frame-wrap iframe[hidden],
.news-player-frame-wrap video[hidden] {
    display: none;
}

.news-player-frame-mask {
    position: absolute;
    z-index: 2;
    pointer-events: auto;
}

.news-player-frame-mask-top {
    top: 0;
    left: 0;
    width: 100%;
    height: 86px;
    background: linear-gradient(180deg, rgba(5,5,5,0.96), rgba(5,5,5,0.55) 66%, transparent);
}

.news-player-frame-mask-bottom {
    right: 0;
    bottom: 0;
    width: min(180px, 30%);
    height: 54px;
    background:
        linear-gradient(0deg, rgba(5,5,5,0.96), rgba(5,5,5,0.72) 64%, transparent),
        linear-gradient(270deg, rgba(5,5,5,0.96), rgba(5,5,5,0.64) 58%, transparent);
}

.news-player-frame-wrap.is-chrome-hidden {
    cursor: none;
}

