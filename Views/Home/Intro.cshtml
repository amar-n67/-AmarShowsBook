@model AmarShowsBook.Models.ViewModels.DeveloperVM
@{
    Layout = null;
    var developerName = string.IsNullOrWhiteSpace(Model?.FullName) ? "Amar ChaudharY" : Model.FullName.Trim();
    var developerEmail = string.IsNullOrWhiteSpace(Model?.DeveloperEmail) ? "example@gmail.com" : Model.DeveloperEmail.Trim();
    var developerPhone = string.IsNullOrWhiteSpace(Model?.Phone) ? "+91 9651698863" : Model.Phone.Trim();
    var developerWhatsApp = string.IsNullOrWhiteSpace(Model?.DeveloperWhatsAppPhone) ? developerPhone : Model.DeveloperWhatsAppPhone.Trim();
    var emailSubject = string.IsNullOrWhiteSpace(Model?.DeveloperEmailSubject) ? "showTime Developer Contact" : Model.DeveloperEmailSubject.Trim();
    var emailBody = (string.IsNullOrWhiteSpace(Model?.DeveloperEmailText)
        ? $"Hi {developerName}, I would like to connect with you about showTime."
        : Model.DeveloperEmailText.Trim())
        .Replace("{user}", "Visitor")
        .Replace("showTime Team", developerName)
        .Replace("Hi Amar,", $"Hi {developerName},");
    var whatsappMessage = (string.IsNullOrWhiteSpace(Model?.TopWhatsAppText)
        ? $"Hi {developerName}, I visited showTime and would like to connect with you."
        : Model.TopWhatsAppText.Trim())
        .Replace("{user}", "Visitor")
        .Replace("showTime Team", developerName)
        .Replace("Hi Amar,", $"Hi {developerName},");
    var telNumber = CleanTelNumber(developerPhone);
    var whatsAppNumber = CleanWhatsAppNumber(developerWhatsApp);
    var emailUrl = $"mailto:{developerEmail}?subject={Uri.EscapeDataString(emailSubject)}&body={Uri.EscapeDataString(emailBody)}";
    var whatsAppUrl = $"https://wa.me/{whatsAppNumber}?text={Uri.EscapeDataString(whatsappMessage)}";
    var socialLinks = new[]
    {
        new { Label = "GitHub", Kind = "github", Url = NormalizeExternalUrl(Model?.GitHubUrl) },
        new { Label = "LinkedIn", Kind = "linkedin", Url = NormalizeExternalUrl(Model?.LinkedInUrl) },
        new { Label = "X", Kind = "twitter", Url = NormalizeExternalUrl(Model?.TwitterUrl) },
        new { Label = "Instagram", Kind = "instagram", Url = NormalizeExternalUrl(Model?.InstagramUrl) },
        new { Label = "Facebook", Kind = "facebook", Url = NormalizeExternalUrl(Model?.FacebookUrl) },
        new { Label = "YouTube", Kind = "youtube", Url = NormalizeExternalUrl(Model?.YoutubeUrl) },
        new { Label = "Website", Kind = "website", Url = NormalizeExternalUrl(Model?.WebsiteUrl) }
    };
}
@functions {
    private static string NormalizeExternalUrl(string? value)
    {
        var trimmed = (value ?? "").Trim();

        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return "";
        }

        if (trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("tel:", StringComparison.OrdinalIgnoreCase))
        {
            return trimmed;
        }

        return $"https://{trimmed.TrimStart('/')}";
    }

