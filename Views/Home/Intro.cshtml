@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>showTime Intro</title>
    <style>
        :root {
            --ink: #172033;
            --muted: #5a667a;
            --paper: #fffdf8;
            --line: rgba(23, 32, 51, 0.14);
            --coral: #e45d48;
            --teal: #168f98;
            --sun: #f0bd4f;
            --blue: #3758d6;
            --plum: #8a3c6b;
            --shadow: 0 24px 70px rgba(23, 32, 51, 0.18);
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            margin: 0;
            color: var(--ink);
            font-family: "Segoe UI", Arial, sans-serif;
            background:
                radial-gradient(circle at 12% 8%, rgba(240, 189, 79, 0.28), transparent 26%),
                radial-gradient(circle at 88% 10%, rgba(22, 143, 152, 0.20), transparent 24%),
                linear-gradient(120deg, #f7fbf8 0%, #fff5df 46%, #f5d5ca 100%);
            overflow-x: hidden;
        }

        body::before {
            position: fixed;
            inset: 0;
            z-index: -2;
            content: "";
            background-image:
                linear-gradient(rgba(23, 32, 51, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(23, 32, 51, 0.05) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.86), transparent 86%);
        }

        body::after {
            position: fixed;
            inset: auto -8vw -24vh -8vw;
            z-index: -1;
            height: 48vh;
            content: "";
            background: linear-gradient(90deg, rgba(55, 88, 214, 0.13), rgba(22, 143, 152, 0.18), rgba(228, 93, 72, 0.14));
            filter: blur(18px);
            transform: skewY(-4deg);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .intro-shell {
            position: relative;
            width: min(1180px, calc(100% - 32px));
            margin: 0 auto;
            padding: 28px 0 40px;
        }

        .topbar {
            position: sticky;
            top: 14px;
            z-index: 20;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 10px 12px;
            border: 1px solid rgba(255, 255, 255, 0.72);
            border-radius: 999px;
            background: rgba(255, 253, 248, 0.76);
            box-shadow: 0 16px 40px rgba(23, 32, 51, 0.10);
            backdrop-filter: blur(18px);
        }

        .brand-mark {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            font-weight: 800;
            letter-spacing: 0;
        }

        .brand-mark img {
            width: 44px;
            height: 44px;
            object-fit: contain;
            filter: drop-shadow(0 8px 16px rgba(23, 32, 51, 0.15));
        }

        .brand-mark span {
            overflow: hidden;
            font-size: clamp(1rem, 2vw, 1.14rem);
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .top-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 10px 16px;
            border: 1px solid transparent;
            border-radius: 999px;
            font-size: 0.95rem;
            font-weight: 800;
            line-height: 1;
            transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        }

        .btn:hover,
        .btn:focus-visible {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(23, 32, 51, 0.14);
            outline: none;
        }

        .btn-primary {
            color: #fffefa;
            background: linear-gradient(135deg, var(--teal), var(--blue));
        }

        .btn-soft {
            color: var(--ink);
            border-color: var(--line);
            background: rgba(255, 255, 255, 0.72);
        }

        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
            gap: clamp(28px, 5vw, 68px);
            align-items: center;
            min-height: calc(100vh - 102px);
            padding: clamp(34px, 7vw, 86px) 0 48px;
        }

        .hero-copy {
            animation: copyIn 0.9s ease both;
        }

        .kicker {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            color: #20364a;
            font-size: 0.78rem;
            font-weight: 900;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .kicker::before {
            width: 38px;
            height: 3px;
            border-radius: 999px;
            content: "";
            background: linear-gradient(90deg, var(--coral), var(--sun), var(--teal));
        }

        h1 {
            max-width: 760px;
            margin: 0;
            color: #101826;
            font-size: clamp(2.7rem, 8vw, 6.7rem);
            line-height: 0.95;
            letter-spacing: 0;
        }

        .lead {
            max-width: 640px;
            margin: 24px 0 0;
            color: #445066;
            font-size: clamp(1rem, 2.1vw, 1.28rem);
            line-height: 1.65;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .mini-metrics {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            max-width: 560px;
            margin-top: 34px;
        }

        .metric {
            padding: 14px;
            border: 1px solid rgba(255, 255, 255, 0.78);
            border-radius: 16px;
            background: rgba(255, 253, 248, 0.66);
            box-shadow: 0 14px 30px rgba(23, 32, 51, 0.08);
            animation: riseIn 0.75s ease both;
        }

        .metric:nth-child(2) {
            animation-delay: 0.08s;
        }

        .metric:nth-child(3) {
            animation-delay: 0.16s;
        }

        .metric strong {
            display: block;
            color: var(--teal);
            font-size: clamp(1.35rem, 4vw, 2.2rem);
            line-height: 1;
        }

        .metric span {
            display: block;
            margin-top: 7px;
            color: var(--muted);
            font-size: 0.83rem;
            font-weight: 700;
        }

        .stage-wrap {
            position: relative;
            min-height: 550px;
            perspective: 1200px;
        }

        .stage-glow {
            position: absolute;
            inset: 8% 5%;
            border-radius: 50%;
            background: conic-gradient(from 90deg, rgba(228, 93, 72, 0.18), rgba(22, 143, 152, 0.24), rgba(240, 189, 79, 0.22), rgba(138, 60, 107, 0.16), rgba(228, 93, 72, 0.18));
            filter: blur(18px);
            animation: slowSpin 16s linear infinite;
        }

        .logo-theater {
            position: relative;
            z-index: 2;
            display: grid;
            place-items: center;
            width: min(92vw, 440px);
            aspect-ratio: 1;
            margin: 44px auto 0;
            border: 1px solid rgba(255, 255, 255, 0.76);
            border-radius: 42px;
            background:
                linear-gradient(150deg, rgba(255, 253, 248, 0.88), rgba(255, 255, 255, 0.55)),
                linear-gradient(135deg, rgba(55, 88, 214, 0.10), rgba(22, 143, 152, 0.16));
            box-shadow: var(--shadow);
            transform: rotateX(8deg) rotateY(-8deg);
            animation: floatPanel 5.8s ease-in-out infinite;
            overflow: hidden;
        }

        .logo-theater::before,
        .logo-theater::after {
            position: absolute;
            content: "";
            border-radius: 999px;
            pointer-events: none;
        }

        .logo-theater::before {
            inset: 34px;
            border: 1px dashed rgba(22, 143, 152, 0.34);
            animation: slowSpin 22s linear infinite reverse;
        }

        .logo-theater::after {
            width: 78%;
            height: 78%;
            background: radial-gradient(circle, rgba(240, 189, 79, 0.20), transparent 62%);
            animation: logoPulse 2.8s ease-in-out infinite;
        }

        .logo-core {
            position: relative;
            z-index: 3;
            width: min(66%, 276px);
            height: min(66%, 276px);
            object-fit: contain;
            filter: drop-shadow(0 18px 26px rgba(23, 32, 51, 0.18));
            animation: logoPop 1.1s cubic-bezier(0.17, 0.84, 0.44, 1) both;
        }

        .orbit {
            position: absolute;
            z-index: 4;
            display: grid;
            place-items: center;
            width: 76px;
            height: 76px;
            border: 1px solid rgba(255, 255, 255, 0.72);
            border-radius: 24px;
            color: #fffefa;
            font-size: 0.78rem;
            font-weight: 900;
            text-align: center;
            background: #20364a;
            box-shadow: 0 18px 30px rgba(23, 32, 51, 0.18);
            animation: floatChip 4.5s ease-in-out infinite;
        }

        .orbit.one {
            top: 38px;
            right: 16px;
            background: var(--coral);
        }

        .orbit.two {
            bottom: 66px;
            left: 10px;
            background: var(--teal);
            animation-delay: -1.1s;
        }

        .orbit.three {
            right: 36px;
            bottom: 18px;
            background: var(--plum);
            animation-delay: -2.2s;
        }

        .cinema-rail {
            position: absolute;
            left: 50%;
            bottom: 18px;
            z-index: 1;
            display: flex;
            gap: 10px;
            width: min(520px, 90vw);
            transform: translateX(-50%);
            opacity: 0.82;
        }

        .cinema-rail span {
            flex: 1;
            height: 76px;
            border-radius: 18px;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.24)),
                linear-gradient(135deg, rgba(228, 93, 72, 0.24), rgba(22, 143, 152, 0.22));
            transform-origin: bottom;
            animation: railWave 2.6s ease-in-out infinite;
        }

        .cinema-rail span:nth-child(2) {
            animation-delay: 0.1s;
        }

        .cinema-rail span:nth-child(3) {
            animation-delay: 0.2s;
        }

        .cinema-rail span:nth-child(4) {
            animation-delay: 0.3s;
        }

        .section {
            padding: 42px 0;
        }

        .section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 18px;
        }

        .section-head h2 {
            margin: 0;
            color: #142033;
            font-size: clamp(1.65rem, 4vw, 3rem);
            line-height: 1.05;
            letter-spacing: 0;
        }

        .section-head p {
            max-width: 520px;
            margin: 0;
            color: var(--muted);
            line-height: 1.55;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
        }

        .feature,
        .profile-panel,
        .timeline-step {
            border: 1px solid rgba(255, 255, 255, 0.78);
            background: rgba(255, 253, 248, 0.72);
            box-shadow: 0 16px 44px rgba(23, 32, 51, 0.10);
            backdrop-filter: blur(16px);
        }

        .feature {
            min-height: 202px;
            padding: 18px;
            border-radius: 18px;
            animation: revealUp both;
            animation-timeline: view();
            animation-range: entry 0% cover 28%;
        }

        .feature-icon {
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            margin-bottom: 16px;
            border-radius: 14px;
            color: #fffefa;
            font-size: 0.76rem;
            font-weight: 900;
            background: var(--blue);
        }

        .feature:nth-child(2) .feature-icon {
            background: var(--teal);
        }

        .feature:nth-child(3) .feature-icon {
            background: var(--coral);
        }

        .feature:nth-child(4) .feature-icon {
            color: #192235;
            background: var(--sun);
        }

        .feature h3 {
            margin: 0 0 10px;
            color: #172033;
            font-size: 1.05rem;
        }

        .feature p {
            margin: 0;
            color: var(--muted);
            font-size: 0.94rem;
            line-height: 1.55;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
            gap: 16px;
            align-items: stretch;
        }

        .profile-panel {
            position: relative;
            overflow: hidden;
            padding: clamp(22px, 4vw, 34px);
            border-radius: 24px;
        }

        .profile-panel::before {
            position: absolute;
            inset: -34% auto auto -16%;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            content: "";
            background: radial-gradient(circle, rgba(22, 143, 152, 0.20), transparent 68%);
            animation: drift 8s ease-in-out infinite;
        }

        .developer-card {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: 18px;
            align-items: center;
            position: relative;
        }

        .developer-card img {
            width: clamp(86px, 14vw, 126px);
            height: clamp(86px, 14vw, 126px);
            object-fit: contain;
            padding: 10px;
            border: 1px solid rgba(23, 32, 51, 0.10);
            border-radius: 28px;
            background: rgba(255, 255, 255, 0.68);
            box-shadow: 0 18px 32px rgba(23, 32, 51, 0.10);
        }

        .developer-card h3 {
            margin: 0 0 6px;
            font-size: clamp(1.4rem, 4vw, 2.2rem);
        }

        .developer-card p {
            margin: 0;
            color: var(--muted);
            line-height: 1.6;
        }

        .profile-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 20px;
        }

        .profile-tags span {
            padding: 9px 11px;
            border: 1px solid var(--line);
            border-radius: 999px;
            color: #20364a;
            font-size: 0.82rem;
            font-weight: 800;
            background: rgba(255, 255, 255, 0.62);
        }

        .contact-list {
            display: grid;
            gap: 10px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .contact-list li {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px;
            border: 1px solid var(--line);
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.58);
        }

        .contact-list span {
            color: var(--muted);
            font-size: 0.82rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .contact-list strong {
            color: #172033;
            font-size: 0.96rem;
            text-align: right;
            word-break: break-word;
        }

        .timeline {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            counter-reset: flow;
        }

        .timeline-step {
            position: relative;
            min-height: 178px;
            padding: 18px;
            border-radius: 18px;
            overflow: hidden;
        }

        .timeline-step::before {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            margin-bottom: 16px;
            border-radius: 50%;
            counter-increment: flow;
            content: counter(flow);
            color: #fffefa;
            font-weight: 900;
            background: #20364a;
        }

        .timeline-step::after {
            position: absolute;
            left: 18px;
            right: 18px;
            bottom: 0;
            height: 4px;
            content: "";
            background: linear-gradient(90deg, var(--coral), var(--sun), var(--teal), var(--blue));
            transform: scaleX(0);
            transform-origin: left;
            animation: stepLine 1.2s ease forwards;
            animation-delay: calc(var(--step, 1) * 0.22s);
        }

        .timeline-step h3 {
            margin: 0 0 8px;
            color: #172033;
            font-size: 1.02rem;
        }

        .timeline-step p {
            margin: 0;
            color: var(--muted);
            font-size: 0.92rem;
            line-height: 1.5;
        }

        .final-cta {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 18px;
            align-items: center;
            margin: 42px 0 4px;
            padding: clamp(24px, 5vw, 38px);
            border: 1px solid rgba(255, 255, 255, 0.74);
            border-radius: 26px;
            background:
                linear-gradient(135deg, rgba(32, 54, 74, 0.94), rgba(22, 143, 152, 0.86)),
                #20364a;
            box-shadow: var(--shadow);
            color: #fffefa;
            overflow: hidden;
        }

        .final-cta h2 {
            margin: 0 0 10px;
            font-size: clamp(1.55rem, 4vw, 2.7rem);
        }

        .final-cta p {
            max-width: 650px;
            margin: 0;
            color: rgba(255, 255, 255, 0.78);
            line-height: 1.6;
        }

        .final-cta .btn-soft {
            color: #172033;
            background: #fffefa;
        }

        .progress-line {
            position: fixed;
            left: 0;
            top: 0;
            z-index: 50;
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.45);
        }

        .progress-line span {
            display: block;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, var(--coral), var(--sun), var(--teal), var(--blue));
            transform: scaleX(0);
            transform-origin: left;
            animation: introProgress 6.4s ease forwards;
        }

        .motion-dots {
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            overflow: hidden;
        }

        .motion-dots span {
            position: absolute;
            display: block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: rgba(23, 32, 51, 0.18);
            animation: dotFloat 13s linear infinite;
        }

        .motion-dots span:nth-child(1) {
            left: 8%;
            animation-duration: 12s;
        }

        .motion-dots span:nth-child(2) {
            left: 28%;
            animation-duration: 16s;
            animation-delay: -4s;
            background: rgba(228, 93, 72, 0.22);
        }

        .motion-dots span:nth-child(3) {
            left: 52%;
            animation-duration: 14s;
            animation-delay: -7s;
            background: rgba(22, 143, 152, 0.22);
        }

        .motion-dots span:nth-child(4) {
            left: 74%;
            animation-duration: 18s;
            animation-delay: -2s;
            background: rgba(55, 88, 214, 0.20);
        }

        .motion-dots span:nth-child(5) {
            left: 91%;
            animation-duration: 15s;
            animation-delay: -9s;
            background: rgba(240, 189, 79, 0.30);
        }

        @@keyframes copyIn {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes riseIn {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes floatPanel {
            0%,
            100% {
                transform: rotateX(8deg) rotateY(-8deg) translateY(0);
            }

            50% {
                transform: rotateX(3deg) rotateY(7deg) translateY(-14px);
            }
        }

        @@keyframes slowSpin {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes logoPulse {
            0%,
            100% {
                transform: scale(0.96);
                opacity: 0.72;
            }

            50% {
                transform: scale(1.08);
                opacity: 1;
            }
        }

        @@keyframes logoPop {
            from {
                opacity: 0;
                transform: scale(0.72) rotate(-7deg);
            }

            to {
                opacity: 1;
                transform: scale(1) rotate(0);
            }
        }

        @@keyframes floatChip {
            0%,
            100% {
                transform: translateY(0) rotate(-2deg);
            }

            50% {
                transform: translateY(-14px) rotate(4deg);
            }
        }

        @@keyframes railWave {
            0%,
            100% {
                transform: scaleY(0.68);
            }

            50% {
                transform: scaleY(1);
            }
        }

        @@keyframes revealUp {
            from {
                opacity: 0;
                transform: translateY(26px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes drift {
            0%,
            100% {
                transform: translate3d(0, 0, 0);
            }

            50% {
                transform: translate3d(42px, 24px, 0);
            }
        }

        @@keyframes stepLine {
            to {
                transform: scaleX(1);
            }
        }

        @@keyframes introProgress {
            to {
                transform: scaleX(1);
            }
        }

        @@keyframes dotFloat {
            from {
                transform: translateY(108vh) scale(0.7);
                opacity: 0;
            }

            18% {
                opacity: 1;
            }

            to {
                transform: translateY(-12vh) scale(1.2);
                opacity: 0;
            }
        }

        @@media (max-width: 980px) {
            .hero,
            .profile-grid,
            .final-cta {
                grid-template-columns: 1fr;
            }

            .hero {
                min-height: auto;
            }

            .stage-wrap {
                min-height: 480px;
            }

            .feature-grid,
            .timeline {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .final-cta {
                justify-items: start;
            }
        }

        @@media (max-width: 680px) {
            .intro-shell {
                width: min(100% - 22px, 1180px);
                padding-top: 12px;
            }

            .topbar {
                align-items: stretch;
                border-radius: 24px;
                flex-direction: column;
            }

            .top-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                width: 100%;
            }

            .btn {
                width: 100%;
                min-height: 40px;
                padding: 10px 12px;
                font-size: 0.84rem;
            }

            .hero {
                padding-top: 30px;
            }

            .mini-metrics,
            .feature-grid,
            .timeline {
                grid-template-columns: 1fr;
            }

            .stage-wrap {
                min-height: 400px;
            }

            .logo-theater {
                border-radius: 28px;
                margin-top: 20px;
            }

            .orbit {
                width: 60px;
                height: 60px;
                border-radius: 18px;
                font-size: 0.67rem;
            }

            .section-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .developer-card {
                grid-template-columns: 1fr;
            }

            .contact-list li {
