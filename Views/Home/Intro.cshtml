            "linkedin" => "<span class='social-icon' aria-hidden='true'><svg viewBox='0 0 24 24'><path d='M4.98 3.5A2.5 2.5 0 1 0 5 8.5a2.5 2.5 0 0 0-.02-5ZM3 9.75h4v10.5H3V9.75Zm6.25 0h3.83v1.44h.06c.53-.95 1.83-1.72 3.44-1.72 3.67 0 4.42 2.22 4.42 5.32v5.46h-4v-4.84c0-1.28-.03-2.62-1.67-2.62-1.68 0-2.08 1.26-2.08 2.62v4.84h-4V9.75Z'/></svg></span>",
            "twitter" => "<span class='social-icon' aria-hidden='true'><svg viewBox='0 0 24 24'><path d='M14.7 10.4 22.2 2h-1.78l-6.51 7.28L8.7 2H2.7l7.86 11-7.86 9h1.78l6.87-7.82L16.84 22h5.99l-8.13-11.6Zm-2.43 2.75-.8-1.12L5.13 3.34h2.72l5.12 7.14.8 1.12 6.64 9.17H17.7l-5.43-7.62Z'/></svg></span>",
            "instagram" => "<span class='social-icon' aria-hidden='true'><svg viewBox='0 0 24 24'><path d='M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm4.2 3.25A4.75 4.75 0 1 1 12 16.75a4.75 4.75 0 0 1 0-9.5Zm0 2A2.75 2.75 0 1 0 12 14.75a2.75 2.75 0 0 0 0-5.5ZM17.2 6.6a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z'/></svg></span>",
            "facebook" => "<span class='social-icon' aria-hidden='true'><svg viewBox='0 0 24 24'><path d='M14.4 8H17V4h-3.05C10.8 4 9 5.88 9 8.7V11H6v4h3v7h4v-7h3.2l.6-4H13V8.92c0-.58.28-.92 1.4-.92Z'/></svg></span>",
            "youtube" => "<span class='social-icon' aria-hidden='true'><svg viewBox='0 0 24 24'><path d='M21.6 7.2a3.02 3.02 0 0 0-2.12-2.14C17.6 4.55 12 4.55 12 4.55s-5.6 0-7.48.51A3.02 3.02 0 0 0 2.4 7.2 31.33 31.33 0 0 0 1.9 12a31.33 31.33 0 0 0 .5 4.8 3.02 3.02 0 0 0 2.12 2.14c1.88.51 7.48.51 7.48.51s5.6 0 7.48-.51a3.02 3.02 0 0 0 2.12-2.14 31.33 31.33 0 0 0 .5-4.8 31.33 31.33 0 0 0-.5-4.8ZM10 15.5v-7l6 3.5-6 3.5Z'/></svg></span>",
            _ => "<span class='social-icon' aria-hidden='true'><svg viewBox='0 0 24 24'><path d='M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 9h-3.1a15.7 15.7 0 0 0-1.05-5.02A8.04 8.04 0 0 1 18.9 11ZM12 4.05c.7 1.02 1.47 3.25 1.7 6.95h-3.4c.23-3.7 1-5.93 1.7-6.95ZM4.26 13h3.93c.1 1.86.43 3.6.95 5.02A8.04 8.04 0 0 1 4.26 13Zm3.93-2H4.26a8.04 8.04 0 0 1 4.88-5.02A15.7 15.7 0 0 0 8.19 11ZM12 19.95c-.7-1.02-1.47-3.25-1.7-6.95h3.4c-.23 3.7-1 5.93-1.7 6.95Zm2.86-1.93c.52-1.42.85-3.16.95-5.02h3.93a8.04 8.04 0 0 1-4.88 5.02Z'/></svg></span>"
        };

        return new Microsoft.AspNetCore.Html.HtmlString(icon);
    }

    private static string CleanWhatsAppNumber(string value)
    {
        var digits = new string((value ?? "").Where(char.IsDigit).ToArray());
        return string.IsNullOrWhiteSpace(digits) ? "919651698863" : digits;
    }

    private static string CleanTelNumber(string value)
    {
        var trimmed = (value ?? "").Trim();
        var digits = new string(trimmed.Where(char.IsDigit).ToArray());

        if (string.IsNullOrWhiteSpace(digits))
        {
            return "+919651698863";
        }

        return trimmed.StartsWith("+", StringComparison.OrdinalIgnoreCase) ? $"+{digits}" : digits;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>showTime Intro</title>
    <link id="introTabIcon" rel="icon" type="image/png" href="/images/brand/showtime-login-logo-tight.png" />
    <style>
        :root {
            --ink: #172033;
            --muted: #5a667a;
            --paper: #fffdf8;
            --line: rgba(23, 32, 51, 0.14);
            --coral: #e45d48;
            --teal: #168f98;
            --sun: #f0bd4f;
            --blue: #3758d6;
            --plum: #8a3c6b;
            --shadow: 0 24px 70px rgba(23, 32, 51, 0.18);
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            margin: 0;
            color: var(--ink);
            font-family: "Segoe UI", Arial, sans-serif;
            background:
                radial-gradient(circle at 12% 8%, rgba(240, 189, 79, 0.28), transparent 26%),
                radial-gradient(circle at 88% 10%, rgba(22, 143, 152, 0.20), transparent 24%),
                linear-gradient(120deg, #f7fbf8 0%, #fff5df 46%, #f5d5ca 100%);
            overflow-x: hidden;
        }

        body::before {
            position: fixed;
            inset: 0;
            z-index: -2;
            content: "";
            background-image:
                linear-gradient(rgba(23, 32, 51, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(23, 32, 51, 0.05) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.86), transparent 86%);
        }

        body::after {
            position: fixed;
            inset: auto -8vw -24vh -8vw;
            z-index: -1;
            height: 48vh;
            content: "";
            background: linear-gradient(90deg, rgba(55, 88, 214, 0.13), rgba(22, 143, 152, 0.18), rgba(228, 93, 72, 0.14));
            filter: blur(18px);
            transform: skewY(-4deg);
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .intro-shell {
            position: relative;
            width: min(1180px, calc(100% - 32px));
            margin: 0 auto;
            padding: 28px 0 40px;
        }

        .topbar {
            position: sticky;
            top: 14px;
            z-index: 20;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 10px 12px;
            border: 1px solid rgba(255, 255, 255, 0.72);
            border-radius: 999px;
            background: rgba(255, 253, 248, 0.76);
            box-shadow: 0 16px 40px rgba(23, 32, 51, 0.10);
            backdrop-filter: blur(18px);
        }

        .brand-mark {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
            font-weight: 800;
            letter-spacing: 0;
        }

        .brand-mark img {
            width: 44px;
            height: 44px;
            object-fit: contain;
            filter: drop-shadow(0 8px 16px rgba(23, 32, 51, 0.15));
        }

        .brand-mark span {
            overflow: hidden;
            font-size: clamp(1rem, 2vw, 1.14rem);
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        .top-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 10px 16px;
            border: 1px solid transparent;
            border-radius: 999px;
            font-size: 0.95rem;
            font-weight: 800;
            line-height: 1;
            transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
        }

        .btn:hover,
        .btn:focus-visible {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(23, 32, 51, 0.14);
            outline: none;
        }

        .btn-primary {
            color: #fffefa;
            background: linear-gradient(135deg, var(--teal), var(--blue));
        }

        .btn-soft {
            color: var(--ink);
            border-color: var(--line);
            background: rgba(255, 255, 255, 0.72);
        }

        .motion-surface {
            position: relative;
            overflow: hidden;
            transform-style: preserve-3d;
            transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
        }

        .motion-surface > :not(.cursor-glow) {
            position: relative;
            z-index: 1;
        }

        .cursor-glow {
            position: absolute;
            left: var(--pointer-x, 50%);
            top: var(--pointer-y, 50%);
            z-index: 0;
            width: 190px;
            height: 190px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.84) 0%, rgba(240, 189, 79, 0.28) 34%, transparent 68%);
            pointer-events: none;
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.7);
            transition: opacity 0.22s ease, transform 0.22s ease;
        }

        .motion-surface:hover .cursor-glow,
        .motion-surface:focus-within .cursor-glow {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }

        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1.08fr) minmax(300px, 0.92fr);
            gap: clamp(28px, 5vw, 68px);
            align-items: center;
            min-height: calc(100vh - 102px);
            padding: clamp(34px, 7vw, 86px) 0 48px;
        }

        .hero-copy {
            animation: copyIn 0.9s ease both;
        }

        .kicker {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
            color: #20364a;
            font-size: 0.78rem;
            font-weight: 900;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .kicker::before {
            width: 38px;
            height: 3px;
            border-radius: 999px;
            content: "";
            background: linear-gradient(90deg, var(--coral), var(--sun), var(--teal));
        }

        h1 {
            max-width: 760px;
            margin: 0;
            color: #101826;
            font-size: clamp(2.7rem, 8vw, 6.7rem);
            line-height: 0.95;
            letter-spacing: 0;
        }

        .lead {
            max-width: 640px;
            margin: 24px 0 0;
            color: #445066;
            font-size: clamp(1rem, 2.1vw, 1.28rem);
            line-height: 1.65;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 30px;
        }

        .ad-strip {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            max-width: 660px;
            margin-top: 18px;
        }

        .ad-strip span {
            position: relative;
            overflow: hidden;
            padding: 8px 12px;
            border: 1px solid rgba(255, 255, 255, 0.82);
            border-radius: 999px;
            color: #20364a;
            font-size: 0.8rem;
            font-weight: 900;
            background: rgba(255, 255, 255, 0.62);
            box-shadow: 0 12px 24px rgba(23, 32, 51, 0.08);
            animation: adPop 0.7s ease both, adBreathe 3.8s ease-in-out infinite;
        }

        .ad-strip span:nth-child(2) {
            animation-delay: 0.08s, 0.5s;
        }

        .ad-strip span:nth-child(3) {
            animation-delay: 0.16s, 1s;
        }

        .ad-strip span:nth-child(4) {
            animation-delay: 0.24s, 1.5s;
        }

        .mini-metrics {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            max-width: 560px;
            margin-top: 34px;
        }

        .metric {
            padding: 14px;
            border: 1px solid rgba(255, 255, 255, 0.78);
            border-radius: 16px;
            background: rgba(255, 253, 248, 0.66);
            box-shadow: 0 14px 30px rgba(23, 32, 51, 0.08);
            animation: riseIn 0.75s ease both;
        }

        .metric:nth-child(2) {
            animation-delay: 0.08s;
        }

        .metric:nth-child(3) {
            animation-delay: 0.16s;
        }

        .metric strong {
            display: block;
            color: var(--teal);
            font-size: clamp(1.35rem, 4vw, 2.2rem);
            line-height: 1;
        }

        .metric span {
            display: block;
            margin-top: 7px;
            color: var(--muted);
            font-size: 0.83rem;
            font-weight: 700;
        }

        .stage-wrap {
            position: relative;
            min-height: 550px;
            perspective: 1200px;
        }

        .stage-glow {
            position: absolute;
            inset: 8% 5%;
            border-radius: 50%;
            background: conic-gradient(from 90deg, rgba(228, 93, 72, 0.18), rgba(22, 143, 152, 0.24), rgba(240, 189, 79, 0.22), rgba(138, 60, 107, 0.16), rgba(228, 93, 72, 0.18));
            filter: blur(18px);
            animation: slowSpin 16s linear infinite;
        }

        .logo-theater {
            position: relative;
            z-index: 2;
            display: grid;
            place-items: center;
            width: min(92vw, 440px);
            aspect-ratio: 1;
            margin: 44px auto 0;
            border: 1px solid rgba(255, 255, 255, 0.76);
            border-radius: 42px;
            background:
                linear-gradient(150deg, rgba(255, 253, 248, 0.88), rgba(255, 255, 255, 0.55)),
                linear-gradient(135deg, rgba(55, 88, 214, 0.10), rgba(22, 143, 152, 0.16));
            box-shadow: var(--shadow);
            transform: rotateX(8deg) rotateY(-8deg);
            animation: floatPanel 5.8s ease-in-out infinite;
            overflow: hidden;
        }

        .logo-theater::before,
        .logo-theater::after {
            position: absolute;
            content: "";
            border-radius: 999px;
            pointer-events: none;
        }

        .logo-theater::before {
            inset: 34px;
            border: 1px dashed rgba(22, 143, 152, 0.34);
            animation: slowSpin 22s linear infinite reverse;
        }

        .logo-theater::after {
            width: 78%;
            height: 78%;
            background: radial-gradient(circle, rgba(240, 189, 79, 0.20), transparent 62%);
            animation: logoPulse 2.8s ease-in-out infinite;
        }

        .logo-core {
            position: relative;
            z-index: 3;
            width: min(66%, 276px);
            height: min(66%, 276px);
            object-fit: contain;
            filter: drop-shadow(0 18px 26px rgba(23, 32, 51, 0.18));
            animation: logoPop 1.1s cubic-bezier(0.17, 0.84, 0.44, 1) both;
        }

        .orbit {
            position: absolute;
            z-index: 4;
            display: grid;
            place-items: center;
            width: 76px;
            height: 76px;
            border: 1px solid rgba(255, 255, 255, 0.72);
            border-radius: 24px;
            color: #fffefa;
            font-size: 0.78rem;
            font-weight: 900;
            text-align: center;
            background: #20364a;
            box-shadow: 0 18px 30px rgba(23, 32, 51, 0.18);
            animation: floatChip 4.5s ease-in-out infinite;
        }

        .orbit.one {
            top: 38px;
            right: 16px;
            background: var(--coral);
        }

        .orbit.two {
            bottom: 66px;
            left: 10px;
            background: var(--teal);
            animation-delay: -1.1s;
        }

        .orbit.three {
            right: 36px;
            bottom: 18px;
            background: var(--plum);
            animation-delay: -2.2s;
        }

        .cinema-rail {
            position: absolute;
            left: 50%;
            bottom: 18px;
            z-index: 1;
            display: flex;
            gap: 10px;
            width: min(520px, 90vw);
            transform: translateX(-50%);
            opacity: 0.82;
        }

        .cinema-rail span {
            flex: 1;
            height: 76px;
            border-radius: 18px;
            background:
                linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.24)),
                linear-gradient(135deg, rgba(228, 93, 72, 0.24), rgba(22, 143, 152, 0.22));
            transform-origin: bottom;
            animation: railWave 2.6s ease-in-out infinite;
        }

        .cinema-rail span:nth-child(2) {
            animation-delay: 0.1s;
        }

        .cinema-rail span:nth-child(3) {
            animation-delay: 0.2s;
        }

        .cinema-rail span:nth-child(4) {
            animation-delay: 0.3s;
        }

        .section {
            padding: 42px 0;
        }

        .section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 18px;
        }

        .section-head h2 {
            margin: 0;
            color: #142033;
            font-size: clamp(1.65rem, 4vw, 3rem);
            line-height: 1.05;
            letter-spacing: 0;
        }

        .section-head p {
            max-width: 520px;
            margin: 0;
            color: var(--muted);
            line-height: 1.55;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
        }

        .feature,
        .profile-panel,
        .timeline-step {
            border: 1px solid rgba(255, 255, 255, 0.78);
            background: rgba(255, 253, 248, 0.72);
            box-shadow: 0 16px 44px rgba(23, 32, 51, 0.10);
            backdrop-filter: blur(16px);
        }

        .feature {
            min-height: 202px;
            padding: 18px;
            border-radius: 18px;
            animation: revealUp both;
            animation-timeline: view();
            animation-range: entry 0% cover 28%;
        }

        .feature-icon {
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            margin-bottom: 16px;
            border-radius: 14px;
            color: #fffefa;
            font-size: 0.76rem;
            font-weight: 900;
            background: var(--blue);
        }

        .feature:nth-child(2) .feature-icon {
            background: var(--teal);
        }

        .feature:nth-child(3) .feature-icon {
            background: var(--coral);
        }

        .feature:nth-child(4) .feature-icon {
            color: #192235;
            background: var(--sun);
        }

        .feature h3 {
            margin: 0 0 10px;
            color: #172033;
            font-size: 1.05rem;
        }

        .feature p {
            margin: 0;
            color: var(--muted);
            font-size: 0.94rem;
            line-height: 1.55;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
            gap: 16px;
            align-items: stretch;
        }

        .profile-panel {
            position: relative;
            overflow: hidden;
            padding: clamp(22px, 4vw, 34px);
            border-radius: 24px;
        }

        .profile-panel::before {
            position: absolute;
            inset: -34% auto auto -16%;
            width: 360px;
            height: 360px;
            border-radius: 50%;
            content: "";
            background: radial-gradient(circle, rgba(22, 143, 152, 0.20), transparent 68%);
            animation: drift 8s ease-in-out infinite;
        }

        .developer-card {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            gap: 18px;
            align-items: center;
            position: relative;
        }

        .developer-card img {
            width: clamp(86px, 14vw, 126px);
            height: clamp(86px, 14vw, 126px);
            object-fit: contain;
            padding: 10px;
            border: 1px solid rgba(23, 32, 51, 0.10);
            border-radius: 28px;
            background: rgba(255, 255, 255, 0.68);
            box-shadow: 0 18px 32px rgba(23, 32, 51, 0.10);
        }

        .developer-card h3 {
            margin: 0 0 6px;
            font-size: clamp(1.4rem, 4vw, 2.2rem);
        }

        .developer-name {
            display: inline-flex;
            flex-wrap: wrap;
            gap: 0.02em;
            color: transparent;
            background: linear-gradient(90deg, #20364a, var(--teal), var(--coral), var(--blue), #20364a);
            background-size: 260% auto;
            -webkit-background-clip: text;
            background-clip: text;
            filter: drop-shadow(0 10px 18px rgba(23, 32, 51, 0.16));
            animation: nameGradient 4.4s linear infinite;
        }

        .developer-name span {
            display: inline-block;
            min-width: 0.28em;
            animation: nameLetter 2.2s ease-in-out infinite;
            animation-delay: calc(var(--letter-index, 0) * 0.045s);
        }

        .developer-name .name-space {
            min-width: 0.34em;
        }

        .developer-card p {
            margin: 0;
            color: var(--muted);
            line-height: 1.6;
        }

        .profile-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 20px;
        }

        .profile-tags span {
            padding: 9px 11px;
            border: 1px solid var(--line);
            border-radius: 999px;
            color: #20364a;
            font-size: 0.82rem;
            font-weight: 800;
            background: rgba(255, 255, 255, 0.62);
        }

        .contact-grid {
            position: relative;
            z-index: 1;
            display: grid;
            gap: 12px;
        }

        .contact-card {
            position: relative;
            display: grid;
            grid-template-columns: 56px minmax(0, 1fr) auto;
            gap: 14px;
            align-items: center;
            min-height: 86px;
            padding: 14px;
            border: 1px solid var(--line);
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.62);
            box-shadow: 0 14px 30px rgba(23, 32, 51, 0.08);
            overflow: hidden;
            animation: contactEnter 0.74s ease both;
        }

        .contact-card:nth-child(2) {
            animation-delay: 0.1s;
        }

        .contact-card:nth-child(3) {
            animation-delay: 0.2s;
        }

        .contact-card::before {
            position: absolute;
            inset: 0;
            content: "";
            background: linear-gradient(110deg, transparent 0%, rgba(255, 255, 255, 0.74) 46%, transparent 68%);
            transform: translateX(-115%);
            animation: contactSweep 4.8s ease-in-out infinite;
        }

        .contact-card:hover,
        .contact-card:focus-visible {
            transform: translateY(-3px);
            box-shadow: 0 18px 38px rgba(23, 32, 51, 0.14);
            outline: none;
        }

        .contact-icon {
            position: relative;
            display: grid;
            place-items: center;
            width: 56px;
            height: 56px;
            border-radius: 18px;
            color: #fffefa;
            background: var(--blue);
            box-shadow: 0 14px 24px rgba(55, 88, 214, 0.22);
            animation: iconFloat 3.2s ease-in-out infinite;
        }

        .contact-icon::after {
            position: absolute;
            inset: -6px;
            border: 1px solid currentColor;
            border-radius: 22px;
            content: "";
            opacity: 0.24;
            animation: contactPulse 2.4s ease-in-out infinite;
        }

        .contact-icon svg {
            width: 28px;
            height: 28px;
            fill: none;
            stroke: currentColor;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-width: 2.1;
        }

        .contact-icon.whatsapp {
            background: #128c7e;
            box-shadow: 0 14px 24px rgba(18, 140, 126, 0.24);
            animation-delay: -0.6s;
        }

        .contact-icon.whatsapp svg {
            fill: currentColor;
            stroke: none;
        }

        .contact-icon.phone {
            background: var(--coral);
            box-shadow: 0 14px 24px rgba(228, 93, 72, 0.22);
            animation-delay: -1.2s;
        }

        .contact-copy {
            position: relative;
            min-width: 0;
        }

        .contact-copy span {
            display: block;
            color: var(--muted);
            font-size: 0.76rem;
            font-weight: 900;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .contact-copy strong {
            display: block;
            margin-top: 5px;
            color: #172033;
            font-size: 0.98rem;
            line-height: 1.25;
            overflow-wrap: anywhere;
        }

        .contact-arrow {
            position: relative;
            display: grid;
            place-items: center;
            width: 34px;
            height: 34px;
            border-radius: 999px;
            color: #172033;
            font-weight: 900;
            background: rgba(240, 189, 79, 0.36);
        }

        .profile-link {
            position: relative;
            z-index: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 42px;
            margin-top: 14px;
            border: 1px solid var(--line);
            border-radius: 999px;
            color: #20364a;
            font-weight: 900;
            background: rgba(255, 255, 255, 0.68);
        }

        .social-section-title {
            position: relative;
            z-index: 1;
            margin: 20px 0 10px;
            color: #20364a;
            font-size: 0.78rem;
            font-weight: 900;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .social-grid {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .social-card {
            position: relative;
            display: grid;
            grid-template-columns: 38px minmax(0, 1fr);
            gap: 10px;
            align-items: center;
            min-height: 58px;
            padding: 10px;
            border: 1px solid rgba(23, 32, 51, 0.12);
            border-radius: 16px;
            color: #172033;
            background: rgba(255, 255, 255, 0.58);
            overflow: hidden;
            animation: contactEnter 0.74s ease both;
        }

        .social-card:hover,
        .social-card:focus-visible {
            transform: translateY(-3px);
            box-shadow: 0 16px 30px rgba(23, 32, 51, 0.13);
            outline: none;
        }

        .social-card.is-muted {
            color: rgba(23, 32, 51, 0.56);
            filter: saturate(0.6);
        }

        .social-icon {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            border-radius: 13px;
            color: #fffefa;
            background: #20364a;
            box-shadow: 0 10px 18px rgba(23, 32, 51, 0.14);
        }

        .social-icon svg {
            width: 22px;
            height: 22px;
            fill: currentColor;
        }

        .social-card.linkedin .social-icon {
            background: #0a66c2;
        }

        .social-card.twitter .social-icon {
            background: #111827;
        }

        .social-card.instagram .social-icon {
            background: linear-gradient(135deg, #f58529, #dd2a7b 48%, #515bd4);
        }

        .social-card.facebook .social-icon {
            background: #1877f2;
        }

        .social-card.youtube .social-icon {
            background: #ff0000;
        }

        .social-card.website .social-icon {
            background: var(--teal);
        }

        .social-copy span {
            display: block;
            color: inherit;
            font-size: 0.86rem;
            font-weight: 900;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .social-copy small {
            display: block;
            margin-top: 2px;
            color: var(--muted);
            font-size: 0.72rem;
            font-weight: 800;
        }

        .timeline {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            counter-reset: flow;
        }

        .timeline-step {
            position: relative;
            min-height: 178px;
            padding: 18px;
            border-radius: 18px;
            overflow: hidden;
        }

        .timeline-step::before {
            display: grid;
            place-items: center;
            width: 38px;
            height: 38px;
            margin-bottom: 16px;
            border-radius: 50%;
            counter-increment: flow;
            content: counter(flow);
            color: #fffefa;
            font-weight: 900;
            background: #20364a;
        }

        .timeline-step::after {
            position: absolute;
            left: 18px;
            right: 18px;
            bottom: 0;
            height: 4px;
            content: "";
            background: linear-gradient(90deg, var(--coral), var(--sun), var(--teal), var(--blue));
            transform: scaleX(0);
            transform-origin: left;
            animation: stepLine 1.2s ease forwards;
            animation-delay: calc(var(--step, 1) * 0.22s);
        }

        .timeline-step h3 {
            margin: 0 0 8px;
            color: #172033;
            font-size: 1.02rem;
        }

        .timeline-step p {
            margin: 0;
            color: var(--muted);
            font-size: 0.92rem;
            line-height: 1.5;
        }

        .final-cta {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 18px;
            align-items: center;
            margin: 42px 0 4px;
            padding: clamp(24px, 5vw, 38px);
            border: 1px solid rgba(255, 255, 255, 0.74);
            border-radius: 26px;
            background:
                linear-gradient(135deg, rgba(32, 54, 74, 0.94), rgba(22, 143, 152, 0.86)),
                #20364a;
            box-shadow: var(--shadow);
            color: #fffefa;
            overflow: hidden;
        }

        .final-cta h2 {
            margin: 0 0 10px;
            font-size: clamp(1.55rem, 4vw, 2.7rem);
        }

        .final-cta p {
            max-width: 650px;
            margin: 0;
            color: rgba(255, 255, 255, 0.78);
            line-height: 1.6;
        }

        .final-cta .btn-soft {
            color: #172033;
            background: #fffefa;
        }

        .progress-line {
            position: fixed;
            left: 0;
            top: 0;
            z-index: 50;
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.45);
        }

        .progress-line span {
            display: block;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, var(--coral), var(--sun), var(--teal), var(--blue));
            transform: scaleX(0);
            transform-origin: left;
            animation: introProgress 6.4s ease forwards;
        }

        .motion-dots {
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            overflow: hidden;
        }

        .motion-dots span {
            position: absolute;
            display: block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: rgba(23, 32, 51, 0.18);
            animation: dotFloat 13s linear infinite;
        }

        .motion-dots span:nth-child(1) {
            left: 8%;
            animation-duration: 12s;
        }

        .motion-dots span:nth-child(2) {
            left: 28%;
            animation-duration: 16s;
            animation-delay: -4s;
            background: rgba(228, 93, 72, 0.22);
        }

        .motion-dots span:nth-child(3) {
            left: 52%;
            animation-duration: 14s;
            animation-delay: -7s;
            background: rgba(22, 143, 152, 0.22);
        }

        .motion-dots span:nth-child(4) {
            left: 74%;
            animation-duration: 18s;
            animation-delay: -2s;
            background: rgba(55, 88, 214, 0.20);
        }

        .motion-dots span:nth-child(5) {
            left: 91%;
            animation-duration: 15s;
            animation-delay: -9s;
            background: rgba(240, 189, 79, 0.30);
        }

        @@keyframes copyIn {
            from {
                opacity: 0;
                transform: translateY(24px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes riseIn {
            from {
                opacity: 0;
                transform: translateY(18px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes adPop {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.96);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes adBreathe {
            0%,
            100% {
                transform: translateY(0);
                border-color: rgba(255, 255, 255, 0.82);
            }

            50% {
                transform: translateY(-3px);
                border-color: rgba(22, 143, 152, 0.34);
            }
        }

        @@keyframes nameGradient {
            to {
                background-position: 260% center;
            }
        }

        @@keyframes nameLetter {
            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            45% {
                transform: translateY(-4px) rotate(-1deg);
            }

            70% {
                transform: translateY(1px) rotate(1deg);
            }
        }

        @@keyframes floatPanel {
            0%,
            100% {
                transform: rotateX(8deg) rotateY(-8deg) translateY(0);
            }

            50% {
                transform: rotateX(3deg) rotateY(7deg) translateY(-14px);
            }
        }

        @@keyframes slowSpin {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes logoPulse {
            0%,
            100% {
                transform: scale(0.96);
                opacity: 0.72;
            }

            50% {
                transform: scale(1.08);
                opacity: 1;
            }
        }

        @@keyframes logoPop {
            from {
                opacity: 0;
                transform: scale(0.72) rotate(-7deg);
            }

            to {
                opacity: 1;
                transform: scale(1) rotate(0);
            }
        }

        @@keyframes floatChip {
            0%,
            100% {
                transform: translateY(0) rotate(-2deg);
            }

            50% {
                transform: translateY(-14px) rotate(4deg);
            }
        }

        @@keyframes railWave {
            0%,
            100% {
                transform: scaleY(0.68);
            }

            50% {
                transform: scaleY(1);
            }
        }

        @@keyframes revealUp {
            from {
                opacity: 0;
                transform: translateY(26px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes drift {
            0%,
            100% {
                transform: translate3d(0, 0, 0);
            }

            50% {
                transform: translate3d(42px, 24px, 0);
            }
        }

        @@keyframes stepLine {
            to {
                transform: scaleX(1);
            }
        }

        @@keyframes introProgress {
            to {
                transform: scaleX(1);
            }
        }

        @@keyframes dotFloat {
            from {
                transform: translateY(108vh) scale(0.7);
                opacity: 0;
            }

            18% {
                opacity: 1;
            }

            to {
                transform: translateY(-12vh) scale(1.2);
                opacity: 0;
            }
        }

        @@keyframes contactEnter {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes contactSweep {
            0%,
            42% {
                transform: translateX(-115%);
            }

            70%,
            100% {
                transform: translateX(115%);
            }
        }

        @@keyframes iconFloat {
            0%,
            100% {
                transform: translateY(0) rotate(-2deg);
            }

            50% {
                transform: translateY(-5px) rotate(2deg);
            }
        }

        @@keyframes contactPulse {
            0%,
            100% {
                transform: scale(0.92);
                opacity: 0.16;
            }

            50% {
                transform: scale(1.08);
                opacity: 0.42;
            }
        }

        @@media (max-width: 980px) {
            .hero,
            .profile-grid,
            .final-cta {
                grid-template-columns: 1fr;
            }

            .hero {
                min-height: auto;
            }

            .stage-wrap {
                min-height: 480px;
            }

            .feature-grid,
            .timeline {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .final-cta {
                justify-items: start;
            }
        }

        @@media (max-width: 680px) {
            .intro-shell {
                width: min(100% - 22px, 1180px);
                padding-top: 12px;
            }

            .topbar {
                align-items: stretch;
                border-radius: 24px;
                flex-direction: column;
            }

            .top-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                width: 100%;
            }

            .btn {
                width: 100%;
                min-height: 40px;
                padding: 10px 12px;
                font-size: 0.84rem;
            }

            .hero {
                padding-top: 30px;
            }

            .mini-metrics,
            .feature-grid,
            .timeline,
            .social-grid {
                grid-template-columns: 1fr;
            }

            .stage-wrap {
                min-height: 400px;
            }

            .logo-theater {
                border-radius: 28px;
                margin-top: 20px;
            }

            .orbit {
                width: 60px;
                height: 60px;
                border-radius: 18px;
                font-size: 0.67rem;
            }

            .section-head {
                align-items: flex-start;
                flex-direction: column;
            }

            .developer-card {
                grid-template-columns: 1fr;
            }

            .contact-card {
                grid-template-columns: 50px minmax(0, 1fr);
            }

            .contact-icon {
                width: 50px;
                height: 50px;
                border-radius: 16px;
            }

            .contact-arrow {
                display: none;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>
<body>
    <div class="progress-line" aria-hidden="true"><span></span></div>
    <div class="motion-dots" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>

    <main class="intro-shell">
        <header class="topbar">
            <a class="brand-mark" href="/Home/Intro" aria-label="showTime intro">
                <img src="/images/brand/showtime-login-logo-tight.png" alt="showTime logo" />
                <span>showTime</span>
            </a>
            <nav class="top-actions" aria-label="Intro actions">
                <a class="btn btn-soft" href="/Home/ShowTime">Skip Intro</a>
                <a class="btn btn-soft" href="/Auth/Login">Login</a>
                <a class="btn btn-primary" href="/Home/ShowTime">Enter Shows</a>
            </nav>
        </header>

        <section class="hero" aria-labelledby="introTitle">
            <div class="hero-copy">
                <span class="kicker">Application opening scene</span>
                <h1 id="introTitle">Book shows with a smoother showTime.</h1>
                <p class="lead">
                    A clean ticket booking experience for movies, standup, events, news viewing, secure payments,
                    refunds, wallet history, admin controls, and role-based management.
                </p>

                <div class="hero-actions">
                    <a class="btn btn-primary" href="/Home/ShowTime">Browse Listed Shows</a>
                    <a class="btn btn-soft" href="/Auth/Login?returnUrl=%2FHome%2FShowTime">Login To Book</a>
                    <a class="btn btn-soft" href="#developerProfiles">Developer Profile</a>
                </div>

                <div class="ad-strip" aria-label="showTime highlights">
                    <span>Fast seat booking</span>
                    <span>Secure payment flow</span>
                    <span>Clean ticket experience</span>
                    <span>Admin-ready control</span>
                </div>

                <div class="mini-metrics" aria-label="Application highlights">
                    <div class="metric">
                        <strong data-count="4">0</strong>
                        <span>Show categories</span>
                    </div>
                    <div class="metric">
                        <strong data-count="24">0</strong>
                        <span>Hour booking flow</span>
                    </div>
                    <div class="metric">
                        <strong data-count="100">0</strong>
                        <span>Responsive layout</span>
                    </div>
                </div>
            </div>

            <div class="stage-wrap" aria-label="Animated showTime logo stage">
                <div class="stage-glow"></div>
                <div class="logo-theater" data-tilt-panel>
                    <img class="logo-core" src="/images/brand/showtime-login-logo-tight.png" alt="showTime logo" />
                    <span class="orbit one">Book</span>
                    <span class="orbit two">Pay</span>
                    <span class="orbit three">Enjoy</span>
                </div>
                <div class="cinema-rail" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </section>

        <section class="section" aria-labelledby="featuresTitle">
            <div class="section-head">
                <h2 id="featuresTitle">What the application gives users</h2>
                <p>Every action stays focused on finding a show, booking seats, paying safely, and getting help when needed.</p>
            </div>

            <div class="feature-grid">
                <article class="feature">
                    <div class="feature-icon">01</div>
                    <h3>Live show listing</h3>
                    <p>Users can browse upcoming shows first, then login only when they decide to book seats.</p>
                </article>
                <article class="feature">
                    <div class="feature-icon">02</div>
                    <h3>Seat booking</h3>
                    <p>Show-wise seat selection, booking confirmation, ticket pages, and download-ready ticket flows.</p>
                </article>
                <article class="feature">
                    <div class="feature-icon">03</div>
                    <h3>Payments and refunds</h3>
                    <p>Wallet tracking, payment records, refund lifecycle, cancellation reasons, and admin refund control.</p>
                </article>
                <article class="feature">
                    <div class="feature-icon">04</div>
                    <h3>Admin workspace</h3>
                    <p>Role access, user management, show control, cancellation history, relaunch tools, and audit logs.</p>
                </article>
            </div>
        </section>

        <section class="section" id="developerProfiles" aria-labelledby="developerTitle">
            <div class="section-head">
                <h2 id="developerTitle">Developer profile</h2>
                <p>Use quick actions and social channels without exposing private contact details on the page.</p>
            </div>

            <div class="profile-grid">
                <article class="profile-panel">
                    <div class="developer-card">
                        <img src="/images/brand/showtime-login-logo-tight.png" alt="@developerName profile mark" />
                        <div>
                            <h3><span class="developer-name" data-animated-name>@developerName</span></h3>
                            <p>
                                Full stack application development focused on booking workflows, admin controls,
                                clean UI behavior, device compatibility, and practical support paths.
                            </p>
                        </div>
                    </div>
                    <div class="profile-tags" aria-label="Developer focus areas">
                        <span>ASP.NET Core MVC</span>
                        <span>PostgreSQL</span>
                        <span>Responsive UI</span>
                        <span>RBAC</span>
                        <span>Booking systems</span>
                        <span>Reports and exports</span>
                    </div>
                </article>

                <aside class="profile-panel" aria-label="Developer contact snapshot">
                    <div class="contact-grid">
                        <a class="contact-card" href="@emailUrl" aria-label="Email @developerName">
                            <span class="contact-icon email" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <path d="m3 7 9 6 9-6"></path>
                                </svg>
                            </span>
                            <span class="contact-copy">
                                <span>Email</span>
                                <strong>Send Message</strong>
                            </span>
                            <span class="contact-arrow" aria-hidden="true">></span>
                        </a>

                        <a class="contact-card" href="@whatsAppUrl" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp @developerName">
                            <span class="contact-icon whatsapp" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12.03 2.25a9.62 9.62 0 0 0-8.3 14.48L2.75 21.25l4.63-1.2a9.62 9.62 0 1 0 4.65-17.8Zm0 1.8a7.82 7.82 0 1 1-3.94 14.57l-.33-.2-2.3.6.6-2.23-.22-.35A7.82 7.82 0 0 1 12.03 4.05Zm-3.1 3.96c-.18 0-.47.07-.72.34-.25.27-.95.93-.95 2.26 0 1.33.98 2.62 1.11 2.8.14.18 1.9 3.03 4.72 4.13 2.35.93 2.83.75 3.34.7.52-.05 1.67-.68 1.9-1.34.24-.66.24-1.22.17-1.34-.07-.12-.26-.19-.54-.33-.28-.14-1.67-.82-1.93-.91-.26-.1-.45-.14-.64.14-.19.28-.74.91-.91 1.1-.17.19-.33.21-.61.07-.28-.14-1.18-.44-2.25-1.39-.83-.74-1.39-1.66-1.55-1.94-.16-.28-.02-.43.12-.57.13-.13.28-.33.42-.49.14-.16.19-.28.28-.47.09-.19.05-.35-.02-.49-.07-.14-.63-1.52-.87-2.08-.23-.54-.46-.47-.64-.48Z"></path>
                                </svg>
                            </span>
                            <span class="contact-copy">
                                <span>WhatsApp</span>
                                <strong>Connect On WhatsApp</strong>
                            </span>
                            <span class="contact-arrow" aria-hidden="true">></span>
                        </a>

                        <a class="contact-card" href="tel:@telNumber" aria-label="Call @developerName">
                            <span class="contact-icon phone" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.32 1.77.59 2.61a2 2 0 0 1-.45 2.11L8 9.69a16 16 0 0 0 6.31 6.31l1.25-1.25a2 2 0 0 1 2.11-.45c.84.27 1.71.47 2.61.59A2 2 0 0 1 22 16.92Z"></path>
                                </svg>
                            </span>
                            <span class="contact-copy">
                                <span>Phone</span>
                                <strong>Call Developer</strong>
                            </span>
                            <span class="contact-arrow" aria-hidden="true">></span>
                        </a>
                    </div>
                    <div class="social-section-title">Social media</div>
                    <div class="social-grid" aria-label="Developer social media links">
                        @foreach (var social in socialLinks)
                        {
                            var hasSocialUrl = !string.IsNullOrWhiteSpace(social.Url);
                            if (hasSocialUrl)
                            {
                                <a class="social-card @social.Kind" href="@social.Url" target="_blank" rel="noopener noreferrer" aria-label="@social.Label profile">
                                    @RenderSocialIcon(social.Kind)
                                    <span class="social-copy">
                                        <span>@social.Label</span>
                                        <small>Open profile</small>
                                    </span>
                                </a>
                            }
                            else
                            {
                                <span class="social-card @social.Kind is-muted" aria-label="@social.Label profile not added">
                                    @RenderSocialIcon(social.Kind)
                                    <span class="social-copy">
                                        <span>@social.Label</span>
                                        <small>Coming soon</small>
                                    </span>
                                </span>
                            }
                        }
                    </div>
                    <a class="profile-link" href="/Developer/Profile">Open Full Developer Profile</a>
                </aside>
            </div>
        </section>

        <section class="section" aria-labelledby="journeyTitle">
            <div class="section-head">
                <h2 id="journeyTitle">User journey</h2>
                <p>The application now starts with this animated intro, then lets visitors move into the show listing.</p>
            </div>

            <div class="timeline">
                <article class="timeline-step" style="--step:1">
                    <h3>Open application</h3>
                    <p>The intro loads first with no show data required.</p>
                </article>
                <article class="timeline-step" style="--step:2">
                    <h3>Browse shows</h3>
                    <p>Visitors can go directly to listed shows from the intro.</p>
                </article>
                <article class="timeline-step" style="--step:3">
                    <h3>Login to book</h3>
                    <p>Booking actions send guests to login and return them to the selected show.</p>
                </article>
                <article class="timeline-step" style="--step:4">
                    <h3>Manage tickets</h3>
                    <p>Confirmed users can continue with payment, tickets, wallet, and support.</p>
                </article>
            </div>
        </section>

        <section class="final-cta" aria-labelledby="readyTitle">
            <div>
                <h2 id="readyTitle">Ready for the show list?</h2>
                <p>Continue to the public home listing, pick a show, and login only when booking is needed.</p>
            </div>
            <a class="btn btn-soft" href="/Home/ShowTime">Enter Application</a>
        </section>
    </main>

    <script>
        (function () {
            const tabTitleFrames = [
                "showTime - Now Introducing",
                "Book Shows Faster",
                "Pick Seats Live",
                "Pay Securely",
                "Meet Amar ChaudharY",
                "Enter showTime"
            ];
            let tabFrameIndex = 0;
            let faviconFrame = 0;

            function updateTabTitle() {
                document.title = tabTitleFrames[tabFrameIndex % tabTitleFrames.length];
                tabFrameIndex += 1;
            }

            function updateTabIcon() {
                const favicon = document.getElementById("introTabIcon");

                if (!favicon || !document.createElement("canvas").getContext) {
                    return;
                }

                const canvas = document.createElement("canvas");
                const size = 64;
                const center = size / 2;
                const phase = faviconFrame % 36;
                const colors = ["#168f98", "#e45d48", "#f0bd4f", "#3758d6"];
                const active = colors[faviconFrame % colors.length];
                const ctx = canvas.getContext("2d");

                if (!ctx) {
                    return;
                }

                canvas.width = size;
                canvas.height = size;

                ctx.clearRect(0, 0, size, size);
                ctx.fillStyle = "#fffdf8";
                ctx.beginPath();
                if (typeof ctx.roundRect === "function") {
                    ctx.roundRect(4, 4, 56, 56, 16);
                }
                else {
                    ctx.rect(4, 4, 56, 56);
                }
                ctx.fill();

                ctx.lineWidth = 5;
                ctx.strokeStyle = active;
                ctx.beginPath();
                ctx.arc(center, center, 22, -Math.PI / 2, -Math.PI / 2 + (Math.PI * 2 * ((phase + 8) / 36)));
                ctx.stroke();

                ctx.fillStyle = active;
                ctx.beginPath();
                ctx.moveTo(27, 21);
                ctx.lineTo(45, 32);
                ctx.lineTo(27, 43);
                ctx.closePath();
                ctx.fill();

                ctx.fillStyle = "#20364a";
                ctx.font = "900 12px Segoe UI, Arial, sans-serif";
                ctx.textAlign = "center";
                ctx.fillText("ST", center, 55);

                favicon.href = canvas.toDataURL("image/png");
                faviconFrame += 1;
            }

            updateTabTitle();
            updateTabIcon();
            setInterval(updateTabTitle, 1400);
            setInterval(updateTabIcon, 420);

            const counters = document.querySelectorAll("[data-count]");
            const duration = 1100;
            const startedAt = performance.now();

            function renderCounters(now) {
                const progress = Math.min((now - startedAt) / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);

                counters.forEach(function (counter) {
                    const target = Number(counter.dataset.count || "0");
                    counter.textContent = Math.round(target * eased).toString();
                });

                if (progress < 1) {
                    requestAnimationFrame(renderCounters);
                }
            }

            requestAnimationFrame(renderCounters);

            document.querySelectorAll("[data-animated-name]").forEach(function (name) {
                const text = name.textContent || "";
                name.textContent = "";

                Array.from(text).forEach(function (letter, index) {
                    const span = document.createElement("span");
                    span.style.setProperty("--letter-index", index.toString());
                    span.textContent = letter === " " ? "\u00A0" : letter;

                    if (letter === " ") {
                        span.className = "name-space";
                    }

                    name.appendChild(span);
                });
            });

            document
                .querySelectorAll(".btn, .metric, .feature, .profile-panel, .contact-card, .social-card, .timeline-step, .final-cta")
                .forEach(function (surface) {
                    surface.classList.add("motion-surface");

                    const glow = document.createElement("span");
                    glow.className = "cursor-glow";
                    glow.setAttribute("aria-hidden", "true");
                    surface.appendChild(glow);

                    surface.addEventListener("pointermove", function (event) {
                        const rect = surface.getBoundingClientRect();
                        const x = ((event.clientX - rect.left) / rect.width) * 100;
                        const y = ((event.clientY - rect.top) / rect.height) * 100;
                        const rotateY = (x - 50) * 0.05;
                        const rotateX = (50 - y) * 0.05;

                        surface.style.setProperty("--pointer-x", x.toFixed(2) + "%");
                        surface.style.setProperty("--pointer-y", y.toFixed(2) + "%");
                        surface.style.transform = "translateY(-3px) rotateX(" + rotateX.toFixed(2) + "deg) rotateY(" + rotateY.toFixed(2) + "deg)";
                    });

                    surface.addEventListener("pointerleave", function () {
                        surface.style.transform = "";
                    });
                });

            const panel = document.querySelector("[data-tilt-panel]");

            if (panel && window.matchMedia("(pointer: fine)").matches) {
                panel.addEventListener("mousemove", function (event) {
                    const rect = panel.getBoundingClientRect();
                    const x = (event.clientX - rect.left) / rect.width - 0.5;
                    const y = (event.clientY - rect.top) / rect.height - 0.5;
                    panel.style.transform = "rotateX(" + ((y * -10) + 8).toFixed(2) + "deg) rotateY(" + ((x * 14) - 8).toFixed(2) + "deg)";
                });

                panel.addEventListener("mouseleave", function () {
                    panel.style.transform = "";
                });
            }
        })();
    </script>
</body>
</html>
