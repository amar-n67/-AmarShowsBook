@model List<AmarShowsBook.Models.User>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Users";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<section class="admin-page">

    <div class="admin-page-header">

        <div>
            <h1>User Management</h1>

            <p>
                Manage account status, profile details,
                and user access.
            </p>
        </div>

        <div class="admin-actions">
            <a class="admin-back-btn admin-page-back"
               href="/Admin/Dashboard">

                ← Back to Dashboard

            </a>
        </div>

    </div>

    <div class="table-wrapper users-table-wrapper">

        <table class="table admin-table users-table">

            <colgroup>
                <col class="users-col-name" />
                <col class="users-col-email" />
                <col class="users-col-mobile" />
                <col class="users-col-status" />
                <col class="users-col-delete-status" />
                <col class="users-col-actions" />
            </colgroup>

            <thead>

                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Mobile</th>
                    <th>Status</th>
                    <th>Delete Status</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var user in Model)
                {
                    <tr data-filter-status="@($"{(user.is_active ? "ACTIVE" : "DISABLED")}|{(user.is_deleted ? "DELETED" : "NORMAL")}")">

                        <td>@user.Name</td>

                        <td>@user.Email</td>

                        <td>@user.Mobile</td>

                        <td>

                            @if (user.is_active)
                            {
                                <span class="badge-active">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge-disabled">
                                    Disabled
                                </span>
                            }

                        </td>

                        <td>

                            @if (user.is_deleted)
                            {
                                <span class="badge bg-danger">
                                    Deleted
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Normal
                                </span>
                            }

                        </td>

                        <td class="user-actions-cell">

                            <div class="admin-actions user-row-actions">


                                <a href="/Admin/UserDetails/@user.Id"
                                   class="btn btn-primary">

                                    Details

                                </a>


                                @if (user.is_active)
                                {
                                    <form method="post"
                                          action="/Admin/DisableUser/@user.Id">

                                        <button type="submit"
                                                class="btn btn-danger">

                                            Disable

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form method="post"
                                          action="/Admin/EnableUser/@user.Id">

                                        <button type="submit"
                                                class="btn btn-success">

                                            Enable

                                        </button>

                                    </form>
                                }


                                @if (user.is_deleted)
                                {
                                    <a class="btn btn-success"
                                       href="/Admin/RevokeUser/@user.Id">

                                        Revoke

                                    </a>
                                }
                                else
                                {
                                    <form method="post"
                                          action="/Admin/DeleteUser/@user.Id">

                                        <button type="submit"
                                                class="btn btn-dark">

                                            Delete

                                        </button>

                                    </form>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    @await Html.PartialAsync("_AdminPagination", new AmarShowsBook.Models.ViewModels.AdminPaginationViewModel
    {
        CurrentPage = currentPage,
        TotalPages = totalPages,
        ActionUrl = "/Admin/Users"
    })

</section>

<style>
    .users-table-wrapper {
        overflow-x: auto !important;
        overflow-y: visible !important;
        scrollbar-gutter: stable both-edges;
        -webkit-overflow-scrolling: touch;
    }

    table.table.admin-table.users-table {
        width: max-content !important;
        min-width: 100% !important;
        max-width: none !important;
        table-layout: auto !important;
    }

    .users-col-name {
        width: max-content;
        min-width: 180px;
    }

    .users-col-email {
        width: max-content;
        min-width: 260px;
    }

    .users-col-mobile {
        width: max-content;
        min-width: 150px;
    }

    .users-col-status,
    .users-col-delete-status {
        width: max-content;
        min-width: 120px;
    }

    .users-col-actions {
        width: 1%;
        min-width: 300px;
    }

    table.table.admin-table.users-table th,
    table.table.admin-table.users-table td {
        max-width: none !important;
        white-space: nowrap;
    }

    table.table.admin-table.users-table th:nth-child(1),
    table.table.admin-table.users-table td:nth-child(1) {
        min-width: 180px !important;
    }

    table.table.admin-table.users-table th:nth-child(2),
    table.table.admin-table.users-table td:nth-child(2) {
        min-width: 260px !important;
    }

    table.table.admin-table.users-table th:nth-child(3),
    table.table.admin-table.users-table td:nth-child(3) {
        min-width: 150px !important;
    }

    table.table.admin-table.users-table th:nth-child(4),
    table.table.admin-table.users-table td:nth-child(4),
    table.table.admin-table.users-table th:nth-child(5),
    table.table.admin-table.users-table td:nth-child(5) {
        min-width: 120px !important;
    }

    table.table.admin-table.users-table th:last-child,
    table.table.admin-table.users-table td:last-child,
    table.table.admin-table.users-table td.user-actions-cell {
        width: 1% !important;
        min-width: 300px !important;
    }

    .user-row-actions {
        display: inline-flex !important;
        flex-wrap: nowrap !important;
        align-items: center;
        gap: 8px;
        width: max-content;
        white-space: nowrap;
    }

    .user-row-actions form {
        display: inline-flex;
        margin: 0;
    }

    .user-row-actions .btn {
        min-width: 72px;
        padding-inline: 12px;
        white-space: nowrap;
    }

    @@media (max-width: 720px) {
        table.table.admin-table.users-table {
            min-width: 920px !important;
        }

        table.table.admin-table.users-table th:last-child,
        table.table.admin-table.users-table td:last-child,
        table.table.admin-table.users-table td.user-actions-cell {
            width: 300px !important;
            min-width: 300px !important;
        }
    }
</style>
