@model List<AmarShowsBook.Models.Role>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Roles";
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Roles Management</h1>
            <p>Create and maintain role definitions used by RBAC.</p>
        </div>
        <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">Back to Dashboard</a>
    </div>

    @if(TempData["Success"]!=null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if(TempData["Error"]!=null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="admin-detail-panel mb-4" data-admin-searchable>
        <h2 class="h5 mb-3">New Role</h2>
        <form asp-action="CreateRole" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">Role Code</label>
                <input name="roleCode" class="form-control" placeholder="AMAR_CONTENT_MANAGER" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Role Name</label>
                <input name="roleName" class="form-control" placeholder="Content Manager" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Description</label>
                <input name="roleDescription" class="form-control" placeholder="What this role can manage" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100" type="submit">Add Role</button>
            </div>
        </form>
    </div>

    <div class="card p-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var role in Model)
                {
                    <tr data-admin-searchable data-filter-status="@(role.IsActive ? "ACTIVE" : "INACTIVE")">
                        <form asp-action="UpdateRole" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@role.Id" />
                            <td><input name="roleName" class="form-control" value="@role.RoleName" /></td>
                            <td><strong>@role.RoleCode</strong></td>
                            <td><input name="roleDescription" class="form-control" value="@role.RoleDescription" /></td>
                            <td>
                                <select name="isActive" class="form-select">
                                    <option value="true" selected="@role.IsActive">Active</option>
                                    <option value="false" selected="@(!role.IsActive)">Inactive</option>
                                </select>
                            </td>
                            <td>
                                <button class="btn btn-warning" type="submit">Save</button>
                            </td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
