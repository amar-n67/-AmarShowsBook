@model List<AmarShowsBook.Models.Role>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Roles";
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Roles Management</h1>
            <p>Maintain the four system roles used by RBAC.</p>
        </div>
        <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">Back to Dashboard</a>
    </div>

    @if(TempData["Success"]!=null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if(TempData["Error"]!=null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="admin-detail-panel mb-4">
        <h2 class="h5 mb-2">System Roles Only</h2>
        <p class="mb-0 text-muted">
            Custom roles are disabled. Use Super Admin, Administrator, Developer, and User for all access control.
        </p>
    </div>

    <div class="card p-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>Code</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var role in Model.Where(x => x.RoleCode == "AMAR_SUPER_ADMIN" || x.RoleCode == "AMAR_ADMIN" || x.RoleCode == "AMAR_DEVELOPER" || x.RoleCode == "AMAR_USER"))
                {
                    var isSuperAdmin = string.Equals(role.RoleCode, "AMAR_SUPER_ADMIN", StringComparison.OrdinalIgnoreCase);
                    <tr data-admin-searchable data-filter-status="@(role.IsActive ? "ACTIVE" : "INACTIVE")">
                        <form asp-action="UpdateRole" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@role.Id" />
                            <td><input name="roleName" class="form-control" value="@role.RoleName" /></td>
                            <td><strong>@role.RoleCode</strong></td>
                            <td><input name="roleDescription" class="form-control" value="@role.RoleDescription" /></td>
                            <td>
                                <select name="isActive" class="form-select" disabled="@isSuperAdmin">
                                    <option value="true" selected="@role.IsActive">Active</option>
                                    <option value="false" selected="@(!role.IsActive)">Inactive</option>
                                </select>
                                @if(isSuperAdmin)
                                {
                                    <input type="hidden" name="isActive" value="true" />
                                }
                            </td>
                            <td>
                                <button class="btn btn-warning" type="submit">Save</button>
                            </td>
                        </form>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
