@model List<AmarShowsBook.Models.Permission>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Permissions";
    var roles = ViewBag.Roles as List<AmarShowsBook.Models.Role> ?? new();
    var modules = ViewBag.Modules as List<AmarShowsBook.Models.ApplicationModule> ?? new();
    var assigned = ViewBag.RolePermissionIds as HashSet<string> ?? new();
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Permissions</h1>
            <p>Assign page, button and workflow access to application roles.</p>
        </div>
        <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">Back to Dashboard</a>
    </div>

    @if(TempData["Success"]!=null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if(TempData["Error"]!=null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="admin-detail-panel mb-4" data-admin-searchable>
        <h2 class="h5 mb-3">New Permission</h2>
        <form asp-action="CreatePermission" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">Module</label>
                <select name="moduleId" class="form-select" required>
                    @foreach(var module in modules)
                    {
                        <option value="@module.Id">@module.ModuleName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Action</label>
                <input name="actionType" class="form-control" placeholder="VIEW" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">Permission Code</label>
                <input name="permissionCode" class="form-control" placeholder="BOOKING_CANCEL" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Name</label>
                <input name="permissionName" class="form-control" placeholder="Cancel booking" required />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Add</button>
            </div>
            <div class="col-12">
                <input name="description" class="form-control" placeholder="Short developer-facing description" />
            </div>
        </form>
    </div>

    <div class="card p-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Permission</th>
                    <th>Action</th>
                    @foreach(var role in roles)
                    {
                        <th>@role.RoleName</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach(var permission in Model)
                {
                    <tr data-admin-searchable>
                        <td>
                            <strong>@permission.PermissionCode</strong>
                            <div class="text-muted small">@permission.PermissionName</div>
                        </td>
                        <td>@permission.ActionType</td>
                        @foreach(var role in roles)
                        {
                            var isGranted = assigned.Contains($"{role.Id}:{permission.Id}");
                            <td>
                                <form asp-action="ToggleRolePermission" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="roleId" value="@role.Id" />
                                    <input type="hidden" name="permissionId" value="@permission.Id" />
                                    <input type="hidden" name="grant" value="@(!isGranted)" />
                                    <button class="btn @(isGranted ? "btn-success" : "btn-outline-secondary") btn-sm" type="submit">
                                        @(isGranted ? "Granted" : "Grant")
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
