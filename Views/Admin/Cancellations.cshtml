@model AmarShowsBook.Models.ViewModels.AdminCancellationsViewModel
@using AmarShowsBook.Helpers
@using System.Globalization

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Ticket Cancellations";
    var showTypeOptions = Model.Bookings.Select(x => x.ShowType)
        .Concat(Model.Shows.Select(x => x.ShowType))
        .Concat(Model.RecentCancellations.Select(x => x.ShowType ?? string.Empty))
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Select(x => x.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToArray();
    var showGroups = Model.Shows
        .GroupBy(x => string.IsNullOrWhiteSpace(x.VenueName) ? "Venue not mapped" : x.VenueName)
        .OrderBy(x => x.Key)
        .ToList();
    var relaunchGroups = Model.RelaunchableShows
        .GroupBy(x => string.IsNullOrWhiteSpace(x.VenueName) ? "Venue not mapped" : x.VenueName)
        .OrderBy(x => x.Key)
        .ToList();
    var theaterHistoryGroups = Model.TheaterCancellationHistory
        .GroupBy(x => string.IsNullOrWhiteSpace(x.VenueName) ? "Venue not mapped" : x.VenueName)
        .OrderBy(x => x.Key)
        .ToList();
    var recordTypeOptions = new List<string>();
    if (Model.Bookings.Any())
    {
        recordTypeOptions.Add("Individual Booking");
    }
    if (Model.Shows.Any(x => !x.IsCancelled))
    {
        recordTypeOptions.Add("Future Show");
    }
    if (Model.Shows.Any(x => x.IsCancelled))
    {
        recordTypeOptions.Add("Cancelled Future Show");
    }
    if (Model.RelaunchableShows.Any())
    {
        recordTypeOptions.Add("Relaunchable Show");
    }
    if (Model.IndividualCancellationHistory.Any())
    {
        recordTypeOptions.Add("History Individual");
    }
    if (Model.TheaterCancellationHistory.Any())
    {
        recordTypeOptions.Add("History Theater");
    }
    ViewData["AdminFilterTarget"] = "[data-admin-filter-row]";
    ViewData["AdminStatusLabel"] = "Record Types";
    ViewData["AdminStatusOptions"] = recordTypeOptions;
    ViewData["AdminMethodLabel"] = "Show Type";
    ViewData["AdminMethodOptions"] = showTypeOptions;
    ViewData["AdminSortOptions"] = new[]
    {
        "oldest|Soonest / Oldest First",
        "newest|Latest First",
        "title|Show / Booking A-Z",
        "tickets|Tickets High-Low",
        "amount|Amount High-Low"
    };

    long SortTime(DateTime value)
    {
        return ShowTimeFormatter.SortTicks(value);
    }

    string SortAmount(decimal value) => value.ToString(CultureInfo.InvariantCulture);

    string DateTimeLocalInput(DateTime value)
    {
        return ShowTimeFormatter.InputValue(value);
    }

    string ShowDateTime(DateTime value) =>
        ShowTimeFormatter.Format(value, "dd MMM yyyy, hh:mm tt");

    string HistoryDateTime(DateTime? value) =>
        value.HasValue
            ? value.Value.ToString("dd MMM yyyy, hh:mm tt", CultureInfo.InvariantCulture)
            : "Not saved in DB";

    string HistoryTimeRange(DateTime? start, DateTime? end)
    {
        if (!start.HasValue && !end.HasValue)
        {
            return "Not saved in DB";
        }

        return $"{HistoryDateTime(start)} - {HistoryDateTime(end)}";
    }
}

<section class="admin-page cancellation-admin-page">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="admin-page-header">
        <div>
            <h1 class="page-title">Ticket Cancellations</h1>
            <p class="page-subtitle">
                Manage individual cancellations, all future shows, theater relaunches, and cancellation history in one place.
            </p>
        </div>
        <div class="admin-actions">
            <a href="/Admin/Dashboard" class="admin-back-btn admin-page-back">← Back to Dashboard</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <span>Individual Bookings</span>
            <strong>@Model.Bookings.Count</strong>
        </div>
        <div class="stat-card">
            <span>All Future Shows</span>
            <strong>@Model.Shows.Count</strong>
        </div>
        <div class="stat-card">
            <span>Relaunchable Shows</span>
            <strong>@Model.RelaunchableShows.Count</strong>
        </div>
        <div class="stat-card">
            <span>Cancelled History</span>
            <strong>@Model.RecentCancellations.Count</strong>
        </div>
    </div>

    <div class="cancellation-filter-anchor" data-page-filter-anchor></div>

    <div class="content-tabs cancellation-content-tabs">
        <button type="button" data-content-target="cancellation-individual" aria-expanded="false" aria-controls="cancellation-individual">
            <span>Individual Bookings</span>
            <span class="content-toggle-arrow" aria-hidden="true">↓</span>
        </button>
        <button type="button" data-content-target="cancellation-shows" aria-expanded="false" aria-controls="cancellation-shows">
            <span>Future Shows</span>
            <span class="content-toggle-arrow" aria-hidden="true">↓</span>
        </button>
        <button type="button" data-content-target="cancellation-relaunch" aria-expanded="false" aria-controls="cancellation-relaunch">
            <span>Relaunch</span>
            <span class="content-toggle-arrow" aria-hidden="true">↓</span>
        </button>
        <button type="button" data-content-target="cancellation-history" aria-expanded="false" aria-controls="cancellation-history">
            <span>History</span>
            <span class="content-toggle-arrow" aria-hidden="true">↓</span>
        </button>
    </div>

    <div class="cancellation-grid">
        <article id="cancellation-individual" class="cancellation-panel content-section" hidden>
            <div class="cancellation-panel-head">
                <div>
                    <span>Part 1</span>
                    <h2>All Individual Bookings</h2>
                    <p>Cancel a single user booking. Refund follows the normal cancellation flow.</p>
                </div>
                <button type="button" class="content-section-toggle" data-content-collapse="cancellation-individual" aria-label="Hide Individual Bookings">
                    ↑
                </button>
            </div>

            <div class="table-wrapper">
                <table class="table admin-table cancellation-table booking-cancel-table">
                    <colgroup>
                        <col class="booking-info-col" />
                        <col class="booking-user-col" />
                        <col class="booking-show-col" />
                        <col class="cancel-form-col" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Booking</th>
                            <th>User</th>
                            <th>Show</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Bookings.Any())
                        {
                            <tr>
                                <td colspan="4" class="empty-state">No individual active bookings found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var booking in Model.Bookings)
                            {
                                <tr class="cancellation-data-row"
                                    data-admin-searchable
                                    data-admin-filter-row
                                    data-filter-status="Individual Booking"
                                    data-filter-method="@booking.ShowType"
                                    data-sort-time="@SortTime(booking.StartTime)"
                                    data-sort-title="@($"{booking.ShowTitle} {booking.BookingRef}")"
                                    data-sort-tickets="@booking.TotalTickets"
                                    data-sort-amount="@SortAmount(booking.Amount)">
                                    <td>
                                        <div class="primary-text">@booking.BookingRef</div>
                                        <div class="sub-text">@CurrencyFormatter.FormatRupees(booking.Amount) | @booking.TotalTickets ticket(s)</div>
                                        <div class="sub-text seat-list">Seats: @booking.SeatNumbers</div>
                                    </td>
                                    <td>
                                        <div class="primary-text">@booking.UserName</div>
                                        <div class="sub-text email-cell">@booking.UserEmail</div>
                                    </td>
                                    <td>
                                        <div class="primary-text">@booking.ShowTitle</div>
                                        <div class="sub-text">@booking.ShowType | @ShowDateTime(booking.StartTime)</div>
                                    </td>
                                    <td class="cancel-action-cell">
                                        <form asp-action="CancelIndividualBooking" method="post" class="cancel-inline-form" data-cancellation-submit-form>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@booking.BookingId" />
                                            <textarea name="cancellationReason" rows="2" maxlength="500" required placeholder="Reason"></textarea>
                                            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </article>

        <article id="cancellation-shows" class="cancellation-panel content-section" hidden>
            <div class="cancellation-panel-head danger-zone">
                <div>
                    <span>Part 2</span>
                    <h2>All Future Shows - Theater Wise</h2>
                    <p>Shows start from the next second onward. Cancelled shows stay visible here with their status.</p>
                </div>
                <button type="button" class="content-section-toggle" data-content-collapse="cancellation-shows" aria-label="Hide Future Shows">
                    ↑
                </button>
            </div>

            @if (!Model.Shows.Any())
            {
                <div class="empty-state">No future theater shows found.</div>
            }
            else
            {
                <div class="theater-show-groups">
                    @foreach (var theaterGroup in showGroups)
                    {
                        <section class="theater-show-group" data-cancellation-group>
                            <div class="theater-group-box">
                                <div>
                                    <span class="theater-chip">Theater</span>
                                    <strong>@theaterGroup.Key</strong>
                                </div>
                                <div class="sub-text">
                                    @theaterGroup.Count() future show(s) | @theaterGroup.Count(x => x.IsCancelled) cancelled | @theaterGroup.Sum(x => x.BookingCount) booking(s) | @theaterGroup.Sum(x => x.TicketCount) ticket(s)
                                </div>
                            </div>

                            <div class="table-wrapper theater-table-wrapper">
                                <table class="table admin-table cancellation-table show-cancel-table">
                                    <colgroup>
                                        <col class="show-info-col" />
                                        <col class="show-theater-col" />
                                        <col class="show-ticket-col" />
                                        <col class="cancel-form-col" />
                                    </colgroup>
                                    <thead>
                                        <tr>
                                            <th>Show</th>
                                            <th>Screen</th>
                                            <th>Booked Tickets</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var show in theaterGroup.OrderBy(x => x.ScreenName).ThenBy(x => x.StartTime))
                                        {
                                            var showRecordType = show.IsCancelled ? "Cancelled Future Show" : "Future Show";
                                            <tr class="cancellation-data-row"
                                                data-admin-searchable
                                                data-admin-filter-row
                                                data-filter-status="@showRecordType"
                                                data-filter-method="@show.ShowType"
                                                data-sort-time="@SortTime(show.StartTime)"
                                                data-sort-title="@show.ShowTitle"
                                                data-sort-tickets="@show.TicketCount"
                                                data-sort-amount="@SortAmount(show.Amount)">
                                                <td>
                                                    <div class="primary-text">@show.ShowTitle</div>
                                                    <div class="sub-text">@show.ShowType | @ShowDateTime(show.StartTime)</div>
                                                    @if (show.IsCancelled)
                                                    {
                                                        <span class="badge danger status-badge">Cancelled</span>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="primary-text">@show.VenueName</div>
                                                    <div class="sub-text"><span class="screen-pill">@show.ScreenName</span></div>
                                                </td>
                                                <td>
                                                    <div class="primary-text">@show.BookingCount booking(s)</div>
                                                    <div class="sub-text">@show.TicketCount ticket(s) | @CurrencyFormatter.FormatRupees(show.Amount)</div>
                                                </td>
                                                <td class="cancel-action-cell">
                                                    @if (show.IsCancelled)
                                                    {
                                                        <div class="cancelled-note">
                                                            <strong>@show.CancellationRef</strong>
                                                            <span>@show.CancellationReason</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <form asp-action="CancelWholeTheater" method="post" class="cancel-inline-form theater-cancel-form" data-cancellation-submit-form data-confirm-text="CANCEL SHOW">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="scheduleId" value="@show.ScheduleId" />
                                                            <textarea name="cancellationReason" rows="2" maxlength="500" required placeholder="Reason"></textarea>
                                                            <input name="confirmationText" maxlength="20" required placeholder="CANCEL SHOW" />
                                                            <button type="submit" class="btn btn-danger btn-sm">Cancel Show</button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    }
                </div>
            }
        </article>
    </div>

    <article id="cancellation-relaunch" class="cancellation-panel content-section mt-4" hidden>
        <div class="cancellation-panel-head relaunch-zone">
            <div>
                <span>Part 3</span>
                <h2>Relaunch Future Cancelled Shows</h2>
                <p>Only theater cancellations can be relaunched. Individual cancelled tickets stay cancelled.</p>
            </div>
            <button type="button" class="content-section-toggle" data-content-collapse="cancellation-relaunch" aria-label="Hide Relaunch">
                ↑
            </button>
        </div>

        @if (!Model.RelaunchableShows.Any())
        {
            <div class="empty-state">No future cancelled theater shows available for relaunch.</div>
        }
        else
        {
            <div class="theater-show-groups relaunch-groups">
                @foreach (var theaterGroup in relaunchGroups)
                {
                    <section class="theater-show-group relaunch-group" data-cancellation-group>
                        <div class="theater-group-box">
                            <div>
                                <span class="theater-chip">Relaunch</span>
                                <strong>@theaterGroup.Key</strong>
                            </div>
                            <div class="sub-text">@theaterGroup.Count() future cancelled show(s)</div>
                        </div>

                        <div class="table-wrapper theater-table-wrapper">
                            <table class="table admin-table cancellation-table show-cancel-table">
                                <colgroup>
                                    <col class="show-info-col" />
                                    <col class="show-theater-col" />
                                    <col class="show-ticket-col" />
                                    <col class="cancel-form-col" />
                                </colgroup>
                                <thead>
                                    <tr>
                                        <th>Show</th>
                                        <th>Screen</th>
                                        <th>Cancelled</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var show in theaterGroup.OrderBy(x => x.ScreenName).ThenBy(x => x.StartTime))
                                    {
                                        <tr class="cancellation-data-row"
                                            data-admin-searchable
                                            data-admin-filter-row
                                            data-filter-status="Relaunchable Show"
                                            data-filter-method="@show.ShowType"
                                            data-sort-time="@SortTime(show.StartTime)"
                                            data-sort-title="@show.ShowTitle"
                                            data-sort-tickets="@show.TicketCount"
                                            data-sort-amount="@SortAmount(show.Amount)">
                                            <td>
                                                <div class="primary-text">@show.ShowTitle</div>
                                                <div class="sub-text">@show.ShowType | @ShowDateTime(show.StartTime)</div>
                                            </td>
                                            <td>
                                                <div class="primary-text">@show.VenueName</div>
                                                <div class="sub-text"><span class="screen-pill">@show.ScreenName</span></div>
                                            </td>
                                            <td>
                                                <div class="primary-text">@show.CancellationRef</div>
                                                <div class="sub-text">@show.CancelledAt</div>
                                                <div class="sub-text cancellation-reason">@show.CancellationReason</div>
                                            </td>
                                            <td class="cancel-action-cell">
                                                <form asp-action="RelaunchTheaterShow" method="post" class="cancel-inline-form theater-cancel-form relaunch-form" data-cancellation-submit-form data-confirm-text="RELAUNCH">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="cancellationId" value="@show.CancellationId" />
                                                    <textarea name="relaunchReason" rows="2" maxlength="500" required placeholder="Relaunch reason"></textarea>
                                                    <label class="relaunch-time-check">
                                                        <input type="checkbox" name="relaunchSameTime" value="true" checked data-relaunch-same-time />
                                                        Same previous time
                                                    </label>
                                                    <input type="hidden" name="relaunchSameTime" value="false" />
                                                    <input type="datetime-local" name="relaunchStartTime" value="@DateTimeLocalInput(show.StartTime)" data-relaunch-start-time disabled />
                                                    <input name="confirmationText" maxlength="20" required placeholder="RELAUNCH" />
                                                    <button type="submit" class="btn btn-success btn-sm">Relaunch</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
            </div>
        }
    </article>

    <article id="cancellation-history" class="cancellation-panel content-section mt-4" hidden>
        <div class="cancellation-panel-head">
            <div>
                <span>Part 4</span>
                <h2>Cancelled History</h2>
                <p>All admin cancellations are separated into individual booking and theater show history.</p>
            </div>
            <button type="button" class="content-section-toggle" data-content-collapse="cancellation-history" aria-label="Hide Cancelled History">
                ↑
            </button>
        </div>

        <div class="history-sections">
            <section class="history-section">
                <div class="history-section-head">
                    <h3>Individual Booking Cancellations</h3>
                    <span>@Model.IndividualCancellationHistory.Count item(s)</span>
                </div>

                <div class="table-wrapper history-table-wrapper">
                    <table class="table admin-table cancellation-table history-cancel-table">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Show</th>
                                <th>Schedule Details</th>
                                <th>Reason</th>
                                <th>Impact</th>
                                <th>Admin</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.IndividualCancellationHistory.Any())
                            {
                                <tr>
                                    <td colspan="6" class="empty-state">No individual booking cancellations saved yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.IndividualCancellationHistory)
                                {
                                    var individualScheduleRange = HistoryTimeRange(item.RelaunchOriginalStartTime, item.RelaunchOriginalEndTime);
                                    <tr class="cancellation-data-row"
                                        data-admin-searchable
                                        data-admin-filter-row
                                        data-filter-status="History Individual"
                                        data-filter-method="@item.ShowType"
                                        data-sort-time="@SortTime(item.CreatedAt)"
                                        data-sort-title="@(item.ShowTitle ?? item.CancellationRef)"
                                        data-sort-tickets="@item.AffectedTickets"
                                        data-sort-amount="0">
                                        <td>
                                            <div class="primary-text">@item.CancellationRef</div>
                                            <div class="sub-text">@item.CreatedAt</div>
                                        </td>
                                        <td>
                                            <div class="primary-text">@(item.ShowTitle ?? "Untitled Show")</div>
                                            <div class="sub-text">@(item.VenueName ?? "Venue not mapped") | @(item.ScreenName ?? "Screen not mapped")</div>
                                        </td>
                                        <td class="schedule-history-cell">
                                            <div class="primary-text">Previous show</div>
                                            <div class="sub-text">@individualScheduleRange</div>
                                            <div class="sub-text">Booking #@(item.BookingId?.ToString() ?? "N/A") | Schedule #@(item.ScheduleId?.ToString() ?? "N/A")</div>
                                        </td>
                                        <td>
                                            <div class="sub-text cancellation-reason">@item.Reason</div>
                                        </td>
                                        <td>
                                            <div class="primary-text">@item.AffectedBookings booking(s)</div>
                                            <div class="sub-text">@item.AffectedTickets ticket(s)</div>
                                        </td>
                                        <td>
                                            <div class="primary-text">@(item.RequestedByName ?? "Admin")</div>
                                            <div class="sub-text">@item.CreatedAt</div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="history-section">
                <div class="history-section-head">
                    <h3>Theater Show Cancellations</h3>
                    <span>@Model.TheaterCancellationHistory.Count item(s)</span>
                </div>

                @if (!Model.TheaterCancellationHistory.Any())
                {
                    <div class="empty-state">No theater show cancellations saved yet.</div>
                }
                else
                {
                    <div class="theater-show-groups history-theater-groups">
                        @foreach (var theaterGroup in theaterHistoryGroups)
                        {
                            <section class="theater-show-group" data-cancellation-group>
                                <div class="theater-group-box">
                                    <div>
                                        <span class="theater-chip">History</span>
                                        <strong>@theaterGroup.Key</strong>
                                    </div>
                                    <div class="sub-text">@theaterGroup.Count() cancellation record(s)</div>
                                </div>

                                <div class="table-wrapper theater-table-wrapper">
                                    <table class="table admin-table cancellation-table history-cancel-table">
                                        <thead>
                                            <tr>
                                                <th>Reference</th>
                                                <th>Show</th>
                                                <th>Status</th>
                                                <th>Schedule Details</th>
                                                <th>Reason</th>
                                                <th>Impact</th>
                                                <th>Admin</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in theaterGroup.OrderByDescending(x => x.CreatedAt))
                                            {
                                                var theaterStatusLabel = item.IsRevoked ? "Relaunched" : "Cancelled";
                                                var originalScheduleRange = HistoryTimeRange(item.RelaunchOriginalStartTime, item.RelaunchOriginalEndTime);
                                                var newScheduleRange = HistoryTimeRange(item.RelaunchNewStartTime, item.RelaunchNewEndTime);
                                                var relaunchMode = item.RelaunchSameTime ? "Same previous time" : "Changed time";
                                                var scheduleChanged = item.IsRevoked &&
                                                    item.RelaunchOriginalStartTime.HasValue &&
                                                    item.RelaunchNewStartTime.HasValue &&
                                                    (item.RelaunchOriginalStartTime.Value != item.RelaunchNewStartTime.Value ||
                                                     item.RelaunchOriginalEndTime != item.RelaunchNewEndTime);
                                                <tr class="cancellation-data-row"
                                                    data-admin-searchable
                                                    data-admin-filter-row
                                                    data-filter-status="History Theater"
                                                    data-filter-method="@item.ShowType"
                                                    data-sort-time="@SortTime(item.CreatedAt)"
                                                    data-sort-title="@(item.ShowTitle ?? item.CancellationRef)"
                                                    data-sort-tickets="@item.AffectedTickets"
                                                    data-sort-amount="0">
                                                    <td>
                                                        <div class="primary-text">@item.CancellationRef</div>
                                                        <div class="sub-text">@item.CreatedAt</div>
                                                    </td>
                                                    <td>
                                                        <div class="primary-text">@(item.ShowTitle ?? "Untitled Show")</div>
                                                        <div class="sub-text">@((item.ShowType ?? "Show")) | @(item.VenueName ?? "Venue not mapped")</div>
                                                        <div class="sub-text">@(item.ScreenName ?? "Screen not mapped") | Schedule #@(item.ScheduleId?.ToString() ?? "N/A")</div>
                                                    </td>
                                                    <td>
                                                        <span class="badge @(item.IsRevoked ? "success" : "danger")">@theaterStatusLabel</span>
                                                        @if (item.IsRevoked)
                                                        {
                                                            <div class="sub-text">Relaunched: @HistoryDateTime(item.RevokedAt)</div>
                                                            <div class="sub-text">By @(item.RevokedByName ?? "Not saved in DB")</div>
                                                        }
                                                    </td>
                                                    <td class="schedule-history-cell">
                                                        @if (item.IsRevoked)
                                                        {
                                                            <div class="primary-text">@relaunchMode</div>
                                                            <div class="schedule-history-line previous @(scheduleChanged ? "schedule-changed" : "")">
                                                                <span>Previous show</span>
                                                                <strong>@originalScheduleRange</strong>
                                                            </div>
                                                            <div class="schedule-history-line relaunch @(scheduleChanged ? "schedule-changed" : "")">
                                                                <span>Relaunch show</span>
                                                                <strong>@newScheduleRange</strong>
                                                            </div>
                                                            <div class="sub-text cancellation-reason">@(item.RelaunchReason ?? "Relaunch reason not saved in DB")</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="primary-text">Cancelled schedule</div>
                                                            <div class="sub-text">Previous show: @originalScheduleRange</div>
                                                        }
                                                    </td>
                                                    <td>
                                                        <div class="sub-text cancellation-reason">@item.Reason</div>
                                                    </td>
                                                    <td>
                                                        <div class="primary-text">@item.AffectedBookings booking(s)</div>
                                                        <div class="sub-text">@item.AffectedTickets ticket(s)</div>
                                                    </td>
                                                    <td>
                                                        <div class="primary-text">@(item.RequestedByName ?? "Admin")</div>
                                                        <div class="sub-text">@item.CreatedAt</div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }
                    </div>
                }
            </section>
        </div>
    </article>
</section>

