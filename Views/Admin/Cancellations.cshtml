@section Scripts {
    <script>
        (() => {
            const page = document.querySelector(".cancellation-admin-page");
            if (!page) {
                return;
            }

            const buttons = [...page.querySelectorAll("[data-content-target]")];
            const sections = [...page.querySelectorAll(".content-section")];
            const groups = [...page.querySelectorAll("[data-cancellation-group]")];
            const activeSectionStorageKey = "showTime.admin.cancellations.activeSection";
            const navigationEntry = performance.getEntriesByType?.("navigation")?.[0];
            const isPageRefresh = navigationEntry?.type === "reload";

            if (isPageRefresh) {
                sessionStorage.removeItem(activeSectionStorageKey);
            }

            const refreshGroups = () => {
                groups.forEach((group) => {
                    const rows = [...group.querySelectorAll("[data-admin-filter-row]")];
                    group.hidden = rows.length > 0 && rows.every((row) => row.hidden);
                });
            };

            const rememberActiveSection = (targetId) => {
                if (targetId) {
                    sessionStorage.setItem(activeSectionStorageKey, targetId);
                } else {
                    sessionStorage.removeItem(activeSectionStorageKey);
                }
            };

            const cleanPageHash = () => {
                if (window.location.hash) {
                    history.replaceState(null, "", window.location.pathname + window.location.search);
                }
            };

            const setActiveSection = (targetId, remember) => {
                const targetSection = targetId ? document.getElementById(targetId) : null;

                sections.forEach((section) => {
                    section.hidden = section !== targetSection;
                });

                buttons.forEach((button) => {
                    const isActive = button.dataset.contentTarget === targetId && Boolean(targetSection);
                    button.classList.toggle("is-active", isActive);
                    button.setAttribute("aria-expanded", isActive ? "true" : "false");

                    const arrow = button.querySelector(".content-toggle-arrow");
                    if (arrow) {
                        arrow.textContent = isActive ? "↑" : "↓";
                    }
                });

                refreshGroups();

                if (remember) {
                    rememberActiveSection(targetSection ? targetId : "");
                }

                cleanPageHash();
            };

            buttons.forEach((button) => {
                button.addEventListener("click", () => {
                    const targetId = button.dataset.contentTarget;
                    const isOpen = button.getAttribute("aria-expanded") === "true";
                    setActiveSection(isOpen ? "" : targetId, true);
                });
            });

            page.querySelectorAll("[data-content-collapse]").forEach((button) => {
                button.addEventListener("click", () => {
                    setActiveSection("", true);
                });
            });

            page.querySelectorAll("[data-relaunch-same-time]").forEach((checkbox) => {
                const form = checkbox.closest("form");
                const timeInput = form?.querySelector("[data-relaunch-start-time]");
                const syncTimeInput = () => {
                    if (!timeInput) {
                        return;
                    }

                    timeInput.disabled = checkbox.checked;
                    timeInput.required = !checkbox.checked;
                    if (checkbox.checked) {
                        timeInput.setCustomValidity("");
                    }
                };

                checkbox.addEventListener("change", syncTimeInput);
                syncTimeInput();
            });

            page.querySelectorAll("[data-cancellation-submit-form]").forEach((form) => {
                const fields = [...form.querySelectorAll("textarea, input")];
                const submitButton = form.querySelector("button[type='submit']");

                const clearValidation = () => {
                    fields.forEach((field) => field.setCustomValidity(""));
                };

                fields.forEach((field) => {
                    field.addEventListener("input", clearValidation);
                });

                form.addEventListener("submit", (event) => {
                    clearValidation();

                    const reasonField = form.querySelector("textarea[name='cancellationReason'], textarea[name='relaunchReason']");
                    if (reasonField && reasonField.value.trim().length < 5) {
                        reasonField.setCustomValidity("Enter at least 5 characters.");
                    }

                    const expectedConfirmation = form.dataset.confirmText || "";
                    const confirmationField = form.querySelector("input[name='confirmationText']");
                    if (confirmationField && expectedConfirmation &&
                        confirmationField.value.trim().toUpperCase() !== expectedConfirmation.toUpperCase()) {
                        confirmationField.setCustomValidity(`Type ${expectedConfirmation} to continue.`);
                    }

                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                        window.hideShowTimeProgressCursor?.();
                        form.reportValidity();
                        form.querySelector(":invalid")?.focus();
                        return;
                    }

                    const section = form.closest(".content-section");
                    if (section?.id) {
                        rememberActiveSection(section.id);
                    }

                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.textContent = form.classList.contains("relaunch-form")
                            ? "Launching..."
                            : "Working...";
                    }

                    window.showTimeProgressCursor?.();
                });
            });

            const hashTarget = window.location.hash.replace("#", "");
            const storedTarget = isPageRefresh ? "" : sessionStorage.getItem(activeSectionStorageKey);
            if (!isPageRefresh && hashTarget && sections.some((section) => section.id === hashTarget)) {
                setActiveSection(hashTarget, false);
            } else if (storedTarget && sections.some((section) => section.id === storedTarget)) {
                setActiveSection(storedTarget, false);
            } else {
                setActiveSection("", false);
            }

            if (groups.length > 0) {
                const observer = new MutationObserver(refreshGroups);
                observer.observe(page, {
                    subtree: true,
                    attributes: true,
                    attributeFilter: ["hidden"]
                });
            }

            refreshGroups();
        })();
    </script>
}
