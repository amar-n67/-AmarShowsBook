@model IEnumerable<AmarShowsBook.Models.Admin.VwCouponUsage>
@using AmarShowsBook.Helpers
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Coupon Used";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalRecords = ViewBag.TotalRecords ?? Model.Count();
    var reversedCount = Model.Count(x => x.UsageStatus == "REVERSED");
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Coupon Used</h1>
            <p>Coupon usage, reversals, bookings, transactions, users and show details.</p>
        </div>
        <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">Back to Dashboard</a>
    </div>

    <div class="stats-grid">
        <div class="stat-card"><span>Total Uses</span><strong>@totalRecords</strong></div>
        <div class="stat-card"><span>Visible Discount</span><strong>@CurrencyFormatter.FormatRupees(Model.Sum(x => x.DiscountAmount ?? 0))</strong></div>
        <div class="stat-card"><span>Visible Final Amount</span><strong>@CurrencyFormatter.FormatRupees(Model.Sum(x => x.FinalAmount ?? 0))</strong></div>
        <div class="stat-card"><span>Reversed</span><strong>@reversedCount</strong></div>
    </div>

    <div class="admin-detail-panel mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <input id="couponSearch" class="form-control rounded-pill" placeholder="Search coupon / user / booking / show" />
            </div>
            <div class="col-md-3">
                <select id="couponStatus" class="form-select rounded-pill">
                    <option value="">All Status</option>
                    <option value="SUCCESS">SUCCESS</option>
                    <option value="FAILED">FAILED</option>
                    <option value="REVERSED">REVERSED</option>
                </select>
            </div>
            <div class="col-md-3">
                <select id="couponShowType" class="form-select rounded-pill">
                    <option value="">All Show Types</option>
                    <option value="Movie">Movie</option>
                    <option value="Standup">Standup</option>
                    <option value="Live">Live</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                <button type="button" class="btn btn-outline-dark rounded-pill w-100" onclick="resetCouponFilters()">Reset</button>
            </div>
        </div>
    </div>

    <div class="table-wrapper coupon-usage-table">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Coupon</th>
                    <th>User</th>
                    <th>Show</th>
                    <th>Booking</th>
                    <th>Transaction</th>
                    <th>Original</th>
                    <th>Discount</th>
                    <th>Final</th>
                    <th>Status</th>
                    <th>Used At</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var item in Model)
            {
                <tr class="coupon-row" data-status="@item.UsageStatus" data-type="@item.ShowType" data-admin-searchable>
                    <td><strong>@item.CouponCode</strong></td>
                    <td>@item.UserName<br /><span class="sub-text">@item.UserEmail</span></td>
                    <td>@item.ShowName<br /><span class="sub-text">@item.ShowType @item.ShowTime?.ToString("dd MMM yyyy hh:mm tt")</span></td>
                    <td>@item.BookingRef</td>
                    <td>@item.TransactionRef</td>
                    <td>@CurrencyFormatter.FormatRupees(item.OriginalAmount)</td>
                    <td>@CurrencyFormatter.FormatRupees(item.DiscountAmount)</td>
                    <td>@CurrencyFormatter.FormatRupees(item.FinalAmount)</td>
                    <td>
                        <span class="badge @(item.UsageStatus == "REVERSED" ? "danger" : "success")">
                            @item.UsageStatus
                        </span>
                    </td>
                    <td>@item.UsedAt?.ToString("dd MMM yyyy hh:mm tt")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="pagination-area">
        @for (int i = 1; i <= totalPages; i++)
        {
            <a class="page-btn @(i == currentPage ? "active" : "")" href="/Admin/CouponUsage?page=@i">@i</a>
        }
    </div>
</section>

<script>
const couponSearch = document.getElementById("couponSearch");
const couponStatus = document.getElementById("couponStatus");
const couponShowType = document.getElementById("couponShowType");
function filterCoupons() {
    const text = (couponSearch.value || "").toLowerCase();
    const status = couponStatus.value;
    const type = normalizeCouponType(couponShowType.value);
    document.querySelectorAll(".coupon-row").forEach(row => {
        const matchesStatus = !status || row.dataset.status === status;
        const matchesType = !type || normalizeCouponType(row.dataset.type || "") === type;
        const matchesText = !text || row.innerText.toLowerCase().includes(text);
        row.hidden = !(matchesStatus && matchesType && matchesText);
    });
}
function normalizeCouponType(value) {
    const normalized = String(value || "").toLowerCase();
    if (normalized.includes("standup")) return "standup";
    if (normalized.includes("live")) return "live";
    if (normalized.includes("movie")) return "movie";
    return normalized || "";
}
function resetCouponFilters() {
    couponSearch.value = "";
    couponStatus.value = "";
    couponShowType.value = "";
    filterCoupons();
    couponSearch.focus();
}
couponSearch?.addEventListener("input", filterCoupons);
couponStatus?.addEventListener("change", filterCoupons);
couponShowType?.addEventListener("change", filterCoupons);
</script>

<style>
.coupon-usage-table {
    overflow-x: auto;
}

.coupon-usage-table table {
    min-width: 1120px;
}

.coupon-usage-table td,
.coupon-usage-table th {
    vertical-align: top;
    white-space: normal;
}
</style>
