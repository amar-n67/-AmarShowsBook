@model IEnumerable<AmarShowsBook.Models.VwBookingCompleteDetails>

@using AmarShowsBook.Helpers

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Bookings";

    int currentPage = ViewBag.CurrentPage ?? 1;

    int totalPages = ViewBag.TotalPages ?? 1;

    int totalRecords = ViewBag.TotalRecords ?? Model.Count();
    var walletAmounts = ViewBag.BookingWalletAmounts as Dictionary<long, decimal>
        ?? new Dictionary<long, decimal>();
}

<section class="admin-page">


    <div class="admin-page-header">

        <div>

            <h1 class="page-title">
                Booking Center
            </h1>

            <p class="page-subtitle">
                Monitor booking references, users,
                seats, show details, payment status,
                and booking lifecycle activity.
            </p>

        </div>

        <div class="admin-actions">

            <a href="/Admin/Dashboard"
               class="admin-back-btn admin-page-back">
                ← Back to Dashboard
            </a>

        </div>

    </div>


    <div class="stats-grid">

        <div class="stat-card">

            <span>Total Bookings</span>

            <strong>
                @totalRecords
            </strong>

        </div>

        <div class="stat-card">

            <span>Visible Rows</span>

            <strong>
                @Model.Count()
            </strong>

        </div>

        <div class="stat-card">

            <span>Total Booking Value</span>

            <strong>
                @CurrencyFormatter.FormatRupees(
                    (decimal)(ViewBag.TotalBookingValue ?? 0m))
            </strong>

        </div>

    </div>


    <div class="table-wrapper">

        <table class="table admin-table booking-table">

            <thead>
                <tr>
                    <th scope="col">Booking</th>
                    <th scope="col">User</th>
                    <th scope="col">Show</th>
                    <th scope="col">Location &amp; show time</th>
                    <th scope="col">Tickets &amp; seats</th>
                    <th scope="col">Amount breakdown</th>
                    <th scope="col">Payment</th>
                    <th scope="col">Transaction</th>
                    <th scope="col">Booking status</th>
                    <th scope="col">Lifecycle (IST)</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="empty-state">No bookings found</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var status = item.BookingStatus?.Trim().ToUpperInvariant() ?? "";
                        var statusClass = item.IsError == 1 || status is "FAILED" or "CANCELLED"
                            ? "danger"
                            : status is "CONFIRMED" or "SUCCESS" or "COMPLETED" ? "success" : "pending";
                        <tr data-filter-status="@($"{item.BookingStatus}|{item.PaymentStatus}|{item.TransactionStatus}")"
                            data-filter-method="@item.ShowType"
                            data-sort-time="@ShowTimeFormatter.SortTicks(item.BookedAt)">
                            <td>
                                <div class="primary-text">@DisplayText(item.BookingRef)</div>
                                <div class="sub-text">Booking ID: @item.BookingId</div>
                            </td>
                            <td>
                                <div class="primary-text">@DisplayText(item.UserName)</div>
                                <div class="sub-text email-cell">@DisplayText(item.UserEmail)</div>
                                <div class="sub-text">User ID: @item.UserId</div>
                            </td>
                            <td>
                                <div class="primary-text">@DisplayText(item.ShowTitle)</div>
                                <div class="sub-text">@DisplayText(item.ShowType)</div>
                            </td>
                            <td>
                                <div class="primary-text">@DisplayText(item.LocationName)</div>
                                <div class="sub-text">@ShowTimeFormatter.Format(item.StartTime, "dd MMM yyyy, hh:mm tt") IST</div>
                            </td>
                            <td>
                                <div class="primary-text">@item.TotalTickets ticket(s)</div>
                                <div class="sub-text">Seats: @DisplayText(item.SeatNumbers)</div>
                            </td>
                            <td>
                                <div class="amount-text">Total: @CurrencyFormatter.FormatRupees(item.TotalAmount)</div>
                                <div class="sub-text">Tax: @DisplayAmount(item.TaxAmount)</div>
                                <div class="sub-text">Discount: @DisplayAmount(item.DiscountAmount)</div>
                                <div class="sub-text">Wallet used: @DisplayAmount(walletAmounts.TryGetValue(item.BookingId, out var walletUsed) ? walletUsed : (decimal?)null)</div>
                                <div class="primary-text">Payable: @DisplayAmount(item.PayableAmount)</div>
                            </td>
                            <td>
                                <div class="primary-text">@DisplayText(item.PaymentStatus)</div>
                                <div class="sub-text">Method: @DisplayText(item.PaymentMethod)</div>
                                <div class="sub-text">Gateway: @DisplayText(item.GatewayName)</div>
                            </td>
                            <td>
                                <div class="primary-text">@DisplayText(item.TransactionRef)</div>
                                <div class="sub-text">Status: @DisplayText(item.TransactionStatus)</div>
                            </td>
                            <td>
                                <span class="badge @statusClass">@DisplayText(item.BookingStatus)</span>
                            </td>
                            <td>
                                <div class="created-date">Booked: @ShowTimeFormatter.Format(item.BookedAt, "dd MMM yyyy, hh:mm tt")</div>
                                <div class="sub-text">Created: @ShowTimeFormatter.Format(item.CreatedAt, "dd MMM yyyy, hh:mm tt")</div>
                                <div class="sub-text">Confirmed: @ShowTimeFormatter.Format(item.ConfirmedAt, "dd MMM yyyy, hh:mm tt", "—")</div>
                                <div class="sub-text">Cancelled: @ShowTimeFormatter.Format(item.CancelledAt, "dd MMM yyyy, hh:mm tt", "—")</div>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>

    </div>


    @await Html.PartialAsync("_AdminPagination", new AmarShowsBook.Models.ViewModels.AdminPaginationViewModel
    {
        CurrentPage = currentPage,
        TotalPages = totalPages,
        ActionUrl = "/Admin/Bookings"
    })

</section>


<style>

    .booking-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: auto !important;
        min-width: 2000px !important;
    }

    .booking-table th:first-child,
    .booking-table td:first-child {
        width: auto !important;
        min-width: 220px !important;
    }

    .booking-table th:last-child,
    .booking-table td:last-child {
        width: auto !important;
        min-width: 190px !important;
    }

    .booking-table td {
        min-width: 170px;
    }

    .booking-table th {
        background: #111827;
        color: white;
        padding: 14px;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .booking-table td {
        padding: 14px;
        vertical-align: top;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
    }

    .booking-table tbody tr:hover {
        background: #f9fafb;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        border-radius: 12px;
        background: white;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

    .stat-card span {
        display: block;
        color: #6b7280;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .stat-card strong {
        font-size: 28px;
        color: #111827;
        line-height: 1.4;
    }

    .page-title {
        margin-bottom: 6px;
        font-size: 30px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 15px;
    }

    .primary-text {
        font-weight: 600;
        color: #111827;
        word-break: break-word;
    }

    .sub-text {
        font-size: 12px;
        color: #6b7280;
        margin-top: 5px;
        line-height: 1.4;
        word-break: break-word;
    }

    .email-cell {
        word-break: break-all;
    }

    .amount-text {
        font-weight: 700;
        color: #15803d;
        font-size: 15px;
    }

    .created-date {
        font-weight: 500;
        color: #111827;
        white-space: nowrap;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .badge.success {
        background: #dcfce7;
        color: #166534;
    }

    .badge.pending {
        background: #fef3c7;
        color: #92400e;
    }

    .badge.danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #6b7280;
        font-size: 15px;
    }

    @@media(max-width: 768px) {

        .page-title {
            font-size: 24px;
        }

        .booking-table td,
        .booking-table td {
        min-width: 170px;
    }

    .booking-table th {
            font-size: 13px;
            padding: 10px;
        }

    }

</style>

@functions {
    private static string DisplayText(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string DisplayAmount(decimal? value) =>
        value.HasValue ? CurrencyFormatter.FormatRupees(value.Value) : "—";
}
