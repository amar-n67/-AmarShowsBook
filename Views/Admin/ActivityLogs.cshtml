@model IEnumerable<AmarShowsBook.Models.Admin.ActivityLog>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Activity Logs</h1>

<table class="table admin-table">

<thead>
<tr>
    <th>Action</th>
    <th>Module</th>
    <th>Status</th>
    <th>Created</th>
</tr>
</thead>

<tbody>

@foreach (var item in Model)
{
    <tr>
        <td>@item.Action</td>
        <td>@item.Module</td>
        <td>@item.Status</td>
        <td>@item.CreatedAt</td>
    </tr>
}

</tbody>

</table>

<a href="/Admin/Dashboard"
   class="btn btn-dark mt-3">
   ← Back Dashboard
</a>
