@model IEnumerable<AmarShowsBook.Models.Admin.ActivityLog>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Activity Logs";
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Activity Logs</h1>
            <p>Latest administrative events and system activity.</p>
        </div>
    </div>

<div class="table-wrapper">
<table class="table admin-table">

<thead>
<tr>
    <th>Action</th>
    <th>Module</th>
    <th>Status</th>
    <th>Created</th>
</tr>
</thead>

<tbody>

@foreach (var item in Model)
{
    <tr>
        <td>@item.Action</td>
        <td>@item.Module</td>
        <td>@item.Status</td>
        <td>@item.CreatedAt</td>
    </tr>
}

</tbody>

</table>
</div>
</section>
