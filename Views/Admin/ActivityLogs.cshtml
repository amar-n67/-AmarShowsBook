
@model List<AmarShowsBook.Models.Admin.VwEnterpriseActivityLog>

@{
    ViewData["Title"] = "Activity Logs";

    int currentPage = ViewBag.CurrentPage ?? 1;

    int totalPages = ViewBag.TotalPages ?? 1;

    int rowNo = ((currentPage - 1) * 50) + 1;
}

<section class="activity-page">

    <!-- ===================================================== -->
    <!-- HUMAN COMMENT:
         PAGE HEADER
    -->
    <!-- ===================================================== -->

    <div class="page-header">

        <div>

            <h1>Enterprise Activity Logs</h1>

            <p>
                Complete system monitoring and audit center
            </p>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- HUMAN COMMENT:
         SEARCH BAR
    -->
    <!-- ===================================================== -->

    <div class="search-box">

        <input
            type="text"
            id="logSearch"
            placeholder="Search logs..."
            onkeyup="searchLogs()" />

    </div>

    <!-- ===================================================== -->
    <!-- HUMAN COMMENT:
         LOG TABLE
    -->
    <!-- ===================================================== -->

    <div class="table-wrapper">

        <table class="log-table"
               id="logsTable">

            <thead>

                <tr>

                    <th>#</th>

                    <th>Time</th>

                    <th>Module</th>

                    <th>Action</th>

                    <th>User</th>

                    <th>Status</th>

                    <th>Description</th>

                    <th>IP</th>

                    <th>Error</th>

                </tr>

            </thead>

            <tbody>

            @if (!Model.Any())
            {
                <tr>

                    <td colspan="9"
                        class="empty-row">

                        No logs found

                    </td>

                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>@rowNo</td>

                        <td>

                            @item.ActivityTime
                                .ToString("dd MMM yyyy")

                            <div class="sub-text">

                                @item.ActivityTime
                                    .ToString("hh:mm tt")

                            </div>

                        </td>

                        <td>@item.Module</td>

                        <td>@item.ActionType</td>

                        <td>

                            <strong>
                                @item.UserName
                            </strong>

                            <div class="sub-text">

                                @item.UserEmail

                            </div>

                        </td>

                        <td>

                            <span class="
                                badge
                                @(item.Status == "SUCCESS"
                                    ? "success"
                                    : item.Status == "FAILED"
                                        ? "danger"
                                        : "warning")">

                                @item.Status

                            </span>

                        </td>

                        <td>

                            @item.Description

                        </td>

                        <td>

                            @item.IpAddress

                        </td>

                        <td>

                            @(string.IsNullOrWhiteSpace(item.ErrorMessage)
                                ? "NA"
                                : item.ErrorMessage)

                        </td>

                    </tr>

                    rowNo++;
                }
            }

            </tbody>

        </table>

    </div>

    <!-- ===================================================== -->
    <!-- HUMAN COMMENT:
         PAGINATION
    -->
    <!-- ===================================================== -->

    <div class="pagination-area">

        @for (int i = 1; i <= totalPages; i++)
        {
            <a href="/Admin/ActivityLogs?page=@i"
               class="page-btn @(i == currentPage ? "active" : "")">

                @i

            </a>
        }

    </div>

</section>

<style>

.activity-page{
    padding:24px;
}

.page-header{
    margin-bottom:24px;
}

.page-header h1{
    font-size:38px;
    font-weight:700;
}

.page-header p{
    color:#64748b;
}

.search-box{
    margin-bottom:18px;
}

.search-box input{
    width:100%;
    padding:14px;
    border-radius:10px;
    border:1px solid #cbd5e1;
}

.table-wrapper{
    overflow:auto;
    border-radius:12px;
}

.log-table{
    width:100%;
    border-collapse:collapse;
    background:white;
}

.log-table thead{
    background:#e2e8f0;
}

.log-table th{
    padding:16px;
    text-align:left;
}

.log-table td{
    padding:16px;
    border-top:1px solid #e2e8f0;
    vertical-align:top;
}

.sub-text{
    font-size:12px;
    color:#64748b;
    margin-top:4px;
}

.badge{
    padding:6px 10px;
    border-radius:999px;
    font-size:12px;
    font-weight:700;
}

.success{
    background:#dcfce7;
    color:#166534;
}

.danger{
    background:#fee2e2;
    color:#991b1b;
}

.warning{
    background:#fef3c7;
    color:#92400e;
}

.pagination-area{
    margin-top:24px;
    display:flex;
    gap:10px;
    flex-wrap:wrap;
}

.page-btn{
    padding:10px 14px;
    border-radius:8px;
    background:#e2e8f0;
    text-decoration:none;
    color:black;
}

.page-btn.active{
    background:#2563eb;
    color:white;
}

.empty-row{
    text-align:center;
    padding:40px;
    color:#64748b;
}

</style>

<script>

function searchLogs() {

    let input =
        document.getElementById("logSearch");

    let filter =
        input.value.toLowerCase();

    let table =
        document.getElementById("logsTable");

    let tr =
        table.getElementsByTagName("tr");

    for (let i = 1; i < tr.length; i++) {

        let txt =
            tr[i].innerText.toLowerCase();

        tr[i].style.display =
            txt.includes(filter)
                ? ""
                : "none";
    }
}

</script>