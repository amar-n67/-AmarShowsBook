@model List<AmarShowsBook.Models.Admin.VwEnterpriseActivityLog>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Activity Logs";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count;
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Enterprise Activity Logs</h1>
            <p>System activity, bookings, transactions, errors, user actions, and audit events.</p>
        </div>

        <div class="admin-actions">
            <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">← Back to Dashboard</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <span>Total Logs</span>
            <strong>@totalRecords</strong>
        </div>
        <div class="stat-card">
            <span>Visible Rows</span>
            <strong>@Model.Count</strong>
        </div>
        <div class="stat-card">
            <span>Errors Visible</span>
            <strong>@Model.Count(x => !string.IsNullOrWhiteSpace(x.error_message))</strong>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Module</th>
                    <th>Action</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Reference</th>
                    <th>Status</th>
                    <th>Description</th>
                    <th>Error</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.activity_time.ToString("dd MMM yyyy")
                                <div class="sub-text">@item.activity_time.ToString("hh:mm tt")</div>
                            </td>

                            <td>
                                <span class="badge warning">
                                    @(string.IsNullOrWhiteSpace(item.module) ? "NA" : item.module)
                                </span>
                            </td>

                            <td>@(string.IsNullOrWhiteSpace(item.action) ? "NA" : item.action)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.user_name) ? "NA" : item.user_name)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.user_email) ? "NA" : item.user_email)</td>
                            <td>@(string.IsNullOrWhiteSpace(item.reference_no) ? "NA" : item.reference_no)</td>

                            <td>
                                <span class="badge @(item.status == "SUCCESS" ? "success" : item.status == "FAILED" ? "danger" : "warning")">
                                    @(string.IsNullOrWhiteSpace(item.status) ? "NA" : item.status)
                                </span>
                            </td>

                            <td>@(string.IsNullOrWhiteSpace(item.description) ? "NA" : item.description)</td>
                            <td class="admin-error-cell">
                                @(string.IsNullOrWhiteSpace(item.error_message) ? "NA" : item.error_message)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="empty-state">No activity logs found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Human Comment: Activity logs are capped at 50 rows per page. -->
    <div class="pagination-area">
        @for (int i = 1; i <= totalPages; i++)
        {
            <a class="page-btn @(i == currentPage ? "active" : "")"
               href="/Admin/ActivityLogs?page=@i">
                @i
            </a>
        }
    </div>
</section>
