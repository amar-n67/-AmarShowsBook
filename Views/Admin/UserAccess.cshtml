@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Access";
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>User Access Management</h1>
            <p>Review user roles, permissions, and access actions.</p>
        </div>
        <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">← Back to Dashboard</a>
    </div>

<div class="card p-4">

    <table class="table">

        <thead>

            <tr>
                <th>User</th>
                <th>Role</th>
                <th>Permissions</th>
                <th>Actions</th>
            </tr>

        </thead>

        <tbody>

            <tr>

                <td>Demo User</td>

                <td>STANDARD USER</td>

                <td>
                    VIEW BOOKINGS
                </td>

                <td>

                    <button class="btn btn-primary">
                        Grant Access
                    </button>

                    <button class="btn btn-warning">
                        Edit Access
                    </button>

                    <button class="btn btn-danger">
                        Remove Access
                    </button>

                </td>

            </tr>

        </tbody>

    </table>

</div>
</section>
