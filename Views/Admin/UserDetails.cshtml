@model AmarShowsBook.Models.ViewModels.AdminUserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
}

<section class="admin-user-page">

    <!-- TOP BAR -->

    <div class="top-bar">

        <h1>User Details</h1>

        <a href="/Admin/Users" class="back-btn">
            ← Back Users
        </a>

    </div>

    <!-- PROFILE SECTION -->

    <div class="profile-card">

        <img src="@(string.IsNullOrWhiteSpace(Model.ProfileImagePath)
            ? "/images/default-user.png"
            : Model.ProfileImagePath)"
             class="profile-image" />

        <div class="profile-info">

            <h2>@Model.Name</h2>

            <p>@Model.Email</p>

            <p>@Model.Mobile</p>

            <span class="status-badge">

                @(Model.IsActive ? "ACTIVE" : "DISABLED")

            </span>

        </div>

    </div>

    <!-- STATS -->

    <div class="stats-grid">

        <div class="card">
            <span>Wallet</span>
            <strong>₹@Model.WalletBalance</strong>
        </div>

        <div class="card">
            <span>Total Transactions</span>
            <strong>@Model.TotalTransactions</strong>
        </div>

        <div class="card success">
            <span>Success</span>
            <strong>@Model.SuccessTransactions</strong>
        </div>

        <div class="card danger">
            <span>Failed</span>
            <strong>@Model.FailedTransactions</strong>
        </div>

        <div class="card warning">
            <span>Pending</span>
            <strong>@Model.PendingTransactions</strong>
        </div>

        <div class="card">
            <span>Total Spent</span>
            <strong>₹@Model.TotalSpent</strong>
        </div>

    </div>

    <!-- DETAILS -->

    <div class="details-grid">

        <!-- ACCOUNT INFO -->

        <div class="detail-card">

            <h3>Account Information</h3>

            <p>
                <strong>Registered:</strong>
                @Model.RegisteredAt
            </p>

            <p>
                <strong>Last Login:</strong>
                @Model.LastLoginAt
            </p>

            <p>
                <strong>Language:</strong>
                @Model.Language
            </p>

            <p>
                <strong>Genre:</strong>
                @Model.Genre
            </p>

        </div>

        <!-- ADDRESS -->

        <div class="detail-card">

            <h3>Address</h3>

            <p>@Model.Address</p>

            <p>@Model.District</p>

            <p>@Model.State</p>

            <p>@Model.Country</p>

            <p>@Model.Pincode</p>

        </div>

        <!-- LAST TRANSACTION -->

        <div class="detail-card">

            <h3>Last Transaction</h3>

            <p>
                <strong>Ref:</strong>
                @Model.LastTransactionRef
            </p>

            <p>
                <strong>Status:</strong>
                @Model.LastTransactionStatus
            </p>

            <p>
                <strong>Date:</strong>
                @Model.LastTransactionDate
            </p>

        </div>

    </div>

    <!-- ACTIVITY -->

    <div class="activity-card">

        <h3>Recent Activity</h3>

        <ul>

            @foreach (var activity in Model.RecentActivities)
            {
                <li>@activity</li>
            }

        </ul>

    </div>

</section>

<style>

.admin-user-page{
    padding:24px;
    background:#f8fafc;
    min-height:100vh;
}

/* TOP BAR */

.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:24px;
}

.top-bar h1{
    font-size:42px;
    font-weight:700;
    color:#111827;
}

.back-btn{
    padding:12px 18px;
    background:#1e293b;
    color:white;
    border-radius:10px;
    text-decoration:none;
    font-weight:600;
    transition:0.3s;
}

.back-btn:hover{
    background:#0f172a;
    color:white;
}

/* PROFILE */

.profile-card{
    display:flex;
    gap:24px;
    align-items:center;
    background:linear-gradient(135deg,#020617,#0f172a,#1e3a8a);
    padding:28px;
    border-radius:20px;
    margin-bottom:24px;
    color:white;
    box-shadow:0 10px 30px rgba(0,0,0,0.25);
}

.profile-image{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
    border:4px solid rgba(255,255,255,0.2);
}

.profile-info h2{
    margin-bottom:10px;
    font-size:38px;
    color:white;
}

.profile-info p{
    margin-bottom:8px;
    color:#e2e8f0;
    font-size:16px;
}

.status-badge{
    display:inline-block;
    margin-top:12px;
    background:#16a34a;
    color:white;
    padding:8px 16px;
    border-radius:999px;
    font-size:14px;
    font-weight:700;
}

/* STATS */

.stats-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-bottom:24px;
}

.card{
    background:white;
    padding:22px;
    border-radius:16px;
    border:1px solid #dbeafe;
    box-shadow:0 4px 10px rgba(0,0,0,0.05);
}

.card span{
    color:#475569;
    font-size:15px;
}

.card strong{
    display:block;
    margin-top:12px;
    font-size:40px;
    font-weight:700;
    color:#0f172a;
}

.success{
    border-left:5px solid #22c55e;
}

.danger{
    border-left:5px solid #ef4444;
}

.warning{
    border-left:5px solid #f59e0b;
}

/* DETAILS */

.details-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-bottom:24px;
}

.detail-card{
    background:linear-gradient(135deg,#020617,#0f172a,#1e3a8a);
    padding:24px;
    border-radius:18px;
    color:white;
    box-shadow:0 10px 25px rgba(0,0,0,0.2);
}

.detail-card h3{
    margin-bottom:18px;
    font-size:28px;
    color:white;
}

.detail-card p{
    margin-bottom:14px;
    color:#e2e8f0;
    line-height:1.6;
}

.detail-card strong{
    color:white;
}

/* ACTIVITY */

.activity-card{
    background:linear-gradient(135deg,#020617,#0f172a,#1e3a8a);
    padding:24px;
    border-radius:18px;
    color:white;
    box-shadow:0 10px 25px rgba(0,0,0,0.2);
}

.activity-card h3{
    margin-bottom:18px;
    font-size:30px;
    color:white;
}

.activity-card ul{
    margin-top:14px;
    padding-left:20px;
}

.activity-card li{
    margin-bottom:14px;
    color:#e2e8f0;
    font-size:16px;
}

/* MOBILE */

@@media(max-width:900px){

    .stats-grid,
    .details-grid{
        grid-template-columns:1fr;
    }

    .profile-card{
        flex-direction:column;
        text-align:center;
    }

    .top-bar{
        flex-direction:column;
        gap:16px;
        align-items:flex-start;
    }

    .card strong{
        font-size:32px;
    }

}

</style>