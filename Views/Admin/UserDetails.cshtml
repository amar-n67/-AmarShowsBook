@model AmarShowsBook.Models.ViewModels.AdminUserDetailsViewModel
@using AmarShowsBook.Helpers

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Details";
}

<section class="admin-user-page">

    <!-- TOP BAR -->

    <div class="top-bar">

        <h1>User Details</h1>

        <a href="/Admin/Users" class="back-btn">
            ← Back Users
        </a>

    </div>

    <!-- PROFILE SECTION -->

    <div class="profile-card">

        <img src="@(string.IsNullOrWhiteSpace(Model.ProfileImagePath)
            ? "/images/default-user.png"
            : Model.ProfileImagePath)"
             class="profile-image" />

        <div class="profile-info">

            <h2>@Model.Name</h2>

            <p>@Model.Email</p>

            <p>@Model.Mobile</p>

            <span class="status-badge">

                @(Model.IsActive ? "ACTIVE" : "DISABLED")

            </span>

        </div>

    </div>

    <!-- STATS -->

    <div class="stats-grid">

        <div class="card">
            <span>Wallet</span>
            <strong>@CurrencyFormatter.FormatRupees(Model.WalletBalance)</strong>
        </div>

        <div class="card">
            <span>Total Transactions</span>
            <strong>@Model.TotalTransactions</strong>
        </div>

        <div class="card success">
            <span>Success</span>
            <strong>@Model.SuccessTransactions</strong>
        </div>

        <div class="card danger">
            <span>Failed</span>
            <strong>@Model.FailedTransactions</strong>
        </div>

        <div class="card warning">
            <span>Pending</span>
            <strong>@Model.PendingTransactions</strong>
        </div>

        <div class="card">
            <span>Total Spent</span>
            <strong>@CurrencyFormatter.FormatRupees(Model.TotalSpent)</strong>
        </div>

    </div>

    <!-- DETAILS -->

    <div class="details-grid">
        <div class="detail-card">

    <h3>User Access</h3>

    <ul class="access-list">

        @foreach (var access in Model.UserAccess)
        {
            <li>@access</li>
        }

    </ul>

</div>

        <!-- ACCOUNT INFO -->

        <div class="detail-card">

            <h3>Account Information</h3>

            <p>
                @(Model.RegisteredAt?.ToString("dd MMM yyyy hh:mm tt") ?? "NA")
            </p>

            <p>
                <strong>Last Login:</strong>
                @(Model.LastLoginAt?.ToString("dd MMM yyyy hh:mm tt") ?? "NA")
            </p>

            <p>
                <strong>Language:</strong>
                @Model.Language
            </p>

            <p>
                <strong>Genre:</strong>
                @Model.Genre
            </p>

        </div>

        <!-- ADDRESS -->

        <div class="detail-card">

            <h3>Address</h3>

           @(string.IsNullOrWhiteSpace(Model.Address) ? "NA" : Model.Address)

            @Model.Address
@Model.District
@Model.State
@Model.Country
@Model.Pincode
@Model.Language
@Model.Genre
@Model.Email
@Model.Mobile
@Model.LastTransactionRef
@Model.LastTransactionStatus

        </div>

        <!-- LAST TRANSACTION -->

        <div class="detail-card">

            <h3>Last Transaction</h3>

            <p>
                <strong>Ref:</strong>
                @Model.LastTransactionRef
            </p>

            <p>
                <strong>Status:</strong>
                @Model.LastTransactionStatus
            </p>

            <p>
               @(Model.LastTransactionDate?.ToString("dd MMM yyyy hh:mm tt") ?? "NA")
            </p>

        </div>

    </div>

    <!-- ACTIVITY -->

    <div class="activity-card">

        <h3>Recent Activity</h3>

        <ul>

            @foreach (var activity in Model.RecentActivities)
            {
                <li>@activity</li>
            }

        </ul>

    </div>

</section>
@* CSS starts here *@
<style>
    .access-list{
    margin-top:12px;
    padding-left:18px;
}

.access-list li{
    margin-bottom:12px;
    color:#475569;
    font-size:15px;
    font-weight:600;
}

.admin-user-page{
    padding:24px;
    background:#f1f5f9;
    min-height:100vh;
    color:#0f172a;
}

/* TOP BAR */

.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:24px;
}

.top-bar h1{
    font-size:42px;
    font-weight:700;
    color:#0f172a;
}

.back-btn{
    padding:12px 18px;
    background:#2563eb;
    color:white;
    border-radius:10px;
    text-decoration:none;
    font-weight:600;
    transition:0.3s;
    box-shadow:0 4px 12px rgba(37,99,235,0.2);
}

.back-btn:hover{
    background:#1d4ed8;
    color:white;
}

/* PROFILE */

.profile-card{
    display:flex;
    gap:24px;
    align-items:center;
    background:white;
    padding:28px;
    border-radius:22px;
    margin-bottom:24px;
    border:1px solid #dbeafe;
    box-shadow:0 10px 30px rgba(15,23,42,0.08);
}

.profile-image{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
    border:5px solid #dbeafe;
}

.profile-info h2{
    margin-bottom:10px;
    font-size:38px;
    color:#0f172a;
}

.profile-info p{
    margin-bottom:8px;
    color:#475569;
    font-size:16px;
}

.status-badge{
    display:inline-block;
    margin-top:12px;
    background:#dcfce7;
    color:#166534;
    padding:8px 16px;
    border-radius:999px;
    font-size:14px;
    font-weight:700;
}

/* STATS */

.stats-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-bottom:24px;
}

.card{
    background:white;
    padding:24px;
    border-radius:18px;
    border:1px solid #e2e8f0;
    box-shadow:0 4px 14px rgba(15,23,42,0.06);
}

.card span{
    color:#64748b;
    font-size:15px;
    font-weight:600;
}

.card strong{
    display:block;
    margin-top:14px;
    font-size:40px;
    font-weight:700;
    color:#0f172a;
}

.success{
    border-left:5px solid #22c55e;
}

.danger{
    border-left:5px solid #ef4444;
}

.warning{
    border-left:5px solid #f59e0b;
}

/* DETAILS */

.details-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-bottom:24px;
}

.detail-card{
    background:white;
    padding:24px;
    border-radius:20px;
    border:1px solid #dbeafe;
    box-shadow:0 10px 25px rgba(15,23,42,0.06);
}

.detail-card h3{
    margin-bottom:18px;
    font-size:28px;
    color:#0f172a;
}

.detail-card p{
    margin-bottom:14px;
    color:#475569;
    line-height:1.7;
}

.detail-card strong{
    color:#0f172a;
}

/* ACTIVITY */

.activity-card{
    background:white;
    padding:24px;
    border-radius:20px;
    border:1px solid #dbeafe;
    box-shadow:0 10px 25px rgba(15,23,42,0.06);
}

.activity-card h3{
    margin-bottom:18px;
    font-size:30px;
    color:#0f172a;
}

.activity-card ul{
    margin-top:14px;
    padding-left:20px;
}

.activity-card li{
    margin-bottom:14px;
    color:#475569;
    font-size:16px;
}

/* MOBILE */

@@media(max-width:900px){

    .stats-grid,
    .details-grid{
        grid-template-columns:1fr;
    }

    .profile-card{
        flex-direction:column;
        text-align:center;
    }

    .top-bar{
        flex-direction:column;
        gap:16px;
        align-items:flex-start;
    }

    .card strong{
        font-size:32px;
    }

}

</style>
