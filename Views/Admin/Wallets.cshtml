@model IEnumerable<AmarShowsBook.Models.Admin.VwWalletSummary>
@using AmarShowsBook.Helpers

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Wallets";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count();
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Wallets</h1>
            <p>Wallet balances, blocked balances, and loyalty points by user.</p>
        </div>
        <div class="admin-actions">
            <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">← Back to Dashboard</a>
        </div>
    </div>

<div class="stats-grid">
    <div class="stat-card">
        <span>Total Wallet Rows</span>
        <strong>@totalRecords</strong>
    </div>
    <div class="stat-card">
        <span>Visible Balance</span>
        <strong>@CurrencyFormatter.FormatRupees(Model.Sum(x => x.WalletBalance))</strong>
    </div>
    <div class="stat-card">
        <span>Visible Blocked</span>
        <strong>@CurrencyFormatter.FormatRupees(Model.Sum(x => x.BlockedBalance))</strong>
    </div>
</div>

<div class="table-wrapper">
<table class="table admin-table">

<thead>
<tr>
    <th>User</th>
    <th>Balance</th>
    <th>Blocked</th>
    <th>Loyalty</th>
</tr>
</thead>

<tbody>

@foreach (var item in Model)
{
    <tr>
        <td>@item.UserName</td>
        <td>@CurrencyFormatter.FormatRupees(item.WalletBalance)</td>
        <td>@CurrencyFormatter.FormatRupees(item.BlockedBalance)</td>
        <td>@item.LoyaltyPoints</td>
    </tr>
}

</tbody>

</table>
</div>

<div class="pagination-area">
    @for (int i = 1; i <= totalPages; i++)
    {
        <a class="page-btn @(i == currentPage ? "active" : "")"
           href="/Admin/Wallets?page=@i">
            @i
        </a>
    }
</div>
</section>
