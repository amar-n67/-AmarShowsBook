@model IEnumerable<AmarShowsBook.Models.Admin.VwWalletSummary>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Wallets</h1>

<table class="table admin-table">

<thead>
<tr>
    <th>User</th>
    <th>Balance</th>
    <th>Blocked</th>
    <th>Loyalty</th>
</tr>
</thead>

<tbody>

@foreach (var item in Model)
{
    <tr>
        <td>@item.UserName</td>
        <td>@item.WalletBalance</td>
        <td>@item.BlockedBalance</td>
        <td>@item.LoyaltyPoints</td>
    </tr>
}

</tbody>

</table>

<a href="/Admin/Dashboard"
   class="btn btn-dark mt-3">
   ← Back Dashboard
</a>
<a href="/Admin/Dashboard"
   class="btn btn-dark mt-3">
   ← Back Dashboard
</a>