@model IEnumerable<AmarShowsBook.Models.Admin.VwWalletSummary>

@using AmarShowsBook.Helpers

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Wallets";

    var walletStatusHistory =
        ViewBag.WalletStatusHistory as Dictionary<long, List<AmarShowsBook.Models.Admin.WalletStatusHistory>>
        ?? new Dictionary<long, List<AmarShowsBook.Models.Admin.WalletStatusHistory>>();

    int currentPage = ViewBag.CurrentPage ?? 1;

    int totalPages = ViewBag.TotalPages ?? 1;

    int totalRecords = ViewBag.TotalRecords ?? Model.Count();
}

<section class="admin-page">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="admin-page-header">

        <div>

            <h1 class="page-title">
                Wallet Management
            </h1>

            <p class="page-subtitle">
                Monitor wallet balances, blocked balances,
                loyalty points, and financial activity across users.
            </p>

        </div>

        <div class="admin-actions">

            <a href="/Admin/Dashboard"
               class="admin-back-btn admin-page-back">
                ← Back to Dashboard
            </a>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- STATS -->
    <!-- ===================================================== -->

    <div class="stats-grid">

        <div class="stat-card">
            <span>Total Wallet Rows</span>
            <strong>@totalRecords</strong>
        </div>

        <div class="stat-card">
            <span>Total Wallet Balance</span>
            <strong>
                @CurrencyFormatter.FormatRupees(
                    Model.Sum(x => x.WalletBalance))
            </strong>
        </div>

        <div class="stat-card">
            <span>Total Blocked Balance</span>
            <strong>
                @CurrencyFormatter.FormatRupees(
                    Model.Sum(x => x.BlockedBalance))
            </strong>
        </div>

        <div class="stat-card">
            <span>Total Used Wallet</span>
            <strong>
                @CurrencyFormatter.FormatRupees(
                    Model.Sum(x => x.TotalDebits))
            </strong>
        </div>

    </div>

    <!-- ===================================================== -->
    <!-- TABLE -->
    <!-- ===================================================== -->

    <div class="table-wrapper">

        <table class="table admin-table wallet-table">

            <thead>

                <tr>

                    <th style="min-width:240px;">
                        User
                    </th>

                    <th style="min-width:180px;">
                        Wallet Balance
                    </th>

                    <th style="min-width:180px;">
                        Blocked Balance
                    </th>

                    <th style="min-width:180px;">
                        Used Wallet Balance
                    </th>

                    <th style="min-width:140px;">
                        Loyalty Points
                    </th>

                    <th style="min-width:180px;">
                        Wallet Status
                    </th>

                    <th style="min-width:260px;">
                        Suspension Reason
                    </th>

                    <th style="min-width:200px;">
                        Last Transaction
                    </th>

                    <th style="min-width:180px;">
                        Action
                    </th>

                    <th style="min-width:280px;">
                        History
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="10"
                            class="empty-state">
                            No wallet records found
                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr id="wallet-@item.WalletId" data-filter-status="@item.WalletStatus">

                            <!-- USER -->

                            <td>

                                <div class="user-name">
                                    @(string.IsNullOrWhiteSpace(item.UserName)
                                        ? "NA"
                                        : item.UserName)
                                </div>

                                <div class="sub-text email-cell">
                                    @(string.IsNullOrWhiteSpace(item.UserEmail)
                                        ? "NA"
                                        : item.UserEmail)
                                </div>

                            </td>

                            <!-- WALLET BALANCE -->

                            <td>

                                <div class="amount-text success-text">
                                   @CurrencyFormatter.FormatRupees(item.WalletBalance)
                                </div>

                            </td>

                            <!-- BLOCKED BALANCE -->

                            <td>

                                <div class="amount-text danger-text">
                                    @CurrencyFormatter.FormatRupees(item.BlockedBalance)
                                </div>

                            </td>

                            <!-- USED WALLET BALANCE -->

                            <td>

                                <div class="amount-text warning-text">
                                    @CurrencyFormatter.FormatRupees(item.TotalDebits)
                                </div>

                            </td>

                            <!-- LOYALTY -->

                            <td>

                                <span class="loyalty-badge">
                                    @item.LoyaltyPoints
                                </span>

                            </td>

                            <!-- STATUS -->

                            <td>

                                @if (item.WalletStatus == "ACTIVE")
                                {
                                    <span class="badge success">
                                        ACTIVE
                                    </span>
                                }
                                else if (item.WalletStatus == "SUSPENDED")
                                {
                                    <span class="badge danger">
                                        SUSPENDED
                                    </span>
                                }
                                else
                                {
                                    <span class="badge warning">
                                        @(string.IsNullOrWhiteSpace(item.WalletStatus)
                                            ? "NA"
                                            : item.WalletStatus)
                                    </span>
                                }

                                @{
                                    var historyRows =
                                        walletStatusHistory.TryGetValue(item.WalletId, out var foundHistory)
                                            ? foundHistory
                                            : new List<AmarShowsBook.Models.Admin.WalletStatusHistory>();
                                }

                            </td>

                            <!-- SUSPENSION REASON -->

                            <td>

                                @if (item.WalletStatus == "SUSPENDED")
                                {
                                    <div class="reason-box">
                                        @(string.IsNullOrWhiteSpace(item.SuspensionReason)
                                            ? "No suspension reason recorded."
                                            : item.SuspensionReason)
                                    </div>

                                    <div class="sub-text">
                                        Suspended:
                                        @(item.SuspendedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "NA")
                                    </div>

                                    <div class="sub-text">
                                        By:
                                        @(string.IsNullOrWhiteSpace(item.SuspendedBy)
                                            ? "Admin"
                                            : item.SuspendedBy)
                                    </div>
                                }
                                else if(item.ReactivatedAt != null)
                                {
                                    <div class="reason-box success-reason">
                                        @(string.IsNullOrWhiteSpace(item.ReactivationReason)
                                            ? "No reactivation reason recorded."
                                            : item.ReactivationReason)
                                    </div>

                                    <div class="sub-text">
                                        Reactivated:
                                        @item.ReactivatedAt?.ToString("dd MMM yyyy hh:mm tt")
                                    </div>

                                    <div class="sub-text">
                                        By:
                                        @(string.IsNullOrWhiteSpace(item.ReactivatedBy)
                                            ? "Admin"
                                            : item.ReactivatedBy)
                                    </div>
                                }
                                else
                                {
                                    <span class="sub-text">
                                        Not suspended
                                    </span>
                                }

                            </td>

                            <!-- LAST TRANSACTION -->

                            <td>

                                @if (item.LastTransactionAt != null)
                                {
                                    <div class="created-date">
                                        @item.LastTransactionAt?
                                            .ToString("dd MMM yyyy")
                                    </div>

                                    <div class="sub-text">
                                        @item.LastTransactionAt?
                                            .ToString("hh:mm tt")
                                    </div>
                                }
                                else
                                {
                                    <span class="sub-text">
                                        No Transactions
                                    </span>
                                }

                            </td>

                            <!-- ACTION -->

                            <td>

                                @if (item.WalletStatus == "SUSPENDED")
                                {
                                    <details class="wallet-reactivate-panel">
                                        <summary>
                                            Reactivate
                                        </summary>

                                        <form method="post" action="/Admin/ReactivateWallet" class="wallet-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="walletId" value="@item.WalletId" />
                                            <textarea
                                                name="reactivationReason"
                                                rows="3"
                                                maxlength="500"
                                                required
                                                placeholder="Mandatory reactivation reason"></textarea>
                                            <button type="submit" class="wallet-reactivate-btn">
                                                Save Reactivation
                                            </button>
                                        </form>
                                    </details>
                                }
                                else
                                {
                                    <details class="wallet-suspend-panel">
                                        <summary>
                                            Suspend
                                        </summary>

                                        <form method="post" action="/Admin/SuspendWallet" class="wallet-action-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="walletId" value="@item.WalletId" />
                                            <textarea
                                                name="suspensionReason"
                                                rows="3"
                                                maxlength="500"
                                                required
                                                placeholder="Mandatory suspension reason"></textarea>
                                            <button type="submit" class="wallet-suspend-btn">
                                                Save Suspension
                                            </button>
                                        </form>
                                    </details>
                                }

                            </td>

                            <!-- HISTORY -->

                            <td>

                                <details class="wallet-history-panel">
                                    <summary>
                                        History (@historyRows.Count)
                                    </summary>

                                    @if(!historyRows.Any())
                                    {
                                        <div class="wallet-history-empty">
                                            No wallet action history yet.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="wallet-history-list">
                                            @foreach(var history in historyRows)
                                            {
                                                <div class="wallet-history-item">
                                                    <div class="wallet-history-top">
                                                        <span class="history-action @history.ActionType.ToLowerInvariant()">
                                                            @history.ActionType
                                                        </span>
                                                        <strong>
                                                            @(history.PreviousStatus ?? "NA") → @history.NewStatus
                                                        </strong>
                                                    </div>
                                                    <p>
                                                        @history.ActionReason
                                                    </p>
                                                    <small>
                                                        @history.CreatedAt.ToString("dd MMM yyyy hh:mm tt")
                                                        · By @(string.IsNullOrWhiteSpace(history.ActionBy) ? "Admin" : history.ActionBy)
                                                        · Balance @CurrencyFormatter.FormatRupees(history.WalletBalance)
                                                    </small>
                                                </div>
                                            }
                                        </div>
                                    }
                                </details>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

    <!-- ===================================================== -->
    <!-- PAGINATION -->
    <!-- ===================================================== -->

    <div class="pagination-area">

        @for (int i = 1; i <= totalPages; i++)
        {
            <a href="/Admin/Wallets?page=@i"
               class="page-btn @(i == currentPage ? "active" : "")">
                @i
            </a>
        }

    </div>

</section>

<!-- ===================================================== -->
<!-- PAGE CSS -->
<!-- ===================================================== -->

<style>

    .wallet-table {
        width: 100%;
        border-collapse: collapse;
    }

    .wallet-table th {
        background: linear-gradient(180deg,#f8fafc,#e8eef7);
        color: #111827;
        padding: 14px;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
        border-bottom: 1px solid #cbd5e1;
        box-shadow: inset 0 -1px 0 rgba(15,23,42,.05);
    }

    .wallet-table td {
        padding: 14px;
        vertical-align: top;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
    }

    .wallet-table tbody tr:hover {
        background: #f9fafb;
    }

    .wallet-table tr:target {
        outline: 3px solid rgba(239,68,68,.28);
        outline-offset: -3px;
        background: #fff7ed;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        border-radius: 12px;
        background: white;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

    .stat-card span {
        display: block;
        color: #6b7280;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .stat-card strong {
        font-size: 26px;
        color: #111827;
        line-height: 1.4;
    }

    .reason-box {
        padding: 10px 12px;
        border-radius: 10px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        font-weight: 800;
        line-height: 1.35;
        max-width: 320px;
    }

    .reason-box.success-reason {
        background: #ecfdf5;
        border-color: #bbf7d0;
        color: #166534;
    }

    .badge.danger {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .wallet-action-form {
        margin: 0;
    }

    .wallet-suspend-panel,
    .wallet-reactivate-panel {
        width: 210px;
    }

    .wallet-suspend-panel summary,
    .wallet-reactivate-panel summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 9px 14px;
        background: #fff;
        font-weight: 900;
        cursor: pointer;
        list-style: none;
        transition: .18s ease;
    }

    .wallet-suspend-panel summary {
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .wallet-reactivate-panel summary {
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .wallet-suspend-panel summary::-webkit-details-marker,
    .wallet-reactivate-panel summary::-webkit-details-marker {
        display: none;
    }

    .wallet-suspend-panel summary:hover {
        background: #fef2f2;
        transform: translateY(-2px);
    }

    .wallet-reactivate-panel summary:hover {
        background: #ecfdf5;
        transform: translateY(-2px);
    }

    .wallet-suspend-panel[open] summary,
    .wallet-reactivate-panel[open] summary {
        margin-bottom: 10px;
    }

    .wallet-suspend-panel[open] summary {
        background: #fef2f2;
    }

    .wallet-reactivate-panel[open] summary {
        background: #ecfdf5;
    }

    .wallet-suspend-panel textarea,
    .wallet-reactivate-panel textarea {
        width: 100%;
        min-height: 82px;
        resize: vertical;
        border-radius: 10px;
        padding: 10px;
        color: #111827;
        font-weight: 750;
        outline: 0;
    }

    .wallet-suspend-panel textarea {
        border: 1px solid #fecaca;
    }

    .wallet-reactivate-panel textarea {
        border: 1px solid #bbf7d0;
    }

    .wallet-suspend-panel textarea:focus {
        border-color: #ef4444;
        box-shadow: 0 0 0 3px rgba(239,68,68,.12);
    }

    .wallet-reactivate-panel textarea:focus {
        border-color: #16a34a;
        box-shadow: 0 0 0 3px rgba(22,163,74,.12);
    }

    .wallet-history-panel {
        width: 260px;
        margin-top: 10px;
    }

    .wallet-history-panel summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 8px 13px;
        color: #1d4ed8;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        font-weight: 900;
        cursor: pointer;
        list-style: none;
        transition: .18s ease;
    }

    .wallet-history-panel summary::-webkit-details-marker {
        display: none;
    }

    .wallet-history-panel summary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(37,99,235,.12);
    }

    .wallet-history-list {
        margin-top: 10px;
        display: grid;
        gap: 8px;
        max-height: 260px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .wallet-history-empty,
    .wallet-history-item {
        margin-top: 10px;
        padding: 10px;
        border-radius: 10px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .wallet-history-empty {
        color: #64748b;
        font-weight: 800;
    }

    .wallet-history-top {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .wallet-history-top strong {
        color: #111827;
        font-size: 12px;
        font-weight: 900;
    }

    .history-action {
        border-radius: 999px;
        padding: 3px 7px;
        font-size: 10px;
        font-weight: 950;
        background: #e0f2fe;
        color: #075985;
    }

    .history-action.suspend {
        background: #fee2e2;
        color: #991b1b;
    }

    .history-action.reactivate {
        background: #dcfce7;
        color: #166534;
    }

    .wallet-history-item p {
        margin: 7px 0 5px;
        color: #334155;
        font-size: 12px;
        font-weight: 800;
        line-height: 1.35;
    }

    .wallet-history-item small {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 750;
        line-height: 1.35;
    }

    .wallet-reactivate-btn {
        width: 100%;
        margin-top: 8px;
        border: 0;
        border-radius: 10px;
        padding: 9px 12px;
        color: #fff;
        background: linear-gradient(135deg,#16a34a,#0f766e);
        font-weight: 900;
        box-shadow: 0 10px 20px rgba(22,163,74,.18);
        transition: .18s ease;
    }

    .wallet-suspend-btn {
        width: 100%;
        margin-top: 8px;
        border: 0;
        border-radius: 10px;
        padding: 9px 12px;
        color: #fff;
        background: linear-gradient(135deg,#ef4444,#b91c1c);
        font-weight: 900;
        box-shadow: 0 10px 20px rgba(239,68,68,.16);
        transition: .18s ease;
    }

    .wallet-reactivate-btn:hover,
    .wallet-suspend-btn:hover {
        transform: translateY(-2px);
    }

    .wallet-reactivate-btn:hover {
        box-shadow: 0 12px 24px rgba(22,163,74,.25);
    }

    .wallet-suspend-btn:hover {
        box-shadow: 0 12px 24px rgba(239,68,68,.24);
    }

    .page-title {
        margin-bottom: 6px;
        font-size: 30px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 15px;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .badge.success {
        background: #dcfce7;
        color: #166534;
    }

    .badge.warning {
        background: #fef3c7;
        color: #92400e;
    }

    .sub-text {
        font-size: 12px;
        color: #6b7280;
        margin-top: 5px;
        line-height: 1.4;
    }

    .pagination-area {
        margin-top: 24px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        background: white;
        color: #111827;
        border: 1px solid #d1d5db;
        transition: 0.2s;
    }

    .page-btn:hover {
        background: #111827;
        color: white;
    }

    .page-btn.active {
        background: #111827;
        color: white;
        border-color: #111827;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #6b7280;
        font-size: 15px;
    }

    .user-name {
        font-weight: 600;
        color: #111827;
        word-break: break-word;
    }

    .email-cell {
        word-break: break-all;
    }

    .amount-text {
        font-weight: 700;
        font-size: 15px;
    }

    .success-text {
        color: #15803d;
    }

    .danger-text {
        color: #dc2626;
    }

    .warning-text {
        color: #b45309;
    }

    .loyalty-badge {
        background: #ede9fe;
        color: #6d28d9;
        padding: 8px 12px;
        border-radius: 999px;
        font-weight: 700;
        display: inline-block;
        min-width: 60px;
        text-align: center;
    }

    .created-date {
        font-weight: 500;
        color: #111827;
    }

    @@media(max-width: 768px) {

        .page-title {
            font-size: 24px;
        }

        .wallet-table td,
        .wallet-table th {
            font-size: 13px;
            padding: 10px;
        }

    }

</style>
