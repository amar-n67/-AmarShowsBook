@model List<AmarShowsBook.Models.VwBookingTransactionSummary>
@using AmarShowsBook.Helpers

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Transactions";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count;
    int successCount = ViewBag.SuccessCount ?? Model.Count(x => x.TransactionStatus == "SUCCESS");
    int failedCount = ViewBag.FailedCount ?? Model.Count(x => x.TransactionStatus != "SUCCESS");
    int rowNo = ((currentPage - 1) * 50) + 1;
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Transaction Center</h1>
            <p>Enterprise payment monitoring across users, bookings, gateways, and status outcomes.</p>
        </div>

        <div class="admin-actions">
            <a href="/Admin/Dashboard" class="admin-back-btn admin-page-back">← Back to Dashboard</a>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <span>Total Transactions</span>
            <strong>@totalRecords</strong>
        </div>

        <div class="stat-card">
            <span>Success</span>
            <strong>@successCount</strong>
        </div>

        <div class="stat-card">
            <span>Failed</span>
            <strong>@failedCount</strong>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Transaction</th>
                    <th>User</th>
                    <th>Amount</th>
                    <th>Payment</th>
                    <th>Booking</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="empty-state">No transactions found</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@rowNo</td>

                            <td>
                                <strong>@item.TransactionRef</strong>
                                <div class="sub-text">@item.ShowTitle</div>
                            </td>

                            <td>
                                <strong>@item.UserName</strong>
                                <div class="sub-text">@item.UserEmail</div>
                            </td>

                            <td>
                                <strong>@CurrencyFormatter.FormatRupees(item.TransactionAmount)</strong>
                                <div class="sub-text">Currency: @(string.IsNullOrWhiteSpace(item.Currency) ? "INR" : item.Currency)</div>
                            </td>

                            <td>
                                <strong>@item.PaymentMethod</strong>
                                <div class="sub-text">@item.GatewayName</div>
                            </td>

                            <td>
                                <strong>@item.BookingRef</strong>
                                <div class="sub-text">@item.BookingStatus</div>
                            </td>

                            <td>
                                <span class="badge @(item.TransactionStatus == "SUCCESS" ? "success" : "danger")">
                                    @item.TransactionStatus
                                </span>
                                @if (!string.IsNullOrWhiteSpace(item.FailureReason))
                                {
                                    <div class="sub-text">@item.FailureReason</div>
                                }
                            </td>

                            <td>
                                @item.BookingCreatedAt.ToString("dd MMM yyyy")
                                <div class="sub-text">@item.BookingCreatedAt.ToString("hh:mm tt")</div>
                            </td>

                            <td>
                                @if (item.TransactionId.HasValue)
                                {
                                    <!-- Human Comment: Uses a real transaction id so the View button resolves to details. -->
                                    <a class="view-btn"
                                       href="/Admin/TransactionDetails/@item.TransactionId.Value">
                                        View
                                    </a>
                                }
                                else
                                {
                                    <span class="sub-text">No transaction id</span>
                                }
                            </td>
                        </tr>

                        rowNo++;
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Human Comment: Transaction center stays capped at 50 rows per page. -->
    <div class="pagination-area">
        @for (int i = 1; i <= totalPages; i++)
        {
            <a class="page-btn @(i == currentPage ? "active" : "")"
               href="/Admin/Transactions?page=@i">
                @i
            </a>
        }
    </div>
</section>
