@model List<AmarShowsBook.Models.VwBookingTransactionSummary>

@using AmarShowsBook.Helpers

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Admin Transactions";

    int currentPage = ViewBag.CurrentPage ?? 1;

    int totalPages = ViewBag.TotalPages ?? 1;

    int totalRecords = ViewBag.TotalRecords ?? Model.Count;

    int successCount =
        ViewBag.SuccessCount ??
        Model.Count(x => x.TransactionStatus == "SUCCESS");

    int failedCount =
        ViewBag.FailedCount ??
        Model.Count(x => x.TransactionStatus != "SUCCESS");

    int rowNo = ((currentPage - 1) * 50) + 1;
}

<section class="admin-page">


    <div class="admin-page-header">

        <div>

            <h1 class="page-title">
                Transaction Center
            </h1>

            <p class="page-subtitle">
                Enterprise payment monitoring across bookings,
                users, gateways, payment methods,
                and transaction outcomes.
            </p>

        </div>

        <div class="admin-actions">

            <a href="/Admin/Dashboard"
               class="admin-back-btn admin-page-back">
                ← Back to Dashboard
            </a>

        </div>

    </div>


    <div class="stats-grid">

        <div class="stat-card">
            <span>Total Transactions</span>
            <strong>@totalRecords</strong>
        </div>

        <div class="stat-card">
            <span>Successful Payments</span>
            <strong>@successCount</strong>
        </div>

        <div class="stat-card">
            <span>Failed Payments</span>
            <strong>@failedCount</strong>
        </div>

    </div>


    <div class="table-wrapper">

        <table class="table admin-table transaction-table">

            <thead>

                <tr>

                    <th style="min-width:70px;">#</th>

                    <th style="min-width:250px;">
                        Transaction
                    </th>

                    <th style="min-width:250px;">
                        User
                    </th>

                    <th style="min-width:180px;">
                        Amount
                    </th>

                    <th style="min-width:220px;">
                        Payment
                    </th>

                    <th style="min-width:220px;">
                        Booking
                    </th>

                    <th style="min-width:180px;">
                        Status
                    </th>

                    <th style="min-width:180px;">
                        Created
                    </th>

                    <th style="min-width:140px;">
                        Action
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="9"
                            class="empty-state">
                            No transactions found
                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr data-filter-status="@($"{item.TransactionStatus}|{item.BookingStatus}")"
                            data-filter-method="@item.PaymentMethod">


                            <td>

                                <span class="row-number">
                                    @rowNo
                                </span>

                            </td>


                            <td>

                                <div class="primary-text">
                                    @(string.IsNullOrWhiteSpace(item.TransactionRef)
                                        ? "NA"
                                        : item.TransactionRef)
                                </div>

                                <div class="sub-text">
                                    @(string.IsNullOrWhiteSpace(item.ShowTitle)
                                        ? "No Show"
                                        : item.ShowTitle)
                                </div>

                            </td>


                            <td>

                                <div class="primary-text">
                                    @(string.IsNullOrWhiteSpace(item.UserName)
                                        ? "NA"
                                        : item.UserName)
                                </div>

                                <div class="sub-text email-cell">
                                    @(string.IsNullOrWhiteSpace(item.UserEmail)
                                        ? "NA"
                                        : item.UserEmail)
                                </div>

                            </td>


                            <td>

                                <div class="amount-text">
                                    @CurrencyFormatter.FormatRupees(item.TransactionAmount)
                                </div>

                                <div class="sub-text">
                                    Currency:
                                    @(string.IsNullOrWhiteSpace(item.Currency)
                                        ? "INR"
                                        : item.Currency)
                                </div>

                            </td>


                            <td>

                                <div class="primary-text">
                                    @(string.IsNullOrWhiteSpace(item.PaymentMethod)
                                        ? "NA"
                                        : item.PaymentMethod)
                                </div>

                                <div class="sub-text">
                                    @(string.IsNullOrWhiteSpace(item.GatewayName)
                                        ? "NA"
                                        : item.GatewayName)
                                </div>

                            </td>


                            <td>

                                <div class="primary-text">
                                    @(string.IsNullOrWhiteSpace(item.BookingRef)
                                        ? "NA"
                                        : item.BookingRef)
                                </div>

                                <div class="sub-text">
                                    @(string.IsNullOrWhiteSpace(item.BookingStatus)
                                        ? "NA"
                                        : item.BookingStatus)
                                </div>

                            </td>


                            <td>

                                @if (item.TransactionStatus == "SUCCESS")
                                {
                                    <span class="badge success">
                                        SUCCESS
                                    </span>
                                }
                                else
                                {
                                    <span class="badge danger">
                                        @(string.IsNullOrWhiteSpace(item.TransactionStatus)
                                            ? "FAILED"
                                            : item.TransactionStatus)
                                    </span>
                                    <span class="app-info app-info-left">
                                        <button type="button" class="app-info-btn" aria-label="Show transaction status details">i</button>
                                        <span class="app-info-popover" role="tooltip">
                                            <b>Status</b> @(string.IsNullOrWhiteSpace(item.TransactionStatus) ? "FAILED" : item.TransactionStatus)<br />
                                            <b>Reason</b> @(string.IsNullOrWhiteSpace(item.FailureReason) ? "Payment is not marked successful yet." : item.FailureReason)<br />
                                            <b>Gateway</b> @(string.IsNullOrWhiteSpace(item.GatewayName) ? "NA" : item.GatewayName)
                                        </span>
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(item.FailureReason))
                                {
                                    <div class="sub-text error-text">
                                        @item.FailureReason
                                    </div>
                                }

                            </td>


                            <td>

                                <div class="created-date">
                                    @item.BookingCreatedAt
                                       
                                </div>

                                <div class="sub-text">
                                    @item.BookingCreatedAt
                                      
                                </div>

                            </td>


                            <td>

                                @if (item.TransactionId.HasValue)
                                {
                                    <a href="/Admin/TransactionDetails/@item.TransactionId.Value"
                                       class="view-btn">
                                        View
                                    </a>
                                }
                                else
                                {
                                    <span class="sub-text">
                                        No transaction id
                                    </span>
                                }

                            </td>

                        </tr>

                        rowNo++;
                    }
                }

            </tbody>

        </table>

    </div>


    @await Html.PartialAsync("_AdminPagination", new AmarShowsBook.Models.ViewModels.AdminPaginationViewModel
    {
        CurrentPage = currentPage,
        TotalPages = totalPages,
        ActionUrl = "/Admin/Transactions"
    })

</section>


<style>

    .transaction-table {
        width: 100%;
        border-collapse: collapse;
    }

    .transaction-table th {
        background: #111827;
        color: white;
        padding: 14px;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .transaction-table td {
        padding: 14px;
        vertical-align: top;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
    }

    .transaction-table tbody tr:hover {
        background: #f9fafb;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        border-radius: 12px;
        background: white;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

    .stat-card span {
        display: block;
        color: #6b7280;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .stat-card strong {
        font-size: 28px;
        color: #111827;
    }

    .page-title {
        margin-bottom: 6px;
        font-size: 30px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 15px;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .badge.success {
        background: #dcfce7;
        color: #166534;
    }

    .badge.danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .sub-text {
        font-size: 12px;
        color: #6b7280;
        margin-top: 5px;
        line-height: 1.4;
        word-break: break-word;
    }

    .email-cell {
        word-break: break-all;
    }

    .primary-text {
        font-weight: 600;
        color: #111827;
        word-break: break-word;
    }

    .amount-text {
        font-weight: 700;
        color: #15803d;
        font-size: 15px;
    }

    .error-text {
        color: #dc2626;
    }

    .created-date {
        font-weight: 500;
        color: #111827;
    }

    .row-number {
        font-weight: 700;
        color: #374151;
    }

    .view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 14px;
        border-radius: 10px;
        background: #111827;
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: 0.2s;
    }

    .view-btn:hover {
        background: #2563eb;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #6b7280;
        font-size: 15px;
    }

    @@media(max-width: 768px) {

        .page-title {
            font-size: 24px;
        }

        .transaction-table td,
        .transaction-table th {
            font-size: 13px;
            padding: 10px;
        }

        .view-btn {
            width: 100%;
        }

    }

</style>
