@model IEnumerable<AmarShowsBook.Models.Admin.VwNotificationCenter>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Notifications";
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Notifications</h1>
            <p>Delivery status for user notification activity.</p>
        </div>
    </div>

<div class="table-wrapper">
<table class="table admin-table">

<thead>
<tr>
    <th>User</th>
    <th>Title</th>
    <th>Status</th>
</tr>
</thead>

<tbody>

@foreach (var item in Model)
{
    <tr>
        <td>@item.UserName</td>
        <td>@item.Title</td>
        <td>@item.Status</td>
    </tr>
}

</tbody>

</table>
</div>
</section>
