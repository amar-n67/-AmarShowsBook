@using AmarShowsBook.Models.ViewModels
@model IEnumerable<AmarShowsBook.Models.Admin.VwNotificationCenter>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Notifications";

    int currentPage = ViewBag.CurrentPage ?? 1;

    int totalPages = ViewBag.TotalPages ?? 1;

    int totalRecords = ViewBag.TotalRecords ?? Model.Count();
    var actionNotifications =
        ViewBag.ActionNotifications as List<AdminNotificationActionItem>
        ?? new List<AdminNotificationActionItem>();

    var archivedActionNotifications =
        ViewBag.ArchivedActionNotifications as List<AdminNotificationActionItem>
        ?? new List<AdminNotificationActionItem>();

    int actionNotificationCount = ViewBag.ActionNotificationCount ?? actionNotifications.Count;

    int archivedActionNotificationCount =
        ViewBag.ArchivedActionNotificationCount ?? archivedActionNotifications.Count;

    int pendingActionCount = ViewBag.PendingActionCount ?? actionNotifications.Count(x => x.RequiresAction);

    int criticalActionCount = ViewBag.CriticalActionCount ?? actionNotifications.Count(x => x.Priority == "HIGH");

    string highlight = Context.Request.Query["highlight"].ToString();

    string BadgeClass(string? status, int isError = 0)
    {
        var normalized = (status ?? string.Empty).Trim().ToUpperInvariant();

        if (isError == 1 ||
            normalized is "HIGH" ||
            normalized is "FAILED" or "ERROR" or "FAILURE" or "REJECTED" or "ISSUE")
        {
            return "danger";
        }

        if (normalized is "MEDIUM" or "PENDING" or "PROCESSING" or "UNREAD" or "CANCELLED")
        {
            return "warning";
        }

        if (normalized is "SENT" or "SUCCESS" or "DELIVERED" or "READ")
        {
            return "success";
        }

        return "neutral";
    }

    string CategoryClass(string? category)
    {
        var normalized = (category ?? string.Empty).Trim().ToUpperInvariant();

        return normalized switch
        {
            "REFUND" => "refund",
            "BOOKING" => "booking",
            "PAYMENT" => "payment",
            "NOTIFICATION" => "delivery",
            "SECURITY" => "security",
            "AUTH" => "auth",
            _ => "system"
        };
    }

    string FormatDate(DateTime value) =>
        value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    string FormatTime(DateTime value) =>
        value.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture);

    string FormatDateTime(DateTime? value) =>
        value.HasValue
            ? value.Value.ToString("dd MMM yyyy hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)
            : "NA";
}

<section class="admin-page">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="admin-page-header">

        <div>

            <h1 class="page-title">
                Notifications
            </h1>

            <p class="page-subtitle">
                Track customer actions, cancellations, refunds,
                payment failures, delivery issues,
                and technical errors in one action queue.
            </p>

        </div>

        <div class="admin-actions">

            <a href="/Admin/Dashboard"
               class="admin-back-btn admin-page-back">
                ← Back to Dashboard
            </a>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- STATS -->
    <!-- ===================================================== -->

    <div class="stats-grid">

        <div class="stat-card">
            <span>Action Items</span>
            <strong>@actionNotificationCount</strong>
        </div>

        <div class="stat-card">
            <span>Needs Admin Action</span>
            <strong>@pendingActionCount</strong>
        </div>

        <div class="stat-card">
            <span>Critical</span>
            <strong>@criticalActionCount</strong>
        </div>

        <div class="stat-card">
            <span>Archive</span>
            <strong>@archivedActionNotificationCount</strong>
        </div>

        <div class="stat-card">
            <span>Delivery Records</span>
            <strong>@totalRecords</strong>
        </div>

    </div>

    <div class="admin-detail-panel mb-4">
        <div class="notification-panel-head">
            <div>
                <h2 class="h5 mb-1">Admin Action Notifications</h2>
                <p class="panel-subtitle">
                    Refunds, cancelled tickets, failed payments, delivery failures,
                    security issues, and technical logs with direct action links.
                </p>
            </div>
        </div>

        <div class="table-wrapper notification-scroll-area">
            <table class="table admin-table action-notification-table">
                <thead>
                    <tr>
                        <th style="min-width:160px;">Time</th>
                        <th style="min-width:150px;">Priority</th>
                        <th style="min-width:190px;">Event</th>
                        <th style="min-width:240px;">User</th>
                        <th style="min-width:420px;">Details</th>
                        <th style="min-width:170px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if(!actionNotifications.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                No action notifications found
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach(var item in actionNotifications)
                        {
                            var categoryClass = CategoryClass(item.Category);
                            var priorityClass = BadgeClass(item.Priority);
                            <tr id="@item.Id"
                                class="action-row action-row-@categoryClass @(highlight == item.Id ? "highlight-row" : "")"
                                data-admin-searchable
                                data-notification-row
                                data-sort-time="@item.Time.Ticks"
                                data-filter-status="@item.Status"
                                data-filter-method="@item.Category"
                                data-filter-priority="@item.Priority">

                                <td>
                                    <div class="created-date">
                                        @FormatDate(item.Time)
                                    </div>
                                    <div class="sub-text">
                                        @FormatTime(item.Time)
                                    </div>
                                </td>

                                <td>
                                    <span class="badge @BadgeClass(item.Priority)">
                                        @item.Priority
                                    </span>
                                    @if (item.RequiresAction)
                                    {
                                        <div class="sub-text">
                                            Action required
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="notification-title">
                                        @item.Title
                                    </div>
                                    <div class="sub-text">
                                        <span class="source-chip source-@categoryClass">
                                            @item.Category
                                        </span>
                                        <span class="status-inline">
                                            @item.Status
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div class="user-name">
                                        @(string.IsNullOrWhiteSpace(item.UserName)
                                            ? "NA"
                                            : item.UserName)
                                    </div>
                                    <div class="sub-text email-cell">
                                        @(string.IsNullOrWhiteSpace(item.UserEmail)
                                            ? "NA"
                                            : item.UserEmail)
                                    </div>
                                </td>

                                <td>
                                    <div class="notification-detail">
                                        @item.Detail
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                                    {
                                        <a class="notification-action-btn action-btn-@priorityClass action-btn-@categoryClass"
                                           href="@item.ActionUrl">
                                            @item.ActionText
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="sub-text">No action</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <details class="admin-detail-panel notification-archive-panel mb-4">
        <summary class="notification-archive-toggle">
            <span>
                Notification Archive
            </span>
            <strong>
                @archivedActionNotificationCount
            </strong>
        </summary>

        <div class="notification-panel-head">
            <div>
                <h2 class="h5 mb-1">Notification Archive</h2>
                <p class="panel-subtitle">
                    Completed admin actions and old notification outcomes in the same review format.
                </p>
            </div>
        </div>

        <div class="table-wrapper notification-scroll-area">
            <table class="table admin-table action-notification-table">
                <thead>
                    <tr>
                        <th style="min-width:160px;">Time</th>
                        <th style="min-width:150px;">Priority</th>
                        <th style="min-width:190px;">Event</th>
                        <th style="min-width:240px;">User</th>
                        <th style="min-width:420px;">Details</th>
                        <th style="min-width:170px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if(!archivedActionNotifications.Any())
                    {
                        <tr>
                            <td colspan="6" class="empty-state">
                                No archived notifications found
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach(var item in archivedActionNotifications)
                        {
                            var categoryClass = CategoryClass(item.Category);
                            var priorityClass = BadgeClass(item.Priority);
                            <tr id="@item.Id"
                                class="action-row archive-row action-row-@categoryClass @(highlight == item.Id ? "highlight-row" : "")"
                                data-admin-searchable
                                data-notification-row
                                data-sort-time="@item.Time.Ticks"
                                data-filter-status="@item.Status"
                                data-filter-method="@item.Category"
                                data-filter-priority="@item.Priority">

                                <td>
                                    <div class="created-date">
                                        @FormatDate(item.Time)
                                    </div>
                                    <div class="sub-text">
                                        @FormatTime(item.Time)
                                    </div>
                                </td>

                                <td>
                                    <span class="badge @BadgeClass(item.Priority)">
                                        @item.Priority
                                    </span>
                                    <div class="sub-text">
                                        Archived
                                    </div>
                                </td>

                                <td>
                                    <div class="notification-title">
                                        @item.Title
                                    </div>
                                    <div class="sub-text">
                                        <span class="source-chip source-@categoryClass">
                                            @item.Category
                                        </span>
                                        <span class="status-inline">
                                            @item.Status
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div class="user-name">
                                        @(string.IsNullOrWhiteSpace(item.UserName)
                                            ? "NA"
                                            : item.UserName)
                                    </div>
                                    <div class="sub-text email-cell">
                                        @(string.IsNullOrWhiteSpace(item.UserEmail)
                                            ? "NA"
                                            : item.UserEmail)
                                    </div>
                                </td>

                                <td>
                                    <div class="notification-detail">
                                        @item.Detail
                                    </div>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                                    {
                                        <a class="notification-action-btn action-btn-@priorityClass action-btn-@categoryClass"
                                           href="@item.ActionUrl">
                                            @item.ActionText
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="sub-text">No action</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </details>

    <!-- ===================================================== -->
    <!-- DELIVERY TABLE -->
    <!-- ===================================================== -->

    <div class="notification-panel-head delivery-panel-head">
        <div>
            <h2 class="h5 mb-1">Delivery Records</h2>
            <p class="panel-subtitle">
                Customer notification messages, delivery timing, retry count,
                and failure details from the notification center.
            </p>
        </div>
    </div>

    <div class="table-wrapper notification-scroll-area">

        <table class="table admin-table notification-table">

            <thead>

                <tr>

                    <th style="min-width:220px;">
                        User
                    </th>

                    <th style="min-width:320px;">
                        Notification
                    </th>

                    <th style="min-width:360px;">
                        Delivery Details
                    </th>

                    <th style="min-width:140px;">
                        Status
                    </th>

                    <th style="min-width:180px;">
                        Created
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5"
                            class="empty-state">
                            No notifications found
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var rowId = $"notification-{item.NotificationId}";

                        <tr id="@rowId"
                            class="@(highlight == rowId ? "highlight-row" : "")"
                            data-admin-searchable
                            data-notification-row
                            data-sort-time="@item.CreatedAt.Ticks"
                            data-filter-status="@item.Status"
                            data-filter-method="@item.NotificationType"
                            data-filter-priority="@item.Priority">

                            <!-- USER -->

                            <td>

                                <div class="user-name">
                                    @(string.IsNullOrWhiteSpace(item.UserName)
                                        ? "NA"
                                        : item.UserName)
                                </div>

                                <div class="sub-text email-cell">
                                    @(string.IsNullOrWhiteSpace(item.UserEmail)
                                        ? "NA"
                                        : item.UserEmail)
                                </div>

                            </td>

                            <!-- TITLE -->

                            <td>

                                <div class="notification-title">
                                    @(string.IsNullOrWhiteSpace(item.Title)
                                        ? "NA"
                                        : item.Title)
                                </div>

                                <div class="sub-text">
                                    Type:
                                    @(string.IsNullOrWhiteSpace(item.NotificationType)
                                        ? "NA"
                                        : item.NotificationType)
                                </div>

                                <div class="sub-text">
                                    Template:
                                    @(string.IsNullOrWhiteSpace(item.TemplateCode)
                                        ? "NA"
                                        : item.TemplateCode)
                                    /
                                    @(string.IsNullOrWhiteSpace(item.TemplateName)
                                        ? "NA"
                                        : item.TemplateName)
                                </div>

                            </td>

                            <!-- DELIVERY DETAILS -->

                            <td>
                                <div class="notification-detail">
                                    @(string.IsNullOrWhiteSpace(item.Message)
                                        ? "No message body"
                                        : item.Message)
                                </div>

                                <div class="sub-text">
                                    Sent:
                                    @FormatDateTime(item.SentAt)
                                    | Delivered:
                                    @FormatDateTime(item.DeliveredAt)
                                    | Read:
                                    @FormatDateTime(item.ReadAt)
                                </div>

                                <div class="sub-text">
                                    Retries: @item.RetryCount
                                    | Failure:
                                    @(string.IsNullOrWhiteSpace(item.FailureReason)
                                        ? "NA"
                                        : item.FailureReason)
                                </div>
                            </td>

                            <!-- STATUS -->

                            <td>

                                <span class="badge @BadgeClass(item.Status, item.IsError)">
                                    @(string.IsNullOrWhiteSpace(item.Status)
                                        ? (item.IsError == 1 ? "FAILED" : "SUCCESS")
                                        : item.Status)
                                </span>

                            </td>

                            <!-- CREATED -->

                            <td>

                                <div class="created-date">
                                    @FormatDate(item.CreatedAt)
                                </div>

                                <div class="sub-text">
                                    @FormatTime(item.CreatedAt)
                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

    <!-- ===================================================== -->
    <!-- PAGINATION -->
    <!-- ===================================================== -->

    <div class="pagination-area">

        @for (int i = 1; i <= totalPages; i++)
        {
            <a href="/Admin/Notifications?page=@i"
               class="page-btn @(i == currentPage ? "active" : "")">
                @i
            </a>
        }

    </div>

</section>

<!-- ===================================================== -->
<!-- PAGE CSS -->
<!-- ===================================================== -->

<style>

    .notification-table,
    .action-notification-table {
        width: 100%;
        border-collapse: collapse;
    }

    .notification-table th,
    .action-notification-table th {
        background: #111827;
        color: white;
        padding: 14px;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .notification-table td,
    .action-notification-table td {
        padding: 14px;
        vertical-align: top;
        border-bottom: 1px solid #e5e7eb;
        font-size: 14px;
    }

    .notification-table tbody tr:hover,
    .action-notification-table tbody tr:hover {
        background: #f9fafb;
    }

    .highlight-row {
        background: #fff7ed !important;
        box-shadow: inset 4px 0 0 #f97316;
    }

    .action-row {
        position: relative;
        transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }

    .action-row:hover {
        transform: translateY(-1px);
    }

    .action-row-refund {
        background:
            linear-gradient(90deg, rgba(255, 247, 237, 0.96), rgba(255, 255, 255, 0.98) 42%);
        box-shadow: inset 5px 0 0 #f97316;
    }

    .action-row-payment {
        box-shadow: inset 5px 0 0 #ef4444;
    }

    .action-row-security {
        box-shadow: inset 5px 0 0 #7c3aed;
    }

    .action-row-booking {
        box-shadow: inset 5px 0 0 #0f766e;
    }

    .action-row-delivery {
        box-shadow: inset 5px 0 0 #2563eb;
    }

    .notification-panel-head {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: flex-start;
        margin-bottom: 16px;
    }

    .delivery-panel-head {
        margin-top: 6px;
    }

    .panel-subtitle {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
        line-height: 1.5;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        border-radius: 12px;
        background: white;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

    .notification-scroll-area {
        max-height: 360px;
        overflow: auto;
    }

    .notification-scroll-area thead th {
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .notification-archive-panel {
        padding: 0;
        overflow: hidden;
    }

    .notification-archive-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
        cursor: pointer;
        background: linear-gradient(135deg, #111827, #334155);
        color: white;
        font-weight: 800;
        list-style: none;
    }

    .notification-archive-toggle::-webkit-details-marker {
        display: none;
    }

    .notification-archive-toggle::after {
        content: "Open";
        min-width: 72px;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.14);
        text-align: center;
        font-size: 12px;
    }

    .notification-archive-panel[open] .notification-archive-toggle::after {
        content: "Close";
    }

    .notification-archive-panel .notification-panel-head,
    .notification-archive-panel .table-wrapper {
        margin-left: 20px;
        margin-right: 20px;
    }

    .notification-archive-panel .notification-panel-head {
        margin-top: 18px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 18px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    }

    .stat-card span {
        display: block;
        color: #6b7280;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .stat-card strong {
        font-size: 28px;
        color: #111827;
    }

    .page-title {
        margin-bottom: 6px;
        font-size: 30px;
        font-weight: 700;
    }

    .page-subtitle {
        color: #6b7280;
        font-size: 15px;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        display: inline-block;
        border: 1px solid transparent;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.45);
    }

    .badge.success {
        background: linear-gradient(135deg, #dcfce7, #99f6e4);
        color: #065f46;
        border-color: #86efac;
    }

    .badge.danger {
        background: linear-gradient(135deg, #fee2e2, #fecdd3);
        color: #9f1239;
        border-color: #fda4af;
    }

    .badge.warning {
        background: linear-gradient(135deg, #fef3c7, #fed7aa);
        color: #92400e;
        border-color: #fdba74;
    }

    .badge.neutral {
        background: linear-gradient(135deg, #e5e7eb, #f8fafc);
        color: #374151;
        border-color: #cbd5e1;
    }

    .sub-text {
        font-size: 12px;
        color: #6b7280;
        margin-top: 5px;
        line-height: 1.4;
    }

    .pagination-area {
        margin-top: 24px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-btn {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        background: white;
        color: #111827;
        border: 1px solid #d1d5db;
        transition: 0.2s;
    }

    .page-btn:hover {
        background: #111827;
        color: white;
    }

    .page-btn.active {
        background: #111827;
        color: white;
        border-color: #111827;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #6b7280;
        font-size: 15px;
    }

    .user-name {
        font-weight: 600;
        color: #111827;
        word-break: break-word;
    }

    .email-cell {
        word-break: break-all;
    }

    .notification-title {
        font-weight: 500;
        color: #111827;
        line-height: 1.5;
        word-break: break-word;
    }

    .source-chip,
    .status-inline {
        display: inline-flex;
        align-items: center;
        min-height: 22px;
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 850;
        line-height: 1;
    }

    .status-inline {
        margin-left: 6px;
        background: #f3f4f6;
        color: #4b5563;
    }

    .source-refund {
        background: #ffedd5;
        color: #9a3412;
    }

    .source-booking {
        background: #ccfbf1;
        color: #115e59;
    }

    .source-payment {
        background: #fee2e2;
        color: #991b1b;
    }

    .source-delivery {
        background: #dbeafe;
        color: #1e40af;
    }

    .source-security {
        background: #ede9fe;
        color: #5b21b6;
    }

    .source-auth,
    .source-system {
        background: #e5e7eb;
        color: #374151;
    }

    .notification-detail {
        color: #374151;
        line-height: 1.55;
        word-break: break-word;
    }

    .notification-action-btn {
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 8px;
        border: 1px solid transparent;
        background: #111827;
        color: #fff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 10px 22px rgba(17, 24, 39, 0.15);
        transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    }

    .notification-action-btn:hover {
        transform: translateY(-1px);
        color: #fff;
    }

    .action-btn-danger {
        background: linear-gradient(135deg, #be123c, #ef4444);
        box-shadow: 0 10px 22px rgba(190, 18, 60, 0.24);
    }

    .action-btn-warning {
        background: linear-gradient(135deg, #b45309, #f59e0b);
        box-shadow: 0 10px 22px rgba(180, 83, 9, 0.24);
    }

