@model AmarShowsBook.Models.ViewModels.AdminDashboardViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard">

    <!-- ===================================================== -->
    <!-- HUMAN COMMENT:
         ADMIN DASHBOARD HEADER
    -->
    <!-- ===================================================== -->

    <div class="admin-page-header">

        <div>

            <h1>Admin Dashboard</h1>

            <p>
                Analytics overview for bookings, payments,
                refunds, wallets, invoices, notifications,
                and security.
            </p>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- HUMAN COMMENT:
         MAIN ANALYTICS CARDS
    -->
    <!-- ===================================================== -->

    <div class="dashboard-grid">

        <div class="dashboard-card">
            <span>Total Bookings</span>
            <strong>@Model.TotalBookings</strong>
        </div>

        <div class="dashboard-card">
            <span>Failed Bookings</span>
            <strong>@Model.FailedBookings</strong>
        </div>

        <div class="dashboard-card">
            <span>Successful Payments</span>
            <strong>@Model.SuccessfulPayments</strong>
        </div>

        <div class="dashboard-card">
            <span>Failed Payments</span>
            <strong>@Model.FailedPayments</strong>
        </div>

        <div class="dashboard-card">
            <span>Total Refunds</span>
            <strong>@Model.TotalRefunds</strong>
        </div>

        <div class="dashboard-card">
            <span>Refund Failures</span>
            <strong>@Model.FailedRefunds</strong>
        </div>

        <div class="dashboard-card">
            <span>Invoice Failures</span>
            <strong>@Model.InvoiceFailures</strong>
        </div>

        <div class="dashboard-card">
            <span>Notification Failures</span>
            <strong>@Model.NotificationFailures</strong>
        </div>

        <div class="dashboard-card">
            <span>Security Alerts</span>
            <strong>@Model.TicketValidationIssues</strong>
        </div>

        <div class="dashboard-card">
            <span>Total Wallet Balance</span>
            <strong>₹ @Model.TotalWalletBalance</strong>
        </div>

        <div class="dashboard-card">
            <span>Total Credits</span>
            <strong>₹ @Model.TotalCredits</strong>
        </div>

        <div class="dashboard-card">
            <span>Total Debits</span>
            <strong>₹ @Model.TotalDebits</strong>
        </div>

    </div>

    <!-- ===================================================== -->
    <!-- HUMAN COMMENT:
         ADMIN QUICK NAVIGATION CARDS
    -->
    <!-- ===================================================== -->

    <div class="admin-navigation-grid">

        <a href="/Admin/Users"
           class="nav-card">

            User Management

        </a>

        <a href="/Admin/UserAccess"
           class="nav-card">

            User Access Control

        </a>

        <a href="/Admin/Transactions"
           class="nav-card">

            Transaction Center

        </a>

        <a href="/Admin/Wallets"
           class="nav-card">

            Wallet Management

        </a>

        <a href="/Admin/Notifications"
           class="nav-card">

            Notification Center

        </a>

        <a href="/Admin/ActivityLogs"
           class="nav-card">

            Enterprise Activity Logs

        </a>

    </div>

</section>

<!-- ===================================================== -->
<!-- HUMAN COMMENT:
     ADMIN DASHBOARD STYLES
-->
<!-- ===================================================== -->

<style>

.admin-dashboard{
    padding:24px;
    background:#f8fafc;
    min-height:100vh;
}

.admin-page-header{
    margin-bottom:28px;
}

.admin-page-header h1{
    font-size:42px;
    font-weight:800;
    color:#0f172a;
    margin-bottom:10px;
}

.admin-page-header p{
    color:#64748b;
    font-size:16px;
    max-width:900px;
    line-height:1.6;
}

/* ===================================================== */
/* HUMAN COMMENT:
   ANALYTICS GRID
*/
/* ===================================================== */

.dashboard-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:20px;
    margin-bottom:40px;
}

.dashboard-card{
    background:white;
    padding:24px;
    border-radius:20px;
    border:1px solid #dbeafe;
    box-shadow:0 10px 25px rgba(15,23,42,0.06);
    transition:0.3s;
}

.dashboard-card:hover{
    transform:translateY(-4px);
}

.dashboard-card span{
    display:block;
    color:#64748b;
    font-size:15px;
    margin-bottom:10px;
}

.dashboard-card strong{
    font-size:36px;
    font-weight:800;
    color:#0f172a;
}

/* ===================================================== */
/* HUMAN COMMENT:
   QUICK NAVIGATION CARDS
*/
/* ===================================================== */

.admin-navigation-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.nav-card{
    background:linear-gradient(135deg,#2563eb,#1d4ed8);
    padding:24px;
    border-radius:20px;
    color:white;
    text-decoration:none;
    font-size:18px;
    font-weight:700;
    transition:0.3s;
    box-shadow:0 12px 30px rgba(37,99,235,0.25);
}

.nav-card:hover{
    transform:translateY(-5px);
    color:white;
    box-shadow:0 16px 35px rgba(37,99,235,0.35);
}

/* ===================================================== */
/* HUMAN COMMENT:
   MOBILE RESPONSIVE
*/
/* ===================================================== */

@@media(max-width:900px){

    .dashboard-grid{
        grid-template-columns:1fr;
    }

    .admin-navigation-grid{
        grid-template-columns:1fr;
    }

    .admin-page-header h1{
        font-size:34px;
    }

    .dashboard-card strong{
        font-size:30px;
    }

}

</style>