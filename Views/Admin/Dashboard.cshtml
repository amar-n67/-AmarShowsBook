@model AmarShowsBook.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard">

    <div class="admin-header">
        <h1>Admin Dashboard</h1>

        <p>
            Analytics overview for bookings,
            payments, refunds, wallets,
            invoices, and security.
        </p>
    </div>

    <div class="dashboard-grid">

        <div class="dashboard-card">
            <span>Total Bookings</span>
            <strong>@Model.TotalBookings</strong>
        </div>

        <div class="dashboard-card">
            <span>Failed Bookings</span>
            <strong>@Model.FailedBookings</strong>
        </div>

        <div class="dashboard-card">
            <span>Successful Payments</span>
            <strong>@Model.SuccessfulPayments</strong>
        </div>

        <div class="dashboard-card">
            <span>Failed Payments</span>
            <strong>@Model.FailedPayments</strong>
        </div>

        <div class="dashboard-card">
            <span>Total Refunds</span>
            <strong>@Model.TotalRefunds</strong>
        </div>

        <div class="dashboard-card">
            <span>Refund Failures</span>
            <strong>@Model.FailedRefunds</strong>
        </div>

        <div class="dashboard-card">
            <span>Invoice Failures</span>
            <strong>@Model.InvoiceFailures</strong>
        </div>

        <div class="dashboard-card">
            <span>Notification Failures</span>
            <strong>@Model.NotificationFailures</strong>
        </div>

        <div class="dashboard-card">
            <span>Security Alerts</span>
            <strong>@Model.TicketValidationIssues</strong>
        </div>

        <div class="dashboard-card">
            <span>Total Wallet Balance</span>
            <strong>₹ @Model.TotalWalletBalance</strong>
        </div>

        <div class="dashboard-card">
            <span>Total Credits</span>
            <strong>₹ @Model.TotalCredits</strong>
        </div>

        <div class="dashboard-card">
            <span>Total Debits</span>
            <strong>₹ @Model.TotalDebits</strong>
        </div>

    </div>

</section>

<style>

.admin-dashboard
{
    padding-bottom: 40px;
}

.admin-header
{
    margin-bottom: 24px;
}

.dashboard-grid
{
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 16px;
}

.dashboard-card
{
    padding: 24px;

    border-radius: 8px;

    background: var(--app-card);

    border: 1px solid var(--app-input-border);

    box-shadow: 0 10px 24px rgba(0,0,0,0.12);
}

.dashboard-card span
{
    display: block;

    margin-bottom: 12px;

    font-size: 0.85rem;

    font-weight: 800;

    text-transform: uppercase;
}

.dashboard-card strong
{
    font-size: 2rem;

    font-weight: 900;
}

@@media (max-width: 900px)
{
    .dashboard-grid
    {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media (max-width: 700px)
{
    .dashboard-grid
    {
        grid-template-columns: 1fr;
    }
}
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<br />

<div class="dashboard-grid">

    <div class="dashboard-card">
        <h2>@ViewBag.TotalUsers</h2>
        <p>Total Users</p>
    </div>

    <div class="dashboard-card">
        <h2>@ViewBag.ActiveUsers</h2>
        <p>Active Users</p>
    </div>

    <div class="dashboard-card">
        <h2>@ViewBag.DisabledUsers</h2>
        <p>Disabled Users</p>
    </div>

    <div class="dashboard-card">
        <h2>@ViewBag.TotalMovies</h2>
        <p>Total Movies</p>
    </div>

    <div class="dashboard-card">
        <h2>@ViewBag.TotalBookings</h2>
        <p>Total Bookings</p>
    </div>

</div>
</style>