<script>
    const supportDetailsModal = document.getElementById("supportDetailsModal");

    function openSupportDetailsModal() {
        if (!supportDetailsModal) {
            return;
        }

        supportDetailsModal.hidden = false;
        syncSupportWhatsApp(true);
        supportDetailsModal.querySelector("input, textarea, button")?.focus();
    }

    function closeSupportDetailsModal() {
        if (supportDetailsModal) {
            supportDetailsModal.hidden = true;
        }
    }

    supportDetailsModal?.addEventListener("click", (event) => {
        if (event.target === supportDetailsModal) {
            closeSupportDetailsModal();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && supportDetailsModal && !supportDetailsModal.hidden) {
            closeSupportDetailsModal();
        }
    });

    const sameAsPhone = document.getElementById("IsSupportWhatsAppSameAsPhone");
    const supportPhone = document.getElementById("SupportPhone");
    const supportWhatsApp = document.getElementById("SupportWhatsAppPhone");

    function syncSupportWhatsApp(clearWhenUnchecked = false) {
        if (!sameAsPhone || !supportPhone || !supportWhatsApp) {
            return;
        }

        supportWhatsApp.disabled = sameAsPhone.checked;
        if (sameAsPhone.checked) {
            supportWhatsApp.value = supportPhone.value;
            return;
        }

        if (clearWhenUnchecked) {
            supportWhatsApp.value = "";
        }
    }

    sameAsPhone?.addEventListener("change", () => syncSupportWhatsApp(true));
    supportPhone?.addEventListener("input", () => syncSupportWhatsApp(false));
    syncSupportWhatsApp(true);

    document.querySelectorAll(".admin-dashboard .dashboard-insight-card").forEach((card) => {
        const head = card.querySelector(".dashboard-section-head");

        if (!head || head.querySelector(".dashboard-toggle-btn")) {
            return;
        }

        let actions = head.querySelector(".dashboard-section-actions");

        if (!actions) {
            actions = document.createElement("div");
            actions.className = "dashboard-section-actions";

            [...head.querySelectorAll(":scope > a")].forEach((link) => {
                actions.appendChild(link);
            });

            head.appendChild(actions);
        }

        const button = document.createElement("button");
        button.type = "button";
        button.className = "dashboard-toggle-btn";
        button.setAttribute("aria-label", "Hide section");
        button.textContent = "▲";

        button.addEventListener("click", () => {
            const collapsed = card.classList.toggle("is-collapsed");
            button.textContent = collapsed ? "▼" : "▲";
            button.setAttribute("aria-label", collapsed ? "Show section" : "Hide section");
        });

        actions.appendChild(button);
    });
</script>
