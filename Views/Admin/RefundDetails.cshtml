@model AmarShowsBook.Models.Admin.VwRefundSummary

@{
    ViewData["Title"] = "Refund Details";
}

<section class="refund-details-page">

    <!-- TOP BAR -->

    <div class="top-bar">

        <div>

            <h1>Refund Details</h1>

            <p>
                Complete refund transaction information,
                gateway details, refund processing and user details.
            </p>
<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">
            Admin Workflow Details
        </h5>
    </div>

    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-4 fw-bold">
                Workflow Action
            </div>

            <div class="col-md-8">
                @(Model.workflow_action ?? "NA")
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 fw-bold">
                Approved By
            </div>

            <div class="col-md-8">
                @(Model.approved_by ?? "NA")
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 fw-bold">
                Rejected By
            </div>

            <div class="col-md-8">
                @(Model.rejected_by ?? "NA")
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 fw-bold">
                Retried By
            </div>

            <div class="col-md-8">
                @(Model.retried_by ?? "NA")
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 fw-bold">
                Admin Notes
            </div>

            <div class="col-md-8">
                @(Model.admin_notes ?? "NA")
            </div>
        </div>

    </div>
</div>
        </div>

        <div class="top-actions">

            <button onclick="window.print()"
                    class="print-btn">
                Print / Save PDF
            </button>

            <a href="/Admin/Refunds"
               class="back-btn">
                Back
            </a>

        </div>

    </div>

    <!-- DETAILS GRID -->

    <div class="details-grid">

        <!-- REFUND INFO -->

        <div class="detail-card">

            <h3>Refund Information</h3>

            <p>
                <strong>Refund Ref:</strong>
                @(string.IsNullOrWhiteSpace(Model.RefundRef)
                    ? "NA"
                    : Model.RefundRef)
            </p>

            <p>
                <strong>Refund Status:</strong>

                @if (Model.RefundStatus == "SUCCESS")
                {
                    <span class="status success">
                        SUCCESS
                    </span>
                }
                else if (Model.RefundStatus == "FAILED")
                {
                    <span class="status failed">
                        FAILED
                    </span>
                }
                else
                {
                    <span class="status pending">
                        @(string.IsNullOrWhiteSpace(Model.RefundStatus)
                            ? "NA"
                            : Model.RefundStatus)
                    </span>
                }

            </p>

            <p>
                <strong>Refund Amount:</strong>
                ₹@Model.RefundAmount
            </p>

            <p>
                <strong>Refund Method:</strong>
                @(string.IsNullOrWhiteSpace(Model.RefundMethod)
                    ? "NA"
                    : Model.RefundMethod)
            </p>

            <p>
                <strong>Gateway Refund Id:</strong>
                @(string.IsNullOrWhiteSpace(Model.GatewayRefundId)
                    ? "NA"
                    : Model.GatewayRefundId)
            </p>

            <p>
                <strong>Refund Reason:</strong>
                @(string.IsNullOrWhiteSpace(Model.RefundReason)
                    ? "NA"
                    : Model.RefundReason)
            </p>

            <p>
                <strong>Failure Reason:</strong>
                @(string.IsNullOrWhiteSpace(Model.FailureReason)
                    ? "NA"
                    : Model.FailureReason)
            </p>

        </div>

        <!-- BOOKING INFO -->

        <div class="detail-card">

            <h3>Booking & Transaction</h3>

            <p>
                <strong>Booking Ref:</strong>
                @(string.IsNullOrWhiteSpace(Model.BookingRef)
                    ? "NA"
                    : Model.BookingRef)
            </p>

            <p>
                <strong>Transaction Ref:</strong>
                @(string.IsNullOrWhiteSpace(Model.TransactionRef)
                    ? "NA"
                    : Model.TransactionRef)
            </p>

            <p>
                <strong>Requested At:</strong>

                @(Model.RequestedAt.HasValue
                    ? Model.RequestedAt.Value
                        .ToString("dd MMM yyyy hh:mm tt")
                    : "NA")

            </p>

            <p>
                <strong>Processed At:</strong>

                @(Model.ProcessedAt.HasValue
                    ? Model.ProcessedAt.Value
                        .ToString("dd MMM yyyy hh:mm tt")
                    : "NA")

            </p>

            <p>
                <strong>Created At:</strong>
                @Model.CreatedAt
                    .ToString("dd MMM yyyy hh:mm tt")
            </p>

            <p>
                <strong>Updated At:</strong>

                @(Model.UpdatedAt.HasValue
                    ? Model.UpdatedAt.Value
                        .ToString("dd MMM yyyy hh:mm tt")
                    : "NA")

            </p>

        </div>

        <!-- USER INFO -->

        <div class="detail-card">

            <h3>User Information</h3>

            <p>
                <strong>User Id:</strong>
                @Model.UserId
            </p>

            <p>
                <strong>User Name:</strong>
                @(string.IsNullOrWhiteSpace(Model.UserName)
                    ? "NA"
                    : Model.UserName)
            </p>

            <p>
                <strong>User Email:</strong>
                @(string.IsNullOrWhiteSpace(Model.UserEmail)
                    ? "NA"
                    : Model.UserEmail)
            </p>

            <p>
                <strong>Refund Error:</strong>

                @if (Model.IsRefundError == 1)
                {
                    <span class="status failed">
                        YES
                    </span>
                }
                else
                {
                    <span class="status success">
                        NO
                    </span>
                }

            </p>

        </div>

    </div>

</section>

<style>

.refund-details-page{
    padding:24px;
    background:#f8fafc;
    min-height:100vh;
}

/* TOP BAR */

.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;
    margin-bottom:28px;
}

.top-bar h1{
    font-size:40px;
    font-weight:700;
    color:#0f172a;
    margin-bottom:8px;
}

.top-bar p{
    color:#64748b;
    font-size:15px;
}

.top-actions{
    display:flex;
    gap:12px;
}

/* BUTTONS */

.print-btn,
.back-btn{
    padding:12px 18px;
    border:none;
    border-radius:12px;
    background:#2563eb;
    color:white;
    text-decoration:none;
    font-weight:600;
    cursor:pointer;
    transition:0.3s;
}

.print-btn:hover,
.back-btn:hover{
    background:#1d4ed8;
    color:white;
}

/* GRID */

.details-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

/* CARD */

.detail-card{
    background:white;
    border-radius:20px;
    padding:24px;
    border:1px solid #e2e8f0;
    box-shadow:0 6px 18px rgba(0,0,0,0.04);
}

.detail-card h3{
    font-size:24px;
    margin-bottom:20px;
    color:#0f172a;
}

.detail-card p{
    margin-bottom:16px;
    color:#475569;
    line-height:1.7;
    word-break:break-word;
}

.detail-card strong{
    color:#0f172a;
}

/* STATUS */

.status{
    display:inline-block;
    padding:6px 12px;
    border-radius:999px;
    font-size:12px;
    font-weight:700;
}

.success{
    background:#dcfce7;
    color:#166534;
}

.failed{
    background:#fee2e2;
    color:#991b1b;
}

.pending{
    background:#fef3c7;
    color:#92400e;
}

/* MOBILE */

@@media(max-width:1100px){

    .details-grid{
        grid-template-columns:1fr;
    }

}

@@media(max-width:768px){

    .refund-details-page{
        padding:16px;
    }

    .top-bar{
        flex-direction:column;
    }

    .top-actions{
        width:100%;
        flex-wrap:wrap;
    }

    .print-btn,
    .back-btn{
        width:100%;
        text-align:center;
    }

    .top-bar h1{
        font-size:30px;
    }

}

/* PRINT */

@@media print{

    .print-btn,
    .back-btn{
        display:none;
    }

    body{
        background:white;
    }

    .detail-card{
        box-shadow:none;
        border:1px solid #dbeafe;
    }

}

</style>