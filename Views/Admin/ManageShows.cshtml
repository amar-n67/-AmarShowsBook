@model AmarShowsBook.Models.ViewModels.ManageShowsViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Shows";
    var seatCounts = ViewBag.ScheduleSeatCounts as Dictionary<int,int> ?? new Dictionary<int,int>();
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Manage Shows</h1>
            <p>Add movies, standup and live shows with theater, screen, date, time and seats.</p>
        </div>
        <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">Back to Dashboard</a>
    </div>

    @if(TempData["Success"]!=null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if(TempData["Error"]!=null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="admin-detail-panel mb-4" data-admin-searchable>
        <h2 class="h5 mb-3">Schedule Show</h2>
        <form asp-action="CreateManagedShow" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div class="col-md-2">
                <label class="form-label">Type</label>
                <select name="Type" class="form-select">
                    <option value="Movie">Movie</option>
                    <option value="Standup">Standup</option>
                    <option value="Live">Live</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Show Name</label>
                <input name="Title" class="form-control" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">Director/Host</label>
                <input name="SecondaryName" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Cast</label>
                <input name="Cast" class="form-control" placeholder="Actor 1, Actor 2" />
            </div>
            <div class="col-md-2">
                <label class="form-label">First Date Time</label>
                <input name="StartTime" class="form-control" type="datetime-local" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">More Date Times</label>
                <textarea name="AdditionalStartTimes" class="form-control" rows="1" placeholder="2026-06-02 18:00, 2026-06-03 21:00"></textarea>
            </div>
            <div class="col-md-1">
                <label class="form-label">Minutes</label>
                <input name="Duration" class="form-control" type="number" min="15" value="120" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Seats</label>
                <input name="TotalSeats" class="form-control" type="number" min="1" value="70" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Silver Price</label>
                <input name="SilverPrice" class="form-control" type="number" min="1" step="0.01" value="150" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Gold Price</label>
                <input name="GoldPrice" class="form-control" type="number" min="1" step="0.01" value="250" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Premium Price</label>
                <input name="PremiumPrice" class="form-control" type="number" min="1" step="0.01" value="350" />
            </div>
            <div class="col-md-2">
                <label class="form-label">IMDB Rating</label>
                <input name="ImdbRating" class="form-control" type="number" min="0" max="10" step="0.1" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Location</label>
                <select name="LocationId" class="form-select" required>
                    <option value="">Select location</option>
                    @foreach(var location in Model.Locations)
                    {
                        <option value="@location.Id">@location.Area, @location.State, @location.Country</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Theater</label>
                <select name="VenueId" class="form-select js-venue-select" required id="venueSelect">
                    @foreach(var venue in Model.Venues)
                    {
                        <option value="@venue.Id">@venue.VenueName, @venue.City</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Screen</label>
                <select name="ScreenId" class="form-select js-screen-select" required>
                    @foreach(var screen in Model.Screens)
                    {
                        var venue = Model.Venues.FirstOrDefault(x => x.Id == screen.VenueId);
                        <option value="@screen.Id" data-venue-id="@screen.VenueId">@screen.ScreenName - @(venue?.VenueName ?? "Venue")</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Poster URL</label>
                <input name="PosterUrl" class="form-control" placeholder="/uploads/poster.jpeg or https://..." />
            </div>
            <div class="col-md-6">
                <label class="form-label">Images</label>
                <input name="Images" class="form-control" placeholder="Comma separated image URLs" />
            </div>
            <div class="col-md-6">
                <label class="form-label">YouTube Trailer Link</label>
                <input name="TrailerUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
            </div>
            <div class="col-md-6">
                <label class="form-label">Description</label>
                <textarea name="Description" class="form-control" rows="1"></textarea>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Save</button>
            </div>
        </form>
    </div>

    <div class="admin-detail-panel mb-3">
        <div class="row g-2">
            <div class="col-md-5">
                <input id="showSearch" class="form-control" placeholder="Search show, type, location, screen" />
            </div>
            <div class="col-md-3">
                <select id="showTypeFilter" class="form-select">
                    <option value="">All Types</option>
                    <option value="Movie">Movie</option>
                    <option value="Standup">Standup</option>
                    <option value="Live">Live</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-dark w-100" onclick="resetShowFilters()">Reset</button>
            </div>
        </div>
    </div>

    <div class="card p-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Show</th>
                    <th>Type</th>
                    <th>Date Time</th>
                    <th>Location</th>
                    <th>Theater</th>
                    <th>Screen</th>
                    <th>Seats</th>
                    <th>Trailer</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach(var schedule in Model.Schedules)
                {
                    var title = schedule.Movie?.Title ?? schedule.StandupShow?.Title ?? schedule.LiveStream?.Title ?? "Untitled";
                    var secondary = schedule.Movie?.Director ?? schedule.StandupShow?.Comedian ?? schedule.LiveStream?.Host;
                    var cast = schedule.Movie?.Cast;
                    var description = schedule.Movie?.Description ?? schedule.StandupShow?.Description ?? schedule.LiveStream?.Description;
                    var poster = schedule.Movie?.PosterUrl ?? schedule.StandupShow?.PosterUrl ?? schedule.LiveStream?.PosterUrl;
                    var images = schedule.Movie?.Images ?? schedule.StandupShow?.Images ?? schedule.LiveStream?.Images;
                    var trailer = schedule.Movie?.TrailerUrl ?? schedule.StandupShow?.TrailerUrl ?? schedule.LiveStream?.TrailerUrl;
                    var rating = schedule.Movie?.ImdbRating;
                    var duration = schedule.Movie?.Duration ?? schedule.StandupShow?.Duration ?? schedule.LiveStream?.Duration ?? (int)Math.Max(15, (schedule.EndTime - schedule.StartTime).TotalMinutes);
                    var venueId = schedule.Screen?.VenueId ?? 0;
                    var venueName = Model.Venues.FirstOrDefault(x => x.Id == venueId)?.VenueName ?? "Not assigned";
                    <tr data-admin-searchable class="show-row" data-type="@schedule.Type">
                        <td><strong>@title</strong></td>
                        <td>@schedule.Type</td>
                        <td>@schedule.StartTime.ToString("dd MMM yyyy hh:mm tt")</td>
                        <td>@schedule.Location?.Area, @schedule.Location?.State</td>
                        <td>@venueName</td>
                        <td>@(schedule.Screen?.ScreenName ?? "Not assigned")</td>
                        <td>@(seatCounts.TryGetValue(schedule.Id, out var seatCount) ? seatCount : 0)</td>
                        <td>
                            @if(!string.IsNullOrWhiteSpace(trailer))
                            {
                                <a href="@trailer" target="_blank" rel="noopener">Trailer</a>
                            }
                            else
                            {
                                <span class="text-muted">NA</span>
                            }
                        </td>
                        <td class="text-end show-actions">
                            <button class="btn btn-sm btn-outline-primary" type="button" onclick="toggleShowEditor(@schedule.Id)">Edit</button>
                            <form asp-action="DeleteManagedShow" method="post" onsubmit="return confirm('Delete this show schedule?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@schedule.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <tr id="showEditor-@schedule.Id" class="show-edit-row d-none">
                        <td colspan="9">
                            <form asp-action="UpdateManagedShow" method="post" class="row g-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@schedule.Id" />
                                <div class="col-md-3">
                                    <label class="form-label">Show Name</label>
                                    <input name="Title" class="form-control" value="@title" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Director/Host</label>
                                    <input name="SecondaryName" class="form-control" value="@secondary" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Cast</label>
                                    <input name="Cast" class="form-control" value="@cast" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Date Time</label>
                                    <input name="StartTime" class="form-control" type="datetime-local" value="@schedule.StartTime.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" required />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Minutes</label>
                                    <input name="Duration" class="form-control" type="number" min="15" value="@duration" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Location</label>
                                    <select name="LocationId" class="form-select" required>
                                        @foreach(var location in Model.Locations)
                                        {
                                            <option value="@location.Id" selected="@(location.Id == schedule.LocationId)">@location.Area, @location.State, @location.Country</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Theater</label>
                                    <select name="VenueId" class="form-select js-venue-select" required>
                                        @foreach(var venue in Model.Venues)
                                        {
                                            <option value="@venue.Id" selected="@(venue.Id == venueId)">@venue.VenueName, @venue.City</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Screen</label>
                                    <select name="ScreenId" class="form-select js-screen-select" required>
                                        @foreach(var screen in Model.Screens)
                                        {
                                            var venue = Model.Venues.FirstOrDefault(x => x.Id == screen.VenueId);
                                            <option value="@screen.Id" data-venue-id="@screen.VenueId" selected="@(screen.Id == schedule.ScreenId)">@screen.ScreenName - @(venue?.VenueName ?? "Venue")</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">IMDB Rating</label>
                                    <input name="ImdbRating" class="form-control" type="number" min="0" max="10" step="0.1" value="@rating" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Poster URL</label>
                                    <input name="PosterUrl" class="form-control" value="@poster" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Images</label>
                                    <input name="Images" class="form-control" value="@images" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">YouTube Trailer Link</label>
                                    <input name="TrailerUrl" class="form-control" value="@trailer" />
                                </div>
                                <div class="col-md-9">
                                    <label class="form-label">Description</label>
                                    <textarea name="Description" class="form-control" rows="1">@description</textarea>
                                </div>
                                <div class="col-md-3 d-flex align-items-end gap-2">
                                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="toggleShowEditor(@schedule.Id)">Close</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<script>
const showSearch = document.getElementById("showSearch");
const showTypeFilter = document.getElementById("showTypeFilter");

function applyShowFilters() {
    const text = (showSearch.value || "").toLowerCase();
    const type = normalizeShowType(showTypeFilter.value);

    document.querySelectorAll(".show-row").forEach(row => {
        const typeMatch = !type || normalizeShowType(row.dataset.type || "") === type;
        const textMatch = !text || row.innerText.toLowerCase().includes(text);
        row.style.display = typeMatch && textMatch ? "" : "none";
    });
}

function normalizeShowType(value) {
    const normalized = String(value || "").toLowerCase();
    if (normalized.includes("standup")) return "standup";
    if (normalized.includes("live")) return "live";
    return normalized || "";
}

function resetShowFilters() {
    showSearch.value = "";
    showTypeFilter.value = "";
    applyShowFilters();
}

showSearch?.addEventListener("input", applyShowFilters);
showTypeFilter?.addEventListener("change", applyShowFilters);

function toggleShowEditor(id) {
    document.getElementById(`showEditor-${id}`)?.classList.toggle("d-none");
}

function syncScreensForVenue(venueSelect) {
    const form = venueSelect.closest("form") || document;
    const screenSelect = form.querySelector(".js-screen-select");
    if (!screenSelect) return;

    const venueId = venueSelect.value;
    let firstVisible = "";
    Array.from(screenSelect.options).forEach(option => {
        const visible = !venueId || option.dataset.venueId === venueId;
        option.hidden = !visible;
        option.disabled = !visible;
        if (visible && !firstVisible) firstVisible = option.value;
    });

    if (screenSelect.selectedOptions.length && screenSelect.selectedOptions[0].disabled) {
        screenSelect.value = firstVisible;
    }
}

document.querySelectorAll(".js-venue-select").forEach(select => {
    syncScreensForVenue(select);
    select.addEventListener("change", () => syncScreensForVenue(select));
});
</script>

<style>
.show-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

.show-edit-row td {
    background: color-mix(in srgb, var(--admin-panel) 88%, var(--admin-gold) 12%);
    border-top: 0;
}
</style>
