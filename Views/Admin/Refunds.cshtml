
@model IEnumerable<AmarShowsBook.Models.Admin.VwRefundSummary>
    @if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">

        @TempData["Success"]

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">

        @TempData["Error"]

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert">
        </button>

    </div>
}
@{
    ViewData["Title"] = "Refund Management";
    var totalRefunds = Model.Count();
    var successRefunds = Model.Count(x => x.RefundStatus == "SUCCESS");
    var pendingRefunds = Model.Count(x => x.RefundStatus == "PENDING");
    var failedRefunds = Model.Count(x => x.RefundStatus == "FAILED");
    var totalRefundAmount = Model.Sum(x => x.RefundAmount ?? 0);
}
<div class="container-fluid px-4 py-4">
    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                Refund Management
            </h2>
            <p class="text-muted mb-0">
                Monitor refund requests, failures, processing status and customer refund history.
            </p>
        </div>
        <div>
            <a
    asp-action="ExportRefunds"
    class="btn btn-dark rounded-pill px-4">

    <i class="bi bi-download me-2"></i>
    Export

</a>
                <i class="bi bi-download me-2"></i>
            </button>
        </div>
    </div>
    <!-- ===================================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ===================================================== -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">
                                Total Refunds
                            </p>
                            <h3 class="fw-bold mb-0">
                                @totalRefunds
                            </h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-arrow-counterclockwise text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">
                                Successful
                            </p>
                            <h3 class="fw-bold text-success mb-0">
                                @successRefunds
                            </h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">
                                Pending
                            </p>
                            <h3 class="fw-bold text-warning mb-0">
                                @pendingRefunds
                            </h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-clock-history text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">
                                Failed
                            </p>
                            <h3 class="fw-bold text-danger mb-0">
                                @failedRefunds
                            </h3>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-x-circle text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- ===================================================== -->
    <!-- TOTAL REFUND AMOUNT -->
    <!-- ===================================================== -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h6 class="text-muted mb-2">
                    Total Refund Amount Processed
                </h6>
                <h2 class="fw-bold text-dark mb-0">
                    ₹ @totalRefundAmount.ToString("N2")
                </h2>
            </div>
            <div class="bg-dark text-white rounded-circle p-4">
                <i class="bi bi-cash-stack fs-2"></i>
            </div>
        </div>
    </div>
    <!-- ===================================================== -->
    <!-- FILTERS -->
    <!-- ===================================================== -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <input
                        type="text"
                        id="refundSearch"
                        class="form-control rounded-pill"
                        placeholder="Search refund ref / user / email">
                </div>
                <div class="col-md-3">
                    <select
                        id="statusFilter"
                        class="form-select rounded-pill">
                        <option value="">
                            All Status
                        </option>
                        <option value="SUCCESS">
                            SUCCESS
                        </option>
                        <option value="PENDING">
                            PENDING
                        </option>
                        <option value="FAILED">
                            FAILED
                        </option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select
                        id="methodFilter"
                        class="form-select rounded-pill">
                        <option value="">
                            All Methods
                        </option>
                        <option value="UPI">
                            UPI
                        </option>
                        <option value="CARD">
                            CARD
                        </option>
                        <option value="NETBANKING">
                            NETBANKING
                        </option>
                        <option value="WALLET">
                            WALLET
                        </option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button
                        class="btn btn-outline-dark rounded-pill w-100"
                        onclick="resetFilters()">
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- ===================================================== -->
    <!-- REFUND TABLE -->
    <!-- ===================================================== -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="refundTable">
                <thead class="table-light">
                    <tr>
                        <th>Refund Ref</th>
                        <th>User</th>
                        <th>Booking Ref</th>
                        <th>Transaction Ref</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Method</th>
                        <th>Requested</th>
                        <th class="text-center">Actions</th>
                        <th class="text-center">Workflow Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">
                                @item.RefundRef
                            </td>
                            <td>
                                <div class="fw-semibold">
                                    @item.UserName
                                </div>
                                <div class="small text-muted">
                                    @item.UserEmail
                                </div>
                            </td>
                            <td>
                                @item.BookingRef
                            </td>
                            <td>
                                @item.TransactionRef
                            </td>
                            <td class="fw-bold">
                                ₹ @((item.RefundAmount ?? 0).ToString("N2"))
                            </td>
                            <td>
                                @if (item.RefundStatus == "SUCCESS")
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        SUCCESS
                                    </span>
                                }
                                else if (item.RefundStatus == "PENDING")
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                        PENDING
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        FAILED
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                    @item.RefundMethod
                                </span>
                            </td>
                            <td>
                                @item.RequestedAt?.ToString("dd MMM yyyy")
                                <br />
                                <span class="small text-muted">
                                    @item.RequestedAt?.ToString("hh:mm tt")
                                </span>
                            </td>
                            <td class="text-center">
                                <a
                                    asp-action="RefundDetails"
                                    asp-route-id="@item.RefundId"
                                    class="btn btn-sm btn-dark rounded-pill px-3">
                                    <i class="bi bi-eye me-1"></i>
                                    View
                                </a>
                            </td>
                            <td class="text-center">

    <div class="d-flex justify-content-center">

        @if (item.RefundStatus == "PENDING")
        {
            <div
                class="btn-group shadow-sm"
                role="group">

                <!-- APPROVE -->

                <form
                    asp-action="ApproveRefund"
                    method="post">

                    <input
                        type="hidden"
                        name="id"
                        value="@item.RefundId" />

                    <button
                        type="submit"
                        class="btn btn-sm btn-success px-3">

                        <i class="bi bi-check-lg me-1"></i>
                        Approve

                    </button>

                </form>

                <!-- REJECT -->

                <form
                    asp-action="RejectRefund"
                    method="post">

                    <input
                        type="hidden"
                        name="id"
                        value="@item.RefundId" />

                    <button
                        type="submit"
                        class="btn btn-sm btn-danger px-3">

                        <i class="bi bi-x-lg me-1"></i>
                        Reject

                    </button>

                </form>

            </div>
        }

        else if (item.RefundStatus == "FAILED")
        {
            <form
                asp-action="RetryRefund"
                method="post">

                <input
                    type="hidden"
                    name="id"
                    value="@item.RefundId" />

                <button
                    type="submit"
                    class="btn btn-sm btn-warning rounded-pill shadow-sm px-3">

                    <i class="bi bi-arrow-repeat me-1"></i>
                    Retry

                </button>

            </form>
        }

        else if (item.RefundStatus == "SUCCESS")
        {
            <div
                class="d-flex align-items-center justify-content-center">

                <div
                    class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                    style="
                        width: 34px;
                        height: 34px;
                    ">

                    <i class="bi bi-check-lg"></i>

                </div>

            </div>
        }

        else if (item.RefundStatus == "REJECTED")
        {
            <div
                class="d-flex align-items-center justify-content-center">

                <div
                    class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                    style="
                        width: 34px;
                        height: 34px;
                    ">

                    <i class="bi bi-x-lg"></i>

                </div>

            </div>
        }

    </div>

</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- ===================================================== -->
<!-- FILTER SCRIPT -->
<!-- ===================================================== -->
<script>
    const searchInput = document.getElementById('refundSearch');
    const statusFilter = document.getElementById('statusFilter');
    const methodFilter = document.getElementById('methodFilter');
    searchInput.addEventListener('keyup', filterTable);
    statusFilter.addEventListener('change', filterTable);
    methodFilter.addEventListener('change', filterTable);
    function filterTable() {
        const search = searchInput.value.toLowerCase();
        const status = statusFilter.value.toLowerCase();
        const method = methodFilter.value.toLowerCase();
        const rows = document.querySelectorAll('#refundTable tbody tr');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const matchesSearch = text.includes(search);
            const matchesStatus = !status || text.includes(status);
            const matchesMethod = !method || text.includes(method);
            row.style.display =
                matchesSearch && matchesStatus && matchesMethod
                    ? ''
                    : 'none';
        });
    }
    function resetFilters() {
        searchInput.value = '';
        statusFilter.value = '';
        methodFilter.value = '';
        filterTable();
    }
</script>