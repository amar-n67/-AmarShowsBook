
@model List<AmarShowsBook.Models.Admin.VwRefundSummary>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Refunds";
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Refunds</h1>
            <p>Refund references, users, amounts, and processing status.</p>
        </div>
        <a class="admin-back-btn admin-page-back" href="/Admin/Dashboard">← Back to Dashboard</a>
    </div>

<div class="table-wrapper">
<table class="table admin-table">

<thead>

    <tr>
        <th>Refund Ref</th>
        <th>Booking Ref</th>
        <th>Transaction Ref</th>
        <th>User</th>
        <th>Email</th>
        <th>Amount</th>
        <th>Status</th>
        <th>Method</th>
        <th>Gateway Refund Id</th>
        <th>Requested</th>
        <th>Processed</th>
        <th>Action</th>
    </tr>

</thead>

<tbody>

<tbody>

@if (Model != null && Model.Any())
{
    @foreach (var item in Model)
    {
        <tr>

            <td>
                @(string.IsNullOrWhiteSpace(item.RefundRef)
                    ? "NA"
                    : item.RefundRef)
            </td>

            <td>
                @(string.IsNullOrWhiteSpace(item.BookingRef)
                    ? "NA"
                    : item.BookingRef)
            </td>

            <td>
                @(string.IsNullOrWhiteSpace(item.TransactionRef)
                    ? "NA"
                    : item.TransactionRef)
            </td>

            <td>
                @(string.IsNullOrWhiteSpace(item.UserName)
                    ? "NA"
                    : item.UserName)
            </td>

            <td>
                @(string.IsNullOrWhiteSpace(item.UserEmail)
                    ? "NA"
                    : item.UserEmail)
            </td>

            <td>
                ₹@item.RefundAmount
            </td>

            <td>

                @if (item.RefundStatus == "SUCCESS")
                {
                    <span class="status success">
                        SUCCESS
                    </span>
                }
                else if (item.RefundStatus == "FAILED")
                {
                    <span class="status failed">
                        FAILED
                    </span>
                }
                else
                {
                    <span class="status pending">
                        @(string.IsNullOrWhiteSpace(item.RefundStatus)
                            ? "NA"
                            : item.RefundStatus)
                    </span>
                }

            </td>

            <td>
                @(string.IsNullOrWhiteSpace(item.RefundMethod)
                    ? "NA"
                    : item.RefundMethod)
            </td>

            <td>
                @(string.IsNullOrWhiteSpace(item.GatewayRefundId)
                    ? "NA"
                    : item.GatewayRefundId)
            </td>

            <td>
                @(item.RequestedAt.HasValue
                    ? item.RequestedAt.Value.ToString("dd MMM yyyy hh:mm tt")
                    : "NA")
            </td>

            <td>
                @(item.UpdatedAt.HasValue
                    ? item.UpdatedAt.Value.ToString("dd MMM yyyy hh:mm tt")
                    : "NA")
            </td>

            <td>

                <a href="/Admin/RefundDetails/@item.RefundId"
                   class="view-btn">
                    View
                </a>

            </td>

        </tr>
    }
}
else
{
    <tr>
        <td colspan="12" class="empty-state">
            No refund records found
        </td>
    </tr>
}

</tbody>

</table>
</div>
</section>
