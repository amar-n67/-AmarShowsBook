@model IEnumerable<AmarShowsBook.Models.Admin.VwRefundSummary>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Refunds";
}

<section class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1>Refunds</h1>
            <p>Refund references, users, amounts, and processing status.</p>
        </div>
    </div>

<div class="table-wrapper">
<table class="table admin-table">

<thead>
<tr>
    <th>Refund Ref</th>
    <th>User</th>
    <th>Amount</th>
    <th>Status</th>
</tr>
</thead>

<tbody>

@foreach (var item in Model)
{
    <tr>
        <td>@item.RefundRef</td>
        <td>@item.UserName</td>
        <td>@item.RefundAmount</td>
        <td>@item.RefundStatus</td>
    </tr>
}

</tbody>

</table>
</div>
</section>
