
@model IEnumerable<AmarShowsBook.Models.Admin.VwRefundSummary>
@using AmarShowsBook.Helpers
@inject AmarShowsBook.Services.RbacService RbacService
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Refund Management";
    var refundRows = Model.ToList();
    var canUsePrintTools = RbacAuthorizationHelper.CanUsePrintTools(Context, RbacService);
    var totalRefunds = refundRows.Count;
    var successRefunds = refundRows.Count(x => x.RefundStatus == "SUCCESS");
    var pendingRefunds = refundRows.Count(x => x.RefundStatus == "PENDING");
    var failedRefunds = refundRows.Count(x => x.RefundStatus == "FAILED");
    var rejectedRefunds = refundRows.Count(x => x.RefundStatus == "REJECTED");
    var totalRefundAmount = refundRows.Sum(x => x.RefundAmount ?? 0);
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalRecords = ViewBag.TotalRecords ?? totalRefunds;
    var statusOptions = refundRows
        .Select(x => x.RefundStatus)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Select(x => x!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
    var methodOptions = refundRows
        .Select(x => x.RefundMethod)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Select(x => x!)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
}
<div class="container-fluid px-4 py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                Refund Management
            </h2>
            <p class="text-muted mb-0">
                Monitor refund requests, failures, processing status and customer refund history.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a
                href="/Admin/Dashboard"
                class="btn btn-outline-dark rounded-pill px-4">

                ← Back

            </a>

            @if (canUsePrintTools)
            {
                <a
    asp-action="ExportRefunds"
    class="btn btn-dark rounded-pill px-4">

    <i class="bi bi-download me-2"></i>
    Export

</a>
            }
        </div>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">
                                Total Refunds
                            </p>
                            <h3 class="fw-bold mb-0">
                                @totalRefunds
                            </h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-arrow-counterclockwise text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">
                                Successful
                            </p>
                            <h3 class="fw-bold text-success mb-0">
                                @successRefunds
                            </h3>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">
                                Pending
                            </p>
                            <h3 class="fw-bold text-warning mb-0">
                                @pendingRefunds
                            </h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-clock-history text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">
                                Failed
                            </p>
                            <h3 class="fw-bold text-danger mb-0">
                                @failedRefunds
                            </h3>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-3 rounded-circle">
                            <i class="bi bi-x-circle text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1 small">All Records</p>
                    <h3 class="fw-bold mb-0">@totalRecords</h3>
                    <span class="small text-muted">Across every refund page</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1 small">Rejected</p>
                    <h3 class="fw-bold text-danger mb-0">@rejectedRefunds</h3>
                    <span class="small text-muted">Visible page count</span>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <p class="text-muted mb-1 small">Visible Rows</p>
                    <h3 class="fw-bold mb-0">@totalRefunds</h3>
                    <span class="small text-muted">50 rows per page maximum</span>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h6 class="text-muted mb-2">
                    Total Refund Amount Processed
                </h6>
                <h2 class="fw-bold text-dark mb-0">
                    @CurrencyFormatter.FormatRupees(totalRefundAmount)
                </h2>
            </div>
            <div class="bg-dark text-white rounded-circle p-4">
                <i class="bi bi-cash-stack fs-2"></i>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <input
                        type="text"
                        id="refundSearch"
                        class="form-control rounded-pill"
                        placeholder="Search refund ref / user / email">
                </div>
                <div class="col-md-3">
                    <select
                        id="statusFilter"
                        class="form-select rounded-pill">
                        <option value="">
                            All Status
                        </option>
                        @foreach (var status in statusOptions)
                        {
                            <option value="@status">
                                @status
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select
                        id="methodFilter"
                        class="form-select rounded-pill">
                        <option value="">
                            All Methods
                        </option>
                        @foreach (var method in methodOptions)
                        {
                            <option value="@method">
                                @method
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button
                        class="btn btn-outline-dark rounded-pill w-100"
                        onclick="resetFilters()">
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 refund-table-card">
        <div class="table-wrapper refund-table-shell">
            <table class="table admin-table refund-grid-table align-middle mb-0" id="refundTable">
                <colgroup>
                    <col class="refund-col-ref" />
                    <col class="refund-col-user" />
                    <col class="refund-col-booking" />
                    <col class="refund-col-transaction" />
                    <col class="refund-col-amount" />
                    <col class="refund-col-status" />
                    <col class="refund-col-method" />
                    <col class="refund-col-requested" />
                    <col class="refund-col-workflow" />
                    <col class="refund-col-view" />
                    <col class="refund-col-workflow-actions" />
                </colgroup>
                <thead class="table-light">
                    <tr>
                        <th>Refund Ref</th>
                        <th>User</th>
                        <th>Booking Ref</th>
                        <th>Transaction Ref</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Method</th>
                        <th>Requested</th>
                        <th>Workflow Status</th>
                        <th>Actions</th>
                        <th class="text-center">Workflow Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!refundRows.Any())
                    {
                        <tr>
                            <td colspan="11" class="empty-state">
                                No refunds found
                            </td>
                        </tr>
                    }
                    @foreach (var item in refundRows)
                    {
                        var refundDetailReason = !string.IsNullOrWhiteSpace(item.FailureReason)
                            ? item.FailureReason
                            : !string.IsNullOrWhiteSpace(item.RefundReason)
                                ? item.RefundReason
                                : "No refund reason recorded.";

                        <tr data-refund-status="@item.RefundStatus"
                            data-refund-method="@item.RefundMethod">
                            <td>
                                <div class="primary-text">
                                    @(string.IsNullOrWhiteSpace(item.RefundRef) ? "NA" : item.RefundRef)
                                </div>
                            </td>
                            <td>
                                <div class="primary-text">
                                    @(string.IsNullOrWhiteSpace(item.UserName) ? "NA" : item.UserName)
                                </div>
                                <div class="sub-text">
                                    @(string.IsNullOrWhiteSpace(item.UserEmail) ? "NA" : item.UserEmail)
                                </div>
                            </td>
                            <td>
                                <div class="primary-text">
                                    @(string.IsNullOrWhiteSpace(item.BookingRef) ? "NA" : item.BookingRef)
                                </div>
                            </td>
                            <td>
                                <div class="primary-text">
                                    @(string.IsNullOrWhiteSpace(item.TransactionRef) ? "NA" : item.TransactionRef)
                                </div>
                            </td>
                            <td class="fw-bold">
                                @CurrencyFormatter.FormatRupees(item.RefundAmount)
                            </td>
                            <td>
                                @if (item.RefundStatus == "SUCCESS")
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        SUCCESS
                                    </span>
                                }
                                else if (item.RefundStatus == "PENDING")
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                        PENDING
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        FAILED
                                    </span>
                                }
                                @if (!string.Equals(item.RefundStatus, "SUCCESS", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="app-info app-info-left">
                                        <button type="button" class="app-info-btn" aria-label="Show refund status details">i</button>
                                        <span class="app-info-popover" role="tooltip">
                                            <b>Status</b> @(string.IsNullOrWhiteSpace(item.RefundStatus) ? "NA" : item.RefundStatus)<br />
                                            <b>Reason</b> @refundDetailReason<br />
                                            <b>Requested</b> @(item.RequestedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "NA")
                                        </span>
                                    </span>
                                }
                            </td>
                            <td class="refund-method-cell">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                                    @(string.IsNullOrWhiteSpace(item.RefundMethod) ? "NA" : item.RefundMethod)
                                </span>
                            </td>
                            <td class="refund-date-cell">
                                <div class="primary-text">
                                    @ShowTimeFormatter.Format(item.RequestedAt, "dd MMM yyyy", "NA")
                                </div>
                                <div class="sub-text">
                                    @ShowTimeFormatter.Format(item.RequestedAt, "hh:mm tt", "")
                                </div>
                            </td>
                            <td>
    @if (item.RefundStatus == "SUCCESS")
    {
        <span class="badge bg-success px-3 py-2">
            ✅ Approved by Admin
        </span>
    }
    else if (item.RefundStatus == "REJECTED")
    {
        <span class="badge bg-danger px-3 py-2">
            Rejected - Ticket Active
        </span>
        <span class="app-info app-info-left">
            <button type="button" class="app-info-btn" aria-label="Show rejected refund details">i</button>
            <span class="app-info-popover" role="tooltip">
                <b>Status</b> Rejected<br />
                <b>Reason</b> @(string.IsNullOrWhiteSpace(item.RefundReason) ? "Ticket remains active or request was rejected by admin." : item.RefundReason)<br />
                <b>Requested</b> @(item.RequestedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "NA")
            </span>
        </span>
    }
    else if (item.RefundStatus == "RETRY")
    {
        <span class="badge bg-warning text-dark px-3 py-2">
            🔄 Retry Initiated
        </span>
    }
    else
    {
        <span class="badge bg-secondary px-3 py-2">
            ⏳ Pending Review
        </span>
    }
</td>
                            <td class="text-center">
                                <a
                                    asp-action="RefundDetails"
                                    asp-route-id="@item.RefundId"
                                    class="btn btn-sm btn-dark rounded-pill px-3">
                                    <i class="bi bi-eye me-1"></i>
                                    View
                                </a>
                            </td>
                            <td class="text-center">

    <div class="d-flex justify-content-center">

        @if (item.RefundStatus == "PENDING")
        {
            <div
                class="btn-group shadow-sm"
                role="group">


                <form
                    asp-action="ApproveRefund"
                    method="post">

                    <input
                        type="hidden"
                        name="id"
                        value="@item.RefundId" />

                    <button
                        type="submit"
                        class="btn btn-sm btn-success px-3">

                        <i class="bi bi-check-lg me-1"></i>
                        Approve

                    </button>

                </form>


                <form
                    asp-action="RejectRefund"
                    method="post">

                    <input
                        type="hidden"
                        name="id"
                        value="@item.RefundId" />

                    <button
                        type="submit"
                        class="btn btn-sm btn-danger px-3"
                        title="Reject cancellation request and keep ticket active">

                        <i class="bi bi-x-lg me-1"></i>
                        Reject

                    </button>

                </form>

            </div>
        }

        else if (item.RefundStatus == "FAILED")
        {
            <form
                asp-action="RetryRefund"
                method="post">

                <input
                    type="hidden"
                    name="id"
                    value="@item.RefundId" />

                <button
                    type="submit"
                    class="btn btn-sm btn-warning rounded-pill shadow-sm px-3">

                    <i class="bi bi-arrow-repeat me-1"></i>
                    Retry

                </button>

            </form>
        }

        else if (item.RefundStatus == "SUCCESS")
        {
            <div
                class="d-flex align-items-center justify-content-center">

                <span class="text-success fw-bold fs-4" title="Approved">✓</span>

            </div>
        }

        else if (item.RefundStatus == "REJECTED")
        {
            <div
                class="d-flex align-items-center justify-content-center">

                <span class="text-danger fw-bold fs-4" title="Rejected - ticket active">✕</span>

            </div>
        }

    </div>

</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_AdminPagination", new AmarShowsBook.Models.ViewModels.AdminPaginationViewModel
    {
        CurrentPage = currentPage,
        TotalPages = totalPages,
        ActionUrl = "/Admin/Refunds"
    })
</div>
<script>
    const searchInput = document.getElementById('refundSearch');
    const statusFilter = document.getElementById('statusFilter');
    const methodFilter = document.getElementById('methodFilter');
    searchInput.addEventListener('keyup', filterTable);
    statusFilter.addEventListener('change', filterTable);
    methodFilter.addEventListener('change', filterTable);
    function filterTable() {
        const search = searchInput.value.trim().toLowerCase();
        const status = statusFilter.value.trim().toLowerCase();
        const method = methodFilter.value.trim().toLowerCase();
        const rows = document.querySelectorAll('#refundTable tbody tr');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            const rowStatus = (row.dataset.refundStatus || '').trim().toLowerCase();
            const rowMethod = (row.dataset.refundMethod || '').trim().toLowerCase();
            const matchesSearch = !search || text.includes(search);
            const matchesStatus = !status || rowStatus === status;
            const matchesMethod = !method || rowMethod === method;
            row.style.display =
                matchesSearch && matchesStatus && matchesMethod
                    ? ''
                    : 'none';
        });
    }
    function resetFilters() {
        searchInput.value = '';
        statusFilter.value = '';
        methodFilter.value = '';
        filterTable();
    }
</script>

<style>
    .refund-table-card {
        overflow: visible;
    }

    .refund-table-shell {
        overflow-x: auto !important;
        overflow-y: visible !important;
    }

    .refund-grid-table {
        min-width: 1480px !important;
        table-layout: fixed !important;
    }

    .refund-grid-table .refund-col-ref {
        width: 150px;
    }

    .refund-grid-table .refund-col-user {
        width: 210px;
    }

    .refund-grid-table .refund-col-booking {
        width: 135px;
    }

    .refund-grid-table .refund-col-transaction {
        width: 165px;
    }

    .refund-grid-table .refund-col-amount {
        width: 115px;
    }

    .refund-grid-table .refund-col-status {
        width: 130px;
    }

    .refund-grid-table .refund-col-method {
        width: 115px;
    }

    .refund-grid-table .refund-col-requested {
        width: 135px;
    }

    .refund-grid-table .refund-col-workflow {
        width: 175px;
    }

    .refund-grid-table .refund-col-view {
        width: 105px;
    }

    .refund-grid-table .refund-col-workflow-actions {
        width: 185px;
    }

    .refund-grid-table th,
    .refund-grid-table td {
        white-space: normal !important;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .refund-grid-table th:first-child,
    .refund-grid-table td:first-child,
    .refund-grid-table th:last-child,
    .refund-grid-table td:last-child,
    .refund-grid-table td:has(.btn),
    .refund-grid-table td:has(form) {
        width: auto !important;
    }

    .refund-grid-table .primary-text {
        color: var(--admin-ink, #111827);
        font-weight: 850;
        line-height: 1.25;
    }

    .refund-grid-table .sub-text {
        margin-top: 3px;
        color: var(--admin-muted, #64748b);
        font-size: 0.78rem;
        line-height: 1.25;
    }

    .refund-grid-table .badge {
        max-width: 100%;
        white-space: normal;
        line-height: 1.2;
        text-align: center;
    }

    .refund-grid-table .btn {
        white-space: nowrap;
    }

    .refund-grid-table .btn-group {
        display: inline-flex;
        flex-wrap: nowrap;
        max-width: 100%;
    }

    .refund-grid-table .btn-group form {
        margin: 0;
    }

    .refund-grid-table .app-info {
        margin-left: 4px;
        vertical-align: middle;
    }

    .refund-date-cell,
    .refund-method-cell {
        text-align: center;
    }

    @@media (max-width: 900px) {
        .refund-grid-table {
            min-width: 1260px !important;
        }

        .refund-grid-table th,
        .refund-grid-table td {
            padding: 10px 11px;
            font-size: 0.82rem;
        }
    }
</style>
