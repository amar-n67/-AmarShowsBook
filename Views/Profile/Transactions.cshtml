@model List<AmarShowsBook.Models.VwBookingTransactionSummary>
@using AmarShowsBook.Helpers

<h2>My Transactions</h2>

<table class="table">

    <thead>
        <tr>
            <th>Ref</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Method</th>
            <th>Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.TransactionRef</td>

            <td>
                @CurrencyFormatter.FormatRupees(item.TransactionAmount)
            </td>

            <td>
                @item.TransactionStatus
                @if (!string.Equals(item.TransactionStatus, "SUCCESS", StringComparison.OrdinalIgnoreCase))
                {
                    <span class="app-info app-info-left">
                        <button type="button" class="app-info-btn" aria-label="Show transaction status details">i</button>
                        <span class="app-info-popover" role="tooltip">
                            <b>Status</b> @(string.IsNullOrWhiteSpace(item.TransactionStatus) ? "NA" : item.TransactionStatus)<br />
                            <b>Reason</b> @(string.IsNullOrWhiteSpace(item.FailureReason) ? "Payment is not marked successful yet." : item.FailureReason)<br />
                            <b>When</b> @(item.CompletedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "Pending")
                        </span>
                    </span>
                }
            </td>

            <td>
                @item.PaymentMethod
            </td>

            <td>
                @item.BookingCreatedAt
            </td>

            <td>
                @if (item.TransactionId.HasValue)
                {
                    <a class="btn btn-primary btn-sm" href="/Transaction/Details/@item.TransactionId.Value">View</a>
                }
                else
                {
                    <span class="text-muted">NA</span>
                }
            </td>

        </tr>
    }

    </tbody>

</table>
